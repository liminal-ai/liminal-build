er-1',\n    95\t          email: 'lee@example.com',\n    96\t          displayName: 'Lee Moore',\n    97\t        },\n    98\t        reason: null,\n    99\t      },\n   100\t    });\n   101\t    const authUserSyncService = new AuthUserSyncService(platformStore);\n   102\t    const app = await buildApp({\n   103\t      authSessionService,\n   104\t      authUserSyncService,\n   105\t      platformStore,\n   106\t    });\n   107\t    const response = await app.inject({\n   108\t      method: 'GET',\n   109\t      url: '/projects',\n   110\t      cookies: {\n   111\t        [sessionCookieName]: 'valid-session-cookie',\n   112\t      },\n   113\t    });\n   114\t\n   115\t    expect(response.statusCode).toBe(200);\n   116\t    expect(response.headers['content-type']).toContain('text/html');\n   117\t    expect(response.body).toContain('window.__SHELL_BOOTSTRAP__');\n   118\t\n   119\t    await app.close();\n   120\t  });\n   121\t\n   122\t  it('TC-1.1b redirects unauthenticated project route', async () => {\n   123\t    const platformStore = new InMemoryPlatformStore();\n   124\t    const app = await buildApp({\n   125\t      authSessionService: createTestAuthSessionService({\n   126\t        resolution: {\n   127\t          actor: null,\n   128\t          reason: 'missing_session',\n   129\t        },\n   130\t      }),\n   131\t      authUserSyncService: new AuthUserSyncService(platformStore),\n   132\t      platformStore,\n   133\t    });\n   134\t    const response = await app.inject({\n   135\t      method: 'GET',\n   136\t      url: '/projects',\n   137\t    });\n   138\t\n   139\t    expect(response.statusCode).toBe(302);\n   140\t    expect(response.headers.location).toContain('/auth/login?returnTo=%2Fprojects');\n   141\t\n   142\t    await app.close();\n   143\t  });\n   144\t\n   145\t  it('TC-1.1c clears invalid session and redirects', async () => {\n   146\t    const platformStore = new InMemoryPlatformStore();\n   147\t    const app = await buildApp({\n 