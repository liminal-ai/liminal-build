\n   101\\t        displayName: 'liminal-build',\\n   102\\t        purpose: 'implementation',\\n   103\\t        accessMode: 'read_write',\\n   104\\t        repositoryUrl: 'https://github.com/liminal-ai/liminal-build',\\n   105\\t        repositoryFullName: 'liminal-ai/liminal-build',\\n   106\\t        targetRef: 'feature/epic-03',\\n   107\\t        hydrationState: 'hydrated',\\n   108\\t        lastHydratedAt: '2026-04-15T12:08:00.000Z',\\n   109\\t        lastHydratedResolvedRef: 'b'.repeat(40),\\n   110\\t        lastObservedRemoteResolvedRef: 'b'.repeat(40),\\n   111\\t        freshnessReason: null,\\n   112\\t        refreshStatus: 'idle',\\n   113\\t        refreshRequestedAt: null,\\n   114\\t        detachedAt: null,\\n   115\\t        detachedByUserId: null,\\n   116\\t        updatedAt: '2026-04-15T12:10:00.000Z',\\n   117\\t      },\\n   118\\t      {\\n   119\\t        _id: 'source-readonly-stale-1',\\n   120\\t        _creationTime: 12,\\n   121\\t        projectId: 'project-sources-1',\\n   122\\t        processId: null,\\n   123\\t        provider: 'github',\\n   124\\t        displayName: 'stale-branch',\\n   125\\t        purpose: 'review',\\n   126\\t        accessMode: 'read_only',\\n   127\\t        repositoryUrl: 'https://github.com/liminal-ai/stale-branch-repo',\\n   128\\t        repositoryFullName: 'liminal-ai/stale-branch-repo',\\n   129\\t        targetRef: 'old-phase',\\n   130\\t        hydrationState: 'stale',\\n   131\\t        lastHydratedAt: '2026-04-15T11:55:00.000Z',\\n   132\\t        lastHydratedResolvedRef: 'c'.repeat(40),\\n   133\\t        lastObservedRemoteResolvedRef: 'd'.repeat(40),\\n   134\\t        freshnessReason: 'target_ref_changed',\\n   135\\t        refreshStatus: 'pending',\\n   136\\t        refreshRequestedAt: '2026-04-15T12:04:00.000Z',\\n   137\\t        detachedAt: null,\\n   138\\t        detachedByUserId: null,\\n   139\\t        updatedAt: '2026-04-15T12:03:00.000Z',\\n   140\\t      },\\n   141\\t    ],\\n   142\\t  };\\n   143\\t}\\n   144\\t\\n   145\\tdescribe('convex/sourceAttachments summaries', () => {\\n   146\\t  it('returns accessMode in the durable source attachment projection', async () => {\\n   147\\t    const { ctx } = createFakeConvexContext(buildSourceAttachmentsSeed());\\n   148\\t\\n   149\\t    const summaries = await listProjectSourceAttachmentSummariesHandler(ctx, {\\n   150\\t      projectId: 'project-sources-1',\\n   151\\t    });\\n   152\\t\\n   153\\t    expect(summaries).toHaveLength(3);\\n   154\\t    for (const summary of summaries) {\\n   155\\t      expect(summary.accessMode === 'read_only' || summary.accessMode === 'read_write').toBe(true);\\n   156\\t    }\\n   157\\t  });\\n   158\\t\\n   159\\t  it('preserves hydrationState and targetRef alongside the new accessMode field', async () => {\\n   160\\t    const { ctx } = createFakeConvexContext(buildSourceAttachmentsSeed());\\n   161\\t\\n   162\\t    const summaries = await listProjectSourceAttachmentSummariesHandler(ctx, {\\n   163\\t      projectId: 'project-sources-1',\\n   164\\t    });\\n   165\\t    const byId = new Map(summaries.map((summary) => [summary.sourceAttachmentId, summary]));\\n   166\\t\\n   167\\t    expect(byId.get('source-readonly-project-1')).toMatchObject({\\n   168\\t      hydrationState: 'hydrated',\\n   169\\t      targetRef: 'main',\\n   170\\t      accessMode: 'read_only',\\n   171\\t    });\\n   172\\t    expect(byId.get('source-writable-process-1')).toMatchObject({\\n   173\\t      hydrationState: 'hydrated',\\n   174\\t      targetRef: 'feature/epic-03',\\n   175\\t      accessMode: 'read_write',\\n   176\\t    });\\n   177\\t    expect(byId.get('source-readonly-stale-1')).toMatchObject({\\n   178\\t      hydrationState: 'stale',\\n   179\\t      targetRef: 'old-phase',\\n   180\\t      accessMode: 'read_only',\\n   181\\t    });\\n   182\\t  });\\n   183\\t\\n   184\\t  it('keeps process linkage fields while adding accessMode', async () => {\\n   185\\t    const { ctx } = createFakeConvexContext(buildSourceAttachmentsSeed());\\n   186\\t\\n   187\\t    const summaries = await listProjectSourceAttachmentSummariesHandler(ctx, {\\n   188\\t      projectId: 'project-sources-1',\\n   189\\t    });\\n   190\\t    const writable = summaries.find(\\n   191\\t      (summary) => summary.sourceAttachmentId === 'source-writable-process-1',\\n   192\\t    );\\n   193\\t    const projectScoped = summaries.find(\\n   194\\t      (summary) => summary.sourceAttachmentId === 'source-readonly-project-1',\\n   195\\t    );\\n   196\\t\\n   197\\t    expect(writable).toMatchObject({\\n   198\\t      attachmentScope: 'process',\\n   199\\t      processId: 'process-sources-1',\\n   200\\t      processDisplayLabel: 'Feature Implementation #1',\\n   201\\t      accessMode: 'read_write',\\n   202\\t    });\\n   203\\t    expect(projectScoped).toMatchObject({\\n   204\\t      attachmentScope: 'project',\\n   205\\t      processId: null,\\n   206\\t      processDisplayLabel: null,\\n   207\\t      accessMode: 'read_only',\\n   208\\t    });\\n   209\\t  });\\n   210\\t\\n   211\\t  it('returns repositoryUrl on every projected source attachment summary', async () => {\\n   212\\t    const { ctx } = createFakeConvexContext(buildSourceAttachmentsSeed());\\n   213\\t\\n   214\\t    const summaries = await listProjectSourceAttachmentSummariesHandler(ctx, {\\n   215\\t      projectId: 'project-sources-1',\\n   216\\t    });\\n   217\\t    const byId = new Map(summaries.map((summary) => [summary.sourceAttachmentId, summary]));\\n   218\\t\\n   219\\t    expect(byId.get('source-readonly-project-1')?.repositoryUrl).toBe(\\n   220\\t      'https://github.com/liminal-ai/reference-repo',\\n   221\\t    );\\n   222\\t    expect(byId.get('source-writable-process-1')?.repositoryUrl).toBe(\\n   223\\t      'https://github.com/liminal-ai/liminal-build',\\n   224\\t    );\\n   225\\t    expect(byId.get('source-readonly-stale-1')?.repositoryUrl).toBe(\\n  