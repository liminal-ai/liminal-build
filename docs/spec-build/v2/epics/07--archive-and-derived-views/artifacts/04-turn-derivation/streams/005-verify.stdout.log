outcome\":\"needs-ruling\",\"storyRunId\":\"03-hydration-and-freshness-management-story-run-001\",\"storyId\":\"03-hydration-and-freshness-management\",\"attempt\":1,\"summary\":{\"storyTitle\":\"Story 3: Hydration and Freshness Management\",\"implementedScope\":\"Replaced the fake immediate-refresh success path with a runtime-backed hydration executor that resolves a real process working-copy target, uses the provider adapter hydration/rehydration seam, returns pending/failed/not-available truthfully, and only marks a source hydrated after actual runtime refresh completion.\",\"acceptanceRationale\":\"Story-lead is pausing for caller ruling 03-hydration-and-freshness-management-story-run-001-ruling-018 before impl-lead can accept the story.\"},\"evidence\":{\"implementorArtifacts\":[{\"kind\":\"implementor-result\",\"path\":\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/03-hydration-and-freshness-management/003-implementor.json\",\"provenance\":\"current-run\"},{\"kind\":\"implementor-result\",\"path\":\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/03-hydration-and-freshness-management/005-continue.json\",\"provenance\":\"current-run\"}],\"selfReviewArtifacts\":[],\"verifierArtifacts\":[{\"kind\":\"verifier-result\",\"path\":\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/03-hydration-and-freshness-management/004-verify.json\",\"provenance\":\"current-run\"},{\"kind\":\"verifier-result\",\"path\":\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/03-hydration-and-freshness-management/006-verify.json\",\"provenance\":\"current-run\"}],\"quickFixArtifacts\":[],\"callerInputArtifacts\":[],\"gateRuns\":[{\"command\":\"corepack pnpm run verify-all\",\"result\":