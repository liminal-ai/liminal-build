r.json\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/shared/contracts/schemas.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/shared/contracts/review-workspace.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/client/browser-api/review-workspace-api.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/client/features/projects/artifact-section.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/errors/codes.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/schemas/review.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/routes/review.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/artifact-review.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/package-review.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/review-workspace.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/projects/platform-store.ts\",\"/Users/leemoore/code/liminal-build-wt-1/convex/schema.ts\",\"/Users/leemoore/code/liminal-build-wt-1/convex/artifacts.ts\",\"/Users/leemoore/code/liminal-build-wt-1/convex/processPackageContexts.ts\",\"/Users/leemoore/code/liminal-build-wt-1/convex/processPackageContextMembers.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/fixtures/artifact-versions.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/fixtures/package-contexts.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/fixtures/package-snapshots.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/fixtures/review-errors.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/review-foundation-contracts.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/process-foundation-contracts.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/package-review-api.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/client/artifact-section.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/client/review-workspace-api.test.ts\"],\"reviewScopeSummary\":\"Initial verification of Story 0 foundation against the story, full Epic 5 tech-design set, and test plan. I inspected the shared artifact/review contracts, review routes and services, Convex package-context persistence, Story 0 fixtures/tests, and the implementor artifact, then ran the requested story and epic gates.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"S0-F1\",\"severity\":\"major\",\"title\":\"Shared package-member vocabulary still uses legacy `versionId` instead of the Story 0 `artifactVersionId` field\",\"evidence\":\"Story 0 defines package members with `artifactVersionId` as the pinned version identifier (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:105-113`). The shipped browser contract still exports `packageMemberSchema.versionId` (`apps/platform/shared/contracts/review-workspace.ts:263-271`), `package-review.service.ts` consumes `member.versionId` throughout (`apps/platform/server/services/review/package-review.service.ts:30-61,118-123`), and the Story 0 implementor artifact explicitly records this as a deferred spec deviation (`.../artifacts/00-foundation/001-implementor.json`).\",\"affectedFiles\":[\"apps/platform/shared/contracts/review-workspace.ts\",\"apps/platform/server/services/review/package-review.service.ts\",\"tests/fixtures/package-snapshots.ts\",\"tests/service/server/package-review-api.test.ts\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/001-implementor.json\"],\"requirementIds\":[\"S0-PACKAGE-MEMBER-VOCAB\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"S0-F2\",\"severity\":\"major\",\"title\":\"Review endpoints still collapse missing-version and missing-member cases into generic or legacy outcomes\",\"evidence\":\"Story 0 requires route-level distinction among `REVIEW_TARGET_NOT_FOUND`, `ARTIFACT_VERSION_NOT_FOUND`, `PACKAGE_MEMBER_UNAVAILABLE`, and `PACKAGE_MEMBER_NOT_ALLOWED` (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:123-140`). In the implementation, `artifact-review.service.ts` returns `null` when an explicit `versionId` is missing (`apps/platform/server/services/review/artifact-review.service.ts:113-120`), and `routes/review.ts` converts any `null` artifact/package lookup into `404 REVIEW_TARGET_NOT_FOUND` (`apps/platform/server/routes/review.ts:287-301,364-378`). Bounded workspace degradation is also hard-coded to `REVIEW_TARGET_NOT_FOUND` (`apps/platform/server/services/review/review-workspace.service.ts:159-183`), while package-member degradation still emits legacy `REVIEW_MEMBER_UNAVAILABLE` (`apps/platform/server/services/review/package-review.service.ts:19-27,125-132`). The passing server suite locks this behavior in by expecting `200` plus `REVIEW_MEMBER_UNAVAILABLE` for a missing explicit `memberId` (`tests/service/server/package-review-api.test.ts:539-579`).\",\"affectedFiles\":[\"apps/platform/server/services/review/artifact-review.service.ts\",\"apps/platform/server/services/review/package-review.service.ts\",\"apps/platform/server/services/review/review-workspace.service.ts\",\"apps/platform/server/routes/review.ts\",\"tests/service/server/package-review-api.test.ts\"],\"requirementIds\":[\"S0-REVIEW-ERROR-TAXONOMY\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"S0-F3\",\"severity\":\"minor\",\"title\":\"The new canonical package-context upsert invariant is not backed by the planned automated proof\",\"evidence\":\"Story 0 makes one-current-package-context semantics, duplicate cleanup, and idempotent upsert part of the foundation (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:115-121,136-138`). The Convex mutation does implement canonical-row selection, duplicate cleanup, and idempotent early return (`convex/processPackageContexts.ts:110-237`), but the authoritative test inventory assigns that proof to `convex/processPackageContexts.test.ts` (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md:160-161,236-240`) and that file is absent. I also found no reviewed test that exercises `upsertCurrentProcessPackageContext`.\",\"affectedFiles\":[\"convex/processPackageContexts.ts\",\"tests/service/server/process-foundation-contracts.test.ts\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md\"],\"requirementIds\":[\"S0-PACKAGE-CONTEXT-CANONICAL-UPSERT\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":false}],\"openFindings\":[{\"id\":\"S0-F1\",\"severity\":\"major\",\"title\":\"Shared package-member vocabulary still uses legacy `versionId` instead of the Story 0 `artifactVersionId` field\",\"evidence\":\"Story 0 defines package members with `artifactVersionId` as the pinned version identifier (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:105-113`). The shipped browser contract still exports `packageMemberSchema.versionId` (`apps/platform/shared/contracts/review-workspace.ts:263-271`), `package-review.service.ts` consumes `member.versionId` throughout (`apps/platform/server/services/review/package-review.service.ts:30-61,118-123`), and the Story 0 implementor artifact explicitly records this as a deferred spec deviation (`.../artifacts/00-foundation/001-implementor.json`).\",\"affectedFiles\":[\"apps/platform/shared/contracts/review-workspace.ts\",\"apps/platform/server/services/review/package-review.service.ts\",\"tests/fixtures/package-snapshots.ts\",\"tests/service/server/package-review-api.test.ts\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/001-implementor.json\"],\"requirementIds\":[\"S0-PACKAGE-MEMBER-VOCAB\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"S0-F2\",\"severity\":\"major\",\"title\":\"Review endpoints still collapse missing-version and missing-member cases into generic or legacy outcomes\",\"evidence\":\"Story 0 requires route-level distinction among `REVIEW_TARGET_NOT_FOUND`, `ARTIFACT_VERSION_NOT_FOUND`, `PACKAGE_MEMBER_UNAVAILABLE`, and `PACKAGE_MEMBER_NOT_ALLOWED` (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:123-140`). In the implementation, `artifact-review.service.ts` returns `null` when an explicit `versionId` is missing (`apps/platform/server/services/review/artifact-review.service.ts:113-120`), and `routes/review.ts` converts any `null` artifact/package lookup into `404 REVIEW_TARGET_NOT_FOUND` (`apps/platform/server/routes/review.ts:287-301,364-378`). Bounded workspace degradation is also hard-coded to `REVIEW_TARGET_NOT_FOUND` (`apps/platform/server/services/review/review-workspace.service.ts:159-183`), while package-member degradation still emits legacy `REVIEW_MEMBER_UNAVAILABLE` (`apps/platform/server/services/review/package-review.service.ts:19-27,125-132`). The passing server suite locks this behavior in by expecting `200` plus `REVIEW_MEMBER_UNAVAILABLE` for a missing explicit `memberId` (`tests/service/server/package-review-api.test.ts:539-579`).\",\"affectedFiles\":[\"apps/platform/server/services/review/artifact-review.service.ts\",\"apps/platform/server/services/review/package-review.service.ts\",\"apps/platform/server/services/review/review-workspace.service.ts\",\"apps/platform/server/routes/review.ts\",\"tests/service/server/package-review-api.test.ts\"],\"requirementIds\":[\"S0-REVIEW-ERROR-TAXONOMY\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"S0-F3\",\"severity\":\"minor\",\"title\":\"The new canonical package-context upsert invariant is not backed by the planned automated proof\",\"evidence\":\"Story 0 makes one-current-package-context semantics, duplicate cleanup, and idempotent upsert part of the foundation (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:115-121,136-138`). The Convex mutation does implement canonical-row selection, duplicate cleanup, and idempotent early return (`convex/processPackageContexts.ts:110-237`), but the authoritative test inventory assigns that proof to `convex/processPackageContexts.test.ts` (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md:160-161,236-240`) and that file is absent. I also found no reviewed test that exercises `upsertCurrentProcessPackageContext`.\",\"affectedFiles\":[\"convex/processPackageContexts.ts\",\"tests/service/server/process-foundation-contracts.test.ts\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md\"],\"requirementIds\":[\"S0-PACKAGE-CONTEXT-CANONICAL-UPSERT\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":false}],\"requirementCoverage\":{\"verified\":[\"S0-ARTIFACT-SUMMARY-VOCAB\",\"S0-VERSION-PROVENANCE-VOCAB\"],\"unverified\":[\"S0-PACKAGE-MEMBER-VOCAB\",\"S0-PACKAGE-CONTEXT-CANONICAL-UPSERT\",\"S0-REVIEW-ERROR-TAXONOMY\"]},\"gatesRun\":[{\"command\":\"corepack pnpm run green-verify\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run verify-all\",\"result\":\"pass\"}],\"mockOrShimAuditFindings\":[\"Server review/package tests rely heavily on `InMemoryPlatformStore`, and that shim still models package members with legacy `versionId` plus `REVIEW_MEMBER_UNAVAILABLE`; the test double currently reinforces the Story 0 vocabulary drift instead of exposing it.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[\"Was the compatibility bridge for legacy `versionId` / `REVIEW_MEMBER_UNAVAILABLE` intentionally accepted for Story 0? The story text and test plan both read as exact aligned vocabulary, not a transitional bridge.\"],\"additionalObservations\":[\"Both requested gates passed, but the passing suites currently validate the compatibility bridge rather than the exact Story 0 package-member and error-taxonomy contracts.\",\"`guard:no-test-changes` and `test:e2e` are scaffolded skips in this repo, so they did not contribute additional Story 0 behavior coverage.\",\"The implementor artifact already lists the `versionId` and `REVIEW_MEMBER_UNAVAILABLE` bridges as spec deviations, which matches Findings S0-F1 and S0-F2.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/006-verify.json\"}],\"startedAt\":\"2026-04-26T21:11:06.042Z\",\"finishedAt\":\"2026-04-26T21:20:41.042Z\"}\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/02-versioned-checkpoint-realignment/012-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"ok\",\"outcome\":\"pass\",\"result\":{\"resultId\":\"73d05191-d0f8-43ba-956c-716c15100606\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.4\",\"sessionId\":\"019dcbe3-6e7e-7e71-9a99-76b2af2b5ef1\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019dcbe3-6e7e-7e71-9a99-76b2af2b5ef1\",\"storyId\":\"02-versioned-checkpoint-realignment\"},\"mode\":\"followup\",\"story\":{\"id\":\"02-versioned-checkpoint-realignment\",\"title\":\"Story 2: Versioned Checkpoint Realignment\"},\"artifactsRead\":[\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/02-versioned-checkpoint-realignment.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-client.md\",\"apps/platform/client/features/review/artifact-review-panel.ts\",\"apps/platform/client/features/review/version-switcher.ts\",\"apps/platform/server/services/review/artifact-review.service.ts\",\"tests/service/client/artifact-review-panel.test.ts\",\"tests/service/client/version-switcher.test.ts\",\"tests/service/server/artifact-review-api.test.ts\"],\"reviewScopeSummary\":\"Follow-up review stayed focused on prior finding SV-02-001 and the directly touched provenance surfaces: selected-version rendering, version-switcher rendering, and the related client/server assertions for AC-2.2.\",\"priorFindingStatuses\":[{\"id\":\"SV-02-001\",\"status\":\"resolved\",\"rationale\":\"The producing-process provenance is now rendered in both user-facing review surfaces: the selected-version panel shows a `Produced by` row (apps/platform/client/features/review/artifact-review-panel.ts:76-86) and every version-switcher entry includes `Produced by` metadata (apps/platform/client/features/review/version-switcher.ts:107-120). The follow-up tests now assert that provenance is returned by the API and rendered in the client for current and prior versions (tests/service/server/artifact-review-api.test.ts:165-197,324-333; tests/service/client/artifact-review-panel.test.ts:30-62,182-212; tests/service/client/version-switcher.test.ts:85-104).\"}],\"newFindings\":[],\"openFindings\":[],\"requirementCoverage\":{\"verified\":[\"AC-2.1\",\"TC-2.1a\",\"TC-2.1b\",\"AC-2.2\",\"TC-2.2a\",\"TC-2.2b\",\"AC-2.3\",\"TC-2.3a\",\"TC-2.3b\"],\"unverified\":[]},\"gatesRun\":[{\"command\":\"corepack pnpm exec vitest run tests/service/client/artifact-review-panel.test.ts tests/service/client/version-switcher.test.ts tests/service/server/artifact-review-api.test.ts --environment jsdom\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run green-verify\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run verify-all\",\"result\":\"pass\"}],\"mockOrShimAuditFindings\":[\"No production-path mocks, shims, or fake adapters were introduced in the touched follow-up surfaces; the fix is pure client rendering over the existing review payload contract.\",\"Test doubles remain confined to fixtures and in-memory/test harnesses; no new fake provenance source leaked into production code paths.\"],\"recommendedNextStep\":\"pass\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[],\"additionalObservations\":[\"The follow-up change is narrowly scoped to rendering and assertions; I did not find a new regression on the touched surfaces.\",\"`verify-all` still passes with the existing scaffold-only `test:e2e` skip message, so there is still no executable browser-automation lane beyond service/client and integration tests.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/02-versioned-checkpoint-realignment/012-verify.json\"}],\"startedAt\":\"2026-04-26T22:36:10.803Z\",\"finishedAt\":\"2026-04-26T22:37:41.087Z\"}\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/013-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"ok\",\"outcome\":\"revise\",\"result\":{\"resultId\":\"35acfd8b-d3a1-4fa6-bddd-2f49a1c97630\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.4\",\"sessionId\":\"019dcba1-b6cb-7d52-8da8-205c598a49ab\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019dcba1-b6cb-7d52-8da8-205c598a49ab\",\"storyId\":\"00-foundation\"},\"mode\":\"followup\",\"story\":{\"id\":\"00-foundation\",\"title\":\"Story 0: Foundation\"},\"artifactsRead\":[\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md\",\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design.md\",\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-client.md\",\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-server.md\",\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/shared/contracts/review-workspace.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/artifact-review.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/package-review.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/review-workspace.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/routes/review.ts\",\"/Users/leemoore/code/liminal-build-wt-1/apps/platform/server/services/review/export.service.ts\",\"/Users/leemoore/code/liminal-build-wt-1/convex/processPackageContexts.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/fixtures/package-snapshots.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/fixtures/review-errors.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/artifact-review-api.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/package-review-api.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/review-workspace-api.test.ts\",\"/Users/leemoore/code/liminal-build-wt-1/tests/service/server/process-foundation-contracts.test.ts\"],\"reviewScopeSummary\":\"Follow-up verification focused on convergence of prior findings S0-F1 through S0-F3. I re-read the directly touched contract, review-service, route, and test surfaces, checked the package-context proof gap, and reran both required gates.\",\"priorFindingStatuses\":[{\"id\":\"S0-F1\",\"status\":\"resolved\",\"rationale\":\"`packageMemberSchema` now requires `artifactVersionId` and no longer exposes the legacy `versionId` member field (`apps/platform/shared/contracts/review-workspace.ts:262-270`). `package-review.service.ts` now reads `member.artifactVersionId` end-to-end (`apps/platform/server/services/review/package-review.service.ts:30-61,118-123`), and updated package-review fixtures/tests use the renamed field (`tests/fixtures/package-snapshots.ts:9-27`, `tests/service/server/package-review-api.test.ts:67-87`).\"},{\"id\":\"S0-F2\",\"status\":\"resolved\",\"rationale\":\"Legacy `REVIEW_MEMBER_UNAVAILABLE` is removed from the shared review-target error vocabulary (`apps/platform/shared/contracts/review-workspace.ts:130-137`). Direct artifact review now returns `404 ARTIFACT_VERSION_NOT_FOUND` for a missing explicit version (`apps/platform/server/services/review/artifact-review.service.ts:15-24,127-137`; `tests/service/server/artifact-review-api.test.ts:230-257`), direct package review now returns `404 PACKAGE_MEMBER_UNAVAILABLE` for a missing explicit member (`apps/platform/server/routes/review.ts:393-410`; `tests/service/server/package-review-api.test.ts:554-567`), and workspace bootstrap preserves bounded unavailable state with `ARTIFACT_VERSION_NOT_FOUND` (`apps/platform/server/services/review/review-workspace.service.ts:142-160,175-202`; `tests/service/server/review-workspace-api.test.ts:407-434`).\"},{\"id\":\"S0-F3\",\"status\":\"still-open\",\"rationale\":\"The package-context mutation still implements canonical selection, duplicate cleanup, and idempotent return (`convex/processPackageContexts.ts:110-237`), but the planned proof remains absent: `convex/processPackageContexts.test.ts` still does not exist, and no reviewed test references `upsertCurrentProcessPackageContext`. The test plan still names that file as the authoritative owner for this coverage (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md:160-161,236-240`).\"}],\"newFindings\":[],\"openFindings\":[{\"id\":\"S0-F3\",\"severity\":\"minor\",\"title\":\"The new canonical package-context upsert invariant is not backed by the planned automated proof\",\"evidence\":\"Story 0 makes one-current-package-context semantics, duplicate cleanup, and idempotent upsert part of the foundation (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/00-foundation.md:115-121,136-138`). The Convex mutation does implement canonical-row selection, duplicate cleanup, and idempotent early return (`convex/processPackageContexts.ts:110-237`), but the authoritative test inventory assigns that proof to `convex/processPackageContexts.test.ts` (`docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md:160-161,236-240`) and that file is still absent. I also found no reviewed test that exercises `upsertCurrentProcessPackageContext`.\",\"affectedFiles\":[\"convex/processPackageContexts.ts\",\"tests/service/server/process-foundation-contracts.test.ts\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md\"],\"requirementIds\":[\"S0-PACKAGE-CONTEXT-CANONICAL-UPSERT\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":false}],\"requirementCoverage\":{\"verified\":[\"S0-ARTIFACT-SUMMARY-VOCAB\",\"S0-VERSION-PROVENANCE-VOCAB\",\"S0-PACKAGE-MEMBER-VOCAB\",\"S0-REVIEW-ERROR-TAXONOMY\"],\"unverified\":[\"S0-PACKAGE-CONTEXT-CANONICAL-UPSERT\"]},\"gatesRun\":[{\"command\":\"corepack pnpm run green-verify\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run verify-all\",\"result\":\"pass\"}],\"mockOrShimAuditFindings\":[],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"quick-fix\",\"openQuestions\":[],\"additionalObservations\":[\"The follow-up patch added explicit server coverage for the missing-version case; the server suite now passes with 239 tests.\",\"Both requested gates passed again. `guard:no-test-changes` and `test:e2e` remain scaffolded skips in this repo, so they did not add proof for the package-context mutation invariant.\",\"No new regressions were introduced in the touched Story 0 contract or review-route surfaces during this follow-up.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/013-verify.json\"}],\"startedAt\":\"2026-04-26T21:37:26.700Z\",\"finishedAt\":\"2026-04-26T21:40:19.206Z\"}\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/02-versioned-checkpoint-realignment/006-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"ok\",\"outcome\":\"revise\",\"result\":{\"resultId\":\"e396da7e-bec9-4fb9-9957-0ec2600a6f0b\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.4\",\"sessionId\":\"019dcbe3-6e7e-7e71-9a99-76b2af2b5ef1\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019dcbe3-6e7e-7e71-9a99-76b2af2b5ef1\",\"storyId\":\"02-versioned-checkpoint-realignment\"},\"mode\":\"initial\",\"story\":{\"id\":\"02-versioned-checkpoint-realignment\",\"title\":\"Story 2: Versioned Checkpoint Realignment\"},\"artifactsRead\":[\"convex/_generated/ai/guidelines.md\",\"docs/onboarding/current-state-index.md\",\"docs/onboarding/current-state-project-and-process-shell.md\",\"docs/onboarding/current-state-process-work-surface.md\",\"docs/onboarding/current-state-tech-design.md\",\"docs/onboarding/current-state-code-map.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/02-versioned-checkpoint-realignment.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-server.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-client.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md\",\"convex/schema.ts\",\"convex/artifacts.ts\",\"convex/artifacts.test.ts\",\"apps/platform/shared/contracts/schemas.ts\",\"apps/platform/shared/contracts/review-workspace.ts\",\"apps/platform/server/services/projects/platform-store.ts\",\"apps/platform/server/services/projects/readers/artifact-section.reader.ts\",\"apps/platform/server/services/processes/readers/materials-section.reader.ts\",\"apps/platform/server/services/review/artifact-review.service.ts\",\"apps/platform/client/features/projects/artifact-section.ts\",\"apps/platform/client/features/review/artifact-review-panel.ts\",\"apps/platform/client/features/review/version-switcher.ts\",\"tests/service/server/project-shell-bootstrap-api.test.ts\",\"tests/service/server/artifact-review-api.test.ts\",\"tests/service/server/process-work-surface-api.test.ts\",\"tests/service/client/artifact-review-panel.test.ts\",\"tests/service/client/version-switcher.test.ts\",\"tests/integration/review-workspace.test.ts\"],\"reviewScopeSummary\":\"Read the Story 2 spec plus the full Epic 5 tech-design/test-plan set, then verified the checkpoint write path, latest-version summary projections, artifact review provenance payloads, and the shipped review UI/client coverage for Versioned Checkpoint Realignment.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"SV-02-001\",\"severity\":\"major\",\"title\":\"Review UI never surfaces the producing-process provenance that Story 2 adds to artifact versions\",\"evidence\":\"Story 2 defines `producedByProcessId` and `producedByProcessDisplayLabel` as the version-provenance fields that make the producing process visible later (docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/02-versioned-checkpoint-realignment.md:56-98), and the client design says selected-version metadata and version-switcher rows must expose them (docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-client.md:343-345,402-407). The server now populates both fields on every version summary and selected-version detail (apps/platform/server/services/review/artifact-review.service.ts:141-165,205-326), but the shipped review UI never reads either field: apps/platform/client/features/review/artifact-review-panel.ts:28-106 renders only artifact/version labels and createdAt, and apps/platform/client/features/review/version-switcher.ts:25-109 renders only versionLabel/current/selected plus createdAt. A repo-wide search found no production client consumer of `producedByProcessId` or `producedByProcessDisplayLabel` under apps/platform/client/features, so a user reviewing earlier revisions still cannot see which process produced each version.\",\"affectedFiles\":[\"apps/platform/client/features/review/artifact-review-panel.ts\",\"apps/platform/client/features/review/version-switcher.ts\",\"tests/service/client/artifact-review-panel.test.ts\",\"tests/service/client/version-switcher.test.ts\"],\"requirementIds\":[\"AC-2.2\",\"TC-2.2a\",\"TC-2.2b\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"openFindings\":[{\"id\":\"SV-02-001\",\"severity\":\"major\",\"title\":\"Review UI never surfaces the producing-process provenance that Story 2 adds to artifact versions\",\"evidence\":\"Story 2 defines `producedByProcessId` and `producedByProcessDisplayLabel` as the version-provenance fields that make the producing process visible later (docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/02-versioned-checkpoint-realignment.md:56-98), and the client design says selected-version metadata and version-switcher rows must expose them (docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-client.md:343-345,402-407). The server now populates both fields on every version summary and selected-version detail (apps/platform/server/services/review/artifact-review.service.ts:141-165,205-326), but the shipped review UI never reads either field: apps/platform/client/features/review/artifact-review-panel.ts:28-106 renders only artifact/version labels and createdAt, and apps/platform/client/features/review/version-switcher.ts:25-109 renders only versionLabel/current/selected plus createdAt. A repo-wide search found no production client consumer of `producedByProcessId` or `producedByProcessDisplayLabel` under apps/platform/client/features, so a user reviewing earlier revisions still cannot see which process produced each version.\",\"affectedFiles\":[\"apps/platform/client/features/review/artifact-review-panel.ts\",\"apps/platform/client/features/review/version-switcher.ts\",\"tests/service/client/artifact-review-panel.test.ts\",\"tests/service/client/version-switcher.test.ts\"],\"requirementIds\":[\"AC-2.2\",\"TC-2.2a\",\"TC-2.2b\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"AC-2.1\",\"TC-2.1a\",\"TC-2.1b\",\"AC-2.3\",\"TC-2.3a\",\"TC-2.3b\"],\"unverified\":[\"AC-2.2\",\"TC-2.2a\",\"TC-2.2b\"]},\"gatesRun\":[{\"command\":\"corepack pnpm exec vitest run convex/artifacts.test.ts tests/service/server/project-shell-bootstrap-api.test.ts tests/service/server/artifact-review-api.test.ts tests/service/server/process-work-surface-api.test.ts --environment node\",\"result\":\"pass\"},{\"command\":\"corepack pnpm exec vitest run tests/service/client/artifact-review-panel.test.ts tests/service/client/version-switcher.test.ts --environment jsdom\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run green-verify\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run verify-all\",\"result\":\"pass\"}],\"mockOrShimAuditFindings\":[\"No production-path mocks, shims, or fake adapters were found in the reviewed Story 2 runtime paths; the Convex-backed implementation uses real store/query surfaces.\",\"Test-only shim note: InMemoryPlatformStore still fabricates a synthetic artifact version from legacy artifact-summary fields when no explicit version rows are seeded (apps/platform/server/services/projects/platform-store.ts:2965-2990). That behavior is limited to tests/in-memory flows, but it can hide provenance regressions if fixtures omit `artifactVersionsByArtifactId`.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[],\"additionalObservations\":[\"AC-2.1 and AC-2.3 are otherwise in good shape: convex/artifacts.ts:22-26 and 401-429 keep artifact identity project-scoped while appending new version rows, and convex/artifacts.ts:46-70 plus apps/platform/server/services/processes/readers/materials-section.reader.ts:19-50 make both project-shell and process-material reads consume latest-version projections.\",\"`verify-all` passed, but the `test:e2e` lane is still scaffold-only and prints a skip message, so there is no browser-automation proof for the Story 2 review flow.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/02-versioned-checkpoint-realignment/006-verify.json\"}],\"startedAt\":\"2026-04-26T22:22:52.904Z\",\"finishedAt\":\"2026-04-26T22:31:05.793Z\"}\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/05-reopen-and-degraded-provenance-states/006-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"blocked\",\"outcome\":\"block\",\"result\":{\"resultId\":\"f87102e1-1e54-40dd-b345-9cc79f384c99\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.4\",\"sessionId\":\"019dcc31-a561-72a3-aea4-bfeecee1f4ad\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019dcc31-a561-72a3-aea4-bfeecee1f4ad\",\"storyId\":\"05-reopen-and-degraded-provenance-states\"},\"mode\":\"initial\",\"story\":{\"id\":\"05-reopen-and-degraded-provenance-states\",\"title\":\"Story 5: Reopen and Degraded Provenance States\"},\"artifactsRead\":[\"convex/_generated/ai/guidelines.md\",\"docs/onboarding/current-state-index.md\",\"docs/onboarding/current-state-project-and-process-shell.md\",\"docs/onboarding/current-state-process-work-surface.md\",\"docs/onboarding/current-state-tech-design.md\",\"docs/onboarding/current-state-code-map.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/stories/05-reopen-and-degraded-provenance-states.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-client.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/tech-design-server.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/test-plan.md\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/05-reopen-and-degraded-provenance-states/001-implementor.json\",\"docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/05-reopen-and-degraded-provenance-states/progress/006-verify.status.json\",\"apps/platform/client/app/bootstrap.ts\",\"apps/platform/client/browser-api/review-workspace-api.ts\",\"apps/platform/client/features/review/review-workspace-page.ts\",\"apps/platform/client/features/review/package-review-panel.ts\",\"apps/platform/server/routes/review.ts\",\"apps/platform/server/services/review/review-workspace.service.ts\",\"apps/platform/server/services/review/artifact-review.service.ts\",\"apps/platform/server/services/review/package-review.service.ts\",\"apps/platform/server/services/processes/readers/materials-section.reader.ts\",\"apps/platform/server/services/processes/process-work-surface.service.ts\",\"apps/platform/server/services/projects/platform-store.ts\",\"tests/service/server/process-work-surface-api.test.ts\",\"tests/service/server/review-workspace-api.test.ts\",\"tests/service/server/artifact-review-api.test.ts\",\"tests/service/server/package-review-api.test.ts\",\"tests/service/server/review-export-api.test.ts\",\"tests/service/client/review-workspace-page.test.ts\",\"tests/service/client/version-switcher.test.ts\",\"tests/service/client/package-member-nav.test.ts\",\"tests/integration/review-workspace.test.ts\",\"tests/integration/process-work-surface.test.ts\"],\"reviewScopeSummary\":\"Verified Story 5 against the story, full tech-design set, test plan, current onboarding baseline, review/package client and server code paths, process materials read path, and the main server/client/integration tests for reopen, degraded provenance, and error-classification behavior.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"SV-05-001\",\"severity\":\"major\",\"title\":\"Stale package-member selections collapse the review workspace instead of reloading bounded degraded state\",\"evidence\":\"The client already has a workspace-reload fallback for stale artifact-version selections (`apps/platform/client/app/bootstrap.ts:1019-1065`, `1188-1238`), but `selectPackageMember()` does not use it. On any `ApiRequestError` from `GET /review/packages/:packageId?memberId=...`, it patches `reviewWorkspace.error` directly (`apps/platform/client/app/bootstrap.ts:1266-1352`). The server intentionally returns `404 PACKAGE_MEMBER_UNAVAILABLE` for an explicit stale member (`apps/platform/server/routes/review.ts:393-410`; covered by `tests/service/server/package-review-api.test.ts:557-585`), while workspace bootstrap intentionally preserves the package shell with `target.status: 'ready'` and `selectedMember.status: 'unavailable'` (`tests/integration/review-workspace.test.ts:868-901`). Because `apps/platform/client/features/review/review-workspace-page.ts:223-235` treats any `reviewWorkspace.error` as a page-level failure, the stale-member click path hides the rest of the package and available targets instead of showing the bounded degraded state that `apps/platform/client/features/review/package-review-panel.ts:65-96` already supports. Existing client coverage only exercises the artifact-version fallback (`tests/service/client/version-switcher.test.ts:321-390`); `tests/service/client/package-member-nav.test.ts:168-244` covers only out-of-order successful responses, so this regression is currently untested.\",\"affectedFiles\":[\"apps/platform/client/app/bootstrap.ts\",\"apps/platform/client/features/review/review-workspace-page.ts\",\"tests/service/client/package-member-nav.test.ts\"],\"requirementIds\":[\"AC-5.2\",\"TC-5.2b\",\"AC-5.4\",\"TC-5.4b\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true}],\"openFindings\":[{\"id\":\"SV-05-001\",\"severity\":\"major\",\"title\":\"Stale package-member selections collapse the review workspace instead of reloading bounded degraded state\",\"evidence\":\"The client already has a workspace-reload fallback for stale artifact-version selections (`apps/platform/client/app/bootstrap.ts:1019-1065`, `1188-1238`), but `selectPackageMember()` does not use it. On any `ApiRequestError` from `GET /review/packages/:packageId?memberId=...`, it patches `reviewWorkspace.error` directly (`apps/platform/client/app/bootstrap.ts:1266-1352`). The server intentionally returns `404 PACKAGE_MEMBER_UNAVAILABLE` for an explicit stale member (`apps/platform/server/routes/review.ts:393-410`; covered by `tests/service/server/package-review-api.test.ts:557-585`), while workspace bootstrap intentionally preserves the package shell with `target.status: 'ready'` and `selectedMember.status: 'unavailable'` (`tests/integration/review-workspace.test.ts:868-901`). Because `apps/platform/client/features/review/review-workspace-page.ts:223-235` treats any `reviewWorkspace.error` as a page-level failure, the stale-member click path hides the rest of the package and available targets instead of showing the bounded degraded state that `apps/platform/client/features/review/package-review-panel.ts:65-96` already supports. Existing client coverage only exercises the artifact-version fallback (`tests/service/client/version-switcher.test.ts:321-390`); `tests/service/client/package-member-nav.test.ts:168-244` covers only out-of-order successful responses, so this regression is currently untested.\",\"affectedFiles\":[\"apps/platform/client/app/bootstrap.ts\",\"apps/platform/client/features/review/review-workspace-page.ts\",\"tests/service/client/package-member-nav.test.ts\"],\"requirementIds\":[\"AC-5.2\",\"TC-5.2b\",\"AC-5.4\",\"TC-5.4b\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"AC-5.1\",\"TC-5.1a\",\"TC-5.1b\",\"AC-5.3\",\"TC-5.3a\",\"TC-5.3b\",\"TC-5.4a\"],\"unverified\":[\"AC-5.2\",\"TC-5.2b\",\"AC-5.4\",\"TC-5.4b\"]},\"gatesRun\":[{\"command\":\"corepack pnpm run green-verify\",\"result\":\"pass\"},{\"command\":\"corepack pnpm run verify-all\",\"result\":\"pass\"}],\"mockOrShimAuditFindings\":[\"No material production-path mocks/shims were found in the reviewed story surfaces; fake auth services, fake Convex contexts, and `InMemoryPlatformStore` usages remained confined to test files.\"],\"recommendedNextStep\":\"block\",\"recommendedFixScope\":\"quick-fix\",\"openQuestions\":[],\"additionalObservations\":[\"Most Story 5 server/bootstrap behavior is already present in the branch; the blocking gap is localized to the client follow-up package-member selection path.\",\"Both verification gates passed, so the stale-member regression currently sits outside automated coverage.\",\"Traceability is somewhat noisy: several relevant tests still use older Story 6-style test names even though they provide Story 5 evidence.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/liminal-build-wt-1/docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/05-reopen-and-degraded-provenance-states/006-verify.json\"}],\"startedAt\":\"2026-04-26T23:48:18.768Z\",\"finishedAt\":\"2026-04-26T23:57:25.290Z\"}\ndocs/spec-build/v2/epics/05--artifact-model-and-review-proven