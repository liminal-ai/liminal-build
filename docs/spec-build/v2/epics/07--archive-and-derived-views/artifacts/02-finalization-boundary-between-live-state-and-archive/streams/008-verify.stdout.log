\t  userId: 'user:archive-finalization',\n    24\t  workosUserId: 'archive-finalization',\n    25\t  email: 'lee@example.com',\n    26\t  displayName: 'Lee Moore',\n    27\t};\n    28\t\n    29\tconst projectId = 'project-archive-finalization';\n    30\tconst processId = 'process-archive-finalization';\n    31\t\n    32\tconst projectSummary = projectSummarySchema.parse({\n    33\t  projectId,\n    34\t  name: 'Archive Finalization Story',\n    35\t  ownerDisplayName: 'Lee Moore',\n    36\t  role: 'owner',\n    37\t  processCount: 1,\n    38\t  artifactCount: 0,\n    39\t  sourceAttachmentCount: 0,\n    40\t  lastUpdatedAt: '2026-05-04T09:00:00.000Z',\n    41\t});\n    42\t\n    43\tfunction buildStore(args: { processStatus?: 'draft' | 'waiting' } = {}) {\n    44\t  const process =\n    45\t    args.processStatus === 'waiting'\n    46\t      ? processSummarySchema.parse({\n    47\t          ...waitingProcessFixture,\n    48\t          processId,\n    49\t          displayLabel: 'Waiting archive process',\n    50\t          updatedAt: '2026-05-04T09:01:00.000Z',\n    51\t        })\n    52\t      : processSummarySchema.parse({\n    53\t          ...draftProcessFixture,\n    54\t          processId,\n    55\t          displayLabel: 'Draft archive process',\n    56\t          updatedAt: '2026-05-04T09:01:00.000Z',\n    57\t        });\n    58\t\n    59\t  return new InMemoryPlatformStore({\n    60\t    accessibleProjectsByUserId: {\n    61\t      [actor.userId]: [projectSummary],\n    62\t    },\n    63\t    projectAccessByProjectId: {\n    64\t      [projectId]: {\n    65\t        kind: 'accessible',\n    66\t        project: projectSummary,\n    67\t      },\n    68\t    },\n    69\t    processesByProjectId: {\n    70\t      [projectId]: [process],\n    71\t    },\n    72\t  });\n    73\t}\n    74\t\n    75\tfunction buildProcessResponseService(platformStore: InMemoryPlatformStore) {\n    76\t  return new ProcessResponseService(\n    77\t    platformStore,\n    78\t 