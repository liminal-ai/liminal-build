seRequestSchema.safeParse(args.body);\n    36\t\n    37\t    if (!parsedBody.success) {\n    38\t      throw new AppError({\n    39\t        code: 'INVALID_PROCESS_RESPONSE',\n    40\t        message: 'Submitted response must include a non-empty clientRequestId and message.',\n    41\t        statusCode: 422,\n    42\t      });\n    43\t    }\n    44\t\n    45\t    const normalizedRequest = this.normalizeRequest(parsedBody.data);\n    46\t    const existing = await this.platformStore.getSubmittedProcessResponse({\n    47\t      processId: access.process.processId,\n    48\t      clientRequestId: normalizedRequest.clientRequestId,\n    49\t    });\n    50\t\n    51\t    if (existing !== null) {\n    52\t      await this.archiveAcceptedUserResponse({\n    53\t        projectId: access.project.projectId,\n    54\t        processId: access.process.processId,\n    55\t        clientRequestId: normalizedRequest.clientRequestId,\n    56\t        historyItem: existing.historyItem,\n    57\t      });\n    58\t      const environment = await this.platformStore.getProcessEnvironmentSummary({\n    59\t        processId: access.process.processId,\n    60\t      });\n    61\t      const process = await buildProcessSurfaceSummaryWithReviewability({\n    62\t        platformStore: this.platformStore,\n    63\t        projectId: access.project.projectId,\n    64\t        process: existing.process,\n    65\t        environment,\n    66\t      });\n    67\t\n    68\t      return submitProcessResponseResponseSchema.parse({\n    69\t        accepted: true,\n    70\t        historyItemId: existing.historyItem.historyItemId,\n    71\t        process,\n    72\t        currentRequest: existing.currentRequest,\n    73\t      });\n    74\t    }\n    75\t\n    76\t    if (!access.process.availableActions.includes('respond')) {\n    77\t      throw new AppError({\n    78\t        code: 'PROCESS_ACTION_NOT_AVAILABLE',\n    79\t        message: 'Respond is not available for this process right now.',\n    80\t        statusCode: 409,\n    81\t      });\n    82\t    }\n    83\t\n    84\t    try {\n    85\t      const result = await this.platformStore.submitProcessResponse({\n    86\t        processId: access.process.processId,\n    87\t        ...normalizedRequest,\n    88\t      });\n    89\t      await this.archiveAcceptedUserResponse({\n    90\t        projectId: access.project.projectId,\n    91\t        processId: access.process.processId,\n    92\t        clientRequestId: normalizedRequest.clientRequestId,\n    93\t        historyItem: result.historyItem,\n    94\t      });\n    95\t      const environment = await this.platformStore.getProcessEnvironmentSummary({\n    96\t        processId: access.process.processId,\n    97\t      });\n    98\t      const process = await buildProcessSurfaceSummaryWithReviewability({\n    99\t        platformStore: this.platformStore,\n   100\t        projectId: access.project.projectId,\n   101\t        process: result.process,\n   102\t        environment,\n   103\t      });\n   104\t\n   105\t      this.processLiveHub.publish({\n   106\t        projectId: access.project.projectId,\n   107\t        processId: access.process.processId,\n   108\t        publication: {\n   109\t          messageType: isTerminalProcessStatus(process.status) ? 'complete' : 'upsert',\n   110\t          completedAt: isTerminalProcessStatus(process.status) ? process.updatedAt : null,\n   111\t          process,\n   112\t          historyItems: [result.historyItem],\n   113\t          currentRequest: result.currentRequest,\n   114\t          environment,\n   115\t        },\n   116\t      });\n   117\t\n   118\t      return submitProcessResponseResponseSchema.parse({\n   119\t        accepted: true,\n   120\t        historyItemId: result.historyItem.historyItemId,\n   121\t        process,\n   122\t        currentRequest: result.currentRequest,\n   123\t      });\n   124\t    } catch (_error) {\n   125\t      throw new AppError({\n   126\t        code: 'PROCESS_ACTION_FAILED',\n   127\t        message:\n   128\t          'The process response could not be completed right now. Try again or reload the page.',\n   129\t        statusCode: 500,\n   130\t      });\n   131\t    }\n   132\t  }\n   133\t\n   134\t  private normalizeRequest(request: SubmitProcessResponseRequest): SubmitProcessResponseRequest {\n   135\t    return {\n   136\t      clientRequestId: request.clientRequestId.trim(),\n   137\t      message: request.message.trim(),\n   138\t    };\n   139\t  }\n   140\t\n   141\t  private async archiveAcceptedUserResponse(args: {\n   142\t    projectId: string;\n   143\t    processId: string;\n   144\t    clientRequestId: string;\n   145\t    historyItem: {\n   146\t      historyItemId: string;\n   147\t      text: string;\n   148\t      createdAt: string;\n   149\t    };\n   150\t  }): Promise<void> {\n   151\t    const bodyText = args.historyItem.text.trim();\n   152\t\n   153\t    await this.archiveFinalizationService.appendFinalizedEntry({\n   154\t      projectId: args.projectId,\n   155\t      processId: args.processId,\n   156\t      entryKind: 'user_message',\n   157\t      finalizationKey: `response:${args.clientRequestId}`,\n   158\t      sourceObjectId: args.historyItem.historyItemId,\n   159\t      bodyText,\n   160\t      bodyData: null,\n   161\t      bodyFormat: bodyText.length > 0 ? 'plain_text' : 'none',\n   162\t      relatedArtifactVersionId: null,\n   163\t      relatedSourceProvenanceId: null,\n   164\t      relatedToolCallId: null,\n   165\t      entryStatus: 'ready',\n   166\t      degradationReason: null,\n   167\t      recordedAt: args.historyItem.createdAt,\n   168\t    });\n   169\t  }\n   170\t}\n   171\t\n   172\tfunction isTerminalProcessStatus(\n   173\t  status: SubmitProcessResponseResponse['process']['status'],\n   174\t): boolean {\n   175\t  return status === 'completed' || status === 'failed' || status === 'interrupted';\n   176\t}\n","exit_code":0,"status":"completed"}}
