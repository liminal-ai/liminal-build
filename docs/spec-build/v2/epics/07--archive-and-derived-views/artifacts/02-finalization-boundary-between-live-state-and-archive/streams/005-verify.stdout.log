{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"node --experimental-strip-types --input-type=module <<'EOF'\nimport { ProcessResponseService } from './apps/platform/server/services/processes/process-response.service.ts';\nimport { ProcessAccessService } from './apps/platform/server/services/processes/process-access.service.ts';\nimport { InMemoryProcessLiveHub } from './apps/platform/server/services/processes/live/process-live-hub.ts';\nimport { InMemoryPlatformStore } from './apps/platform/server/services/projects/platform-store.ts';\nimport { ProjectAccessService } from './apps/platform/server/services/projects/project-access.service.ts';\nimport { ArchiveFinalizationService } from './apps/platform/server/services/archive/archive-finalization.service.ts';\nimport { processSummarySchema, projectSummarySchema } from './apps/platform/shared/contracts/index.ts';\nimport { draftProcessFixture, waitingProcessFixture } from './tests/fixtures/processes.ts';\n\nconst actor = {\n  userId: 'user:archive-finalization',\n  workosUserId: 'archive-finalization',\n  email: 'lee@example.com',\n  displayName: 'Lee Moore',\n};\nconst projectId = 'project-archive-finalization';\nconst processId = 'process-archive-finalization';\nconst projectSummary = projectSummarySchema.parse({\n  projectId,\n  name: 'Archive Finalization Story',\n  ownerDisplayName: 'Lee Moore',\n  role: 'owner',\n  processCount: 1,\n  artifactCount: 0,\n  sourceAttachmentCount: 0,\n  lastUpdatedAt: '2026-05-04T09:00:00.000Z',\n});\nconst process = processSummarySchema.parse({\n  ...waitingProcessFixture,\n  processId,\n  displayLabel: 'Waiting archive process',\n  updatedAt: '2026-05-04T09:01:00.000Z',\n});\nconst store = new InMemoryPlatformStore({\n  accessibleProjectsByUserId: { [actor.userId]: [projectSummary] },\n  projectAccessByProjectId: { [projectId]: { kind: 'accessible', project: projectSummary } },\n  processesByProjectId: { [projectId]: [process] },\n});\nconst responseService = new ProcessResponseService(\n  store,\n  new ProcessAccessService(store, new ProjectAccessService(store)),\n  new InMemoryProcessLiveHub(),\n);\nawait responseService.respond({\n  actor,\n  projectId,\n  processId,\n  body: { clientRequestId: 'req-archive-3', message: 'Keep the archive durable.' },\n});\nconst existing = await store.getSubmittedProcessResponse({ processId, clientRequestId: 'req-archive-3' });\nconst finalizer = new ArchiveFinalizationService(store);\nawait finalizer.appendFromProcessHistoryItem({ projectId, processId, historyItem: existing.historyItem });\nconst page = await store.listArchiveEntries({ processId, limit: 20 });\nconsole.log(JSON.stringify(page.entries.map((entry) => ({finalizationKey: entry.finalizationKey, sourceObjectId: entry.sourceObjectId, bodyText: entry.bodyText})), null, 2));\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
