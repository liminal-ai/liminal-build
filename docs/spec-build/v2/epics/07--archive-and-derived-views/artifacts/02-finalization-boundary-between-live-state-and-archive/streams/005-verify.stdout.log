Item.text);\\n    65\\t\\n    66\\t    return this.appendFinalizedEntry({\\n    67\\t      projectId: args.projectId,\\n    68\\t      processId: args.processId,\\n    69\\t      entryKind,\\n    70\\t      finalizationKey: buildHistoryItemFinalizationKey({\\n    71\\t        entryKind,\\n    72\\t        sourceObjectId: args.historyItem.historyItemId,\\n    73\\t      }),\\n    74\\t      sourceObjectId: args.historyItem.historyItemId,\\n    75\\t      bodyText: bodyFormat === 'none' ? null : args.historyItem.text,\\n    76\\t      bodyData: null,\\n    77\\t      bodyFormat,\\n    78\\t      relatedArtifactVersionId: null,\\n    79\\t      relatedSourceProvenanceId: null,\\n    80\\t      relatedToolCallId: null,\\n    81\\t      entryStatus: 'ready',\\n    82\\t      degradationReason: null,\\n    83\\t      recordedAt: args.historyItem.createdAt,\\n    84\\t    });\\n    85\\t  }\\n    86\\t}\\n    87\\t\\n    88\\tfunction buildHistoryItemFinalizationKey(args: {\\n    89\\t  entryKind: ArchiveEntryKind;\\n    90\\t  sourceObjectId: string;\\n    91\\t}): string {\\n    92\\t  switch (args.entryKind) {\\n    93\\t    case 'user_message':\\n    94\\t      return `response:${args.sourceObjectId}`;\\n    95\\t    case 'model_message':\\n    96\\t      return `model:${args.sourceObjectId}`;\\n    97\\t    case 'process_event':\\n    98\\t      return `event:${args.sourceObjectId}`;\\n    99\\t    default:\\n   100\\t      return `history:${args.sourceObjectId}`;\\n   101\\t  }\\n   102\\t}\\n   103\\t\\n   104\\tfunction toBodyFormat(text: string): ArchiveBodyFormat {\\n   105\\t  return text.trim().length > 0 ? 'plain_text' : 'none';\\n   106\\t}\\n   107\\t\\n   108\\tfunction normalizeOptionalString(value: string | null | undefined): string | null {\\n   109\\t  const trimmed = value?.trim() ?? '';\\n   110\\t  return trimmed.length > 0 ? trimmed : null;\\n   111\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n26:{\"type\":\"item.started\",\"item\":{\"id\":\