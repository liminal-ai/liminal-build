 127\t    ).resolves.toBeNull();\n   128\t\n   129\t    const archivePage = await platformStore.listArchiveEntries({\n   130\t      processId,\n   131\t      limit: 20,\n   132\t    });\n   133\t\n   134\t    expect(archivePage.entries).toEqual([]);\n   135\t  });\n   136\t\n   137\t  it('TC-2.2b incomplete tool result excluded', async () => {\n   138\t    const platformStore = buildStore();\n   139\t    const archiveFinalizationService = new ArchiveFinalizationService(platformStore);\n   140\t\n   141\t    await expect(\n   142\t      archiveFinalizationService.appendFinalizedEntry({\n   143\t        projectId,\n   144\t        processId,\n   145\t        entryKind: 'tool_result',\n   146\t        finalizationKey: 'tool:lint:result',\n   147\t        sourceObjectId: 'tool-result-1',\n   148\t        bodyText: null,\n   149\t        bodyData: {\n   150\t          jsonText: '{\"stdout\":\"ok\"}',\n   151\t        },\n   152\t        bodyFormat: 'structured',\n   153\t        relatedArtifactVersionId: null,\n   154\t        relatedSourceProvenanceId: null,\n   155\t        relatedToolCallId: null,\n   156\t        entryStatus: 'ready',\n   157\t        degradationReason: null,\n   158\t        recordedAt: '2026-05-04T09:02:00.000Z',\n   159\t      }),\n   160\t    ).rejects.toThrow('relatedToolCallId');\n   161\t\n   162\t    const archivePage = await platformStore.listArchiveEntries({\n   163\t      processId,\n   164\t      limit: 20,\n   165\t    });\n   166\t\n   167\t    expect(archivePage.entries).toEqual([]);\n   168\t  });\n   169\t\n   170\t  it('TC-2.3a completed live object archived once through finalization service', async () => {\n   171\t    const platformStore = buildStore({\n   172\t      processStatus: 'waiting',\n   173\t    });\n   174\t    const processResponseService = buildProcessResponseService(platformStore);\n   175\t\n   176\t    await processResponseService.respond({\n   177\t      actor,\n   178\t      projectId,\n   179\t      processId,\n