ecutionResult;\n   228\t      }): Promise<{ historyItems: Array<{ historyItemId: string }> }>;\n   229\t    };\n   230\t\n   231\t    await applyExecutionResultSideEffects.applyExecutionResultSideEffects({\n   232\t      projectId,\n   233\t      processId,\n   234\t      executionResult,\n   235\t    });\n   236\t    await applyExecutionResultSideEffects.applyExecutionResultSideEffects({\n   237\t      projectId,\n   238\t      processId,\n   239\t      executionResult,\n   240\t    });\n   241\t\n   242\t    const [archivePage, historyItems] = await Promise.all([\n   243\t      platformStore.listArchiveEntries({\n   244\t        processId,\n   245\t        limit: 20,\n   246\t      }),\n   247\t      platformStore.listProcessHistoryItems({\n   248\t        processId,\n   249\t      }),\n   250\t    ]);\n   251\t\n   252\t    expect(archivePage.entries).toMatchObject([\n   253\t      {\n   254\t        entryKind: 'model_message',\n   255\t        finalizationKey: 'model:runtime-model-1',\n   256\t        sourceObjectId: 'runtime-model-1',\n   257\t      },\n   258\t    ]);\n   259\t    expect(archivePage.entries).toHaveLength(1);\n   260\t    expect(historyItems).toHaveLength(2);\n   261\t  });\n   262\t\n   263\t  it('maps finalized compatible process-history items into canonical archive entries only when safe', async () => {\n   264\t    const platformStore = buildStore();\n   265\t    const archiveFinalizationService = new ArchiveFinalizationService(platformStore);\n   266\t\n   267\t    const archiveEntry = await archiveFinalizationService.appendFromProcessHistoryItem({\n   268\t      projectId,\n   269\t      processId,\n   270\t      historyItem: processMessageHistoryFixture,\n   271\t    });\n   272\t    const skippedEntry = await archiveFinalizationService.appendFromProcessHistoryItem({\n   273\t      projectId,\n   274\t      processId,\n   275\t      historyItem: progressUpdateHistoryFixture,\n   276\t    });\n   277\t\n   278\t    expect(archiveEntry).to