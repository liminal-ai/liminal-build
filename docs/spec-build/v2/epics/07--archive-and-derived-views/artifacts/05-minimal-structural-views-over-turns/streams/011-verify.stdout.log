ck',\n    38\t        loginReturnUri: 'http://localhost:5001/projects',\n    39\t      });\n    40\t    }\n    41\t\n    42\t    override async resolveSession(): Promise<SessionResolution> {\n    43\t      return resolution;\n    44\t    }\n    45\t  }\n    46\t\n    47\t  return new TestAuthSessionService();\n    48\t}\n    49\t\n    50\tconst actor = {\n    51\t  userId: 'workos-user-derived-views-1',\n    52\t  workosUserId: 'workos-user-derived-views-1',\n    53\t  email: 'lee@example.com',\n    54\t  displayName: 'Lee Moore',\n    55\t};\n    56\t\n    57\tconst projectId = userArchiveEntryFixture.projectId;\n    58\tconst processId = userArchiveEntryFixture.processId;\n    59\t\n    60\tconst projectSummary = projectSummarySchema.parse({\n    61\t  projectId,\n    62\t  name: 'Archive Story Project',\n    63\t  ownerDisplayName: 'Lee Moore',\n    64\t  role: 'owner',\n    65\t  processCount: 1,\n    66\t  artifactCount: 0,\n    67\t  sourceAttachmentCount: 0,\n    68\t  lastUpdatedAt: '2026-05-05T09:00:00.000Z',\n    69\t});\n    70\t\n    71\tconst processSummary = processSummarySchema.parse({\n    72\t  ...completedProcessFixture,\n    73\t  processId,\n    74\t  displayLabel: 'Archive replay process',\n    75\t  updatedAt: '2026-05-05T09:05:00.000Z',\n    76\t});\n    77\t\n    78\tfunction makeArchiveEntry(base: ArchiveEntry, overrides: Partial<ArchiveEntry>): ArchiveEntry {\n    79\t  return archiveEntrySchema.parse({\n    80\t    ...base,\n    81\t    projectId,\n    82\t    processId,\n    83\t    ...overrides,\n    84\t  });\n    85\t}\n    86\t\n    87\tfunction buildHappyPathArchiveEntries(): ArchiveEntry[] {\n    88\t  return [\n    89\t    makeArchiveEntry(userArchiveEntryFixture, {\n    90\t      archiveEntryId: 'archive-entry-user-401',\n    91\t      finalizationKey: 'response:history-user-401',\n    92\t      sourceObjectId: 'history-user-401',\n    93\t      sequence: 0,\n    94\t      recordedAt: '2026-05-01T12:40:00.000Z',\n    95\t    }),\n    96\t    makeArchiveEntry(modelArchiveEntryFixture, {\n    97\t      archiveEntryId: 'archive-entry-model-401',\n    98\t      finalizationKey: 'model:message-401',\n    99\t      sourceObjectId: 'message-401',\n   100\t      sequence: 1,\n   101\t      recordedAt: '2026-05-01T12:40:01.000Z',\n   102\t    }),\n   103\t    makeArchiveEntry(toolCallArchiveEntryFixture, {\n   104\t      archiveEntryId: 'archive-entry-tool-call-401',\n   105\t      finalizationKey: 'tool:search:call:401',\n   106\t      sourceObjectId: 'tool-call-401',\n   107\t      relatedToolCallId: 'tool-call-401',\n   108\t      sequence: 2,\n   109\t      recordedAt: '2026-05-01T12:40:02.000Z',\n   110\t    }),\n   111\t    makeArchiveEntry(toolResultArchiveEntryFixture, {\n   112\t      archiveEntryId: 'archive-entry-tool-result-401',\n   113\t      finalizationKey: 'tool:search:result:401',\n   114\t      sourceObjectId: 'tool-result-401',\n   115\t      relatedToolCallId: 'tool-call-401',\n   116\t      sequence: 3,\n   117\t      recordedAt: '2026-05-01T12:40:03.000Z',\n   118\t    }),\n   119\t    makeArchiveEntry(userArchiveEntryFixture, {\n   120\t      archiveEntryId: 'archive-entry-user-402',\n   121\t      finalizationKey: 'response:history-user-402',\n   122\t      sourceObjectId: 'history-user-402',\n   123\t      bodyText: 'Please regroup the archive views.',\n   124\t      sequence: 4,\n   125\t      recordedAt: '2026-05-01T12:41:00.000Z',\n   126\t    }),\n   127\t    makeArchiveEntry(processEventArchiveEntryFixture, {\n   128\t      archiveEntryId: 'archive-entry-event-402',\n   129\t      finalizationKey: 'event:402',\n   130\t      sourceObjectId: 'event-402',\n   131\t      relatedArtifactVersionId: null,\n   132\t      relatedSourceProvenanceId: null,\n   133\t      sequence: 5,\n   134\t      recordedAt: '2026-05-01T12:41:02.000Z',\n   135\t    }),\n   136\t  ];\n   137\t}\n   138\t\n   139\tfunction buildStore(\n   140\t  args: { archiveEntries?: ArchiveEntry[]; derivedViews?: DerivedArchiveView[] } = {},\n   141\t) {\n   142\t  return new InMemoryPlatformStore({\n   143\t    accessibleProjectsByUserId: {\n   144\t      [`user:${actor.workosUserId}`]: [projectSummary],\n   145\t    },\n   146\t    projectAccessByProjectId: {\n   147\t      [projectId]: {\n   148\t        kind: 'accessible',\n   149\t        project: projectSummary,\n   150\t      },\n   151\t    },\n   152\t    processesByProjectId: {\n   153\t      [projectId]: [processSummary],\n   154\t    },\n   155\t    archiveEntriesByProcessId: {\n   156\t      [processId]: args.archiveEntries ?? buildHappyPathArchiveEntries(),\n   157\t    },\n   158\t    derivedArchiveViewsByProcessId:\n   159\t      args.derivedViews === undefined ? undefined : { [processId]: args.derivedViews },\n   160\t  });\n   161\t}\n   162\t\n   163\tasync function buildDerivedViewsApp(store: InMemoryPlatformStore) {\n   164\t  return buildApp({\n   165\t    authSessionService: createTestAuthSessionService({\n   166\t      actor,\n   167\t      reason: null,\n   168\t    }),\n   169\t    authUserSyncService: new AuthUserSyncService(store),\n   170\t    platformStore: store,\n   171\t  });\n   172\t}\n   173\t\n   174\tclass ConflictDuringDerivedViewRefreshStore extends InMemoryPlatformStore {\n   175\t  private mutated = false;\n   176\t\n   177\t  override async replaceDerivedArchiveViews(args: {\n   178\t    projectId: string;\n   179\t    processId: string;\n   180\t    views: DerivedArchiveView[];\n   181\t  }): Promise<void> {\n   182\t    if (!this.mutated) {\n   183\t      this.mutated = true;\n   184\t      await this.appendArchiveEntry({\n   185\t        projectId: args.projectId,\n   186\t        processId: args.processId,\n   187\t        entryKind: 'process_event',\n   188\t        finalizationKey: 'event:derived-refresh-conflict',\n   189\t        sourceObjectId: 'event-derived-refresh-conflict',\n   190\t        bodyFormat: 'none',\n   191\t        recordedAt: '2026-05-01T12:42:00.000Z',\n   192\t      });\n   193\t    }\n   194\t\n   195\t    await super.replaceDerivedArchiveViews(args);\n   196\t  }\n   197\t}\n   198\t\n   199\tdescribe('derived archive view service and route', () => {\n   200\t  it('TC-5.1a derived view returned for turn range', async () => {\n   201\t    const app = await buildDerivedViewsApp(buildStore());\n   202\t    const response = await app.inject({\n   203\t      method: 'GET',\n   204\t      url: buildProcessDerivedArchiveViewsApiPath({ projectId, processId }),\n   205\t      cookies: {\n   206\t        [sessionCookieName]: 'valid-session-cookie',\n   207\t      },\n   208\t    });\n   209\t\n   210\t    expect(response.statusCode).toBe(200);\n   211\t    expect(response.json()).toMatchObject({\n   212\t      views: expect.arrayContaining([\n   213\t        expect.objectContaining({\n   214\t          viewKind: 'turn_range',\n   215\t          bodyText: 'Turn 0',\n   216\t        }),\n   217\t      ]),\n   218\t    });\n   219\t\n   220\t    await app.close();\n   221\t  });\n   222\t\n   223\t  it('TC-5.2a derived view identifies boundary and TC-5.3a/TC-5.3b preserve provenance', async () => {\n   224\t    const app = await buildDerivedViewsApp(buildStore());\n   225\t    const response = await app.inject({\n   226\t      method: 'GET',\n   227\t      url: buildProcessDerivedArchiveViewsApiPath({ projectId, processId }),\n   228\t      cookies: {\n   229\t        [sessionCookieName]: 'valid-session-cookie',\n   230\t      },\n   231\t    });\n   232\t\n   233\t    expect(response.statusCode).toBe(200);\n   234\t    expect(response.json()).toMatchObject({\n   235\t      views: expect.arrayContaining([\n   236\t        expect.objectContaining({\n   237\t          derivedViewId: `${processId}:derived-view:turn_range:0-0`,\n   238\t          turnRange: {\n   239\t            startIndex: 0,\n   240\t            endIndex: 0,\n   241\t          },\n   242\t          sourceTurnIds: [`${processId}:turn:0`],\n   243\t          sourceArchiveEntryIds: [\n   244\t            'archive-entry-user-401',\n   245\t            'archive-entry-model-401',\n   246\t            'archive-entry-tool-call-401',\n   247\t            'archive-entry-tool-result-401',\n   248\t          ],\n   249\t        }),\n   250\t      ]),\n   251\t    });\n   252\t\n   253\t    await app.close();\n   254\t  });\n   255\t\n   256\t  it('TC-5.5a derived view failure leaves archive readable', async () => {\n   257\t    const store = new ConflictDuringDerivedViewRefreshStore({\n   258\t      accessibleProjectsByUserId: {\n   259\t        [`user:${actor.workosUserId}`]: [projectSummary],\n   260\t      },\n   261\t      projectAccessByProjectId: {\n   262\t        [projectId]: {\n   263\t          kind: 'accessible',\n   264\t          project: projectSummary,\n   265\t        },\n   266\t      },\n   267\t      processesByProjectId: {\n   268\t        [projectId]: [processSummary],\n   269\t      },\n   270\t      archiveEntriesByProcessId: {\n   271\t        [processId]: buildHappyPathArchiveEntries(),\n   272\t      },\n   273\t    });\n   274\t    const app = await buildDerivedViewsApp(store);\n   275\t\n   276\t    const refresh = await app.inject({\n   277\t      method: 'POST',\n   278\t      url: buildProcessDerivedArchiveViewsRefreshApiPath({ projectId, processId }),\n   279\t      payload: {},\n   280\t      cookies: {\n   281\t        [sessionCookieName]: 'valid-session-cookie',\n   282\t      },\n   283\t    });\n   284\t    const archive = await app.inject({\n   285\t      method: 'GET',\n   286\t      url: buildProcessArchiveApiPath({ projectId, processId }),\n   287\t      cookies: {\n   288\t        [sessionCookieName]: 'valid-session-cookie',\n   289\t      },\n   290\t    });\n   291\t\n   292\t    expect(refresh.statusCode).toBe(409);\n   293\t    expect(archive.statusCode).toBe(200);\n   294\t    expect(archive.json()).toMatchObject({\n   295\t      entries: expect.arrayContaining([\n   296\t        expect.objectContaining({\n   297\t          finalizationKey: 'event:derived-refresh-conflict',\n   298\t        }),\n   299\t      ]),\n   300\t    });\n   301\t\n   302\t    await app.close();\n   303\t  });\n   304\t\n   305\t  it('chunk_candidate stays structural and stale derived views rebuild from current turns', async () => {\n   306\t    const store = buildStore({\n   307\t      derivedViews: [\n   308\t        {\n   309\t          ...turnRangeDerivedArchiveViewFixture,\n   310\t          derivedViewId: 'stale-derived-view',\n   311\t          sourceTurnIds: ['stale-turn-id'],\n   312\t          sourceArchiveEntryIds: ['stale-archive-entry-id'],\n   313\t          updatedAt: '2026-04-01T00:00:00.000Z',\n   314\t        },\n   315\t      ],\n   316\t    });\n   317\t    const app = await buildDerivedViewsApp(store);\n   318\t    const response = await app.inject({\n   319\t      method: 'GET',\n   320\t      url: buildProcessDerivedArchiveViewsApiPath({ projectId, processId }),\n   321\t      cookies: {\n   322\t        [sessionCookieName]: 'valid-session-cookie',\n   323\t      },\n   324\t    });\n   325\t\n   326\t    expect(response.statusCode).toBe(200);\n   327\t    expect(response.json()).toMatchObject({\n   328\t      views: expect.arrayContaining([\n   329\t        expect.objectContaining({\n   330\t          derivedViewId: `${processId}:derived-view:chunk_candidate:0-1`,\n   331\t          viewKind: 'chunk_candidate',\n   332\t          bodyText: 'Chunk candidate turns 0-1',\n   333\t          sourceTurnIds: [`${processId}:turn:0`, `${processId}:turn:1`],\n   334\t        }),\n   335\t      ]),\n   336\t    });\n   337\t    expect(response.json().views).not.toEqual(\n   338\t      expect.arrayContaining([expect.objectContaining({ derivedViewId: 'stale-derived-view' })]),\n   339\t    );\n   340\t\n   341\t    await app.close();\n   342\t  });\n   343\t});\n","exit_code":0,"status":"completed"}}
