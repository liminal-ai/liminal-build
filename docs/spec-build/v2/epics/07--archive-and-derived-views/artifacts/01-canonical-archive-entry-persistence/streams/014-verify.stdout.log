rocess = await appendArchiveEntryHandler(\n   459\t      ctx,\n   460\t      buildAppendArgs({\n   461\t        processId: 'process-archive-2',\n   462\t        finalizationKey: 'process-2:first',\n   463\t      }),\n   464\t    );\n   465\t\n   466\t    expect([first.sequence, second.sequence, otherProcess.sequence]).toEqual([0, 1, 0]);\n   467\t  });\n   468\t});\n","exit_code":0,"status":"completed"}}
