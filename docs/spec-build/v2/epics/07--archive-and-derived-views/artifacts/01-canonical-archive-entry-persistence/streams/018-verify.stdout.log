'), v.null()),\n    43\t  relatedSourceProvenanceId: v.union(v.string(), v.null()),\n    44\t  relatedToolCallId: v.union(v.string(), v.null()),\n    45\t  entryStatus: archiveEntryStatusValidator,\n    46\t  degradationReason: v.union(v.string(), v.null()),\n    47\t  recordedAt: v.string(),\n    48\t};\n    49\t\n    50\tconst archiveEntryWriteArgsValidator = {\n    51\t  projectId: v.string(),\n    52\t  processId: v.string(),\n    53\t  entryKind: archiveEntryKindValidator,\n    54\t  finalizationKey: v.string(),\n    55\t  sourceObjectId: v.optional(v.union(v.string(), v.null())),\n    56\t  bodyText: v.optional(v.union(v.string(), v.null())),\n    57\t  bodyData: v.optional(v.union(archiveEntryBodyDataValidator, v.null())),\n    58\t  bodyFormat: archiveBodyFormatValidator,\n    59\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n    60\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n    61\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n    62\t  entryStatus: v.optional(archiveEntryStatusValidator),\n    63\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n    64\t  recordedAt: v.optional(v.string()),\n    65\t} as const;\n    66\t\n    67\tconst archiveListArgsValidator = {\n    68\t  processId: v.string(),\n    69\t  cursor: v.optional(v.union(v.string(), v.null())),\n    70\t  limit: v.number(),\n    71\t} as const;\n    72\t\n    73\tconst MAX_ARCHIVE_PAGE_SIZE = 200;\n    74\tconst supportedArchiveEntryKinds = new Set([\n    75\t  'user_message',\n    76\t  'model_message',\n    77\t  'reasoning',\n    78\t  'script_emission',\n    79\t  'tool_call',\n    80\t  'tool_result',\n    81\t  'process_event',\n    82\t] satisfies ArchiveEntry['entryKind'][]);\n    83\t\n    84\texport const appendArchiveEntry = mutation({\n    85\t  args: archiveEntryWriteArgsValidator,\n    86\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry> => {\n    87\t    assertArchiveEntryInput(args);\n    88\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n    89\t    const existingEntry = await ctx.db\n    90\t      .query('archiveEntries')\n    91\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n    92\t        indexQuery.eq('processId', processRecord._id).eq('finalizationKey', args.finalizationKey),\n    93\t      )\n    94\t      .unique();\n    95\t\n    96\t    if (existingEntry !== null) {\n    97\t      return buildArchiveEntry(existingEntry);\n    98\t    }\n    99\t\n   100\t    const mostRecentEntry = await ctx.db\n   101\t      .query('archiveEntries')\n   102\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n   103\t        indexQuery.eq('processId', processRecord._id),\n   104\t      )\n   105\t      .order('desc')\n   106\t      .take(1);\n   107\t    const nextSequence = (mostRecentEntry[0]?.sequence ?? -1) + 1;\n   108\t    const archiveEntryId = await ctx.db.insert('archiveEntries', {\n   109\t      projectId: args.projectId,\n   110\t      processId: processRecord._id,\n   111\t      entryKind: args.entryKind,\n   112\t      sequence: nextSequence,\n   113\t      lifecycleState: 'finalized',\n   114\t      finalizationKey: args.finalizationKey,\n   115\t      sourceObjectId: args.sourceObjectId ?? null,\n   116\t      bodyText: args.bodyText ?? null,\n   117\t      bodyData: args.bodyData ?? null,\n   118\t      bodyFormat: args.bodyFormat,\n   119\t      relatedArtifactVersionId:\n   120\t        args.relatedArtifactVersionId === undefined || args.relatedArtifactVersionId === null\n   121\t          ? null\n   122\t          : (args.relatedArtifactVersionId as Id<'artifactVersions'>),\n   123\t      relatedSourceProvenanceId: args.relatedSourceProvenanceId ?? null,\n   124\t      relatedToolCallId: args.relatedToolCallId ?? null,\n   125\t      entryStatus: args.entryStatus ?? 'ready',\n   126\t      degradationReason: args.degradationReason ?? null,\n   127\t      recordedAt: args.recordedAt ?? new Date().toISOString(),\n   128\t    });\n   129\t    const storedEntry = await ctx.db.get(archiveEntryId);\n   130\t\n   131\t    if (storedEntry === null) {\n   132\t      throw new Error('Archive entry was not found after append.');\n   133\t    }\n   134\t\n   135\t    return buildArchiveEntry(storedEntry);\n   136\t  },\n   137\t});\n   138\t\n   139\texport const listArchiveEntries = query({\n   140\t  args: archiveListArgsValidator,\n   141\t  handler: async (ctx: QueryCtx, args): Promise<ArchivePage> => {\n   142\t    assertArchivePageLimit(args.limit);\n   143\t    const processId = args.processId as Id<'processes'>;\n   144\t    const allEntries = await ctx.db\n   145\t      .query('archiveEntries')\n   146\t      .withIndex('by_processId_and_sequence', (indexQuery) => indexQuery.eq('processId', processId))\n   147\t      .order('asc')\n   148\t      .collect();\n   149\t\n   150\t    return paginateArchiveEntries({\n   151\t      entries: allEntries.map((entry) => buildArchiveEntry(entry)),\n   152\t      cursor: args.cursor ?? null,\n   153\t      limit: args.limit,\n   154\t    });\n   155\t  },\n   156\t});\n   157\t\n   158\tfunction assertArchiveEntryInput(args: {\n   159\t  entryKind: string;\n   160\t  finalizationKey: string;\n   161\t  sourceObjectId?: string | null;\n   162\t  bodyText?: string | null;\n   163\t  bodyData?: { jsonText: string } | null;\n   164\t  bodyFormat: ArchiveEntry['bodyFormat'];\n   165\t  relatedArtifactVersionId?: string | null;\n   166\t  relatedSourceProvenanceId?: string | null;\n   167\t  relatedToolCallId?: string | null;\n   168\t  entryStatus?: ArchiveEntry['entryStatus'];\n   169\t  degradationReason?: string | null;\n   170\t}): void {\n   171\t  if (!supportedArchiveEntryKinds.has(args.entryKind as ArchiveEntry['entryKind'])) {\n   172\t    throw new Error(`Unsupported archive entry kind: ${args.entryKind}`);\n   173\t  }\n   174\t\n   175\t  if (args.finalizationKey.trim().length === 0) {\n   176\t    throw new Error('Archive entries require a non-empty finalization key.');\n   177\t  }\n   178\t\n   179\t  assertOptionalNonEmptyString(args.sourceObjectId, 'Source object id');\n   180\t  assertOptionalNonEmptyString(args.bodyText, 'Archive body text');\n   181\t  assertOptionalNonEmptyString(args.relatedArtifactVersionId, 'Related artifact version id');\n   182\t  assertOptionalNonEmptyString(args.relatedSourceProvenanceId, 'Related source provenance id');\n   183\t  assertOptionalNonEmptyString(args.relatedToolCallId, 'Related tool call id');\n   184\t\n   185\t  if (args.bodyFormat === 'structured' && args.bodyData == null) {\n   186\t    throw new Error('Structured archive entries must include bodyData.');\n   187\t  }\n   188\t\n   189\t  if (args.bodyFormat === 'none' && (args.bodyText != null || args.bodyData != null)) {\n   190\t    throw new Error(\"Archive entries with bodyFormat 'none' cannot include body content.\");\n   191\t  }\n   192\t\n   193\t  if ((args.entryStatus ?? 'ready') === 'degraded' && args.degradationReason == null) {\n   194\t    throw new Error('Degraded archive entries must include a degradation reason.');\n   195\t  }\n   196\t}\n   197\t\n   198\tfunction assertOptionalNonEmptyString(value: string | null | undefined, label: string): void {\n   199\t  if (value !== undefined && value !== null && value.trim().length === 0) {\n   200\t    throw new Error(`${label} must be a non-empty string when provided.`);\n   201\t  }\n   202\t}\n   203\t\n   204\tfunction assertArchivePageLimit(limit: number): void {\n   205\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_ARCHIVE_PAGE_SIZE) {\n   206\t    throw new Error(\n   207\t      `Archive page limit must be an integer between 1 and ${MAX_ARCHIVE_PAGE_SIZE}.`,\n   208\t    );\n   209\t  }\n   210\t}\n   211\t\n   212\tasync function getProcessRecordOrThrow(\n   213\t  ctx: MutationCtx,\n   214\t  processIdValue: string,\n   215\t  projectId: string,\n   216\t): Promise<Doc<'processes'>> {\n   217\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n   218\t\n   219\t  if (processRecord === null) {\n   220\t    throw new Error('Process not found.');\n   221\t  }\n   222\t\n   223\t  if (processRecord.projectId !== projectId) {\n   224\t    throw new Error('Process does not belong to the requested project.');\n   225\t  }\n   226\t\n   227\t  return processRecord;\n   228\t}\n   229\t\n   230\tfunction buildArchiveEntry(record: Doc<'archiveEntries'>): ArchiveEntry {\n   231\t  return {\n   232\t    archiveEntryId: record._id,\n   233\t    projectId: record.projectId,\n   234\t    processId: record.processId,\n   235\t    entryKind: record.entryKind,\n   236\t    sequence: record.sequence,\n   237\t    lifecycleState: record.lifecycleState,\n   238\t    finalizationKey: record.finalizationKey,\n   239\t    sourceObjectId: record.sourceObjectId,\n   240\t    bodyText: record.bodyText,\n   241\t    bodyData: record.bodyData,\n   242\t    bodyFormat: record.bodyFormat,\n   243\t    relatedArtifactVersionId: record.relatedArtifactVersionId,\n   244\t    relatedSourceProvenanceId: record.relatedSourceProvenanceId,\n   245\t    relatedToolCallId: record.relatedToolCallId,\n   246\t    entryStatus: record.entryStatus,\n   247\t    degradationReason: record.degradationReason,\n   248\t    recordedAt: record.recordedAt,\n   249\t  };\n   250\t}\n   251\t\n   252\tfunction decodeArchiveCursor(cursor: string | null): number | null {\n   253\t  if (cursor == null) {\n   254\t    return null;\n   255\t  }\n   256\t\n   257\t  const parsed = Number.parseInt(cursor, 10);\n   258\t  return Number.isNaN(parsed) ? null : parsed;\n   259\t}\n   260\t\n   261\tfunction paginateArchiveEntries(args: {\n   262\t  entries: ArchiveEntry[];\n   263\t  cursor: string | null;\n   264\t  limit: number;\n   265\t}): ArchivePage {\n   266\t  const decodedCursor = decodeArchiveCursor(args.cursor);\n   267\t  const filtered =\n   268\t    decodedCursor === null\n   269\t      ? args.entries\n   270\t      : args.entries.filter((entry) => entry.sequence > decodedCursor);\n   271\t  const pageEntries = filtered.slice(0, args.limit);\n   272\t  const hasMore = filtered.length > args.limit;\n   273\t  const lastEntry = pageEntries.at(-1);\n   274\t\n   275\t  return {\n   276\t    entries: pageEntries,\n   277\t    page: {\n   278\t      cursor: args.cursor,\n   279\t      nextCursor: hasMore && lastEntry !== undefined ? String(lastEntry.sequence) : null,\n   280\t      hasMore,\n   281\t    },\n   282\t  };\n   283\t}\n","exit_code":0,"status":"completed"}}
