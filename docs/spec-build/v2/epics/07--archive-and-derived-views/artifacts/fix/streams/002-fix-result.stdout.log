n   428\\t    expect(secondPage.entries).toEqual([\\n   429\\t      expect.objectContaining({\\n   430\\t        finalizationKey: 'event:missing-related-context',\\n   431\\t        relatedArtifactVersionId: 'artifact-version-missing',\\n   432\\t        relatedSourceProvenanceId: 'provenance-missing',\\n   433\\t        relatedToolCallId: 'tool-call-missing',\\n   434\\t      }),\\n   435\\t    ]);\\n   436\\t  });\\n   437\\t\\n   438\\t  it('sequence assignment is atomic across same-process appends', async () => {\\n   439\\t    const { ctx } = createFakeConvexContext({\\n   440\\t      ...buildArchiveSeed(),\\n   441\\t      archiveEntries: [],\\n   442\\t    });\\n   443\\t\\n   444\\t    const first = await appendArchiveEntryHandler(\\n   445\\t      ctx,\\n   446\\t      buildAppendArgs({\\n   447\\t        processId: 'process-archive-1',\\n   448\\t        finalizationKey: 'process-1:first',\\n   449\\t      }),\\n   450\\t    );\\n   451\\t    const second = await appendArchiveEntryHandler(\\n   452\\t      ctx,\\n   453\\t      buildAppendArgs({\\n   454\\t        processId: 'process-archive-1',\\n   455\\t        finalizationKey: 'process-1:second',\\n   456\\t      }),\\n   457\\t    );\\n   458\\t    const otherProcess = await appendArchiveEntryHandler(\\n   459\\t      ctx,\\n   460\\t      buildAppendArgs({\\n   461\\t        processId: 'process-archive-2',\\n   462\\t        finalizationKey: 'process-2:first',\\n   463\\t      }),\\n   464\\t    );\\n   465\\t\\n   466\\t    expect([first.sequence, second.sequence, otherProcess.sequence]).toEqual([0, 1, 0]);\\n   467\\t  });\\n   468\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
