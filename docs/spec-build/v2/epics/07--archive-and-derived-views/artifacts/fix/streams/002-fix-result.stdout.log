e: 'finalized',\\n   225\\t      });\\n   226\\t    }\\n   227\\t\\n   228\\t    const page = await listArchiveEntriesHandler(ctx, {\\n   229\\t      processId: 'process-archive-1',\\n   230\\t      limit: 20,\\n   231\\t    });\\n   232\\t\\n   233\\t    expect(page.entries.map((entry) => entry.entryKind)).toEqual(requiredKinds);\\n   234\\t  });\\n   235\\t\\n   236\\t  it('TC-1.2b rejects unsupported archive entry kind', async () => {\\n   237\\t    const { ctx } = createFakeConvexContext({\\n   238\\t      ...buildArchiveSeed(),\\n   239\\t      archiveEntries: [],\\n   240\\t    });\\n   241\\t\\n   242\\t    await expect(\\n   243\\t      appendArchiveEntryHandler(\\n   244\\t        ctx,\\n   245\\t        buildAppendArgs({\\n   246\\t          entryKind: 'unsupported_kind' as never,\\n   247\\t          finalizationKey: 'unsupported:1',\\n   248\\t        }),\\n   249\\t      ),\\n   250\\t    ).rejects.toThrow('Unsupported archive entry kind: unsupported_kind');\\n   251\\t\\n   252\\t    await expect(\\n   253\\t      listArchiveEntriesHandler(ctx, {\\n   254\\t        processId: 'process-archive-1',\\n   255\\t        limit: 20,\\n   256\\t      }),\\n   257\\t    ).resolves.toMatchObject({\\n   258\\t      entries: [],\\n   259\\t    });\\n   260\\t  });\\n   261\\t\\n   262\\t  it('TC-1.3a reads entries in stable sequence order', async () => {\\n   263\\t    const { ctx } = createFakeConvexContext({\\n   264\\t      ...buildArchiveSeed(),\\n   265\\t      archiveEntries: [],\\n   266\\t    });\\n   267\\t\\n   268\\t    await appendArchiveEntryHandler(\\n   269\\t      ctx,\\n   270\\t      buildAppendArgs({\\n   271\\t        entryKind: 'model_message',\\n   272\\t        finalizationKey: 'model:late-timestamp',\\n   273\\t        recordedAt: '2026-05-01T10:06:00.000Z',\\n   274\\t      }),\\n   275\\t    );\\n   276\\t    await appendArchiveEntryHandler(\\n   277\\t      ctx,\\n   278\\t      buildAppendArgs({\\n   279\\t        entryKind: 'user_messa