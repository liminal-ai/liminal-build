\\t    expect(first.statusCode).toBe(200);\\n   280\\t    expect(second.statusCode).toBe(200);\\n   281\\t    expect(first.json()).toEqual(second.json());\\n   282\\t    expect(first.json()).toMatchObject({\\n   283\\t      entries: readyArchivePageFixture.entries,\\n   284\\t      page: {\\n   285\\t        cursor: null,\\n   286\\t        nextCursor: null,\\n   287\\t        hasMore: false,\\n   288\\t      },\\n   289\\t    });\\n   290\\t\\n   291\\t    await app.close();\\n   292\\t  });\\n   293\\t\\n   294\\t  it('TC-3.2b archive survives environment loss', async () => {\\n   295\\t    const store = buildStore({\\n   296\\t      environmentLost: true,\\n   297\\t      archiveEntries: [userArchiveEntryFixture, modelArchiveEntryFixture],\\n   298\\t    });\\n   299\\t    const app = await buildArchiveApp(store);\\n   300\\t    const response = await app.inject({\\n   301\\t      method: 'GET',\\n   302\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   303\\t      cookies: {\\n   304\\t        [sessionCookieName]: 'valid-session-cookie',\\n   305\\t      },\\n   306\\t    });\\n   307\\t\\n   308\\t    expect(response.statusCode).toBe(200);\\n   309\\t    expect(response.json()).toMatchObject({\\n   310\\t      entries: [userArchiveEntryFixture, modelArchiveEntryFixture],\\n   311\\t      page: {\\n   312\\t        cursor: null,\\n   313\\t        nextCursor: null,\\n   314\\t        hasMore: false,\\n   315\\t      },\\n   316\\t    });\\n   317\\t\\n   318\\t    await app.close();\\n   319\\t  });\\n   320\\t\\n   321\\t  it('TC-3.3a unauthorized archive read blocked', async () => {\\n   322\\t    const store = buildStore({\\n   323\\t      access: 'forbidden',\\n   324\\t    });\\n   325\\t    const app = await buildArchiveApp(store);\\n   326\\t    const response = await app.inject({\\n   327\\t      method: 'GET',\\n   328\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   329\\t      cookies: {\\n   330\\t        [sessionCookieName]: 'valid-session-cookie',\\n   331\\t      },\\n   332\\t    });\\n   333\\t\\n   334\\t    expect(response.statusCode).toBe(403);\\n   335\\t    expect(response.json()).toEqual({\\n   336\\t      code: 'PROJECT_FORBIDDEN',\\n   337\\t      message: 'You do not have access to this process.',\\n   338\\t      status: 403,\\n   339\\t    });\\n   340\\t\\n   341\\t    await app.close();\\n   342\\t  });\\n   343\\t\\n   344\\t  it('TC-3.3b missing process archive read returns not found', async () => {\\n   345\\t    const store = buildStore({\\n   346\\t      includeProcess: false,\\n   347\\t    });\\n   348\\t    const app = await buildArchiveApp(store);\\n   349\\t    const response = await app.inject({\\n   350\\t      method: 'GET',\\n   351\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   352\\t      cookies: {\\n   353\\t        [sessionCookieName]: 'valid-session-cookie',\\n   354\\t      },\\n   355\\t    });\\n   356\\t\\n   357\\t    expect(response.statusCode).toBe(404);\\n   358\\t    expect(response.json()).toEqual({\\n   359\\t      code: 'PROCESS_NOT_FOUND',\\n   360\\t      message: 'The requested process could not be found.',\\n   361\\t      status: 404,\\n   362\\t    });\\n   363\\t\\n   364\\t    await app.close();\\n   365\\t  });\\n   366\\t\\n   367\\t  it('TC-3.4a degraded entry displayed with healthy entries', async () => {\\n   368\\t    const store = buildStore({\\n   369\\t      archiveEntries: [userArchiveEntryFixture, degradedArchiveEntryFixture],\\n   370\\t    });\\n   371\\t    const app = await buildArchiveApp(store);\\n   372\\t    const response = await app.inject({\\n   373\\t      method: 'GET',\\n   374\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   375\\t      cookies: {\\n   376\\t        [sessionCookieName]: 'valid-session-cookie',\\n   377\\t      },\\n   378\\t    });\\n   379\\t\\n   380\\t    expect(response.statusCode).toBe(200);\\n   381\\t    expect(response.json()).toMatchObject({\\n   382\\t      entries: [\\n   383\\t        expect.objectContaining({\\n   384\\t          archiveEntryId: userArchiveEntryFixture.archiveEntryId,\\n   385\\t          entryStatus: 'ready',\\n   386\\t        }),\\n   387\\t        expect.objectContaining({\\n   388\\t          archiveEntryId: degradedArchiveEntryFixture.archiveEntryId,\\n   389\\t          entryStatus: 'degraded',\\n   390\\t          degradationReason: degradedArchiveEntryFixture.degradationReason,\\n   391\\t        }),\\n   392\\t      ],\\n   393\\t    });\\n   394\\t\\n   395\\t    await app.close();\\n   396\\t  });\\n   397\\t\\n   398\\t  it('invalid archive query returns INVALID_ARCHIVE_REQUEST', async () => {\\n   399\\t    const store = buildStore();\\n   400\\t    const app = await buildArchiveApp(store);\\n   401\\t    const response = await app.inject({\\n   402\\t      method: 'GET',\\n   403\\t      url: `${buildProcessArchiveApiPath({ projectId, processId })}?cursor=banana`,\\n   404\\t      cookies: {\\n   405\\t        [sessionCookieName]: 'valid-session-cookie',\\n   406\\t      },\\n   407\\t    });\\n   408\\t\\n   409\\t    expect(response.statusCode).toBe(422);\\n   410\\t    expect(response.json()).toEqual({\\n   411\\t      code: 'INVALID_ARCHIVE_REQUEST',\\n   412\\t      message: 'Archive pagination parameters were invalid.',\\n   413\\t      status: 422,\\n   414\\t    });\\n   415\\t\\n   416\\t    await app.close();\\n   417\\t  });\\n   418\\t\\n   419\\t  it('TC-6.1a artifact provenance visible from archive entry', async () => {\\n   420\\t    const store = buildStore({\\n   421\\t      archiveEntries: [\\n   422\\t        {\\n   423\\t          ...processEventArchiveEntryFixture,\\n   424\\t          relatedSourceProvenanceId: null,\\n   425\\t        },\\n   426\\t      ],\\n   427\\t      artifactVersionsByArtifactId: {\\n   428\\t        'artifact-001': [\\n   429\\t          {\\n   430\\t            versionId: currentArtifactVersionFixture.versionId,\\n   431\\t            artifactId: 'artifact-001',\\n   432\\t            versionLabel: currentArtifactVersionFixture.versionLabel,\\n   433\\t            contentStorageId: 'storage-001',\\n   434\\t            contentKind: 'markdown',\\n   435\\t            bytes: 128,\\n   436\\t            createdAt: currentArtifactVersionFixture.createdAt,\\n   437\\t            createdByProcessId: currentArtifactVersionFixture.producedByProcessId,\\n   438\\t          },\\n   439\\t        ],\\n   440\\t      },\\n   441\\t    });\\n   442\\t    const app = await buildArchiveApp(store);\\n   443\\t    const response = await app.inject({\\n   444\\t      method: 'GET',\\n   445\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   446\\t      cookies: {\\n   447\\t        [sessionCookieName]: 'valid-session-cookie',\\n   448\\t      },\\n   449\\t    });\\n   450\\t\\n   451\\t    expect(response.statusCode).toBe(200);\\n   452\\t    expect(response.json()).toMatchObject({\\n   453\\t      entries: [archiveEntryWithArtifactProvenanceFixture],\\n   454\\t    });\\n   455\\t\\n   456\\t    await app.close();\\n   457\\t  });\\n   458\\t\\n   459\\t  it('TC-6.2a source provenance visible from archive entry', async () => {\\n   460\\t    const store = buildStore({\\n   461\\t      archiveEntries: [\\n   462\\t        {\\n   463\\t          ...processEventArchiveEntryFixture,\\n   464\\t          relatedArtifactVersionId: null,\\n   465\\t          relatedSourceProvenanceId: readySourceProvenanceFixture.provenanceId,\\n   466\\t        },\\n   467\\t      ],\\n   468\\t      sourceProvenanceByProcessId: {\\n   469\\t        [processId]: [storedReadySourceProvenance],\\n   470\\t      },\\n   471\\t    });\\n   472\\t    const app = await buildArchiveApp(store);\\n   473\\t    const response = await app.inject({\\n   474\\t      method: 'GET',\\n   475\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   476\\t      cookies: {\\n   477\\t        [sessionCookieName]: 'valid-session-cookie',\\n   478\\t      },\\n   479\\t    });\\n   480\\t\\n   481\\t    expect(response.statusCode).toBe(200);\\n   482\\t    expect(response.json()).toMatchObject({\\n   483\\t      entries: [archiveEntryWithSourceProvenanceFixture],\\n   484\\t    });\\n   485\\t\\n   486\\t    await app.close();\\n   487\\t  });\\n   488\\t\\n   489\\t  it('TC-6.3a missing source context degrades one entry', async () => {\\n   490\\t    const store = buildStore({\\n   491\\t      archiveEntries: [\\n   492\\t        userArchiveEntryFixture,\\n   493\\t        {\\n   494\\t          ...processEventArchiveEntryFixture,\\n   495\\t          relatedArtifactVersionId: null,\\n   496\\t          relatedSourceProvenanceId: 'provenance-missing-001',\\n   497\\t        },\\n   498\\t      ],\\n   499\\t    });\\n   500\\t    const app = await buildArchiveApp(store);\\n   501\\t    const response = await app.inject({\\n   502\\t      method: 'GET',\\n   503\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   504\\t      cookies: {\\n   505\\t        [sessionCookieName]: 'valid-session-cookie',\\n   506\\t      },\\n   507\\t    });\\n   508\\t\\n   509\\t    expect(response.statusCode).toBe(200);\\n   510\\t    expect(response.json()).toMatchObject({\\n   511\\t      entries: [\\n   512\\t        expect.objectContaining({\\n   513\\t          archiveEntryId: userArchiveEntryFixture.archiveEntryId,\\n   514\\t          entryStatus: 'ready',\\n   515\\t        }),\\n   516\\t        expect.objectContaining({\\n   517\\t          archiveEntryId: processEventArchiveEntryFixture.archiveEntryId,\\n   518\\t          entryStatus: 'degraded',\\n   519\\t          degradationReason: 'Related source provenance is unavailable.',\\n   520\\t        }),\\n   521\\t      ],\\n   522\\t    });\\n   523\\t\\n   524\\t    await app.close();\\n   525\\t  });\\n   526\\t\\n   527\\t  it('source provenance lookup failure degrades one entry without failing the archive page', async () => {\\n   528\\t    const store = new ThrowingSourceProvenanceLookupStore(\\n   529\\t      buildStoreSeed({\\n   530\\t        archiveEntries: [\\n   531\\t          userArchiveEntryFixture,\\n   532\\t          {\\n   533\\t            ...processEventArchiveEntryFixture,\\n   534\\t            relatedArtifactVersionId: null,\\n   535\\t            relatedSourceProvenanceId: readySourceProvenanceFixture.provenanceId,\\n   536\\t          },\\n   537\\t        ],\\n   538\\t      }),\\n   539\\t    );\\n   540\\t    const app = await buildArchiveApp(store);\\n   541\\t    const response = await app.inject({\\n   542\\t      method: 'GET',\\n   543\\t      url: buildProcessArchiveApiPath({ projectId, processId }),\\n   544\\t      cookies: {\\n   545\\t        [sessionCookieName]: 'valid-session-cookie',\\n   546\\t      },\\n   547\\t    });\\n   548\\t\\n   549\\t    expect(response.statusCode).toBe(200);\\n   550\\t    expect(response.json()).toMatchObject({\\n   551\\t      entries: [\\n   552\\t        expect.objectContaining({\\n   553\\t          archiveEntryId: userArchiveEntryFixture.archiveEntryId,\\n   554\\t          entryStatus: 'ready',\\n   555\\t        }),\\n   556\\t        expect.objectContaining({\\n   557\\t          archiveEntryId: processEventArchiveEntryFixture.archiveEntryId,\\n   558\\t          entryStatus: 'degraded',\\n   559\\t          degradationReason: 'Related source provenance is unavailable.',\\n   560\\t        }),\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/quick-fix/streams/007-quick-fix.stdout.log:94:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_51\",\"type\":\"agent_message\",\"text\":\"Archive enrichment now degrades locally instead of failing the whole page. In [archive-read.service.ts](/Users/leemoore/code/liminal-build/apps/platform/server/services/archive/archive-read.service.ts:63), thrown `getArtifactVersion`, `listProcessesByIds`, and `listProcessSourceProvenance` calls are caught during read-time enrichment and treated like unavailable related context, so only the affected archive entry comes back as `degraded` with the existing bounded reason text.\\n\\nThe regression coverage is updated in [archive-api.test.ts](/Users/leemoore/code/liminal-build/tests/service/server/archive-api.test.ts:567). `TC-6.3b` now starts from a ready canonical `process_event` archive entry and breaks the real artifact-version lookup seam instead of using a pre-degraded fixture, and there’s a matching source-provenance lookup-failure test at [archive-api.test.ts](/Users/leemoore/code/liminal-build/tests/service/server/archive-api.test.ts:527). I left the other in-flight archive/client/contract edits already present in the worktree untouched.\\n\\nVerification passed:\\n- `corepack pnpm exec vitest run tests/service/server/archive-api.test.ts tests/service/client/archive-section.test.ts --environment node`\\n- `corepack pnpm run green-verify`\"}}\ndocs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/quick-fix/streams/007-quick-fix.stdout.log:96:{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":2447482,\"cached_input_tokens\":2329216,\"output_tokens\":12085,\"reasoning_output_tokens\":5523}}\n","exit_code":0,"status":"completed"}}
