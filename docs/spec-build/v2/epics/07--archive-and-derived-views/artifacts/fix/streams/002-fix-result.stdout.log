ed server package-review fixtures to include provenance-bearing version summaries.\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"tests/service/server/nfr.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"Updated package-review NFR fixtures to satisfy provenance-bearing artifact review contracts.\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"tests/service/server/observability.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"Updated observed package-review fixtures to satisfy provenance-bearing artifact review contracts.\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"tests/service/client/artifact-review-panel.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"Updated unsupported-version fixture data for required provenance fields.\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"tests/service/client/artifact-section.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"Updated UI assertions for ownership-free project artifact rendering.\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"tests/integration/platform-shell.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"Made the production-shell asset assertion use the active worktree build output path.\\\\\\\"}],\\\\\\\"tests\\\\\\\":{\\\\\\\"added\\\\\\\":[],\\\\\\\"modified\\\\\\\":[\\\\\\\"tests/service/server/review-foundation-contracts.test.ts\\\\\\\",\\\\\\\"tests/service/server/review-export-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/package-review-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/nfr.test.ts\\\\\\\",\\\\\\\"tests/service/server/observability.test.ts\\\\\\\",\\\\\\\"tests/service/client/artifact-review-panel.test.ts\\\\\\\",\\\\\\\"tests/service/client/artifact-section.test.ts\\\\\\\",\\\\\\\"tests/integration/platform-shell.test.ts\\\\\\\"],\\\\\\\"removed\\\\\\\":[],\\\\\\\"totalAfterStory\\\\\\\":552,\\\\\\\"deltaFromPriorBaseline\\\\\\\":1},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run green-verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run verify-all\\\\\\\