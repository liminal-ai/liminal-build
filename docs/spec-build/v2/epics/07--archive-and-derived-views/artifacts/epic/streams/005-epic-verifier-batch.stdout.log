{\n  const response = await fetch(\n    `/api/projects/${args.projectId}/processes/${args.processId}/source-provenance`,\n    {\n      credentials: 'include',\n    },\n  );\n\n  if (!response.ok) {\n","exit_code":0,"status":"completed"}}
