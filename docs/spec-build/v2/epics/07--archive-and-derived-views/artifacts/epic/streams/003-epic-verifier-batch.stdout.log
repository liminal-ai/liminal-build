ync getArchive(args: {\n    44\t    actor: AuthenticatedActor;\n    45\t    projectId: string;\n    46\t    processId: string;\n    47\t    cursor?: string | null;\n    48\t    limit?: number;\n    49\t  }): Promise<ArchivePage> {\n    50\t    await this.processAccessService.assertProcessAccess({\n    51\t      actor: args.actor,\n    52\t      projectId: args.projectId,\n    53\t      processId: args.processId,\n    54\t    });\n    55\t\n    56\t    const cursor = normalizeArchiveCursor(args.cursor);\n    57\t    const limit = normalizeArchiveLimit(args.limit);\n    58\t    const page = await this.platformStore.listArchiveEntries({\n    59\t      processId: args.processId,\n    60\t      cursor,\n    61\t      limit,\n    62\t    });\n    63\t    const entries = await enrichArchiveEntries({\n    64\t      entries: page.entries,\n    65\t      platformStore: this.platformStore,\n    66\t      processId: args.processId,\n    67\t    });\n    68\t\n    69\t    return archivePageSchema.parse({\n    70\t      ...page,\n    71\t      entries,\n    72\t    });\n    73\t  }\n    74\t}\n    75\t\n    76\tasync function enrichArchiveEntries(args: {\n    77\t  entries: ArchiveEntry[];\n    78\t  platformStore: Pick<PlatformStore, 'getArtifactVersion'> & {\n    79\t    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n    80\t    listProcessSourceProvenance?: PlatformStore['listProcessSourceProvenance'];\n    81\t  };\n    82\t  processId: string;\n    83\t}): Promise<ArchiveEntry[]> {\n    84\t  const artifactVersionIds = Array.from(\n    85\t    new Set(\n    86\t      args.entries\n    87\t        .map((entry) => entry.relatedArtifactVersionId)\n    88\t        .filter((versionId): versionId is string => versionId !== null),\n    89\t    ),\n    90\t  );\n    91\t  const sourceProvenanceIds = new Set(\n    92\t    args.entries\n    93\t      .map((entry) => entry.relatedSourceProvenanceId)\n    94\t      .filter((provenanceId): provenanceId is string => provenanceId !== null),\n    95\t  );\n    96\t  const artifactVersions = await Promise.all(\n    97\t    artifactVersionIds.map(async (versionId) => {\n    98\t      try {\n    99\t        return [versionId, await args.platformStore.getArtifactVersion({ versionId })] as const;\n   100\t      } catch {\n   101\t        return [versionId, null] as const;\n   102\t      }\n   103\t    }),\n   104\t  );\n   105\t  const artifactVersionsById = new Map<string, ArtifactVersionRecord | null>(artifactVersions);\n   106\t  const producingProcessIds = Array.from(\n   107\t    new Set(\n   108\t      artifactVersions\n   109\t        .map(([, version]) => version?.createdByProcessId ?? null)\n   110\t        .filter((processId): processId is string => processId !== null),\n   111\t    ),\n   112\t  );\n   113\t  const processes =\n   114\t    args.platformStore.listProcessesByIds === undefined || producingProcessIds.length === 0\n   115\t      ? []\n   116\t      : await loadProcessesByIds(args.platformStore, producingProcessIds);\n   117\t  const processDisplayLabelsById = new Map(\n   118\t    processes.map((processRecord) => [processRecord.processId, processRecord.displayLabel]),\n   119\t  );\n   120\t  const sourceRecords =\n   121\t    args.platformStore.listProcessSourceProvenance === undefined || sourceProvenanceIds.size === 0\n   122\t      ? []\n   123\t      : await loadSourceProvenanceRecords(args.platformStore, args.processId);\n   124\t  const sourceRecordsById = new Map(\n   125\t    sourceRecords.map((record) => [record.provenanceId, record] as const),\n   126\t  );\n   127\t\n   128\t  return args.entries.map((entry) =>\n   129\t    buildEnrichedArchiveEntry(entry, {\n   130\t      artifactVersion: resolveArtifactVersion(entry, artifactVersionsById),\n   131\t      producingProcessDisplayLabelsById: processDisplayLabelsById,\n   132\t      sourceRecord: resolveSourceRecord(entry, sourceProvenanceIds, sourceRecordsById),\n   133\t    }),\n   134\t  );\n   135\t}\n   136\t\n   137\tfunction resolveArtifactVersion(\n   138\t  entry: ArchiveEntry,\n   139\t  artifactVersionsById: Map<string, ArtifactVersionRecord | null>,\n   140\t): ArtifactVersionRecord | null {\n   141\t  if (entry.relatedArtifactVersionId === null) {\n   142\t    return null;\n   143\t  }\n   144\t\n   145\t  return artifactVersionsById.get(entry.relatedArtifactVersionId) ?? null;\n   146\t}\n   147\t\n   148\tfunction resolveSourceRecord(\n   149\t  entry: ArchiveEntry,\n   150\t  sourceProvenanceIds: Set<string>,\n   151\t  sourceRecordsById: Map<string, StoredSourceProvenanceRecord>,\n   152\t): StoredSourceProvenanceRecord | null {\n   153\t  if (\n   154\t    entry.relatedSourceProvenanceId === null ||\n   155\t    !sourceProvenanceIds.has(entry.relatedSourceProvenanceId)\n   156\t  ) {\n   157\t    return null;\n   158\t  }\n   159\t\n   160\t  return sourceRecordsById.get(entry.relatedSourceProvenanceId) ?? null;\n   161\t}\n   162\t\n   163\tfunction buildEnrichedArchiveEntry(\n   164\t  entry: ArchiveEntry,\n   165\t  args: {\n   166\t    artifactVersion: ArtifactVersionRecord | null;\n   167\t    producingProcessDisplayLabelsById: Map<string, string>;\n   168\t    sourceRecord: StoredSourceProvenanceRecord | null;\n   169\t  },\n   170\t): ArchiveEntry {\n   171\t  const degradationReasons = entry.degradationReason === null ? [] : [entry.degradationReason];\n   172\t  let relatedArtifactProvenance: ArchiveEntryArtifactProvenance | undefined;\n   173\t  let relatedSourceProvenance: ArchiveEntrySourceProvenance | undefined;\n   174\t\n   175\t  if (entry.relatedArtifactVersionId !== null) {\n   176\t    if (args.artifactVersion === null) {\n   177\t      degradationReasons.push('Related artifact version is unavailable.');\n   178\t    } else {\n   179\t      const producedByProcessDisplayLabel =\n   180\t        args.producingProcessDisplayLabelsById.get(args.artifactVersion.createdByProcessId) ?? null;\n   181\t      relatedArtifactProvenance = {\n   182\t        versionId: args.artifactVersion.versionId,\n   183\t        artifactId: args.artifactVersion.artifactId,\n   184\t        versionLabel: args.artifactVersion.versionLabel,\n   185\t        createdAt: args.artifactVersion.createdAt,\n   186\t        producedByProcessId: args.artifactVersion.createdByProcessId,\n   187\t        producedByProcessDisplayLabel,\n   188\t      };\n   189\t\n   190\t      if (producedByProcessDisplayLabel === null) {\n   191\t        degradationReasons.push(\n   192\t          'Producing process provenance is unavailable for the related artifact version.',\n   193\t        );\n   194\t      }\n   195\t    }\n   196\t  }\n   197\t\n   198\t  if (entry.relatedSourceProvenanceId !== null) {\n   199\t    if (args.sourceRecord === null) {\n   200\t      degradationReasons.push('Related source provenance is unavailable.');\n   201\t    } else {\n   202\t      relatedSourceProvenance = {\n   203\t        provenanceId: args.sourceRecord.provenanceId,\n   204\t        sourceAttachmentId: args.sourceRecord.sourceAttachmentId,\n   205\t        relationshipKind: args.sourceRecord.relationshipKind,\n   206\t        repositoryFullName: args.sourceRecord.repositoryFullName,\n   207\t        repositoryUrl: args.sourceRecord.repositoryUrl,\n   208\t        targetRef: args.sourceRecord.targetRef,\n   209\t        entryStatus: args.sourceRecord.entryStatus,\n   210\t        degradationReason: args.sourceRecord.degradationReason,\n   211\t        recordedAt: args.sourceRecord.recordedAt,\n   212\t      };\n   213\t    }\n   214\t  }\n   215\t\n   216\t  const nextDegradationReason = dedupeStrings(degradationReasons).join(' ') || null;\n   217\t\n   218\t  return {\n   219\t    ...entry,\n   220\t    ...(relatedArtifactProvenance === undefined ? {} : { relatedArtifactProvenance }),\n   221\t    ...(relatedSourceProvenance === undefined ? {} : { relatedSourceProvenance }),\n   222\t    entryStatus: nextDegradationReason === null ? 'ready' : 'degraded',\