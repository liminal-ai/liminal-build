k<\n    43\t      PlatformStore,\n    44\t      'listArchiveEntries' | 'listDerivedArchiveViews' | 'replaceDerivedArchiveViews'\n    45\t    >,\n    46\t    private readonly turnDerivationService: Pick<TurnDerivationService, 'rebuildTurns'>,\n    47\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n    48\t  ) {}\n    49\t\n    50\t  async listViews(args: {\n    51\t    actor: AuthenticatedActor;\n    52\t    projectId: string;\n    53\t    processId: string;\n    54\t  }): Promise<DerivedArchiveViewListResponse> {\n    55\t    await this.processAccessService.assertProcessAccess({\n    56\t      actor: args.actor,\n    57\t      projectId: args.projectId,\n    58\t      processId: args.processId,\n    59\t    });\n    60\t\n    61\t    try {\n    62\t      const turns = await this.turnDerivationService.rebuildTurns({\n    63\t        projectId: args.projectId,\n    64\t        processId: args.processId,\n    65\t      });\n    66\t      const views = limitDerivedArchiveViews(buildDerivedArchiveViews(turns, args.processId));\n    67\t\n    68\t      await this.platformStore.replaceDerivedArchiveViews({\n    69\t        projectId: args.projectId,\n    70\t        processId: args.processId,\n    71\t        views,\n    72\t      });\n    73\t\n    74\t      return derivedArchiveViewListResponseSchema.parse({ views });\n    75\t    } catch (error) {\n    76\t      const storedViews = await this.platformStore.listDerivedArchiveViews({\n    77\t        processId: args.processId,\n    78\t      });\n    79\t      if (storedViews.length > 0) {\n    80\t        return derivedArchiveViewListResponseSchema.parse({\n    81\t          views: limitDerivedArchiveViews(storedViews),\n    82\t        });\n    83\t      }\n    84\t\n    85\t      throw error;\n    86\t    }\n    87\t  }\n    88\t\n    89\t  async refreshViews(args: {\n    90\t    actor: AuthenticatedActor;\n    91\t    projectId: string;\n    92\t    processId: string;\n    93\t  }): Promise<DerivedArchiveViewRefreshResponse> {\n    94\t    await this.processAccessService.assertProcessAccess({\n    95\t      actor: args.actor,\n    96\t      projectId: args.projectId,\n    97\t      processId: args.processId,\n    98\t    });\n    99\t\n   100\t    const archiveSignatureBeforeRefresh = await computeArchiveSignature(\n   101\t      this.platformStore,\n   102\t      args.processId,\n   103\t    );\n   104\t    const turns = await this.turnDerivationService.rebuildTurns({\n   105\t      projectId: args.projectId,\n   106\t      processId: args.processId,\n   107\t    });\n   108\t    const archiveSignatureAfterTurnRebuild = await computeArchiveSignature(\n   109\t      this.platformStore,\n   110\t      args.processId,\n   111\t    );\n   112\t\n   113\t    if (archiveSignatureAfterTurnRebuild !== archiveSignatureBeforeRefresh) {\n   114\t      throw new AppError({\n   115\t        code: archiveDerivationConflictErrorCode,\n   116\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n   117\t        statusCode: 409,\n   118\t      });\n   119\t    }\n   120\t\n   121\t    const views = limitDerivedArchiveViews(buildDerivedArchiveViews(turns, args.processId));\n   122\t    await this.platformStore.replaceDerivedArchiveViews({\n   123\t      projectId: args.projectId,\n   124\t      processId: args.processId,\n   125\t      views,\n   126\t    });\n   127\t\n   128\t    const archiveSignatureAfterRefresh = await computeArchiveSignature(\n   129\t      this.platformStore,\n   130\t      args.processId,\n   131\t    );\n   132\t\n   133\t    if (archiveSignatureAfterRefresh !== archiveSignatureBeforeRefresh) {\n   134\t      throw new AppError({\n   135\t        code: archiveDerivationConflictErrorCode,\n   136\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n   137\t        statusCode: 409,\n   138\t      });\n   139\t    }\n   140\t\n   141\t    return derivedArchiveViewRefreshResponseSchema.parse({\n   142\t      views,\n   143\t      refreshStatus: views.some((view) => view.viewStatus === 'degraded') ? 'degraded' : 'settled',\n   144\t    });\n   145\t  }\n   146\t}\n   147\t\n   148\tasync function computeArchiveSignature(\n   149\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n   150\t  processId: string,\n   151\t): Promise<string> {\n   152\t  const entries = await listAllArchiveEntries(platformStore, processId);\n   153\t\n   154\t  return entries\n   155\t    .map((entry) => `${entry.archiveEntryId}:${entry.sequence}:${entry.recordedAt}`)\n   156\t    .join('|');\n   157\t}\n   158\t\n   159\tasync function listAllArchiveEntries(\n   160\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n   161\t  processId: string,\n   162\t): Promise<ArchiveEntry[]> {\n   163\t  const entries: ArchiveEntry[] = [];\n   164\t  let cursor: string | null = null;\n   165\t\n   166\t  for (;;) {\n   167\t    const page: ArchivePage = await platformStore.listArchiveEntries({\n   168\t      processId,\n   169\t      cursor,\n   170\t      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n   171\t    });\n   172\t    entries.push(...page.entries);\n   173\t\n   174\t    if (!page.page.hasMore || page.page.nextCursor === null) {\n   175\t      break;\n   176\t    }\n   177\t\n   178\t    cursor = normalizeArchiveCursor(page.page.nextCursor);\n   179\t  }\n   180\t\n   181\t  return entries.sort((left, right) => left.sequence - right.sequence);\n   182\t}\n   183\t\n   184\tfunction buildDerivedArchiveViews(turns: DerivedTurn[], processId: string): DerivedArchiveView[] {\n   185\t  if (turns.length === 0) {\n   186\t    return [];\n   187\t  }\n   188\t\n   189\t  const now = Date.now();\n   190\t  const turnRangeViews = turns.map((turn, index) =>\n   191\t    buildStructuralView({\n   192\t      processId,\n   193\t      viewKind: 'turn_range',\n   194\t      rangeTurns: [turn],\n   195\t      updatedAt: new Date(now - index).toISOString(),\n   196\t    }),\n   197\t  );\n   198\t  const chunkCandidateViews = groupTurnsForChunkCandidates(turns).map((group, index) =>\n   199\t    buildStructuralView({\n   200\t      processId,\n   201\t      viewKind: 'chunk_candidate',\n   202\t      rangeTurns: group,\n   203\t      updatedAt: new Date(now - turnRangeViews.length - index).toISOString(),\n   204\t    }),\n   205\t  );\n   206\t\n   207\t  return [...turnRangeViews, ...chunkCandidateViews];\n   208\t}\n   209\t\n   210\tfunction limitDerivedArchiveViews(views: DerivedArchiveView[]): DerivedArchiveView[] {\n   211\t  return views.slice(0, MAX_DERIVED_ARCHIVE_VIEWS);\n   212\t}\n   213\t\n   214\tfunction groupTurnsForChunkCandidates(turns: DerivedTurn[]): DerivedTurn[][] {\n   215\t  const groups: DerivedTurn[][] = [];\n   216\t\n   217\t  for (let index = 0; index < turns.length; index += CHUNK_CANDIDATE_GROUP_SIZE) {\n   218\t    groups.push(turns.slice(index, index + CHUNK_CANDIDATE_GROUP_SIZE));\n   219\t  }\n   220\t\n","exit_code":0,"status":"completed"}}
