 (source, filePath) => {\n    34\t  const sourceDirCandidates = [\n    35\t    path.join(\n    36\t      'sources',\n    37\t      \\`\\${sanitizeSegment(source.sourceAttachmentId)}-\\${sanitizeSegment(source.displayName)}\\`,\n    38\t    ),\n    39\t    path.join(\n    40\t      'sources',\n    41\t      \\`\\${sanitizeSegment(source.displayName)}-\\${sanitizeSegment(source.sourceAttachmentId)}\\`,\n    42\t    ),\n    43\t  ];\n    44\t  for (const relativePath of sourceDirCandidates) {\n    45\t    try {\n    46\t      await fs.access(path.join(process.cwd(), relativePath));\n    47\t      return path.join(relativePath, filePath);\n    48\t    } catch {}\n    49\t  }\n    50\t  return path.join(sourceDirCandidates[0], filePath);\n    51\t};\n    52\tconst artifactContents = [\n    53\t  '# Default Execution Summary',\n    54\t  '',\n    55\t  'This is the shared default execution payload.',\n    56\t  'The provider, hydration, execution, and checkpoint lanes are working.',\n    57\t  '',\n    58\t  \\`Generated: \\${now}\\`,\n    59\t  \\`Used source: \\${informingSource?.displayName ?? 'none'}\\`,\n    60\t].join('\\\\n');\n    61\tawait fs.mkdir(path.dirname(artifactAbsolutePath), { recursive: true });\n    62\tawait fs.writeFile(artifactAbsolutePath, artifactContents, 'utf8');\n    63\tconst codeCheckpointCandidates = [];\n    64\tif (writableSource !== null) {\n    65\t  const codeFilePath = 'liminal-build-default-execution-note.md';\n    66\t  const workspaceRef = await resolveSourceWorkspaceRef(writableSource, codeFilePath);\n    67\t  const workspacePath = path.join(process.cwd(), workspaceRef);\n    68\t  const codeContents = [\n    69\t    '# Default Execution Note',\n    70\t    '',\n    71\t    \\`Generated: \\${now}\\`,\n    72\t    \\`Source: \\${writableSource.displayName}\\`,\n    73\t  ].join('\\\\n');\n    74\t  await fs.mkdir(path.dirname(workspacePath), { recursive: true });\n    75\t  await fs.writeFile(workspacePath, codeContents, 'utf8');\n    76\t  codeCheckpointCandidates.push({\n    77\t    sourceAttachmentId: writableSource.sourceAttachmentId,\n    78\t    displayName: writableSource.displayName,\n    79\t    targetRef: writableSource.targetRef,\n    80\t    accessMode: writableSource.accessMode,\n    81\t    workspaceRef,\n    82\t    filePath: codeFilePath,\n    83\t    commitMessage: 'Record default execution note',\n    84\t  });\n    85\t}\n    86\tconst result = {\n    87\t  processStatus: 'completed',\n    88\t  processHistoryItems: [\n    89\t    {\n    90\t      historyItemId: \\`default-execution-history-\\${now}\\`,\n    91\t      kind: 'process_event',\n    92\t      lifecycleState: 'finalized',\n    93\t      text: 'Default execution completed and generated review-ready outputs.',\n    94\t      createdAt: now,\n    95\t      relatedSideWorkId: null,\n    96\t      relatedArtifactId: null,\n    97\t    },\n    98\t  ],\n    99\t  archiveEntries: [\n   100\t    {\n   101\t      entryKind: 'reasoning',\n   102\t      finalizationKey: \\`reasoning:\\${now}\\`,\n   103\t      sourceObjectId: \\`reasoning:\\${now}\\`,\n   104\t      bodyText: 'Validated the execution environment, prepared one reviewable artifact, and correlated the live archive stream with the active source context.',\n   105\t      bodyData: null,\n   106\t      bodyFormat: 'plain_text',\n   107\t      relatedArtifactVersionId: null,\n   108\t      relatedSourceProvenanceId: null,\n   109\t      relatedToolCallId: null,\n   110\t      entryStatus: 'ready',\n   111\t      degradationReason: null,\n   112\t      recordedAt: now,\n   113\t      artifactCheckpointIndex: null,\n   114\t      sourceProvenanceBinding: null,\n   115\t    },\n   116\t    {\n   117\t      entryKind: 'tool_call',\n   118\t      finalizationKey: \\`tool-call:\\${toolCallId}\\`,\n   119\t      sourceObjectId: toolCallId,\n   120\t      bodyText: null,\n   121\t      bodyData: {\n   122\t        jsonText: JSON.stringify({\n   123\t          tool: 'writ