null,\n   224\t      state: 'ready_for_review',\n   225\t      updatedAt: now,\n   226\t    },\n   227\t  ],\n   228\t  sideWorkWrites: [\n   229\t    {\n   230\t      displayLabel: 'Environment validation',\n   231\t      purposeSummary: 'Validate the shared environment execution lane.',\n   232\t      status: 'completed',\n   233\t      resultSummary:\n   234\t        writableSource === null\n   235\t          ? 'Execution placeholder completed without a writable source checkpoint.'\n   236\t          : 'Execution placeholder completed and staged a writable source checkpoint.',\n   237\t      updatedAt: now,\n   238\t    },\n   239\t  ],\n   240\t  artifactCheckpointCandidates: [\n   241\t    {\n   242\t      artifactId: undefined,\n   243\t      displayName: 'Default Execution Summary',\n   244\t      revisionLabel: 'default-v1',\n   245\t      contentsRef: artifactRelativePath,\n   246\t    },\n   247\t  ],\n   248\t  codeCheckpointCandidates,\n   249\t  usedSourceAttachmentIds: informingSource === null ? [] : [informingSource.sourceAttachmentId],\n   250\t};\n   251\tawait fs.writeFile(\n   252\t  path.join(process.cwd(), '_liminal_exec_result.json'),\n   253\t  JSON.stringify(result, null, 2),\n   254\t  'utf8',\n   255\t);\n   256\t`;\n   257\t}\n   258\t\n   259\texport function buildDefaultScriptPayload(\n   260\t  args: {\n   261\t    sourceInputs?: Array<\n   262\t      Pick<\n   263\t        HydrationPlanSourceInput,\n   264\t        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n   265\t      >\n   266\t    >;\n   267\t  } = {},\n   268\t): ScriptPayload {\n   269\t  const sourceInputs: DefaultScriptSourceInput[] = [...(args.sourceInputs ?? [])];\n   270\t  return {\n   271\t    format: 'ts-module-source',\n   272\t    entrypoint: 'default',\n   273\t    source: buildDefaultScriptSource({\n   274\t      sourceInputs,\n   275\t    }),\n   276\t  };\n   277\t}\n   278\t\n   279\t/**\n   280\t * Thin wrapper around `ProviderAdapter.exec