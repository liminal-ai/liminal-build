ew-ready outputs.',\n      createdAt: now,\n      relatedSideWorkId: null,\n      relatedArtifactId: null,\n    },\n  ],\n  archiveEntries: [\n    {\n      entryKind: 'reasoning',\n      finalizationKey: \\`reasoning:\\${now}\\`,\n      sourceObjectId: \\`reasoning:\\${now}\\`,\n      bodyText: 'Validated the execution environment, prepared one reviewable artifact, and correlated the live archive stream with the active source context.',\n      bodyData: null,\n      bodyFormat: 'plain_text',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: null,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'tool_call',\n      finalizationKey: \\`tool-call:\\${toolCallId}\\`,\n      sourceObjectId: toolCallId,\n      bodyText: null,\n      bodyData: {\n        jsonText: JSON.stringify({\n          tool: 'write_default_execution_summary',\n          target: artifactRelativePath,\n        }),\n      },\n      bodyFormat: 'structured',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: toolCallId,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'tool_result',\n      finalizationKey: \\`tool-result:\\${toolCallId}\\`,\n      sourceObjectId: \\`tool-result:\\${toolCallId}\\`,\n      bodyText: null,\n      bodyData: {\n        jsonText: JSON.stringify({\n          ok: true,\n          wroteArtifact: artifactRelativePath,\n          wroteSourceCheckpoint: writableSource !== null,\n        }),\n      },\n      bodyFormat: 'structured',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: toolCallId,\n      entryStatus: 'ready',\n      degradat