{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AqsTi8y3JjCyvwu7RTxRXu","type":"tool_result","content":"1\timport type { FastifyInstance } from 'fastify';\n2\timport type { ZodTypeProvider } from 'fastify-type-provider-zod';\n3\timport { buildShellBootstrapPayload } from '../config.js';\n4\timport { AppError } from '../errors/app-error.js';\n5\timport {\n6\t  getDerivedArchiveViewsRouteSchema,\n7\t  getProcessArchiveRouteSchema,\n8\t  getProcessArchiveTurnsRouteSchema,\n9\t  postRefreshDerivedArchiveViewsRouteSchema,\n10\t} from '../schemas/archive.js';\n11\timport { sessionCookieName } from '../services/auth/auth-session.service.js';\n12\timport {\n13\t  processArchiveApiPathnamePattern,\n14\t  processArchiveTurnsApiPathnamePattern,\n15\t  processDerivedArchiveViewsApiPathnamePattern,\n16\t  processDerivedArchiveViewsRefreshApiPathnamePattern,\n17\t  processArchiveRoutePathnamePattern,\n18\t  type RequestError,\n19\t} from '../../shared/contracts/index.js';\n20\t\n21\tfunction buildRequestError(error: AppError): RequestError {\n22\t  return {\n23\t    code: error.code as RequestError['code'],\n24\t    message: error.message,\n25\t    status: error.statusCode,\n26\t  };\n27\t}\n28\t\n29\texport const archiveRoutePatterns = {\n30\t  shell: processArchiveRoutePathnamePattern,\n31\t  bootstrap: processArchiveApiPathnamePattern,\n32\t  turns: processArchiveTurnsApiPathnamePattern,\n33\t  derivedViews: processDerivedArchiveViewsApiPathnamePattern,\n34\t  refreshDerivedViews: processDerivedArchiveViewsRefreshApiPathnamePattern,\n35\t} as const;\n36\t\n37\tfunction buildLoginRedirectPath(returnTo: string): string {\n38\t  return `/auth/login?returnTo=${encodeURIComponent(returnTo)}`;\n39\t}\n40\t\n41\tfunction renderUnavailableShell(title: string, message: string): string {\n42\t  return `<!doctype html>\n43\t<html lang=\"en\">\n44\t  <head>\n45\t    <meta charset=\"utf-8\" />\n46\t    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n47\t    <title>${title}</title>\n48\t  </head>\n49\t  <body>\n50\t    <main>\n51\t      <h1>${title}</h1>\n52\t      <p>${message}</p>\n53\t    </main>\n54\t  </body>\n55\t</html>`;\n56\t}\n57\t\n58\texport async function registerArchiveRoutes(app: FastifyInstance): Promise<void> {\n59\t  const typedApp = app.withTypeProvider<ZodTypeProvider>();\n60\t\n61\t  typedApp.get(\n62\t    '/projects/:projectId/processes/:processId/archive',\n63\t    {\n64\t      schema: {\n65\t        params: getProcessArchiveRouteSchema.params,\n66\t      },\n67\t    },\n68\t    async (request, reply) => {\n69\t      if (request.actor === null) {\n70\t        if (request.authFailureReason === 'invalid_session') {\n71\t          reply.clearCookie(sessionCookieName, { path: '/' });\n72\t        }\n73\t\n74\t        return reply.redirect(buildLoginRedirectPath(request.url));\n75\t      }\n76\t\n77\t      const access = await app.processAccessService.getProcessAccess({\n78\t        actor: request.actor,\n79\t        projectId: request.params.projectId,\n80\t        processId: request.params.processId,\n81\t      });\n82\t\n83\t      if (access.kind === 'forbidden') {\n84\t        return reply\n85\t          .code(403)\n86\t          .type('text/html')\n87\t          .send(renderUnavailableShell('Access denied', 'You do not have access to this process.'));\n88\t      }\n89\t\n90\t      if (access.kind === 'project_not_found') {\n91\t        return reply\n92\t          .code(404)\n93\t          .type('text/html')\n94\t          .send(\n95\t            renderUnavailableShell(\n96\t              'Project not found',\n97\t              'The requested project could not be found.',\n98\t            ),\n99\t          );\n100\t      }\n101\t\n102\t      if (access.kind === 'process_not_found') {\n103\t        return reply\n104\t          .code(404)\n105\t          .type('text/html')\n106\t          .send(\n107\t            renderUnavailableShell(\n108\t              'Process unavailable',\n109\t              'The requested process archive could not be opened.',\n110\t            ),\n111\t          );\n112\t      }\n113\t\n114\t      const url = new URL(request.url, 'http://story3.local');\n115\t      const payload = buildShellBootstrapPayload({\n116\t        actor: {\n117\t          id: request.actor.userId,\n118\t          email: request.actor.email,\n119\t          displayName: request.actor.displayName,\n120\t        },\n121\t        pathname: `/projects/${request.params.projectId}/processes/${request.params.processId}/archive`,\n122\t        search: url.search,\n123\t        csrfToken: reply.generateCsrf(),\n124\t      });\n125\t\n126\t      return reply.type('text/html').send(await app.renderShellDocument(payload, request.url));\n127\t    },\n128\t  );\n129\t\n130\t  typedApp.get(\n131\t    '/api/projects/:projectId/processes/:processId/archive/turns',\n132\t    {\n133\t      schema: getProcessArchiveTurnsRouteSchema,\n134\t    },\n135\t    async (request, reply) => {\n136\t      if (request.actor === null) {\n137\t        if (request.authFailureReason === 'invalid_session') {\n138\t          reply.clearCookie(sessionCookieName, { path: '/' });\n139\t        }\n140\t\n141\t        return reply.code(401).send({\n142\t          code: 'UNAUTHENTICATED',\n143\t          message: 'Authenticated access is required.',\n144\t          status: 401,\n145\t        });\n146\t      }\n147\t\n148\t      try {\n149\t        const turns = await app.turnDerivationService.getTurns({\n150\t          actor: request.actor,\n151\t          projectId: request.params.projectId,\n152\t          processId: request.params.processId,\n153\t          cursor: request.query.cursor,\n154\t          limit: request.query.limit,\n155\t        });\n156\t\n157\t        return reply.code(200).send(turns);\n158\t      } catch (error) {\n159\t        if (error instanceof AppError) {\n160\t          const statusCode = error.statusCode as 403 | 404 | 422;\n161\t\n162\t          return reply.code(statusCode).send(buildRequestError(error));\n163\t        }\n164\t\n165\t        throw error;\n166\t      }\n167\t    },\n168\t  );\n169\t\n170\t  typedApp.get(\n171\t    '/api/projects/:projectId/processes/:processId/archive/derived-views',\n172\t    {\n173\t      schema: getDerivedArchiveViewsRouteSchema,\n174\t    },\n175\t    async (request, reply) => {\n176\t      if (request.actor === null) {\n177\t        if (request.authFailureReason === 'invalid_session') {\n178\t          reply.clearCookie(sessionCookieName, { path: '/' });\n179\t        }\n180\t\n181\t        return reply.code(401).send({\n182\t          code: 'UNAUTHENTICATED',\n183\t          message: 'Authenticated access is required.',\n184\t          status: 401,\n185\t        });\n186\t      }\n187\t\n188\t      try {\n189\t        const response = await app.derivedArchiveViewService.listViews({\n190\t          actor: request.actor,\n191\t          projectId: request.params.projectId,\n192\t          processId: request.params.processId,\n193\t          cursor: request.query.cursor,\n194\t          limit: request.query.limit,\n195\t        });\n196\t\n197\t        return reply.code(200).send(response);\n198\t      } catch (error) {\n199\t        if (error instanceof AppError) {\n200\t          const statusCode = error.statusCode as 403 | 404 | 422;\n201\t\n202\t          return reply.code(statusCode).send(buildRequestError(error));\n203\t        }\n204\t\n205\t        throw error;\n206\t      }\n207\t    },\n208\t  );\n209\t\n210\t  typedApp.post(\n211\t    '/api/projects/:projectId/processes/:processId/archive/derived-views/refresh',\n212\t    {\n213\t      schema: postRefreshDerivedArchiveViewsRouteSchema,\n214\t    },\n215\t    async (request, reply) => {\n216\t      if (request.actor === null) {\n217\t        if (request.authFailureReason === 'invalid_session') {\n218\t          reply.clearCookie(sessionCookieName, { path: '/' });\n219\t        }\n220\t\n221\t        return reply.code(401).send({\n222\t          code: 'UNAUTHENTICATED',\n223\t          message: 'Authenticated access is required.',\n224\t          status: 401,\n225\t        });\n226\t      }\n227\t\n228\t      try {\n229\t        const response = await app.derivedArchiveViewService.refreshViews({\n230\t          actor: request.actor,\n231\t          projectId: request.params.projectId,\n232\t          processId: request.params.processId,\n233\t        });\n234\t\n235\t        return reply.code(200).send(response);\n236\t      } catch (error) {\n237\t        if (error instanceof AppError) {\n238\t          const statusCode = error.statusCode as 403 | 404 | 409 | 422;\n239\t\n240\t          return reply.code(statusCode).send(buildRequestError(error));\n241\t        }\n242\t\n243\t        throw error;\n244\t      }\n245\t    },\n246\t  );\n247\t\n248\t  typedApp.get(\n249\t    '/api/projects/:projectId/processes/:processId/archive',\n250\t    {\n251\t      schema: getProcessArchiveRouteSchema,\n252\t    },\n253\t    async (request, reply) => {\n254\t      if (request.actor === null) {\n255\t        if (request.authFailureReason === 'invalid_session') {\n256\t          reply.clearCookie(sessionCookieName, { path: '/' });\n257\t        }\n258\t\n259\t        return reply.code(401).send({\n260\t          code: 'UNAUTHENTICATED',\n261\t          message: 'Authenticated access is required.',\n262\t          status: 401,\n263\t        });\n264\t      }\n265\t\n266\t      try {\n267\t        const archive = await app.archiveReadService.getArchive({\n268\t          actor: request.actor,\n269\t          projectId: request.params.projectId,\n270\t          processId: request.params.processId,\n271\t          cursor: request.query.cursor,\n272\t          limit: request.query.limit,\n273\t        });\n274\t\n275\t        return reply.code(200).send(archive);\n276\t      } catch (error) {\n277\t        if (error instanceof AppError) {\n278\t          const statusCode = error.statusCode as 403 | 404 | 422;\n279\t\n280\t          return reply.code(statusCode).send(buildRequestError(error));\n281\t        }\n282\t\n283\t        throw error;\n284\t      }\n285\t    },\n286\t  );\n287\t}\n288\t"}]},"parent_tool_use_id":null,"session_id":"9d3edd01-ce82-457d-91bf-cf1987ab6574","uuid":"98e30dae-98c8-42c9-8716-61524caa34a3","timestamp":"2026-05-05T23:53:33.691Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/routes/archive.ts","content":"import type { FastifyInstance } from 'fastify';\nimport type { ZodTypeProvider } from 'fastify-type-provider-zod';\nimport { buildShellBootstrapPayload } from '../config.js';\nimport { AppError } from '../errors/app-error.js';\nimport {\n  getDerivedArchiveViewsRouteSchema,\n  getProcessArchiveRouteSchema,\n  getProcessArchiveTurnsRouteSchema,\n  postRefreshDerivedArchiveViewsRouteSchema,\n} from '../schemas/archive.js';\nimport { sessionCookieName } from '../services/auth/auth-session.service.js';\nimport {\n  processArchiveApiPathnamePattern,\n  processArchiveTurnsApiPathnamePattern,\n  processDerivedArchiveViewsApiPathnamePattern,\n  processDerivedArchiveViewsRefreshApiPathnamePattern,\n  processArchiveRoutePathnamePattern,\n  type RequestError,\n} from '../../shared/contracts/index.js';\n\nfunction buildRequestError(error: AppError): RequestError {\n  return {\n    code: error.code as RequestError['code'],\n    message: error.message,\n    status: error.statusCode,\n  };\n}\n\nexport const archiveRoutePatterns = {\n  shell: processArchiveRoutePathnamePattern,\n  bootstrap: processArchiveApiPathnamePattern,\n  turns: processArchiveTurnsApiPathnamePattern,\n  derivedViews: processDerivedArchiveViewsApiPathnamePattern,\n  refreshDerivedViews: processDerivedArchiveViewsRefreshApiPathnamePattern,\n} as const;\n\nfunction buildLoginRedirectPath(returnTo: string): string {\n  return `/auth/login?returnTo=${encodeURIComponent(returnTo)}`;\n}\n\nfunction renderUnavailableShell(title: string, message: string): string {\n  return `<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>${title}</title>\n  </head>\n  <body>\n    <main>\n      <h1>${title}</h1>\n      <p>${message}</p>\n    </main>\n  </body>\n</html>`;\n}\n\nexport async function registerArchiveRoutes(app: FastifyInstance): Promise<void> {\n  const typedApp = app.withTypeProvider<ZodTypeProvider>();\n\n  typedApp.get(\n    '/projects/:projectId/processes/:processId/archive',\n    {\n      schema: {\n        params: getProcessArchiveRouteSchema.params,\n      },\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.redirect(buildLoginRedirectPath(request.url));\n      }\n\n      const access = await app.processAccessService.getProcessAccess({\n        actor: request.actor,\n        projectId: request.params.projectId,\n        processId: request.params.processId,\n      });\n\n      if (access.kind === 'forbidden') {\n        return reply\n          .code(403)\n          .type('text/html')\n          .send(renderUnavailableShell('Access denied', 'You do not have access to this process.'));\n      }\n\n      if (access.kind === 'project_not_found') {\n        return reply\n          .code(404)\n          .type('text/html')\n          .send(\n            renderUnavailableShell(\n              'Project not found',\n              'The requested project could not be found.',\n            ),\n          );\n      }\n\n      if (access.kind === 'process_not_found') {\n        return reply\n          .code(404)\n          .type('text/html')\n          .send(\n            renderUnavailableShell(\n              'Process unavailable',\n              'The requested process archive could not be opened.',\n            ),\n          );\n      }\n\n      const url = new URL(request.url, 'http://story3.local');\n      const payload = buildShellBootstrapPayload({\n        actor: {\n          id: request.actor.userId,\n          email: request.actor.email,\n          displayName: request.actor.displayName,\n        },\n        pathname: `/projects/${request.params.projectId}/processes/${request.params.processId}/archive`,\n        search: url.search,\n        csrfToken: reply.generateCsrf(),\n      });\n\n      return reply.type('text/html').send(await app.renderShellDocument(payload, request.url));\n    },\n  );\n\n  typedApp.get(\n    '/api/projects/:projectId/processes/:processId/archive/turns',\n    {\n      schema: getProcessArchiveTurnsRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const turns = await app.turnDerivationService.getTurns({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n          cursor: request.query.cursor,\n          limit: request.query.limit,\n        });\n\n        return reply.code(200).send(turns);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n\n  typedApp.get(\n    '/api/projects/:projectId/processes/:processId/archive/derived-views',\n    {\n      schema: getDerivedArchiveViewsRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const response = await app.derivedArchiveViewService.listViews({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n          cursor: request.query.cursor,\n          limit: request.query.limit,\n        });\n\n        return reply.code(200).send(response);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n\n  typedApp.post(\n    '/api/projects/:projectId/processes/:processId/archive/derived-views/refresh',\n    {\n      schema: postRefreshDerivedArchiveViewsRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const response = await app.derivedArchiveViewService.refreshViews({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n        });\n\n        return reply.code(200).send(response);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 409 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n\n  typedApp.get(\n    '/api/projects/:projectId/processes/:processId/archive',\n    {\n      schema: getProcessArchiveRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const archive = await app.archiveReadService.getArchive({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n          cursor: request.query.cursor,\n          limit: request.query.limit,\n        });\n\n        return reply.code(200).send(archive);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n}\n","numLines":288,"startLine":1,"totalLines":288}}}
