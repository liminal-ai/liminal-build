{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V56jwVuGmr3c5CCHHEsW3R","type":"tool_result","content":"1\timport type {\n2\t  ArchiveEntry,\n3\t  ArchivePage,\n4\t  ArchiveTurnPage,\n5\t  DerivedTurn,\n6\t} from '../../../shared/contracts/index.js';\n7\timport { archiveTurnPageSchema } from '../../../shared/contracts/index.js';\n8\timport { AppError } from '../../errors/app-error.js';\n9\timport { invalidArchiveRequestErrorCode } from '../../errors/codes.js';\n10\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n11\timport type { ProcessAccessService } from '../processes/process-access.service.js';\n12\timport type { PlatformStore } from '../projects/platform-store.js';\n13\timport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\n14\timport { enrichArchiveEntries } from './archive-entry-enrichment.js';\n15\t\n16\tconst DEFAULT_TURN_PAGE_LIMIT = 50;\n17\tconst MAX_TURN_PAGE_LIMIT = 100;\n18\tconst ARCHIVE_REBUILD_PAGE_LIMIT = 200;\n19\t\n20\ttype DraftTurn = {\n21\t  archiveEntryIds: string[];\n22\t  degradationReasons: string[];\n23\t  endedAt: string;\n24\t  processId: string;\n25\t  startedAt: string;\n26\t  turnId: string;\n27\t  turnIndex: number;\n28\t};\n29\t\n30\texport interface TurnDerivationService {\n31\t  rebuildTurns(args: { projectId: string; processId: string }): Promise<DerivedTurn[]>;\n32\t  getTurns(args: {\n33\t    actor: AuthenticatedActor;\n34\t    projectId: string;\n35\t    processId: string;\n36\t    cursor?: string | null;\n37\t    limit?: number;\n38\t  }): Promise<ArchiveTurnPage>;\n39\t}\n40\t\n41\texport class DefaultTurnDerivationService implements TurnDerivationService {\n42\t  constructor(\n43\t    private readonly platformStore: Pick<\n44\t      PlatformStore,\n45\t      'getArtifactVersion' | 'listArchiveEntries' | 'listArchiveTurns' | 'upsertArchiveTurns'\n46\t    >,\n47\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n48\t    private readonly sourceProvenanceService?: Pick<\n49\t      SourceProvenanceService,\n50\t      'listProcessSourceProvenance'\n51\t    >,\n52\t  ) {}\n53\t\n54\t  async rebuildTurns(args: { projectId: string; processId: string }): Promise<DerivedTurn[]> {\n55\t    const entries = await listAllArchiveEntries(this.platformStore, args.processId);\n56\t    const enrichedEntries = await enrichArchiveEntries({\n57\t      entries,\n58\t      projectId: args.projectId,\n59\t      processId: args.processId,\n60\t      platformStore: this.platformStore,\n61\t      sourceProvenanceService: this.sourceProvenanceService,\n62\t    });\n63\t    const turns = deriveTurnsFromArchiveEntries(enrichedEntries, args.processId);\n64\t\n65\t    await this.platformStore.upsertArchiveTurns({\n66\t      projectId: args.projectId,\n67\t      processId: args.processId,\n68\t      turns,\n69\t    });\n70\t\n71\t    return turns;\n72\t  }\n73\t\n74\t  async getTurns(args: {\n75\t    actor: AuthenticatedActor;\n76\t    projectId: string;\n77\t    processId: string;\n78\t    cursor?: string | null;\n79\t    limit?: number;\n80\t  }): Promise<ArchiveTurnPage> {\n81\t    await this.processAccessService.assertProcessAccess({\n82\t      actor: args.actor,\n83\t      projectId: args.projectId,\n84\t      processId: args.processId,\n85\t    });\n86\t\n87\t    const cursor = normalizeTurnCursor(args.cursor);\n88\t    const limit = normalizeTurnLimit(args.limit);\n89\t    const storedPage = await this.platformStore.listArchiveTurns({\n90\t      processId: args.processId,\n91\t      cursor,\n92\t      limit,\n93\t    });\n94\t\n95\t    if (cursor !== null) {\n96\t      return archiveTurnPageSchema.parse(storedPage);\n97\t    }\n98\t\n99\t    if (storedPage.turns.length > 0) {\n100\t      return archiveTurnPageSchema.parse(storedPage);\n101\t    }\n102\t\n103\t    if (!(await hasArchiveEntries(this.platformStore, args.processId))) {\n104\t      return archiveTurnPageSchema.parse(storedPage);\n105\t    }\n106\t\n107\t    await this.warmTurnsCacheOnMiss({\n108\t      projectId: args.projectId,\n109\t      processId: args.processId,\n110\t    });\n111\t\n112\t    const rebuiltPage = await this.platformStore.listArchiveTurns({\n113\t      processId: args.processId,\n114\t      cursor,\n115\t      limit,\n116\t    });\n117\t\n118\t    return archiveTurnPageSchema.parse(rebuiltPage);\n119\t  }\n120\t\n121\t  private async warmTurnsCacheOnMiss(args: {\n122\t    projectId: string;\n123\t    processId: string;\n124\t  }): Promise<void> {\n125\t    await this.rebuildTurns(args);\n126\t  }\n127\t}\n128\t\n129\tasync function hasArchiveEntries(\n130\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n131\t  processId: string,\n132\t): Promise<boolean> {\n133\t  const firstPage = await platformStore.listArchiveEntries({\n134\t    processId,\n135\t    cursor: null,\n136\t    limit: 1,\n137\t  });\n138\t\n139\t  return firstPage.entries.length > 0;\n140\t}\n141\t\n142\tasync function listAllArchiveEntries(\n143\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n144\t  processId: string,\n145\t): Promise<ArchiveEntry[]> {\n146\t  const entries: ArchiveEntry[] = [];\n147\t  let cursor: string | null = null;\n148\t\n149\t  for (;;) {\n150\t    const page: ArchivePage = await platformStore.listArchiveEntries({\n151\t      processId,\n152\t      cursor,\n153\t      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n154\t    });\n155\t    entries.push(...page.entries);\n156\t\n157\t    if (!page.page.hasMore || page.page.nextCursor === null) {\n158\t      break;\n159\t    }\n160\t\n161\t    cursor = page.page.nextCursor;\n162\t  }\n163\t\n164\t  return entries.sort((left, right) => left.sequence - right.sequence);\n165\t}\n166\t\n167\texport function deriveTurnsFromArchiveEntries(\n168\t  entries: ArchiveEntry[],\n169\t  processId: string,\n170\t): DerivedTurn[] {\n171\t  const drafts: DraftTurn[] = [];\n172\t  const toolCallTurnIndexes = new Map<string, number>();\n173\t  let activeTurn: DraftTurn | null = null;\n174\t\n175\t  const createTurn = (): DraftTurn => {\n176\t    const turnIndex = drafts.length;\n177\t    const nextTurn: DraftTurn = {\n178\t      archiveEntryIds: [],\n179\t      degradationReasons: [],\n180\t      endedAt: '',\n181\t      processId,\n182\t      startedAt: '',\n183\t      turnId: `${processId}:turn:${turnIndex}`,\n184\t      turnIndex,\n185\t    };\n186\t    drafts.push(nextTurn);\n187\t    activeTurn = nextTurn;\n188\t    return nextTurn;\n189\t  };\n190\t\n191\t  const ensureActiveTurn = (): DraftTurn => activeTurn ?? createTurn();\n192\t\n193\t  const attachEntry = (turn: DraftTurn, entry: ArchiveEntry): void => {\n194\t    turn.archiveEntryIds.push(entry.archiveEntryId);\n195\t    if (turn.startedAt.length === 0 || entry.recordedAt < turn.startedAt) {\n196\t      turn.startedAt = entry.recordedAt;\n197\t    }\n198\t    if (turn.endedAt.length === 0 || entry.recordedAt > turn.endedAt) {\n199\t      turn.endedAt = entry.recordedAt;\n200\t    }\n201\t\n202\t    if (entry.entryStatus === 'degraded') {\n203\t      addDegradationReason(\n204\t        turn,\n205\t        entry.degradationReason ?? `Archive entry ${entry.archiveEntryId} is degraded.`,\n206\t      );\n207\t    }\n208\t  };\n209\t\n210\t  for (const entry of entries) {\n211\t    if (entry.entryKind === 'user_message') {\n212\t      const lastDraft = drafts[drafts.length - 1];\n213\t      const hasActiveEntries = lastDraft !== undefined && lastDraft.archiveEntryIds.length > 0;\n214\t      const targetTurn = hasActiveEntries ? createTurn() : ensureActiveTurn();\n215\t      attachEntry(targetTurn, entry);\n216\t      continue;\n217\t    }\n218\t\n219\t    if (entry.entryKind === 'tool_result') {\n220\t      const correlationKey = entry.relatedToolCallId ?? entry.sourceObjectId;\n221\t      if (correlationKey !== null) {\n222\t        const correlatedTurnIndex = toolCallTurnIndexes.get(correlationKey);\n223\t        if (correlatedTurnIndex !== undefined) {\n224\t          const correlatedTurn = drafts[correlatedTurnIndex];\n225\t          if (correlatedTurn !== undefined) {\n226\t            attachEntry(correlatedTurn, entry);\n227\t            continue;\n228\t          }\n229\t        }\n230\t      }\n231\t\n232\t      const fallbackTurn = ensureActiveTurn();\n233\t      attachEntry(fallbackTurn, entry);\n234\t      addDegradationReason(\n235\t        fallbackTurn,\n236\t        correlationKey === null\n237\t          ? `Tool result ${entry.archiveEntryId} is missing related tool-call context.`\n238\t          : `Tool result ${entry.archiveEntryId} could not match tool call ${correlationKey}.`,\n239\t      );\n240\t      continue;\n241\t    }\n242\t\n243\t    const targetTurn = ensureActiveTurn();\n244\t    attachEntry(targetTurn, entry);\n245\t\n246\t    if (entry.entryKind === 'tool_call') {\n247\t      const correlationKey = entry.relatedToolCallId ?? entry.sourceObjectId;\n248\t      if (correlationKey !== null) {\n249\t        toolCallTurnIndexes.set(correlationKey, targetTurn.turnIndex);\n250\t      } else {\n251\t        addDegradationReason(\n252\t          targetTurn,\n253\t          `Tool call ${entry.archiveEntryId} is missing stable correlation metadata.`,\n254\t        );\n255\t      }\n256\t    }\n257\t  }\n258\t\n259\t  return drafts.map((draft) => ({\n260\t    turnId: draft.turnId,\n261\t    processId: draft.processId,\n262\t    turnIndex: draft.turnIndex,\n263\t    archiveEntryIds: draft.archiveEntryIds,\n264\t    startedAt: draft.startedAt,\n265\t    endedAt: draft.endedAt,\n266\t    turnStatus: draft.degradationReasons.length > 0 ? 'degraded' : 'ready',\n267\t    degradationReason:\n268\t      draft.degradationReasons.length > 0 ? draft.degradationReasons.join(' ') : null,\n269\t  }));\n270\t}\n271\t\n272\tfunction addDegradationReason(turn: DraftTurn, reason: string): void {\n273\t  if (turn.degradationReasons.includes(reason)) {\n274\t    return;\n275\t  }\n276\t\n277\t 