   43\t    private readonly platformStore: Pick<\n    44\t      PlatformStore,\n    45\t      'getArtifactVersion' | 'listArchiveEntries' | 'listArchiveTurns' | 'upsertArchiveTurns'\n    46\t    >,\n    47\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n    48\t    private readonly sourceProvenanceService?: Pick<\n    49\t      SourceProvenanceService,\n    50\t      'listProcessSourceProvenance'\n    51\t    >,\n    52\t  ) {}\n    53\t\n    54\t  async rebuildTurns(args: { projectId: string; processId: string }): Promise<DerivedTurn[]> {\n    55\t    const entries = await listAllArchiveEntries(this.platformStore, args.processId);\n    56\t    const enrichedEntries = await enrichArchiveEntries({\n    57\t      entries,\n    58\t      projectId: args.projectId,\n    59\t      processId: args.processId,\n    60\t      platformStore: this.platformStore,\n    61\t      sourceProvenanceService: this.sourceProvenanceService,\n    62\t    });\n    63\t    const turns = deriveTurnsFromArchiveEntries(enrichedEntries, args.processId);\n    64\t\n    65\t    await this.platformStore.upsertArchiveTurns({\n    66\t      projectId: args.projectId,\n    67\t      processId: args.processId,\n    68\t      turns,\n    69\t    });\n    70\t\n    71\t    return turns;\n    72\t  }\n    73\t\n    74\t  async getTurns(args: {\n    75\t    actor: AuthenticatedActor;\n    76\t    projectId: string;\n    77\t    processId: string;\n    78\t    cursor?: string | null;\n    79\t    limit?: number;\n    80\t  }): Promise<ArchiveTurnPage> {\n    81\t    await this.processAccessService.assertProcessAccess({\n    82\t      actor: args.actor,\n    83\t      projectId: args.projectId,\n    84\t      processId: args.processId,\n    85\t    });\n    86\t\n    87\t    await this.rebuildTurns({\n    88\t      projectId: args.projectId,\n    89\t      processId: args.processId,\n    90\t    });\n    91\t\n    92\t    const page = await this.platformStore.listArchiveTurns({\n    93\t      processId: args.processId,\n    94\t      cursor: normalizeTurnCursor(args.cursor),\n    95\t      limit: normalizeTurnLimit(args.limit),\n    96\t    });\n    97\t\n    98\t    return archiveTurnPageSchema.parse(page);\n    99\t  }\n   100\t}\n   101\t\n   102\tasync function listAllArchiveEntries(\n   103\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n   104\t  processId: string,\n   105\t): Promise<ArchiveEntry[]> {\n   106\t  const entries: ArchiveEntry[] = [];\n   107\t  let cursor: string | null = null;\n   108\t\n   109\t  for (;;) {\n   110\t    const page: ArchivePage = await platformStore.listArchiveEntries({\n   111\t      processId,\n   112\t      cursor,\n   113\t      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n   114\t    });\n   115\t    entries.push(...page.entries);\n   116\t\n   117\t    if (!page.page.hasMore || page.page.nextCursor === null) {\n   118\t      break;\n   119\t    }\n   120\t\n   121\t    cursor = page.page.nextCursor;\n   122\t  }\n   123\t\n   124\t  return entries.sort((left, right) => left.sequence - right.sequence);\n   125\t}\n   126\t\n   127\texport function deriveTurnsFromArchiveEntries(\n   128\t  entries: ArchiveEntry[],\n   129\t  processId: string,\n   130\t): DerivedTurn[] {\n   131\t  const drafts: DraftTurn[] = [];\n   132\t  const toolCallTurnIndexes = new Map<string, number>();\n   133\t  let activeTurn: DraftTurn | null = null;\n   134\t\n   135\t  const createTurn = (): DraftTurn => {\n   136\t    const turnIndex = drafts.length;\n   137\t    const nextTurn: DraftTurn = {\n   138\t      archiveEntryIds: [],\n   139\t      degradationReasons: [],\n   140\t      endedAt: '',\n   141\t      processId,\n   142\t      startedAt: '',\n   143\t      turnId: `${processId}:turn:${turnIndex}`,\n   144\t      turnIndex,\n   145\t    };\n   146\t    drafts.push(nextTurn);\n   147\t    activeTurn = nextTurn;\n   148\t    return nextTurn;\n   149\t  };\n   150\t\n   151\t  const ensureActiveTurn = (): DraftTurn => activeTurn ?? createTurn();\n   152\t\n   153\t  const attachEntry = (turn: DraftTurn, entry: ArchiveEntry): void => {\n   154\t    turn.archiveEntryIds.push(entry.archiveEntryId);\n   155\t    if (turn.startedAt.length === 0 || entry.recordedAt < turn.startedAt) {\n   156\t      turn.startedAt = entry.recordedAt;\n   157\t    }\n   158\t    if (turn.endedAt.length === 0 || entry.recordedAt > turn.endedAt) {\n   159\t      turn.endedAt = entry.recordedAt;\n   160\t    }\n   161\t\n   162\t    if (entry.entryStatus === 'degraded') {\n   163\t      addDegradationReason(\n   164\t        turn,\n   165\t        entry.degradationReason ?? `Archive entry ${entry.archiveEntryId} is degraded.`,\n   166\t      );\n   167\t    }\n   168\t  };\n   169\t\n   170\t  for (const entry of entries) {\n   171\t    if (entry.entryKind === 'user_message') {\n   172\t      const lastDraft = drafts[drafts.length - 1];\n   173\t      const hasActiveEntries = lastDraft !== undefined && lastDraft.archiveEntryIds.length > 0;\n   174\t      const targetTurn = hasActiveEntries ? createTurn() : ensureActiveTurn();\n   175\t      attachEntry(targetTurn, entry);\n   176\t      continue;\n   177\t    }\n   178\t\n   179\t    if (entry.entryKind === 'tool_result') {\n   180\t      const correlationKey = entry.relatedToolCallId ?? entry.sourceObjectId;\n   181\t      if (correlationKey !== null) {\n   182\t        const correlatedTurnIndex = toolCallTurnIndexes.get(correlationKey);\n   183\t        if (correlatedTurnIndex !== undefined) {\n   184\t          const correlatedTurn = drafts[correlatedTurnIndex];\n   185\t          if (correlatedTurn !== undefined) {\n   186\t            attachEntry(correlatedTurn, entry);\n   187\t            continue;\n   188\t          }\n   189\t        }\n   190\t      }\n   191\t\n   192\t      const fallbackTurn = ensureActiveTurn();\n   193\t      attachEntry(fallbackTurn, entry);\n   194\t      addDegradationReason(\n   195\t        fallbackTurn,\n   196\t        correlationKey === null\n   197\t          ? `Tool result ${entry.archiveEntryId} is missing related tool-call context.`\n   198\t          : `Tool result ${entry.archiveEntryId} could not match tool call ${correlationKey}.`,\n   199\t      );\n   200\t      continue;\n   201\t    }\n   202\t\n   203\t    const targetTurn = ensureActiveTurn();\n   204\t    attachEntry(targetTurn, entry);\n   205\t\n   206\t    if (entry.entryKind === 'tool_call') {\n   207\t      const correlationKey = entry.relatedToolCallId ?? entry.sourceObjectId;\n   208\t      if (correlationKey !== null) {\n   209\t        toolCallTurnIndexes.set(correlationKey, targetTurn.turnIndex);\n   210\t      } else {\n   211\t        addDegradationReason(\n   212\t          targetTurn,\n   213\t          `Tool call ${entry.archiveEntryId} is missing stable correlation metadata.`,\n   214\t        );\n   215\t      }\n   216\t    }\n   217\t  }\n   218\t\n   219\t  return drafts.map((draft) => ({\n   220\t    turnId: draft.turnId,\n   221\t    processId: draft.processId,\n   222\t    turnIndex: draft.turnIndex,\n   223\t    archiveEntryIds: draft.archiveEntryIds,\n   224\t    startedAt: draft.startedAt,\n   225\t    endedAt: draft.endedAt,\n   226\t    turnStatus: draft.degradationReasons.length > 0 ? 'degraded' : 'ready',\n   227\t    degradationReason:\n   228\t      draft.degradationReasons.length > 0 ? draft.degradationReasons.join(' ') : null,\n   229\t  }));\n   230\t}\n   231\t\n   232\tfunction addDegradationReason(turn: DraftTurn, reason: string): void {\n   233\t  if (turn.degradationReasons.includes(reason)) {\n   234\t    return;\n   235\t  }\n   236\t\n   237\t  turn.degradationReasons.push(reason);\n   238\t}\n   239\t\n   240\tfunction normalizeTurnCursor(cursor: string | null | undefined): string | null {\n   241\t  if (cursor === undefined || cursor === null) {\n   242\t    return null;\n   243\t  }\n   244\t\n   245\t  if (!/^\\d+$/.test(cursor)) {\n   246\t    throw new AppError({\n   247\t      code: invalidArchiveRequestErrorCode,\n   248\t      message: 'Archive pagination parameters were invalid.',\n   249\t      statusCode: 422,\n   250\t    });\n   251\t  }\n   252\t\n   253\t  return cursor;\n   254\t}\n   255\t\n   256\tfunction normalizeTurnLimit(limit: number | undefined): number {\n   257\t  if (limit === undefined) {\n   258\t    return DEFAULT_TURN_PAGE_LIMIT;\n   259\t  }\n   260\t\n   261\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_TURN_PAGE_LIMIT) {\n   262\t    throw new AppError({\n   263\t      code: invalidArchiveRequestErrorCode,\n   264\t      message: 'Archive pagination parameters were invalid.',\n   265\t      statusCode: 422,\n   266\t    });\n   267\t  }\n   268\t\n   269\t  return limit;\n   270\t}\n","exit_code":0,"status":"completed"}}
