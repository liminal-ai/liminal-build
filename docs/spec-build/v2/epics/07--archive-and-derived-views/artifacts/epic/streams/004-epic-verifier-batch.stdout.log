\n    86\t  args: {\n    87\t    artifactVersion: ArtifactVersionRecord | null;\n    88\t    producingProcessDisplayLabelsById: Map<string, string>;\n    89\t    sourceEntry: SourceProvenanceEntry | null;\n    90\t  },\n    91\t): ArchiveEntry {\n    92\t  const degradationReasons = entry.degradationReason === null ? [] : [entry.degradationReason];\n    93\t  let relatedArtifactProvenance: ArchiveEntryArtifactProvenance | undefined;\n    94\t  let relatedSourceProvenance: ArchiveEntrySourceProvenance | undefined;\n    95\t\n    96\t  if (entry.relatedArtifactVersionId !== null) {\n    97\t    if (args.artifactVersion === null) {\n    98\t      degradationReasons.push('Related artifact version is unavailable.');\n    99\t    } else {\n   100\t      const producedByProcessDisplayLabel =\n   101\t        args.producingProcessDisplayLabelsById.get(args.artifactVersion.createdByProcessId) ?? null;\n   102\t      relatedArtifactProvenance = {\n   103\t        versionId: args.artifactVersion.versionId,\n   104\t        artifactId: args.artifactVersion.artifactId,\n   105\t        versionLabel: args.artifactVersion.versionLabel,\n   106\t        createdAt: args.artifactVersion.createdAt,\n   107\t        producedByProcessId: args.artifactVersion.createdByProcessId,\n   108\t        producedByProcessDisplayLabel,\n   109\t      };\n   110\t\n   111\t      if (producedByProcessDisplayLabel === null) {\n   112\t        degradationReasons.push(\n   113\t          'Producing process provenance is unavailable for the related artifact version.',\n   114\t        );\n   115\t      }\n   116\t    }\n   117\t  }\n   118\t\n   119\t  if (entry.relatedSourceProvenanceId !== null) {\n   120\t    if (args.sourceEntry === null) {\n   121\t      degradationReasons.push('Related source provenance is unavailable.');\n   122\t    } else {\n   123\t      relatedSourceProvenance = {\n   124\t        provenanceId: args.sourceEntry.provenanceId,\n   125\t        sourceAttachmentId: args.sourceEntry.sourceAttachmentId,\n   126\t        relationshipKind: args.sourceEntry.relationshipKind,\n   127\t        repositoryFullName: args.sourceEntry.repositoryFullName,\n   128\t        repositoryUrl: args.sourceEntry.repositoryUrl,\n   129\t        targetRef: args.sourceEntry.targetRef,\n   130\t        entryStatus: args.sourceEntry.entryStatus,\n   131\t        degradationReason: args.sourceEntry.degradationReason,\n   132\t        recordedAt: args.sourceEntry.recordedAt,\n   133\t      };\n   134\t\n   135\t      if (args.sourceEntry.entryStatus === 'degraded' && args.sourceEntry.degradationReason !== null) {\n   136\t        degradationReasons.push(args.sourceEntry.degradationReason);\n   137\t      }\n   138\t    }\n   139\t  }\n   140\t\n   141\t  const nextDegradationReason = dedupeStrings(degradationReasons).join(' ') || null;\n   142\t\n   143\t  return {\n   144\t    ...entry,\n   145\t    ...(relatedArtifactProvenance === undefined ? {} : { relatedArtifactProvenance }),\n   146\t    ...(relatedSourceProvenance === undefined ? {} : { relatedSourceProvenance }),\n   147\t    entryStatus: nextDegradationReason === null ? 'ready' : 'degraded',\n   148\t    degradationReason: nextDegradationReason,\n   149\t  };\n   150\t}\n   151\t\n   152\tfunction dedupeStrings(values: string[]): string[] {\n   153\t  return [...new Set(values)];\n   154\t}\n   155\t\n   156\tasync function loadProcessesByIds(\n   157\t  platformStore: {\n   158\t    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n   159\t  },\n   160\t  processIds: string[],\n   161\t): Promise<Array<Awaited<ReturnType<NonNullable<PlatformStore['listProcessesByIds']>>>[number]>> {\n   162\t  if (platformStore.listProcessesByIds === undefined || processIds.length === 0) {\n   163\t    return [];\n   164\t  }\n   165\t\n   166\t  try {\n   167\t    return await platformStore.listProcessesByIds({\n   168\t      processIds,\n   169\t    });\n   170\t  } catch {\n   171\t    return [];\n   172\t  }\n   173\t}\n   174\t\n   175\tasync function loadSourceProvenanceEntries(\n   176\t  sourceProvenanceService: Pick<SourceProvenanceService, 'listProcessSourceProvenance'>,\n   177\t  args: {\n   178\t    projectId: string;\n   179\t    processId: string;\n   180\t  },\n   181\t): Promise<SourceProvenanceEntry[]> {\n   182\t  try {\n   183\t    const response = await sourceProvenanceService.listProcessSourceProvenance(args);\n   184\t    return response.entries;\n   185\t  } catch {\n   186\t    return [];\n   187\t  }\n   188\t}\n","exit_code":0,"status":"completed"}}
