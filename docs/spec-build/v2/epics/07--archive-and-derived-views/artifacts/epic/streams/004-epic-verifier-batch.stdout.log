eProvenance'\n    39\t    >,\n    40\t  ) {}\n    41\t\n    42\t  async getArchive(args: {\n    43\t    actor: AuthenticatedActor;\n    44\t    projectId: string;\n    45\t    processId: string;\n    46\t    cursor?: string | null;\n    47\t    limit?: number;\n    48\t  }): Promise<ArchivePage> {\n    49\t    await this.processAccessService.assertProcessAccess({\n    50\t      actor: args.actor,\n    51\t      projectId: args.projectId,\n    52\t      processId: args.processId,\n    53\t    });\n    54\t\n    55\t    const cursor = normalizeArchiveCursor(args.cursor);\n    56\t    const limit = normalizeArchiveLimit(args.limit);\n    57\t    const page = await this.platformStore.listArchiveEntries({\n    58\t      processId: args.processId,\n    59\t      cursor,\n    60\t      limit,\n    61\t    });\n    62\t    const entries = await enrichArchiveEntries({\n    63\t      entries: page.entries,\n    64\t      projectId: args.projectId,\n    65\t      platformStore: this.platformStore,\n    66\t      processId: args.processId,\n    67\t      sourceProvenanceService: this.sourceProvenanceService,\n    68\t    });\n    69\t\n    70\t    return archivePageSchema.parse({\n    71\t      ...page,\n    72\t      entries,\n    73\t    });\n    74\t  }\n    75\t}\n    76\t\n    77\tfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n    78\t  if (cursor === undefined || cursor === null) {\n    79\t    return null;\n    80\t  }\n    81\t\n    82\t  if (!/^\\d+$/.test(cursor)) {\n    83\t    throw new AppError({\n    84\t      code: invalidArchiveRequestErrorCode,\n    85\t      message: 'Archive pagination parameters were invalid.',\n    86\t      statusCode: 422,\n    87\t    });\n    88\t  }\n    89\t\n    90\t  return cursor;\n    91\t}\n    92\t\n    93\tfunction normalizeArchiveLimit(limit: number | undefined): number {\n    94\t  if (limit === undefined) {\n    95\t    return DEFAULT_ARCHIVE_PAGE_LIMIT;\n    96\t  }\n    97\t\n    98\t 