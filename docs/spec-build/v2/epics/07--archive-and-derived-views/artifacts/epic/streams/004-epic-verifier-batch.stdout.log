   267\t  historyItemId: z.string().min(1),\n   268\t  kind: processHistoryItemKindSchema,\n   269\t  lifecycleState: processHistoryItemLifecycleSchema,\n   270\t  text: z.string().min(1),\n   271\t  createdAt: z.string().min(1),\n   272\t  relatedSideWorkId: z.string().min(1).nullable(),\n   273\t  relatedArtifactId: z.string().min(1).nullable(),\n   274\t});\n   275\texport type ProcessHistoryItem = z.infer<typeof processHistoryItemSchema>;\n   276\t\n   277\texport const processHistorySectionEnvelopeSchema = z\n   278\t  .object({\n   279\t    status: sectionStatusSchema,\n   280\t    items: z.array(processHistoryItemSchema),\n   281\t    error: processSurfaceSectionErrorSchema.optional(),\n   282\t  })\n   283\t  .superRefine((value, context) => {\n   284\t    if (value.status === 'error' && value.error === undefined) {\n   285\t      context.addIssue({\n   286\t        code: z.ZodIssueCode.custom,\n   287\t        message: 'Process history error state requires an error payload.',\n   288\t      });\n   289\t    }\n   290\t  });\n   291\texport type ProcessHistorySectionEnvelope = z.infer<typeof processHistorySectionEnvelopeSchema>;\n   292\t\n   293\texport const currentProcessRequestSchema = z.object({\n   294\t  requestId: z.string().min(1),\n   295\t  requestKind: currentProcessRequestKindSchema,\n   296\t  promptText: z.string().min(1),\n   297\t  requiredActionLabel: z.string().min(1).nullable(),\n   298\t  createdAt: z.string().min(1),\n   299\t});\n   300\texport type CurrentProcessRequest = z.infer<typeof currentProcessRequestSchema>;\n   301\t\n   302\texport const processArtifactReferenceSchema = z.object({\n   303\t  artifactId: z.string().min(1),\n   304\t  displayName: z.string().min(1),\n   305\t  currentVersionLabel: z.string().min(1).nullable(),\n   306\t  roleLabel: z.string().min(1).nullable(),\n   307\t  updatedAt: z.string().min(1),\n   308\t});\n   309\texport type ProcessArtifactReference = z.infer<typeof processArtifactReferenceSchema>;\n