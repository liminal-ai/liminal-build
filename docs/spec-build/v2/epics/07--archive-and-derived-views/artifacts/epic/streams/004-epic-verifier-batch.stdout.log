:02.000Z',\n   295\t      }),\n   296\t    ];\n   297\t    const store = buildStore(degradedEntries);\n   298\t    const app = await buildTurnsApp(store);\n   299\t    const response = await app.inject({\n   300\t      method: 'GET',\n   301\t      url: buildProcessArchiveTurnsApiPath({ projectId, processId }),\n   302\t      cookies: {\n   303\t        [sessionCookieName]: 'valid-session-cookie',\n   304\t      },\n   305\t    });\n   306\t\n   307\t    expect(response.statusCode).toBe(200);\n   308\t    expect(response.json()).toMatchObject({\n   309\t      turns: [\n   310\t        {\n   311\t          turnId: `${processId}:turn:0`,\n   312\t          turnStatus: 'degraded',\n   313\t          degradationReason:\n   314\t            'Tool result archive-entry-tool-result-201 could not match tool call missing-tool-call-201.',\n   315\t        },\n   316\t        {\n   317\t          turnId: `${processId}:turn:1`,\n   318\t          turnStatus: 'ready',\n   319\t        },\n   320\t      ],\n   321\t    });\n   322\t\n   323\t    await app.close();\n   324\t  });\n   325\t\n   326\t  it('degrades turns when archive source provenance resolves to a detached source on reopen', async () => {\n   327\t    const detachedSourceProvenanceId = 'provenance-detached-turn-1';\n   328\t    const store = buildStore(\n   329\t      [\n   330\t        makeArchiveEntry(userArchiveEntryFixture, {\n   331\t          archiveEntryId: 'archive-entry-user-detached-1',\n   332\t          finalizationKey: 'response:history-user-detached-1',\n   333\t          sourceObjectId: 'history-user-detached-1',\n   334\t          sequence: 0,\n   335\t          recordedAt: '2026-05-01T12:12:00.000Z',\n   336\t        }),\n   337\t        makeArchiveEntry(processEventArchiveEntryFixture, {\n   338\t          archiveEntryId: 'archive-entry-event-detached-1',\n   339\t          finalizationKey: 'event:detached-1',\n   340\t          sourceObjectId: 'event-detached-1',\n   341\t          relatedArtifact