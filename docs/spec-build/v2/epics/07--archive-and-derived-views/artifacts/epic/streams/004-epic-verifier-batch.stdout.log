n   312\t    const currentSurface = store.get().processSurface;\n   313\t\n   314\t    if (currentSurface.projectId !== projectId || currentSurface.processId !== processId) {\n   315\t      return;\n   316\t    }\n   317\t\n   318\t    store.patch('processSurface', {\n   319\t      ...currentSurface,\n   320\t      live: nextLive,\n   321\t    });\n   322\t  };\n   323\t\n   324\t  const buildProcessLiveUrl = (projectId: string, processId: string): string => {\n   325\t    const livePath = buildProcessLiveUpdatesPath({\n   326\t      projectId,\n   327\t      processId,\n   328\t    });\n   329\t    const currentUrl = new URL(targetWindow.location.href);\n   330\t    currentUrl.protocol = currentUrl.protocol === 'https:' ? 'wss:' : 'ws:';\n   331\t    currentUrl.pathname = livePath;\n   332\t    currentUrl.search = '';\n   333\t    currentUrl.hash = '';\n   334\t    return currentUrl.toString();\n   335\t  };\n   336\t\n   337\t  const startProcessLiveSubscription = (projectId: string, processId: string): void => {\n   338\t    stopLiveConnection();\n   339\t\n   340\t    const WebSocketCtor = targetWindow.WebSocket;\n   341\t\n   342\t    if (typeof WebSocketCtor !== 'function') {\n   343\t      return;\n   344\t    }\n   345\t\n   346\t    const currentSurface = store.get().processSurface;\n   347\t\n   348\t    if (currentSurface.projectId !== projectId || currentSurface.processId !== processId) {\n   349\t      return;\n   350\t    }\n   351\t\n   352\t    updateLiveState(projectId, processId, {\n   353\t      connectionState: 'connecting',\n   354\t      subscriptionId: null,\n   355\t      lastSequenceNumber: null,\n   356\t      error: null,\n   357\t    });\n   358\t\n   359\t    let socket: WebSocket;\n   360\t    let opened = false;\n","exit_code":0,"status":"completed"}}
