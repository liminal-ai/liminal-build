5\tconst listDirectoryEntriesSafe = async (relativeDir) => {\n    36\t  try {\n    37\t    return await fs.readdir(path.join(process.cwd(), relativeDir), { withFileTypes: true });\n    38\t  } catch {\n    39\t    return [];\n    40\t  }\n    41\t};\n    42\tconst resolveSourceWorkspaceRef = async (source, filePath) => {\n    43\t  const sourceDirCandidates = [\n    44\t    path.join(\n    45\t      'sources',\n    46\t      \\`\\${sanitizeSegment(source.sourceAttachmentId)}-\\${sanitizeSegment(source.displayName)}\\`,\n    47\t    ),\n    48\t    path.join(\n    49\t      'sources',\n    50\t      \\`\\${sanitizeSegment(source.displayName)}-\\${sanitizeSegment(source.sourceAttachmentId)}\\`,\n    51\t    ),\n    52\t  ];\n    53\t  for (const relativePath of sourceDirCandidates) {\n    54\t    try {\n    55\t      await fs.access(path.join(process.cwd(), relativePath));\n    56\t      return path.join(relativePath, filePath);\n    57\t    } catch {}\n    58\t  }\n    59\t  return path.join(sourceDirCandidates[0], filePath);\n    60\t};\n    61\tconst hydratedArtifacts = await listDirectoryEntriesSafe('artifacts');\n    62\tconst hydratedSources = await listDirectoryEntriesSafe('sources');\n    63\tconst sourceObservations = await Promise.all(\n    64\t  hydratedSources\n    65\t    .filter((entry) => entry.isDirectory())\n    66\t    .map(async (entry) => {\n    67\t      const relativeSourceDir = path.join('sources', entry.name);\n    68\t      const childEntries = await listDirectoryEntriesSafe(relativeSourceDir);\n    69\t      return {\n    70\t        directory: entry.name,\n    71\t        fileCount: childEntries.length,\n    72\t        sampleEntries: childEntries.slice(0, 5).map((child) => child.name),\n    73\t      };\n    74\t    }),\n    75\t);\n    76\tconst artifactContents = [\n    77\t  '# Runtime Execution Report',\n    78\t  '',\n    79\t  'This report was generated by the integrated runtime path after inspecting the hydrated workspace.',\n    80\