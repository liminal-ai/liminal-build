hema = processSurfaceAvailableActionSchema;\n    83\texport type ProcessSurfaceControlActionId = z.infer<typeof processSurfaceControlActionIdSchema>;\n    84\t\n    85\texport const environmentStateSchema = z.enum([\n    86\t  'absent',\n    87\t  'preparing',\n    88\t  'rehydrating',\n    89\t  'ready',\n    90\t  'running',\n    91\t  'checkpointing',\n    92\t  'stale',\n    93\t  'failed',\n    94\t  'lost',\n    95\t  'rebuilding',\n    96\t  'unavailable',\n    97\t]);\n    98\texport type EnvironmentState = z.infer<typeof environmentStateSchema>;\n    99\t\n   100\texport const defaultEnvironmentStatusLabels = {\n   101\t  absent: 'Not prepared',\n   102\t  preparing: 'Preparing environment',\n   103\t  rehydrating: 'Rehydrating environment',\n   104\t  ready: 'Ready for work',\n   105\t  running: 'Running in environment',\n   106\t  checkpointing: 'Checkpointing work',\n   107\t  stale: 'Environment is stale',\n   108\t  failed: 'Environment failed',\n   109\t  lost: 'Environment lost',\n   110\t  rebuilding: 'Rebuilding environment',\n   111\t  unavailable: 'Environment unavailable',\n   112\t} as const satisfies Record<EnvironmentState, string>;\n   113\t\n   114\texport function deriveEnvironmentStatusLabel(state: EnvironmentState): string {\n   115\t  return defaultEnvironmentStatusLabels[state];\n   116\t}\n   117\t\n   118\texport const checkpointKindSchema = z.enum(['artifact', 'code', 'mixed']);\n   119\texport type CheckpointKind = z.infer<typeof checkpointKindSchema>;\n   120\t\n   121\texport const checkpointOutcomeSchema = z.enum(['succeeded', 'failed']);\n   122\texport type CheckpointOutcome = z.infer<typeof checkpointOutcomeSchema>;\n   123\t\n   124\texport const processHistoryItemKindSchema = z.enum([\n   125\t  'user_message',\n   126\t  'process_message',\n   127\t  'progress_update',\n   128\t  'attention_request',\n   129\t  'side_work_update',\n   130\t  'process_event',\n   131\t]);\n   132\texport type ProcessHistoryItemKind = z.infe