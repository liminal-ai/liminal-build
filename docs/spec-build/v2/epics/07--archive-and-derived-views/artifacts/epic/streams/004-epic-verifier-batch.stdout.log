d: null,\n   103\t    };\n   104\t  }\n   105\t\n   106\t  return {\n   107\t    projectId: parsedRoute.projectId,\n   108\t    processId: parsedRoute.processId,\n   109\t  };\n   110\t}\n   111\t\n   112\tfunction getArchiveRouteIdentity(parsedRoute: ParsedRoute): {\n   113\t  projectId: string | null;\n   114\t  processId: string | null;\n   115\t} {\n   116\t  if (parsedRoute.kind !== 'process-archive') {\n   117\t    return {\n   118\t      projectId: null,\n   119\t      processId: null,\n   120\t    };\n   121\t  }\n   122\t\n   123\t  return {\n   124\t    projectId: parsedRoute.projectId,\n   125\t    processId: parsedRoute.processId,\n   126\t  };\n   127\t}\n   128\t\n   129\tfunction getReviewWorkspaceRouteIdentity(parsedRoute: ParsedRoute): {\n   130\t  projectId: string | null;\n   131\t  processId: string | null;\n   132\t  selection: ReviewWorkspaceSelection | null;\n   133\t} {\n   134\t  if (parsedRoute.kind !== 'review-workspace') {\n   135\t    return {\n   136\t      projectId: null,\n   137\t      processId: null,\n   138\t      selection: null,\n   139\t    };\n   140\t  }\n   141\t\n   142\t  return {\n   143\t    projectId: parsedRoute.projectId,\n   144\t    processId: parsedRoute.processId,\n   145\t    selection: parsedRoute.reviewSelection,\n   146\t  };\n   147\t}\n   148\t\n   149\tfunction normalizeReviewWorkspaceBootstrapError(error: ApiRequestError): RequestError {\n   150\t  if (\n   151\t    error.payload.code === 'REVIEW_EXPORT_FAILED' ||\n   152\t    error.payload.code === 'REVIEW_EXPORT_NOT_AVAILABLE'\n   153\t  ) {\n   154\t    return {\n   155\t      code: 'PROCESS_ACTION_FAILED',\n   156\t      message: 'The review workspace is unavailable right now. Try again or reload the page.',\n   157\t      status: 500,\n   158\t    };\n   159\t  }\n   160\t\n   161\t  return error.payload;\n   162\t}\n   163\t\n   164\tfunction normalizeDerivedArchiveViewsBootstrapError(error: unknown): RequestError {\n   165\t  if (error instanceof Ap