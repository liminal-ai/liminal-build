t\n    42\t    return this.platformStore.appendArchiveEntry({\n    43\t      ...args,\n    44\t      finalizationKey,\n    45\t      sourceObjectId,\n    46\t      relatedToolCallId,\n    47\t      bodyText: args.bodyText ?? null,\n    48\t      bodyData: args.bodyData ?? null,\n    49\t      relatedArtifactVersionId: args.relatedArtifactVersionId ?? null,\n    50\t      relatedSourceProvenanceId: args.relatedSourceProvenanceId ?? null,\n    51\t      entryStatus: args.entryStatus ?? 'ready',\n    52\t      degradationReason: args.degradationReason ?? null,\n    53\t      recordedAt: args.recordedAt,\n    54\t    });\n    55\t  }\n    56\t\n    57\t  async appendFromProcessHistoryItem(args: {\n    58\t    projectId: string;\n    59\t    processId: string;\n    60\t    historyItem: ProcessHistoryItem;\n    61\t  }): Promise<ArchiveEntry | null> {\n    62\t    const entryKind = this.processHistoryCompatService.mapHistoryKindToArchiveKind(\n    63\t      args.historyItem.kind,\n    64\t    );\n    65\t\n    66\t    if (args.historyItem.lifecycleState !== 'finalized' || entryKind === null) {\n    67\t      return null;\n    68\t    }\n    69\t\n    70\t    const bodyFormat = toBodyFormat(args.historyItem.text);\n    71\t    const sourceObjectId = args.historyItem.historyItemId;\n    72\t\n    73\t    if (entryKind === 'user_message') {\n    74\t      const existingAcceptedResponse = await this.findExistingEntryBySourceObjectId({\n    75\t        processId: args.processId,\n    76\t        entryKind,\n    77\t        sourceObjectId,\n    78\t      });\n    79\t\n    80\t      if (existingAcceptedResponse !== null) {\n    81\t        return existingAcceptedResponse;\n    82\t      }\n    83\t    }\n    84\t\n    85\t    return this.appendFinalizedEntry({\n    86\t      projectId: args.projectId,\n    87\t      processId: args.processId,\n    88\t      entryKind,\n    89\t      finalizationKey: buildHistoryItemArchiveFinalizationKey({\n    90\t        entryKind,\n    91\t 