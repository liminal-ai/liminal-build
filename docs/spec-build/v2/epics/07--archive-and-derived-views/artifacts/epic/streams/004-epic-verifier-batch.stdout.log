k<\n    43\t      PlatformStore,\n    44\t      'listArchiveEntries' | 'listDerivedArchiveViews' | 'replaceDerivedArchiveViews'\n    45\t    >,\n    46\t    private readonly turnDerivationService: Pick<TurnDerivationService, 'rebuildTurns'>,\n    47\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n    48\t  ) {}\n    49\t\n    50\t  async listViews(args: {\n    51\t    actor: AuthenticatedActor;\n    52\t    projectId: string;\n    53\t    processId: string;\n    54\t  }): Promise<DerivedArchiveViewListResponse> {\n    55\t    await this.processAccessService.assertProcessAccess({\n    56\t      actor: args.actor,\n    57\t      projectId: args.projectId,\n    58\t      processId: args.processId,\n    59\t    });\n    60\t\n    61\t    try {\n    62\t      const turns = await this.turnDerivationService.rebuildTurns({\n    63\t        projectId: args.projectId,\n    64\t        processId: args.processId,\n    65\t      });\n    66\t      const views = limitDerivedArchiveViews(buildDerivedArchiveViews(turns, args.processId));\n    67\t\n    68\t      await this.platformStore.replaceDerivedArchiveViews({\n    69\t        projectId: args.projectId,\n    70\t        processId: args.processId,\n    71\t        views,\n    72\t      });\n    73\t\n    74\t      return derivedArchiveViewListResponseSchema.parse({ views });\n    75\t    } catch (error) {\n    76\t      const storedViews = await this.platformStore.listDerivedArchiveViews({\n    77\t        processId: args.processId,\n    78\t      });\n    79\t      if (storedViews.length > 0) {\n    80\t        return derivedArchiveViewListResponseSchema.parse({\n    81\t          views: limitDerivedArchiveViews(storedViews),\n    82\t        });\n    83\t      }\n    84\t\n    85\t      throw error;\n    86\t    }\n    87\t  }\n    88\t\n    89\t  async refreshViews(args: {\n    90\t    actor: AuthenticatedActor;\n    91\t    projectId: string;\n    92\t    processId: string;\n    93\t  }): Promise<DerivedArchiveViewRefreshResponse> {\n    94\t    await this.processAccessService.assertProcessAccess({\n    95\t      actor: args.actor,\n    96\t      projectId: args.projectId,\n    97\t      processId: args.processId,\n    98\t    });\n    99\t\n   100\t    const archiveSignatureBeforeRefresh = await computeArchiveSignature(\n   101\t      this.platformStore,\n   102\t      args.processId,\n   103\t    );\n   104\t    const turns = await this.turnDerivationService.rebuildTurns({\n   105\t      projectId: args.projectId,\n   106\t      processId: args.processId,\n   107\t    });\n   108\t    const archiveSignatureAfterTurnRebuild = await computeArchiveSignature(\n   109\t      this.platformStore,\n   110\t      args.processId,\n   111\t    );\n   112\t\n   113\t    if (archiveSignatureAfterTurnRebuild !== archiveSignatureBeforeRefresh) {\n   114\t      throw new AppError({\n   115\t        code: archiveDerivationConflictErrorCode,\n   116\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n   117\t        statusCode: 409,\n   118\t      });\n   119\t    }\n   120\t\n   121\t    const views = limitDerivedArchiveViews(buildDerivedArchiveViews(turns, args.processId));\n   122\t    await this.platformStore.replaceDerivedArchiveViews({\n   123\t      projectId: args.projectId,\n   124\t      processId: args.processId,\n   125\t      views,\n   126\t    });\n   127\t\n   128\t    const archiveSignatureAfterRefresh = await computeArchiveSignature(\n   129\t      this.platformStore,\n   130\t      args.processId,\n   131\t    );\n   132\t\n   133\t    if (archiveSignatureAfterRefresh !== archiveSignatureBeforeRefresh) {\n   134\t      throw new AppError({\n   135\t        code: archiveDerivationConflictErrorCode,\n   136\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n   137\t        statusCode: 409,\n   138\t      });\n   139\t    }\n   140\t\n   141\t   