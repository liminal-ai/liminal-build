s'), v.null()),\n    43\t  relatedSourceProvenanceId: v.union(v.string(), v.null()),\n    44\t  relatedToolCallId: v.union(v.string(), v.null()),\n    45\t  entryStatus: archiveEntryStatusValidator,\n    46\t  degradationReason: v.union(v.string(), v.null()),\n    47\t  recordedAt: v.string(),\n    48\t};\n    49\t\n    50\tconst archiveEntryWriteArgsValidator = {\n    51\t  projectId: v.string(),\n    52\t  processId: v.string(),\n    53\t  entryKind: archiveEntryKindValidator,\n    54\t  finalizationKey: v.string(),\n    55\t  sourceObjectId: v.optional(v.union(v.string(), v.null())),\n    56\t  bodyText: v.optional(v.union(v.string(), v.null())),\n    57\t  bodyData: v.optional(v.union(archiveEntryBodyDataValidator, v.null())),\n    58\t  bodyFormat: archiveBodyFormatValidator,\n    59\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n    60\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n    61\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n    62\t  entryStatus: v.optional(archiveEntryStatusValidator),\n    63\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n    64\t  recordedAt: v.optional(v.string()),\n    65\t} as const;\n    66\t\n    67\tconst archiveListArgsValidator = {\n    68\t  processId: v.string(),\n    69\t  cursor: v.optional(v.union(v.string(), v.null())),\n    70\t  limit: v.number(),\n    71\t} as const;\n    72\t\n    73\tconst MAX_ARCHIVE_PAGE_SIZE = 200;\n    74\tconst supportedArchiveEntryKinds = new Set([\n    75\t  'user_message',\n    76\t  'model_message',\n    77\t  'reasoning',\n    78\t  'script_emission',\n    79\t  'tool_call',\n    80\t  'tool_result',\n    81\t  'process_event',\n    82\t] satisfies ArchiveEntry['entryKind'][]);\n    83\t\n    84\texport const appendArchiveEntry = mutation({\n    85\t  args: archiveEntryWriteArgsValidator,\n    86\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry> => {\n    87\t    assertArchiveEntryInput(args);\n    88\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n    89\t    const existingEntry = await ctx.db\n    90\t      .query('archiveEntries')\n    91\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n    92\t        indexQuery.eq('processId', processRecord._id).eq('finalizationKey', args.finalizationKey),\n    93\t      )\n    94\t      .unique();\n    95\t\n    96\t    if (existingEntry !== null) {\n    97\t      return buildArchiveEntry(existingEntry);\n    98\t    }\n    99\t\n   100\t    const mostRecentEntry = await ctx.db\n   101\t      .query('archiveEntries')\n   102\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n   103\t        indexQuery.eq('processId', processRecord._id),\n   104\t      )\n   105\t      .order('desc')\n   106\t      .take(1);\n   107\t    const nextSequence = (mostRecentEntry[0]?.sequence ?? -1) + 1;\n   108\t    const archiveEntryId = await ctx.db.insert('archiveEntries', {\n   109\t      projectId: args.projectId,\n   110\t      processId: processRecord._id,\n   111\t      entryKind: args.entryKind,\n   112\t      sequence: nextSequence,\n   113\t      lifecycleState: 'finalized',\n   114\t      finalizationKey: args.finalizationKey,\n   115\t      sourceObjectId: args.sourceObjectId ?? null,\n   116\t      bodyText: args.bodyText ?? null,\n   117\t      bodyData: args.bodyData ?? null,\n   118\t      bodyFormat: args.bodyFormat,\n   119\t      relatedArtifactVersionId:\n   120\t        args.relatedArtifactVersionId === undefined || args.relatedArtifactVersionId === null\n   121\t          ? null\n   122\t          : (args.relatedArtifactVersionId as Id<'artifactVersions'>),\n   123\t      relatedSourceProvenanceId: args.relatedSourceProvenanceId ?? null,\n   124\t      relatedToolCallId: args.relatedToolCallId ?? null,\n   125\t      entryStatus: args.entryStatus ?? 'ready',\n   126\t      degradationReason: args.degradationReason ?? null,\n   127\t      recordedAt: args.recordedAt ?? new Date().toISOString(),\n   128\t    });\n   129\t    const storedEntry = await ctx.db.get(archiveEntryId);\n   130\t\n   131\t    if (storedEntry === null) {\n   132\t      throw new Error('Archive entry was not found after append.');\n   133\t    }\n   134\t\n   135\t    return buildArchiveEntry(storedEntry);\n   136\t  },\n   137\t});\n   138\t\n   139\texport const listArchiveEntries = query({\n   140\t  args: archiveListArgsValidator,\n   141\t  handler: async (ctx: QueryCtx, args): Promise<ArchivePage> => {\n   142\t    assertArchivePageLimit(args.limit);\n   143\t    const processId = args.processId as Id<'processes'>;\n   144\t    const decodedCursor = decodeArchiveCursor(args.cursor ?? null);\n   145\t    const pageWithLookahead = await ctx.db\n   146\t      .query('archiveEntries')\n   147\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n   148\t        decodedCursor === null\n   149\t          ? indexQuery.eq('processId', processId)\n   150\t          : indexQuery.eq('processId', processId).gt('sequence', decodedCursor),\n   151\t      )\n   152\t      .order('asc')\n   153\t      .take(args.limit + 1);\n   154\t    const hasMore = pageWithLookahead.length > args.limit;\n   155\t    const pageEntries = pageWithLookahead\n   156\t      .slice(0, args.limit)\n   157\t      .map((entry) => buildArchiveEntry(entry));\n   158\t    const lastEntry = pageEntries.at(-1);\n   159\t\n   160\t    return {\n   161\t      entries: pageEntries,\n   162\t      page: {\n   163\t        cursor: args.cursor ?? null,\n   164\t        nextCursor: hasMore && lastEntry !== undefined ? String(lastEntry.sequence) : null,\n   165\t        hasMore,\n   166\t      },\n   167\t    };\n   168\t  },\n   169\t});\n   170\t\n   171\tfunction assertArchiveEntryInput(args: {\n   172\t  entryKind: string;\n   173\t  finalizationKey: string;\n   174\t  sourceObjectId?: string | null;\n   175\t  bodyText?: string | null;\n   176\t  bodyData?: { jsonText: string } | null;\n   177\t  bodyFormat: ArchiveEntry['bodyFormat'];\n   178\t  relatedArtifactVersionId?: string | null;\n   179\t  relatedSourceProvenanceId?: string | null;\n   180\t  relatedToolCallId?: string | null;\n   181\t  entryStatus?: ArchiveEntry['entryStatus'];\n   182\t  degradationReason?: string | null;\n   183\t}): void {\n   184\t  if (!supportedArchiveEntryKinds.has(args.entryKind as ArchiveEntry['entryKind'])) {\n   185\t    throw new Error(`Unsupported archive entry kind: ${args.entryKind}`);\n   186\t  }\n   187\t\n   188\t  if (args.finalizationKey.trim().length === 0) {\n   189\t    throw new Error('Archive entries require a non-empty finalization key.');\n   190\t  }\n   191\t\n   192\t  assertOptionalNonEmptyString(args.sourceObjectId, 'Source object id');\n   193\t  assertOptionalNonEmptyString(args.bodyText, 'Archive body text');\n   194\t  assertOptionalNonEmptyString(args.relatedArtifactVersionId, 'Related artifact version id');\n   195\t  assertOptionalNonEmptyString(args.relatedSourceProvenanceId, 'Related source provenance id');\n   196\t  assertOptionalNonEmptyString(args.relatedToolCallId, 'Related tool call id');\n   197\t\n   198\t  if (args.bodyFormat === 'structured' && args.bodyData == null) {\n   199\t    throw new Error('Structured archive entries must include bodyData.');\n   200\t  }\n   201\t\n   202\t  if (args.bodyFormat === 'none' && (args.bodyText != null || args.bodyData != null)) {\n   203\t    throw new Error(\"Archive entries with bodyFormat 'none' cannot include body content.\");\n   204\t  }\n   205\t\n   206\t  if ((args.entryStatus ?? 'ready') === 'degraded' && args.degradationReason == null) {\n   207\t    throw new Error('Degraded archive entries must include a degradation reason.');\n   208\t  }\n   209\t}\n   210\t\n   211\tfunction assertOptionalNonEmptyString(value: string | null | undefined, label: string): void {\n   212\t  if (value !== undefined && value !== null && value.trim().length === 0) {\n   213\t    throw new Error(`${label} must be a non-empty string when provided.`);\n   214\t  }\n   215\t}\n   216\t\n   217\tfunction assertArchivePageLimit(limit: number): void {\n   218\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_ARCHIVE_PAGE_SIZE) {\n   219\t    throw new Error(\n   220\t      `Archive page limit must be an integer between 1 and ${MAX_ARCHIVE_PAGE_SIZE}.`,\n   221\t    );\n   222\t  }\n   223\t}\n   224\t\n   225\tasync function getProcessRecordOrThrow(\n   226\t  ctx: MutationCtx,\n   227\t  processIdValue: string,\n   228\t  projectId: string,\n   229\t): Promise<Doc<'processes'>> {\n   230\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n   231\t\n   232\t  if (processRecord === null) {\n   233\t    throw new Error('Process not found.');\n   234\t  }\n   235\t\n   236\t  if (processRecord.projectId !== projectId) {\n   237\t    throw new Error('Process does not belong to the requested project.');\n   238\t  }\n   239\t\n   240\t  return processRecord;\n   241\t}\n   242\t\n   243\tfunction buildArchiveEntry(record: Doc<'archiveEntries'>): ArchiveEntry {\n   244\t  return {\n   245\t    archiveEntryId: record._id,\n   246\t    projectId: record.projectId,\n   247\t    processId: record.processId,\n   248\t    entryKind: record.entryKind,\n   249\t    sequence: record.sequence,\n   250\t    lifecycleState: record.lifecycleState,\n   251\t    finalizationKey: record.finalizationKey,\n   252\t    sourceObjectId: record.sourceObjectId,\n   253\t    bodyText: record.bodyText,\n   254\t    bodyData: record.bodyData,\n   255\t    bodyFormat: record.bodyFormat,\n   256\t    relatedArtifactVersionId: record.relatedArtifactVersionId,\n   257\t    relatedSourceProvenanceId: record.relatedSourceProvenanceId,\n   258\t    relatedToolCallId: record.relatedToolCallId,\n   259\t    entryStatus: record.entryStatus,\n   260\t    degradationReason: record.degradationReason,\n   261\t    recordedAt: record.recordedAt,\n   262\t  };\n   263\t}\n   264\t\n   265\tfunction decodeArchiveCursor(cursor: string | null): number | null {\n   266\t  if (cursor == null) {\n   267\t    return null;\n   268\t  }\n   269\t\n   270\t  const parsed = Number.parseInt(cursor, 10);\n   271\t  return Number.isNaN(parsed) ? null : parsed;\n   272\t}\n","exit_code":0,"status":"completed"}}
