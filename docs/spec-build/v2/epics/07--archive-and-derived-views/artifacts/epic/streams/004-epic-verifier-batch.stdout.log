{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,360p' apps/platform/server/services/processes/environment/script-execution.service.ts\"","aggregated_output":"import type {\n  ExecutionResult,\n  ProviderAdapter,\n  ProviderKind,\n  ScriptPayload,\n} from './provider-adapter.js';\nimport type { ProviderAdapterRegistry } from './provider-adapter-registry.js';\nimport type { HydrationPlanSourceInput } from './provider-adapter.js';\n\ntype RuntimeAuditSourceInput = Pick<\n  HydrationPlanSourceInput,\n  'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n>;\n\nfunction buildIntegratedRuntimeAuditSource(args: {\n  sourceInputs: RuntimeAuditSourceInput[];\n}): string {\n  return `// liminal-build integrated runtime audit payload.\n// Observes the hydrated workspace, writes a runtime report artifact, and when\n// possible records a real source-side note inside a writable attached repo.\nimport { promises as fs } from 'node:fs';\nimport * as path from 'node:path';\nconst sourceInputs = ${JSON.stringify(args.sourceInputs)};\nconst now = new Date().toISOString();\nconst artifactRelativePath = 'artifacts/runtime-execution-report.md';\nconst artifactAbsolutePath = path.join(process.cwd(), artifactRelativePath);\nconst writableSource = sourceInputs.find((source) => source.accessMode === 'read_write') ?? null;\nconst informingSource = writableSource ?? sourceInputs[0] ?? null;\nconst toolCallId = \\`runtime-audit-tool-call-\\${now}\\`;\nconst sanitizeSegment = (raw) => {\n  const trimmed = raw.trim();\n  const replaced = trimmed.replace(/[^a-zA-Z0-9._-]+/g, '-');\n  return replaced.length === 0 ? 'unnamed' : replaced;\n};\nconst listDirectoryEntriesSafe = async (relativeDir) => {\n  try {\n    return await fs.readdir(path.join(process.cwd(), relativeDir), { withFileTypes: true });\n  } catch {\n    return [];\n  }\n};\nconst resolveSourceWorkspaceRef = async (source, filePath) => {\n  const sourceDirCandidates = [\n    path.join(\n      'sources',\n      \\`\\${sanitizeSegment(source.sourceAttachmentId)}-\\${sanitizeSegment(source.displayName)}\\`,\n    ),\n    path.join(\n      'sources',\n      \\`\\${sanitizeSegment(source.displayName)}-\\${sanitizeSegment(source.sourceAttachmentId)}\\`,\n    ),\n  ];\n  for (const relativePath of sourceDirCandidates) {\n    try {\n      await fs.access(path.join(process.cwd(), relativePath));\n      return path.join(relativePath, filePath);\n    } catch {}\n  }\n  return path.join(sourceDirCandidates[0], filePath);\n};\nconst hydratedArtifacts = await listDirectoryEntriesSafe('artifacts');\nconst hydratedSources = await listDirectoryEntriesSafe('sources');\nconst sourceObservations = await Promise.all(\n  hydratedSources\n    .filter((entry) => entry.isDirectory())\n    .map(async (entry) => {\n      const relativeSourceDir = path.join('sources', entry.name);\n      const childEntries = await listDirectoryEntriesSafe(relativeSourceDir);\n      return {\n        directory: entry.name,\n        fileCount: childEntries.length,\n        sampleEntries: childEntries.slice(0, 5).map((child) => child.name),\n      };\n    }),\n);\nconst artifactContents = [\n  '# Runtime Execution Report',\n  '',\n  'This report was generated by the integrated runtime path after inspecting the hydrated workspace.',\n  '',\n  \\`Generated: \\${now}\\`,\n  \\`Hydrated artifact files: \\${hydratedArtifacts.length}\\`,\n  \\`Hydrated source worktrees: \\${sourceObservations.length}\\`,\n  \\`Primary source: \\${informingSource?.displayName ?? 'none'}\\`,\n  '',\n  'Observed source worktrees:',\n  ...(sourceObservations.length === 0\n    ? ['- none']\n    : sourceObservations.map(\n        (observation) =>\n          \\`- \\${observation.directory}: \\${observation.fileCount} entries (\\${observation.sampleEntries.join(', ') || 'no visible files'})\\`,\n      )),\n].join('\\\\n');\nawait fs.mkdir(path.dirname(artifactAbsolutePath), { recursive: true });\nawait fs.writeFile(artifactAbsolutePath, artifactContents, 'utf8');\nconst codeCheckpointCandidates = [];\nif (writableSource !== null) {\n  const codeFilePath = 'liminal-runtime-observation.md';\n  const workspaceRef = await resolveSourceWorkspaceRef(writableSource, codeFilePath);\n  const workspacePath = path.join(process.cwd(), workspaceRef);\n  const codeContents = [\n    '# Runtime Observation',\n    '',\n    \\`Generated: \\${now}\\`,\n    \\`Source: \\${writableSource.displayName}\\`,\n    \\`Observed hydrated source count: \\${sourceObservations.length}\\`,\n    \\`Observed artifact file count: \\${hydratedArtifacts.length}\\`,\n  ].join('\\\\n');\n  await fs.mkdir(path.dirname(workspacePath), { recursive: true });\n  await fs.writeFile(workspacePath, codeContents, 'utf8');\n  codeCheckpointCandidates.push({\n    sourceAttachmentId: writableSource.sourceAttachmentId,\n    displayName: writableSource.displayName,\n    targetRef: writableSource.targetRef,\n    accessMode: writableSource.accessMode,\n    workspaceRef,\n    filePath: codeFilePath,\n    commitMessage: 'Record runtime observation note',\n  });\n}\nconst result = {\n  processStatus: 'completed',\n  processHistoryItems: [\n    {\n      historyItemId: \\`runtime-execution-history-\\${now}\\`,\n      kind: 'process_event',\n      lifecycleState: 'finalized',\n      text: 'Runtime execution inspection completed and recorded workspace observations.',\n      createdAt: now,\n      relatedSideWorkId: null,\n      relatedArtifactId: null,\n    },\n  ],\n  archiveEntries: [\n    {\n      entryKind: 'reasoning',\n      finalizationKey: \\`reasoning:\\${now}\\`,\n      sourceObjectId: \\`reasoning:\\${now}\\`,\n      bodyText: \\`Inspected \\${hydratedArtifacts.length} hydrated artifact files and \\${sourceObservations.length} source worktrees before finalizing the runtime archive batch.\\`,\n      bodyData: null,\n      bodyFormat: 'plain_text',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: null,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'tool_call',\n      finalizationKey: \\`tool-call:\\${toolCallId}\\`,\n      sourceObjectId: toolCallId,\n      bodyText: null,\n      bodyData: {\n        jsonText: JSON.stringify({\n          tool: 'inspect_runtime_workspace',\n          artifactTarget: artifactRelativePath,\n          writableSourceTarget: writableSource?.displayName ?? null,\n        }),\n      },\n      bodyFormat: 'structured',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: toolCallId,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'tool_result',\n      finalizationKey: \\`tool-result:\\${toolCallId}\\`,\n      sourceObjectId: \\`tool-result:\\${toolCallId}\\`,\n      bodyText: null,\n      bodyData: {\n        jsonText: JSON.stringify({\n          ok: true,\n          observedArtifacts: hydratedArtifacts.length,\n          observedSourceWorktrees: sourceObservations.length,\n          wroteArtifactReport: artifactRelativePath,\n          wroteSourceObservation: writableSource !== null,\n        }),\n      },\n      bodyFormat: 'structured',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: toolCallId,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'model_message',\n      finalizationKey: \\`model:\\${now}\\`,\n      sourceObjectId: \\`model:\\${now}\\`,\n      bodyText: [\n        'Runtime inspection completed.',\n        '',\n        \\`Report: \\${artifactRelativePath}\\`,\n        \\`Primary source: \\${informingSource?.displayName ?? 'none'}\\`,\n        \\`Observed source worktrees: \\${sourceObservations.length}\\`,\n      ].join('\\\\n'),\n      bodyData: null,\n      bodyFormat: 'markdown',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: null,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'process_event',\n      finalizationKey: \\`event:\\${now}\\`,\n      sourceObjectId: \\`event:\\${now}\\`,\n      bodyText: 'Runtime inspection completed and finalized archive observations.',\n      bodyData: null,\n      bodyFormat: 'plain_text',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: null,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: null,\n      sourceProvenanceBinding: null,\n    },\n    {\n      entryKind: 'script_emission',\n      finalizationKey: \\`script:\\${now}\\`,\n      sourceObjectId: \\`script:\\${now}\\`,\n      bodyText: artifactContents,\n      bodyData: null,\n      bodyFormat: 'plain_text',\n      relatedArtifactVersionId: null,\n      relatedSourceProvenanceId: null,\n      relatedToolCallId: null,\n      entryStatus: 'ready',\n      degradationReason: null,\n      recordedAt: now,\n      artifactCheckpointIndex: 0,\n      sourceProvenanceBinding:\n        informingSource === null\n          ? null\n          : {\n              relationshipKind: 'informed_work',\n              sourceAttachmentId: informingSource.sourceAttachmentId,\n            },\n    },\n  ],\n  outputWrites: [\n    {\n      displayName: 'Runtime Execution Report',\n      revisionLabel: 'runtime-audit-v1',\n      linkedArtifactId: null,\n      state: 'ready_for_review',\n      updatedAt: now,\n    },\n  ],\n  sideWorkWrites: [\n    {\n      displayLabel: 'Runtime inspection',\n      purposeSummary: 'Inspect hydrated runtime materials and record a canonical archive report.',\n      status: 'completed',\n      resultSummary:\n        writableSource === null\n          ? \\`Observed \\${hydratedArtifacts.length} artifact files and \\${sourceObservations.length} source worktrees without a writable source note.\\`\n          : \\`Observed \\${hydratedArtifacts.length} artifact files and \\${sourceObservations.length} source worktrees, then staged a writable runtime note.\\`,\n      updatedAt: now,\n    },\n  ],\n  artifactCheckpointCandidates: [\n    {\n      artifactId: undefined,\n      displayName: 'Runtime Execution Report',\n      revisionLabel: 'runtime-audit-v1',\n      contentsRef: artifactRelativePath,\n    },\n  ],\n  codeCheckpointCandidates,\n  usedSourceAttachmentIds: informingSource === null ? [] : [informingSource.sourceAttachmentId],\n};\nawait fs.writeFile(\n  path.join(process.cwd(), '_liminal_exec_result.json'),\n  JSON.stringify(result, null, 2),\n  'utf8',\n);\n`;\n}\n\nexport function buildIntegratedRuntimeAuditPayload(\n  args: {\n    sourceInputs?: Array<\n      Pick<\n        HydrationPlanSourceInput,\n        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n      >\n    >;\n  } = {},\n): ScriptPayload {\n  const sourceInputs: RuntimeAuditSourceInput[] = [...(args.sourceInputs ?? [])];\n  return {\n    format: 'ts-module-source',\n    entrypoint: 'default',\n    source: buildIntegratedRuntimeAuditSource({\n      sourceInputs,\n    }),\n  };\n}\n\n/**\n * Thin wrapper around `ProviderAdapter.executeScript` that packages the\n * current integrated runtime audit payload and resolves the correct provider\n * adapter from the registry.\n */\nexport class ScriptExecutionService {\n  constructor(\n    private readonly providerAdapterRegistry: ProviderAdapterRegistry,\n    private readonly scriptPayloadFactory: (args: {\n      currentSources: Array<\n        Pick<\n          HydrationPlanSourceInput,\n          'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n        >\n      >;\n    }) => ScriptPayload = ({ currentSources }) =>\n      buildIntegratedRuntimeAuditPayload({\n        sourceInputs: currentSources,\n      }),\n  ) {}\n\n  async executeFor(args: {\n    providerKind: ProviderKind;\n    environmentId: string;\n    currentSources?: Array<\n      Pick<\n        HydrationPlanSourceInput,\n        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n      >\n    >;\n  }): Promise<ExecutionResult> {\n    const adapter: ProviderAdapter = this.providerAdapterRegistry.resolve(args.providerKind);\n    return adapter.executeScript({\n      environmentId: args.environmentId,\n      scriptPayload: this.scriptPayloadFactory({\n        currentSources: args.currentSources ?? [],\n      }),\n    });\n  }\n}\n","exit_code":0,"status":"completed"}}
