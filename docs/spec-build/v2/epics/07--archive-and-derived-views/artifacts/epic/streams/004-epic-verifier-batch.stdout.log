        },\n   192\t        {\n   193\t          turnId: `${processId}:turn:1`,\n   194\t          turnIndex: 1,\n   195\t          turnStatus: 'ready',\n   196\t        },\n   197\t      ],\n   198\t      page: {\n   199\t        cursor: null,\n   200\t        nextCursor: null,\n   201\t        hasMore: false,\n   202\t      },\n   203\t    });\n   204\t\n   205\t    await app.close();\n   206\t  });\n   207\t\n   208\t  it('TC-4.1b empty archive produces empty turn view', async () => {\n   209\t    const store = buildStore([]);\n   210\t    const app = await buildTurnsApp(store);\n   211\t    const response = await app.inject({\n   212\t      method: 'GET',\n   213\t      url: buildProcessArchiveTurnsApiPath({ projectId, processId }),\n   214\t      cookies: {\n   215\t        [sessionCookieName]: 'valid-session-cookie',\n   216\t      },\n   217\t    });\n   218\t\n   219\t    expect(response.statusCode).toBe(200);\n   220\t    expect(response.json()).toEqual({\n   221\t      turns: [],\n   222\t      page: {\n   223\t        cursor: null,\n   224\t        nextCursor: null,\n   225\t        hasMore: false,\n   226\t      },\n   227\t    });\n   228\t\n   229\t    await app.close();\n   230\t  });\n   231\t\n   232\t  it('TC-4.2a turn includes archive entry references', async () => {\n   233\t    const store = buildStore(buildHappyPathArchiveEntries());\n   234\t    const app = await buildTurnsApp(store);\n   235\t    const response = await app.inject({\n   236\t      method: 'GET',\n   237\t      url: buildProcessArchiveTurnsApiPath({ projectId, processId }),\n   238\t      cookies: {\n   239\t        [sessionCookieName]: 'valid-session-cookie',\n   240\t      },\n   241\t    });\n   242\t\n   243\t    expect(response.statusCode).toBe(200);\n   244\t    expect(response.json()).toMatchObject({\n   245\t      turns: [\n   246\t        {\n   247\t          archiveEntryIds: [\n   248\t            'archive-entry-user-101',\n   249\t            'archive-entry-model-101