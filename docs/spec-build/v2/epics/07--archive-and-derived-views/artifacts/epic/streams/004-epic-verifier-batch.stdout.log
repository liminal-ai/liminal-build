{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba convex/archiveTurns.ts | sed -n '1,240p'\"","aggregated_output":"     1\timport type { ArchiveTurnPage, DerivedTurn } from '../apps/platform/shared/contracts/index.js';\n     2\timport type { Doc, Id } from './_generated/dataModel.js';\n     3\timport { mutation, query, type MutationCtx, type QueryCtx } from './_generated/server.js';\n     4\timport { v } from 'convex/values';\n     5\timport { archiveEntryStatusValidator } from './archiveEntries.js';\n     6\t\n     7\texport const archiveTurnsTableFields = {\n     8\t  projectId: v.string(),\n     9\t  processId: v.id('processes'),\n    10\t  turnId: v.string(),\n    11\t  turnIndex: v.number(),\n    12\t  archiveEntryIds: v.array(v.id('archiveEntries')),\n    13\t  startedAt: v.string(),\n    14\t  endedAt: v.string(),\n    15\t  turnStatus: archiveEntryStatusValidator,\n    16\t  degradationReason: v.union(v.string(), v.null()),\n    17\t  rebuiltAt: v.string(),\n    18\t};\n    19\t\n    20\tconst derivedTurnValidator = v.object({\n    21\t  turnId: v.string(),\n    22\t  processId: v.string(),\n    23\t  turnIndex: v.number(),\n    24\t  archiveEntryIds: v.array(v.string()),\n    25\t  startedAt: v.string(),\n    26\t  endedAt: v.string(),\n    27\t  turnStatus: archiveEntryStatusValidator,\n    28\t  degradationReason: v.union(v.string(), v.null()),\n    29\t});\n    30\t\n    31\tconst upsertArchiveTurnsArgsValidator = {\n    32\t  projectId: v.string(),\n    33\t  processId: v.string(),\n    34\t  turns: v.array(derivedTurnValidator),\n    35\t} as const;\n    36\t\n    37\tconst listArchiveTurnsArgsValidator = {\n    38\t  processId: v.string(),\n    39\t  cursor: v.optional(v.union(v.string(), v.null())),\n    40\t  limit: v.number(),\n    41\t} as const;\n    42\t\n    43\tconst MAX_TURN_PAGE_SIZE = 100;\n    44\t\n    45\texport const upsertArchiveTurns = mutation({\n    46\t  args: upsertArchiveTurnsArgsValidator,\n    47\t  handler: async (ctx: MutationCtx, args): Promise<null> => {\n    48\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n    49\t    const rebuiltAt = new Date().toISOString();\n    50\t    const existingTurns = await ctx.db\n    51\t      .query('archiveTurns')\n    52\t      .withIndex('by_processId_and_turnId', (indexQuery) =>\n    53\t        indexQuery.eq('processId', processRecord._id),\n    54\t      )\n    55\t      .collect();\n    56\t    const existingByTurnId = new Map(existingTurns.map((turn) => [turn.turnId, turn]));\n    57\t    const nextTurnIds = new Set<string>();\n    58\t\n    59\t    for (const turn of [...args.turns].sort((left, right) => left.turnIndex - right.turnIndex)) {\n    60\t      assertDerivedTurn(turn, args.processId);\n    61\t      nextTurnIds.add(turn.turnId);\n    62\t      const storedTurn = {\n    63\t        projectId: args.projectId,\n    64\t        processId: processRecord._id,\n    65\t        turnId: turn.turnId,\n    66\t        turnIndex: turn.turnIndex,\n    67\t        archiveEntryIds: turn.archiveEntryIds.map((entryId) => entryId as Id<'archiveEntries'>),\n    68\t        startedAt: turn.startedAt,\n    69\t        endedAt: turn.endedAt,\n    70\t        turnStatus: turn.turnStatus,\n    71\t        degradationReason: turn.degradationReason,\n    72\t        rebuiltAt,\n    73\t      };\n    74\t      const existing = existingByTurnId.get(turn.turnId);\n    75\t\n    76\t      if (existing === undefined) {\n    77\t        await ctx.db.insert('archiveTurns', storedTurn);\n    78\t        continue;\n    79\t      }\n    80\t\n    81\t      await ctx.db.patch(existing._id, storedTurn);\n    82\t    }\n    83\t\n    84\t    for (const existing of existingTurns) {\n    85\t      if (!nextTurnIds.has(existing.turnId)) {\n    86\t        await ctx.db.delete(existing._id);\n    87\t      }\n    88\t    }\n    89\t\n    90\t    return null;\n    91\t  },\n    92\t});\n    93\t\n    94\texport const listArchiveTurns = query({\n    95\t  args: listArchiveTurnsArgsValidator,\n    96\t  handler: async (ctx: QueryCtx, args): Promise<ArchiveTurnPage> => {\n    97\t    assertTurnPageLimit(args.limit);\n    98\t    const processId = args.processId as Id<'processes'>;\n    99\t    const decodedCursor = decodeArchiveTurnCursor(args.cursor ?? null);\n   100\t    const pageWithLookahead = await ctx.db\n   101\t      .query('archiveTurns')\n   102\t      .withIndex('by_processId_and_turnIndex', (indexQuery) =>\n   103\t        decodedCursor === null\n   104\t          ? indexQuery.eq('processId', processId)\n   105\t          : indexQuery.eq('processId', processId).gt('turnIndex', decodedCursor),\n   106\t      )\n   107\t      .order('asc')\n   108\t      .take(args.limit + 1);\n   109\t    const hasMore = pageWithLookahead.length > args.limit;\n   110\t    const pageTurns = pageWithLookahead.slice(0, args.limit).map((turn) => buildDerivedTurn(turn));\n   111\t    const lastTurn = pageTurns.at(-1);\n   112\t\n   113\t    return {\n   114\t      turns: pageTurns,\n   115\t      page: {\n   116\t        cursor: args.cursor ?? null,\n   117\t        nextCursor: hasMore && lastTurn !== undefined ? String(lastTurn.turnIndex) : null,\n   118\t        hasMore,\n   119\t      },\n   120\t    };\n   121\t  },\n   122\t});\n   123\t\n   124\tasync function getProcessRecordOrThrow(\n   125\t  ctx: MutationCtx,\n   126\t  processIdValue: string,\n   127\t  projectId: string,\n   128\t): Promise<Doc<'processes'>> {\n   129\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n   130\t\n   131\t  if (processRecord === null) {\n   132\t    throw new Error('Process not found.');\n   133\t  }\n   134\t\n   135\t  if (processRecord.projectId !== projectId) {\n   136\t    throw new Error('Process does not belong to the requested project.');\n   137\t  }\n   138\t\n   139\t  return processRecord;\n   140\t}\n   141\t\n   142\tfunction buildDerivedTurn(record: Doc<'archiveTurns'>): DerivedTurn {\n   143\t  return {\n   144\t    turnId: record.turnId,\n   145\t    processId: record.processId,\n   146\t    turnIndex: record.turnIndex,\n   147\t    archiveEntryIds: [...record.archiveEntryIds],\n   148\t    startedAt: record.startedAt,\n   149\t    endedAt: record.endedAt,\n   150\t    turnStatus: record.turnStatus,\n   151\t    degradationReason: record.degradationReason,\n   152\t  };\n   153\t}\n   154\t\n   155\tfunction assertDerivedTurn(turn: DerivedTurn, processId: string): void {\n   156\t  if (turn.turnId.trim().length === 0) {\n   157\t    throw new Error('Derived turns require a non-empty turnId.');\n   158\t  }\n   159\t\n   160\t  if (turn.processId !== processId) {\n   161\t    throw new Error('Derived turn processId must match the enclosing process.');\n   162\t  }\n   163\t\n   164\t  if (!Number.isInteger(turn.turnIndex) || turn.turnIndex < 0) {\n   165\t    throw new Error('Derived turns require a non-negative turnIndex.');\n   166\t  }\n   167\t\n   168\t  if (turn.archiveEntryIds.length === 0) {\n   169\t    throw new Error('Derived turns require at least one archive entry id.');\n   170\t  }\n   171\t\n   172\t  if (turn.archiveEntryIds.some((archiveEntryId) => archiveEntryId.trim().length === 0)) {\n   173\t    throw new Error('Derived turn archive entry ids must be non-empty strings.');\n   174\t  }\n   175\t\n   176\t  if (\n   177\t    turn.turnStatus === 'degraded' &&\n   178\t    (turn.degradationReason === null || turn.degradationReason.trim().length === 0)\n   179\t  ) {\n   180\t    throw new Error('Degraded turns must include a degradation reason.');\n   181\t  }\n   182\t}\n   183\t\n   184\tfunction assertTurnPageLimit(limit: number): void {\n   185\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_TURN_PAGE_SIZE) {\n   186\t    throw new Error(`Turn page limit must be an integer between 1 and ${MAX_TURN_PAGE_SIZE}.`);\n   187\t  }\n   188\t}\n   189\t\n   190\tfunction decodeArchiveTurnCursor(cursor: string | null): number | null {\n   191\t  if (cursor == null) {\n   192\t    return null;\n   193\t  }\n   194\t\n   195\t  const parsed = Number.parseInt(cursor, 10);\n   196\t  return Number.isNaN(parsed) ? null : parsed;\n   197\t}\n","exit_code":0,"status":"completed"}}
