\n  1769\t): string | null {\n  1770\t  if (target === undefined) {\n  1771\t    return null;\n  1772\t  }\n  1773\t\n  1774\t  return target.targetRef ?? sourceSummariesById.get(target.sourceAttachmentId)?.targetRef ?? null;\n  1775\t}\n  1776\t\n  1777\tfunction deriveUsedSourceAttachmentIds(executionResult: ExecutionResult): string[] {\n  1778\t  if (executionResult.usedSourceAttachmentIds !== undefined) {\n  1779\t    return Array.from(new Set(executionResult.usedSourceAttachmentIds));\n  1780\t  }\n  1781\t\n  1782\t  return Array.from(\n  1783\t    new Set(\n  1784\t      executionResult.codeCheckpointCandidates.map((candidate) => candidate.sourceAttachmentId),\n  1785\t    ),\n  1786\t  );\n  1787\t}\n  1788\t\n  1789\tfunction archiveEntryRequiresDeferredRelations(entry: RuntimeArchiveEntry): boolean {\n  1790\t  return entry.artifactCheckpointIndex != null || entry.sourceProvenanceBinding != null;\n  1791\t}\n  1792\t\n  1793\tfunction extractExecutionFailureReason(executionResult: ExecutionResult): string {\n  1794\t  // Spec: ExecutionResult does not carry a top-level `failureReason`. The\n  1795\t  // canonical place for the failure description is the `processHistoryItems`\n  1796\t  // entries the script produced. Take the most recent finalized text, falling\n  1797\t  // back to the generic label so the env summary always has a non-empty\n  1798\t  // blockedReason for failed runs.\n  1799\t  const lastFailureItem = [...executionResult.processHistoryItems]\n  1800\t    .reverse()\n  1801\t    .find((item) => item.lifecycleState === 'finalized' && item.text.trim().length > 0);\n  1802\t  if (lastFailureItem !== undefined) {\n  1803\t    return lastFailureItem.text;\n  1804\t  }\n  1805\t  return 'Execution failed.';\n  1806\t}\n  1807\t\n  1808\t/**\n  1809\t * Resolves a candidate `contentsRef` / `workspaceRef` to actual textual\n  1810\t * content. For LocalProvider, refs are filesystem paths (absolute or relative\n  1811\t * to the working tree) and 