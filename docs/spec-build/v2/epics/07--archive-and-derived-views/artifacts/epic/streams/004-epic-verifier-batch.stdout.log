\n   216\t  };\n   217\t}\n   218\t\n   219\tfunction normalizeProcessSourceProvenance(\n   220\t  response: ListProcessSourceProvenanceResponse,\n   221\t): ProcessSourceProvenanceSectionState {\n   222\t  return {\n   223\t    status: response.entries.length === 0 ? 'empty' : 'ready',\n   224\t    entries: response.entries,\n   225\t  };\n   226\t}\n   227\t\n   228\tfunction buildUnavailableProcessSourceProvenanceState(): ProcessSourceProvenanceSectionState {\n   229\t  return {\n   230\t    status: 'error',\n   231\t    entries: [],\n   232\t    error: {\n   233\t      code: 'PROCESS_SOURCE_PROVENANCE_UNAVAILABLE',\n   234\t      message: 'Source provenance is unavailable right now. Reload the page or try again later.',\n   235\t    },\n   236\t  };\n   237\t}\n   238\t\n   239\tasync function loadProcessSourceProvenanceSafely(args: { projectId: string; processId: string }) {\n   240\t  try {\n   241\t    return normalizeProcessSourceProvenance(await getProcessSourceProvenance(args));\n   242\t  } catch (error) {\n   243\t    if (error instanceof ApiRequestError && error.payload.code === 'UNAUTHENTICATED') {\n   244\t      throw error;\n   245\t    }\n   246\t\n   247\t    return buildUnavailableProcessSourceProvenanceState();\n   248\t  }\n   249\t}\n   250\t\n   251\texport async function bootstrapApp(\n   252\t  targetWindow: Window & typeof globalThis = window,\n   253\t): Promise<void> {\n   254\t  const bootstrap = getShellBootstrapPayload(targetWindow);\n   255\t  const parsedRoute = parseRoute(new URL(targetWindow.location.href));\n   256\t  const processSurfaceRouteIdentity = getProcessSurfaceRouteIdentity(parsedRoute);\n   257\t  const archiveRouteIdentity = getArchiveRouteIdentity(parsedRoute);\n   258\t  const reviewWorkspaceRouteIdentity = getReviewWorkspaceRouteIdentity(parsedRoute);\n   259\t  const initialState: Partial<AppState> = {\n   260\t    auth: {\n   261\t      actor: bootstrap?.actor ?? null,\n   262\t      isResolved: true,\n   263\t   