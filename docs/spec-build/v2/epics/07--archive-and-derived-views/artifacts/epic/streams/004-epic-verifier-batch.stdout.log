{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/services/archive/derived-archive-view.service.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport type {\n     2\t  ArchiveEntry,\n     3\t  ArchivePage,\n     4\t  DerivedArchiveView,\n     5\t  DerivedArchiveViewListResponse,\n     6\t  DerivedArchiveViewRefreshResponse,\n     7\t  DerivedTurn,\n     8\t} from '../../../shared/contracts/index.js';\n     9\timport {\n    10\t  derivedArchiveViewListResponseSchema,\n    11\t  derivedArchiveViewRefreshResponseSchema,\n    12\t} from '../../../shared/contracts/index.js';\n    13\timport { AppError } from '../../errors/app-error.js';\n    14\timport {\n    15\t  archiveDerivationConflictErrorCode,\n    16\t  invalidArchiveRequestErrorCode,\n    17\t} from '../../errors/codes.js';\n    18\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n    19\timport type { ProcessAccessService } from '../processes/process-access.service.js';\n    20\timport type { PlatformStore } from '../projects/platform-store.js';\n    21\timport type { TurnDerivationService } from './turn-derivation.service.js';\n    22\t\n    23\tconst ARCHIVE_REBUILD_PAGE_LIMIT = 200;\n    24\tconst CHUNK_CANDIDATE_GROUP_SIZE = 2;\n    25\tconst MAX_DERIVED_ARCHIVE_VIEWS = 50;\n    26\t\n    27\texport interface DerivedArchiveViewService {\n    28\t  listViews(args: {\n    29\t    actor: AuthenticatedActor;\n    30\t    projectId: string;\n    31\t    processId: string;\n    32\t  }): Promise<DerivedArchiveViewListResponse>;\n    33\t  refreshViews(args: {\n    34\t    actor: AuthenticatedActor;\n    35\t    projectId: string;\n    36\t    processId: string;\n    37\t  }): Promise<DerivedArchiveViewRefreshResponse>;\n    38\t}\n    39\t\n    40\texport class DefaultDerivedArchiveViewService implements DerivedArchiveViewService {\n    41\t  constructor(\n    42\t    private readonly platformStore: Pick<\n    43\t      PlatformStore,\n    44\t      'listArchiveEntries' | 'listDerivedArchiveViews' | 'replaceDerivedArchiveViews'\n    45\t    >,\n    46\t    private readonly turnDerivationService: Pick<TurnDerivationService, 'rebuildTurns'>,\n    47\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n    48\t  ) {}\n    49\t\n    50\t  async listViews(args: {\n    51\t    actor: AuthenticatedActor;\n    52\t    projectId: string;\n    53\t    processId: string;\n    54\t  }): Promise<DerivedArchiveViewListResponse> {\n    55\t    await this.processAccessService.assertProcessAccess({\n    56\t      actor: args.actor,\n    57\t      projectId: args.projectId,\n    58\t      processId: args.processId,\n    59\t    });\n    60\t\n    61\t    try {\n    62\t      const turns = await this.turnDerivationService.rebuildTurns({\n    63\t        projectId: args.projectId,\n    64\t        processId: args.processId,\n    65\t      });\n    66\t      const views = limitDerivedArchiveViews(buildDerivedArchiveViews(turns, args.processId));\n    67\t\n    68\t      await this.platformStore.replaceDerivedArchiveViews({\n    69\t        projectId: args.projectId,\n    70\t        processId: args.processId,\n    71\t        views,\n    72\t      });\n    73\t\n    74\t      return derivedArchiveViewListResponseSchema.parse({ views });\n    75\t    } catch (error) {\n    76\t      const storedViews = await this.platformStore.listDerivedArchiveViews({\n    77\t        processId: args.processId,\n    78\t      });\n    79\t      if (storedViews.length > 0) {\n    80\t        return derivedArchiveViewListResponseSchema.parse({\n    81\t          views: limitDerivedArchiveViews(storedViews),\n    82\t        });\n    83\t      }\n    84\t\n    85\t      throw error;\n    86\t    }\n    87\t  }\n    88\t\n    89\t  async refreshViews(args: {\n    90\t    actor: AuthenticatedActor;\n    91\t    projectId: string;\n    92\t    processId: string;\n    93\t  }): Promise<DerivedArchiveViewRefreshResponse> {\n    94\t    await this.processAccessService.assertProcessAccess({\n    95\t      actor: args.actor,\n    96\t      projectId: args.projectId,\n    97\t      processId: args.processId,\n    98\t    });\n    99\t\n   100\t    const archiveSignatureBeforeRefresh = await computeArchiveSignature(\n   101\t      this.platformStore,\n   102\t      args.processId,\n   103\t    );\n   104\t    const turns = await this.turnDerivationService.rebuildTurns({\n   105\t      projectId: args.projectId,\n   106\t      processId: args.processId,\n   107\t    });\n   108\t    const archiveSignatureAfterTurnRebuild = await computeArchiveSignature(\n   109\t      this.platformStore,\n   110\t      args.processId,\n   111\t    );\n   112\t\n   113\t    if (archiveSignatureAfterTurnRebuild !== archiveSignatureBeforeRefresh) {\n   114\t      throw new AppError({\n   115\t        code: archiveDerivationConflictErrorCode,\n   116\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n   117\t        statusCode: 409,\n   118\t      });\n   119\t    }\n   120\t\n   121\t    const views = limitDerivedArchiveViews(buildDerivedArchiveViews(turns, args.processId));\n   122\t    await this.platformStore.replaceDerivedArchiveViews({\n   123\t      projectId: args.projectId,\n   124\t      processId: args.processId,\n   125\t      views,\n   126\t    });\n   127\t\n   128\t    const archiveSignatureAfterRefresh = await computeArchiveSignature(\n   129\t      this.platformStore,\n   130\t      args.processId,\n   131\t    );\n   132\t\n   133\t    if (archiveSignatureAfterRefresh !== archiveSignatureBeforeRefresh) {\n   134\t      throw new AppError({\n   135\t        code: archiveDerivationConflictErrorCode,\n   136\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n   137\t        statusCode: 409,\n   138\t      });\n   139\t    }\n   140\t\n   141\t    return derivedArchiveViewRefreshResponseSchema.parse({\n   142\t      views,\n   143\t      refreshStatus: views.some((view) => view.viewStatus === 'degraded') ? 'degraded' : 'settled',\n   144\t    });\n   145\t  }\n   146\t}\n   147\t\n   148\tasync function computeArchiveSignature(\n   149\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n   150\t  processId: string,\n   151\t): Promise<string> {\n   152\t  const entries = await listAllArchiveEntries(platformStore, processId);\n   153\t\n   154\t  return entries\n   155\t    .map((entry) => `${entry.archiveEntryId}:${entry.sequence}:${entry.recordedAt}`)\n   156\t    .join('|');\n   157\t}\n   158\t\n   159\tasync function listAllArchiveEntries(\n   160\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n   161\t  processId: string,\n   162\t): Promise<ArchiveEntry[]> {\n   163\t  const entries: ArchiveEntry[] = [];\n   164\t  let cursor: string | null = null;\n   165\t\n   166\t  for (;;) {\n   167\t    const page: ArchivePage = await platformStore.listArchiveEntries({\n   168\t      processId,\n   169\t      cursor,\n   170\t      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n   171\t    });\n   172\t    entries.push(...page.entries);\n   173\t\n   174\t    if (!page.page.hasMore || page.page.nextCursor === null) {\n   175\t      break;\n   176\t    }\n   177\t\n   178\t    cursor = normalizeArchiveCursor(page.page.nextCursor);\n   179\t  }\n   180\t\n   181\t  return entries.sort((left, right) => left.sequence - right.sequence);\n   182\t}\n   183\t\n   184\tfunction buildDerivedArchiveViews(turns: DerivedTurn[], processId: string): DerivedArchiveView[] {\n   185\t  if (turns.length === 0) {\n   186\t    return [];\n   187\t  }\n   188\t\n   189\t  const now = Date.now();\n   190\t  const turnRangeViews = turns.map((turn, index) =>\n   191\t    buildStructuralView({\n   192\t      processId,\n   193\t      viewKind: 'turn_range',\n   194\t      rangeTurns: [turn],\n   195\t      updatedAt: new Date(now - index).toISOString(),\n   196\t    }),\n   197\t  );\n   198\t  const chunkCandidateViews = groupTurnsForChunkCandidates(turns).map((group, index) =>\n   199\t    buildStructuralView({\n   200\t      processId,\n   201\t      viewKind: 'chunk_candidate',\n   202\t      rangeTurns: group,\n   203\t      updatedAt: new Date(now - turnRangeViews.length - index).toISOString(),\n   204\t    }),\n   205\t  );\n   206\t\n   207\t  return [...turnRangeViews, ...chunkCandidateViews];\n   208\t}\n   209\t\n   210\tfunction limitDerivedArchiveViews(views: DerivedArchiveView[]): DerivedArchiveView[] {\n   211\t  return views.slice(0, MAX_DERIVED_ARCHIVE_VIEWS);\n   212\t}\n   213\t\n   214\tfunction groupTurnsForChunkCandidates(turns: DerivedTurn[]): DerivedTurn[][] {\n   215\t  const groups: DerivedTurn[][] = [];\n   216\t\n   217\t  for (let index = 0; index < turns.length; index += CHUNK_CANDIDATE_GROUP_SIZE) {\n   218\t    groups.push(turns.slice(index, index + CHUNK_CANDIDATE_GROUP_SIZE));\n   219\t  }\n   220\t\n   221\t  return groups;\n   222\t}\n   223\t\n   224\tfunction buildStructuralView(args: {\n   225\t  processId: string;\n   226\t  viewKind: DerivedArchiveView['viewKind'];\n   227\t  rangeTurns: DerivedTurn[];\n   228\t  updatedAt: string;\n   229\t}): DerivedArchiveView {\n   230\t  const firstTurn = args.rangeTurns[0];\n   231\t  const lastTurn = args.rangeTurns[args.rangeTurns.length - 1];\n   232\t\n   233\t  if (firstTurn === undefined || lastTurn === undefined) {\n   234\t    throw new AppError({\n   235\t      code: invalidArchiveRequestErrorCode,\n   236\t      message: 'Derived archive views require at least one source turn.',\n   237\t      statusCode: 422,\n   238\t    });\n   239\t  }\n   240\t\n   241\t  const turnRange = {\n   242\t    startIndex: firstTurn.turnIndex,\n   243\t    endIndex: lastTurn.turnIndex,\n   244\t  };\n   245\t  const label =\n   246\t    args.viewKind === 'turn_range'\n   247\t      ? formatTurnRangeLabel(turnRange.startIndex, turnRange.endIndex)\n   248\t      : formatChunkCandidateLabel(turnRange.startIndex, turnRange.endIndex);\n   249\t  const degradationReasons = dedupeStrings(\n   250\t    args.rangeTurns\n   251\t      .filter((turn) => turn.turnStatus === 'degraded')\n   252\t      .map(\n   253\t        (turn) =>\n   254\t          turn.degradationReason ?? `Turn ${turn.turnIndex} degraded during derived-view refresh.`,\n   255\t      ),\n   256\t  );\n   257\t  const hasGap = !args.rangeTurns.every((turn, index) =>\n   258\t    index === 0 ? true : turn.turnIndex === firstTurn.turnIndex + index,\n   259\t  );\n   260\t\n   261\t  if (hasGap) {\n   262\t    degradationReasons.push(\n   263\t      `Turn indexes ${turnRange.startIndex}-${turnRange.endIndex} were not contiguous during derived-view refresh.`,\n   264\t    );\n   265\t  }\n   266\t\n   267\t  return {\n   268\t    derivedViewId: `${args.processId}:derived-view:${args.viewKind}:${turnRange.startIndex}-${turnRange.endIndex}`,\n   269\t    processId: args.processId,\n   270\t    viewKind: args.viewKind,\n   271\t    turnRange,\n   272\t    sourceTurnIds: args.rangeTurns.map((turn) => turn.turnId),\n   273\t    sourceArchiveEntryIds: dedupeStrings(args.rangeTurns.flatMap((turn) => turn.archiveEntryIds)),\n   274\t    title: label,\n   275\t    bodyText: label,\n   276\t    viewStatus: degradationReasons.length > 0 ? 'degraded' : 'ready',\n   277\t    degradationReason: degradationReasons.length > 0 ? degradationReasons.join(' ') : null,\n   278\t    updatedAt: args.updatedAt,\n   279\t  };\n   280\t}\n   281\t\n   282\tfunction formatTurnRangeLabel(startIndex: number, endIndex: number): string {\n   283\t  return startIndex === endIndex ? `Turn ${startIndex}` : `Turns ${startIndex}-${endIndex}`;\n   284\t}\n   285\t\n   286\tfunction formatChunkCandidateLabel(startIndex: number, endIndex: number): string {\n   287\t  return startIndex === endIndex\n   288\t    ? `Chunk candidate turn ${startIndex}`\n   289\t    : `Chunk candidate turns ${startIndex}-${endIndex}`;\n   290\t}\n   291\t\n   292\tfunction dedupeStrings(values: string[]): string[] {\n   293\t  return [...new Set(values)];\n   294\t}\n   295\t\n   296\tfunction normalizeArchiveCursor(cursor: string): string {\n   297\t  if (!/^\\d+$/.test(cursor)) {\n   298\t    throw new AppError({\n   299\t      code: invalidArchiveRequestErrorCode,\n   300\t      message: 'Archive pagination parameters were invalid.',\n   301\t      statusCode: 422,\n   302\t    });\n   303\t  }\n   304\t\n   305\t  return cursor;\n   306\t}\n","exit_code":0,"status":"completed"}}
