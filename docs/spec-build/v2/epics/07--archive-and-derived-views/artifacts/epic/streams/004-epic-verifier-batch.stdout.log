sourceAttachment.targetRef,\n   217\t      eventId: args.eventId,\n   218\t      entryStatus: 'ready',\n   219\t      degradationReason: null,\n   220\t    });\n   221\t  }\n   222\t\n   223\t  private buildSourceProvenanceEntry(\n   224\t    record: StoredSourceProvenanceRecord,\n   225\t    args: {\n   226\t      currentAttachment: SourceAttachmentSummary | null;\n   227\t      exactAttachment: SourceAttachmentSummary | null;\n   228\t    },\n   229\t  ): SourceProvenanceEntry {\n   230\t    const sourceAttachment = args.currentAttachment;\n   231\t    if (\n   232\t      record.entryStatus === 'ready' &&\n   233\t      record.degradationReason === null &&\n   234\t      sourceAttachment !== null &&\n   235\t      (args.exactAttachment === null || args.exactAttachment.detachedAt == null) &&\n   236\t      sourceAttachment.detachedAt == null &&\n   237\t      !isRedactedCurrentAttachment(sourceAttachment) &&\n   238\t      sourceAttachment.hydrationState !== 'unavailable'\n   239\t    ) {\n   240\t      return {\n   241\t        provenanceId: record.provenanceId,\n   242\t        sourceAttachmentId: record.sourceAttachmentId,\n   243\t        relationshipKind: record.relationshipKind,\n   244\t        repositoryFullName: record.repositoryFullName,\n   245\t        repositoryUrl: record.repositoryUrl,\n   246\t        targetRef: record.targetRef,\n   247\t        currentAttachmentDisplayName: sourceAttachment.displayName,\n   248\t        currentAttachmentScope: sourceAttachment.attachmentScope,\n   249\t        currentAttachmentAccessMode: sourceAttachment.accessMode,\n   250\t        currentAttachmentHydrationState: sourceAttachment.hydrationState,\n   251\t        currentAttachmentVisibility: 'available',\n   252\t        entryStatus: record.entryStatus,\n   253\t        degradationReason: record.degradationReason,\n   254\t        recordedAt: record.recordedAt,\n   255\t      };\n   256\t    }\n   257\t\n   258\t    const currentAttachmentVisibility =\n   259\t 