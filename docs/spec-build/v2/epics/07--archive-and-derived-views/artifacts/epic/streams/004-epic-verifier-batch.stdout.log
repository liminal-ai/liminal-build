;\n   101\t\n   102\texport const replaceDerivedArchiveViews = internalMutation({\n   103\t  args: replaceDerivedArchiveViewsArgsValidator,\n   104\t  handler: async (ctx: MutationCtx, args): Promise<null> => {\n   105\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n   106\t    const existingViews = await ctx.db\n   107\t      .query('derivedArchiveViews')\n   108\t      .withIndex('by_processId_and_updatedAt', (indexQuery) =>\n   109\t        indexQuery.eq('processId', processRecord._id),\n   110\t      )\n   111\t      .collect();\n   112\t    const nextViewIds = new Set<string>();\n   113\t\n   114\t    for (const view of args.views) {\n   115\t      assertDerivedArchiveView(view, args.processId);\n   116\t      nextViewIds.add(view.derivedViewId);\n   117\t    }\n   118\t\n   119\t    for (const existingView of existingViews) {\n   120\t      if (!nextViewIds.has(existingView.derivedViewId)) {\n   121\t        await ctx.db.delete(existingView._id);\n   122\t      }\n   123\t    }\n   124\t\n   125\t    for (const view of args.views) {\n   126\t      const storedView = {\n   127\t        projectId: args.projectId,\n   128\t        processId: processRecord._id,\n   129\t        derivedViewId: view.derivedViewId,\n   130\t        viewKind: view.viewKind,\n   131\t        startTurnIndex: view.turnRange?.startIndex ?? null,\n   132\t        endTurnIndex: view.turnRange?.endIndex ?? null,\n   133\t        sourceTurnIds: [...view.sourceTurnIds],\n   134\t        sourceArchiveEntryIds: view.sourceArchiveEntryIds.map(\n   135\t          (archiveEntryId) => archiveEntryId as Id<'archiveEntries'>,\n   136\t        ),\n   137\t        title: view.title,\n   138\t        bodyText: view.bodyText,\n   139\t        viewStatus: view.viewStatus,\n   140\t        degradationReason: view.degradationReason,\n   141\t        updatedAt: view.updatedAt,\n   142\t      };\n   143\t      const existing = existingViews.find(\n   144\t        (existingView) => existingView.derivedViewId === view.derivedViewId,\n   145\t      );\n   146\t\n   147\t      if (existing === undefined) {\n   148\t        await ctx.db.insert('derivedArchiveViews', storedView);\n   149\t        continue;\n   150\t      }\n   151\t\n   152\t      await ctx.db.patch(existing._id, storedView);\n   153\t    }\n   154\t\n   155\t    return null;\n   156\t  },\n   157\t});\n   158\t\n   159\texport const listDerivedArchiveViewsForService = query({\n   160\t  args: {\n   161\t    apiKey: v.string(),\n   162\t    ...listDerivedArchiveViewsArgsValidator,\n   163\t  },\n   164\t  handler: async (ctx, args): Promise<DerivedArchiveView[]> => {\n   165\t    assertValidApiKey(args.apiKey);\n   166\t\n   167\t    const result: DerivedArchiveView[] = await ctx.runQuery(listDerivedArchiveViewsInternalRef, {\n   168\t      processId: args.processId,\n   169\t    });\n   170\t\n   171\t    return result;\n   172\t  },\n   173\t});\n   174\t\n   175\texport const listDerivedArchiveViews = internalQuery({\n   176\t  args: listDerivedArchiveViewsArgsValidator,\n   177\t  handler: async (ctx: QueryCtx, args): Promise<DerivedArchiveView[]> => {\n   178\t    const processId = args.processId as Id<'processes'>;\n   179\t    const storedViews = await ctx.db\n   180\t      .query('derivedArchiveViews')\n   181\t      .withIndex('by_processId_and_updatedAt', (indexQuery) =>\n   182\t        indexQuery.eq('processId', processId),\n   183\t      )\n   184\t      .order('desc')\n   185\t      .collect();\n   186\t\n   187\t    return storedViews.map((storedView) => buildDerivedArchiveView(storedView));\n   188\t  },\n   189\t});\n   190\t\n   191\tasync function getProcessRecordOrThrow(\n   192\t  ctx: MutationCtx,\n   193\t  processIdValue: string,\n   194\t  projectId: string,\n   195\t): Promise<Doc<'processes'>> {\n   196\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n   197\t\n   198\t  if (processRecord === null) {\n   199\t    throw new Error('Process not found.');\n   200\t  }\n   201\t\n   202\t  if (processRecord.projectId !== projectId) {\n   203\t    throw new Error('Process does not belong to the requested project.');\n   204\t  }\n   205\t\n   206\t  return processRecord;\n   207\t}\n   208\t\n   209\tfunction buildDerivedArchiveView(record: Doc<'derivedArchiveViews'>): DerivedArchiveView {\n   210\t  return {\n   211\t    derivedViewId: record.derivedViewId,\n   212\t    processId: record.processId,\n   213\t    viewKind: record.viewKind,\n   214\t    turnRange:\n   215\t      record.startTurnIndex === null || record.endTurnIndex === null\n   216\t        ? null\n   217\t        : {\n   218\t            startIndex: record.startTurnIndex,\n   219\t            endIndex: record.endTurnIndex,\n   220\t          },\n   221\t    sourceTurnIds: [...record.sourceTurnIds],\n   222\t    sourceArchiveEntryIds: [...record.sourceArchiveEntryIds],\n   223\t    title: record.title,\n   224\t    bodyText: record.bodyText,\n   225\t    viewStatus: record.viewStatus,\n   226\t    degradationReason: record.degradationReason,\n   227\t    updatedAt: record.updatedAt,\n   228\t  };\n   229\t}\n   230\t\n   231\tfunction assertDerivedArchiveView(view: DerivedArchiveView, processId: string): void {\n   232\t  if (view.derivedViewId.trim().length === 0) {\n   233\t    throw new Error('Derived archive views require a non-empty derivedViewId.');\n   234\t  }\n   235\t\n   236\t  if (view.processId !== processId) {\n   237\t    throw new Error('Derived archive view processId must match the enclosing process.');\n   238\t  }\n   239\t\n   240\t  if (view.viewKind === 'turn_range' && view.turnRange === null) {\n   241\t    throw new Error('Turn-range views require turnRange metadata.');\n   242\t  }\n   243\t\n   244\t  if (view.turnRange !== null && view.turnRange.endIndex < view.turnRange.startIndex) {\n   245\t    throw new Error('Derived archive view turn ranges must end at or after their start index.');\n   246\t  }\n   247\t\n   248\t  if (\n   249\t    view.sourceTurnIds.length === 0 ||\n   250\t    view.sourceTurnIds.some((turnId) => turnId.trim().length === 0)\n   251\t  ) {\n   252\t    throw new Error('Derived archive views require at least one non-empty source turn id.');\n   253\t  }\n   254\t\n   255\t  if (\n   256\t    view.sourceArchiveEntryIds.length === 0 ||\n   257\t    view.sourceArchiveEntryIds.some((archiveEntryId) => archiveEntryId.trim().length === 0)\n   258\t  ) {\n   259\t    throw new Error(\n   260\t      'Derived archive views require at least one non-empty source archive entry id.',\n   261\t    );\n   262\t  }\n   263\t\n   264\t  assertOptionalNonEmptyString(view.title, 'Derived archive view title');\n   265\t  assertOptionalNonEmptyString(view.bodyText, 'Derived archive view body text');\n   266\t\n   267\t  if (\n   268\t    view.viewStatus === 'degraded' &&\n   269\t    (view.degradationReason === null || view.degradationReason.trim().length === 0)\n   270\t  ) {\n   271\t    throw new Error('Degraded derived archive views must include a degradation reason.');\n   272\t  }\n   273\t}\n   274\t\n   275\tfunction assertOptionalNonEmptyString(value: string | null, label: string): void {\n   276\t  if (value !== null && value.trim().length === 0) {\n   277\t    throw new Error(`${label} must be a non-empty string when provided.`);\n   278\t  }\n   279\t}\n","exit_code":0,"status":"completed"}}
