78\tconst listDerivedArchiveViewsHandler = getHandler<\n179\t  {\n180\t    processId: string;\n181\t    cursor?: string | null;\n182\t    limit: number;\n183\t  },\n184\t  {\n185\t    views: Array<{\n186\t      derivedViewId: string;\n187\t      processId: string;\n188\t      viewKind: 'turn_range' | 'chunk_candidate';\n189\t      turnRange: { startIndex: number; endIndex: number } | null;\n190\t      sourceTurnIds: string[];\n191\t      sourceArchiveEntryIds: string[];\n192\t      title: string | null;\n193\t      bodyText: string | null;\n194\t      viewStatus: 'ready' | 'degraded';\n195\t      degradationReason: string | null;\n196\t      updatedAt: string;\n197\t    }>;\n198\t    page: {\n199\t      cursor: string | null;\n200\t      nextCursor: string | null;\n201\t      hasMore: boolean;\n202\t    };\n203\t  }\n204\t>(listDerivedArchiveViews);\n205\t\n206\tconst replaceDerivedArchiveViewsForServiceHandler = getHandler<\n207\t  {\n208\t    apiKey: string;\n209\t    projectId: string;\n210\t    processId: string;\n211\t    views: Array<{\n212\t      derivedViewId: string;\n213\t      processId: string;\n214\t      viewKind: 'turn_range' | 'chunk_candidate';\n215\t      turnRange: { startIndex: number; endIndex: number } | null;\n216\t      sourceTurnIds: string[];\n217\t      sourceArchiveEntryIds: string[];\n218\t      title: string | null;\n219\t      bodyText: string | null;\n220\t      viewStatus: 'ready' | 'degraded';\n221\t      degradationReason: string | null;\n222\t      updatedAt: string;\n223\t    }>;\n224\t  },\n225\t  null\n226\t>(replaceDerivedArchiveViewsForService);\n227\t\n228\tconst listDerivedArchiveViewsForServiceHandler = getHandler<\n229\t  {\n230\t    apiKey: string;\n231\t    processId: string;\n232\t    cursor?: string | null;\n233\t    limit: number;\n234\t  },\n235\t  {\n236\t    views: Array<{\n237\t      derivedViewId: string;\n238\t      processId: string;\n239\t      viewKind: 'turn_range' | 'chunk_candidate';\n240\t      turnRange: { startIndex: number; endIndex: number } | null;\n241\t      sourceTurnIds: string[];\n242\t      sourceArchiveEntryIds: string[];\n243\t      title: string | null;\n244\t      bodyText: string | null;\n245\t      viewStatus: 'ready' | 'degraded';\n246\t      degradationReason: string | null;\n247\t      updatedAt: string;\n248\t    }>;\n249\t    page: {\n250\t      cursor: string | null;\n251\t      nextCursor: string | null;\n252\t      hasMore: boolean;\n253\t    };\n254\t  }\n255\t>(listDerivedArchiveViewsForService);\n256\t\n257\tfunction buildArchiveSeed() {\n258\t  return {\n259\t    projects: [\n260\t      {\n261\t        _id: 'project-archive-1',\n262\t        _creationTime: 1,\n263\t        name: 'Archive Project',\n264\t        ownerUserId: 'user-1',\n265\t        processCount: 2,\n266\t        artifactCount: 1,\n267\t        sourceAttachmentCount: 0,\n268\t        lastUpdatedAt: '2026-05-01T10:00:00.000Z',\n269\t        createdAt: '2026-05-01T10:00:00.000Z',\n270\t        updatedAt: '2026-05-01T10:00:00.000Z',\n271\t      },\n272\t    ],\n273\t    processes: [\n274\t      {\n275\t        _id: 'process-archive-1',\n276\t        _creationTime: 2,\n277\t        projectId: 'project-archive-1',\n278\t        processType: 'FeatureImplementation',\n279\t        displayLabel: 'Archive Process One',\n280\t        status: 'running',\n281\t        phaseLabel: 'Working',\n282\t        nextActionLabel: 'Inspect the archive',\n283\t        currentRequestHistoryItemId: null,\n284\t        hasEnvironment: true,\n285\t        createdAt: '2026-05-01T10:00:00.000Z',\n286\t        updatedAt: '2026-05-01T10:00:00.000Z',\n287\t      },\n288\t      {\n289\t        _id: 'process-archive-2',\n290\t        _creationTime: 3,\n291\t        projectId: 'project-archive-1',\n292\t        processType: 'FeatureImplementation',\n293\t        displayLabel: 'Archive Process Two',\n294\t        status: 'running',\n295\t        phaseLabel: 'Working',\n296\t        nextActionLabel: 'Inspect the archive',\n297\t        currentRequestHistoryItemId: null,\n298\t        hasEnvironment: true,\n299\t        createdAt: '2026-05-01T10:00:00.000Z',\n300\t        updatedAt: '2026-05-01T10:00:00.000Z',\n301\t      },\n302\t    ],\n303\t    artifactVersions: [\n304\t      {\n305\t        _id: 'artifact-version-1',\n306\t        _creationTime: 4,\n307\t        artifactId: 'artifact-1',\n308\t        versionLabel: 'v1',\n309\t        contentStorageId: 'storage-1',\n310\t        contentKind: 'markdown',\n311\t        bytes: 128,\n312\t        createdAt: '2026-05-01T10:00:00.000Z',\n313\t        createdByProcessId: 'process-archive-1',\n314\t      },\n315\t    ],\n316\t  };\n317\t}\n318\t\n319\tfunction buildAppendArgs(\n320\t  overrides: Partial<Parameters<typeof appendArchiveEntryHandler>[1]> = {},\n321\t): Parameters<typeof appendArchiveEntryHandler>[1] {\n322\t  const entryKind = overrides.entryKind ?? 'user_message';\n323\t  const isStructured = entryKind === 'tool_call' || entryKind === 'tool_result';\n324\t  const isBodyless = entryKind === 'process_event';\n325\t\n326\t  return {\n327\t    projectId: overrides.projectId ?? 'project-archive-1',\n328\t    processId: overrides.processId ?? 'process-archive-1',\n329\t    entryKind,\n330\t    finalizationKey:\n331\t      overrides.finalizationKey ?? `${entryKind}:${Math.random().toString(36).slice(2, 8)}`,\n332\t    sourceObjectId: overrides.sourceObjectId ?? `${entryKind}-source`,\n333\t    bodyText:\n334\t      overrides.bodyText ??\n335\t      (isBodyless ? null : isStructured ? null : `Finalized ${entryKind} body.`),\n336\t    bodyData: overrides.bodyData ?? (isStructured ? { jsonText: `{\"kind\":\"${entryKind}\"}` } : null),\n337\t    bodyFormat:\n338\t      overrides.bodyFormat ?? (isBodyless ? 'none' : isStructured ? 'structured' : 'plain_text'),\n339\t    relatedArtifactVersionId: overrides.relatedArtifactVersionId ?? null,\n340\t    relatedSourceProvenanceId: overrides.relatedSourceProvenanceId ?? null,\n341\t    relatedToolCallId: overrides.relatedToolCallId ?? null,\n342\t    entryStatus: overrides.entryStatus ?? 'ready',\n343\t    degradationReason: overrides.degradationReason ?? null,\n344\t    recordedAt: overrides.recordedAt ?? '2026-05-01T10:05:00.000Z',\n345\t  };\n346\t}\n347\t\n348\tfunction buildArchiveCtx(seed: Parameters<typeof createFakeConvexContext>[0]) {\n349\t  const fixture = createFakeConvexContext(seed);\n350\t  fixture.registry.register(\n351\t    'derivedArchiveViews:replaceDerivedArchiveViews',\n352\t    replaceDerivedArchiveViewsHandler as unknown as (\n353\t      ctx: unknown,\n354\t      args: unknown,\n355\t    ) => Promise<unknown>,\n356\t  );\n357\t  fixture.registry.register(\n358\t    'derivedArchiveViews:listDerivedArchiveViews',\n359\t    listDerivedArchiveViewsHandler as unknown as (ctx: unknown, args: unknown) => Promise<unknown>,\n360\t  );\n361\t\n362\t  return fixture;\n363\t}\n364\t\n365\tdescribe('convex/archiveEntries', () => {\n366\t  const originalApiKey = readRuntimeApiKey();\n367\t\n368\t  beforeEach(() => {\n369\t    writeRuntimeApiKey('test-convex-api-key');\n370\t  });\n371\t\n372\t  afterEach(() => {\n373\t    writeRuntimeApiKey(originalApiKey);\n374\t  });\n375\t\n376\t  it('TC-1.2a accepts required archive entry kinds', async () => {\n377\t    const { ctx } = createFakeConvexContext({\n378\t      ...buildArchiveSeed(),\n379\t      archiveEntries: [],\n380\t    });\n381\t    const requiredKinds = [\n382\t      'user_message',\n383\t      'model_message',\n384\t      'reasoning',\n385\t      'script_emission',\n386\t      'tool_call',\n387\t      'tool_result',\n388\t      'process_event',\n389\t    ] as const;\n390\t\n391\t    for (const [index, entryKind] of requiredKinds.entries()) {\n392\t      const entry = await appendArchiveEntryHandler(\n393\t        ctx,\n394\t        buildAppendArgs({\n395\t          entryKind,\n396\t          finalizationKey: `${entryKind}:${index}`,\n397\t          recordedAt: `2026-05-01T10:05:0${index}.000Z`,\n398\t        }),\n399\t      );\n400\t\n401\t      expect(entry).toMatchObject({\n402\t        entryKind,\n403\t        sequence: index,\n404\t        lifecycleState: 'finalized',\n405\t      });\n406\t    }\n407\t\n408\t    const page = await listArchiveEntriesHandler(ctx, {\n409\t      processId: 'process-archive-1',\n410\t      limit: 20,\n411\t    });\n412\t\n413\t    expect(page.entries.map((entry) => entry.entryKind)).toEqual(requiredKinds);\n414\t  });\n415\t\n416\t  it('TC-1.2b rejects unsupported archive entry kind', async () => {\n417\t    const { ctx } = createFakeConvexContext({\n418\t      ...buildArchiveSeed(),\n419\t      archiveEntries: [],\n420\t    });\n421\t\n422\t    await expect(\n423\t      appendArchiveEntryHandler(\n424\t        ctx,\n425\t        buildAppendArgs({\n426\t          entryKind: 'unsupported_kind' as never,\n427\t          finalizationKey: 'unsupported:1',\n428\t        }),\n429\t      ),\n430\t    ).rejects.toThrow('Unsupported archive entry kind: unsupported_kind');\n431\t\n432\t    await expect(\n433\t      listArchiveEntriesHandler(ctx, {\n434\t        processId: 'process-archive-1',\n435\t        limit: 20,\n436\t      }),\n437\t    ).resolves.toMatchObject({\n438\t      entries: [],\n439\t    });\n440\t  });\n441\t\n442\t  it('TC-1.3a reads entries in stable sequence order', async () => {\n443\t    const { ctx } = createFakeConvexContext({\n444\t      ...buildArchiveSeed(),\n445\t      archiveEntries: [],\n446\t    });\n447\t\n448\t    await appendArchiveEntryHandler(\n449\t      ctx,\n450\t      buildAppendArgs({\n451\t        entryKind: 'model_message',\n452\t        finalizationKey: 'model:late-timestamp',\n453\t        recordedAt: '2026-05-01T10:06:00.000Z',\n454\t      }),\n455\t    );\n456\t    await appendArchiveEntryHandler(\n457\t      ctx,\n458\t      buildAppendArgs({\n459\t        entryKind: 'user_message',\n460\t        finalizationKey: 'user:early-timestamp',\n461\t        recordedAt: 