{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qu8XpMHYB3XA5RZKAukDv7","type":"tool_result","content":"1\timport type { ArchivePage } from '../../../shared/contracts/index.js';\n2\timport { archivePageSchema } from '../../../shared/contracts/index.js';\n3\timport { AppError } from '../../errors/app-error.js';\n4\timport { invalidArchiveRequestErrorCode } from '../../errors/codes.js';\n5\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n6\timport type { ProcessAccessService } from '../processes/process-access.service.js';\n7\timport type { PlatformStore } from '../projects/platform-store.js';\n8\timport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\n9\timport { enrichArchiveEntries } from './archive-entry-enrichment.js';\n10\t\n11\tconst DEFAULT_ARCHIVE_PAGE_LIMIT = 100;\n12\tconst MAX_ARCHIVE_PAGE_LIMIT = 200;\n13\t\n14\texport interface ArchiveReadService {\n15\t  getArchive(args: {\n16\t    actor: AuthenticatedActor;\n17\t    projectId: string;\n18\t    processId: string;\n19\t    cursor?: string | null;\n20\t    limit?: number;\n21\t  }): Promise<ArchivePage>;\n22\t}\n23\t\n24\texport class DefaultArchiveReadService implements ArchiveReadService {\n25\t  constructor(\n26\t    private readonly platformStore: Pick<\n27\t      PlatformStore,\n28\t      'getArtifactVersion' | 'listArchiveEntries'\n29\t    > & {\n30\t      listProcessesByIds?: PlatformStore['listProcessesByIds'];\n31\t    },\n32\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n33\t    private readonly sourceProvenanceService?: Pick<\n34\t      SourceProvenanceService,\n35\t      'listProcessSourceProvenance'\n36\t    >,\n37\t  ) {}\n38\t\n39\t  async getArchive(args: {\n40\t    actor: AuthenticatedActor;\n41\t    projectId: string;\n42\t    processId: string;\n43\t    cursor?: string | null;\n44\t    limit?: number;\n45\t  }): Promise<ArchivePage> {\n46\t    await this.processAccessService.assertProcessAccess({\n47\t      actor: args.actor,\n48\t      projectId: args.projectId,\n49\t      processId: args.processId,\n50\t    });\n51\t\n52\t    const cursor = normalizeArchiveCursor(args.cursor);\n53\t    const limit = normalizeArchiveLimit(args.limit);\n54\t    const page = await this.platformStore.listArchiveEntries({\n55\t      processId: args.processId,\n56\t      cursor,\n57\t      limit,\n58\t    });\n59\t    const entries = await enrichArchiveEntries({\n60\t      entries: page.entries,\n61\t      projectId: args.projectId,\n62\t      platformStore: this.platformStore,\n63\t      processId: args.processId,\n64\t      sourceProvenanceService: this.sourceProvenanceService,\n65\t    });\n66\t\n67\t    return archivePageSchema.parse({\n68\t      ...page,\n69\t      entries,\n70\t    });\n71\t  }\n72\t}\n73\t\n74\tfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n75\t  if (cursor === undefined || cursor === null) {\n76\t    return null;\n77\t  }\n78\t\n79\t  if (!/^\\d+$/.test(cursor)) {\n80\t    throw new AppError({\n81\t      code: invalidArchiveRequestErrorCode,\n82\t      message: 'Archive pagination parameters were invalid.',\n83\t      statusCode: 422,\n84\t    });\n85\t  }\n86\t\n87\t  return cursor;\n88\t}\n89\t\n90\tfunction normalizeArchiveLimit(limit: number | undefined): number {\n91\t  if (limit === undefined) {\n92\t    return DEFAULT_ARCHIVE_PAGE_LIMIT;\n93\t  }\n94\t\n95\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_ARCHIVE_PAGE_LIMIT) {\n96\t    throw new AppError({\n97\t      code: invalidArchiveRequestErrorCode,\n98\t      message: 'Archive pagination parameters were invalid.',\n99\t      statusCode: 422,\n100\t    });\n101\t  }\n102\t\n103\t  return limit;\n104\t}\n105\t"}]},"parent_tool_use_id":null,"session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"25b3d663-06d7-48f0-b560-75e910595c6f","timestamp":"2026-05-05T18:53:42.878Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/services/archive/archive-read.service.ts","content":"import type { ArchivePage } from '../../../shared/contracts/index.js';\nimport { archivePageSchema } from '../../../shared/contracts/index.js';\nimport { AppError } from '../../errors/app-error.js';\nimport { invalidArchiveRequestErrorCode } from '../../errors/codes.js';\nimport type { AuthenticatedActor } from '../auth/auth-session.service.js';\nimport type { ProcessAccessService } from '../processes/process-access.service.js';\nimport type { PlatformStore } from '../projects/platform-store.js';\nimport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\nimport { enrichArchiveEntries } from './archive-entry-enrichment.js';\n\nconst DEFAULT_ARCHIVE_PAGE_LIMIT = 100;\nconst MAX_ARCHIVE_PAGE_LIMIT = 200;\n\nexport interface ArchiveReadService {\n  getArchive(args: {\n    actor: AuthenticatedActor;\n    projectId: string;\n    processId: string;\n    cursor?: string | null;\n    limit?: number;\n  }): Promise<ArchivePage>;\n}\n\nexport class DefaultArchiveReadService implements ArchiveReadService {\n  constructor(\n    private readonly platformStore: Pick<\n      PlatformStore,\n      'getArtifactVersion' | 'listArchiveEntries'\n    > & {\n      listProcessesByIds?: PlatformStore['listProcessesByIds'];\n    },\n    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n    private readonly sourceProvenanceService?: Pick<\n      SourceProvenanceService,\n      'listProcessSourceProvenance'\n    >,\n  ) {}\n\n  async getArchive(args: {\n    actor: AuthenticatedActor;\n    projectId: string;\n    processId: string;\n    cursor?: string | null;\n    limit?: number;\n  }): Promise<ArchivePage> {\n    await this.processAccessService.assertProcessAccess({\n      actor: args.actor,\n      projectId: args.projectId,\n      processId: args.processId,\n    });\n\n    const cursor = normalizeArchiveCursor(args.cursor);\n    const limit = normalizeArchiveLimit(args.limit);\n    const page = await this.platformStore.listArchiveEntries({\n      processId: args.processId,\n      cursor,\n      limit,\n    });\n    const entries = await enrichArchiveEntries({\n      entries: page.entries,\n      projectId: args.projectId,\n      platformStore: this.platformStore,\n      processId: args.processId,\n      sourceProvenanceService: this.sourceProvenanceService,\n    });\n\n    return archivePageSchema.parse({\n      ...page,\n      entries,\n    });\n  }\n}\n\nfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n  if (cursor === undefined || cursor === null) {\n    return null;\n  }\n\n  if (!/^\\d+$/.test(cursor)) {\n    throw new AppError({\n      code: invalidArchiveRequestErrorCode,\n      message: 'Archive pagination parameters were invalid.',\n      statusCode: 422,\n    });\n  }\n\n  return cursor;\n}\n\nfunction normalizeArchiveLimit(limit: number | undefined): number {\n  if (limit === undefined) {\n    return DEFAULT_ARCHIVE_PAGE_LIMIT;\n  }\n\n  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_ARCHIVE_PAGE_LIMIT) {\n    throw new AppError({\n      code: invalidArchiveRequestErrorCode,\n      message: 'Archive pagination parameters were invalid.',\n      statusCode: 422,\n    });\n  }\n\n  return limit;\n}\n","numLines":105,"startLine":1,"totalLines":105}}}
