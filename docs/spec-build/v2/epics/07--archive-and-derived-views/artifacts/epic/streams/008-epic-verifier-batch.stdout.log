n needed\n   179\t\n   180\tapps/platform/server/services/projects/\n   181\t└── platform-store.ts                         # MODIFIED: archive append/read/projection methods\n   182\t\n   183\tapps/platform/server/services/processes/\n   184\t├── environment/process-environment.service.ts # MODIFIED: call finalization for execution/tool/process events\n   185\t├── process-response.service.ts               # MODIFIED: archive accepted user responses\n   186\t└── live/process-live-normalizer.ts           # UNCHANGED: live upserts remain current-object transport\n   187\t\n   188\tapps/platform/client/features/processes/\n   189\t├── archive-section.ts                        # NEW: process archive read surface\n   190\t├── archive-turns-section.ts                  # NEW: derived turn surface\n   191\t└── derived-archive-views-section.ts          # NEW: structural derived-view surface\n   192\t\n   193\tapps/platform/client/app/\n   194\t└── bootstrap.ts                              # MODIFIED: route archive actions to process/archive surfaces\n   195\t\n   196\ttests/\n   197\t├── fixtures/archive.ts                       # NEW: archive/turn/view fixtures\n   198\t├── service/server/archive-api.test.ts        # NEW: Fastify archive route tests\n   199\t├── service/server/archive-finalization.test.ts # NEW: finalization and idempotency tests\n   200\t├── service/server/turn-derivation.test.ts    # NEW: deterministic turn derivation tests\n   201\t├── service/client/archive-section.test.ts    # NEW: client archive rendering tests\n   202\t├── service/client/archive-turns-section.test.ts # NEW: turn surface rendering tests\n   203\t└── service/client/derived-archive-views.test.ts # NEW: derived-view UI tests\n   204\t```\n   205\t\n","exit_code":0,"status":"completed"}}
