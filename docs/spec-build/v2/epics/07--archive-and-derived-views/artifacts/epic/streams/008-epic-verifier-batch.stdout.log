{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DCVSeGGJLBXpwUSJAgFitL","type":"tool_result","content":"1\timport type {\n2\t  ArchiveEntry,\n3\t  ArchivePage,\n4\t  DerivedArchiveView,\n5\t  DerivedArchiveViewListResponse,\n6\t  DerivedArchiveViewRefreshResponse,\n7\t  DerivedTurn,\n8\t} from '../../../shared/contracts/index.js';\n9\timport { derivedArchiveViewRefreshResponseSchema } from '../../../shared/contracts/index.js';\n10\timport { AppError } from '../../errors/app-error.js';\n11\timport {\n12\t  archiveDerivationConflictErrorCode,\n13\t  invalidArchiveRequestErrorCode,\n14\t} from '../../errors/codes.js';\n15\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n16\timport type { ProcessAccessService } from '../processes/process-access.service.js';\n17\timport type { PlatformStore } from '../projects/platform-store.js';\n18\timport type { TurnDerivationService } from './turn-derivation.service.js';\n19\t\n20\tconst ARCHIVE_REBUILD_PAGE_LIMIT = 200;\n21\tconst CHUNK_CANDIDATE_GROUP_SIZE = 2;\n22\tconst DEFAULT_DERIVED_ARCHIVE_VIEW_LIMIT = 50;\n23\tconst MAX_DERIVED_ARCHIVE_VIEW_LIMIT = 50;\n24\t\n25\texport interface DerivedArchiveViewService {\n26\t  listViews(args: {\n27\t    actor: AuthenticatedActor;\n28\t    projectId: string;\n29\t    processId: string;\n30\t    cursor?: string | null;\n31\t    limit?: number;\n32\t  }): Promise<DerivedArchiveViewListResponse>;\n33\t  refreshViews(args: {\n34\t    actor: AuthenticatedActor;\n35\t    projectId: string;\n36\t    processId: string;\n37\t  }): Promise<DerivedArchiveViewRefreshResponse>;\n38\t}\n39\t\n40\texport class DefaultDerivedArchiveViewService implements DerivedArchiveViewService {\n41\t  constructor(\n42\t    private readonly platformStore: Pick<\n43\t      PlatformStore,\n44\t      | 'listArchiveEntries'\n45\t      | 'listArchiveTurns'\n46\t      | 'listDerivedArchiveViews'\n47\t      | 'replaceDerivedArchiveViews'\n48\t    >,\n49\t    private readonly turnDerivationService: Pick<TurnDerivationService, 'rebuildTurns'>,\n50\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n51\t  ) {}\n52\t\n53\t  async listViews(args: {\n54\t    actor: AuthenticatedActor;\n55\t    projectId: string;\n56\t    processId: string;\n57\t    cursor?: string | null;\n58\t    limit?: number;\n59\t  }): Promise<DerivedArchiveViewListResponse> {\n60\t    await this.processAccessService.assertProcessAccess({\n61\t      actor: args.actor,\n62\t      projectId: args.projectId,\n63\t      processId: args.processId,\n64\t    });\n65\t\n66\t    const cursor = normalizeArchiveCursor(args.cursor);\n67\t    const limit = normalizeDerivedArchiveViewLimit(args.limit);\n68\t    const storedViews = await this.platformStore.listDerivedArchiveViews({\n69\t      processId: args.processId,\n70\t      cursor,\n71\t      limit,\n72\t    });\n73\t\n74\t    if (cursor !== null) {\n75\t      return storedViews;\n76\t    }\n77\t\n78\t    if (storedViews.views.length > 0) {\n79\t      return storedViews;\n80\t    }\n81\t\n82\t    if (await hasStoredViews(this.platformStore, args.processId)) {\n83\t      return storedViews;\n84\t    }\n85\t\n86\t    if (await hasStoredTurns(this.platformStore, args.processId)) {\n87\t      await this.warmViewsCacheOnMiss({\n88\t        projectId: args.projectId,\n89\t        processId: args.processId,\n90\t      });\n91\t\n92\t      return this.platformStore.listDerivedArchiveViews({\n93\t        processId: args.processId,\n94\t        cursor,\n95\t        limit,\n96\t      });\n97\t    }\n98\t\n99\t    if (!(await hasArchiveEntries(this.platformStore, args.processId))) {\n100\t      return storedViews;\n101\t    }\n102\t\n103\t    await this.warmViewsCacheOnMiss({\n104\t      projectId: args.projectId,\n105\t      processId: args.processId,\n106\t    });\n107\t\n108\t    return this.platformStore.listDerivedArchiveViews({\n109\t      processId: args.processId,\n110\t      cursor,\n111\t      limit,\n112\t    });\n113\t  }\n114\t\n115\t  async refreshViews(args: {\n116\t    actor: AuthenticatedActor;\n117\t    projectId: string;\n118\t    processId: string;\n119\t  }): Promise<DerivedArchiveViewRefreshResponse> {\n120\t    await this.processAccessService.assertProcessAccess({\n121\t      actor: args.actor,\n122\t      projectId: args.projectId,\n123\t      processId: args.processId,\n124\t    });\n125\t\n126\t    const archiveSignatureBeforeRefresh = await computeArchiveSignature(\n127\t      this.platformStore,\n128\t      args.processId,\n129\t    );\n130\t    const turns = await this.turnDerivationService.rebuildTurns({\n131\t      projectId: args.projectId,\n132\t      processId: args.processId,\n133\t    });\n134\t    const archiveSignatureAfterTurnRebuild = await computeArchiveSignature(\n135\t      this.platformStore,\n136\t      args.processId,\n137\t    );\n138\t\n139\t    if (archiveSignatureAfterTurnRebuild !== archiveSignatureBeforeRefresh) {\n140\t      throw new AppError({\n141\t        code: archiveDerivationConflictErrorCode,\n142\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n143\t        statusCode: 409,\n144\t      });\n145\t    }\n146\t\n147\t    const views = buildDerivedArchiveViews(turns, args.processId);\n148\t    await this.platformStore.replaceDerivedArchiveViews({\n149\t      projectId: args.projectId,\n150\t      processId: args.processId,\n151\t      views,\n152\t    });\n153\t\n154\t    const archiveSignatureAfterRefresh = await computeArchiveSignature(\n155\t      this.platformStore,\n156\t      args.processId,\n157\t    );\n158\t\n159\t    if (archiveSignatureAfterRefresh !== archiveSignatureBeforeRefresh) {\n160\t      throw new AppError({\n161\t        code: archiveDerivationConflictErrorCode,\n162\t        message: 'Derived views could not be refreshed safely from the current archive state.',\n163\t        statusCode: 409,\n164\t      });\n165\t    }\n166\t\n167\t    return derivedArchiveViewRefreshResponseSchema.parse({\n168\t      views,\n169\t      refreshStatus: views.some((view) => view.viewStatus === 'degraded') ? 'degraded' : 'settled',\n170\t    });\n171\t  }\n172\t\n173\t  private async warmViewsCacheOnMiss(args: {\n174\t    projectId: string;\n175\t    processId: string;\n176\t  }): Promise<void> {\n177\t    const turns =\n178\t      (await listAllStoredTurns(this.platformStore, args.processId)) ??\n179\t      (await this.turnDerivationService.rebuildTurns({\n180\t        projectId: args.projectId,\n181\t        processId: args.processId,\n182\t      }));\n183\t    const views = buildDerivedArchiveViews(turns, args.processId);\n184\t\n185\t    await this.platformStore.replaceDerivedArchiveViews({\n186\t      projectId: args.projectId,\n187\t      processId: args.processId,\n188\t      views,\n189\t    });\n190\t  }\n191\t}\n192\t\n193\tasync function hasStoredViews(\n194\t  platformStore: Pick<PlatformStore, 'listDerivedArchiveViews'>,\n195\t  processId: string,\n196\t): Promise<boolean> {\n197\t  const firstPage = await platformStore.listDerivedArchiveViews({\n198\t    processId,\n199\t    cursor: null,\n200\t    limit: 1,\n201\t  });\n202\t\n203\t  return firstPage.views.length > 0;\n204\t}\n205\t\n206\tasync function listAllStoredTurns(\n207\t  platformStore: Pick<PlatformStore, 'listArchiveTurns'>,\n208\t  processId: string,\n209\t): Promise<DerivedTurn[] | null> {\n210\t  const firstPage = await platformStore.listArchiveTurns({\n211\t    processId,\n212\t    cursor: null,\n213\t    limit: 1,\n214\t  });\n215\t\n216\t  if (firstPage.turns.length === 0) {\n217\t    return null;\n218\t  }\n219\t\n220\t  const turns: DerivedTurn[] = [...firstPage.turns];\n221\t  let cursor = firstPage.page.nextCursor;\n222\t\n223\t  while (cursor !== null) {\n224\t    const page = await platformStore.listArchiveTurns({\n225\t      processId,\n226\t      cursor,\n227\t      limit: DEFAULT_DERIVED_ARCHIVE_VIEW_LIMIT,\n228\t    });\n229\t    turns.push(...page.turns);\n230\t    cursor = page.page.nextCursor;\n231\t  }\n232\t\n233\t  return turns;\n234\t}\n235\t\n236\tasync function hasStoredTurns(\n237\t  platformStore: Pick<PlatformStore, 'listArchiveTurns'>,\n238\t  processId: string,\n239\t): Promise<boolean> {\n240\t  const firstPage = await platformStore.listArchiveTurns({\n241\t    processId,\n242\t    cursor: null,\n243\t    limit: 1,\n244\t  });\n245\t\n246\t  return firstPage.turns.length > 0;\n247\t}\n248\t\n249\tasync function hasArchiveEntries(\n250\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n251\t  processId: string,\n252\t): Promise<boolean> {\n253\t  const firstPage = await platformStore.listArchiveEntries({\n254\t    processId,\n255\t    cursor: null,\n256\t    limit: 1,\n257\t  });\n258\t\n259\t  return firstPage.entries.length > 0;\n260\t}\n261\t\n262\tasync function computeArchiveSignature(\n263\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n264\t  processId: string,\n265\t): Promise<string> {\n266\t  const entries = await listAllArchiveEntries(platformStore, processId);\n267\t\n268\t  return entries\n269\t    .map((entry) => `${entry.archiveEntryId}:${entry.sequence}:${entry.recordedAt}`)\n270\t    .join('|');\n271\t}\n272\t\n273\tasync function listAllArchiveEntries(\n274\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n275\t  processId: string,\n276\t): Promise<ArchiveEntry[]> {\n277\t  const entries: ArchiveEntry[] = [];\n278\t  let cursor: string | null = null;\n279\t\n280\t  for (;;) {\n281\t    const page: ArchivePage = await platformStore.listArchiveEntries({\n282\t      processId,\n283\t      cursor,\n284\t      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n285\t    });\n286\t    entries.push(...page.entries);\n287\t\n288\t    if (!page.page.hasMore || page.page.nextCursor === null) {\n289\t      break;\n290\t    }\n291\t\n292\t    cursor = normalizeArchiveCursor(page.page.nextCursor);\n293\t  }\n294\t\n295\t  return entries.sort((left, right) => left.sequence - right.sequence);\n296\t}\n297\t\n298\tfunction buildDerivedArchiveViews(turns: DerivedTurn[], processId: string): DerivedArchiveView[] {\n299\t  if (turns.length === 0) {\n300\t    return [];\n301\t  }\n302\t\n303\t  const now = Date.now();\n304\t  const turnRangeViews = turns.map((turn, index) =>\n305\t    buildStructuralView({\n306\t      processId,\n307\t      viewKind: 'turn_range',\n308\t      rangeTurns: [turn],\n309\t      updatedAt: new Date(now - index).toISOString(),\n310\t    }),\n311\t  );\n312\t  const chunkCandidateViews = groupTurnsForChunkCandidates(turns).map((group, index) =>\n313\t    buildStructuralView({\n314\t      processId,\n315\t      viewKind: 'chunk_candidate',\n316\t      rangeTurns: group,\n317\t      updatedAt: new Date(now - turnRangeViews.length - index).toISOString(),\n318\t    }),\n319\t  );\n320\t\n321\t  return [...turnRangeViews, ...chunkCandidateViews];\n322\t}\n323\t\n324\tfunction groupTurnsForChunkCandidates(turns: DerivedTurn[]): DerivedTurn[][] {\n325\t  const groups: DerivedTurn[][] = [];\n326\t\n327\t  for (let index = 0; index < turns.length; index += CHUNK_CANDIDATE_GROUP_SIZE) {\n328\t    groups.push(turns.slice(index, index + CHUNK_CANDIDATE_GROUP_SIZE));\n329\t  }\n330\t\n331\t  return groups;\n332\t}\n333\t\n334\tfunction buildStructuralView(args: {\n335\t  processId: string;\n336\t  viewKind: DerivedArchiveView['viewKind'];\n337\t  rangeTurns: DerivedTurn[];\n338\t  updatedAt: string;\n339\t}): DerivedArchiveView {\n340\t  const firstTurn = args.rangeTurns[0];\n341\t  const lastTurn = args.rangeTurns[args.rangeTurns.length - 1];\n342\t\n343\t  if (firstTurn === undefined || lastTurn === undefined) {\n344\t    throw new AppError({\n345\t      code: invalidArchiveRequestErrorCode,\n346\t      message: 'Derived archive views require at least one source turn.',\n347\t      statusCode: 422,\n348\t    });\n349\t  }\n350\t\n351\t  const turnRange = {\n352\t    startIndex: firstTurn.turnIndex,\n353\t    endIndex: lastTurn.turnIndex,\n354\t  };\n355\t  const label =\n356\t    args.viewKind === 'turn_range'\n357\t      ? formatTurnRangeLabel(turnRange.startIndex, turnRange.endIndex)\n358\t      : formatChunkCandidateLabel(turnRange.startIndex, turnRange.endIndex);\n359\t  const degradationReasons = dedupeStrings(\n360\t    args.rangeTurns\n361\t      .filter((turn) => turn.turnStatus === 'degraded')\n362\t      .map(\n363\t        (turn) =>\n364\t          turn.degradationReason ?? `Turn ${turn.turnIndex} degraded during derived-view refresh.`,\n365\t      ),\n366\t  );\n367\t  const hasGap = !args.rangeTurns.every((turn, index) =>\n368\t    index === 0 ? true : turn.turnIndex === firstTurn.turnIndex + index,\n369\t  );\n370\t\n371\t  if (hasGap) {\n372\t    degradationReasons.push(\n373\t      `Turn indexes ${turnRange.startIndex}-${turnRange.endIndex} were not contiguous during derived-view refresh.`,\n374\t    );\n375\t  }\n376\t\n377\t  return {\n378\t    derivedViewId: `${args.processId}:derived-view:${args.viewKind}:${turnRange.startIndex}-${turnRange.endIndex}`,\n379\t    processId: args.processId,\n380\t    viewKind: args.viewKind,\n381\t    turnRange,\n382\t    sourceTurnIds: args.rangeTurns.map((turn) => turn.turnId),\n383\t    sourceArchiveEntryIds: dedupeStrings(args.rangeTurns.flatMap((turn) => turn.archiveEntryIds)),\n384\t    title: label,\n385\t    bodyText: label,\n386\t    viewStatus: degradationReasons.length > 0 ? 'degraded' : 'ready',\n387\t    degradationReason: degradationReasons.length > 0 ? degradationReasons.join(' ') : null,\n388\t    updatedAt: args.updatedAt,\n389\t  };\n390\t}\n391\t\n392\tfunction formatTurnRangeLabel(startIndex: number, endIndex: number): string {\n393\t  return startIndex === endIndex ? `Turn ${startIndex}` : `Turns ${startIndex}-${endIndex}`;\n394\t}\n395\t\n396\tfunction formatChunkCandidateLabel(startIndex: number, endIndex: number): string {\n397\t  return startIndex === endIndex\n398\t    ? `Chunk candidate turn ${startIndex}`\n399\t    : `Chunk candidate turns ${startIndex}-${endIndex}`;\n400\t}\n401\t\n402\tfunction dedupeStrings(values: string[]): string[] {\n403\t  return [...new Set(values)];\n404\t}\n405\t\n406\tfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n407\t  if (cursor === undefined || cursor === null) {\n408\t    return null;\n409\t  }\n410\t\n411\t  if (!/^\\d+$/.test(cursor)) {\n412\t    throw new AppError({\n413\t      code: invalidArchiveRequestErrorCode,\n414\t      message: 'Archive pagination parameters were invalid.',\n415\t      statusCode: 422,\n416\t    });\n417\t  }\n418\t\n419\t  return cursor;\n420\t}\n421\t\n422\tfunction normalizeDerivedArchiveViewLimit(limit: number | undefined): number {\n423\t  if (limit === undefined) {\n424\t    return DEFAULT_DERIVED_ARCHIVE_VIEW_LIMIT;\n425\t  }\n426\t\n427\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_DERIVED_ARCHIVE_VIEW_LIMIT) {\n428\t    throw new AppError({\n429\t      code: invalidArchiveRequestErrorCode,\n430\t      message: 'Archive pagination parameters were invalid.',\n431\t      statusCode: 422,\n432\t    });\n433\t  }\n434\t\n435\t  return limit;\n436\t}\n437\t"}]},"parent_tool_use_id":null,"session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"a5251614-51a9-4f48-93d8-b64c47d241bd","timestamp":"2026-05-05T18:53:46.721Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/services/archive/derived-archive-view.service.ts","content":"import type {\n  ArchiveEntry,\n  ArchivePage,\n  DerivedArchiveView,\n  DerivedArchiveViewListResponse,\n  DerivedArchiveViewRefreshResponse,\n  DerivedTurn,\n} from '../../../shared/contracts/index.js';\nimport { derivedArchiveViewRefreshResponseSchema } from '../../../shared/contracts/index.js';\nimport { AppError } from '../../errors/app-error.js';\nimport {\n  archiveDerivationConflictErrorCode,\n  invalidArchiveRequestErrorCode,\n} from '../../errors/codes.js';\nimport type { AuthenticatedActor } from '../auth/auth-session.service.js';\nimport type { ProcessAccessService } from '../processes/process-access.service.js';\nimport type { PlatformStore } from '../projects/platform-store.js';\nimport type { TurnDerivationService } from './turn-derivation.service.js';\n\nconst ARCHIVE_REBUILD_PAGE_LIMIT = 200;\nconst CHUNK_CANDIDATE_GROUP_SIZE = 2;\nconst DEFAULT_DERIVED_ARCHIVE_VIEW_LIMIT = 50;\nconst MAX_DERIVED_ARCHIVE_VIEW_LIMIT = 50;\n\nexport interface DerivedArchiveViewService {\n  listViews(args: {\n    actor: AuthenticatedActor;\n    projectId: string;\n    processId: string;\n    cursor?: string | null;\n    limit?: number;\n  }): Promise<DerivedArchiveViewListResponse>;\n  refreshViews(args: {\n    actor: AuthenticatedActor;\n    projectId: string;\n    processId: string;\n  }): Promise<DerivedArchiveViewRefreshResponse>;\n}\n\nexport class DefaultDerivedArchiveViewService implements DerivedArchiveViewService {\n  constructor(\n    private readonly platformStore: Pick<\n      PlatformStore,\n      | 'listArchiveEntries'\n      | 'listArchiveTurns'\n      | 'listDerivedArchiveViews'\n      | 'replaceDerivedArchiveViews'\n    >,\n    private readonly turnDerivationService: Pick<TurnDerivationService, 'rebuildTurns'>,\n    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n  ) {}\n\n  async listViews(args: {\n    actor: AuthenticatedActor;\n    projectId: string;\n    processId: string;\n    cursor?: string | null;\n    limit?: number;\n  }): Promise<DerivedArchiveViewListResponse> {\n    await this.processAccessService.assertProcessAccess({\n      actor: args.actor,\n      projectId: args.projectId,\n      processId: args.processId,\n    });\n\n    const cursor = normalizeArchiveCursor(args.cursor);\n    const limit = normalizeDerivedArchiveViewLimit(args.limit);\n    const storedViews = await this.platformStore.listDerivedArchiveViews({\n      processId: args.processId,\n      cursor,\n      limit,\n    });\n\n    if (cursor !== null) {\n      return storedViews;\n    }\n\n    if (storedViews.views.length > 0) {\n      return storedViews;\n    }\n\n    if (await hasStoredViews(this.platformStore, args.processId)) {\n      return storedViews;\n    }\n\n    if (await hasStoredTurns(this.platformStore, args.processId)) {\n      await this.warmViewsCacheOnMiss({\n        projectId: args.projectId,\n        processId: args.processId,\n      });\n\n      return this.platformStore.listDerivedArchiveViews({\n        processId: args.processId,\n        cursor,\n        limit,\n      });\n    }\n\n    if (!(await hasArchiveEntries(this.platformStore, args.processId))) {\n      return storedViews;\n    }\n\n    await this.warmViewsCacheOnMiss({\n      projectId: args.projectId,\n      processId: args.processId,\n    });\n\n    return this.platformStore.listDerivedArchiveViews({\n      processId: args.processId,\n      cursor,\n      limit,\n    });\n  }\n\n  async refreshViews(args: {\n    actor: AuthenticatedActor;\n    projectId: string;\n    processId: string;\n  }): Promise<DerivedArchiveViewRefreshResponse> {\n    await this.processAccessService.assertProcessAccess({\n      actor: args.actor,\n      projectId: args.projectId,\n      processId: args.processId,\n    });\n\n    const archiveSignatureBeforeRefresh = await computeArchiveSignature(\n      this.platformStore,\n      args.processId,\n    );\n    const turns = await this.turnDerivationService.rebuildTurns({\n      projectId: args.projectId,\n      processId: args.processId,\n    });\n    const archiveSignatureAfterTurnRebuild = await computeArchiveSignature(\n      this.platformStore,\n      args.processId,\n    );\n\n    if (archiveSignatureAfterTurnRebuild !== archiveSignatureBeforeRefresh) {\n      throw new AppError({\n        code: archiveDerivationConflictErrorCode,\n        message: 'Derived views could not be refreshed safely from the current archive state.',\n        statusCode: 409,\n      });\n    }\n\n    const views = buildDerivedArchiveViews(turns, args.processId);\n    await this.platformStore.replaceDerivedArchiveViews({\n      projectId: args.projectId,\n      processId: args.processId,\n      views,\n    });\n\n    const archiveSignatureAfterRefresh = await computeArchiveSignature(\n      this.platformStore,\n      args.processId,\n    );\n\n    if (archiveSignatureAfterRefresh !== archiveSignatureBeforeRefresh) {\n      throw new AppError({\n        code: archiveDerivationConflictErrorCode,\n        message: 'Derived views could not be refreshed safely from the current archive state.',\n        statusCode: 409,\n      });\n    }\n\n    return derivedArchiveViewRefreshResponseSchema.parse({\n      views,\n      refreshStatus: views.some((view) => view.viewStatus === 'degraded') ? 'degraded' : 'settled',\n    });\n  }\n\n  private async warmViewsCacheOnMiss(args: {\n    projectId: string;\n    processId: string;\n  }): Promise<void> {\n    const turns =\n      (await listAllStoredTurns(this.platformStore, args.processId)) ??\n      (await this.turnDerivationService.rebuildTurns({\n        projectId: args.projectId,\n        processId: args.processId,\n      }));\n    const views = buildDerivedArchiveViews(turns, args.processId);\n\n    await this.platformStore.replaceDerivedArchiveViews({\n      projectId: args.projectId,\n      processId: args.processId,\n      views,\n    });\n  }\n}\n\nasync function hasStoredViews(\n  platformStore: Pick<PlatformStore, 'listDerivedArchiveViews'>,\n  processId: string,\n): Promise<boolean> {\n  const firstPage = await platformStore.listDerivedArchiveViews({\n    processId,\n    cursor: null,\n    limit: 1,\n  });\n\n  return firstPage.views.length > 0;\n}\n\nasync function listAllStoredTurns(\n  platformStore: Pick<PlatformStore, 'listArchiveTurns'>,\n  processId: string,\n): Promise<DerivedTurn[] | null> {\n  const firstPage = await platformStore.listArchiveTurns({\n    processId,\n    cursor: null,\n    limit: 1,\n  });\n\n  if (firstPage.turns.length === 0) {\n    return null;\n  }\n\n  const turns: DerivedTurn[] = [...firstPage.turns];\n  let cursor = firstPage.page.nextCursor;\n\n  while (cursor !== null) {\n    const page = await platformStore.listArchiveTurns({\n      processId,\n      cursor,\n      limit: DEFAULT_DERIVED_ARCHIVE_VIEW_LIMIT,\n    });\n    turns.push(...page.turns);\n    cursor = page.page.nextCursor;\n  }\n\n  return turns;\n}\n\nasync function hasStoredTurns(\n  platformStore: Pick<PlatformStore, 'listArchiveTurns'>,\n  processId: string,\n): Promise<boolean> {\n  const firstPage = await platformStore.listArchiveTurns({\n    processId,\n    cursor: null,\n    limit: 1,\n  });\n\n  return firstPage.turns.length > 0;\n}\n\nasync function hasArchiveEntries(\n  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n  processId: string,\n): Promise<boolean> {\n  const firstPage = await platformStore.listArchiveEntries({\n    processId,\n    cursor: null,\n    limit: 1,\n  });\n\n  return firstPage.entries.length > 0;\n}\n\nasync function computeArchiveSignature(\n  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n  processId: string,\n): Promise<string> {\n  const entries = await listAllArchiveEntries(platformStore, processId);\n\n  return entries\n    .map((entry) => `${entry.archiveEntryId}:${entry.sequence}:${entry.recordedAt}`)\n    .join('|');\n}\n\nasync function listAllArchiveEntries(\n  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n  processId: string,\n): Promise<ArchiveEntry[]> {\n  const entries: ArchiveEntry[] = [];\n  let cursor: string | null = null;\n\n  for (;;) {\n    const page: ArchivePage = await platformStore.listArchiveEntries({\n      processId,\n      cursor,\n      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n    });\n    entries.push(...page.entries);\n\n    if (!page.page.hasMore || page.page.nextCursor === null) {\n      break;\n    }\n\n    cursor = normalizeArchiveCursor(page.page.nextCursor);\n  }\n\n  return entries.sort((left, right) => left.sequence - right.sequence);\n}\n\nfunction buildDerivedArchiveViews(turns: DerivedTurn[], processId: string): DerivedArchiveView[] {\n  if (turns.length === 0) {\n    return [];\n  }\n\n  const now = Date.now();\n  const turnRangeViews = turns.map((turn, index) =>\n    buildStructuralView({\n      processId,\n      viewKind: 'turn_range',\n      rangeTurns: [turn],\n      updatedAt: new Date(now - index).toISOString(),\n    }),\n  );\n  const chunkCandidateViews = groupTurnsForChunkCandidates(turns).map((group, index) =>\n    buildStructuralView({\n      processId,\n      viewKind: 'chunk_candidate',\n      rangeTurns: group,\n      updatedAt: new Date(now - turnRangeViews.length - index).toISOString(),\n    }),\n  );\n\n  return [...turnRangeViews, ...chunkCandidateViews];\n}\n\nfunction groupTurnsForChunkCandidates(turns: DerivedTurn[]): DerivedTurn[][] {\n  const groups: DerivedTurn[][] = [];\n\n  for (let index = 0; index < turns.length; index += CHUNK_CANDIDATE_GROUP_SIZE) {\n    groups.push(turns.slice(index, index + CHUNK_CANDIDATE_GROUP_SIZE));\n  }\n\n  return groups;\n}\n\nfunction buildStructuralView(args: {\n  processId: string;\n  viewKind: DerivedArchiveView['viewKind'];\n  rangeTurns: DerivedTurn[];\n  updatedAt: string;\n}): DerivedArchiveView {\n  const firstTurn = args.rangeTurns[0];\n  const lastTurn = args.rangeTurns[args.rangeTurns.length - 1];\n\n  if (firstTurn === undefined || lastTurn === undefined) {\n    throw new AppError({\n      code: invalidArchiveRequestErrorCode,\n      message: 'Derived archive views require at least one source turn.',\n      statusCode: 422,\n    });\n  }\n\n  const turnRange = {\n    startIndex: firstTurn.turnIndex,\n    endIndex: lastTurn.turnIndex,\n  };\n  const label =\n    args.viewKind === 'turn_range'\n      ? formatTurnRangeLabel(turnRange.startIndex, turnRange.endIndex)\n      : formatChunkCandidateLabel(turnRange.startIndex, turnRange.endIndex);\n  const degradationReasons = dedupeStrings(\n    args.rangeTurns\n      .filter((turn) => turn.turnStatus === 'degraded')\n      .map(\n        (turn) =>\n          turn.degradationReason ?? `Turn ${turn.turnIndex} degraded during derived-view refresh.`,\n      ),\n  );\n  const hasGap = !args.rangeTurns.every((turn, index) =>\n    index === 0 ? true : turn.turnIndex === firstTurn.turnIndex + index,\n  );\n\n  if (hasGap) {\n    degradationReasons.push(\n      `Turn indexes ${turnRange.startIndex}-${turnRange.endIndex} were not contiguous during derived-view refresh.`,\n    );\n  }\n\n  return {\n    derivedViewId: `${args.processId}:derived-view:${args.viewKind}:${turnRange.startIndex}-${turnRange.endIndex}`,\n    processId: args.processId,\n    viewKind: args.viewKind,\n    turnRange,\n    sourceTurnIds: args.rangeTurns.map((turn) => turn.turnId),\n    sourceArchiveEntryIds: dedupeStrings(args.rangeTurns.flatMap((turn) => turn.archiveEntryIds)),\n    title: label,\n    bodyText: label,\n    viewStatus: degradationReasons.length > 0 ? 'degraded' : 'ready',\n    degradationReason: degradationReasons.length > 0 ? degradationReasons.join(' ') : null,\n    updatedAt: args.updatedAt,\n  };\n}\n\nfunction formatTurnRangeLabel(startIndex: number, endIndex: number): string {\n  return startIndex === endIndex ? `Turn ${startIndex}` : `Turns ${startIndex}-${endIndex}`;\n}\n\nfunction formatChunkCandidateLabel(startIndex: number, endIndex: number): string {\n  return startIndex === endIndex\n    ? `Chunk candidate turn ${startIndex}`\n    : `Chunk candidate turns ${startIndex}-${endIndex}`;\n}\n\nfunction dedupeStrings(values: string[]): string[] {\n  return [...new Set(values)];\n}\n\nfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n  if (cursor === undefined || cursor === null) {\n    return null;\n  }\n\n  if (!/^\\d+$/.test(cursor)) {\n    throw new AppError({\n      code: invalidArchiveRequestErrorCode,\n      message: 'Archive pagination parameters were invalid.',\n      statusCode: 422,\n    });\n  }\n\n  return cursor;\n}\n\nfunction normalizeDerivedArchiveViewLimit(limit: number | undefined): number {\n  if (limit === undefined) {\n    return DEFAULT_DERIVED_ARCHIVE_VIEW_LIMIT;\n  }\n\n  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_DERIVED_ARCHIVE_VIEW_LIMIT) {\n    throw new AppError({\n      code: invalidArchiveRequestErrorCode,\n      message: 'Archive pagination parameters were invalid.',\n      statusCode: 422,\n    });\n  }\n\n  return limit;\n}\n","numLines":437,"startLine":1,"totalLines":437}}}
