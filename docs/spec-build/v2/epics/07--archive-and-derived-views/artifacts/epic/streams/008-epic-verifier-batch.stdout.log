{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rinbtj1bNZguug6qWGLug2","type":"tool_result","content":"1\timport type {\n2\t  ArchiveBodyFormat,\n3\t  ArchiveEntryKind,\n4\t  ProcessHistoryItem,\n5\t} from '../../../shared/contracts/index.js';\n6\timport type { ArchiveEntryWriteInput } from '../projects/platform-store.js';\n7\t\n8\tconst compatibleHistoryKindToArchiveKind = {\n9\t  user_message: 'user_message',\n10\t  process_message: 'model_message',\n11\t  process_event: 'process_event',\n12\t} as const satisfies Partial<Record<ProcessHistoryItem['kind'], ArchiveEntryKind>>;\n13\t\n14\texport class ProcessHistoryCompatService {\n15\t  mapHistoryKindToArchiveKind(kind: ProcessHistoryItem['kind']): ArchiveEntryKind | null {\n16\t    if (kind in compatibleHistoryKindToArchiveKind) {\n17\t      return compatibleHistoryKindToArchiveKind[\n18\t        kind as keyof typeof compatibleHistoryKindToArchiveKind\n19\t      ];\n20\t    }\n21\t\n22\t    return null;\n23\t  }\n24\t\n25\t  mapHistoryItemToArchiveSeed(args: {\n26\t    projectId: string;\n27\t    processId: string;\n28\t    historyItem: ProcessHistoryItem;\n29\t  }): ArchiveEntryWriteInput | null {\n30\t    const entryKind = this.mapHistoryKindToArchiveKind(args.historyItem.kind);\n31\t\n32\t    if (args.historyItem.lifecycleState !== 'finalized' || entryKind === null) {\n33\t      return null;\n34\t    }\n35\t\n36\t    const bodyFormat: ArchiveBodyFormat =\n37\t      args.historyItem.text.trim().length > 0 ? 'plain_text' : 'none';\n38\t\n39\t    return {\n40\t      projectId: args.projectId,\n41\t      processId: args.processId,\n42\t      entryKind,\n43\t      finalizationKey: buildHistoryItemArchiveFinalizationKey({\n44\t        entryKind,\n45\t        sourceObjectId: args.historyItem.historyItemId,\n46\t      }),\n47\t      sourceObjectId: args.historyItem.historyItemId,\n48\t      bodyText: bodyFormat === 'none' ? null : args.historyItem.text,\n49\t      bodyData: null,\n50\t      bodyFormat,\n51\t      relatedArtifactVersionId: null,\n52\t      relatedSourceProvenanceId: null,\n53\t      relatedToolCallId: null,\n54\t      entryStatus: 'ready',\n55\t      degradationReason: null,\n56\t      recordedAt: args.historyItem.createdAt,\n57\t    };\n58\t  }\n59\t}\n60\t\n61\texport function buildHistoryItemArchiveFinalizationKey(args: {\n62\t  entryKind: ArchiveEntryKind;\n63\t  sourceObjectId: string;\n64\t}): string {\n65\t  switch (args.entryKind) {\n66\t    case 'user_message':\n67\t      return buildAcceptedUserResponseArchiveFinalizationKey(args.sourceObjectId);\n68\t    case 'model_message':\n69\t      return `model:${args.sourceObjectId}`;\n70\t    case 'process_event':\n71\t      return `event:${args.sourceObjectId}`;\n72\t    default:\n73\t      return `history:${args.sourceObjectId}`;\n74\t  }\n75\t}\n76\t\n77\texport function buildAcceptedUserResponseArchiveFinalizationKey(historyItemId: string): string {\n78\t  return `response:${historyItemId}`;\n79\t}\n80\t"}]},"parent_tool_use_id":"toolu_01MLQaCrEnQ196HFMGLH5UZn","session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"ac733d8b-9c57-4b4e-a8c8-39af8e5647df","timestamp":"2026-05-05T18:52:32.998Z"}
