{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A5E6Vr2c38ZawtnaDZgty8","type":"tool_result","content":"1\timport type { ArchiveTurnPage, DerivedTurn } from '../apps/platform/shared/contracts/index.js';\n2\timport type { Doc, Id } from './_generated/dataModel.js';\n3\timport { mutation, query, type MutationCtx, type QueryCtx } from './_generated/server.js';\n4\timport { v } from 'convex/values';\n5\timport { archiveEntryStatusValidator } from './archiveEntries.js';\n6\t\n7\texport const archiveTurnsTableFields = {\n8\t  projectId: v.string(),\n9\t  processId: v.id('processes'),\n10\t  turnId: v.string(),\n11\t  turnIndex: v.number(),\n12\t  archiveEntryIds: v.array(v.id('archiveEntries')),\n13\t  startedAt: v.string(),\n14\t  endedAt: v.string(),\n15\t  turnStatus: archiveEntryStatusValidator,\n16\t  degradationReason: v.union(v.string(), v.null()),\n17\t  rebuiltAt: v.string(),\n18\t};\n19\t\n20\tconst derivedTurnValidator = v.object({\n21\t  turnId: v.string(),\n22\t  processId: v.string(),\n23\t  turnIndex: v.number(),\n24\t  archiveEntryIds: v.array(v.string()),\n25\t  startedAt: v.string(),\n26\t  endedAt: v.string(),\n27\t  turnStatus: archiveEntryStatusValidator,\n28\t  degradationReason: v.union(v.string(), v.null()),\n29\t});\n30\t\n31\tconst upsertArchiveTurnsArgsValidator = {\n32\t  projectId: v.string(),\n33\t  processId: v.string(),\n34\t  turns: v.array(derivedTurnValidator),\n35\t} as const;\n36\t\n37\tconst listArchiveTurnsArgsValidator = {\n38\t  processId: v.string(),\n39\t  cursor: v.optional(v.union(v.string(), v.null())),\n40\t  limit: v.number(),\n41\t} as const;\n42\t\n43\tconst MAX_TURN_PAGE_SIZE = 100;\n44\t\n45\texport const upsertArchiveTurns = mutation({\n46\t  args: upsertArchiveTurnsArgsValidator,\n47\t  handler: async (ctx: MutationCtx, args): Promise<null> => {\n48\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n49\t    const rebuiltAt = new Date().toISOString();\n50\t    const existingTurns = await ctx.db\n51\t      .query('archiveTurns')\n52\t      .withIndex('by_processId_and_turnId', (indexQuery) =>\n53\t        indexQuery.eq('processId', processRecord._id),\n54\t      )\n55\t      .collect();\n56\t    const existingByTurnId = new Map(existingTurns.map((turn) => [turn.turnId, turn]));\n57\t    const nextTurnIds = new Set<string>();\n58\t\n59\t    for (const turn of [...args.turns].sort((left, right) => left.turnIndex - right.turnIndex)) {\n60\t      assertDerivedTurn(turn, args.processId);\n61\t      nextTurnIds.add(turn.turnId);\n62\t      const storedTurn = {\n63\t        projectId: args.projectId,\n64\t        processId: processRecord._id,\n65\t        turnId: turn.turnId,\n66\t        turnIndex: turn.turnIndex,\n67\t        archiveEntryIds: turn.archiveEntryIds.map((entryId) => entryId as Id<'archiveEntries'>),\n68\t        startedAt: turn.startedAt,\n69\t        endedAt: turn.endedAt,\n70\t        turnStatus: turn.turnStatus,\n71\t        degradationReason: turn.degradationReason,\n72\t        rebuiltAt,\n73\t      };\n74\t      const existing = existingByTurnId.get(turn.turnId);\n75\t\n76\t      if (existing === undefined) {\n77\t        await ctx.db.insert('archiveTurns', storedTurn);\n78\t        continue;\n79\t      }\n80\t\n81\t      await ctx.db.patch(existing._id, storedTurn);\n82\t    }\n83\t\n84\t    for (const existing of existingTurns) {\n85\t      if (!nextTurnIds.has(existing.turnId)) {\n86\t        await ctx.db.delete(existing._id);\n87\t      }\n88\t    }\n89\t\n90\t    await invalidateDerivedArchiveViews(ctx, processRecord._id);\n91\t\n92\t    return null;\n93\t  },\n94\t});\n95\t\n96\texport const listArchiveTurns = query({\n97\t  args: listArchiveTurnsArgsValidator,\n98\t  handler: async (ctx: QueryCtx, args): Promise<ArchiveTurnPage> => {\n99\t    assertTurnPageLimit(args.limit);\n100\t    const processId = args.processId as Id<'processes'>;\n101\t    const decodedCursor = decodeArchiveTurnCursor(args.cursor ?? null);\n102\t    const pageWithLookahead = await ctx.db\n103\t      .query('archiveTurns')\n104\t      .withIndex('by_processId_and_turnIndex', (indexQuery) =>\n105\t        decodedCursor === null\n106\t          ? indexQuery.eq('processId', processId)\n107\t          : indexQuery.eq('processId', processId).gt('turnIndex', decodedCursor),\n108\t      )\n109\t      .order('asc')\n110\t      .take(args.limit + 1);\n111\t    const hasMore = pageWithLookahead.length > args.limit;\n112\t    const pageTurns = pageWithLookahead.slice(0, args.limit).map((turn) => buildDerivedTurn(turn));\n113\t    const lastTurn = pageTurns.at(-1);\n114\t\n115\t    return {\n116\t      turns: pageTurns,\n117\t      page: {\n118\t        cursor: args.cursor ?? null,\n119\t        nextCursor: hasMore && lastTurn !== undefined ? String(lastTurn.turnIndex) : null,\n120\t        hasMore,\n121\t      },\n122\t    };\n123\t  },\n124\t});\n125\t\n126\tasync function getProcessRecordOrThrow(\n127\t  ctx: MutationCtx,\n128\t  processIdValue: string,\n129\t  projectId: string,\n130\t): Promise<Doc<'processes'>> {\n131\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n132\t\n133\t  if (processRecord === null) {\n134\t    throw new Error('Process not found.');\n135\t  }\n136\t\n137\t  if (processRecord.projectId !== projectId) {\n138\t    throw new Error('Process does not belong to the requested project.');\n139\t  }\n140\t\n141\t  return processRecord;\n142\t}\n143\t\n144\tfunction buildDerivedTurn(record: Doc<'archiveTurns'>): DerivedTurn {\n145\t  return {\n146\t    turnId: record.turnId,\n147\t    processId: record.processId,\n148\t    turnIndex: record.turnIndex,\n149\t    archiveEntryIds: [...record.archiveEntryIds],\n150\t    startedAt: record.startedAt,\n151\t    endedAt: record.endedAt,\n152\t    turnStatus: record.turnStatus,\n153\t    degradationReason: record.degradationReason,\n154\t  };\n155\t}\n156\t\n157\tasync function invalidateDerivedArchiveViews(\n158\t  ctx: MutationCtx,\n159\t  processId: Id<'processes'>,\n160\t): Promise<void> {\n161\t  const storedViews = await ctx.db\n162\t    .query('derivedArchiveViews')\n163\t    .withIndex('by_processId_and_updatedAt', (indexQuery) => indexQuery.eq('processId', processId))\n164\t    .collect();\n165\t\n166\t  for (const storedView of storedViews) {\n167\t    await ctx.db.delete(storedView._id);\n168\t  }\n169\t}\n170\t\n171\tfunction assertDerivedTurn(turn: DerivedTurn, processId: string): void {\n172\t  if (turn.turnId.trim().length === 0) {\n173\t    throw new Error('Derived turns require a non-empty turnId.');\n174\t  }\n175\t\n176\t  if (turn.processId !== processId) {\n177\t    throw new Error('Derived turn processId must match the enclosing process.');\n178\t  }\n179\t\n180\t  if (!Number.isInteger(turn.turnIndex) || turn.turnIndex < 0) {\n181\t    throw new Error('Derived turns require a non-negative turnIndex.');\n182\t  }\n183\t\n184\t  if (turn.archiveEntryIds.length === 0) {\n185\t    throw new Error('Derived turns require at least one archive entry id.');\n186\t  }\n187\t\n188\t  if (turn.archiveEntryIds.some((archiveEntryId) => archiveEntryId.trim().length === 0)) {\n189\t    throw new Error('Derived turn archive entry ids must be non-empty strings.');\n190\t  }\n191\t\n192\t  if (\n193\t    turn.turnStatus === 'degraded' &&\n194\t    (turn.degradationReason === null || turn.degradationReason.trim().length === 0)\n195\t  ) {\n196\t    throw new Error('Degraded turns must include a degradation reason.');\n197\t  }\n198\t}\n199\t\n200\tfunction assertTurnPageLimit(limit: number): void {\n201\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_TURN_PAGE_SIZE) {\n202\t    throw new Error(`Turn page limit must be an integer between 1 and ${MAX_TURN_PAGE_SIZE}.`);\n203\t  }\n204\t}\n205\t\n206\tfunction decodeArchiveTurnCursor(cursor: string | null): number | null {\n207\t  if (cursor == null) {\n208\t    return null;\n209\t  }\n210\t\n211\t  const parsed = Number.parseInt(cursor, 10);\n212\t  return Number.isNaN(parsed) ? null : parsed;\n213\t}\n214\t"}]},"parent_tool_use_id":"toolu_01MLQaCrEnQ196HFMGLH5UZn","session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"b9d888e1-b0c5-446f-bd2b-e6b0b05001fd","timestamp":"2026-05-05T18:52:23.738Z"}
