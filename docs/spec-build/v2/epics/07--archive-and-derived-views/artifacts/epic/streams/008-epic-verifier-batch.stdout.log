kSurfaceRouteParams = z.infer<typeof processWorkSurfaceRouteParamsSchema>;\n    38\t\n    39\texport function buildProcessWorkSurfacePath(args: ProcessWorkSurfaceRouteParams): string {\n    40\t  return `/projects/${args.projectId}/processes/${args.processId}`;\n    41\t}\n    42\t\n    43\texport function buildProcessWorkSurfaceApiPath(args: ProcessWorkSurfaceRouteParams): string {\n    44\t  return `/api${buildProcessWorkSurfacePath(args)}`;\n    45\t}\n    46\t\n    47\texport function buildProcessStartApiPath(args: ProcessWorkSurfaceRouteParams): string {\n    48\t  return `${buildProcessWorkSurfaceApiPath(args)}/start`;\n    49\t}\n    50\t\n    51\texport function buildProcessResumeApiPath(args: ProcessWorkSurfaceRouteParams): string {\n    52\t  return `${buildProcessWorkSurfaceApiPath(args)}/resume`;\n    53\t}\n    54\t\n    55\texport function buildProcessRehydrateApiPath(args: ProcessWorkSurfaceRouteParams): string {\n    56\t  return `${buildProcessWorkSurfaceApiPath(args)}/rehydrate`;\n    57\t}\n    58\t\n    59\texport function buildProcessRebuildApiPath(args: ProcessWorkSurfaceRouteParams): string {\n    60\t  return `${buildProcessWorkSurfaceApiPath(args)}/rebuild`;\n    61\t}\n    62\t\n    63\texport function buildProcessResponseApiPath(args: ProcessWorkSurfaceRouteParams): string {\n    64\t  return `${buildProcessWorkSurfaceApiPath(args)}/responses`;\n    65\t}\n    66\t\n    67\texport function buildProcessLiveUpdatesPath(args: ProcessWorkSurfaceRouteParams): string {\n    68\t  return `/ws${buildProcessWorkSurfacePath(args)}`;\n    69\t}\n    70\t\n    71\texport const processSurfaceAvailableActionSchema = z.enum([\n    72\t  'start',\n    73\t  'respond',\n    74\t  'resume',\n    75\t  'rehydrate',\n    76\t  'rebuild',\n    77\t  'review',\n    78\t  'restart',\n    79\t]);\n    80\texport type ProcessSurfaceAvailableAction = z.infer<typeof processSurfaceAvailableActionSchema>;\n    81\t\n    82\texport const processSurfaceControlActionIdSchema = processSurfaceAvailableActionSchema;\n    83\texport type ProcessSurfaceControlActionId = z.infer<typeof processSurfaceControlActionIdSchema>;\n    84\t\n    85\texport const environmentStateSchema = z.enum([\n    86\t  'absent',\n    87\t  'preparing',\n    88\t  'rehydrating',\n    89\t  'ready',\n    90\t  'running',\n    91\t  'checkpointing',\n    92\t  'stale',\n    93\t  'failed',\n    94\t  'lost',\n    95\t  'rebuilding',\n    96\t  'unavailable',\n    97\t]);\n    98\texport type EnvironmentState = z.infer<typeof environmentStateSchema>;\n    99\t\n   100\texport const defaultEnvironmentStatusLabels = {\n   101\t  absent: 'Not prepared',\n   102\t  preparing: 'Preparing environment',\n   103\t  rehydrating: 'Rehydrating environment',\n   104\t  ready: 'Ready for work',\n   105\t  running: 'Running in environment',\n   106\t  checkpointing: 'Checkpointing work',\n   107\t  stale: 'Environment is stale',\n   108\t  failed: 'Environment failed',\n   109\t  lost: 'Environment lost',\n   110\t  rebuilding: 'Rebuilding environment',\n   111\t  unavailable: 'Environment unavailable',\n   112\t} as const satisfies Record<EnvironmentState, string>;\n   113\t\n   114\texport function deriveEnvironmentStatusLabel(state: EnvironmentState): string {\n   115\t  return defaultEnvironmentStatusLabels[state];\n   116\t}\n   117\t\n   118\texport const checkpointKindSchema = z.enum(['artifact', 'code', 'mixed']);\n   119\texport type CheckpointKind = z.infer<typeof checkpointKindSchema>;\n   120\t\n   121\texport const checkpointOutcomeSchema = z.enum(['succeeded', 'failed']);\n   122\texport type CheckpointOutcome = z.infer<typeof checkpointOutcomeSchema>;\n   123\t\n   124\texport const processHistoryItemKindSchema = z.enum([\n   125\t  'user_message',\n   126\t  'process_message',\n   127\t  'progress_update',\n   128\t  'attention_request',\n   129\t  'side_work_update',\n   130\t  'process_event',\n   131\t]);\n   132\texport type ProcessHistoryItemKind = z.infe