{"type":"item.completed","item":{"id":"item_84","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/client/features/processes/process-work-surface-page.ts | sed -n '1,240p'\"","aggregated_output":"     1\timport type { AppStore } from '../../app/store.js';\n     2\timport { renderShellHeader } from '../projects/shell-header.js';\n     3\timport {\n     4\t  renderForbiddenProcessState,\n     5\t  renderMissingProcessState,\n     6\t  renderMissingProjectState,\n     7\t} from '../projects/unavailable-state.js';\n     8\timport { renderCurrentRequestPanel } from './current-request-panel.js';\n     9\timport { renderProcessControls } from './process-controls.js';\n    10\timport { renderProcessEnvironmentPanel } from './process-environment-panel.js';\n    11\timport { renderProcessHistorySection } from './process-history-section.js';\n    12\timport { renderProcessLiveStatus } from './process-live-status.js';\n    13\timport { renderProcessMaterialsSection } from './process-materials-section.js';\n    14\timport { renderProcessResponseComposer } from './process-response-composer.js';\n    15\timport { renderSourceProvenanceSection } from './source-provenance-section.js';\n    16\timport { renderSideWorkSection } from './side-work-section.js';\n    17\timport type { CreateSourceAttachmentRequest } from '../../../shared/contracts/index.js';\n    18\t\n    19\tfunction formatProcessTypeLabel(processType: string): string {\n    20\t  return processType.replace(/([a-z])([A-Z])/g, '$1 $2');\n    21\t}\n    22\t\n    23\tfunction formatProcessStatusLabel(status: string): string {\n    24\t  return status.charAt(0).toUpperCase() + status.slice(1);\n    25\t}\n    26\t\n    27\texport function renderProcessWorkSurfacePage(args: {\n    28\t  store: AppStore;\n    29\t  targetDocument: Document;\n    30\t  targetWindow: Window & typeof globalThis;\n    31\t  onOpenProject: (projectId: string) => void;\n    32\t  onOpenReview?: (projectId: string, processId: string) => void;\n    33\t  onStartProcess?: (projectId: string, processId: string) => void;\n    34\t  onResumeProcess?: (projectId: string, processId: string) => void;\n    35\t  onRehydrateEnvironment?: (projectId: string, processId: string) => void;\n    36\t  onRebuildEnvironment?: (projectId: string, processId: string) => void;\n    37\t  onSubmitProcessResponse?: (projectId: string, processId: string, message: string) => void;\n    38\t  onRetryLiveSubscription?: (projectId: string, processId: string) => void;\n    39\t  onAttachSource?: (\n    40\t    projectId: string,\n    41\t    processId: string,\n    42\t    input: CreateSourceAttachmentRequest,\n    43\t  ) => Promise<void>;\n    44\t  onRefreshSource?: (projectId: string, sourceAttachmentId: string) => Promise<void>;\n    45\t}): HTMLElement {\n    46\t  const container = args.targetDocument.createElement('section');\n    47\t  const state = args.store.get();\n    48\t  const processSurface = state.processSurface;\n    49\t\n    50\t  container.setAttribute('data-process-work-surface', 'true');\n    51\t  container.append(\n    52\t    renderShellHeader({\n    53\t      store: args.store,\n    54\t      targetDocument: args.targetDocument,\n    55\t      targetWindow: args.targetWindow,\n    56\t    }),\n    57\t  );\n    58\t\n    59\t  if (processSurface.isLoading) {\n    60\t    const loading = args.targetDocument.createElement('p');\n    61\t    loading.textContent = 'Loading process work surface...';\n    62\t    container.append(loading);\n    63\t    return container;\n    64\t  }\n    65\t\n    66\t  if (processSurface.error?.code === 'PROJECT_FORBIDDEN') {\n    67\t    container.append(renderForbiddenProcessState(args.targetDocument));\n    68\t    return container;\n    69\t  }\n    70\t\n    71\t  if (processSurface.error?.code === 'PROJECT_NOT_FOUND') {\n    72\t    container.append(renderMissingProjectState(args.targetDocument));\n    73\t    return container;\n    74\t  }\n    75\t\n    76\t  if (processSurface.error?.code === 'PROCESS_NOT_FOUND') {\n    77\t    container.append(renderMissingProcessState(args.targetDocument));\n    78\t    return container;\n    79\t  }\n    80\t\n    81\t  if (\n    82\t    processSurface.error !== null ||\n    83\t    processSurface.project === null ||\n    84\t    processSurface.process === null\n    85\t  ) {\n    86\t    const error = args.targetDocument.createElement('section');\n    87\t    const title = args.targetDocument.createElement('h2');\n    88\t    const body = args.targetDocument.createElement('p');\n    89\t    title.textContent = 'Process work surface failed to load';\n    90\t    body.textContent = processSurface.error?.message ?? 'The process work surface is unavailable.';\n    91\t    error.append(title, body);\n    92\t    container.append(error);\n    93\t    return container;\n    94\t  }\n    95\t\n    96\t  const activeProject = processSurface.project;\n    97\t  const activeProcess = processSurface.process;\n    98\t\n    99\t  const backButton = args.targetDocument.createElement('button');\n   100\t  backButton.type = 'button';\n   101\t  backButton.textContent = 'Back to project';\n   102\t  backButton.addEventListener('click', () => {\n   103\t    args.onOpenProject(activeProject.projectId);\n   104\t  });\n   105\t\n   106\t  const projectHeading = args.targetDocument.createElement('h2');\n   107\t  const projectRole = args.targetDocument.createElement('p');\n   108\t  const processHeading = args.targetDocument.createElement('h3');\n   109\t  const processMeta = args.targetDocument.createElement('p');\n   110\t  const processPhase = args.targetDocument.createElement('p');\n   111\t\n   112\t  projectHeading.textContent = activeProject.name;\n   113\t  projectRole.textContent = `Role: ${activeProject.role}`;\n   114\t  processHeading.textContent = activeProcess.displayLabel;\n   115\t  processMeta.textContent = `${formatProcessTypeLabel(activeProcess.processType)} • ${formatProcessStatusLabel(activeProcess.status)}`;\n   116\t  processPhase.textContent = `Phase: ${activeProcess.phaseLabel}`;\n   117\t  container.append(\n   118\t    backButton,\n   119\t    projectHeading,\n   120\t    projectRole,\n   121\t    processHeading,\n   122\t    processMeta,\n   123\t    processPhase,\n   124\t  );\n   125\t\n   126\t  if (processSurface.actionError !== null) {\n   127\t    const actionError = args.targetDocument.createElement('p');\n   128\t    actionError.setAttribute('data-process-action-error', 'true');\n   129\t    actionError.setAttribute('role', 'alert');\n   130\t    actionError.textContent = processSurface.actionError.message;\n   131\t    container.append(actionError);\n   132\t  }\n   133\t\n   134\t  if (activeProcess.nextActionLabel !== null) {\n   135\t    const nextAction = args.targetDocument.createElement('p');\n   136\t    nextAction.textContent = `Next action: ${activeProcess.nextActionLabel}`;\n   137\t    container.append(nextAction);\n   138\t  }\n   139\t\n   140\t  container.append(\n   141\t    renderProcessControls({\n   142\t      controls: activeProcess.controls,\n   143\t      targetDocument: args.targetDocument,\n   144\t      onAction: (actionId) => {\n   145\t        switch (actionId) {\n   146\t          case 'start':\n   147\t            args.onStartProcess?.(activeProject.projectId, activeProcess.processId);\n   148\t            return;\n   149\t          case 'resume':\n   150\t            args.onResumeProcess?.(activeProject.projectId, activeProcess.processId);\n   151\t            return;\n   152\t          case 'review':\n   153\t            args.onOpenReview?.(activeProject.projectId, activeProcess.processId);\n   154\t            return;\n   155\t          case 'rehydrate':\n   156\t            args.onRehydrateEnvironment?.(activeProject.projectId, activeProcess.processId);\n   157\t            return;\n   158\t          case 'rebuild':\n   159\t            args.onRebuildEnvironment?.(activeProject.projectId, activeProcess.processId);\n   160\t            return;\n   161\t          case 'respond': {\n   162\t            const responseInput = container.querySelector('[data-process-response-input=\"true\"]');\n   163\t\n   164\t            if (responseInput instanceof args.targetWindow.HTMLTextAreaElement) {\n   165\t              responseInput.focus();\n   166\t            }\n   167\t            return;\n   168\t          }\n   169\t          default:\n   170\t            return;\n   171\t        }\n   172\t      },\n   173\t    }),\n   174\t  );\n   175\t\n   176\t  const liveStatus = renderProcessLiveStatus({\n   177\t    liveState: processSurface.live,\n   178\t    targetDocument: args.targetDocument,\n   179\t    onRetry:\n   180\t      args.onRetryLiveSubscription === undefined\n   181\t        ? undefined\n   182\t        : () => {\n   183\t            args.onRetryLiveSubscription?.(activeProject.projectId, activeProcess.processId);\n   184\t          },\n   185\t  });\n   186\t\n   187\t  if (liveStatus !== null) {\n   188\t    container.append(liveStatus);\n   189\t  }\n   190\t\n   191\t  container.append(\n   192\t    renderProcessEnvironmentPanel({\n   193\t      environment: processSurface.environment,\n   194\t      targetDocument: args.targetDocument,\n   195\t    }),\n   196\t    renderCurrentRequestPanel({\n   197\t      currentRequest: processSurface.currentRequest,\n   198\t      targetDocument: args.targetDocument,\n   199\t    }),\n   200\t  );\n   201\t\n   202\t  if (\n   203\t    activeProcess.availableActions.includes('respond') &&\n   204\t    args.onSubmitProcessResponse !== undefined\n   205\t  ) {\n   206\t    container.append(\n   207\t      renderProcessResponseComposer({\n   208\t        targetDocument: args.targetDocument,\n   209\t        onSubmitResponse: async (message: string) => {\n   210\t          args.onSubmitProcessResponse?.(activeProject.projectId, activeProcess.processId, message);\n   211\t        },\n   212\t      }),\n   213\t    );\n   214\t  }\n   215\t\n   216\t  container.append(\n   217\t    renderProcessHistorySection({\n   218\t      envelope: processSurface.history,\n   219\t      targetDocument: args.targetDocument,\n   220\t    }),\n   221\t    renderProcessMaterialsSection({\n   222\t      envelope: processSurface.materials,\n   223\t      targetDocument: args.targetDocument,\n   224\t      onAttachSource:\n   225\t        args.onAttachSource === undefined\n   226\t          ? undefined\n   227\t          : async (input) => {\n   228\t              await args.onAttachSource?.(activeProject.projectId, activeProcess.processId, input);\n   229\t            },\n   230\t      onRefreshSource:\n   231\t        args.onRefreshSource === undefined\n   232\t          ? undefined\n   233\t          : async (sourceAttachmentId) => {\n   234\t              await args.onRefreshSource?.(activeProject.projectId, sourceAttachmentId);\n   235\t            },\n   236\t    }),\n   237\t    renderSourceProvenanceSection({\n   238\t      provenance: processSurface.sourceProvenance,\n   239\t      targetDocument: args.targetDocument,\n   240\t    }),\n","exit_code":0,"status":"completed"}}
