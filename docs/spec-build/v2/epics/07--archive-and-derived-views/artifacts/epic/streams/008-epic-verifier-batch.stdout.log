ay(v.string()),\n52\t  title: v.union(v.string(), v.null()),\n53\t  bodyText: v.union(v.string(), v.null()),\n54\t  viewStatus: archiveEntryStatusValidator,\n55\t  degradationReason: v.union(v.string(), v.null()),\n56\t  updatedAt: v.string(),\n57\t});\n58\t\n59\tconst replaceDerivedArchiveViewsArgsValidator = {\n60\t  projectId: v.string(),\n61\t  processId: v.string(),\n62\t  views: v.array(derivedArchiveViewValidator),\n63\t} as const;\n64\t\n65\tconst listDerivedArchiveViewsArgsValidator = {\n66\t  processId: v.string(),\n67\t  cursor: v.optional(v.union(v.string(), v.null())),\n68\t  limit: v.number(),\n69\t} as const;\n70\t\n71\tconst replaceDerivedArchiveViewsInternalRef = makeFunctionReference<\n72\t  'mutation',\n73\t  {\n74\t    projectId: string;\n75\t    processId: string;\n76\t    views: DerivedArchiveView[];\n77\t  },\n78\t  null\n79\t>('derivedArchiveViews:replaceDerivedArchiveViews');\n80\t\n81\tconst listDerivedArchiveViewsInternalRef = makeFunctionReference<\n82\t  'query',\n83\t  {\n84\t    processId: string;\n85\t    cursor?: string | null;\n86\t    limit: number;\n87\t  },\n88\t  DerivedArchiveViewListResponse\n89\t>('derivedArchiveViews:listDerivedArchiveViews');\n90\t\n91\texport const replaceDerivedArchiveViewsForService = mutation({\n92\t  args: {\n93\t    apiKey: v.string(),\n94\t    ...replaceDerivedArchiveViewsArgsValidator,\n95\t  },\n96\t  handler: async (ctx, args): Promise<null> => {\n97\t    assertValidApiKey(args.apiKey);\n98\t\n99\t    const result: null = await ctx.runMutation(replaceDerivedArchiveViewsInternalRef, {\n100\t      projectId: args.projectId,\n101\t      processId: args.processId,\n102\t      views: args.views,\n103\t    });\n104\t\n105\t    return result;\n106\t  },\n107\t});\n108\t\n109\texport const replaceDerivedArchiveViews = internalMutation({\n110\t  args: replaceDerivedArchiveViewsArgsValidator,\n111\t  handler: async (ctx: MutationCtx, args): Promise<null> => {\n112\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n113\t    const existingViews = await ctx.db\n114\t      .query('derivedArchiveViews')\n115\t      .withIndex('by_processId_and_updatedAt', (indexQuery) =>\n116\t        indexQuery.eq('processId', processRecord._id),\n117\t      )\n118\t      .collect();\n119\t    const nextViewIds = new Set<string>();\n120\t\n121\t    for (const view of args.views) {\n122\t      assertDerivedArchiveView(view, args.processId);\n123\t      nextViewIds.add(view.derivedViewId);\n124\t    }\n125\t\n126\t    for (const existingView of existingViews) {\n127\t      if (!nextViewIds.has(existingView.derivedViewId)) {\n128\t        await ctx.db.delete(existingView._id);\n129\t      }\n130\t    }\n131\t\n132\t    for (const view of args.views) {\n133\t      const storedView = {\n134\t        projectId: args.projectId,\n135\t        processId: processRecord._id,\n136\t        derivedViewId: view.derivedViewId,\n137\t        viewKind: view.viewKind,\n138\t        startTurnIndex: view.turnRange?.startIndex ?? null,\n139\t        endTurnIndex: view.turnRange?.endIndex ?? null,\n140\t        sourceTurnIds: [...view.sourceTurnIds],\n141\t        sourceArchiveEntryIds: view.sourceArchiveEntryIds.map(\n142\t          (archiveEntryId) => archiveEntryId as Id<'archiveEntries'>,\n143\t        ),\n144\t        title: view.title,\n145\t        bodyText: view.bodyText,\n146\t        viewStatus: view.viewStatus,\n147\t        degradationReason: view.degradationReason,\n148\t        updatedAt: view.updatedAt,\n149\t      };\n150\t      const existing = existingViews.find(\n151\t        (existingView) => existingView.derivedViewId === view.derivedViewId,\n152\t      );\n153\t\n154\t      if (existing === undefined) {\n155\t        await ctx.db.insert('derivedArchiveViews', storedView);\n156\t        continue;\n157\t      }\n158\t\n159\t      await ctx.db.patch(existing._id, storedView);\n160\t    }\n161\t\n162\t    return null;\n163\t  },\n164\t});\n165\t\n166\texport const listDerivedArchiveViewsForService = query({\n167\t  args: {\n168\t    apiKey: v.string(),\n169\t    ...listDerivedArchiveViewsArgsValidator,\n170\t  },\n171\t  handler: async (ctx, args): Promise<DerivedArchiveViewListResponse> => {\n172\t    assertValidApiKey(args.apiKey);\n173\t\n174\t    const result: DerivedArchiveViewListResponse = await ctx.runQuery(\n175\t      listDerivedArchiveViewsInternalRef,\n176\t      {\n177\t        processId: args.processId,\n178\t        cursor: args.cursor ?? null,\n179\t        limit: args.limit,\n180\t      },\n181\t    );\n182\t\n183\t    return result;\n184\t  },\n185\t});\n186\t\n187\texport const listDerivedArchiveViews = internalQuery({\n188\t  args: listDerivedArchiveViewsArgsValidator,\n189\t  handler: async (ctx: QueryCtx, args): Promise<DerivedArchiveViewListResponse> => {\n190\t    assertDerivedViewPageLimit(args.limit);\n191\t    const processId = args.processId as Id<'processes'>;\n192\t    const decodedCursor = decodeDerivedArchiveViewCursor(args.cursor ?? null);\n193\t    const storedViews = await ctx.db\n194\t      .query('derivedArchiveViews')\n195\t      .withIndex('by_processId_and_updatedAt', (indexQuery) =>\n196\t        indexQuery.eq('processId', processId),\n197\t      )\n198\t      .order('desc')\n199\t      .take(args.limit + decodedCursor + 1);\n200\t\n201\t    const pageWithLookahead = storedViews.slice(decodedCursor);\n202\t    const hasMore = pageWithLookahead.length > args.limit;\n203\t    const pageViews = pageWithLookahead\n204\t      .slice(0, args.limit)\n205\t      .map((storedView) => buildDerivedArchiveView(storedView));\n206\t\n207\t    return {\n208\t      views: pageViews,\n209\t      page: {\n210\t        cursor: args.cursor ?? null,\n211\t        nextCursor: hasMore ? String(decodedCursor + pageViews.length) : null,\n212\t        hasMore,\n213\t      },\n214\t    };\n215\t  },\n216\t});\n217\t\n218\tasync function getProcessRecordOrThrow(\n219\t  ctx: MutationCtx,\n220\t  processIdValue: string,\n221\t  projectId: string,\n222\t): Promise<Doc<'processes'>> {\n223\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n224\t\n225\t  if (processRecord === null) {\n226\t    throw new Error('Process not found.');\n227\t  }\n228\t\n229\t  if (processRecord.projectId !== projectId) {\n230\t    throw new Error('Process does not belong to the requested project.');\n231\t  }\n232\t\n233\t  return processRecord;\n234\t}\n235\t\n236\tfunction buildDerivedArchiveView(record: Doc<'derivedArchiveViews'>): DerivedArchiveView {\n237\t  return {\n238\t    derivedViewId: record.derivedViewId,\n239\t    processId: record.processId,\n240\t    viewKind: record.viewKind,\n241\t    turnRange:\n242\t      record.startTurnIndex === null || record.endTurnIndex === null\n243\t        ? null\n244\t        : {\n245\t            startIndex: record.startTurnIndex,\n246\t            endIndex: record.endTurnIndex,\n247\t          },\n248\t    sourceTurnIds: [...record.sourceTurnIds],\n249\t    sourceArchiveEntryIds: [...record.sourceArchiveEntryIds],\n250\t    title: record.title,\n251\t    bodyText: record.bodyText,\n252\t    viewStatus: record.viewStatus,\n253\t    degradationReason: record.degradationReason,\n254\t    updatedAt: record.updatedAt,\n255\t  };\n256\t}\n257\t\n258\tfunction assertDerivedArchiveView(view: DerivedArchiveView, processId: string): void {\n259\t  if (view.derivedViewId.trim().length === 0) {\n260\t    throw new Error('Derived archive views require a non-empty derivedViewId.');\n261\t  }\n262\t\n263\t  if (view.processId !== processId) {\n264\t    throw new Error('Derived archive view processId must match the enclosing process.');\n265\t  }\n266\t\n267\t  if (view.viewKind === 'turn_range' && view.turnRange === null) {\n268\t    throw new Error('Turn-range views require turnRange metadata.');\n269\t  }\n270\t\n271\t  if (view.turnRange !== null && view.turnRange.endIndex < view.turnRange.startIndex) {\n272\t    throw new Error('Derived archive view turn ranges must end at or after their start index.');\n273\t  }\n274\t\n275\t  if (\n276\t    view.sourceTurnIds.length === 0 ||\n277\t    view.sourceTurnIds.some((turnId) => turnId.trim().length === 0)\n278\t  ) {\n279\t    throw new Error('Derived archive views require at least one non-empty source turn id.');\n280\t  }\n281\t\n282\t  if (\n283\t    view.sourceArchiveEntryIds.length === 0 ||\n284\t    view.sourceArchiveEntryIds.some((archiveEntryId) => archiveEntryId.trim().length === 0)\n285\t  ) {\n286\t    throw new Error(\n287\t      'Derived archive views require at least one non-empty source archive entry id.',\n288\t    );\n289\t  }\n290\t\n291\t  assertOptionalNonEmptyString(view.title, 'Derived archive view title');\n292\t  assertOptionalNonEmptyString(view.bodyText, 'Derived archive view body text');\n293\t\n294\t  if (\n295\t    view.viewStatus === 'degraded' &&\n296\t    (view.degradationReason === null || view.degradationReason.trim().length === 0)\n297\t  ) {\n298\t    throw new Error('Degraded derived archive views must include a degradation reason.');\n299\t  }\n300\t}\n301\t\n302\tfunction assertDerivedViewPageLimit(limit: number): void {\n303\t  if (!Number.isInteger(limit) || limit <= 0 || limit > 50) {\n304\t    throw new Error('Derived archive view page limit must be an integer between 1 and 50.');\n305\t  }\n306\t}\n307\t\n308\tfunction decodeDerivedArchiveViewCursor(cursor: string | null): number {\n309\t  if (cursor == null) {\n310\t    return 0;\n311\t  }\n312\t\n313\t  const parsed = Number.parseInt(cursor, 10);\n314\t  return Number.isNaN(parsed) || parsed < 0 ? 0 : parsed;\n315\t}\n316\t\n317\tfunction assertOptionalNonEmptyString(value: string | null, label: string): void {\n318\t  if (value !== null && value.trim().length === 0) {\n319\t    throw new Error(`${label} must be a non-empty string when provided.`);\n320\t  }\n321\t}\n322\t"}]},"parent_tool_use_id":"toolu_01MLQaCrEnQ196HFMGLH5UZn","session_