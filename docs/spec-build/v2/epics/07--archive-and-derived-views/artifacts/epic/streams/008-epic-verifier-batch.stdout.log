{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S1RWgzjie2ZwZJ3ddc6Ugb","type":"tool_result","content":"1\timport type { ArchivePage } from '../../../shared/contracts/index.js';\n2\timport { archivePageSchema } from '../../../shared/contracts/index.js';\n3\timport { AppError } from '../../errors/app-error.js';\n4\timport { invalidArchiveRequestErrorCode } from '../../errors/codes.js';\n5\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n6\timport type { ProcessAccessService } from '../processes/process-access.service.js';\n7\timport type { PlatformStore } from '../projects/platform-store.js';\n8\timport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\n9\timport { enrichArchiveEntries } from './archive-entry-enrichment.js';\n10\t\n11\tconst DEFAULT_ARCHIVE_PAGE_LIMIT = 100;\n12\tconst MAX_ARCHIVE_PAGE_LIMIT = 200;\n13\t\n14\texport interface ArchiveReadService {\n15\t  getArchive(args: {\n16\t    actor: AuthenticatedActor;\n17\t    projectId: string;\n18\t    processId: string;\n19\t    cursor?: string | null;\n20\t    limit?: number;\n21\t  }): Promise<ArchivePage>;\n22\t}\n23\t\n24\texport class DefaultArchiveReadService implements ArchiveReadService {\n25\t  constructor(\n26\t    private readonly platformStore: Pick<\n27\t      PlatformStore,\n28\t      'getArtifactVersion' | 'listArchiveEntries'\n29\t    > & {\n30\t      listProcessesByIds?: PlatformStore['listProcessesByIds'];\n31\t    },\n32\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n33\t    private readonly sourceProvenanceService?: Pick<\n34\t      SourceProvenanceService,\n35\t      'listProcessSourceProvenance'\n36\t    >,\n37\t  ) {}\n38\t\n39\t  async getArchive(args: {\n40\t    actor: AuthenticatedActor;\n41\t    projectId: string;\n42\t    processId: string;\n43\t    cursor?: string | null;\n44\t    limit?: number;\n45\t  }): Promise<ArchivePage> {\n46\t    await this.processAccessService.assertProcessAccess({\n47\t      actor: args.actor,\n48\t      projectId: args.projectId,\n49\t      processId: args.processId,\n50\t    });\n51\t\n52\t    const cursor = normalizeArchiveCursor(args.cursor);\n53\t    const limit = normalizeArchiveLimit(args.limit);\n54\t    const page = await this.platformStore.listArchiveEntries({\n55\t      processId: args.processId,\n56\t      cursor,\n57\t      limit,\n58\t    });\n59\t    const entries = await enrichArchiveEntries({\n60\t      entries: page.entries,\n61\t      projectId: args.projectId,\n62\t      platformStore: this.platformStore,\n63\t      processId: args.processId,\n64\t      sourceProvenanceService: this.sourceProvenanceService,\n65\t    });\n66\t\n67\t    return archivePageSchema.parse({\n68\t      ...page,\n69\t      entries,\n70\t    });\n71\t  }\n72\t}\n73\t\n74\tfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n75\t  if (cursor === undefined || cursor === null) {\n76\t    return null;\n77\t  }\n78\t\n79\t  if (!/^\\d+$/.test(cursor)) {\n80\t    throw new AppError({\n81\t      code: invalidArchiveRequestErrorCode,\n82\t      message: 'Archive pagination parameters were invalid.',\n83\t      statusCode: 422,\n84\t    });\n85\t  }\n86\t\n87\t  return cursor;\n88\t}\n89\t\n90\tfunction normalizeArchiveLimit(limit: number | undefined): number {\n91\t  if (limit === undefined) {\n92\t    return DEFAULT_ARCHIVE_PAGE_LIMIT;\n93\t  }\n94\t\n95\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_ARCHIVE_PAGE_LIMIT) {\n96\t    throw new AppError({\n97\t      code: invalidArchiveRequestErrorCode,\n98\t      message: 'Archive pagination parameters were invalid.',\n99\t      statusCode: 422,\n100\t    });\n101\t  }\n102\t\n103\t  return limit;\n104\t}\n105\t"}]},"parent_tool_use_id":"toolu_01MLQaCrEnQ196HFMGLH5UZn","session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"2bfe8e6c-4129-4c6a-b1c6-d5e6b841a0b8","timestamp":"2026-05-05T18:52:30.658Z