{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XYvp3atWQdAWmgSkBqZt5u","type":"tool_result","content":"1\timport type { FastifyInstance } from 'fastify';\n2\timport type { ZodTypeProvider } from 'fastify-type-provider-zod';\n3\timport { buildShellBootstrapPayload } from '../config.js';\n4\timport { AppError } from '../errors/app-error.js';\n5\timport {\n6\t  getDerivedArchiveViewsRouteSchema,\n7\t  getProcessArchiveRouteSchema,\n8\t  getProcessArchiveTurnsRouteSchema,\n9\t  postRefreshDerivedArchiveViewsRouteSchema,\n10\t} from '../schemas/archive.js';\n11\timport { sessionCookieName } from '../services/auth/auth-session.service.js';\n12\timport {\n13\t  processArchiveApiPathnamePattern,\n14\t  processArchiveTurnsApiPathnamePattern,\n15\t  processDerivedArchiveViewsApiPathnamePattern,\n16\t  processDerivedArchiveViewsRefreshApiPathnamePattern,\n17\t  processArchiveRoutePathnamePattern,\n18\t  type RequestError,\n19\t} from '../../shared/contracts/index.js';\n20\t\n21\tfunction buildRequestError(error: AppError): RequestError {\n22\t  return {\n23\t    code: error.code as RequestError['code'],\n24\t    message: error.message,\n25\t    status: error.statusCode,\n26\t  };\n27\t}\n28\t\n29\texport const archiveRoutePatterns = {\n30\t  shell: processArchiveRoutePathnamePattern,\n31\t  bootstrap: processArchiveApiPathnamePattern,\n32\t  turns: processArchiveTurnsApiPathnamePattern,\n33\t  derivedViews: processDerivedArchiveViewsApiPathnamePattern,\n34\t  refreshDerivedViews: processDerivedArchiveViewsRefreshApiPathnamePattern,\n35\t} as const;\n36\t\n37\tfunction buildLoginRedirectPath(returnTo: string): string {\n38\t  return `/auth/login?returnTo=${encodeURIComponent(returnTo)}`;\n39\t}\n40\t\n41\tfunction renderUnavailableShell(title: string, message: string): string {\n42\t  return `<!doctype html>\n43\t<html lang=\"en\">\n44\t  <head>\n45\t    <meta charset=\"utf-8\" />\n46\t    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n47\t    <title>${title}</title>\n48\t  </head>\n49\t  <body>\n50\t    <main>\n51\t      <h1>${title}</h1>\n52\t      <p>${message}</p>\n53\t    </main>\n54\t  </body>\n55\t</html>`;\n56\t}\n57\t\n58\texport async function registerArchiveRoutes(app: FastifyInstance): Promise<void> {\n59\t  void archiveRoutePatterns;\n60\t\n61\t  const typedApp = app.withTypeProvider<ZodTypeProvider>();\n62\t\n63\t  typedApp.get(\n64\t    '/projects/:projectId/processes/:processId/archive',\n65\t    {\n66\t      schema: {\n67\t        params: getProcessArchiveRouteSchema.params,\n68\t      },\n69\t    },\n70\t    async (request, reply) => {\n71\t      if (request.actor === null) {\n72\t        if (request.authFailureReason === 'invalid_session') {\n73\t          reply.clearCookie(sessionCookieName, { path: '/' });\n74\t        }\n75\t\n76\t        return reply.redirect(buildLoginRedirectPath(request.url));\n77\t      }\n78\t\n79\t      const access = await app.processAccessService.getProcessAccess({\n80\t        actor: request.actor,\n81\t        projectId: request.params.projectId,\n82\t        processId: request.params.processId,\n83\t      });\n84\t\n85\t      if (access.kind === 'forbidden') {\n86\t        return reply\n87\t          .code(403)\n88\t          .type('text/html')\n89\t          .send(renderUnavailableShell('Access denied', 'You do not have access to this process.'));\n90\t      }\n91\t\n92\t      if (access.kind === 'project_not_found') {\n93\t        return reply\n94\t          .code(404)\n95\t          .type('text/html')\n96\t          .send(\n97\t            renderUnavailableShell(\n98\t              'Project not found',\n99\t              'The requested project could not be found.',\n100\t            ),\n101\t          );\n102\t      }\n103\t\n104\t      if (access.kind === 'process_not_found') {\n105\t        return reply\n106\t          .code(404)\n107\t          .type('text/html')\n108\t          .send(\n109\t            renderUnavailableShell(\n110\t              'Process unavailable',\n111\t              'The requested process archive could not be opened.',\n112\t            ),\n113\t          );\n114\t      }\n115\t\n116\t      const url = new URL(request.url, 'http://story3.local');\n117\t      const payload = buildShellBootstrapPayload({\n118\t        actor: {\n119\t          id: request.actor.userId,\n120\t          email: request.actor.email,\n121\t          displayName: request.actor.displayName,\n122\t        },\n123\t        pathname: `/projects/${request.params.projectId}/processes/${request.params.processId}/archive`,\n124\t        search: url.search,\n125\t        csrfToken: reply.generateCsrf(),\n126\t      });\n127\t\n128\t      return reply.type('text/html').send(await app.renderShellDocument(payload, request.url));\n129\t    },\n130\t  );\n131\t\n132\t  typedApp.get(\n133\t    '/api/projects/:projectId/processes/:processId/archive/turns',\n134\t    {\n135\t      schema: getProcessArchiveTurnsRouteSchema,\n136\t    },\n137\t    async (request, reply) => {\n138\t      if (request.actor === null) {\n139\t        if (request.authFailureReason === 'invalid_session') {\n140\t          reply.clearCookie(sessionCookieName, { path: '/' });\n141\t        }\n142\t\n143\t        return reply.code(401).send({\n144\t          code: 'UNAUTHENTICATED',\n145\t          message: 'Authenticated access is required.',\n146\t          status: 401,\n147\t        });\n148\t      }\n149\t\n150\t      try {\n151\t        const turns = await app.turnDerivationService.getTurns({\n152\t          actor: request.actor,\n153\t          projectId: request.params.projectId,\n154\t          processId: request.params.processId,\n155\t          cursor: request.query.cursor,\n156\t          limit: request.query.limit,\n157\t        });\n158\t\n159\t        return reply.code(200).send(turns);\n160\t      } catch (error) {\n161\t        if (error instanceof AppError) {\n162\t          const statusCode = error.statusCode as 403 | 404 | 422;\n163\t\n164\t          return reply.code(statusCode).send(buildRequestError(error));\n165\t        }\n166\t\n167\t        throw error;\n168\t      }\n169\t    },\n170\t  );\n171\t\n172\t  typedApp.get(\n173\t    '/api/projects/:projectId/processes/:processId/archive/derived-views',\n174\t    {\n175\t      schema: getDerivedArchiveViewsRouteSchema,\n176\t    },\n177\t    async (request, reply) => {\n178\t      if (request.actor === null) {\n179\t        if (request.authFailureReason === 'invalid_session') {\n180\t          reply.clearCookie(sessionCookieName, { path: '/' });\n181\t        }\n182\t\n183\t        return reply.code(401).send({\n184\t          code: 'UNAUTHENTICATED',\n185\t          message: 'Authenticated access is required.',\n186\t          status: 401,\n187\t        });\n188\t      }\n189\t\n190\t      try {\n191\t        const response = await app.derivedArchiveViewService.listViews({\n192\t          actor: request.actor,\n193\t          projectId: request.params.projectId,\n194\t          processId: request.params.processId,\n195\t          cursor: request.query.cursor,\n196\t          limit: request.query.limit,\n197\t        });\n198\t\n199\t        return reply.code(200).send(response);\n200\t      } catch (error) {\n201\t        if (error instanceof AppError) {\n202\t          const statusCode = error.statusCode as 403 | 404 | 422;\n203\t\n204\t          return reply.code(statusCode).send(buildRequestError(error));\n205\t        }\n206\t\n207\t        throw error;\n208\t      }\n209\t    },\n210\t  );\n211\t\n212\t  typedApp.post(\n213\t    '/api/projects/:projectId/processes/:processId/archive/derived-views/refresh',\n214\t    {\n215\t      schema: postRefreshDerivedArchiveViewsRouteSchema,\n216\t    },\n217\t    async (request, reply) => {\n218\t      if (request.actor === null) {\n219\t        if (request.authFailureReason === 'invalid_session') {\n220\t          reply.clearCookie(sessionCookieName, { path: '/' });\n221\t        }\n222\t\n223\t        return reply.code(401).send({\n224\t          code: 'UNAUTHENTICATED',\n225\t          message: 'Authenticated access is required.',\n226\t          status: 401,\n227\t        });\n228\t      }\n229\t\n230\t      try {\n231\t        const response = await app.derivedArchiveViewService.refreshViews({\n232\t          actor: request.actor,\n233\t          projectId: request.params.projectId,\n234\t          processId: request.params.processId,\n235\t        });\n236\t\n237\t        return reply.code(200).send(response);\n238\t      } catch (error) {\n239\t        if (error instanceof AppError) {\n240\t          const statusCode = error.statusCode as 403 | 404 | 409 | 422;\n241\t\n242\t          return reply.code(statusCode).send(buildRequestError(error));\n243\t        }\n244\t\n245\t        throw error;\n246\t      }\n247\t    },\n248\t  );\n249\t\n250\t  typedApp.get(\n251\t    '/api/projects/:projectId/processes/:processId/archive',\n252\t    {\n253\t      schema: getProcessArchiveRouteSchema,\n254\t    },\n255\t    async (request, reply) => {\n256\t      if (request.actor === null) {\n257\t        if (request.authFailureReason === 'invalid_session') {\n258\t          reply.clearCookie(sessionCookieName, { path: '/' });\n259\t        }\n260\t\n261\t        return reply.code(401).send({\n262\t          code: 'UNAUTHENTICATED',\n263\t          message: 'Authenticated access is required.',\n264\t          status: 401,\n265\t        });\n266\t      }\n267\t\n268\t      try {\n269\t        const archive = await app.archiveReadService.getArchive({\n270\t          actor: request.actor,\n271\t          projectId: request.params.projectId,\n272\t          processId: request.params.processId,\n273\t          cursor: request.query.cursor,\n274\t          limit: request.query.limit,\n275\t        });\n276\t\n277\t        return reply.code(200).send(archive);\n278\t      } catch (error) {\n279\t        if (error instanceof AppError) {\n280\t          const statusCode = error.statusCode as 403 | 404 | 422;\n281\t\n282\t          return reply.code(statusCode).send(buildRequestError(error));\n283\t        }\n284\t\n285\t        throw error;\n286\t      }\n287\t    },\n288\t  );\n289\t}\n290\t"}]},"parent_tool_use_id":null,"session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"e01f9fbe-2c86-410f-aead-770a8f027b97","timestamp":"2026-05-05T18:53:50.662Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/routes/archive.ts","content":"import type { FastifyInstance } from 'fastify';\nimport type { ZodTypeProvider } from 'fastify-type-provider-zod';\nimport { buildShellBootstrapPayload } from '../config.js';\nimport { AppError } from '../errors/app-error.js';\nimport {\n  getDerivedArchiveViewsRouteSchema,\n  getProcessArchiveRouteSchema,\n  getProcessArchiveTurnsRouteSchema,\n  postRefreshDerivedArchiveViewsRouteSchema,\n} from '../schemas/archive.js';\nimport { sessionCookieName } from '../services/auth/auth-session.service.js';\nimport {\n  processArchiveApiPathnamePattern,\n  processArchiveTurnsApiPathnamePattern,\n  processDerivedArchiveViewsApiPathnamePattern,\n  processDerivedArchiveViewsRefreshApiPathnamePattern,\n  processArchiveRoutePathnamePattern,\n  type RequestError,\n} from '../../shared/contracts/index.js';\n\nfunction buildRequestError(error: AppError): RequestError {\n  return {\n    code: error.code as RequestError['code'],\n    message: error.message,\n    status: error.statusCode,\n  };\n}\n\nexport const archiveRoutePatterns = {\n  shell: processArchiveRoutePathnamePattern,\n  bootstrap: processArchiveApiPathnamePattern,\n  turns: processArchiveTurnsApiPathnamePattern,\n  derivedViews: processDerivedArchiveViewsApiPathnamePattern,\n  refreshDerivedViews: processDerivedArchiveViewsRefreshApiPathnamePattern,\n} as const;\n\nfunction buildLoginRedirectPath(returnTo: string): string {\n  return `/auth/login?returnTo=${encodeURIComponent(returnTo)}`;\n}\n\nfunction renderUnavailableShell(title: string, message: string): string {\n  return `<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>${title}</title>\n  </head>\n  <body>\n    <main>\n      <h1>${title}</h1>\n      <p>${message}</p>\n    </main>\n  </body>\n</html>`;\n}\n\nexport async function registerArchiveRoutes(app: FastifyInstance): Promise<void> {\n  void archiveRoutePatterns;\n\n  const typedApp = app.withTypeProvider<ZodTypeProvider>();\n\n  typedApp.get(\n    '/projects/:projectId/processes/:processId/archive',\n    {\n      schema: {\n        params: getProcessArchiveRouteSchema.params,\n      },\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.redirect(buildLoginRedirectPath(request.url));\n      }\n\n      const access = await app.processAccessService.getProcessAccess({\n        actor: request.actor,\n        projectId: request.params.projectId,\n        processId: request.params.processId,\n      });\n\n      if (access.kind === 'forbidden') {\n        return reply\n          .code(403)\n          .type('text/html')\n          .send(renderUnavailableShell('Access denied', 'You do not have access to this process.'));\n      }\n\n      if (access.kind === 'project_not_found') {\n        return reply\n          .code(404)\n          .type('text/html')\n          .send(\n            renderUnavailableShell(\n              'Project not found',\n              'The requested project could not be found.',\n            ),\n          );\n      }\n\n      if (access.kind === 'process_not_found') {\n        return reply\n          .code(404)\n          .type('text/html')\n          .send(\n            renderUnavailableShell(\n              'Process unavailable',\n              'The requested process archive could not be opened.',\n            ),\n          );\n      }\n\n      const url = new URL(request.url, 'http://story3.local');\n      const payload = buildShellBootstrapPayload({\n        actor: {\n          id: request.actor.userId,\n          email: request.actor.email,\n          displayName: request.actor.displayName,\n        },\n        pathname: `/projects/${request.params.projectId}/processes/${request.params.processId}/archive`,\n        search: url.search,\n        csrfToken: reply.generateCsrf(),\n      });\n\n      return reply.type('text/html').send(await app.renderShellDocument(payload, request.url));\n    },\n  );\n\n  typedApp.get(\n    '/api/projects/:projectId/processes/:processId/archive/turns',\n    {\n      schema: getProcessArchiveTurnsRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const turns = await app.turnDerivationService.getTurns({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n          cursor: request.query.cursor,\n          limit: request.query.limit,\n        });\n\n        return reply.code(200).send(turns);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n\n  typedApp.get(\n    '/api/projects/:projectId/processes/:processId/archive/derived-views',\n    {\n      schema: getDerivedArchiveViewsRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const response = await app.derivedArchiveViewService.listViews({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n          cursor: request.query.cursor,\n          limit: request.query.limit,\n        });\n\n        return reply.code(200).send(response);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n\n  typedApp.post(\n    '/api/projects/:projectId/processes/:processId/archive/derived-views/refresh',\n    {\n      schema: postRefreshDerivedArchiveViewsRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const response = await app.derivedArchiveViewService.refreshViews({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n        });\n\n        return reply.code(200).send(response);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 409 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n\n  typedApp.get(\n    '/api/projects/:projectId/processes/:processId/archive',\n    {\n      schema: getProcessArchiveRouteSchema,\n    },\n    async (request, reply) => {\n      if (request.actor === null) {\n        if (request.authFailureReason === 'invalid_session') {\n          reply.clearCookie(sessionCookieName, { path: '/' });\n        }\n\n        return reply.code(401).send({\n          code: 'UNAUTHENTICATED',\n          message: 'Authenticated access is required.',\n          status: 401,\n        });\n      }\n\n      try {\n        const archive = await app.archiveReadService.getArchive({\n          actor: request.actor,\n          projectId: request.params.projectId,\n          processId: request.params.processId,\n          cursor: request.query.cursor,\n          limit: request.query.limit,\n        });\n\n        return reply.code(200).send(archive);\n      } catch (error) {\n        if (error instanceof AppError) {\n          const statusCode = error.statusCode as 403 | 404 | 422;\n\n          return reply.code(statusCode).send(buildRequestError(error));\n        }\n\n        throw error;\n      }\n    },\n  );\n}\n","numLines":290,"startLine":1,"totalLines":290}}}
