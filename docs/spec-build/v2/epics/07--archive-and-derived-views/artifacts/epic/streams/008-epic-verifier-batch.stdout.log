{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P5aU2kw5LoEAhxxCXVgERt","type":"tool_result","content":"1\timport type {\n2\t  ArchiveEntry,\n3\t  ArchivePage,\n4\t  ArchiveTurnPage,\n5\t  DerivedTurn,\n6\t} from '../../../shared/contracts/index.js';\n7\timport { archiveTurnPageSchema } from '../../../shared/contracts/index.js';\n8\timport { AppError } from '../../errors/app-error.js';\n9\timport { invalidArchiveRequestErrorCode } from '../../errors/codes.js';\n10\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n11\timport type { ProcessAccessService } from '../processes/process-access.service.js';\n12\timport type { PlatformStore } from '../projects/platform-store.js';\n13\timport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\n14\timport { enrichArchiveEntries } from './archive-entry-enrichment.js';\n15\t\n16\tconst DEFAULT_TURN_PAGE_LIMIT = 50;\n17\tconst MAX_TURN_PAGE_LIMIT = 100;\n18\tconst ARCHIVE_REBUILD_PAGE_LIMIT = 200;\n19\t\n20\ttype DraftTurn = {\n21\t  archiveEntryIds: string[];\n22\t  degradationReasons: string[];\n23\t  endedAt: string;\n24\t  processId: string;\n25\t  startedAt: string;\n26\t  turnId: string;\n27\t  turnIndex: number;\n28\t};\n29\t\n30\texport interface TurnDerivationService {\n31\t  rebuildTurns(args: { projectId: string; processId: string }): Promise<DerivedTurn[]>;\n32\t  getTurns(args: {\n33\t    actor: AuthenticatedActor;\n34\t    projectId: string;\n35\t    processId: string;\n36\t    cursor?: string | null;\n37\t    limit?: number;\n38\t  }): Promise<ArchiveTurnPage>;\n39\t}\n40\t\n41\texport class DefaultTurnDerivationService implements TurnDerivationService {\n42\t  constructor(\n43\t    private readonly platformStore: Pick<\n44\t      PlatformStore,\n45\t      'getArtifactVersion' | 'listArchiveEntries' | 'listArchiveTurns' | 'upsertArchiveTurns'\n46\t    >,\n47\t    private readonly processAccessService: Pick<ProcessAccessService, 'assertProcessAccess'>,\n48\t    private readonly sourceProvenanceService?: Pick<\n49\t      SourceProvenanceService,\n50\t      'listProcessSourceProvenance'\n51\t    >,\n52\t  ) {}\n53\t\n54\t  async rebuildTurns(args: { projectId: string; processId: string }): Promise<DerivedTurn[]> {\n55\t    const entries = await listAllArchiveEntries(this.platformStore, args.processId);\n56\t    const enrichedEntries = await enrichArchiveEntries({\n57\t      entries,\n58\t      projectId: args.projectId,\n59\t      processId: args.processId,\n60\t      platformStore: this.platformStore,\n61\t      sourceProvenanceService: this.sourceProvenanceService,\n62\t    });\n63\t    const turns = deriveTurnsFromArchiveEntries(enrichedEntries, args.processId);\n64\t\n65\t    await this.platformStore.upsertArchiveTurns({\n66\t      projectId: args.projectId,\n67\t      processId: args.processId,\n68\t      turns,\n69\t    });\n70\t\n71\t    return turns;\n72\t  }\n73\t\n74\t  async getTurns(args: {\n75\t    actor: AuthenticatedActor;\n76\t    projectId: string;\n77\t    processId: string;\n78\t    cursor?: string | null;\n79\t    limit?: number;\n80\t  }): Promise<ArchiveTurnPage> {\n81\t    await this.processAccessService.assertProcessAccess({\n82\t      actor: args.actor,\n83\t      projectId: args.projectId,\n84\t      processId: args.processId,\n85\t    });\n86\t\n87\t    const cursor = normalizeTurnCursor(args.cursor);\n88\t    const limit = normalizeTurnLimit(args.limit);\n89\t    const storedPage = await this.platformStore.listArchiveTurns({\n90\t      processId: args.processId,\n91\t      cursor,\n92\t      limit,\n93\t    });\n94\t\n95\t    if (cursor !== null) {\n96\t      return archiveTurnPageSchema.parse(storedPage);\n97\t    }\n98\t\n99\t    if (storedPage.turns.length > 0) {\n100\t      return archiveTurnPageSchema.parse(storedPage);\n101\t    }\n102\t\n103\t    if (await hasStoredTurns(this.platformStore, args.processId)) {\n104\t      return archiveTurnPageSchema.parse(storedPage);\n105\t    }\n106\t\n107\t    if (!(await hasArchiveEntries(this.platformStore, args.processId))) {\n108\t      return archiveTurnPageSchema.parse(storedPage);\n109\t    }\n110\t\n111\t    await this.warmTurnsCacheOnMiss({\n112\t      projectId: args.projectId,\n113\t      processId: args.processId,\n114\t    });\n115\t\n116\t    const rebuiltPage = await this.platformStore.listArchiveTurns({\n117\t      processId: args.processId,\n118\t      cursor,\n119\t      limit,\n120\t    });\n121\t\n122\t    return archiveTurnPageSchema.parse(rebuiltPage);\n123\t  }\n124\t\n125\t  private async warmTurnsCacheOnMiss(args: {\n126\t    projectId: string;\n127\t    processId: string;\n128\t  }): Promise<void> {\n129\t    await this.rebuildTurns(args);\n130\t  }\n131\t}\n132\t\n133\tasync function hasStoredTurns(\n134\t  platformStore: Pick<PlatformStore, 'listArchiveTurns'>,\n135\t  processId: string,\n136\t): Promise<boolean> {\n137\t  const firstPage = await platformStore.listArchiveTurns({\n138\t    processId,\n139\t    cursor: null,\n140\t    limit: 1,\n141\t  });\n142\t\n143\t  return firstPage.turns.length > 0;\n144\t}\n145\t\n146\tasync function hasArchiveEntries(\n147\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n148\t  processId: string,\n149\t): Promise<boolean> {\n150\t  const firstPage = await platformStore.listArchiveEntries({\n151\t    processId,\n152\t    cursor: null,\n153\t    limit: 1,\n154\t  });\n155\t\n156\t  return firstPage.entries.length > 0;\n157\t}\n158\t\n159\tasync function listAllArchiveEntries(\n160\t  platformStore: Pick<PlatformStore, 'listArchiveEntries'>,\n161\t  processId: string,\n162\t): Promise<ArchiveEntry[]> {\n163\t  const entries: ArchiveEntry[] = [];\n164\t  let cursor: string | null = null;\n165\t\n166\t  for (;;) {\n167\t    const page: ArchivePage = await platformStore.listArchiveEntries({\n168\t      processId,\n169\t      cursor,\n170\t      limit: ARCHIVE_REBUILD_PAGE_LIMIT,\n171\t    });\n172\t    entries.push(...page.entries);\n173\t\n174\t    if (!page.page.hasMore || page.page.nextCursor === null) {\n175\t      break;\n176\t    }\n177\t\n178\t    cursor = page.page.nextCursor;\n179\t  }\n180\t\n181\t  return entries.sort((left, right) => left.sequence - right.sequence);\n182\t}\n183\t\n184\texport function deriveTurnsFromArchiveEntries(\n185\t  entries: ArchiveEntry[],\n186\t  processId: string,\n187\t): DerivedTurn[] {\n188\t  const drafts: DraftTurn[] = [];\n189\t  const toolCallTurnIndexes = new Map<string, number>();\n190\t  let activeTurn: DraftTurn | null = null;\n191\t\n192\t  const createTurn = (): DraftTurn => {\n193\t    const turnIndex = drafts.length;\n194\t    const nextTurn: DraftTurn = {\n195\t      archiveEntryIds: [],\n196\t      degradationReasons: [],\n197\t      endedAt: '',\n198\t      processId,\n199\t      startedAt: '',\n200\t      turnId: `${processId}:turn:${turnIndex}`,\n201\t      turnIndex,\n202\t    };\n203\t    drafts.push(nextTurn);\n204\t    activeTurn = nextTurn;\n205\t    return nextTurn;\n206\t  };\n207\t\n208\t  const ensureActiveTurn = (): DraftTurn => activeTurn ?? createTurn();\n209\t\n210\t  const attachEntry = (turn: DraftTurn, entry: ArchiveEntry): void => {\n211\t    turn.archiveEntryIds.push(entry.archiveEntryId);\n212\t    if (turn.startedAt.length === 0 || entry.recordedAt < turn.startedAt) {\n213\t      turn.startedAt = entry.recordedAt;\n214\t    }\n215\t    if (turn.endedAt.length === 0 || entry.recordedAt > turn.endedAt) {\n216\t      turn.endedAt = entry.recordedAt;\n217\t    }\n218\t\n219\t    if (entry.entryStatus === 'degraded') {\n220\t      addDegradationReason(\n221\t        turn,\n222\t        entry.degradationReason ?? `Archive entry ${entry.archiveEntryId} is degraded.`,\n223\t      );\n224\t    }\n225\t  };\n226\t\n227\t  for (const entry of entries) {\n228\t    if (entry.entryKind === 'user_message') {\n229\t      const lastDraft = drafts[drafts.length - 1];\n230\t      const hasActiveEntries = lastDraft !== undefined && lastDraft.archiveEntryIds.length > 0;\n231\t      const targetTurn = hasActiveEntries ? createTurn() : ensureActiveTurn();\n232\t      attachEntry(targetTurn, entry);\n233\t      continue;\n234\t    }\n235\t\n236\t    if (entry.entryKind === 'tool_result') {\n237\t      const correlationKey = entry.relatedToolCallId ?? entry.sourceObjectId;\n238\t      if (correlationKey !== null) {\n239\t        const correlatedTurnIndex = toolCallTurnIndexes.get(correlationKey);\n240\t        if (correlatedTurnIndex !== undefined) {\n241\t          const correlatedTurn = drafts[correlatedTurnIndex];\n242\t          if (correlatedTurn !== undefined) {\n243\t            attachEntry(correlatedTurn, entry);\n244\t            continue;\n245\t          }\n246\t        }\n247\t      }\n248\t\n249\t      const fallbackTurn = ensureActiveTurn();\n250\t      attachEntry(fallbackTurn, entry);\n251\t      addDegradationReason(\n252\t        fallbackTurn,\n253\t        correlationKey === null\n254\t          ? `Tool result ${entry.archiveEntryId} is missing related tool-call context.`\n255\t          : `Tool result ${entry.archiveEntryId} could not match tool call ${correlationKey}.`,\n256\t      );\n257\t      continue;\n258\t    }\n259\t\n260\t    const targetTurn = ensureActiveTurn();\n261\t    attachEntry(targetTurn, entry);\n262\t\n263\t    if (entry.entryKind === 'tool_call') {\n264\t      const correlationKey = entry.relatedToolCallId ?? entry.sourceObjectId;\n265\t      if (correlationKey !== null) {\n266\t        toolCallTurnIndexes.set(correlationKey, targetTurn.turnIndex);\n267\t      } else {\n268\t        addDegradationReason(\n269\t          targetTurn,\n270\t          `Tool call ${entry.archiveEntryId} is missing stable correlation metadata.`,\n271\t        );\n272\t      }\n273\t    }\n274\t  }\n275\t\n276\t  return drafts.map((draft) => ({\n277\t    turnId: draft.turnId,\n278\t    processId: draft.processId,\n279\t    turnIndex: draft.turnIndex,\n280\t    archiveEntryIds: draft.archiveEntryIds,\n281\t    startedAt: draft.startedAt,\n282\t    endedAt: draft.endedAt,\n283\t    turnStatus: draft.degradationReasons.length > 0 ? 'degraded' : 'ready',\n284\t    degradationReason:\n285\t      draft.degradationReasons.length > 0 ? draft.degradationReasons.join(' ') : null,\n286\t  }));\n287\t}\n288\t\n289\tfunction addDegradationReason(turn: DraftTurn, reason: string): void {\n290\t  if (turn.degradationReasons.includes(reason)) {\n291\t    return;\n292\t  }\n293\t\n294\t  turn.degradationReasons.push(reason);\n295\t}\n296\t\n297\tfunction normalizeTurnCursor(cursor: string | null | undefined): string | null {\n298\t  if (cursor === undefined || cursor === null) {\n299\t    return null;\n300\t  }\n301\t\n302\t  if (!/^\\d+$/.test(cursor)) {\n303\t    throw new AppError({\n304\t      code: invalidArchiveRequestErrorCode,\n305\t      message: 'Archive pagination parameters were invalid.',\n306\t      statusCode: 422,\n307\t    });\n308\t  }\n309\t\n310\t  return cursor;\n311\t}\n312\t\n313\tfunction normalizeTurnLimit(limit: number | undefined): number {\n314\t  if (limit === undefined) {\n315\t    return DEFAULT_TURN_PAGE_LIMIT;\n316\t  }\n317\t\n318\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_TURN_PAGE_LIMIT) {\n319\t    throw new AppError({\n320\t      code: invalidArchiveRequestErrorCode,\n321\t      message: 'Archive pagination parameters were invalid.',\n322\t      statusCode: 422,\n323\t    });\n324\t  }\n325\t\n326\t  return limit;\n327\t}\n328\t"}]},"parent_tool_use_id":"toolu_01MLQaCrEnQ196HFMGLH5UZn","session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"8b867dce-fd89-45d6-971d-6dea411fecf4","timestamp":"2026-05-05T18:52:30.843Z"}
