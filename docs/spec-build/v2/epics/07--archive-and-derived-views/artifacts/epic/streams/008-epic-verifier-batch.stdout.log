',\n   179\t] as const satisfies readonly ProcessSurfaceControlActionId[];\n   180\t\n   181\texport const defaultProcessSurfaceControlLabels = {\n   182\t  start: 'Start process',\n   183\t  respond: 'Respond',\n   184\t  resume: 'Resume process',\n   185\t  rehydrate: 'Rehydrate environment',\n   186\t  rebuild: 'Rebuild environment',\n   187\t  review: 'Review',\n   188\t  restart: 'Restart process',\n   189\t} as const satisfies Record<ProcessSurfaceControlActionId, string>;\n   190\t\n   191\texport function buildProcessSurfaceControls(args: {\n   192\t  availableActions: readonly ProcessSurfaceAvailableAction[];\n   193\t  disabledReasons?: Partial<Record<ProcessSurfaceControlActionId, string>>;\n   194\t  labels?: Partial<Record<ProcessSurfaceControlActionId, string>>;\n   195\t}): ProcessSurfaceControlState[] {\n   196\t  const availableActions = new Set(args.availableActions);\n   197\t\n   198\t  return processSurfaceControlOrder.map((actionId) => {\n   199\t    const disabledReason = args.disabledReasons?.[actionId] ?? null;\n   200\t\n   201\t    return processSurfaceControlStateSchema.parse({\n   202\t      actionId,\n   203\t      enabled: availableActions.has(actionId) && disabledReason === null,\n   204\t      disabledReason,\n   205\t      label: args.labels?.[actionId] ?? defaultProcessSurfaceControlLabels[actionId],\n   206\t    });\n   207\t  });\n   208\t}\n   209\t\n   210\texport const defaultProcessSurfaceControls = buildProcessSurfaceControls({\n   211\t  availableActions: [],\n   212\t});\n   213\t\n   214\texport const lastCheckpointResultSchema = z.object({\n   215\t  checkpointId: z.string().min(1),\n   216\t  checkpointKind: checkpointKindSchema,\n   217\t  outcome: checkpointOutcomeSchema,\n   218\t  targetLabel: z.string().min(1),\n   219\t  targetRef: z.string().min(1).nullable().default(null),\n   220\t  completedAt: z.string().min(1),\n","exit_code":0,"status":"completed"}}
