v.string(), v.null()),\n47\t  recordedAt: v.string(),\n48\t};\n49\t\n50\tconst archiveEntryWriteArgsValidator = {\n51\t  projectId: v.string(),\n52\t  processId: v.string(),\n53\t  entryKind: archiveEntryKindValidator,\n54\t  finalizationKey: v.string(),\n55\t  sourceObjectId: v.optional(v.union(v.string(), v.null())),\n56\t  bodyText: v.optional(v.union(v.string(), v.null())),\n57\t  bodyData: v.optional(v.union(archiveEntryBodyDataValidator, v.null())),\n58\t  bodyFormat: archiveBodyFormatValidator,\n59\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n60\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n61\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n62\t  entryStatus: v.optional(archiveEntryStatusValidator),\n63\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n64\t  recordedAt: v.optional(v.string()),\n65\t} as const;\n66\t\n67\tconst archiveListArgsValidator = {\n68\t  processId: v.string(),\n69\t  cursor: v.optional(v.union(v.string(), v.null())),\n70\t  limit: v.number(),\n71\t} as const;\n72\t\n73\tconst archivePatchArgsValidator = {\n74\t  processId: v.string(),\n75\t  finalizationKey: v.string(),\n76\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n77\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n78\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n79\t  entryStatus: v.optional(archiveEntryStatusValidator),\n80\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n81\t} as const;\n82\t\n83\tconst MAX_ARCHIVE_PAGE_SIZE = 200;\n84\tconst supportedArchiveEntryKinds = new Set([\n85\t  'user_message',\n86\t  'model_message',\n87\t  'reasoning',\n88\t  'script_emission',\n89\t  'tool_call',\n90\t  'tool_result',\n91\t  'process_event',\n92\t] satisfies ArchiveEntry['entryKind'][]);\n93\t\n94\texport const appendArchiveEntry = mutation({\n95\t  args: archiveEntryWriteArgsValidator,\n96\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry> => {\n97\t    assertArchiveEntryInput(args);\n98\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n99\t    const existingEntry = await ctx.db\n100\t      .query('archiveEntries')\n101\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n102\t        indexQuery.eq('processId', processRecord._id).eq('finalizationKey', args.finalizationKey),\n103\t      )\n104\t      .unique();\n105\t\n106\t    if (existingEntry !== null) {\n107\t      return buildArchiveEntry(existingEntry);\n108\t    }\n109\t\n110\t    const mostRecentEntry = await ctx.db\n111\t      .query('archiveEntries')\n112\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n113\t        indexQuery.eq('processId', processRecord._id),\n114\t      )\n115\t      .order('desc')\n116\t      .take(1);\n117\t    const nextSequence = (mostRecentEntry[0]?.sequence ?? -1) + 1;\n118\t    const archiveEntryId = await ctx.db.insert('archiveEntries', {\n119\t      projectId: args.projectId,\n120\t      processId: processRecord._id,\n121\t      entryKind: args.entryKind,\n122\t      sequence: nextSequence,\n123\t      lifecycleState: 'finalized',\n124\t      finalizationKey: args.finalizationKey,\n125\t      sourceObjectId: args.sourceObjectId ?? null,\n126\t      bodyText: args.bodyText ?? null,\n127\t      bodyData: args.bodyData ?? null,\n128\t      bodyFormat: args.bodyFormat,\n129\t      relatedArtifactVersionId:\n130\t        args.relatedArtifactVersionId === undefined || args.relatedArtifactVersionId === null\n131\t          ? null\n132\t          : (args.relatedArtifactVersionId as Id<'artifactVersions'>),\n133\t      relatedSourceProvenanceId: args.relatedSourceProvenanceId ?? null,\n134\t      relatedToolCallId: args.relatedToolCallId ?? null,\n135\t      entryStatus: args.entryStatus ?? 'ready',\n136\t      degradationReason: args.degradationReason ?? null,\n137\t      recordedAt: args.recordedAt ?? new Date().toISOString(),\n138\t    });\n139\t    await invalidateArchiveDerivedCaches(ctx, processRecord._id);\n140\t    const storedEntry = await ctx.db.get(archiveEntryId);\n141\t\n142\t    if (storedEntry === null) {\n143\t      throw new Error('Archive entry was not found after append.');\n144\t    }\n145\t\n146\t    return buildArchiveEntry(storedEntry);\n147\t  },\n148\t});\n149\t\n150\texport const listArchiveEntries = query({\n151\t  args: archiveListArgsValidator,\n152\t  handler: async (ctx: QueryCtx, args): Promise<ArchivePage> => {\n153\t    assertArchivePageLimit(args.limit);\n154\t    const processId = args.processId as Id<'processes'>;\n155\t    const decodedCursor = decodeArchiveCursor(args.cursor ?? null);\n156\t    const pageWithLookahead = await ctx.db\n157\t      .query('archiveEntries')\n158\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n159\t        decodedCursor === null\n160\t          ? indexQuery.eq('processId', processId)\n161\t          : indexQuery.eq('processId', processId).gt('sequence', decodedCursor),\n162\t      )\n163\t      .order('asc')\n164\t      .take(args.limit + 1);\n165\t    const hasMore = pageWithLookahead.length > args.limit;\n166\t    const pageEntries = pageWithLookahead\n167\t      .slice(0, args.limit)\n168\t      .map((entry) => buildArchiveEntry(entry));\n169\t    const lastEntry = pageEntries.at(-1);\n170\t\n171\t    return {\n172\t      entries: pageEntries,\n173\t      page: {\n174\t        cursor: args.cursor ?? null,\n175\t        nextCursor: hasMore && lastEntry !== undefined ? String(lastEntry.sequence) : null,\n176\t        hasMore,\n177\t      },\n178\t    };\n179\t  },\n180\t});\n181\t\n182\texport const patchArchiveEntry = mutation({\n183\t  args: archivePatchArgsValidator,\n184\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry | null> => {\n185\t    if (args.finalizationKey.trim().length === 0) {\n186\t      throw new Error('Archive entries require a non-empty finalization key.');\n187\t    }\n188\t\n189\t    assertOptionalNonEmptyString(args.relatedArtifactVersionId, 'Related artifact version id');\n190\t    assertOptionalNonEmptyString(args.relatedSourceProvenanceId, 'Related source provenance id');\n191\t    assertOptionalNonEmptyString(args.relatedToolCallId, 'Related tool call id');\n192\t\n193\t    const processId = args.processId as Id<'processes'>;\n194\t    const existingEntry = await ctx.db\n195\t      .query('archiveEntries')\n196\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n197\t        indexQuery.eq('processId', processId).eq('finalizationKey', args.finalizationKey),\n198\t      )\n199\t      .unique();\n200\t\n201\t    if (existingEntry === null) {\n202\t      return null;\n203\t    }\n204\t\n205\t    await ctx.db.patch(existingEntry._id, {\n206\t      relatedArtifactVersionId:\n207\t        args.relatedArtifactVersionId === undefined\n208\t          ? existingEntry.relatedArtifactVersionId\n209\t          : args.relatedArtifactVersionId === null\n210\t            ? null\n211\t            : (args.relatedArtifactVersionId as Id<'artifactVersions'>),\n212\t      relatedSourceProvenanceId:\n213\t        args.relatedSourceProvenanceId === undefined\n214\t          ? existingEntry.relatedSourceProvenanceId\n215\t          : args.relatedSourceProvenanceId,\n216\t      relatedToolCallId:\n217\t        args.relatedToolCallId === undefined\n218\t          ? existingEntry.relatedToolCallId\n219\t          : args.relatedToolCallId,\n220\t      entryStatus: args.entryStatus ?? existingEntry.entryStatus,\n221\t      degradationReason:\n222\t        args.degradationReason === undefined\n223\t          ? existingEntry.degradationReason\n224\t          : args.degradationReason,\n225\t    });\n226\t    await invalidateArchiveDerivedCaches(ctx, processId);\n227\t\n228\t    const storedEntry = await ctx.db.get(existingEntry._id);\n229\t\n230\t    if (storedEntry === null) {\n231\t      throw new Error('Archive entry was not found after patch.');\n232\t    }\n233\t\n234\t    return buildArchiveEntry(storedEntry);\n235\t  },\n236\t});\n237\t\n238\tasync function invalidateArchiveDerivedCaches(\n239\t  ctx: MutationCtx,\n240\t  processId: Id<'processes'>,\n241\t): Promise<void> {\n242\t  const storedTurns = await ctx.db\n243\t    .query('archiveTurns')\n244\t    .withIndex('by_processId_and_turnId', (indexQuery) => indexQuery.eq('processId', processId))\n245\t    .collect();\n246\t  const storedViews = await ctx.db\n247\t    .query('derivedArchiveViews')\n248\t    .withIndex('by_processId_and_updatedAt', (indexQuery) => indexQuery.eq('processId', processId))\n249\t    .collect();\n250\t\n251\t  for (const storedTurn of storedTurns) {\n252\t    await ctx.db.delete(storedTurn._id);\n253\t  }\n254\t\n255\t  for (const storedView of storedViews) {\n256\t    await ctx.db.delete(storedView._id);\n257\t  }\n258\t}\n259\t\n260\tfunction assertArchiveEntryInput(args: {\n261\t  entryKind: string;\n262\t  finalizationKey: string;\n263\t  sourceObjectId?: string | null;\n264\t  bodyText?: string | null;\n265\t  bodyData?: { jsonText: string } | null;\n266\t  bodyFormat: ArchiveEntry['bodyFormat'];\n267\t  relatedArtifactVersionId?: string | null;\n268\t  relatedSourceProvenanceId?: string | null;\n269\t  relatedToolCallId?: string | null;\n270\t  entryStatus?: ArchiveEntry['entryStatus'];\n271\t  degradationReason?: string | null;\n272\t}): void {\n273\t  if (!supportedArchiveEntryKinds.has(args.entryKind as ArchiveEntry['entryKind'])) {\n274\t    throw new Error(`Unsupported archive entry kind: ${args.entryKind}`);\n275\t  }\n276\t\n277\t  if (args.finalizationKey.trim().length === 0) {\n278\t    throw new Error('Archive entries require a non-empty finalization key.');\n279\t  }\n280\t\n281\t  assertOptionalNonEmptyString(args.sourceObjectId, 'Source object id');\n282\t  assertOptionalNonEmptyString(args.bodyText, 'Archive body text');\n283\t  assertOptionalNonEmptyString(args.relatedArtifactVersionId, 'Related artifact version id');\n284\t  assertOptionalNonEmptyString(args.relatedSourceProvenanceId, 'Related source provenance id');\n285\t  assertOptionalNonEmptyString(args.relatedToolCallId, 'Related tool call id');\n286\t\n287\t  if (args.bodyFormat === 'structured' && args.bodyData == null) {\n288\t    throw new Error('Structured archive entries must include bodyData.');\n289\t  }\n290\t\n291\t  if (args.bodyFormat === 'none' && (args.bodyText != null || args.bodyData != null)) {\n292\t    throw new Error(\"Archive entries with bodyFormat 'none' cannot include body content.\");\n293\t  }\n294\t\n295\t  if ((args.entryStatus ?? 'ready') === 'degraded' && args.degradationReason == null) {\n296\t    throw new Error('Degraded archive entries must include a degradation reason.');\n297\t  }\n298\t}\n299\t\n300\tfunction assertOptionalNonEmptyString(value: string | null | undefined, label: string): void {\n301\t  if (value !== undefined && value !== null && value.trim().length === 0) {\n302\t    throw new Error(`${label} must be a non-empty string when provided.`);\n303\t  }\n304\t}\n305\t\n306\tfunction assertArchivePageLimit(limit: number): void {\n307\t  if (!Number.isInteger(limit) || limit <= 0 || limit > MAX_ARCHIVE_PAGE_SIZE) {\n308\t    throw new Error(\n309\t      `Archive page limit must be an integer between 1 and ${MAX_ARCHIVE_PAGE_SIZE}.`,\n310\t    );\n311\t  }\n312\t}\n313\t\n314\tasync function getProcessRecordOrThrow(\n315\t  ctx: MutationCtx,\n316\t  processIdValue: string,\n317\t  projectId: string,\n318\t): Promise<Doc<'processes'>> {\n319\t  const processRecord = await ctx.db.get(processIdValue as Id<'processes'>);\n320\t\n321\t  if (processRecord === null) {\n322\t    throw new Error('Process not found.');\n323\t  }\n324\t\n325\t  if (processRecord.projectId !== projectId) {\n326\t    throw new Error('Process does not belong to the requested project.');\n327\t  }\n328\t\n329\t  return processRecord;\n330\t}\n331\t\n332\tfunction buildArchiveEntry(record: Doc<'archiveEntries'>): ArchiveEntry {\n333\t  return {\n334\t    archiveEntryId: record._id,\n335\t    projectId: record.projectId,\n336\t    processId: record.processId,\n337\t    entryKind: record.entryKind,\n338\t    sequence: record.sequence,\n339\t    lifecycleState: record.lifecycleState,\n340\t    finalizationKey: record.finalizationKey,\n341\t    sourceObjectId: record.sourceObjectId,\n342\t    bodyText: record.bodyText,\n343\t    bodyData: record.bodyData,\n344\t    bodyFormat: record.bodyFormat,\n345\t    relatedArtifactVersionId: record.relatedArtifactVersionId,\n346\t    relatedSourceProvenanceId: record.relatedSourceProvenanceId,\n347\t    relatedToolCallId: record.relatedToolCallId,\n348\t    entryStatus: record.entryStatus,\n349\t    degradationReason: record.degradationReason,\n350\t    recordedAt: record.recordedAt,\n351\t  };\n352\t}\n353\t\n354\tfunction decodeArchiveCursor(cursor: string | null): number | null {\n355\t  if (cursor == null) {\n356\t    return null;\n357\t  }\n358\t\n359\t  const parsed = Number.parseInt(cursor, 10);\n360\t  return Number.isNaN(parsed) ? null : parsed;\n361\t}\n362\t"}]},"parent_tool_use_id":"toolu_01MLQaCrEnQ196HFMGLH5UZn","session_id":"c9eda3ca-6602-4708-99a5-3d7fcbb61de5","uuid":"74e4980f-5eae-4d2e-898a-a1457c962b08","timestamp":"2026-05-05T18:52:23.577Z"}
