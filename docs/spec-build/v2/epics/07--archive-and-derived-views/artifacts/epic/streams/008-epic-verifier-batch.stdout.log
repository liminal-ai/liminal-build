{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LJDqraKLsH4HNHTziCVSAp","type":"tool_result","content":"1\timport type { ArchivePage } from '../../../shared/contracts/index.js';\n2\t\n3\tfunction formatArchiveEntryKindLabel(kind: string): string {\n4\t  return kind.replaceAll('_', ' ');\n5\t}\n6\t\n7\tfunction describeArchiveBody(entry: ArchivePage['entries'][number]): string {\n8\t  if (entry.bodyText !== null) {\n9\t    return entry.bodyText;\n10\t  }\n11\t\n12\t  if (entry.bodyData !== null) {\n13\t    return entry.bodyData.jsonText;\n14\t  }\n15\t\n16\t  return 'No archived body content.';\n17\t}\n18\t\n19\tfunction describeArtifactProvenance(entry: ArchivePage['entries'][number]): string | null {\n20\t  const provenance = entry.relatedArtifactProvenance;\n21\t  if (provenance === undefined) {\n22\t    return null;\n23\t  }\n24\t\n25\t  return `Artifact version: ${provenance.versionLabel} (${provenance.versionId})`;\n26\t}\n27\t\n28\tfunction describeProducingProcess(entry: ArchivePage['entries'][number]): string | null {\n29\t  const provenance = entry.relatedArtifactProvenance;\n30\t  if (provenance === undefined) {\n31\t    return null;\n32\t  }\n33\t\n34\t  return `Produced by: ${provenance.producedByProcessDisplayLabel ?? provenance.producedByProcessId} (${provenance.producedByProcessId})`;\n35\t}\n36\t\n37\tfunction describeSourceProvenance(entry: ArchivePage['entries'][number]): string | null {\n38\t  const provenance = entry.relatedSourceProvenance;\n39\t  if (provenance === undefined) {\n40\t    return null;\n41\t  }\n42\t\n43\t  const repositoryRef = provenance.targetRef === null ? '' : ` @ ${provenance.targetRef}`;\n44\t  return `Source: ${provenance.repositoryFullName}${repositoryRef}`;\n45\t}\n46\t\n47\texport function renderArchiveSection(args: {\n48\t  archive: ArchivePage | null;\n49\t  targetDocument: Document;\n50\t}): HTMLElement {\n51\t  const section = args.targetDocument.createElement('section');\n52\t  const title = args.targetDocument.createElement('h2');\n53\t\n54\t  section.setAttribute('data-archive-section', 'true');\n55\t  title.textContent = 'Archive';\n56\t  section.append(title);\n57\t\n58\t  if (args.archive === null) {\n59\t    const message = args.targetDocument.createElement('p');\n60\t    message.textContent = 'Loading archive entries...';\n61\t    section.append(message);\n62\t    return section;\n63\t  }\n64\t\n65\t  const pageState = args.targetDocument.createElement('p');\n66\t  pageState.setAttribute('data-archive-page-state', 'true');\n67\t  pageState.textContent = args.archive.page.hasMore\n68\t    ? `Showing ${args.archive.entries.length} finalized archive entries. More finalized entries are available.`\n69\t    : `Showing ${args.archive.entries.length} finalized archive entries.`;\n70\t  section.append(pageState);\n71\t\n72\t  if (args.archive.entries.length === 0) {\n73\t    const empty = args.targetDocument.createElement('p');\n74\t    empty.setAttribute('data-archive-empty-state', 'true');\n75\t    empty.textContent = 'No archived entries yet.';\n76\t    section.append(empty);\n77\t    return section;\n78\t  }\n79\t\n80\t  const list = args.targetDocument.createElement('ol');\n81\t\n82\t  for (const entry of args.archive.entries) {\n83\t    const item = args.targetDocument.createElement('li');\n84\t    const heading = args.targetDocument.createElement('strong');\n85\t    const body = args.targetDocument.createElement('p');\n86\t    const meta = args.targetDocument.createElement('p');\n87\t\n88\t    item.setAttribute('data-archive-entry-kind', entry.entryKind);\n89\t    item.setAttribute('data-archive-entry-status', entry.entryStatus);\n90\t    heading.textContent = `${entry.sequence}. ${formatArchiveEntryKindLabel(entry.entryKind)}`;\n91\t    body.textContent = describeArchiveBody(entry);\n92\t    meta.textContent = `Recorded: ${entry.recordedAt}`;\n93\t    item.append(heading, body, meta);\n94\t\n95\t    const artifactProvenance = describeArtifact