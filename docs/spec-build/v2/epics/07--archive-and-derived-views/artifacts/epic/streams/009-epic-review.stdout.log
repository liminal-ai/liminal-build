      }): Promise<{ historyItems: Array<{ historyItemId: string }> }>;\\n   229\\t    };\\n   230\\t\\n   231\\t    await applyExecutionResultSideEffects.applyExecutionResultSideEffects({\\n   232\\t      projectId,\\n   233\\t      processId,\\n   234\\t      executionResult,\\n   235\\t    });\\n   236\\t    await applyExecutionResultSideEffects.applyExecutionResultSideEffects({\\n   237\\t      projectId,\\n   238\\t      processId,\\n   239\\t      executionResult,\\n   240\\t    });\\n   241\\t\\n   242\\t    const [archivePage, historyItems] = await Promise.all([\\n   243\\t      platformStore.listArchiveEntries({\\n   244\\t        processId,\\n   245\\t        limit: 20,\\n   246\\t      }),\\n   247\\t      platformStore.listProcessHistoryItems({\\n   248\\t        processId,\\n   249\\t      }),\\n   250\\t    ]);\\n   251\\t\\n   252\\t    expect(archivePage.entries).toMatchObject([\\n   253\\t      {\\n   254\\t        entryKind: 'model_message',\\n   255\\t        finalizationKey: 'model:runtime-model-1',\\n   256\\t        sourceObjectId: 'runtime-model-1',\\n   257\\t      },\\n   258\\t    ]);\\n   259\\t    expect(archivePage.entries).toHaveLength(1);\\n   260\\t    expect(historyItems).toHaveLength(2);\\n   261\\t  });\\n   262\\t\\n   263\\t  it('maps finalized compatible process-history items into canonical archive entries only when safe', async () => {\\n   264\\t    const platformStore = buildStore();\\n   265\\t    const archiveFinalizationService = new ArchiveFinalizationService(platformStore);\\n   266\\t\\n   267\\t    const archiveEntry = await archiveFinalizationService.appendFromProcessHistoryItem({\\n   268\\t      projectId,\\n   269\\t      processId,\\n   270\\t      historyItem: processMessageHistoryFixture,\\n   271\\t    });\\n   272\\t    const skippedEntry = await archiveFinalizationService.appendFromProcessHistoryItem({\\n   273\\t      projectId,\\n   274\\t      processId,\\n   275\\t      historyItem: progressUpdateHistoryFixture,\\n   276\\t    });\\n   277\\t\\n   278\\t    expect(archiveEntry).toMatchObject({\\n   279\\t      entryKind: 'model_message',\\n   280\\t      finalizationKey: `model:${processMessageHistoryFixture.historyItemId}`,\\n   281\\t      bodyText: processMessageHistoryFixture.text,\\n   282\\t    });\\n   283\\t    expect(skippedEntry).toBeNull();\\n   284\\t  });\\n   285\\t\\n   286\\t  it('replayed accepted user responses reuse finalizationKey idempotency without duplicating archive rows', async () => {\\n   287\\t    const platformStore = buildStore({\\n   288\\t      processStatus: 'waiting',\\n   289\\t    });\\n   290\\t    const processResponseService = buildProcessResponseService(platformStore);\\n   291\\t    const archiveFinalizationService = new ArchiveFinalizationService(platformStore);\\n   292\\t\\n   293\\t    await processResponseService.respond({\\n   294\\t      actor,\\n   295\\t      projectId,\\n   296\\t      processId,\\n   297\\t      body: {\\n   298\\t        clientRequestId: 'req-archive-2',\\n   299\\t        message: 'Keep the archive durable.',\\n   300\\t      },\\n   301\\t    });\\n   302\\t    const submittedResponse = await platformStore.getSubmittedProcessResponse({\\n   303\\t      processId,\\n   304\\t      clientRequestId: 'req-archive-2',\\n   305\\t    });\\n   306\\t\\n   307\\t    expect(submittedResponse).not.toBeNull();\\n   308\\t\\n   309\\t    const bridgedArchiveEntry = await archiveFinalizationService.appendFromProcessHistoryItem({\\n   310\\t      projectId,\\n   311\\t      processId,\\n   312\\t      historyItem: submittedResponse!.historyItem,\\n   313\\t    });\\n   314\\t\\n   315\\t    const archivePage = await platformStore.listArchiveEntries({\\n   316\\t      processId,\\n   317\\t      limit: 20,\\n   318\\t    });\\n   319\\t\\n   320\\t    expect(archivePage.entries).toHaveLength(1);\\n   321\\t    expect(archivePage.entries[0]).toMatchObject({\\n   322\\t      finalizationKey: 'response:req-archive-2',\\n   323\\t      entryKind: 'user_message',\\n   324\\t      sourceObjectId: submittedResponse!.historyItem.historyItemId,\\n   325\\t    });\\n   326\\t    expect(bridgedArchiveEntry).toMatchObject({\\n   327\\t      finalizationKey: 'response:req-archive-2',\\n   328\\t      sourceObjectId: submittedResponse!.historyItem.historyItemId,\\n   329\\t    });\\n   330\\t  });\\n   331\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/streams/008-verify.stdout.log:92:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_44\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba apps/platform/server/services/archive/process-history-compat.service.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"     1\\timport type {\\n     2\\t  ArchiveBodyFormat,\\n     3\\t  ArchiveEntryKind,\\n     4\\t  ProcessHistoryItem,\\n     5\\t} from '../../../shared/contracts/index.js';\\n     6\\timport type { ArchiveEntryWriteInput } from '../projects/platform-store.js';\\n     7\\t\\n     8\\tconst compatibleHistoryKindToArchiveKind = {\\n     9\\t  user_message: 'user_message',\\n    10\\t  process_message: 'model_message',\\n    11\\t  process_event: 'process_event',\\n    12\\t} as const satisfies Partial<Record<ProcessHistoryItem['kind'], ArchiveEntryKind>>;\\n    13\\t\\n    14\\texport class ProcessHistoryCompatService {\\n    15\\t  mapHistoryKindToArchiveKind(kind: ProcessHistoryItem['kind']): ArchiveEntryKind | null {\\n    16\\t    if (kind in compatibleHistoryKindToArchiveKind) {\\n    17\\t      return compatibleHistoryKindToArchiveKind[\\n    18\\t        kind as keyof typeof compatibleHistoryKindToArchiveKind\\n    19\\t      ];\\n    20\\t    }\\n    21\\t\\n    22\\t    return null;\\n    23\\t  }\\n    24\\t\\n    25\\t  mapHistoryItemToArchiveSeed(args: {\\n    26\\t    projectId: string;\\n    27\\t    processId: string;\\n    28\\t    historyItem: ProcessHistoryItem;\\n    29\\t  }): ArchiveEntryWriteInput | null {\\n    30\\t    const entryKind = this.mapHistoryKindToArchiveKind(args.historyItem.kind);\\n    31\\t\\n    32\\t    if (args.historyItem.lifecycleState !== 'finalized' || entryKind === null) {\\n    33\\t      return null;\\n    34\\t    }\\n    35\\t\\n    36\\t    const bodyFormat: ArchiveBodyFormat =\\n    37\\t      args.historyItem.text.trim().length > 0 ? 'plain_text' : 'none';\\n    38\\t\\n    39\\t    return {\\n    40\\t      projectId: args.projectId,\\n    41\\t      processId: args.processId,\\n    42\\t      entryKind,\\n    43\\t      finalizationKey: buildHistoryItemArchiveFinalizationKey({\\n    44\\t        entryKind,\\n    45\\t        sourceObjectId: args.historyItem.historyItemId,\\n    46\\t      }),\\n    47\\t      sourceObjectId: args.historyItem.historyItemId,\\n    48\\t      bodyText: bodyFormat === 'none' ? null : args.historyItem.text,\\n    49\\t      bodyData: null,\\n    50\\t      bodyFormat,\\n    51\\t      relatedArtifactVersionId: null,\\n    52\\t      relatedSourceProvenanceId: null,\\n    53\\t      relatedToolCallId: null,\\n    54\\t      entryStatus: 'ready',\\n    55\\t      degradationReason: null,\\n    56\\t      recordedAt: args.historyItem.createdAt,\\n    57\\t    };\\n    58\\t  }\\n    59\\t}\\n    60\\t\\n    61\\texport function buildHistoryItemArchiveFinalizationKey(args: {\\n    62\\t  entryKind: ArchiveEntryKind;\\n    63\\t  sourceObjectId: string;\\n    64\\t}): string {\\n    65\\t  switch (args.entryKind) {\\n    66\\t    case 'user_message':\\n    67\\t      return `response:${args.sourceObjectId}`;\\n    68\\t    case 'model_message':\\n    69\\t      return `model:${args.sourceObjectId}`;\\n    70\\t    case 'process_event':\\n    71\\t      return `event:${args.sourceObjectId}`;\\n    72\\t    default:\\n    73\\t      return `history:${args.sourceObjectId}`;\\n    74\\t  }\\n    75\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/streams/008-verify.stdout.log:108:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_51\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/005-verify.json\\\"\",\"aggregated_output\":\"{\\\"command\\\":\\\"story-verify\\\",\\\"version\\\":1,\\\"status\\\":\\\"ok\\\",\\\"outcome\\\":\\\"revise\\\",\\\"result\\\":{\\\"resultId\\\":\\\"b11ad75a-dd58-4a13-a1e5-13b5e4de6c0b\\\",\\\"role\\\":\\\"story_verifier\\\",\\\"provider\\\":\\\"codex\\\",\\\"model\\\":\\\"gpt-5.4\\\",\\\"sessionId\\\":\\\"019df653-489e-7370-8de4-3a3f3f801119\\\",\\\"continuation\\\":{\\\"provider\\\":\\\"codex\\\",\\\"sessionId\\\":\\\"019df653-489e-7370-8de4-3a3f3f801119\\\",\\\"storyId\\\":\\\"02-finalization-boundary-between-live-state-and-archive\\\"},\\\"mode\\\":\\\"initial\\\",\\\"story\\\":{\\\"id\\\":\\\"02-finalization-boundary-between-live-state-and-archive\\\",\\\"title\\\":\\\"Story 2: Finalization Boundary Between Live State and Archive\\\"},\\\"artifactsRead\\\":[\\\"convex/_generated/ai/guidelines.md\\\",\\\"docs/spec-build/v2/epics/07--archive-and-derived-views/stories/02-finalization-boundary-between-live-state-and-archive.md\\\",\\\"docs/spec-build/v2/epics/07--archive-and-derived-views/tech-design.md\\\",\\\"docs/spec-build/v2/epics/07--archive-and-derived-views/test-plan.md\\\",\\\"apps/platform/server/services/archive/archive-finalization.service.ts\\\",\\\"apps/platform/server/services/archive/process-history-compat.service.ts\\\",\\\"apps/platform/server/services/processes/process-response.service.ts\\\",\\\"apps/platform/server/services/processes/environment/process-environment.service.ts\\\",\\\"apps/platform/server/services/processes/live/process-live-normalizer.ts\\\",\\\"apps/platform/client/app/process-live.ts\\\",\\\"apps/platform/server/services/projects/platform-store.ts\\\",\\\"tests/service/server/archive-finalization.test.ts\\\",\\\"tests/service/client/process-live.test.ts\\\",\\\"tests/fixtures/process-history.ts\\\",\\\"docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/003-implementor.json\\\",\\\"docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/005-verify.json\\\",\\\"docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/streams/005-verify.stdout.log\\\"],\\\"reviewScopeSummary\\\":\\\"Reviewed Story 2 finalization-boundary requirements and design, inspected the new ArchiveFinalizationService plus its response/environment completion hooks and live-separation surfaces, checked the story tests, reproduced a compatibility-bridge edge case, and reran the focused story test plus the story and epic gates.\\\",\\\"priorFindingStatuses\\\":[],\\\"newFindings\\\":[{\\\"id\\\":\\\"story2-user-message-bridge-finalization-key\\\",\\\"severity\\\":\\\"major\\\",\\\"title\\\":\\\"Bridged user_message rows can bypass the accepted-response idempotency key and duplicate archive truth\\\",\\\"evidence\\\":\\\"`ProcessHistoryCompatService` marks `user_message` as bridgeable (`apps/platform/server/services/archive/process-history-compat.service.ts:8-12`), but `ArchiveFinalizationService.buildHistoryItemFinalizationKey` emits `response:${historyItemId}` for that bridge path (`apps/platform/server/services/archive/archive-finalization.service.ts:88-100`) while `ProcessResponseService` archives the same accepted response under `response:${clientRequestId}` (`apps/platform/server/services/processes/process-response.service.ts:153-158`). Reproduction with `corepack pnpm exec tsx` after one `respond()` call and one `appendFromProcessHistoryItem(existing.historyItem)` call produced two archive rows for the same response: `response:req-archive-3` and `response:process-archive-finalization:history-response-1`. That breaks exact-once archive finalization if the explicit compatibility bridge is used on accepted responses.\\\",\\\"affectedFiles\\\":[\\\"apps/platform/server/services/archive/process-history-compat.service.ts\\\",\\\"apps/platform/server/services/archive/archive-finalization.service.ts\\\",\\\"apps/platform/server/services/processes/process-response.service.ts\\\",\\\"tests/service/server/archive-finalization.test.ts\\\"],\\\"requirementIds\\\":[\\\"AC-2.3\\\",\\\"TC-2.3b\\\",\\\"DoD-compatibility-mapping\\\"],\\\"recommendedFixScope\\\":\\\"quick-fix\\\",\\\"blocking\\\":true}],\\\"openFindings\\\":[{\\\"id\\\":\\\"story2-user-message-bridge-finalization-key\\\",\\\"severity\\\":\\\"major\\\",\\\"title\\\":\\\"Bridged user_message rows can bypass the accepted-response idempotency key and duplicate archive truth\\\",\\\"evidence\\\":\\\"`ProcessHistoryCompatService` marks `user_message` as bridgeable (`apps/platform/server/services/archive/process-history-compat.service.ts:8-12`), but `ArchiveFinalizationService.buildHistoryItemFinalizationKey` emits `response:${historyItemId}` for that bridge path (`apps/platform/server/services/archive/archive-finalization.service.ts:88-100`) while `ProcessResponseService` archives the same accepted response under `response:${clientRequestId}` (`apps/platform/server/services/processes/process-response.service.ts:153-158`). Reproduction with `corepack pnpm exec tsx` after one `respond()` call and one `appendFromProcessHistoryItem(existing.historyItem)` call produced two archive rows for the same response: `response:req-archive-3` and `response:process-archive-finalization:history-response-1`. That breaks exact-once archive finalization if the explicit compatibility bridge is used on accepted responses.\\\",\\\"affectedFiles\\\":[\\\"apps/platform/server/services/