{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B7dvamRZyzSvw6AMXxH2wa","type":"tool_result","content":"1\timport type {\n2\t  ArchiveBodyFormat,\n3\t  ArchiveEntry,\n4\t  ArchiveEntryKind,\n5\t  ProcessHistoryItem,\n6\t} from '../../../shared/contracts/index.js';\n7\timport type { ArchiveEntryWriteInput, PlatformStore } from '../projects/platform-store.js';\n8\timport {\n9\t  buildHistoryItemArchiveFinalizationKey,\n10\t  ProcessHistoryCompatService,\n11\t} from './process-history-compat.service.js';\n12\t\n13\texport class ArchiveFinalizationService {\n14\t  constructor(\n15\t    private readonly platformStore: Pick<\n16\t      PlatformStore,\n17\t      'appendArchiveEntry' | 'listArchiveEntries'\n18\t    >,\n19\t    private readonly processHistoryCompatService = new ProcessHistoryCompatService(),\n20\t  ) {}\n21\t\n22\t  async appendFinalizedEntry(args: ArchiveEntryWriteInput): Promise<ArchiveEntry> {\n23\t    const finalizationKey = args.finalizationKey.trim();\n24\t    const sourceObjectId = normalizeOptionalString(args.sourceObjectId);\n25\t    const relatedToolCallId = normalizeOptionalString(args.relatedToolCallId);\n26\t\n27\t    if (finalizationKey.length === 0) {\n28\t      throw new Error('Finalized archive entries require a non-empty finalizationKey.');\n29\t    }\n30\t\n31\t    if (sourceObjectId === null) {\n32\t      throw new Error(`Finalized ${args.entryKind} entries require a sourceObjectId.`);\n33\t    }\n34\t\n35\t    if (\n36\t      (args.entryKind === 'tool_call' || args.entryKind === 'tool_result') &&\n37\t      relatedToolCallId === null\n38\t    ) {\n39\t      throw new Error(`Finalized ${args.entryKind} entries require relatedToolCallId.`);\n40\t    }\n41\t\n42\t    return this.platformStore.appendArchiveEntry({\n43\t      ...args,\n44\t      finalizationKey,\n45\t      sourceObjectId,\n46\t      relatedToolCallId,\n47\t      bodyText: args.bodyText ?? null,\n48\t      bodyData: args.bodyData ?? null,\n49\t      relatedArtifactVersionId: args.relatedArtifactVersionId ?? null,\n50\t      relatedSourceProvenanceId: args.relatedSourceProvenanceId ?? null,\n51\t      entryStatus: args.entryStatus ?? 'ready',\n52\t      degradationReason: args.degradationReason ?? null,\n53\t      recordedAt: args.recordedAt,\n54\t    });\n55\t  }\n56\t\n57\t  async appendFromProcessHistoryItem(args: {\n58\t    projectId: string;\n59\t    processId: string;\n60\t    historyItem: ProcessHistoryItem;\n61\t  }): Promise<ArchiveEntry | null> {\n62\t    const entryKind = this.processHistoryCompatService.mapHistoryKindToArchiveKind(\n63\t      args.historyItem.kind,\n64\t    );\n65\t\n66\t    if (args.historyItem.lifecycleState !== 'finalized' || entryKind === null) {\n67\t      return null;\n68\t    }\n69\t\n70\t    const bodyFormat = toBodyFormat(args.historyItem.text);\n71\t    const sourceObjectId = args.historyItem.historyItemId;\n72\t\n73\t    if (entryKind === 'user_message') {\n74\t      const existingAcceptedResponse = await this.findExistingEntryBySourceObjectId({\n75\t        processId: args.processId,\n76\t        entryKind,\n77\t        sourceObjectId,\n78\t      });\n79\t\n80\t      if (existingAcceptedResponse !== null) {\n81\t        return existingAcceptedResponse;\n82\t      }\n83\t    }\n84\t\n85\t    return this.appendFinalizedEntry({\n86\t      projectId: args.projectId,\n87\t      processId: args.processId,\n88\t      entryKind,\n89\t      finalizationKey: buildHistoryItemArchiveFinalizationKey({\n90\t        entryKind,\n91\t        sourceObjectId,\n92\t      }),\n93\t      sourceObjectId,\n94\t      bodyText: bodyFormat === 'none' ? null : args.historyItem.text,\n95\t      bodyData: null,\n96\t      bodyFormat,\n97\t      relatedArtifactVersionId: null,\n98\t      relatedSourceProvenanceId: null,\n99\t      relatedToolCallId: null,\n100\t      entryStatus: 'ready',\n101\t      degradationReason: null,\n102\t      recordedAt: args.historyItem.createdAt,\n103\t    });\n104\t  }\n105\t\n106\t  private async findExistingEntryBySourceObjectId(args: {\n107\t    processId: string;\n108\t    entryKind: ArchiveEntryKind;\n109\t    sourceObjectId: string;\n110\t  }): Promise<ArchiveEntry | null> {\n111\t    let cursor: string | null = null;\n112\t\n113\t    do {\n114\t      const page = await this.platformStore.listArchiveEntries({\n115\t        processId: args.processId,\n116\t        cursor,\n117\t        limit: 200,\n118\t      });\n119\t      const existingEntry =\n120\t        page.entries.find(\n121\t          (entry) =>\n122\t            entry.entryKind === args.entryKind && entry.sourceObjectId === args.sourceObjectId,\n123\t        ) ?? null;\n124\t\n125\t      if (existingEntry !== null) {\n126\t        return existingEntry;\n127\t      }\n128\t\n129\t      cursor = page.page.nextCursor;\n130\t    } while (cursor !== null);\n131\t\n132\t    return null;\n133\t  }\n134\t}\n135\t\n136\tfunction toBodyFormat(text: string): ArchiveBodyFormat {\n137\t  return text.trim().length > 0 ? 'plain_text' : 'none';\n138\t}\n139\t\n140\tfunction normalizeOptionalString(value: string | null | undefined): string | null {\n141\t  const trimmed = value?.trim() ?? '';\n142\t  return trimmed.length > 0 ? trimmed : null;\n143\t}\n144\t"}]},"parent_tool_use_id":"toolu_018pkqsaddBrKr63mqNtZtwV","session_id":"ceb8cd2b-35ba-478c-a9f5-82f59e9dd21d","uuid":"26a94449-df3c-4113-b338-22e5af624023","timestamp":"2026-05-05T23:31:03.903Z"}
