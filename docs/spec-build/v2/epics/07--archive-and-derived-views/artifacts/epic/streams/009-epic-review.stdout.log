ldAppendArgs({\n578\t        entryKind: 'process_event',\n579\t        finalizationKey: 'event:missing-related-context',\n580\t        relatedArtifactVersionId: 'artifact-version-missing',\n581\t        relatedSourceProvenanceId: 'provenance-missing',\n582\t        relatedToolCallId: 'tool-call-missing',\n583\t        recordedAt: '2026-05-01T10:08:02.000Z',\n584\t      }),\n585\t    );\n586\t\n587\t    const firstPage = await listArchiveEntriesHandler(ctx, {\n588\t      processId: 'process-archive-1',\n589\t      limit: 2,\n590\t    });\n591\t    const secondPage = await listArchiveEntriesHandler(ctx, {\n592\t      processId: 'process-archive-1',\n593\t      cursor: firstPage.page.nextCursor,\n594\t      limit: 2,\n595\t    });\n596\t\n597\t    expect(firstPage.page).toEqual({\n598\t      cursor: null,\n599\t      nextCursor: '1',\n600\t      hasMore: true,\n601\t    });\n602\t    expect(firstPage.entries[1]).toMatchObject({\n603\t      finalizationKey: 'event:with-related-context',\n604\t      relatedArtifactVersionId: 'artifact-version-1',\n605\t      relatedSourceProvenanceId: 'provenance-1',\n606\t      relatedToolCallId: 'tool-call-7',\n607\t    });\n608\t    expect(secondPage.entries).toEqual([\n609\t      expect.objectContaining({\n610\t        finalizationKey: 'event:missing-related-context',\n611\t        relatedArtifactVersionId: 'artifact-version-missing',\n612\t        relatedSourceProvenanceId: 'provenance-missing',\n613\t        relatedToolCallId: 'tool-call-missing',\n614\t      }),\n615\t    ]);\n616\t  });\n617\t\n618\t  it('TC-4.3a archive unchanged after turn derivation', async () => {\n619\t    const { ctx } = createFakeConvexContext({\n620\t      ...buildArchiveSeed(),\n621\t      archiveEntries: [],\n622\t      archiveTurns: [],\n623\t    });\n624\t\n625\t    const userEntry = await appendArchiveEntryHandler(\n626\t      ctx,\n627\t      buildAppendArgs({\n628\t        entryKind: 'user_message',\n629\t        finalizationKey: 'turn-derivation:u