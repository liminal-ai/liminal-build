{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QsHDfB21QoyQ647Z3yNcyb","type":"tool_result","content":"1\timport type { ArchiveEntry, ArchivePage } from '../apps/platform/shared/contracts/index.js';\n2\timport type { Doc, Id } from './_generated/dataModel.js';\n3\timport { mutation, query, type MutationCtx, type QueryCtx } from './_generated/server.js';\n4\timport { v } from 'convex/values';\n5\t\n6\texport const archiveEntryKindValidator = v.union(\n7\t  v.literal('user_message'),\n8\t  v.literal('model_message'),\n9\t  v.literal('reasoning'),\n10\t  v.literal('script_emission'),\n11\t  v.literal('tool_call'),\n12\t  v.literal('tool_result'),\n13\t  v.literal('process_event'),\n14\t);\n15\t\n16\texport const archiveEntryLifecycleStateValidator = v.literal('finalized');\n17\t\n18\texport const archiveBodyFormatValidator = v.union(\n19\t  v.literal('plain_text'),\n20\t  v.literal('markdown'),\n21\t  v.literal('structured'),\n22\t  v.literal('none'),\n23\t);\n24\t\n25\texport const archiveEntryStatusValidator = v.union(v.literal('ready'), v.literal('degraded'));\n26\t\n27\texport const archiveEntryBodyDataValidator = v.object({\n28\t  jsonText: v.string(),\n29\t});\n30\t\n31\texport const archiveEntriesTableFields = {\n32\t  projectId: v.string(),\n33\t  processId: v.id('processes'),\n34\t  entryKind: archiveEntryKindValidator,\n35\t  sequence: v.number(),\n36\t  lifecycleState: archiveEntryLifecycleStateValidator,\n37\t  finalizationKey: v.string(),\n38\t  sourceObjectId: v.union(v.string(), v.null()),\n39\t  bodyText: v.union(v.string(), v.null()),\n40\t  bodyData: v.union(archiveEntryBodyDataValidator, v.null()),\n41\t  bodyFormat: archiveBodyFormatValidator,\n42\t  relatedArtifactVersionId: v.union(v.id('artifactVersions'), v.null()),\n43\t  relatedSourceProvenanceId: v.union(v.string(), v.null()),\n44\t  relatedToolCallId: v.union(v.string(), v.null()),\n45\t  entryStatus: archiveEntryStatusValidator,\n46\t  degradationReason: v.union(v.string(), v.null()),\n47\t  recordedAt: v.string(),\n48\t};\n49\t\n50\tconst archiveEntryWriteArgsValidator = {\n51\t  projectId: v.string(),\n52\t  processId: v.string(),\n53\t  entryKind: archiveEntryKindValidator,\n54\t  finalizationKey: v.string(),\n55\t  sourceObjectId: v.optional(v.union(v.string(), v.null())),\n56\t  bodyText: v.optional(v.union(v.string(), v.null())),\n57\t  bodyData: v.optional(v.union(archiveEntryBodyDataValidator, v.null())),\n58\t  bodyFormat: archiveBodyFormatValidator,\n59\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n60\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n61\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n62\t  entryStatus: v.optional(archiveEntryStatusValidator),\n63\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n64\t  recordedAt: v.optional(v.string()),\n65\t} as const;\n66\t\n67\tconst archiveListArgsValidator = {\n68\t  processId: v.string(),\n69\t  cursor: v.optional(v.union(v.string(), v.null())),\n70\t  limit: v.number(),\n71\t} as const;\n72\t\n73\tconst archivePatchArgsValidator = {\n74\t  processId: v.string(),\n75\t  finalizationKey: v.string(),\n76\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n77\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n78\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n79\t  entryStatus: v.optional(archiveEntryStatusValidator),\n80\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n81\t} as const;\n82\t\n83\tconst MAX_ARCHIVE_PAGE_SIZE = 200;\n84\tconst supportedArchiveEntryKinds = new Set([\n85\t  'user_message',\n86\t  'model_message',\n87\t  'reasoning',\n88\t  'script_emission',\n89\t  'tool_call',\n90\t  'tool_result',\n91\t  'process_event',\n92\t] satisfies ArchiveEntry['entryKind'][]);\n93\t\n94\texport const appendArchiveEntry = mutation({\n95\t  args: archiveEntryWriteArgsValidator,\n96\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry> => {\n97\t    assertArchiveEntryInput(args);\n98\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n99\t    const existingEntry = await ctx.db\n100\t      .query('archiveEntries')\n101\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n102\t        indexQuery.eq('processId', processRecord._id).eq('finalizationKey', args.finalizationKey),\n103\t      )\n104\t      .unique();\n105\t\n106\t    if (existingEntry !== null) {\n107\t      return buildArchiveEntry(existingEntry);\n108\t    }\n109\t\n110\t    const mostRecentEntry = await ctx.db\n111\t      .query('archiveEntries')\n112\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n113\t        indexQuery.eq('processId', processRecord._id),\n114\t      )\n115\t      .order('desc')\n116\t      .take(1);\n117\t    const nextSequence = (mostRecentEntry[0]?.sequence ?? -1) + 1;\n118\t    const archiveEntryId = await ctx.db.insert('archiveEntries', {\n119\t      projectId: args.projectId,\n120\t      processId: processRecord._id,\n121\t      entryKind: args.entryKind,\n122\t      sequence: nextSequence,\n123\t      lifecycleState: 'finalized',\n124\t      finalizationKey: args.finalizationKey,\n125\t      sourceObjectId: args.sourceObjectId ?? null,\n126\t      bodyText: args.bodyText ?? null,\n127\t      bodyData: args.bodyData ?? null,\n128\t      bodyFormat: args.bodyFormat,\n129\t      relatedArtifactVersionId:\n130\t        args.relatedArtifactVersionId === undefined || args.relatedArtifactVersionId === null\n131\t          ? null\n132\t          : (args.relatedArtifactVersionId as Id<'artifactVersions'>),\n133\t      relatedSourceProvenanceId: args.relatedSourceProvenanceId ?? null,\n134\t      relatedToolCallId: args.relatedToolCallId ?? null,\n135\t      entryStatus: args.entryStatus ?? 'ready',\n136\t      degradationReason: args.degradationReason ?? null,\n137\t      recordedAt: args.recordedAt ?? new Date().toISOString(),\n138\t    });\n139\t    await invalidateArchiveDerivedCaches(ctx, processRecord._id);\n140\t    const storedEntry = await ctx.db.get(archiveEntryId);\n141\t\n142\t    if (storedEntry === null) {\n143\t      throw new Error('Archive entry was not found after append.');\n144\t    }\n145\t\n146\t    return buildArchiveEntry(storedEntry);\n147\t  },\n148\t});\n149\t\n150\texport const listArchiveEntries = query({\n151\t  args: archiveListArgsValidator,\n152\t  handler: async (ctx: QueryCtx, args): Promise<ArchivePage> => {\n153\t    assertArchivePageLimit(args.limit);\n154\t    const processId = args.processId as Id<'processes'>;\n155\t    const decodedCursor = decodeArchiveCursor(args.cursor ?? null);\n156\t    const pageWithLookahead = await ctx.db\n157\t      .query('archiveEntries')\n158\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n159\t        decodedCursor === null\n160\t          ? indexQuery.eq('processId', processId)\n161\t          : indexQuery.eq('processId', processId).gt('sequence', decodedCursor),\n162\t      )\n163\t      .order('asc')\n164\t      .take(args.limit + 1);\n165\t    const hasMore = pageWithLookahead.length > args.limit;\n166\t    const pageEntries = pageWithLookahead\n167\t      .slice(0, args.limit)\n168\t      .map((entry) => buildArchiveEntry(entry));\n169\t    const lastEntry = pageEntries.at(-1);\n170\t\n171\t    return {\n172\t      entries: pageEntries,\n173\t      page: {\n174\t        cursor: args.cursor ?? null,\n175\t        nextCursor: hasMore && lastEntry !== undefined ? String(lastEntry.sequence) : null,\n176\t        hasMore,\n177\t      },\n178\t    };\n179\t  },\n180\t});\n181\t\n182\texport const patchArchiveEntry = mutation({\n183\t  args: archivePatchArgsValidator,\n184\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry | null> => {\n185\t    if (args.finalizationKey.trim().length === 0) {\n186\t      throw new Error('Archive entries require a non-empty finalization key.');\n187\t    }\n188\t\n189\t    assertOptionalNonEmptyString(args.relatedArtifactVersionId, 'Related artifact version id');\n190\t    assertOptionalNonEmptyString(args.relatedSourceProvenanceId, 'Related source provenance id');\n191\t    assertOptionalNonEmptyString(args.relatedToolCallId, 'Related tool call id');\n192\t\n193\t    const processId = args.processId as Id<'processes'>;\n194\t    const existingEntry = await ctx.db\n195\t      .query('archiveEntries')\n196\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n197\t        indexQuery.eq('processId', processId).eq('finalizationKey', args.finalizationKey),\n198\t      )\n199\t      .unique();\n200\t\n201\t    if (existingEntry === null) {\n202\t      return null;\n203\t    }\n204\t\n205\t    await ctx.db.patch(existingEntry._id, {\n206\t      relatedArtifactVersionId:\n207\t        args.relatedArtifactVersionId === undefined\n208\t          ? existingEntry.relatedArtifactVersionId\n209\t          : args.relatedArtifactVersionId === null\n210\t            ? null\n211\t            : (args.relatedArtifactVersionId as Id<'artifactVersions'>),\n212\t      relatedSourceProvenanceId:\n213\t        args.relatedSourceProvenanceId === undefined\n214\t          ? existingEntry.relatedSourceProvenanceId\n215\t          : args.relatedSourceProvenanceId,\n216\t      relatedToolCallId:\n217\t        args.relatedToolCallId === undefined\n218\t          ? existingEntry.relatedToolCallId\n219\t          : args.relatedToolCallId,\n220\t      entryStatus: args.entryStatus ?? existingEntry.entryStatus,\n221\t      degradationReason:\n222\t        args.degradationReason === undefined\n223\t          ? existingEntry.degradationReason\n224\t          : args.degradationReason,\n225\t    });\n226\t    await invalidateArchiveDerivedCaches(ctx, processId);\n227\t\n228\t    const storedEntry = await ctx.db.get(existingEntry._id);\n229\t\n230\t    if (storedEntry === null) {\n231\t      throw new Error('Archive entry was not found after patch.');\n232\t    }\n233\t\n234\t    return buildArchiveEntry(storedEntry);\n235\t  },\n236\t});\n237\t\n238\tasync function invalidateArchiveDerivedCaches(\n239\t  ctx: MutationCtx,\n240\t  processId: Id<'processes'>,\n241\t): Promise<void> {\n242\t  const storedTurns = await ctx.db\n243\t    .query('archiveTurns')\n244\t    .withIndex('by_processId_and_turnId', (indexQuery) => indexQuery.eq('processId', processId))\n245\t    .collect();\n246\t  const storedViews = await ctx.db\n247\t    .query('derivedArchiveViews')\n248\t    .withIndex('by_processId_and_updatedAt', (indexQuery) => indexQuery.eq('processId', processId))\n249\t    .collect();\n250\t\n251\t  for (const storedTurn of storedTurns) {\n252\t    await ctx.db.delete(storedTurn._id);\n253\t  }\n254\t\n255\t  for (const storedView of storedViews) {\n256\t    await ctx.db.delete(storedView._id);\n257\t  }\n258\t}\n259\t\n260\tfunction assertArchiveEntryInput(args: {\n261\t  entryKind: string;\n262\t  finalizationKey: string;\n263\t  sourceObjectId?: string | null;\n264\t  bodyText?: string | null;\n265\t  bodyData?: { jsonText: string } | null;\n266\t  bodyFormat: ArchiveEntry['bodyFormat'];\n267\t  relatedArtifactVersionId?: string | null;\n268\t  relatedSourceProvenanceId?: string | null;\n269\t  relatedToolCallId?: string | null;\n270\t  entryStatus?: ArchiveEntry['entryStatus'];\n271\t  degradationReason?: string | null;\n272\t}): void {\n273\t  if (!supportedArchiveEntryKinds.has(args.entryKind as ArchiveEntry['entryKind'])) {\n274\t    throw new Error(`Unsupported archive entry kind: ${args.entryKind}`);\n275\t  }\n276\t\n277\t  if (args.finalizationKey.trim().length === 0) {\n278\t    throw new Error('Archive entries require a non-empty finalization key.');\n279\t  }\n280\t\n281\t  assertOptionalNonEmptyString(args.sourceObjectId, 'Source object id');\n282\t  assertOptionalNonEmptyString(args.bodyText, 'Archive body text');\n283\t  assertOptionalNonEmptyString(arg