E = 200;\n    84\tconst supportedArchiveEntryKinds = new Set([\n    85\t  'user_message',\n    86\t  'model_message',\n    87\t  'reasoning',\n    88\t  'script_emission',\n    89\t  'tool_call',\n    90\t  'tool_result',\n    91\t  'process_event',\n    92\t] satisfies ArchiveEntry['entryKind'][]);\n    93\t\n    94\texport const appendArchiveEntry = mutation({\n    95\t  args: archiveEntryWriteArgsValidator,\n    96\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry> => {\n    97\t    assertArchiveEntryInput(args);\n    98\t    const processRecord = await getProcessRecordOrThrow(ctx, args.processId, args.projectId);\n    99\t    const existingEntry = await ctx.db\n   100\t      .query('archiveEntries')\n   101\t      .withIndex('by_processId_and_finalizationKey', (indexQuery) =>\n   102\t        indexQuery.eq('processId', processRecord._id).eq('finalizationKey', args.finalizationKey),\n   103\t      )\n   104\t      .unique();\n   105\t\n   106\t    if (existingEntry !== null) {\n   107\t      return buildArchiveEntry(existingEntry);\n   108\t    }\n   109\t\n   110\t    const mostRecentEntry = await ctx.db\n   111\t      .query('archiveEntries')\n   112\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n   113\t        indexQuery.eq('processId', processRecord._id),\n   114\t      )\n   115\t      .order('desc')\n   116\t      .take(1);\n   117\t    const nextSequence = (mostRecentEntry[0]?.sequence ?? -1) + 1;\n   118\t    const archiveEntryId = await ctx.db.insert('archiveEntries', {\n   119\t      projectId: args.projectId,\n   120\t      processId: processRecord._id,\n   121\t      entryKind: args.entryKind,\n   122\t      sequence: nextSequence,\n   123\t      lifecycleState: 'finalized',\n   124\t      finalizationKey: args.finalizationKey,\n   125\t      sourceObjectId: args.sourceObjectId ?? null,\n   126\t      bodyText: args.bodyText ?? null,\n   127\t      bodyData: args.bodyData ?? null,\n   128\t      bodyFormat: args.bodyFo