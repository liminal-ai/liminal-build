atedAt: new Date().toISOString(),\n274\t      fingerprint: args.plan.fingerprint,\n275\t    };\n276\t  }\n277\t\n278\t  async rebuildEnvironment(args: {\n279\t    processId: string;\n280\t    previousEnvironmentId: string | null;\n281\t    providerKind: ProviderKind;\n282\t    plan: HydrationPlan;\n283\t  }): Promise<HydrationResult & EnsuredEnvironment> {\n284\t    const environmentId = `env-rebuilt-${args.processId}`;\n285\t    this.processIdByEnvironmentId.set(environmentId, args.processId);\n286\t    return {\n287\t      providerKind: args.providerKind,\n288\t      environmentId,\n289\t      workspaceHandle: `workspace-rebuilt-${args.processId}`,\n290\t      hydratedAt: new Date().toISOString(),\n291\t      fingerprint: args.plan.fingerprint,\n292\t    };\n293\t  }\n294\t\n295\t  async teardownEnvironment(args: { environmentId: string }): Promise<void> {\n296\t    this.processIdByEnvironmentId.delete(args.environmentId);\n297\t  }\n298\t\n299\t  async resolveCandidateContents(args: ResolveCandidateContentsArgs): Promise<string> {\n300\t    return args.ref;\n301\t  }\n302\t}\n303\t\n304\t/**\n305\t * Always-failing provider adapter. Used in tests to drive the `failed`\n306\t * environment state path without any external dependencies. Like\n307\t * `InMemoryProviderAdapter`, NOT wired as the production provider.\n308\t */\n309\texport class FailingProviderAdapter implements ProviderAdapter {\n310\t  readonly providerKind: ProviderKind = 'local';\n311\t\n312\t  constructor(private readonly reason: string = 'Hydration failed in test') {}\n313\t\n314\t  async ensureEnvironment(_args: EnsureEnvironmentArgs): Promise<never> {\n315\t    throw new Error(this.reason);\n316\t  }\n317\t\n318\t  async hydrateEnvironment(_args: { environmentId: string; plan: HydrationPlan }): Promise<never> {\n319\t    throw new Error(this.reason);\n320\t  }\n321\t\n322\t  async executeScript(_args: ExecuteEnvironmentScriptArgs): Promise<ExecutionResult> {\n323\t    return {\n324\t      processStatus: 'failed',\n325\t      processHistoryItems: [\n326\t        {\n327\t          historyItemId: `failing-provider:${Date.now()}`,\n328\t          kind: 'process_event',\n329\t          lifecycleState: 'finalized',\n330\t          text: this.reason,\n331\t          createdAt: new Date().toISOString(),\n332\t          relatedSideWorkId: null,\n333\t          relatedArtifactId: null,\n334\t        } satisfies ProcessHistoryItem,\n335\t      ],\n336\t      archiveEntries: [],\n337\t      outputWrites: [],\n338\t      sideWorkWrites: [],\n339\t      artifactCheckpointCandidates: [],\n340\t      codeCheckpointCandidates: [],\n341\t    };\n342\t  }\n343\t\n344\t  async rehydrateEnvironment(_args: {\n345\t    environmentId: string;\n346\t    plan: HydrationPlan;\n347\t  }): Promise<never> {\n348\t    throw new Error(this.reason);\n349\t  }\n350\t\n351\t  async rebuildEnvironment(_args: {\n352\t    processId: string;\n353\t    previousEnvironmentId: string | null;\n354\t    providerKind: ProviderKind;\n355\t    plan: HydrationPlan;\n356\t  }): Promise<never> {\n357\t    throw new Error(this.reason);\n358\t  }\n359\t\n360\t  async teardownEnvironment(_args: { environmentId: string }): Promise<void> {\n361\t    return;\n362\t  }\n363\t\n364\t  async resolveCandidateContents(_args: ResolveCandidateContentsArgs): Promise<string> {\n365\t    throw new Error(this.reason);\n366\t  }\n367\t}\n368\t"}]},"parent_tool_use_id":null,"session_id":"8366fdc4-8e5c-4246-9b1c-47fd55763cba","uuid":"0d7d5bbd-cfd3-40bd-b2b2-b9b1e6f5f476","timestamp":"2026-05-05T23:31:43.209Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/services/processes/environment/provider-adapter.ts","content":"import type {\n  ArchiveBodyFormat,\n  ArchiveEntryBodyData,\n  ArchiveEntryKind,\n  ArchiveEntryStatus,\n  ProcessHistoryItem,\n  SourceAccessMode,\n  SourceProvenanceEntry,\n} from '../../../../shared/contracts/index.js';\n\nexport type ProviderKin