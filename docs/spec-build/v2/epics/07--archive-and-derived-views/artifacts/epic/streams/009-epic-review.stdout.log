  expect(requestErrorSchema.parse(archiveDerivationConflictErrorFixture)).toMatchObject({\n96\t      code: 'ARCHIVE_DERIVATION_CONFLICT',\n97\t      status: 409,\n98\t    });\n99\t    expect(requestErrorSchema.parse(invalidArchiveRequestErrorFixture)).toMatchObject({\n100\t      code: 'INVALID_ARCHIVE_REQUEST',"}]},"parent_tool_use_id":"toolu_018pkqsaddBrKr63mqNtZtwV","session_id":"ceb8cd2b-35ba-478c-a9f5-82f59e9dd21d","uuid":"99261d46-981a-419a-a9ea-3140fff91cb7","timestamp":"2026-05-05T23:31:27.646Z"}
