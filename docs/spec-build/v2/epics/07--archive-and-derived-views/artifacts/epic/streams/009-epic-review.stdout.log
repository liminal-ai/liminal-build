efore);\n745\t  });\n746\t\n747\t  it('service-only derived-view wrappers require the shared API key and preserve archive rows', async () => {\n748\t    const { ctx } = buildArchiveCtx({\n749\t      ...buildArchiveSeed(),\n750\t      archiveEntries: [],\n751\t      derivedArchiveViews: [],\n752\t    });\n753\t\n754\t    const userEntry = await appendArchiveEntryHandler(\n755\t      ctx,\n756\t      buildAppendArgs({\n757\t        entryKind: 'user_message',\n758\t        finalizationKey: 'service-wrapper:user',\n759\t        recordedAt: '2026-05-01T10:11:00.000Z',\n760\t      }),\n761\t    );\n762\t    const archiveBefore = await listArchiveEntriesHandler(ctx, {\n763\t      processId: 'process-archive-1',\n764\t      limit: 20,\n765\t    });\n766\t\n767\t    await replaceDerivedArchiveViewsForServiceHandler(ctx, {\n768\t      apiKey: 'test-convex-api-key',\n769\t      projectId: 'project-archive-1',\n770\t      processId: 'process-archive-1',\n771\t      views: [\n772\t        {\n773\t          derivedViewId: 'process-archive-1:derived-view:turn_range:0-0',\n774\t          processId: 'process-archive-1',\n775\t          viewKind: 'turn_range',\n776\t          turnRange: {\n777\t            startIndex: 0,\n778\t            endIndex: 0,\n779\t          },\n780\t          sourceTurnIds: ['process-archive-1:turn:0'],\n781\t          sourceArchiveEntryIds: [userEntry.archiveEntryId],\n782\t          title: 'Turn 0',\n783\t          bodyText: 'Turn 0',\n784\t          viewStatus: 'ready',\n785\t          degradationReason: null,\n786\t          updatedAt: '2026-05-01T10:11:10.000Z',\n787\t        },\n788\t      ],\n789\t    });\n790\t\n791\t    await expect(\n792\t      listDerivedArchiveViewsForServiceHandler(ctx, {\n793\t        apiKey: 'wrong-api-key',\n794\t        processId: 'process-archive-1',\n795\t        limit: 20,\n796\t      }),\n797\t    ).rejects.toThrow('Unauthorized service API key.');\n798\t\n799\t    const storedViews = await listDerivedArchiveViewsForSer