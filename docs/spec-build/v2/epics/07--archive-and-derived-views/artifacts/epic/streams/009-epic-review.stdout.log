eturn { ok: false, reason: 'archiveEntries must be an array when provided.' };\n404\t  }\n405\t\n406\t  if (obj.archiveEntries !== undefined && !Array.isArray(obj.archiveEntries)) {\n407\t    return { ok: false, reason: 'Field archiveEntries must be an array when provided.' };\n408\t  }\n409\t\n410\t  if (\n411\t    obj.usedSourceAttachmentIds !== undefined &&\n412\t    (!Array.isArray(obj.usedSourceAttachmentIds) ||\n413\t      obj.usedSourceAttachmentIds.some((value) => typeof value !== 'string' || value.length === 0))\n414\t  ) {\n415\t    return { ok: false, reason: 'Field usedSourceAttachmentIds must be an array of strings.' };\n416\t  }\n417\t\n418\t  const codeCandidateValidation = validateCodeCheckpointCandidates(\n419\t    obj.codeCheckpointCandidates as ExecutionResult['codeCheckpointCandidates'],\n420\t  );\n421\t  if (!codeCandidateValidation.ok) {\n422\t    return codeCandidateValidation;\n423\t  }\n424\t\n425\t  return {\n426\t    ok: true,\n427\t    value: {\n428\t      processStatus: obj.processStatus as ProcessExecutionStatus,\n429\t      processHistoryItems: obj.processHistoryItems as ExecutionResult['processHistoryItems'],\n430\t      archiveEntries: (obj.archiveEntries as ExecutionResult['archiveEntries']) ?? [],\n431\t      outputWrites: obj.outputWrites as ExecutionResult['outputWrites'],\n432\t      sideWorkWrites: obj.sideWorkWrites as ExecutionResult['sideWorkWrites'],\n433\t      artifactCheckpointCandidates:\n434\t        obj.artifactCheckpointCandidates as ExecutionResult['artifactCheckpointCandidates'],\n435\t      codeCheckpointCandidates:\n436\t        obj.codeCheckpointCandidates as ExecutionResult['codeCheckpointCandidates'],\n437\t      usedSourceAttachmentIds: obj.usedSourceAttachmentIds as string[] | undefined,\n438\t    },\n439\t  };\n440\t}\n441\t\n442\tfunction validateCodeCheckpointCandidates(\n443\t  candidates: CodeCheckpointCandidate[],\n444\t): ValidationResult<void> {\n445\t  for (const candidate of candidates) {\n446\t  