'2026-05-01T10:05:00.000Z',\n462\t      }),\n463\t    );\n464\t\n465\t    const page = await listArchiveEntriesHandler(ctx, {\n466\t      processId: 'process-archive-1',\n467\t      limit: 20,\n468\t    });\n469\t\n470\t    expect(\n471\t      page.entries.map((entry) => [entry.sequence, entry.finalizationKey, entry.recordedAt]),\n472\t    ).toEqual([\n473\t      [0, 'model:late-timestamp', '2026-05-01T10:06:00.000Z'],\n474\t      [1, 'user:early-timestamp', '2026-05-01T10:05:00.000Z'],\n475\t    ]);\n476\t  });\n477\t\n478\t  it('TC-1.3b same timestamp entries remain deterministic', async () => {\n479\t    const { ctx } = createFakeConvexContext({\n480\t      ...buildArchiveSeed(),\n481\t      archiveEntries: [],\n482\t    });\n483\t\n484\t    await appendArchiveEntryHandler(\n485\t      ctx,\n486\t      buildAppendArgs({\n487\t        entryKind: 'tool_call',\n488\t        finalizationKey: 'tool:lint:call',\n489\t        relatedToolCallId: 'tool-call-1',\n490\t        recordedAt: '2026-05-01T10:07:00.000Z',\n491\t      }),\n492\t    );\n493\t    await appendArchiveEntryHandler(\n494\t      ctx,\n495\t      buildAppendArgs({\n496\t        entryKind: 'tool_result',\n497\t        finalizationKey: 'tool:lint:result',\n498\t        relatedToolCallId: 'tool-call-1',\n499\t        recordedAt: '2026-05-01T10:07:00.000Z',\n500\t      }),\n501\t    );\n502\t\n503\t    const page = await listArchiveEntriesHandler(ctx, {\n504\t      processId: 'process-archive-1',\n505\t      limit: 20,\n506\t    });\n507\t\n508\t    expect(page.entries.map((entry) => [entry.sequence, entry.finalizationKey])).toEqual([\n509\t      [0, 'tool:lint:call'],\n510\t      [1, 'tool:lint:result'],\n511\t    ]);\n512\t  });\n513\t\n514\t  it('TC-2.3b replayed completion does not duplicate entry', async () => {\n515\t    const { ctx } = createFakeConvexContext({\n516\t      ...buildArchiveSeed(),\n517\t      archiveEntries: [],\n518\t    });\n519\t\n520\t    const first = await appendArchiveEntryHandler