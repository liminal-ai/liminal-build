{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015XWt42vrQdEGA2PxbbZWzU","type":"tool_result","content":"1\timport { defineSchema, defineTable } from 'convex/server';\n2\timport { archiveEntriesTableFields } from './archiveEntries.js';\n3\timport { archiveTurnsTableFields } from './archiveTurns.js';\n4\timport { artifactsTableFields } from './artifacts.js';\n5\timport { artifactVersionsTableFields } from './artifactVersions.js';\n6\timport { derivedArchiveViewsTableFields } from './derivedArchiveViews.js';\n7\timport { packageSnapshotMembersTableFields } from './packageSnapshotMembers.js';\n8\timport { packageSnapshotsTableFields } from './packageSnapshots.js';\n9\timport { processEnvironmentStatesTableFields } from './processEnvironmentStates.js';\n10\timport { processesTableFields } from './processes.js';\n11\timport { processFeatureImplementationStateTableFields } from './processFeatureImplementationStates.js';\n12\timport { processFeatureSpecificationStateTableFields } from './processFeatureSpecificationStates.js';\n13\timport { processHistoryItemsTableFields } from './processHistoryItems.js';\n14\timport { processOutputsTableFields } from './processOutputs.js';\n15\timport { processPackageContextMembersTableFields } from './processPackageContextMembers.js';\n16\timport { processPackageContextsTableFields } from './processPackageContexts.js';\n17\timport { processProductDefinitionStateTableFields } from './processProductDefinitionStates.js';\n18\timport { processSideWorkItemsTableFields } from './processSideWorkItems.js';\n19\timport { projectMembersTableFields } from './projectMembers.js';\n20\timport { projectsTableFields } from './projects.js';\n21\timport { sourceAttachmentsTableFields } from './sourceAttachments.js';\n22\timport { sourceProvenanceTableFields } from './sourceProvenance.js';\n23\timport { usersTableFields } from './users.js';\n24\t\n25\texport default defineSchema({\n26\t  users: defineTable(usersTableFields).index('