{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QDHgQpa7NDA5tQg6EDnS1H","type":"tool_result","content":"1\timport type { ProcessSummary } from '../../../../shared/contracts/index.js';\n2\timport type {\n3\t  ExecutionResult,\n4\t  HydrationPlanSourceInput,\n5\t  ProviderAdapter,\n6\t  ProviderKind,\n7\t  ScriptPayload,\n8\t} from './provider-adapter.js';\n9\timport type { ProviderAdapterRegistry } from './provider-adapter-registry.js';\n10\t\n11\ttype DefaultExecutionSourceInput = Pick<\n12\t  HydrationPlanSourceInput,\n13\t  'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n14\t>;\n15\t\n16\tfunction buildIntegratedWorkspaceExecutionSource(args: {\n17\t  processContext?: Pick<ProcessSummary, 'processId' | 'displayLabel' | 'processType' | 'status'>;\n18\t  sourceInputs: DefaultExecutionSourceInput[];\n19\t}): string {\n20\t  return `// liminal-build integrated default execution payload.\n21\t// Reads hydrated runtime materials, synthesizes a summary artifact, and when\n22\t// possible stages a source-side note from the real execution path.\n23\timport { promises as fs } from 'node:fs';\n24\timport * as path from 'node:path';\n25\tconst processContext = ${JSON.stringify(args.processContext ?? null)};\n26\tconst sourceInputs = ${JSON.stringify(args.sourceInputs)};\n27\tconst now = new Date().toISOString();\n28\tconst runtimeProfileByProcessType = {\n29\t  ProductDefinition: {\n30\t    artifactTitle: 'Product Definition Runtime Brief',\n31\t    artifactDisplayName: 'Product Definition Runtime Brief',\n32\t    artifactSlug: 'product-definition-runtime-brief',\n33\t    sourceNoteFilePath: 'notes/liminal-product-definition-runtime.md',\n34\t    revisionLabel: 'product-definition-runtime-v1',\n35\t    sideWorkLabel: 'Product definition runtime synthesis',\n36\t    executionFocus: 'shape hydrated discovery and product context into a product-definition brief',\n37\t    historyText: 'Product definition runtime completed and recorded hydrated discovery outputs.',\n38\t    sourceNoteTitle: 'Product Definition Runtime Note',\n39\t    commitMessage: 'Record product definition runtime note',\n40\t  },\n41\t  FeatureSpecification: {\n42\t    artifactTitle: 'Feature Specification Runtime Brief',\n43\t    artifactDisplayName: 'Feature Specification Runtime Brief',\n44\t    artifactSlug: 'feature-specification-runtime-brief',\n45\t    sourceNoteFilePath: 'notes/liminal-feature-specification-runtime.md',\n46\t    revisionLabel: 'feature-specification-runtime-v1',\n47\t    sideWorkLabel: 'Feature specification runtime synthesis',\n48\t    executionFocus: 'turn hydrated product and source context into a specification-readiness brief',\n49\t    historyText: 'Feature specification runtime completed and recorded hydrated specification outputs.',\n50\t    sourceNoteTitle: 'Feature Specification Runtime Note',\n51\t    commitMessage: 'Record feature specification runtime note',\n52\t  },\n53\t  FeatureImplementation: {\n54\t    artifactTitle: 'Feature Implementation Runtime Brief',\n55\t    artifactDisplayName: 'Feature Implementation Runtime Brief',\n56\t    artifactSlug: 'feature-implementation-runtime-brief',\n57\t    sourceNoteFilePath: 'notes/liminal-feature-implementation-runtime.md',\n58\t    revisionLabel: 'feature-implementation-runtime-v1',\n59\t    sideWorkLabel: 'Feature implementation runtime synthesis',\n60\t    executionFocus: 'inspect hydrated specs and source worktrees for implementation-ready context',\n61\t    historyText: 'Feature implementation runtime completed and recorded hydrated implementation outputs.',\n62\t    sourceNoteTitle: 'Feature Implementation Runtime Note',\n63\t    commitMessage: 'Record feature implementation runtime note',\n64\t  },\n65\t};\n66\tconst genericRuntimeProfile = {\n67\t  artifactTitle: 'Process Runtime Brief',\n68\t  artifactDisplayName: 'Process Runtime Brief',\n69\t  artifactSlug: 'process-runtime-brief',\n70\t  sourceNoteFilePath: 'notes/liminal-process-runtime.md',\n71\t  revisionLabel: 'process-runtime-v1',\n72\t  sideWorkLabel: 'Process runtime synthesis',\n73\t  executionFocus: 'synthesize process context from hydrated materials',\n74\t  historyText: 'Process runtime completed and recorded hydrated workspace outputs.',\n75\t  sourceNoteTitle: 'Process Runtime Note',\n76\t  commitMessage: 'Record process runtime note',\n77\t};\n78\tconst runtimeProfile =\n79\t  processContext === null\n80\t    ? genericRuntimeProfile\n81\t    : runtimeProfileByProcessType[processContext.processType] ?? genericRuntimeProfile;\n82\tconst artifactRelativePath = \\`artifacts/\\${runtimeProfile.artifactSlug}.md\\`;\n83\tconst artifactAbsolutePath = path.join(process.cwd(), artifactRelativePath);\n84\tconst sourceNoteFilePath = runtimeProfile.sourceNoteFilePath;\n85\tconst runtimeAuditRelativePath = '_liminal_runtime_audit.json';\n86\tconst writableSource = sourceInputs.find((source) => source.accessMode === 'read_write') ?? null;\n87\tconst primarySource = writableSource ?? sourceInputs[0] ?? null;\n88\tconst usedSourceAttachmentIds = sourceInputs.map((source) => source.sourceAttachmentId);\n89\tconst sanitizeSegment = (raw) => {\n90\t  const trimmed = raw.trim();\n91\t  const replaced = trimmed.replace(/[^a-zA-Z0-9._-]+/g, '-');\n92\t  return replaced.length === 0 ? 'unnamed' : replaced;\n93\t};\n94\tconst listDirectoryEntriesSafe = async (relativeDir) => {\n95\t  try {\n96\t    return await fs.readdir(path.join(process.cwd(), relativeDir), { withFileTypes: true });\n97\t  } catch {\n98\t    return [];\n99\t  }\n100\t};\n101\tconst readTextSafe = async (relativePath) => {\n102\t  try {\n103\t    return await fs.readFile(path.join(process.cwd(), relativePath), 'utf8');\n104\t  } catch {\n105\t    return null;\n106\t  }\n107\t};\n108\tconst summarizeText = (text) => {\n109\t  if (text === null) {\n110\t    return null;\n111\t  }\n112\t  const normalized = text.replace(/\\\\s+/g, ' ').trim();\n113\t  return normalized.length === 0 ? null : normalized.slice(0, 180);\n114\t};\n115\tconst resolveSourceWorkspaceRef = async (source, filePath) => {\n116\t  const sourceDirCandidates = [\n117\t    path.join(\n118\t      'sources',\n119\t      \\`\\${sanitizeSegment(source.sourceAttachmentId)}-\\${sanitizeSegment(source.displayName)}\\`,\n120\t    ),\n121\t    path.join(\n122\t      'sources',\n123\t      \\`\\${sanitizeSegment(source.displayName)}-\\${sanitizeSegment(source.sourceAttachmentId)}\\`,\n124\t    ),\n125\t  ];\n126\t  for (const relativePath of sourceDirCandidates) {\n127\t    try {\n128\t      await fs.access(path.join(process.cwd(), relativePath));\n129\t      return path.join(relativePath, filePath);\n130\t    } catch {}\n131\t  }\n132\t  return path.join(sourceDirCandidates[0], filePath);\n133\t};\n134\tconst hydratedArtifacts = (await listDirectoryEntriesSafe('artifacts')).filter((entry) =>\n135\t  entry.isFile(),\n136\t);\n137\tconst hydratedSources = (await listDirectoryEntriesSafe('sources')).filter((entry) =>\n138\t  entry.isDirectory(),\n139\t);\n140\tconst runtimeAudit = {\n141\t  generatedAt: now,\n142\t  processId: processContext?.processId ?? null,\n143\t  processType: processContext?.processType ?? null,\n144\t  runtimeProfile: runtimeProfile.artifactSlug,\n145\t  executionFocus: runtimeProfile.executionFocus,\n146\t  observedArtifactFileCount: hydratedArtifacts.length,\n147\t  observedSourceWorkspaceCount: hydratedSources.length,\n148\t  writableSourceAttachmentIds: sourceInputs\n149\t    .filter((source) => source.accessMode === 'read_write')\n150\t    .map((source) => source.sourceAttachmentId),\n151\t  usedSourceAttachmentIds,\n152\t};\n153\tconst artifactObservations = await Promise.all(\n154\t  hydratedArtifacts.slice(0, 6).map(async (entry) => {\n155\t    const relativePath = path.join('artifacts', entry.name);\n156\t    return {\n157\t      fileName: entry.name,\n158\t      excerpt: summarizeText(await readTextSafe(relativePath)),\n159\t    };\n160\t  }),\n161\t);\n162\tconst sourceObservations = await Promise.all(\n163\t  hydratedSources.slice(0, 6).map(async (entry) => {\n164\t    const relativeSourceDir = path.join('sources', entry.name);\n165\t    const childEntries = await listDirectoryEntriesSafe(relativeSourceDir);\n166\t    const topLevelFiles = childEntries.filter((child) => child.isFile()).slice(0, 6);\n167\t    const firstReadableFile = topLevelFiles[0] ?? null;\n168\t    const excerpt =\n169\t      firstReadableFile === null\n170\t        ? null\n171\t        : summarizeText(await readTextSafe(path.join(relativeSourceDir, firstReadableFile.name)));\n172\t    return {\n173\t      directory: entry.name,\n174\t      fileCount: childEntries.length,\n175\t      sampleEntries: childEntries.slice(0, 6).map((child) => child.name),\n176\t      excerpt,\n177\t    };\n178\t  }),\n179\t);\n180\tconst artifactSummaryLines = [\n181\t  \\`# \\${runtimeProfile.artifactTitle}\\`,\n182\t  '',\n183\t  'This brief was generated by the integrated runtime path from hydrated process materials.',\n184\t  '',\n185\t  \\`Process: \\${processContext?.displayLabel ?? 'unknown process'}\\`,\n186\t  \\`Process type: \\${processContext?.processType ?? 'unknown'}\\`,\n187\t  \\`Process status at start: \\${processContext?.status ?? 'unknown'}\\`,\n188\t  \\`Runtime focus: \\${runtimeProfile.executionFocus}\\`,\n189\t  \\`Generated: \\${now}\\`,\n190\t  \\`Hydrated artifact files: \\${artifactObservations.length}\\`,\n191\t  \\`Hydrated source worktrees: \\${sourceObservations.length}\\`,\n192\t  \\`Primary source: \\${primarySource?.displayName ?? 'none'}\\`,\n193\t  '',\n194\t  'Observed artifacts:',\n195\t  ...(artifactObservations.length === 0\n196\t    ? ['- none']\n197\t    : artifactObservations.map(\n198\t        (observation) =>\n199\t          \\`- \\${observation.fileName}: \\${observation.excerpt ?? 'no readable preview'}\\`,\n200\t      )),\n201\t  '',\n202\t  'Observed source worktrees:',\n203\t  ...(sourceObservations.length === 0\n204\t    ? ['- none']\n205\t    : sourceObservations.map((observation) => {\n206\t        const preview =\n207\t          observation.excerpt === null ? '' : \\` | preview: \\${observation.excerpt}\\`;\n208\t        return \\`- \\${observation.directory}: \\${observation.fileCount} entries (\\${observation.sampleEntries.join(', ') || 'no visible files'})\\${preview}\\`;\n209\t      })),\n210\t].join('\\\\n');\n211\tawait fs.mkdir(path.dirname(artifactAbsolutePath), { recursive: true });\n212\tawait fs.writeFile(artifactAbsolutePath, artifactSummaryLines, 'utf8');\n213\tconst codeCheckpointCandidates = [];\n214\tif (writableSource !== null) {\n215\t  const workspaceRef = await resolveSourceWorkspaceRef(writableSource, sourceNoteFilePath);\n216\t  const workspacePath = path.join(process.cwd(), workspaceRef);\n217\t  const sourceNoteContents = [\n218\t    \\`# \\${runtimeProfile.sourceNoteTitle}\\`,\n219\t    '',\n220\t    \\`Generated: \\${now}\\`,\n221\t    \\`Process type: \\${processContext?.processType ?? 'unknown'}\\`,\n222\t    \\`Runtime focus: \\${runtimeProfile.executionFocus}\\`,\n223\t    \\`Source: \\${writableSource.displayName}\\`,\n224\t    \\`Observed source worktrees: \\${sourceObservations.length}\\`,\n225\t    \\`Observed artifact files: \\${artifactObservations.length}\\`,\n226\t    \\`Summary artifact: \\${artifactRelativePath}\\`,\n227\t  ].join('\\\\n');\n228\t  await fs.mkdir(path.dirname(workspacePath), { recursive: true });\n229\t  await fs.writeFile(workspacePath, sourceNoteContents, 'utf8');\n230\t  codeCheckpointCandidates.push({\n231\t    sourceAttachmentId: writableSource.sourceAttachmentId,\n232\t    displayName: writableSource.displayName,\n233\t    targetRef: writableSource.targetRef,\n234\t    accessMode: writableSource.accessMode,\n235\t    workspaceRef,\n236\t    filePath: sourceNoteFilePath,\n237\t    commitMessage: runtimeProfile.commitMessage,\n238\t  });\n239\t}\n240\tconst result = {\n241\t  processStatus: 'completed',\n242\t  processHistoryItems: [\n243\t    {\n244\t      historyItemId: \\`default-execution-history-\\${now}\\`,\n245\t      kind: 'process_event',\n246\t      lifecycleState: 'finalized',\n247\t      text: runtimeProfile.historyText,\n248\t      createdAt: now,\n249\t      relatedSideWorkId: null,\n250\t      relatedArtifactId: null,\n251\t    },\n252\t  ],\n253\t  archiveEntries: [],\n254\t  outputWrites: [\n255\t    {\n256\t      displayName: runtimeProfile.artifactDisplayName,\n257\t      revisionLabel: runtimeProfile.revisionLabel,\n258\t      linkedArtifactId: null,\n259\t      state: 'ready_for_review',\n260\t      updatedAt: now,\n261\t    },\n262\t  ],\n263\t  sideWorkWrites: [\n264\t    {\n265\t      displayLabel: runtimeProfile.sideWorkLabel,\n266\t      purposeSummary: \\`\\${runtimeProfile.executionFocus}, write a typed runtime brief, and stage source follow-up when possible.\\`,\n267\t      status: 'completed',\n268\t      resultSummary:\n269\t        writableSource === null\n270\t          ? \\`Synthesized a summary from \\${artifactObservations.length} artifact files and \\${sourceObservations.length} source worktrees without a writable source note.\\`\n271\t          : \\`Synthesized a summary from \\${artifactObservations.length} artifact files and \\${sourceObservations.length} source worktrees, then staged a writable source note.\\`,\n272\t      updatedAt: now,\n273\t    },\n274\t  ],\n275\t  artifactCheckpointCandidates: [\n276\t    {\n277\t      artifactId: undefined,\n278\t      displayName: runtimeProfile.artifactDisplayName,\n279\t      revisionLabel: runtimeProfile.revisionLabel,\n280\t      contentsRef: artifactRelativePath,\n281\t    },\n282\t  ],\n283\t  codeCheckpointCandidates,\n284\t  usedSourceAttachmentIds,\n285\t};\n286\tawait fs.writeFile(\n287\t  path.join(process.cwd(), runtimeAuditRelativePath),\n288\t  JSON.stringify(runtimeAudit, null, 2),\n289\t  'utf8',\n290\t);\n291\tawait fs.writeFile(\n292\t  path.join(process.cwd(), '_liminal_exec_result.json'),\n293\t  JSON.stringify(result, null, 2),\n294\t  'utf8',\n295\t);\n296\t`;\n297\t}\n298\t\n299\texport function buildIntegratedWorkspaceExecutionPayload(\n300\t  args: {\n301\t    processContext?: Pick<ProcessSummary, 'processId' | 'displayLabel' | 'processType' | 'status'>;\n302\t    sourceInputs?: Array<\n303\t      Pick<\n304\t        HydrationPlanSourceInput,\n305\t        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n306\t      >\n307\t    >;\n308\t  } = {},\n309\t): ScriptPayload {\n310\t  const sourceInputs: DefaultExecutionSourceInput[] = [...(args.sourceInputs ?? [])];\n311\t  return {\n312\t    format: 'ts-module-source',\n313\t    entrypoint: 'default',\n314\t    source: buildIntegratedWorkspaceExecutionSource({\n315\t      processContext: args.processContext,\n316\t      sourceInputs,\n317\t    }),\n318\t  };\n319\t}\n320\t\n321\t/**\n322\t * Thin wrapper around `ProviderAdapter.executeScript` that packages the\n323\t * current integrated default execution payload and resolves the correct\n324\t * provider adapter from the registry. The default payload may produce runtime\n325\t * artifacts/checkpoint candidates, but it must not synthesize canonical archive\n326\t * entries; archive rows should come from real process-specific execution.\n327\t */\n328\texport class ScriptExecutionService {\n329\t  constructor(\n330\t    private readonly providerAdapterRegistry: ProviderAdapterRegistry,\n331\t    private readonly scriptPayloadFactory: (args: {\n332\t      processContext?: Pick<\n333\t        ProcessSummary,\n334\t        'processId' | 'displayLabel' | 'processType' | 'status'\n335\t      >;\n336\t      currentSources: Array<\n337\t        Pick<\n338\t          HydrationPlanSourceInput,\n339\t          'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n340\t        >\n341\t      >;\n342\t    }) => ScriptPayload = ({ processContext, currentSources }) =>\n343\t      buildIntegratedWorkspaceExecutionPayload({\n344\t        processContext,\n345\t        sourceInputs: currentSources,\n346\t      }),\n347\t  ) {}\n348\t\n349\t  async executeFor(args: {\n350\t    providerKind: ProviderKind;\n351\t    environmentId: string;\n352\t    processContext?: Pick<ProcessSummary, 'processId' | 'displayLabel' | 'processType' | 'status'>;\n353\t    currentSources?: Array<\n354\t      Pick<\n355\t        HydrationPlanSourceInput,\n356\t        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n357\t      >\n358\t    >;\n359\t  }): Promise<ExecutionResult> {\n360\t    const adapter: ProviderAdapter = this.providerAdapterRegistry.resolve(args.providerKind);\n361\t    return adapter.executeScript({\n362\t      environmentId: args.environmentId,\n363\t      scriptPayload: this.scriptPayloadFactory({\n364\t        processContext: args.processContext,\n365\t        currentSources: args.currentSources ?? [],\n366\t      }),\n367\t    });\n368\t  }\n369\t}\n370\t"}]},"parent_tool_use_id":null,"session_id":"8366fdc4-8e5c-4246-9b1c-47fd55763cba","uuid":"bd62445d-b351-4056-a00c-b4b9278c758b","timestamp":"2026-05-05T23:31:56.655Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/services/processes/environment/script-execution.service.ts","content":"import type { ProcessSummary } from '../../../../shared/contracts/index.js';\nimport type {\n  ExecutionResult,\n  HydrationPlanSourceInput,\n  ProviderAdapter,\n  ProviderKind,\n  ScriptPayload,\n} from './provider-adapter.js';\nimport type { ProviderAdapterRegistry } from './provider-adapter-registry.js';\n\ntype DefaultExecutionSourceInput = Pick<\n  HydrationPlanSourceInput,\n  'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n>;\n\nfunction buildIntegratedWorkspaceExecutionSource(args: {\n  processContext?: Pick<ProcessSummary, 'processId' | 'displayLabel' | 'processType' | 'status'>;\n  sourceInputs: DefaultExecutionSourceInput[];\n}): string {\n  return `// liminal-build integrated default execution payload.\n// Reads hydrated runtime materials, synthesizes a summary artifact, and when\n// possible stages a source-side note from the real execution path.\nimport { promises as fs } from 'node:fs';\nimport * as path from 'node:path';\nconst processContext = ${JSON.stringify(args.processContext ?? null)};\nconst sourceInputs = ${JSON.stringify(args.sourceInputs)};\nconst now = new Date().toISOString();\nconst runtimeProfileByProcessType = {\n  ProductDefinition: {\n    artifactTitle: 'Product Definition Runtime Brief',\n    artifactDisplayName: 'Product Definition Runtime Brief',\n    artifactSlug: 'product-definition-runtime-brief',\n    sourceNoteFilePath: 'notes/liminal-product-definition-runtime.md',\n    revisionLabel: 'product-definition-runtime-v1',\n    sideWorkLabel: 'Product definition runtime synthesis',\n    executionFocus: 'shape hydrated discovery and product context into a product-definition brief',\n    historyText: 'Product definition runtime completed and recorded hydrated discovery outputs.',\n    sourceNoteTitle: 'Product Definition Runtime Note',\n    commitMessage: 'Record product definition runtime note',\n  },\n  FeatureSpecification: {\n    artifactTitle: 'Feature Specification Runtime Brief',\n    artifactDisplayName: 'Feature Specification Runtime Brief',\n    artifactSlug: 'feature-specification-runtime-brief',\n    sourceNoteFilePath: 'notes/liminal-feature-specification-runtime.md',\n    revisionLabel: 'feature-specification-runtime-v1',\n    sideWorkLabel: 'Feature specification runtime synthesis',\n    executionFocus: 'turn hydrated product and source context into a specification-readiness brief',\n    historyText: 'Feature specification runtime completed and recorded hydrated specification outputs.',\n    sourceNoteTitle: 'Feature Specification Runtime Note',\n    commitMessage: 'Record feature specification runtime note',\n  },\n  FeatureImplementation: {\n    artifactTitle: 'Feature Implementation Runtime Brief',\n    artifactDisplayName: 'Feature Implementation Runtime Brief',\n    artifactSlug: 'feature-implementation-runtime-brief',\n    sourceNoteFilePath: 'notes/liminal-feature-implementation-runtime.md',\n    revisionLabel: 'feature-implementation-runtime-v1',\n    sideWorkLabel: 'Feature implementation runtime synthesis',\n    executionFocus: 'inspect hydrated specs and source worktrees for implementation-ready context',\n    historyText: 'Feature implementation runtime completed and recorded hydrated implementation outputs.',\n    sourceNoteTitle: 'Feature Implementation Runtime Note',\n    commitMessage: 'Record feature implementation runtime note',\n  },\n};\nconst genericRuntimeProfile = {\n  artifactTitle: 'Process Runtime Brief',\n  artifactDisplayName: 'Process Runtime Brief',\n  artifactSlug: 'process-runtime-brief',\n  sourceNoteFilePath: 'notes/liminal-process-runtime.md',\n  revisionLabel: 'process-runtime-v1',\n  sideWorkLabel: 'Process runtime synthesis',\n  executionFocus: 'synthesize process context from hydrated materials',\n  historyText: 'Process runtime completed and recorded hydrated workspace outputs.',\n  sourceNoteTitle: 'Process Runtime Note',\n  commitMessage: 'Record process runtime note',\n};\nconst runtimeProfile =\n  processContext === null\n    ? genericRuntimeProfile\n    : runtimeProfileByProcessType[processContext.processType] ?? genericRuntimeProfile;\nconst artifactRelativePath = \\`artifacts/\\${runtimeProfile.artifactSlug}.md\\`;\nconst artifactAbsolutePath = path.join(process.cwd(), artifactRelativePath);\nconst sourceNoteFilePath = runtimeProfile.sourceNoteFilePath;\nconst runtimeAuditRelativePath = '_liminal_runtime_audit.json';\nconst writableSource = sourceInputs.find((source) => source.accessMode === 'read_write') ?? null;\nconst primarySource = writableSource ?? sourceInputs[0] ?? null;\nconst usedSourceAttachmentIds = sourceInputs.map((source) => source.sourceAttachmentId);\nconst sanitizeSegment = (raw) => {\n  const trimmed = raw.trim();\n  const replaced = trimmed.replace(/[^a-zA-Z0-9._-]+/g, '-');\n  return replaced.length === 0 ? 'unnamed' : replaced;\n};\nconst listDirectoryEntriesSafe = async (relativeDir) => {\n  try {\n    return await fs.readdir(path.join(process.cwd(), relativeDir), { withFileTypes: true });\n  } catch {\n    return [];\n  }\n};\nconst readTextSafe = async (relativePath) => {\n  try {\n    return await fs.readFile(path.join(process.cwd(), relativePath), 'utf8');\n  } catch {\n    return null;\n  }\n};\nconst summarizeText = (text) => {\n  if (text === null) {\n    return null;\n  }\n  const normalized = text.replace(/\\\\s+/g, ' ').trim();\n  return normalized.length === 0 ? null : normalized.slice(0, 180);\n};\nconst resolveSourceWorkspaceRef = async (source, filePath) => {\n  const sourceDirCandidates = [\n    path.join(\n      'sources',\n      \\`\\${sanitizeSegment(source.sourceAttachmentId)}-\\${sanitizeSegment(source.displayName)}\\`,\n    ),\n    path.join(\n      'sources',\n      \\`\\${sanitizeSegment(source.displayName)}-\\${sanitizeSegment(source.sourceAttachmentId)}\\`,\n    ),\n  ];\n  for (const relativePath of sourceDirCandidates) {\n    try {\n      await fs.access(path.join(process.cwd(), relativePath));\n      return path.join(relativePath, filePath);\n    } catch {}\n  }\n  return path.join(sourceDirCandidates[0], filePath);\n};\nconst hydratedArtifacts = (await listDirectoryEntriesSafe('artifacts')).filter((entry) =>\n  entry.isFile(),\n);\nconst hydratedSources = (await listDirectoryEntriesSafe('sources')).filter((entry) =>\n  entry.isDirectory(),\n);\nconst runtimeAudit = {\n  generatedAt: now,\n  processId: processContext?.processId ?? null,\n  processType: processContext?.processType ?? null,\n  runtimeProfile: runtimeProfile.artifactSlug,\n  executionFocus: runtimeProfile.executionFocus,\n  observedArtifactFileCount: hydratedArtifacts.length,\n  observedSourceWorkspaceCount: hydratedSources.length,\n  writableSourceAttachmentIds: sourceInputs\n    .filter((source) => source.accessMode === 'read_write')\n    .map((source) => source.sourceAttachmentId),\n  usedSourceAttachmentIds,\n};\nconst artifactObservations = await Promise.all(\n  hydratedArtifacts.slice(0, 6).map(async (entry) => {\n    const relativePath = path.join('artifacts', entry.name);\n    return {\n      fileName: entry.name,\n      excerpt: summarizeText(await readTextSafe(relativePath)),\n    };\n  }),\n);\nconst sourceObservations = await Promise.all(\n  hydratedSources.slice(0, 6).map(async (entry) => {\n    const relativeSourceDir = path.join('sources', entry.name);\n    const childEntries = await listDirectoryEntriesSafe(relativeSourceDir);\n    const topLevelFiles = childEntries.filter((child) => child.isFile()).slice(0, 6);\n    const firstReadableFile = topLevelFiles[0] ?? null;\n    const excerpt =\n      firstReadableFile === null\n        ? null\n        : summarizeText(await readTextSafe(path.join(relativeSourceDir, firstReadableFile.name)));\n    return {\n      directory: entry.name,\n      fileCount: childEntries.length,\n      sampleEntries: childEntries.slice(0, 6).map((child) => child.name),\n      excerpt,\n    };\n  }),\n);\nconst artifactSummaryLines = [\n  \\`# \\${runtimeProfile.artifactTitle}\\`,\n  '',\n  'This brief was generated by the integrated runtime path from hydrated process materials.',\n  '',\n  \\`Process: \\${processContext?.displayLabel ?? 'unknown process'}\\`,\n  \\`Process type: \\${processContext?.processType ?? 'unknown'}\\`,\n  \\`Process status at start: \\${processContext?.status ?? 'unknown'}\\`,\n  \\`Runtime focus: \\${runtimeProfile.executionFocus}\\`,\n  \\`Generated: \\${now}\\`,\n  \\`Hydrated artifact files: \\${artifactObservations.length}\\`,\n  \\`Hydrated source worktrees: \\${sourceObservations.length}\\`,\n  \\`Primary source: \\${primarySource?.displayName ?? 'none'}\\`,\n  '',\n  'Observed artifacts:',\n  ...(artifactObservations.length === 0\n    ? ['- none']\n    : artifactObservations.map(\n        (observation) =>\n          \\`- \\${observation.fileName}: \\${observation.excerpt ?? 'no readable preview'}\\`,\n      )),\n  '',\n  'Observed source worktrees:',\n  ...(sourceObservations.length === 0\n    ? ['- none']\n    : sourceObservations.map((observation) => {\n        const preview =\n          observation.excerpt === null ? '' : \\` | preview: \\${observation.excerpt}\\`;\n        return \\`- \\${observation.directory}: \\${observation.fileCount} entries (\\${observation.sampleEntries.join(', ') || 'no visible files'})\\${preview}\\`;\n      })),\n].join('\\\\n');\nawait fs.mkdir(path.dirname(artifactAbsolutePath), { recursive: true });\nawait fs.writeFile(artifactAbsolutePath, artifactSummaryLines, 'utf8');\nconst codeCheckpointCandidates = [];\nif (writableSource !== null) {\n  const workspaceRef = await resolveSourceWorkspaceRef(writableSource, sourceNoteFilePath);\n  const workspacePath = path.join(process.cwd(), workspaceRef);\n  const sourceNoteContents = [\n    \\`# \\${runtimeProfile.sourceNoteTitle}\\`,\n    '',\n    \\`Generated: \\${now}\\`,\n    \\`Process type: \\${processContext?.processType ?? 'unknown'}\\`,\n    \\`Runtime focus: \\${runtimeProfile.executionFocus}\\`,\n    \\`Source: \\${writableSource.displayName}\\`,\n    \\`Observed source worktrees: \\${sourceObservations.length}\\`,\n    \\`Observed artifact files: \\${artifactObservations.length}\\`,\n    \\`Summary artifact: \\${artifactRelativePath}\\`,\n  ].join('\\\\n');\n  await fs.mkdir(path.dirname(workspacePath), { recursive: true });\n  await fs.writeFile(workspacePath, sourceNoteContents, 'utf8');\n  codeCheckpointCandidates.push({\n    sourceAttachmentId: writableSource.sourceAttachmentId,\n    displayName: writableSource.displayName,\n    targetRef: writableSource.targetRef,\n    accessMode: writableSource.accessMode,\n    workspaceRef,\n    filePath: sourceNoteFilePath,\n    commitMessage: runtimeProfile.commitMessage,\n  });\n}\nconst result = {\n  processStatus: 'completed',\n  processHistoryItems: [\n    {\n      historyItemId: \\`default-execution-history-\\${now}\\`,\n      kind: 'process_event',\n      lifecycleState: 'finalized',\n      text: runtimeProfile.historyText,\n      createdAt: now,\n      relatedSideWorkId: null,\n      relatedArtifactId: null,\n    },\n  ],\n  archiveEntries: [],\n  outputWrites: [\n    {\n      displayName: runtimeProfile.artifactDisplayName,\n      revisionLabel: runtimeProfile.revisionLabel,\n      linkedArtifactId: null,\n      state: 'ready_for_review',\n      updatedAt: now,\n    },\n  ],\n  sideWorkWrites: [\n    {\n      displayLabel: runtimeProfile.sideWorkLabel,\n      purposeSummary: \\`\\${runtimeProfile.executionFocus}, write a typed runtime brief, and stage source follow-up when possible.\\`,\n      status: 'completed',\n      resultSummary:\n        writableSource === null\n          ? \\`Synthesized a summary from \\${artifactObservations.length} artifact files and \\${sourceObservations.length} source worktrees without a writable source note.\\`\n          : \\`Synthesized a summary from \\${artifactObservations.length} artifact files and \\${sourceObservations.length} source worktrees, then staged a writable source note.\\`,\n      updatedAt: now,\n    },\n  ],\n  artifactCheckpointCandidates: [\n    {\n      artifactId: undefined,\n      displayName: runtimeProfile.artifactDisplayName,\n      revisionLabel: runtimeProfile.revisionLabel,\n      contentsRef: artifactRelativePath,\n    },\n  ],\n  codeCheckpointCandidates,\n  usedSourceAttachmentIds,\n};\nawait fs.writeFile(\n  path.join(process.cwd(), runtimeAuditRelativePath),\n  JSON.stringify(runtimeAudit, null, 2),\n  'utf8',\n);\nawait fs.writeFile(\n  path.join(process.cwd(), '_liminal_exec_result.json'),\n  JSON.stringify(result, null, 2),\n  'utf8',\n);\n`;\n}\n\nexport function buildIntegratedWorkspaceExecutionPayload(\n  args: {\n    processContext?: Pick<ProcessSummary, 'processId' | 'displayLabel' | 'processType' | 'status'>;\n    sourceInputs?: Array<\n      Pick<\n        HydrationPlanSourceInput,\n        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n      >\n    >;\n  } = {},\n): ScriptPayload {\n  const sourceInputs: DefaultExecutionSourceInput[] = [...(args.sourceInputs ?? [])];\n  return {\n    format: 'ts-module-source',\n    entrypoint: 'default',\n    source: buildIntegratedWorkspaceExecutionSource({\n      processContext: args.processContext,\n      sourceInputs,\n    }),\n  };\n}\n\n/**\n * Thin wrapper around `ProviderAdapter.executeScript` that packages the\n * current integrated default execution payload and resolves the correct\n * provider adapter from the registry. The default payload may produce runtime\n * artifacts/checkpoint candidates, but it must not synthesize canonical archive\n * entries; archive rows should come from real process-specific execution.\n */\nexport class ScriptExecutionService {\n  constructor(\n    private readonly providerAdapterRegistry: ProviderAdapterRegistry,\n    private readonly scriptPayloadFactory: (args: {\n      processContext?: Pick<\n        ProcessSummary,\n        'processId' | 'displayLabel' | 'processType' | 'status'\n      >;\n      currentSources: Array<\n        Pick<\n          HydrationPlanSourceInput,\n          'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n        >\n      >;\n    }) => ScriptPayload = ({ processContext, currentSources }) =>\n      buildIntegratedWorkspaceExecutionPayload({\n        processContext,\n        sourceInputs: currentSources,\n      }),\n  ) {}\n\n  async executeFor(args: {\n    providerKind: ProviderKind;\n    environmentId: string;\n    processContext?: Pick<ProcessSummary, 'processId' | 'displayLabel' | 'processType' | 'status'>;\n    currentSources?: Array<\n      Pick<\n        HydrationPlanSourceInput,\n        'sourceAttachmentId' | 'displayName' | 'targetRef' | 'accessMode'\n      >\n    >;\n  }): Promise<ExecutionResult> {\n    const adapter: ProviderAdapter = this.providerAdapterRegistry.resolve(args.providerKind);\n    return adapter.executeScript({\n      environmentId: args.environmentId,\n      scriptPayload: this.scriptPayloadFactory({\n        processContext: args.processContext,\n        currentSources: args.currentSources ?? [],\n      }),\n    });\n  }\n}\n","numLines":370,"startLine":1,"totalLines":370}}}
