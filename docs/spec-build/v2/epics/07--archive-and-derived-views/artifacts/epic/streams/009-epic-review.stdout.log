rdedAt ?? new Date().toISOString(),\n138\t    });\n139\t    await invalidateArchiveDerivedCaches(ctx, processRecord._id);\n140\t    const storedEntry = await ctx.db.get(archiveEntryId);\n141\t\n142\t    if (storedEntry === null) {\n143\t      throw new Error('Archive entry was not found after append.');\n144\t    }\n145\t\n146\t    return buildArchiveEntry(storedEntry);\n147\t  },\n148\t});\n149\t\n150\texport const listArchiveEntries = query({\n151\t  args: archiveListArgsValidator,\n152\t  handler: async (ctx: QueryCtx, args): Promise<ArchivePage> => {\n153\t    assertArchivePageLimit(args.limit);\n154\t    const processId = args.processId as Id<'processes'>;\n155\t    const decodedCursor = decodeArchiveCursor(args.cursor ?? null);\n156\t    const pageWithLookahead = await ctx.db\n157\t      .query('archiveEntries')\n158\t      .withIndex('by_processId_and_sequence', (indexQuery) =>\n159\t        decodedCursor === null\n160\t          ? indexQuery.eq('processId', processId)\n161\t          : indexQuery.eq('processId', processId).gt('sequence', decodedCursor),\n162\t      )\n163\t      .order('asc')\n164\t      .take(args.limit + 1);\n165\t    const hasMore = pageWithLookahead.length > args.limit;\n166\t    const pageEntries = pageWithLookahead\n167\t      .slice(0, args.limit)\n168\t      .map((entry) => buildArchiveEntry(entry));\n169\t    const lastEntry = pageEntries.at(-1);\n170\t\n171\t    return {\n172\t      entries: pageEntries,\n173\t      page: {\n174\t        cursor: args.cursor ?? null,\n175\t        nextCursor: hasMore && lastEntry !== undefined ? String(lastEntry.sequence) : null,\n176\t        hasMore,\n177\t      },\n178\t    };\n179\t  },\n180\t});\n181\t\n182\texport const patchArchiveEntry = mutation({\n183\t  args: archivePatchArgsValidator,\n184\t  handler: async (ctx: MutationCtx, args): Promise<ArchiveEntry | null> => {\n185\t    if (args.finalizationKey.trim().length === 0) {\n186\t      throw new Error('Archive entries require a non-empty 