341\t    relatedToolCallId: overrides.relatedToolCallId ?? null,\n342\t    entryStatus: overrides.entryStatus ?? 'ready',\n343\t    degradationReason: overrides.degradationReason ?? null,\n344\t    recordedAt: overrides.recordedAt ?? '2026-05-01T10:05:00.000Z',\n345\t  };\n346\t}\n347\t\n348\tfunction buildArchiveCtx(seed: Parameters<typeof createFakeConvexContext>[0]) {\n349\t  const fixture = createFakeConvexContext(seed);\n350\t  fixture.registry.register(\n351\t    'derivedArchiveViews:replaceDerivedArchiveViews',\n352\t    replaceDerivedArchiveViewsHandler as unknown as (\n353\t      ctx: unknown,\n354\t      args: unknown,\n355\t    ) => Promise<unknown>,\n356\t  );\n357\t  fixture.registry.register(\n358\t    'derivedArchiveViews:listDerivedArchiveViews',\n359\t    listDerivedArchiveViewsHandler as unknown as (ctx: unknown, args: unknown) => Promise<unknown>,\n360\t  );\n361\t\n362\t  return fixture;\n363\t}\n364\t\n365\tdescribe('convex/archiveEntries', () => {\n366\t  const originalApiKey = readRuntimeApiKey();\n367\t\n368\t  beforeEach(() => {\n369\t    writeRuntimeApiKey('test-convex-api-key');\n370\t  });\n371\t\n372\t  afterEach(() => {\n373\t    writeRuntimeApiKey(originalApiKey);\n374\t  });\n375\t\n376\t  it('TC-1.2a accepts required archive entry kinds', async () => {\n377\t    const { ctx } = createFakeConvexContext({\n378\t      ...buildArchiveSeed(),\n379\t      archiveEntries: [],\n380\t    });\n381\t    const requiredKinds = [\n382\t      'user_message',\n383\t      'model_message',\n384\t      'reasoning',\n385\t      'script_emission',\n386\t      'tool_call',\n387\t      'tool_result',\n388\t      'process_event',\n389\t    ] as const;\n390\t\n391\t    for (const [index, entryKind] of requiredKinds.entries()) {\n392\t      const entry = await appendArchiveEntryHandler(\n393\t        ctx,\n394\t        buildAppendArgs({\n395\t          entryKind,\n396\t          finalizationKey: `${entryKind}:${index}`,\n397\t          recordedAt: `2026-05-01