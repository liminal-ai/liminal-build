didates must supply a meaningful message so the commit log is not\n126\t   * littered with generic text.\n127\t   */\n128\t  commitMessage: string;\n129\t}\n130\t\n131\texport type ProcessExecutionStatus = 'running' | 'waiting' | 'completed' | 'failed' | 'interrupted';\n132\t\n133\texport interface RuntimeArchiveEntry {\n134\t  entryKind: ArchiveEntryKind;\n135\t  finalizationKey: string;\n136\t  sourceObjectId: string;\n137\t  bodyText: string | null;\n138\t  bodyData: ArchiveEntryBodyData | null;\n139\t  bodyFormat: ArchiveBodyFormat;\n140\t  relatedArtifactVersionId?: string | null;\n141\t  relatedSourceProvenanceId?: string | null;\n142\t  relatedToolCallId?: string | null;\n143\t  entryStatus?: ArchiveEntryStatus;\n144\t  degradationReason?: string | null;\n145\t  recordedAt?: string;\n146\t  artifactCheckpointIndex?: number | null;\n147\t  sourceProvenanceBinding?: {\n148\t    relationshipKind: SourceProvenanceEntry['relationshipKind'];\n149\t    sourceAttachmentId: string;\n150\t  } | null;\n151\t}\n152\t\n153\texport interface ExecutionResult {\n154\t  processStatus: ProcessExecutionStatus;\n155\t  processHistoryItems: ProcessHistoryItem[];\n156\t  archiveEntries?: RuntimeArchiveEntry[];\n157\t  outputWrites: PlatformProcessOutputWriteInput[];\n158\t  sideWorkWrites: PlatformSideWorkWriteInput[];\n159\t  artifactCheckpointCandidates: ArtifactCheckpointCandidate[];\n160\t  codeCheckpointCandidates: CodeCheckpointCandidate[];\n161\t  usedSourceAttachmentIds?: string[];\n162\t}\n163\t\n164\texport interface ProviderAdapter {\n165\t  readonly providerKind: ProviderKind;\n166\t  ensureEnvironment(args: EnsureEnvironmentArgs): Promise<EnsuredEnvironment>;\n167\t  hydrateEnvironment(args: {\n168\t    environmentId: string;\n169\t    plan: HydrationPlan;\n170\t  }): Promise<HydrationResult>;\n171\t  executeScript(args: ExecuteEnvironmentScriptArgs): Promise<ExecutionResult>;\n172\t  rehydrateEnvironment(args: {\n173\t    environmentId: string;\n174\t    plan: HydrationPlan;\n175\t  }): Promise<HydrationResult>;\n176\t  rebuildEnvironment(args: {\n177\t    processId: string;\n178\t    previousEnvironmentId: string | null;\n179\t    providerKind: ProviderKind;\n180\t    plan: HydrationPlan;\n181\t  }): Promise<HydrationResult & EnsuredEnvironment>;\n182\t  teardownEnvironment(args: { environmentId: string }): Promise<void>;\n183\t  resolveCandidateContents(args: ResolveCandidateContentsArgs): Promise<string>;\n184\t}\n185\t\n186\texport type ProviderFailureState = 'failed' | 'unavailable' | 'lost';\n187\t\n188\texport class ProviderLifecycleError extends Error {\n189\t  readonly environmentState: ProviderFailureState;\n190\t\n191\t  constructor(environmentState: ProviderFailureState, message: string) {\n192\t    super(message);\n193\t    this.name = 'ProviderLifecycleError';\n194\t    this.environmentState = environmentState;\n195\t  }\n196\t}\n197\t\n198\t/**\n199\t * In-memory test fake. Produces deterministic results in the new spec'd\n200\t * `ExecutionResult` shape for unit tests and fixture-driven scenarios. NOT\n201\t * wired as the production provider — production resolves a real adapter via\n202\t * the registry.\n203\t */\n204\texport class InMemoryProviderAdapter implements ProviderAdapter {\n205\t  readonly providerKind: ProviderKind = 'local';\n206\t  private readonly processIdByEnvironmentId = new Map<string, string>();\n207\t\n208\t  async ensureEnvironment(args: EnsureEnvironmentArgs): Promise<EnsuredEnvironment> {\n209\t    const environmentId = `env-mem-${args.processId}`;\n210\t    this.processIdByEnvironmentId.set(environmentId, args.processId);\n211\t    return {\n212\t      providerKind: args.providerKind,\n213\t      environmentId,\n214\t      workspaceHandle: `workspace-mem-${args.processId}`,\n215\t    };\n216\t  }\n217\t\n218\t  async hydrateEnvironment(args: {\n219\t    environmentId: string;\n220\t    plan: HydrationPlan;\n221\t  }): Promise<HydrationResult> {\n222\t    return {\n223\t      environmen