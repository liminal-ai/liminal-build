{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C25iQuYegnjtDMyvySJDeu","type":"tool_result","content":"1\timport type {\n2\t  ArchiveEntry,\n3\t  ArchiveEntryArtifactProvenance,\n4\t  ArchiveEntrySourceProvenance,\n5\t  SourceProvenanceEntry,\n6\t} from '../../../shared/contracts/index.js';\n7\timport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\n8\timport type { ArtifactVersionRecord, PlatformStore } from '../projects/platform-store.js';\n9\t\n10\texport async function enrichArchiveEntries(args: {\n11\t  entries: ArchiveEntry[];\n12\t  projectId: string;\n13\t  processId: string;\n14\t  platformStore: Pick<PlatformStore, 'getArtifactVersion'> & {\n15\t    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n16\t  };\n17\t  sourceProvenanceService?: Pick<SourceProvenanceService, 'listProcessSourceProvenance'>;\n18\t}): Promise<ArchiveEntry[]> {\n19\t  const artifactVersionIds = Array.from(\n20\t    new Set(\n21\t      args.entries\n22\t        .map((entry) => entry.relatedArtifactVersionId)\n23\t        .filter((versionId): versionId is string => versionId !== null),\n24\t    ),\n25\t  );\n26\t  const artifactVersions = await Promise.all(\n27\t    artifactVersionIds.map(async (versionId) => {\n28\t      try {\n29\t        return [versionId, await args.platformStore.getArtifactVersion({ versionId })] as const;\n30\t      } catch {\n31\t        return [versionId, null] as const;\n32\t      }\n33\t    }),\n34\t  );\n35\t  const artifactVersionsById = new Map<string, ArtifactVersionRecord | null>(artifactVersions);\n36\t  const producingProcessIds = Array.from(\n37\t    new Set(\n38\t      artifactVersions\n39\t        .map(([, version]) => version?.createdByProcessId ?? null)\n40\t        .filter((processId): processId is string => processId !== null),\n41\t    ),\n42\t  );\n43\t  const processes =\n44\t    args.platformStore.listProcessesByIds === undefined || producingProcessIds.length === 0\n45\t      ? []\n46\t      : await loadProcessesByIds(args.platformStore, producingProcessIds);\n47\t  const processDisplayLabelsById = new Map(\n48\t    processes.map((processRecord) => [processRecord.processId, processRecord.displayLabel]),\n49\t  );\n50\t  const sourceProvenanceEntries =\n51\t    args.sourceProvenanceService === undefined\n52\t      ? []\n53\t      : await loadSourceProvenanceEntries(args.sourceProvenanceService, {\n54\t          projectId: args.projectId,\n55\t          processId: args.processId,\n56\t        });\n57\t  const sourceEntriesById = new Map(\n58\t    sourceProvenanceEntries.map((entry) => [entry.provenanceId, entry] as const),\n59\t  );\n60\t\n61\t  return args.entries.map((entry) =>\n62\t    buildEnrichedArchiveEntry(entry, {\n63\t      artifactVersion: resolveArtifactVersion(entry, artifactVersionsById),\n64\t      producingProcessDisplayLabelsById: processDisplayLabelsById,\n65\t      sourceEntry:\n66\t        entry.relatedSourceProvenanceId === null\n67\t          ? null\n68\t          : (sourceEntriesById.get(entry.relatedSourceProvenanceId) ?? null),\n69\t    }),\n70\t  );\n71\t}\n72\t\n73\tfunction resolveArtifactVersion(\n74\t  entry: ArchiveEntry,\n75\t  artifactVersionsById: Map<string, ArtifactVersionRecord | null>,\n76\t): ArtifactVersionRecord | null {\n77\t  if (entry.relatedArtifactVersionId === null) {\n78\t    return null;\n79\t  }\n80\t\n81\t  return artifactVersionsById.get(entry.relatedArtifactVersionId) ?? null;\n82\t}\n83\t\n84\tfunction buildEnrichedArchiveEntry(\n85\t  entry: ArchiveEntry,\n86\t  args: {\n87\t    artifactVersion: ArtifactVersionRecord | null;\n88\t    producingProcessDisplayLabelsById: Map<string, string>;\n89\t    sourceEntry: SourceProvenanceEntry | null;\n90\t  },\n91\t): ArchiveEntry {\n92\t  const degradationReasons = entry.degradationReason === null ? [] : [entry.degradationReason];\n93\t  let relatedArtifactProvenance: ArchiveEntryArtifactProvenance | undefined;\n94\t  let relatedSourceProvenance: ArchiveEntrySourceProvenance | undefined;\n95\t\n96\t  if (entry.relatedArtifactVersionId !== null) {\n97\t    if (args.artifactVersion === null) {\n98\t      degradationReasons.push('Related artifact version is unavailable.');\n99\t    } else {\n100\t      const producedByProcessDisplayLabel =\n101\t        args.producingProcessDisplayLabelsById.get(args.artifactVersion.createdByProcessId) ?? null;\n102\t      relatedArtifactProvenance = {\n103\t        versionId: args.artifactVersion.versionId,\n104\t        artifactId: args.artifactVersion.artifactId,\n105\t        versionLabel: args.artifactVersion.versionLabel,\n106\t        createdAt: args.artifactVersion.createdAt,\n107\t        producedByProcessId: args.artifactVersion.createdByProcessId,\n108\t        producedByProcessDisplayLabel,\n109\t      };\n110\t\n111\t      if (producedByProcessDisplayLabel === null) {\n112\t        degradationReasons.push(\n113\t          'Producing process provenance is unavailable for the related artifact version.',\n114\t        );\n115\t      }\n116\t    }\n117\t  }\n118\t\n119\t  if (entry.relatedSourceProvenanceId !== null) {\n120\t    if (args.sourceEntry === null) {\n121\t      degradationReasons.push('Related source provenance is unavailable.');\n122\t    } else {\n123\t      relatedSourceProvenance = {\n124\t        provenanceId: args.sourceEntry.provenanceId,\n125\t        sourceAttachmentId: args.sourceEntry.sourceAttachmentId,\n126\t        relationshipKind: args.sourceEntry.relationshipKind,\n127\t        repositoryFullName: args.sourceEntry.repositoryFullName,\n128\t        repositoryUrl: args.sourceEntry.repositoryUrl,\n129\t        targetRef: args.sourceEntry.targetRef,\n130\t        entryStatus: args.sourceEntry.entryStatus,\n131\t        degradationReason: args.sourceEntry.degradationReason,\n132\t        recordedAt: args.sourceEntry.recordedAt,\n133\t      };\n134\t\n135\t      if (\n136\t        args.sourceEntry.entryStatus === 'degraded' &&\n137\t        args.sourceEntry.degradationReason !== null\n138\t      ) {\n139\t        degradationReasons.push(args.sourceEntry.degradationReason);\n140\t      }\n141\t    }\n142\t  }\n143\t\n144\t  const nextDegradationReason = dedupeStrings(degradationReasons).join(' ') || null;\n145\t\n146\t  return {\n147\t    ...entry,\n148\t    ...(relatedArtifactProvenance === undefined ? {} : { relatedArtifactProvenance }),\n149\t    ...(relatedSourceProvenance === undefined ? {} : { relatedSourceProvenance }),\n150\t    entryStatus: nextDegradationReason === null ? 'ready' : 'degraded',\n151\t    degradationReason: nextDegradationReason,\n152\t  };\n153\t}\n154\t\n155\tfunction dedupeStrings(values: string[]): string[] {\n156\t  return [...new Set(values)];\n157\t}\n158\t\n159\tasync function loadProcessesByIds(\n160\t  platformStore: {\n161\t    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n162\t  },\n163\t  processIds: string[],\n164\t): Promise<Array<Awaited<ReturnType<NonNullable<PlatformStore['listProcessesByIds']>>>[number]>> {\n165\t  if (platformStore.listProcessesByIds === undefined || processIds.length === 0) {\n166\t    return [];\n167\t  }\n168\t\n169\t  try {\n170\t    return await platformStore.listProcessesByIds({\n171\t      processIds,\n172\t    });\n173\t  } catch {\n174\t    return [];\n175\t  }\n176\t}\n177\t\n178\tasync function loadSourceProvenanceEntries(\n179\t  sourceProvenanceService: Pick<SourceProvenanceService, 'listProcessSourceProvenance'>,\n180\t  args: {\n181\t    projectId: string;\n182\t    processId: string;\n183\t  },\n184\t): Promise<SourceProvenanceEntry[]> {\n185\t  try {\n186\t    const response = await sourceProvenanceService.listProcessSourceProvenance(args);\n187\t    return response.entries;\n188\t  } catch {\n189\t    return [];\n190\t  }\n191\t}\n192\t"}]},"parent_tool_use_id":null,"session_id":"8366fdc4-8e5c-4246-9b1c-47fd55763cba","uuid":"21dc10d8-3fb6-4856-8db2-8adcd0311d0d","timestamp":"2026-05-05T23:31:14.184Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/liminal-build/apps/platform/server/services/archive/archive-entry-enrichment.ts","content":"import type {\n  ArchiveEntry,\n  ArchiveEntryArtifactProvenance,\n  ArchiveEntrySourceProvenance,\n  SourceProvenanceEntry,\n} from '../../../shared/contracts/index.js';\nimport type { SourceProvenanceService } from '../sources/source-provenance.service.js';\nimport type { ArtifactVersionRecord, PlatformStore } from '../projects/platform-store.js';\n\nexport async function enrichArchiveEntries(args: {\n  entries: ArchiveEntry[];\n  projectId: string;\n  processId: string;\n  platformStore: Pick<PlatformStore, 'getArtifactVersion'> & {\n    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n  };\n  sourceProvenanceService?: Pick<SourceProvenanceService, 'listProcessSourceProvenance'>;\n}): Promise<ArchiveEntry[]> {\n  const artifactVersionIds = Array.from(\n    new Set(\n      args.entries\n        .map((entry) => entry.relatedArtifactVersionId)\n        .filter((versionId): versionId is string => versionId !== null),\n    ),\n  );\n  const artifactVersions = await Promise.all(\n    artifactVersionIds.map(async (versionId) => {\n      try {\n        return [versionId, await args.platformStore.getArtifactVersion({ versionId })] as const;\n      } catch {\n        return [versionId, null] as const;\n      }\n    }),\n  );\n  const artifactVersionsById = new Map<string, ArtifactVersionRecord | null>(artifactVersions);\n  const producingProcessIds = Array.from(\n    new Set(\n      artifactVersions\n        .map(([, version]) => version?.createdByProcessId ?? null)\n        .filter((processId): processId is string => processId !== null),\n    ),\n  );\n  const processes =\n    args.platformStore.listProcessesByIds === undefined || producingProcessIds.length === 0\n      ? []\n      : await loadProcessesByIds(args.platformStore, producingProcessIds);\n  const processDisplayLabelsById = new Map(\n    processes.map((processRecord) => [processRecord.processId, processRecord.displayLabel]),\n  );\n  const sourceProvenanceEntries =\n    args.sourceProvenanceService === undefined\n      ? []\n      : await loadSourceProvenanceEntries(args.sourceProvenanceService, {\n          projectId: args.projectId,\n          processId: args.processId,\n        });\n  const sourceEntriesById = new Map(\n    sourceProvenanceEntries.map((entry) => [entry.provenanceId, entry] as const),\n  );\n\n  return args.entries.map((entry) =>\n    buildEnrichedArchiveEntry(entry, {\n      artifactVersion: resolveArtifactVersion(entry, artifactVersionsById),\n      producingProcessDisplayLabelsById: processDisplayLabelsById,\n      sourceEntry:\n        entry.relatedSourceProvenanceId === null\n          ? null\n          : (sourceEntriesById.get(entry.relatedSourceProvenanceId) ?? null),\n    }),\n  );\n}\n\nfunction resolveArtifactVersion(\n  entry: ArchiveEntry,\n  artifactVersionsById: Map<string, ArtifactVersionRecord | null>,\n): ArtifactVersionRecord | null {\n  if (entry.relatedArtifactVersionId === null) {\n    return null;\n  }\n\n  return artifactVersionsById.get(entry.relatedArtifactVersionId) ?? null;\n}\n\nfunction buildEnrichedArchiveEntry(\n  entry: ArchiveEntry,\n  args: {\n    artifactVersion: ArtifactVersionRecord | null;\n    producingProcessDisplayLabelsById: Map<string, string>;\n    sourceEntry: SourceProvenanceEntry | null;\n  },\n): ArchiveEntry {\n  const degradationReasons = entry.degradationReason === null ? [] : [entry.degradationReason];\n  let relatedArtifactProvenance: ArchiveEntryArtifactProvenance | undefined;\n  let relatedSourceProvenance: ArchiveEntrySourceProvenance | undefined;\n\n  if (entry.relatedArtifactVersionId !== null) {\n    if (args.artifactVersion === null) {\n      degradationReasons.push('Related artifact version is unavailable.');\n    } else {\n      const producedByProcessDisplayLabel =\n        args.producingProcessDisplayLabelsById.get(args.artifactVersion.createdByProcessId) ?? null;\n      relatedArtifactProvenance = {\n        versionId: args.artifactVersion.versionId,\n        artifactId: args.artifactVersion.artifactId,\n        versionLabel: args.artifactVersion.versionLabel,\n        createdAt: args.artifactVersion.createdAt,\n        producedByProcessId: args.artifactVersion.createdByProcessId,\n        producedByProcessDisplayLabel,\n      };\n\n      if (producedByProcessDisplayLabel === null) {\n        degradationReasons.push(\n          'Producing process provenance is unavailable for the related artifact version.',\n        );\n      }\n    }\n  }\n\n  if (entry.relatedSourceProvenanceId !== null) {\n    if (args.sourceEntry === null) {\n      degradationReasons.push('Related source provenance is unavailable.');\n    } else {\n      relatedSourceProvenance = {\n        provenanceId: args.sourceEntry.provenanceId,\n        sourceAttachmentId: args.sourceEntry.sourceAttachmentId,\n        relationshipKind: args.sourceEntry.relationshipKind,\n        repositoryFullName: args.sourceEntry.repositoryFullName,\n        repositoryUrl: args.sourceEntry.repositoryUrl,\n        targetRef: args.sourceEntry.targetRef,\n        entryStatus: args.sourceEntry.entryStatus,\n        degradationReason: args.sourceEntry.degradationReason,\n        recordedAt: args.sourceEntry.recordedAt,\n      };\n\n      if (\n        args.sourceEntry.entryStatus === 'degraded' &&\n        args.sourceEntry.degradationReason !== null\n      ) {\n        degradationReasons.push(args.sourceEntry.degradationReason);\n      }\n    }\n  }\n\n  const nextDegradationReason = dedupeStrings(degradationReasons).join(' ') || null;\n\n  return {\n    ...entry,\n    ...(relatedArtifactProvenance === undefined ? {} : { relatedArtifactProvenance }),\n    ...(relatedSourceProvenance === undefined ? {} : { relatedSourceProvenance }),\n    entryStatus: nextDegradationReason === null ? 'ready' : 'degraded',\n    degradationReason: nextDegradationReason,\n  };\n}\n\nfunction dedupeStrings(values: string[]): string[] {\n  return [...new Set(values)];\n}\n\nasync function loadProcessesByIds(\n  platformStore: {\n    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n  },\n  processIds: string[],\n): Promise<Array<Awaited<ReturnType<NonNullable<PlatformStore['listProcessesByIds']>>>[number]>> {\n  if (platformStore.listProcessesByIds === undefined || processIds.length === 0) {\n    return [];\n  }\n\n  try {\n    return await platformStore.listProcessesByIds({\n      processIds,\n    });\n  } catch {\n    return [];\n  }\n}\n\nasync function loadSourceProvenanceEntries(\n  sourceProvenanceService: Pick<SourceProvenanceService, 'listProcessSourceProvenance'>,\n  args: {\n    projectId: string;\n    processId: string;\n  },\n): Promise<SourceProvenanceEntry[]> {\n  try {\n    const response = await sourceProvenanceService.listProcessSourceProvenance(args);\n    return response.entries;\n  } catch {\n    return [];\n  }\n}\n","numLines":192,"startLine":1,"totalLines":192}}}
