{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B5rdU3FRBshWHxxbQKw4zi","type":"tool_result","content":"1\timport type { ArchiveEntry, ArchivePage } from '../apps/platform/shared/contracts/index.js';\n2\timport type { Doc, Id } from './_generated/dataModel.js';\n3\timport { mutation, query, type MutationCtx, type QueryCtx } from './_generated/server.js';\n4\timport { v } from 'convex/values';\n5\t\n6\texport const archiveEntryKindValidator = v.union(\n7\t  v.literal('user_message'),\n8\t  v.literal('model_message'),\n9\t  v.literal('reasoning'),\n10\t  v.literal('script_emission'),\n11\t  v.literal('tool_call'),\n12\t  v.literal('tool_result'),\n13\t  v.literal('process_event'),\n14\t);\n15\t\n16\texport const archiveEntryLifecycleStateValidator = v.literal('finalized');\n17\t\n18\texport const archiveBodyFormatValidator = v.union(\n19\t  v.literal('plain_text'),\n20\t  v.literal('markdown'),\n21\t  v.literal('structured'),\n22\t  v.literal('none'),\n23\t);\n24\t\n25\texport const archiveEntryStatusValidator = v.union(v.literal('ready'), v.literal('degraded'));\n26\t\n27\texport const archiveEntryBodyDataValidator = v.object({\n28\t  jsonText: v.string(),\n29\t});\n30\t\n31\texport const archiveEntriesTableFields = {\n32\t  projectId: v.string(),\n33\t  processId: v.id('processes'),\n34\t  entryKind: archiveEntryKindValidator,\n35\t  sequence: v.number(),\n36\t  lifecycleState: archiveEntryLifecycleStateValidator,\n37\t  finalizationKey: v.string(),\n38\t  sourceObjectId: v.union(v.string(), v.null()),\n39\t  bodyText: v.union(v.string(), v.null()),\n40\t  bodyData: v.union(archiveEntryBodyDataValidator, v.null()),\n41\t  bodyFormat: archiveBodyFormatValidator,\n42\t  relatedArtifactVersionId: v.union(v.id('artifactVersions'), v.null()),\n43\t  relatedSourceProvenanceId: v.union(v.string(), v.null()),\n44\t  relatedToolCallId: v.union(v.string(), v.null()),\n45\t  entryStatus: archiveEntryStatusValidator,\n46\t  degradationReason: v.union(v.string(), v.null()),\n47\t  recordedAt: v.string(),\n48\t};\n49\t\n50\tconst archiveEntryWriteArgsValidator = {\n51\t  projectId: v.string(),\n52\t  processId: v.string(),\n53\t  entryKind: archiveEntryKindValidator,\n54\t  finalizationKey: v.string(),\n55\t  sourceObjectId: v.optional(v.union(v.string(), v.null())),\n56\t  bodyText: v.optional(v.union(v.string(), v.null())),\n57\t  bodyData: v.optional(v.union(archiveEntryBodyDataValidator, v.null())),\n58\t  bodyFormat: archiveBodyFormatValidator,\n59\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n60\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n61\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n62\t  entryStatus: v.optional(archiveEntryStatusValidator),\n63\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n64\t  recordedAt: v.optional(v.string()),\n65\t} as const;\n66\t\n67\tconst archiveListArgsValidator = {\n68\t  processId: v.string(),\n69\t  cursor: v.optional(v.union(v.string(), v.null())),\n70\t  limit: v.number(),\n71\t} as const;\n72\t\n73\tconst archivePatchArgsValidator = {\n74\t  processId: v.string(),\n75\t  finalizationKey: v.string(),\n76\t  relatedArtifactVersionId: v.optional(v.union(v.string(), v.null())),\n77\t  relatedSourceProvenanceId: v.optional(v.union(v.string(), v.null())),\n78\t  relatedToolCallId: v.optional(v.union(v.string(), v.null())),\n79\t  entryStatus: v.optional(archiveEntryStatusValidator),\n80\t  degradationReason: v.optional(v.union(v.string(), v.null())),\n81\t} as const;\n82\t\n83\tconst MAX_ARCHIVE_PAGE_SIZE = 200;\n84\tconst supportedArchiveEntryKinds = new Set([\n85\t  'user_message',\n86\t  'model_message',\n87\t  'reasoning',\n88\t  'script_emission',\n89\t  'tool_call',\n90\t  'tool_result',\n91\t  'process_event',\n92\t] satisfies ArchiveEntry['entryKind'][]);\n93\t\n94\texport const appendArchiveEntry = mutation({\n95\t  args: archiveEntryWriteArgsValidator,\n96\t  handler: asy