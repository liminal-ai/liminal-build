erver/review-export-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/package-review-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/nfr.test.ts\\\\\\\",\\\\\\\"tests/service/server/observability.test.ts\\\\\\\",\\\\\\\"tests/service/client/artifact-review-panel.test.ts\\\\\\\",\\\\\\\"tests/service/client/artifact-section.test.ts\\\\\\\",\\\\\\\"tests/integration/platform-shell.test.ts\\\\\\\"],\\\\\\\"removed\\\\\\\":[],\\\\\\\"totalAfterStory\\\\\\\":552,\\\\\\\"deltaFromPriorBaseline\\\\\\\":1},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run green-verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run verify-all\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"}],\\\\\\\"selfReview\\\\\\\":{\\\\\\\"passesRun\\\\\\\":3,\\\\\\\"findingsFixed\\\\\\\":[\\\\\\\"Removed artifact ownership fields from project-shell artifact summaries and rendering while preserving process-local artifact references.\\\\\\\",\\\\\\\"Added provenance ids and display labels to review version contracts and patched store/service/test scaffolding to emit them consistently.\\\\\\\",\\\\\\\"Added durable process package-context tables plus store methods with canonical upsert and idempotent semantics.\\\\\\\",\\\\\\\"Fixed the production-shell integration assertion to resolve the built asset from the active worktree instead of a hard-coded sibling checkout path.\\\\\\\"],\\\\\\\"findingsSurfaced\\\\\\\":[\\\\\\\"Browser-facing package member contracts still carry the legacy `versionId` name as a compatibility shim; later Epic 5 stories still need the full surface rename to `artifactVersionId`.\\\\\\\",\\\\\\\"Review target schemas still accept legacy `REVIEW_MEMBER_UNAVAILABLE` alongside `PACKAGE_MEMBER_UNAVAILABLE` as a compatibility bridge until downstream package-review callers are fully migrated.\\\\\\\"]},\\\\\\\"openQuestions\\\\\\\":[],\\\\\\\"specDeviations\\\\\\\":[\\\\\\\"Browser-facing package membe