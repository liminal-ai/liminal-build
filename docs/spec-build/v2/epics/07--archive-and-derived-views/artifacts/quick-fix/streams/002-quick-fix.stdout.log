arlier process.\\\\\\\\\\\\\\\"}],\\\\\\\\\\\\\\\"tests\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"added\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"modified\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"tests/service/server/project-shell-bootstrap-api.test.ts\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tests/service/server/process-work-surface-api.test.ts\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tests/service/server/artifact-review-api.test.ts\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\"removed\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"totalAfterStory\\\\\\\\\\\\\\\":556,\\\\\\\\\\\\\\\"deltaFromPriorBaseline\\\\\\\\\\\\\\\":3},\\\\\\\\\\\\\\\"gatesRun\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"corepack pnpm run green-verify\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"result\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"pass\\\\\\\\\\\\\\\"},{\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"corepack pnpm run verify-all\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"result\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"pass\\\\\\\\\\\\\\\"}],\\\\\\\\\\\\\\\"selfReview\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"findingsFixed\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"Confirmed AC-1.1 through AC-1.3 are covered in behavior by stripping shell ownership fields, preserving process-local current-material projection, and enabling referenced-artifact review entry without ownership transfer.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Validated the in-scope test-plan obligations with added server coverage for shell summary shape, current-material reference behavior, and cross-process referenced review access.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Caught and fixed the temporary integration regression from a too-narrow current-ref-only reviewability rule, then re-ran both story and epic gates successfully.\\\\\\\\\\\\\\\"],\\\\\\\\\\\\\\\"findingsSurfaced\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"Legacy artifact-row ownership hints still exist in some internal durable/test seams as compatibility residue; this story stops relying on them in the affected read paths, but Story 2 remains the write-path cleanup point.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Review eligibility now intentionally unions current refs with produced-artifact visibility to preserve existing shipped behavior during this chunk; a later epic/story can narrow or replace that compatibility path once package-context and full review-context alignment land.\\\\\\\\\\\\\\\"]},\\\\\\\\\\\\\\\"openQuestions\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"specDeviations\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"recommendedNextStep\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Proceed to verification with focused checks on cross-process artifact reference behavior in the project shell, process materials, and review entry paths, then carry the deferred write-path and compatibility cleanup into Story 2 and later review-context alignment work.\\\\\\\\\\\\\\\"}\\\\\\\"}}\\\\napps/platform/shared/contracts/schemas.ts:34:export const attachmentScopeSchema = z.enum(['project', 'process']);\\\\napps/platform/shared/contracts/schemas.ts:35:export type AttachmentScope = z.infer<typeof attachmentScopeSchema>;\\\\napps/platform/shared/contracts/schemas.ts:155:export type ArtifactSummary = z.infer<typeof artifactSummarySchema> & {\\\\napps/platform/shared/contracts/schemas.ts:156:  attachmentScope?: AttachmentScope;\\\\napps/platform/shared/contracts/schemas.ts:158:  processDisplayLabel?: string | null;\\\\napps/platform/shared/contracts/schemas.ts:173:  attachmentScope: attachmentScopeSchema,\\\\napps/platform/shared/contracts/schemas.ts:175:  processDisplayLabel: z.string().min(1).nullable(),\\\\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/004-self-review-pass-3.json:1:{\\\\\\\"resultId\\\\\\\":\\\\\\\"dd90a8d2-6bab-472f-aaaf-9a44c9e87b49\\\\\\\",\\\\\\\"provider\\\\\\\":\\\\\\\"codex\\\\\\\",\\\\\\\"model\\\\\\\":\\\\\\\"gpt-5.4\\\\\\\",\\\\\\\"role\\\\\\\":\\\\\\\"story_self_review_pass\\\\\\\",\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\",\\\\\\\"sessionId\\\\\\\":\\\\\\\"019dcb8d-54d4-7882-8bd6-b820edf