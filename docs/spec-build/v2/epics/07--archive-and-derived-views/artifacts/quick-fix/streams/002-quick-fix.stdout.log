\t  availableActions: ['start'],\\n    41\\t});\\n    42\\t\\n    43\\texport const runningProcessSurfaceFixture = processSurfaceSummarySchema.parse({\\n    44\\t  ...baseProcessSurfaceSummary,\\n    45\\t  processId: 'process-surface-running-001',\\n    46\\t  status: 'running',\\n    47\\t  nextActionLabel: 'Monitor progress in the work surface',\\n    48\\t  availableActions: ['review'],\\n    49\\t});\\n    50\\t\\n    51\\texport const waitingProcessSurfaceFixture = processSurfaceSummarySchema.parse({\\n    52\\t  ...baseProcessSurfaceSummary,\\n    53\\t  processId: 'process-surface-waiting-001',\\n    54\\t  status: 'waiting',\\n    55\\t  nextActionLabel: 'Respond to the current request',\\n    56\\t  availableActions: ['respond'],\\n    57\\t});\\n    58\\t\\n    59\\texport const pausedProcessSurfaceFixture = processSurfaceSummarySchema.parse({\\n    60\\t  ...baseProcessSurfaceSummary,\\n    61\\t  processId: 'process-surface-paused-001',\\n    62\\t  status: 'paused',\\n    63\\t  nextActionLabel: 'Resume the process to continue working',\\n    64\\t  availableActions: ['resume'],\\n    65\\t});\\n    66\\t\\n    67\\texport const interruptedProcessSurfaceFixture = processSurfaceSummarySchema.parse({\\n    68\\t  ...baseProcessSurfaceSummary,\\n    69\\t  processId: 'process-surface-interrupted-001',\\n    70\\t  status: 'interrupted',\\n    71\\t  nextActionLabel: 'Resume the process to continue working',\\n    72\\t  availableActions: ['resume', 'review', 'restart'],\\n    73\\t});\\n    74\\t\\n    75\\texport const completedProcessSurfaceFixture = processSurfaceSummarySchema.parse({\\n    76\\t  ...baseProcessSurfaceSummary,\\n    77\\t  processId: 'process-surface-completed-001',\\n    78\\t  status: 'completed',\\n    79\\t  nextActionLabel: null,\\n    80\\t  availableActions: ['review'],\\n    81\\t});\\n    82\\t\\n    83\\texport const failedProcessSurfaceFixture = processSurfaceSummarySchema.parse({\\n    84\\t  ...baseProcessSurfaceSummary,\\