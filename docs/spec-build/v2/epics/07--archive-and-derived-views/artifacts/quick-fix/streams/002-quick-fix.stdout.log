ct: processSurfaceProjectFixture,\\n   128\\t  process: interruptedProcessSurfaceFixture,\\n   129\\t  history: emptyProcessHistoryFixture,\\n   130\\t  materials: emptyProcessMaterialsFixture,\\n   131\\t  currentRequest: null,\\n   132\\t  sideWork: emptySideWorkFixture,\\n   133\\t});\\n   134\\t\\n   135\\texport const degradedProcessWorkSurfaceFixture = processWorkSurfaceResponseSchema.parse({\\n   136\\t  project: processSurfaceProjectFixture,\\n   137\\t  process: runningProcessSurfaceFixture,\\n   138\\t  history: errorProcessHistoryFixture,\\n   139\\t  materials: errorProcessMaterialsFixture,\\n   140\\t  currentRequest: null,\\n   141\\t  sideWork: errorSideWorkFixture,\\n   142\\t});\\n   143\\t\\n   144\\texport const startedProcessResponseFixture = startProcessResponseSchema.parse({\\n   145\\t  process: processSurfaceSummarySchema.parse({\\n   146\\t    ...runningProcessSurfaceFixture,\\n   147\\t    processId: draftProcessSurfaceFixture.processId,\\n   148\\t    phaseLabel: draftProcessSurfaceFixture.phaseLabel,\\n   149\\t    updatedAt: '2026-04-13T12:20:00.000Z',\\n   150\\t  }),\\n   151\\t  currentRequest: null,\\n   152\\t});\\n   153\\t\\n   154\\texport const resumedPausedProcessResponseFixture = resumeProcessResponseSchema.parse({\\n   155\\t  process: processSurfaceSummarySchema.parse({\\n   156\\t    ...runningProcessSurfaceFixture,\\n   157\\t    processId: pausedProcessSurfaceFixture.processId,\\n   158\\t    phaseLabel: pausedProcessSurfaceFixture.phaseLabel,\\n   159\\t    updatedAt: '2026-04-13T12:24:00.000Z',\\n   160\\t  }),\\n   161\\t  currentRequest: null,\\n   162\\t});\\n   163\\t\\n   164\\texport const resumedInterruptedProcessResponseFixture = resumeProcessResponseSchema.parse({\\n   165\\t  process: processSurfaceSummarySchema.parse({\\n   166\\t    ...runningProcessSurfaceFixture,\\n   167\\t    processId: interruptedProcessSurfaceFixture.processId,\\n   168\\t    phaseLabel: interruptedProcessSurfaceFixture.phaseLabel,\\n   169\\t    updatedAt: '2026-04-13T12:27:00.000Z',\\n   170\\t  }),\\n   171\\t  currentRequest: null,\\n   172\\t});\\n   173\\t\\n   174\\texport const processUnavailableErrorFixture = requestErrorSchema.parse({\\n   175\\t  code: 'PROCESS_NOT_FOUND',\\n   176\\t  message: 'The requested process could not be found.',\\n   177\\t  status: 404,\\n   178\\t});\\n   179\\t\\n   180\\texport const processAccessDeniedErrorFixture = requestErrorSchema.parse({\\n   181\\t  code: 'PROJECT_FORBIDDEN',\\n   182\\t  message: 'You do not have access to this process.',\\n   183\\t  status: 403,\\n   184\\t});\\n   185\\t\\n   186\\t// Live transport state fixture for post-bootstrap disconnect/error handling.\\n   187\\t// This is not a bootstrap HTTP error response fixture.\\n   188\\texport const processLiveUnavailableTransportErrorFixture = requestErrorSchema.parse({\\n   189\\t  code: 'PROCESS_LIVE_UPDATES_UNAVAILABLE',\\n   190\\t  message: 'Live updates are currently unavailable.',\\n   191\\t  status: 503,\\n   192\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/02-start-and-resume/codex-review-round-1.jsonl:113:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_57\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba apps/platform/server/services/processes/process-module-registry.ts | sed -n '1,260p'\\\"\",\"aggregated_output\":\"     1\\timport type {\\n     2\\t  ProcessArtifactReference,\\n     3\\t  ProcessHistoryItem,\\n     4\\t  ProcessOutputReference,\\n     5\\t  ProcessSourceReference,\\n     6\\t  SideWorkItem,\\n     7\\t  SupportedProcessType,\\n     8\\t} from '../../../shared/contracts/index.js';\\n     9\\timport { AppError } from '../../errors/app-error.js';\\n    10\\timport { story0NotImplementedErrorCode } from '../../errors/codes.js';\\n    11\\timport type {\\n    12\\t  ProcessActionResult,\\n    13\\t  ProcessSurfaceProjection,\\n    14\\t} from './process-work-surface.service.js';\\n    15\\t\\n    16\\texport interface ProcessWorkSurfaceModule<TState = unknown> {\\n    17\\t  processType: SupportedProcessType;\\n    18\\t  getState(args: { processId: string }): Promise<TState | null>;\\n    19\\t  buildSurfaceProjection(args: {\\n    20\\t    processId: string;\\n    21\\t    state: TState;\\n    22\\t    visibleHistory: ProcessHistoryItem[];\\n    23\\t    sideWork: SideWorkItem[];\\n    24\\t    outputs: ProcessOutputReference[];\\n    25\\t    artifactLookup: Map<ProcessArtifactReference['artifactId'], ProcessArtifactReference>;\\n    26\\t    sourceLookup: Map<ProcessSourceReference['sourceAttachmentId'], ProcessSourceReference>;\\n    27\\t  }): Promise<ProcessSurfaceProjection> | ProcessSurfaceProjection;\\n    28\\t  start(args: { processId: string; state: TState; actorId: string }): Promise<ProcessActionResult>;\\n    29\\t  resume(args: { processId: string; state: TState; actorId: string }): Promise<ProcessActionResult>;\\n    30\\t  respond(args: {\\n    31\\t    processId: string;\\n    32\\t    state: TState;\\n    33\\t    actorId: string;\\n    34\\t    message: string;\\n    35\\t    clientRequestId: string;\\n    36\\t  }): Promise<ProcessActionResult>;\\n    37\\t}\\n    38\\t\\n    39\\texport class ProcessModuleRegistry {\\n    40\\t  private readonly modules = new Map<SupportedProcessType, ProcessWorkSurfaceModule<unknown>>();\\n    41\\t\\n    42\\t  constructor(modules: ProcessWorkSurfaceModule<unknown>[] = []) {\\n    43\\t    for (const module of modules) {\\n    44\\t      this.register(module);\\n    45\\t    }\\n    46\\t  }\\n    47\\t\\n    48\\t  register(module: ProcessWorkSurfaceModule<unknown>): void {\\n    49\\t    this.modules.set(module.processType, module);\\n    50\\t  }\\n    51\\t\\n    52\\t  get(processType: SupportedProcessType): ProcessWorkSurfaceModule<unknown> {\\n    53\\t    const module = this.modules.get(processType);\\n    54\\t\\n    55\\t    if (module === undefined) {\\n    56\\t      throw new AppError({\\n    57\\t        code: story0NotImplementedErrorCode,\\n    58\\t        message: `No process work-surface module is registered for ${processType}.`,\\n    59\\t        statusCode: 501,\\n    60\\t      });\\n    61\\t    }\\n    62\\t\\n    63\\t    return module;\\n    64\\t  }\\n    65\\t\\n    66\\t  list(): SupportedProcessType[] {\\n    67\\t    return [...this.modules.keys()];\\n    68\\t  }\\n    69\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/cursor-review.md:5:- Durable accepted-response history looks coherent in [process-response.service.ts](/Users/leemoore/code/liminal-build/apps/platform/server/services/processes/process-response.service.ts), [bootstrap.ts](/Users/leemoore/code/liminal-build/apps/platform/client/app/bootstrap.ts), and [processes.ts](/Users/leemoore/code/liminal-build/convex/processes.ts).\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/cursor-review.md:7:- Current-request pinning and attention-required distinction look aligned to Story 3 in [current-request-panel.ts](/Users/leemoore/code/liminal-build/apps/platform/client/features/processes/current-request-panel.ts), [process-history-section.ts](/Users/leemoore/code/liminal-build/apps/platform/client/features/processes/process-history-section.ts), and [processes.ts](/Users/leemoore/code/liminal-build/convex/processes.ts).\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/00-foundation/sonnet-review.json:1:{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"duration_ms\":427594,\"duration_api_ms\":426924,\"num_turns\":43,\"result\":\"The file write is pending your approval. Here is the full review:\\n\\n---\\n\\n## VERDICT: REVISE\\n\\nOne MAJOR finding must be resolved before this foundation is clean enough to serve as the reference baseline for Stories 1–6.\\n\\n---\\n\\n## STORY0_REQUIREMENTS_MATRIX\\n\\n| Requirement | Status |\\n|---|---|\\n| Shared route constants and endpoint vocabulary | SATISFIED |\\n| `process.processType`, `.status`, `.availableActions` values | SATISFIED |\\n| `history.kind`, `.lifecycleState` values | SATISFIED |\\n| `live.messageType`, `.entityType` values | SATISFIED |\\n| Shared section error and live update contracts | SATISFIED |\\n| `processSurface` state slice in `AppState` | SATISFIED |\\n| Route parsing: process route checked before project-shell | SATISFIED |\\n| `processSurface.projectId/processId` populated on route parse | SATISFIED |\\n| Pure `applyLiveProcessMessage` helper | SATISFIED |\\n| WebSocket plugin scaffold | SATISFIED |\\n| Process routes scaffold | SATISFIED |\\n| `ProcessWorkSurfaceService` interface + NotImplemented stub | SATISFIED |\\n| `ProcessModuleRegistry` + functional registry | SATISFIED |\\n| `ProcessLiveHub` + `NoopProcessLiveHub` | SATISFIED |\\n| `app.ts` plugin/route registration order | SATISFIED |\\n| All three new Convex tables with correct fields and indexes | SATISFIED |\\n| `currentRequestHistoryItemId` pointer added to `processes` | SATISFIED |\\n| New Convex modules are guideline-compliant | SATISFIED |\\n| **Modified `convex/processes.ts` normalized to Epic 2 guidelines** | **VIOLATED** |\\n| All required fixtures present and valid | SATISFIED |\\n| `renderShell` supports non-`/projects` routes | SATISFIED |\\n| No Story 1+ user-visible behavior introduced | SATISFIED |\\n\\n---\\n\\n## TEST_DIFF_AUDIT\\n\\nZero test file changes from base commit. This is correct — Chunk 0 specifies 0 TC and 0 non-TC tests per the test plan. The exit gate is typecheck + build only.\\n\\n---\\n\\n## BLOCKING_FINDINGS\\n\\n### F-1 — MAJOR | HIGH confidence\\n\\n**`convex/processes.ts` was modified in Story 0 but not normalized to Epic 2 Convex guidelines.**\\n\\nObserved violations in the file as modified:\\n\\n```ts\\n// line 1 — uses generic imports instead of typed\\nimport { mutationGeneric as mutation, queryGeneric as query } from 'convex/server';\\n\\n// lines 37, 64 — ctx: any, args: any\\nhandler: async (ctx: any, args: any) => { ... }\\n\\n// line 40 — unbounded collect\\n.order('desc').collect();\\n```\\n\\nAdditionally, `convex/schema.ts` shows a duplicate index on the `processes` table:\\n\\n```ts\\n.index('by_projectId_updatedAt', ['projectId', 'updatedAt'])     // old\\n.index('by_projectId_and_updatedAt', ['projectId', 'updatedAt']) // new — both index same fields\\n```\\n\\nThe tech-design.md Issue table explicitly resolves this: *\\\"This design standardizes new and modified Convex modules on guideline-compliant validators, typed contexts, bounded queries, and explicit indexes. Existing scaffold shortcuts are treated as implementation debt, not as design precedent.\\\"* The verification bundle's own orchestrator note flags this as a primary scrutiny point.\\n\\n**Why this matters:** `processes.ts` is the reference file for later story implementers. Leaving `ctx: any` and `.collect()` in place after modification signals that those patterns are acceptable precedent. Stories 2–6 will replicate the debt.\\n\\n**Required fix:** Replace `queryGeneric`/`mutationGeneric` with typed imports, replace `ctx: any`/`args: any` with proper context types and explicit validators, replace `.collect()` with `.take(n)`, remove the duplicate `by_projectId_updatedAt` index.\\n\\n---\\n\\n## NONBLOCKING_WARNINGS\\n\\n**F-2 — MINOR:** `processLiveUnavailableErrorFixture` uses `requestErrorSchema` with `status: 503`. The fixture is type-valid (it fits `live.error`), but naming and the 503 status imply an HTTP response, which contradicts the tech-design resolution that live unavailability is a transport state, not an HTTP error. Renaming and a clarifying comment would prevent Story 6 misuse.\\n\\n**F-3 — MINOR (covered by F-1):** Duplicate `processes` table indexes.\\n\\n**F-4 — MINOR:** `bootstrap.ts` `loadParsedRoute` falls through to `getProjectShell` for `process-work-surface` routes. Within Story 0 scope, but Story 1 must add a dedicated branch or it will call the shell API unnecessarily on every process route.\\n\\n---\\n\\n## UNRESOLVED\\n\\n**U-1:** `ProcessWorkSurfaceModule.buildSurfaceProjection` receives `processId: string` rather than `process: ProcessRecord` as shown in tech-design-server.md. Cannot confirm impact until Stories 2–3 implement the first concrete module.\\n\\n---\\n\\n## GATE_RESULT\\n\\nClaimed PASS (typecheck + build) per verification bundle. Could not independently verify — the `typecheck` command required approval not granted during this session. Accepted as claimed; gate failure would escalate to BLOCK.\",\"stop_reason\":\"end_turn\",\"session_id\":\"7aebeca1-dc8c-43a0-926a-06ae9502e2c0\",\"total_cost_usd\":1.0892933999999999,\"usage\":{\"input_tokens\":170,\"cache_creation_input_tokens\":91994,\"cache_read_input_tokens\":1330853,\"output_tokens\":22970,\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"ephemeral_1h_input_tokens\":91994,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":\"\",\"iterations\":[{\"input_tokens\":8,\"output_tokens\":1464,\"cache_read_input_tokens\":100068,\"cache_creation_input_tokens\":4335,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":4335},\"type\":\"message\"}],\"speed\":\"standard\"},\"modelUsage\":{\"claude-sonnet-4-6\":{\"inputTokens\":170,\"outputTokens\":22970,\"cacheReadInputTokens\":1330853,\"cacheCreationInputTokens\":91994,\"webSearchRequests\":0,\"costUSD\":1.0892933999999999,\"contextWindow\":200000,\"maxOutputTokens\":32000}},\"permission_denials\":[{\"tool_name\":\"Bash\",\"tool_use_id\":\"toolu_01UD9rnr5wb9PmL71CW5ZdeK\",\"tool_input\":{\"command\":\"corepack pnpm run typecheck 2>&1 | tail -30\",\"timeout\":60000,\"description\":\"Run typecheck gate\"}},{\"tool_name\":\"Bash\",\"tool_use_id\":\"toolu_01UwejwDC59cmMy1kBRF5S1p\",\"tool_input\":{\"command\":\"corepack pnpm run typecheck\",\"timeout\":60000,\"description\":\"Run typecheck gate\"}},{\"tool_name\":\"Write\",\"tool_use_id\":\"toolu_01CAdP2WqUxx26SJNAkuJizw\",\"tool_input\":{\"file_path\":\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/02--process-work-surface/story-verification/00-foundation/sonnet-review.md\",\"content\":\"# Story 0 Foundation — Compliance Review\\n\\n**Reviewer:** Claude Sonnet 4.6  \\n**Date:** 2026-04-14  \\n**Story base commit:** `c9a63ef2b71e7bdfa380a6c7313f3a2b38e7c9ac`  \\n**Verification bundle:** `story-verification/00-foundation/verification-bundle.md`\\n\\n---\\n\\n## VERDICT: REVISE\\n\\nOne MAJOR finding (Convex normalization) must be resolved before the foundation\\nis clean enough to be the reference baseline for Stories 1–6. The issue is a\\nconfirmed scope omission, not speculative. Everything else is PASS or MINOR.\\n\\n---\\n\\n## STORY0_REQUIREMENTS_MATRIX\\n\\n| Requirement | Status | Notes |\\n|---|---|---|\\n| Shared route constant `/projects/{projectId}/processes/{processId}` | SATISFIED | `processWorkSurfaceRouteTemplate` and companion patterns defined in `process-work-surface.ts` |\\n| Shared endpoint vocabulary (bootstrap, start, resume, respond, live WS) | SATISFIED | All six path patterns defined and exported; path-builder helpers present |\\n| `process.processType` values | SATISFIED | `ProductDefinition`, `FeatureSpecification`, `FeatureImplementation` |\\n| `process.status` values | SATISFIED | All 7 values in `processStatusSchema` and mirrored in Convex validator |\\n| `process.availableActions` values (`start`, `respond`, `resume`, `review`, `restart`) | SATISFIED | `processSurfaceAvailableActionSchema` in `process-work-surface.ts` |\\n| `history.kind` values | SATISFIED | All 6 kinds in `processHistoryItemKindSchema` |\\n| `history.lifecycleState` values | SATISFIED | `current`, `finalized` |\\n| `live.messageType` values | SATISFIED | `snapshot`, `upsert`, `complete`, `error` |\\n| `live.entityType` values | SATISFIED | All 5 entity types |\\n| Shared section error contract (code, message) | SATISFIED | `processSurfaceSectionErrorSchema` with typed code enum |\\n| Shared live update contract (all 9 fields per spec) | SATISFIED | `liveProcessMessageBaseSchema` covers all fields; discriminated union covers all entity types |\\n| `processSurface` state slice in `AppState` | SATISFIED | `processSurfaceStateSchema` in `state.ts`; `processSurface` key in `appStateSchema`; default values in `defaultAppState` |\\n| Route parsing: process route matched before project-shell pattern | SATISFIED | `processMatch` check precedes `projectMatch` in `parseRoute()` |\\n| `processId` and `projectId` populated in `processSurface` slice on route parse | SATISFIED | `getProcessSurfaceRouteIdentity` called in `bootstrap.ts`; identity fields stored in `processSurface` initial state |\\n| Pure `applyLiveProcessMessage` helper | SATISFIED | Implemented in `process-live.ts`; handles all 5 entity types and error messages; stale-message guard present |\\n| WebSocket plugin scaffold in server | SATISFIED | `websocket.plugin.ts` registers with Fastify; decorates app with `NoopProcessLiveHub` |\\n| Process routes scaffold in server | SATISFIED | `routes/processes.ts` stubs `registerProcessRoutes`; exports route-pattern constants |\\n| `ProcessWorkSurfaceService` interface + NotImplemented stub | SATISFIED | `process-work-surface.service.ts`; stub throws `story0NotImplementedErrorCode` |\\n| `ProcessModuleRegistry` interface + functional registry | SATISFIED | Registry is functional (register/get/list); throws NotImplemented when no module registered |\\n| `ProcessLiveHub` interface + `NoopProcessLiveHub` | SATISFIED | In `process-live-hub.ts`; subscribe and publish both no-ops |\\n| `app.ts` registers websocket plugin and process routes in correct order | SATISFIED | `websocketPlugin` registered before `registerProcessRoutes`; `ProcessLiveHub` wired as optional decoration |\\n| Convex schema: `processHistoryItems` with correct fields and indexes | SATISFIED | Fields match tech-design spec exactly; both required indexes present |\\n| Convex schema: `processSideWorkItems` with correct fields and indexes | SATISFIED | Fields match spec; `by_processId_and_updatedAt` index present |\\n| Convex schema: `processOutputs` with correct fields and indexes | SATISFIED | Fields match spec; `by_processId_and_updatedAt` index present |\\n| `processes` table: `currentRequestHistoryItemId` pointer added | SATISFIED | Present in `processesTableFields`; typed as `v.union(v.id('processHistoryItems'), v.null())` |\\n| New Convex modules use guideline-compliant patterns | SATISFIED | New table modules (`processHistoryItems.ts`, `processSideWorkItems.ts`, `processOutputs.ts`) export only field definitions; no query/mutation functions yet; no debt introduced |\\n| **Modified Convex module `processes.ts` normalized to Epic 2 Convex guidelines** | **VIOLATED** | `queryGeneric`/`mutationGeneric`, `ctx: any`, unbounded `.collect()`, duplicate index — all present after modification; see Finding F-1 |\\n| Fixtures: history items — all 6 kinds, finalized/current variants | SATISFIED | `process-history.ts` covers all kinds; both lifecycle states represented |\\n| Fixtures: materials — artifact, linked output, standalone output, source, empty | SATISFIED | All required variants in `materials.ts` |\\n| Fixtures: side-work — running, completed, failed, empty, error | SATISFIED | `side-work.ts` covers all cases |\\n| Fixtures: process surface — ready, early (empty), degraded, unavailable, access-denied | SATISFIED | `process-surface.ts` covers all 5 cases |\\n| Fixtures: live process — snapshot, upsert, complete, error, cleared-request | SATISFIED | `live-process.ts` covers all message forms; builder helper present |\\n| `renderShell` test helper supports non-`/projects` bootstrap paths | SATISFIED | `render-shell.ts` now accepts arbitrary `pathname`/`search` overrides |\\n| No user-visible Story 1+ behavior introduced | SATISFIED | See note on bootstrap.ts below; the fall-through to shell loading is placeholder behavior, not process surface behavior |\\n| Story files can reference foundation without redefining vocabulary | SATISFIED | All vocabulary defined once; `index.ts` re-exports from all four contract files |\\n\\n---\\n\\n## TEST_DIFF_AUDIT\\n\\n**Git diff result:** No test file changes between `c9a63ef` and HEAD.\\n\\n**Verification bundle claim:** \\\"Tests Added Or Updated: none. Story 0 is scaffolding-only. Chunk 0 specifies 0 TC tests and 0 non-TC tests.\\\"\\n\\n**Cross-check against test plan:** The test plan lists Story 0 (Chunk 0) explicitly as zero TC tests and zero non-TC tests, with `red-verify` (typecheck + build) as the exit gate. Claim is CONSISTENT with the test plan specification.\\n\\n**Assessment:** OBSERVED. No executable test coverage was expected or introduced. This is correct per the test plan.\\n\\n---\\n\\n## CONTRACT_AND_FIXTURE_FINDINGS\\n\\n**Contracts are internally consistent.** All four contract files (`schemas.ts`,\\n`process-work-surface.ts`, `live-process-updates.ts`, `state.ts`) import cleanly\\nfrom each other. `index.ts` re-exports all four. Router and store both import\\nfrom `index.ts` as expected.\\n\\n**Live update discriminated union is complete.** All five entity types have typed\\nschemas; the error variant restricts entity type to `history | materials |\\nside_work`. The `completedAt` and `correlationId` fields are nullable across all\\nvariants, consistent with the spec.\\n\\n**`currentRequestLiveDataMessageSchema` constrains `entityId` to literal\\n`'current_request'`.** This is tighter than the spec but correct for the single\\n`current_request` projection slot.\\n\\n**One fixture modeling concern (non-blocking):**\\n\\n`processLiveUnavailableErrorFixture` in `process-surface.ts` (lines 103–107):\\n\\n```ts\\nexport const processLiveUnavailableErrorFixture = requestErrorSchema.parse({\\n  code: 'PROCESS_LIVE_UPDATES_UNAVAILABLE',\\n  message: 'Live updates are currently unavailable.',\\n  status: 503,\\n});\\n```\\n\\nThe design resolution (tech-design.md Issue table) explicitly states live\\nunavailability is NOT an HTTP bootstrap failure — it is a post-bootstrap live\\ntransport state expressed through `live.connectionState` and `live.error`. This\\nfixture is structurally valid (the `live.error` field in `ProcessSurfaceState`\\naccepts `requestErrorSchema`) but the `status: 503` field implies an HTTP\\nresponse code, which will never be returned for this case. Any Story 6\\nimplementer who follows this fixture as a template for handling live failures may\\nmodel the wrong client path. See Finding F-2.\\n\\n**Section error envelopes include `superRefine` consistency guard.** All three\\nenvelope types (`history`, `materials`, `sideWork`) enforce `error` presence\\nwhen `status === 'error'`. This is correct and forward-compatible.\\n\\n**`processSurfaceAvailableActionSchema` (work surface) vs `processAvailableActionSchema`\\n(shell):** The two schemas have different vocabularies (`start` vs `open`,\\n`rehydrate` absent in surface). This is intentional and correctly models the\\nEpic 1 shell vocabulary vs Epic 2 surface vocabulary. Not a defect.\\n\\n---\\n\\n## CONVEX_GUIDELINE_FINDINGS\\n\\n**Convex AI guidelines** (per `convex/_generated/ai/guidelines.md` referenced in\\nCLAUDE.md): typed query/mutation imports, proper ctx types, `withIndex` over\\n`filter`, bounded reads with `.take(n)`.\\n\\n**New table modules (`processHistoryItems.ts`, `processSideWorkItems.ts`,\\n`processOutputs.ts`):** Export field definitions only; no function\\nimplementations yet. No guideline violations introduced. Clean.\\n\\n**`convex/schema.ts`:** New tables `processHistoryItems`, `processSideWorkItems`,\\n`processOutputs` correctly defined with required indexes per the tech design\\nIndex Plan. One debt item present in the `processes` table declaration — see\\nFinding F-1.\\n\\n**`convex/processes.ts`:** MAJOR violation. See Finding F-1 for full detail.\\n\\n---\\n\\n## COMPLETENESS_GAPS\\n\\n1. **Process service skeletons absent:** `process-access.service.ts`,\\n   `process-start.service.ts`, `process-resume.service.ts`,\\n   `process-response.service.ts`, reader services, and summary builders are\\n   not present. The verification bundle does not list them; the tech-design\\n   Skeleton Requirements tables assign them to later stories (they appear in\\n   Flow 1–5 skeleton tables but Story 0 is foundation only). **Assessment:**\\n   ACCEPTABLE for Story 0. These are Story 1–3 deliverables.\\n\\n2. **`bootstrap.ts` `loadParsedRoute` falls through to project-shell loading for\\n   `process-work-surface` routes.** When the route kind is\\n   `process-work-surface`, the function calls `getProjectShell` as a\\n   placeholder. This is within scope (Story 0 does not own process bootstrap\\n   behavior), but Story 1 must add a dedicated `process-work-surface` branch\\n   and stop loading the project shell for that route. This is not a Story 0\\n   violation, but it is a known functional gap that Story 1 must close.\\n\\n3. **`connectedProcessSurfaceStateFixture` has `project: null`.** A connected\\n   live state that has already bootstrapped should normally have project info\\n   populated. The fixture is technically valid per schema but may require a\\n   richer variant for Story 6 tests. Minor fixture gap.\\n\\n4. **`process-module-registry.ts` interface deviates slightly from tech-design-server.md.**\\n   The design shows `buildSurfaceProjection` receiving `process: ProcessRecord`,\\n   but the implementation passes `processId: string` instead. This reduces the\\n   data available to process module implementations. Acceptable for Story 0\\n   scaffolding; Story 3/4 must confirm the signature is sufficient.\\n\\n---\\n\\n## BLOCKING_FINDINGS\\n\\n### F-1 — MAJOR | HIGH confidence\\n\\n**Finding:** `convex/processes.ts` was modified in Story 0 (added\\n`currentRequestHistoryItemId` to the field schema and to `createProcess`) but\\nwas not normalized to Epic 2 Convex guideline standards.\\n\\n**Evidence (OBSERVED):**\\n\\n```ts\\n// convex/processes.ts line 1\\nimport { mutationGeneric as mutation, queryGeneric as query } from 'convex/server';\\n\\n// line 37\\nhandler: async (ctx: any, args: any) => {\\n\\n// line 40\\n  .withIndex('by_projectId_updatedAt', ...)\\n  .order('desc')\\n  .collect();   // unbounded collect on processes table\\n\\n// convex/schema.ts lines 25–26 — duplicate index names for same fields\\n.index('by_projectId_updatedAt', ['projectId', 'updatedAt'])\\n.index('by_projectId_and_updatedAt', ['projectId', 'updatedAt']),\\n```\\n\\n**Design requirement (OBSERVED):** tech-design.md Issue table, row 6:\\n\\n> \\\"The current Convex scaffold uses `queryGeneric`/`mutationGeneric`, `ctx:\\n> any`, and some broad `.collect()` reads that do not match the generated\\n> Convex AI guidelines... This design standardizes new and modified Convex\\n> modules on guideline-compliant validators, typed contexts, bounded queries,\\n> and explicit indexes. Existing scaffold shortcuts are treated as\\n> implementation debt, not as design precedent.\\\"\\n\\nThe verification bundle orchestrator note also explicitly flags this as a\\nscrutiny point.\\n\\n**Disproof attempt:** Could Story 0 defer normalization on the grounds that the\\nmodification was additive (schema field only) and the function bodies were not\\ntouched? Weak. The field definition change and the `createProcess` mutation body\\n(which now inserts `currentRequestHistoryItemId: null`) both touched the file.\\nThe design says modified modules adopt the new standard.\\n\\n**Impact:** `processes.ts` becomes the de-facto reference for later story\\nimplementers. If this file is not normalized, Stories 2–6 will add functions\\nusing `ctx: any`, `queryGeneric`, and unbounded `.collect()` patterns because\\nthey look like established precedent. The duplicate index is also functional\\ndebt — two indexes on identical columns consume unnecessary storage and may\\ncause confusion in query planning.\\n\\n**Validation step:** Normalize `convex/processes.ts`:\\n- Replace `queryGeneric as query` and `mutationGeneric as mutation` with typed\\n  imports from `convex/server`\\n- Replace `ctx: any` / `args: any` with proper `QueryCtx`/`MutationCtx` types\\n  and explicit argument validators\\n- Replace `.collect()` with `.take(n)` (bound appropriate to the list size)\\n- Remove the duplicate `by_projectId_updatedAt` index, keeping only\\n  `by_projectId_and_updatedAt`\\n- Re-run `typecheck && build`\\n\\n---\\n\\n## NONBLOCKING_WARNINGS\\n\\n### F-2 — MINOR | MEDIUM confidence\\n\\n**Finding:** `processLiveUnavailableErrorFixture` models live unavailability as\\na `requestErrorSchema` row with `status: 503`.\\n\\n**Evidence:** `tests/fixtures/process-surface.ts` lines 103–107.\\n\\n**Design stance:** tech-design.md Q8 answer and resolved Issue 5 — live\\nunavailability is a post-bootstrap live transport state, not an HTTP error.\\n`PROCESS_LIVE_UPDATES_UNAVAILABLE` belongs to the `live.error` field of\\n`ProcessSurfaceState`, not to the top-level HTTP error response. The `status:\\n503` field in this fixture has no corresponding HTTP route that will ever return\\nit.\\n\\n**Impact:** Story 6 implementers may incorrectly model live reconnect failure\\nas an HTTP-layer response rather than a transport-layer state. The `live.error`\\nfield is typed as `requestErrorSchema.nullable()`, so the fixture type is\\nvalid; the mislead is semantic, not a compile-time failure.\\n\\n**Suggested fix:** Rename to `processLiveTransportErrorFixture` and clarify in\\na JSDoc comment that it represents a `live.error` payload, not an HTTP response.\\nRemove or zero out the `status` field, or document why 503 was chosen.\\n\\n### F-3 — MINOR | HIGH confidence\\n\\n**Finding:** Duplicate Convex index on `processes` table.\\n\\n**Evidence:** `convex/schema.ts` lines 25–26:\\n\\n```ts\\n.index('by_projectId_updatedAt', ['projectId', 'updatedAt'])\\n.index('by_projectId_and_updatedAt', ['projectId', 'updatedAt']),\\n```\\n\\nBoth index the same two fields. The old name (`by_projectId_updatedAt`) is used\\nin `processes.ts` line 40. This is covered by F-1's normalization fix.\\n\\n### F-4 — MINOR | HIGH confidence\\n\\n**Finding:** `bootstrap.ts` falls through to project-shell loading for\\n`process-work-surface` routes. Story 1 must add a dedicated branch.\\n\\n**Evidence:** `apps/platform/client/app/bootstrap.ts` `loadParsedRoute()`\\nfunction, lines 155–234. Only `project-index` has an explicit branch; all other\\nroute kinds (including `process-work-surface`) fall through to `getProjectShell`.\\n\\n**Impact:** On a process route, the shell API is called unnecessarily. More\\ncritically, the process work surface data is never fetched until Story 1 adds\\nthe branch. Story 1 must not leave this fallthrough in place.\\n\\n**Story 0 scope verdict:** ACCEPTABLE for Story 0. Not a Story 0 violation.\\nFlagged so Story 1 does not inherit it silently.\\n\\n---\\n\\n## UNRESOLVED\\n\\n### U-1 — LOW confidence\\n\\n**Issue:** `process-module-registry.ts` `ProcessWorkSurfaceModule.buildSurfaceProjection`\\nreceives `processId: string` rather than `process: ProcessRecord` as specified\\nin tech-design-server.md.\\n\\n**Evidence INFERRED:** The tech design shows `process: ProcessRecord` in the\\ninterface. The implementation uses `processId: string`. The change reduces what\\nmodule implementations can access about the process record in one call.\\n\\n**Why unresolved:** Story 0 is scaffolding only; no process module\\nimplementations exist yet. It is possible this simplified signature was a\\ndeliberate Story 0 choice with the intent to expand later, or it is an\\nunintentional deviation. The impact cannot be confirmed until Stories 2–3\\nimplement the first real module.\\n\\n**Validation step:** When Story 2/3 authors the first concrete process module,\\nconfirm whether `processId` alone is sufficient for `buildSurfaceProjection` or\\nwhether `process: ProcessRecord` is needed.\\n\\n---\\n\\n## GATE_RESULT\\n\\n**Claimed:** `corepack pnpm run typecheck && corepack pnpm run build` → PASS (verification bundle).\\n\\n**Independently verified:** NO. The `typecheck` command required approval that\\nwas not granted during this review session. The gate result is ACCEPTED as\\nclaimed from the verification bundle. If the gate fails when run independently,\\nthe verdict escalates to BLOCK.\\n\\n---\\n\\n## What else I noticed but chose not to report\\n\\n- **`processAvailableActionSchema` in `schemas.ts` includes `open`, `rehydrate`** values\\n  that do not appear in the work-surface `processSurfaceAvailableActionSchema`. This is\\n  correct — they serve the Epic 1 shell context — but the coexistence of two\\n  overlapping action enums creates a long-term maintenance question about\\n  whether they eventually merge. I did not report this because it is a design\\n  future-risk, not a Story 0 defect.\\n\\n- **`deriveAvailableActions` in `processes.ts` returns `['open']` for draft status** while\\n  the Epic 2 contract returns `['start']` for draft. This is correct scope separation\\n  (the Convex function feeds the shell summary, not the work surface) but the divergence\\n  will widen as the work surface action vocabulary grows. Not reported because it is\\n  intentional for the current milestone.\\n\\n- **`app.ts` still has the health route returning `story: 'story-5-return-and-recovery-visibility'`**\\n  which is Epic 1's last story label. This label is stale after Story 0 was applied.\\n  A cosmetic artifact, not a functional issue.\\n\\n- **`processWorkSurfaceService` is declared but `processLiveHub` is NOT decorated on the\\n  Fastify instance** (it is passed to the websocket plugin but not decorated via\\n  `app.decorate('processLiveHub', ...)` at the app level). The plugin does the decoration\\n  inside its own scope. This means Fastify routes cannot access `app.processLiveHub`\\n  unless they are registered after the plugin. The TypeScript declaration `FastifyInstance.processLiveHub`\\n  is in `websocket.plugin.ts` and will be available after the plugin runs. This is\\n  correct sequencing, but the pattern differs from how other services are decorated.\\n  Not reported because it is architecturally sound.\\n\\n- **`connectedProcessSurfaceStateFixture` uses a `processId` from `waitingProcessSurfaceFixture`**\\n  but `processUpsertLiveFixture` uses `runningProcessSurfaceFixture.processId` (a different\\n  ID). The two fixtures are not pointing at the same process, so reconciliation tests\\n  that mix them would apply an upsert from a different process into the connected state.\\n  This may cause false negatives in reconciliation tests. I chose not to report it\\n  because no reconciliation tests exist yet in Story 0, and the fixture builder pattern\\n  (`buildLiveProcessMessageFixture`) provides a clean override path.\\n\"}},{\"tool_name\":\"Write\",\"tool_use_id\":\"toolu_01U5Bjdag7nNrWUuSkwfyNnk\",\"tool_input\":{\"file_path\":\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/02--process-work-surface/story-verification/00-foundation/sonnet-review.md\",\"content\":\"# Story 0 Foundation — Compliance Review\\n\\n**Reviewer:** Claude Sonnet 4.6  \\n**Date:** 2026-04-14  \\n**Story base commit:** `c9a63ef2b71e7bdfa380a6c7313f3a2b38e7c9ac`  \\n**Verification bundle:** `story-verification/00-foundation/verification-bundle.md`\\n\\n---\\n\\n## VERDICT: REVISE\\n\\nOne MAJOR finding (Convex normalization) must be resolved before the foundation\\nis clean enough to be the reference baseline for Stories 1–6. The issue is a\\nconfirmed scope omission, not speculative. Everything else is PASS or MINOR.\\n\\n---\\n\\n## STORY0_REQUIREMENTS_MATRIX\\n\\n| Requirement | Status | Notes |\\n|---|---|---|\\n| Shared route constant `/projects/{projectId}/processes/{processId}` | SATISFIED | `processWorkSurfaceRouteTemplate` and companion patterns defined in `process-work-surface.ts` |\\n| Shared endpoint vocabulary (bootstrap, start, resume, respond, live WS) | SATISFIED | All six path patterns defined and exported; path-builder helpers present |\\n| `process.processType` values | SATISFIED | `ProductDefinition`, `FeatureSpecification`, `FeatureImplementation` |\\n| `process.status` values | SATISFIED | All 7 values in `processStatusSchema` and mirrored in Convex validator |\\n| `process.availableActions` values (`start`, `respond`, `resume`, `review`, `restart`) | SATISFIED | `processSurfaceAvailableActionSchema` in `process-work-surface.ts` |\\n| `history.kind` values | SATISFIED | All 6 kinds in `processHistoryItemKindSchema` |\\n| `history.lifecycleState` values | SATISFIED | `current`, `finalized` |\\n| `live.messageType` values | SATISFIED | `snapshot`, `upsert`, `complete`, `error` |\\n| `live.entityType` values | SATISFIED | All 5 entity types |\\n| Shared section error contract (code, message) | SATISFIED | `processSurfaceSectionErrorSchema` with typed code enum |\\n| Shared live update contract (all 9 fields per spec) | SATISFIED | `liveProcessMessageBaseSchema` covers all fields; discriminated union covers all entity types |\\n| `processSurface` state slice in `AppState` | SATISFIED | `processSurfaceStateSchema` in `state.ts`; `processSurface` key in `appStateSchema`; default values in `defaultAppState` |\\n| Route parsing: process route matched before project-shell pattern | SATISFIED | `processMatch` check precedes `projectMatch` in `parseRoute()` |\\n| `processId` and `projectId` populated in `processSurface` slice on route parse | SATISFIED | `getProcessSurfaceRouteIdentity` called in `bootstrap.ts`; identity fields stored in `processSurface` initial state |\\n| Pure `applyLiveProcessMessage` helper | SATISFIED | Implemented in `process-live.ts`; handles all 5 entity types and error messages; stale-message guard present |\\n| WebSocket plugin scaffold in server | SATISFIED | `websocket.plugin.ts` registers with Fastify; decorates app with `NoopProcessLiveHub` |\\n| Process routes scaffold in server | SATISFIED | `routes/processes.ts` stubs `registerProcessRoutes`; exports route-pattern constants |\\n| `ProcessWorkSurfaceService` interface + NotImplemented stub | SATISFIED | `process-work-surface.service.ts`; stub throws `story0NotImplementedErrorCode` |\\n| `ProcessModuleRegistry` interface + functional registry | SATISFIED | Registry is functional (register/get/list); throws NotImplemented when no module registered |\\n| `ProcessLiveHub` interface + `NoopProcessLiveHub` | SATISFIED | In `process-live-hub.ts`; subscribe and publish both no-ops |\\n| `app.ts` registers websocket plugin and process routes in correct order | SATISFIED | `websocketPlugin` registered before `registerProcessRoutes`; `ProcessLiveHub` wired as optional decoration |\\n| Convex schema: `processHistoryItems` with correct fields and indexes | SATISFIED | Fields match tech-design spec exactly; both required indexes present |\\n| Convex schema: `processSideWorkItems` with correct fields and indexes | SATISFIED | Fields match spec; `by_processId_and_updatedAt` index present |\\n| Convex schema: `processOutputs` with correct fields and indexes | SATISFIED | Fields match spec; `by_processId_and_updatedAt` index present |\\n| `processes` table: `currentRequestHistoryItemId` pointer added | SATISFIED | Present in `processesTableFields`; typed as `v.union(v.id('processHistoryItems'), v.null())` |\\n| New Convex modules use guideline-compliant patterns | SATISFIED | New table modules export field definitions only; no function implementations yet; no debt introduced |\\n| **Modified Convex module `processes.ts` normalized to Epic 2 Convex guidelines** | **VIOLATED** | `queryGeneric`/`mutationGeneric`, `ctx: any`, unbounded `.collect()`, duplicate index — all present after modification; see Finding F-1 |\\n| Fixtures: history items — all 6 kinds, finalized/current variants | SATISFIED | `process-history.ts` covers all kinds; both lifecycle states represented |\\n| Fixtures: materials — artifact, linked output, standalone output, source, empty | SATISFIED | All required variants in `materials.ts` |\\n| Fixtures: side-work — running, completed, failed, empty, error | SATISFIED | `side-work.ts` covers all cases |\\n| Fixtures: process surface — ready, early (empty), degraded, unavailable, access-denied | SATISFIED | `process-surface.ts` covers all 5 cases |\\n| Fixtures: live process — snapshot, upsert, complete, error, cleared-request | SATISFIED | `live-process.ts` covers all message forms; builder helper present |\\n| `renderShell` test helper supports non-`/projects` bootstrap paths | SATISFIED | `render-shell.ts` accepts arbitrary `pathname`/`search` overrides |\\n| No user-visible Story 1+ behavior introduced | SATISFIED | Bootstrap falls through to shell loading as placeholder — not process surface behavior |\\n| Story files can reference foundation without redefining vocabulary | SATISFIED | All vocabulary defined once; `index.ts` re-exports from all four contract files |\\n\\n---\\n\\n## TEST_DIFF_AUDIT\\n\\n**Git diff result:** No test file changes between `c9a63ef` and HEAD.\\n\\n**Verification bundle claim:** \\\"Tests Added Or Updated: none. Story 0 is\\nscaffolding-only. Chunk 0 specifies 0 TC tests and 0 non-TC tests.\\\"\\n\\n**Cross-check against test plan:** The test plan lists Story 0 (Chunk 0)\\nexplicitly as zero TC tests and zero non-TC tests, with `red-verify`\\n(typecheck + build) as the exit gate.\\n\\n**Assessment:** OBSERVED. No executable test coverage was expected or\\nintroduced. This is correct per the test plan.\\n\\n---\\n\\n## CONTRACT_AND_FIXTURE_FINDINGS\\n\\nContracts are internally consistent. All four contract files import cleanly\\nfrom each other. `index.ts` re-exports all four. Router and store both import\\nfrom `index.ts` as expected.\\n\\nLive update discriminated union is complete. All five entity types have typed\\nschemas; the error variant restricts entity type to `history | materials |\\nside_work`. `completedAt` and `correlationId` fields are nullable across all\\nvariants, consistent with the spec.\\n\\n`currentRequestLiveDataMessageSchema` constrains `entityId` to the literal\\n`'current_request'`. Tighter than the spec but correct.\\n\\n**One fixture modeling concern (non-blocking):**\\n\\n`processLiveUnavailableErrorFixture` in `tests/fixtures/process-surface.ts`\\nlines 103–107 models live unavailability as a `requestErrorSchema` row with\\n`status: 503`. The tech-design.md resolved Issue 5 explicitly: live\\nunavailability is a post-bootstrap transport state, not an HTTP failure. The\\nfixture is structurally valid (the `live.error` field accepts\\n`requestErrorSchema`), but the `status: 503` value implies an HTTP response\\ncode that will never be returned for this case. See Finding F-2.\\n\\nSection error envelopes include `superRefine` consistency guards enforcing\\n`error` presence when `status === 'error'`. Correct and forward-compatible.\\n\\n---\\n\\n## CONVEX_GUIDELINE_FINDINGS\\n\\nNew table modules (`processHistoryItems.ts`, `processSideWorkItems.ts`,\\n`processOutputs.ts`) export field definitions only. No function\\nimplementations yet. No guideline violations introduced. Clean.\\n\\n`convex/schema.ts` new tables correctly use guideline-compliant indexes.\\nOne debt item in the `processes` table — see Finding F-1.\\n\\n`convex/processes.ts`: MAJOR violation. See Finding F-1.\\n\\n---\\n\\n## COMPLETENESS_GAPS\\n\\n1. **Process service skeletons absent:** `process-access.service.ts`,\\n   `process-start.service.ts`, `process-resume.service.ts`,\\n   `process-response.service.ts`, reader services, and summary builders are\\n   not present. The tech-design Skeleton Requirements tables assign these to\\n   later stories. ACCEPTABLE for Story 0.\\n\\n2. **`bootstrap.ts` falls through to project-shell loading for\\n   `process-work-surface` routes.** `loadParsedRoute` has explicit handling\\n   only for `project-index`; all other route kinds call `getProjectShell`.\\n   Within Story 0 scope (process bootstrap is Story 1), but Story 1 must add\\n   a dedicated branch and stop loading the shell for process routes.\\n\\n3. **`connectedProcessSurfaceStateFixture` has `project: null`.** Technically\\n   valid; a richer variant may be needed for Story 6 reconciliation tests.\\n\\n4. **`ProcessWorkSurfaceModule.buildSurfaceProjection` passes `processId:\\n   string` instead of `process: ProcessRecord`** as shown in\\n   tech-design-server.md. See UNRESOLVED U-1.\\n\\n---\\n\\n## BLOCKING_FINDINGS\\n\\n### F-1 — MAJOR | HIGH confidence\\n\\n**Finding:** `convex/processes.ts` was modified in Story 0 but not normalized\\nto Epic 2 Convex guideline standards.\\n\\n**Evidence (OBSERVED):**\\n\\n```ts\\n// line 1 — guideline violation: use typed query/mutation, not generics\\nimport { mutationGeneric as mutation, queryGeneric as query } from 'convex/server';\\n\\n// line 37 — guideline violation: ctx: any, args: any\\nhandler: async (ctx: any, args: any) => {\\n\\n// line 40 — guideline violation: unbounded .collect() on processes table\\n  .withIndex('by_projectId_updatedAt', ...)\\n  .order('desc')\\n  .collect();\\n\\n// convex/schema.ts lines 25–26 — duplicate index: same fields, two names\\n.index('by_projectId_updatedAt', ['projectId', 'updatedAt'])\\n.index('by_projectId_and_updatedAt', ['projectId', 'updatedAt']),\\n```\\n\\n**Design requirement (OBSERVED):** tech-design.md Issue table, row 6:\\n\\n> \\\"This design standardizes new and modified Convex modules on\\n> guideline-compliant validators, typed contexts, bounded queries, and\\n> explicit indexes. Existing scaffold shortcuts are treated as implementation\\n> debt, not as design precedent.\\\"\\n\\nThe verification bundle orchestrator note also explicitly flags this as a\\nscrutiny point for verifiers.\\n\\n**Disproof attempt:** Could Story 0 defer normalization because the change was\\nadditive (schema field only)? Weak. The `processesTableFields` change and the\\n`createProcess` mutation body both touch the file; the design's normalization\\nrequirement applies to modified modules regardless of change size.\\n\\n**Impact:** `processes.ts` becomes the de-facto reference for later story\\nimplementers. Stories 2–6 will mirror `ctx: any` and `.collect()` because\\nthey look like established precedent. The duplicate index also causes\\nunnecessary storage overhead and introduces ambiguity about which index name\\nto use in queries.\\n\\n**Required fix:**\\n- Replace `queryGeneric as query` / `mutationGeneric as mutation` with typed\\n  imports (`query`, `mutation`, or `internalQuery`/`internalMutation`)\\n- Replace `ctx: any` / `args: any` with proper typed context and explicit\\n  argument validators\\n- Replace `.collect()` with `.take(n)` bounded by a suitable limit\\n- Remove the duplicate `by_projectId_updatedAt` index, keeping only\\n  `by_projectId_and_updatedAt`\\n- Re-run `typecheck && build`\\n\\n---\\n\\n## NONBLOCKING_WARNINGS\\n\\n### F-2 — MINOR | MEDIUM confidence\\n\\n**Finding:** `processLiveUnavailableErrorFixture` uses `status: 503` and is\\nnamed to suggest it is a top-level error response rather than a `live.error`\\npayload.\\n\\n**Evidence:** `tests/fixtures/process-surface.ts` lines 103–107.\\n\\n**Design stance:** tech-design.md Q8 — live unavailability is a transport\\nstate, not an HTTP error. The fixture is type-valid (it fits `live.error`),\\nbut the naming and 503 status code may mislead Story 6 implementers.\\n\\n**Suggested fix:** Rename to `processLiveTransportErrorFixture`; add a JSDoc\\ncomment clarifying this is the `live.error` payload shape, not an HTTP\\nresponse body. Evaluate whether the `status` field should be omitted or\\ndocumented explicitly.\\n\\n### F-3 — MINOR | HIGH confidence (covered by F-1 fix)\\n\\nDuplicate `processes` table indexes `by_projectId_updatedAt` and\\n`by_projectId_and_updatedAt` index the same `['projectId', 'updatedAt']`\\nfields. Resolved as part of the F-1 normalization.\\n\\n### F-4 — MINOR | HIGH confidence\\n\\n`bootstrap.ts` `loadParsedRoute` falls through to `getProjectShell` for\\n`process-work-surface` routes. Not a Story 0 violation; Story 1 must add a\\ndedicated branch.\\n\\n---\\n\\n## UNRESOLVED\\n\\n### U-1 — LOW confidence\\n\\n`ProcessWorkSurfaceModule.buildSurfaceProjection` in\\n`process-module-registry.ts` receives `processId: string` rather than\\n`process: ProcessRecord` as specified in tech-design-server.md. Impact cannot\\nbe confirmed until Stories 2–3 implement the first concrete process module.\\nConfirm then whether the simplified signature is sufficient or whether the\\nfull ProcessRecord is needed.\\n\\n---\\n\\n## GATE_RESULT\\n\\n**Claimed:** `corepack pnpm run typecheck && corepack pnpm run build` → PASS\\n(per verification bundle).\\n\\n**Independently verified:** NO — the `typecheck` command required approval\\nthat was not granted during this review session. Gate result is ACCEPTED as\\nclaimed. If the gate fails when run independently, the verdict escalates to\\nBLOCK.\\n\\n---\\n\\n## What else I noticed but chose not to report\\n\\n- **`processAvailableActionSchema` (schemas.ts) vs `processSurfaceAvailableActionSchema`\\n  (process-work-surface.ts) vocabulary divergence** — `open`/`rehydrate` vs\\n  `start`. Correct by design (shell vs work-surface contexts), but the two\\n  enums will need to be managed carefully as the action model evolves.\\n\\n- **`deriveAvailableActions` in `processes.ts` returns `['open']` for draft\\n  status** while the Epic 2 surface contract uses `['start']`. Correct scope\\n  separation today; the divergence will widen.\\n\\n- **`app.ts` health route still returns `story: 'story-5-return-and-recovery-visibility'`**\\n  — stale label from Epic 1's last story. Cosmetic artifact, not functional.\\n\\n- **`processLiveHub` is decorated by the websocket plugin, not by `app.ts`\\n  directly** (unlike other services). Architecturally sound given plugin\\n  sequencing, but the pattern inconsistency may surprise Story 6 authors\\n  looking for hub access in routes.\\n\\n- **`connectedProcessSurfaceStateFixture` and `processUpsertLiveFixture` use\\n  different process IDs** (`waiting` vs `running`). Mixing them in a\\n  reconciliation test would apply an upsert for a different process into the\\n  connected state. No reconciliation tests exist yet in Story 0 so no\\n  false-negatives are currently triggered, but the fixture family should be\\n  made self-consistent in Story 6.\\n\"}}],\"terminal_reason\":\"completed\",\"fast_mode_state\":\"off\",\"uuid\":\"8b25cd86-ea60-4616-95cb-e621e95188ef\"}\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/verification-bundle.md:47:- `apps/platform/client/features/processes/process-history-section.ts`\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/verification-bundle.md:56:- `tests/service/client/process-history-section.test.ts`\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/verification-bundle.md:76:- `tests/service/client/process-history-section.test.ts`\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/verification-bundle.md:105:- `tests/service/client/process-history-section.test.ts`\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/02-start-and-resume/codex-review-stalled.jsonl:9:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,260p' docs/spec-build/v2/epics/02--process-work-surface/tech-design-client.md\\\"\",\"aggregated_output\":\"# Technical Design: Process Work Surface Client\\n\\nThis companion document covers the browser-side implementation for Epic 2. The\\nclient remains the same Vite-built vanilla TypeScript shell mounted inside the\\nFastify-owned application boundary. Epic 2 does not introduce a second client\\napp or a different frontend framework. It extends the existing shell with a\\ndedicated process route, a process-surface state slice, and a typed live-update\\nclient.\\n\\n## HTML Shell and Route Model\\n\\nThe browser still receives one shell document for all authenticated project and\\nprocess routes. Epic 2 does not embed process work in a separate micro-app. The\\nserver delivers the same HTML shell, and the client router decides whether the\\ncurrent route is:\\n\\n- project index\\n- project shell\\n- process work surface\\n\\nThis matters because Epic 2 inherits Epic 1's authenticated shell bootstrap. The\\nprocess work surface is a deeper route within the same browser app, not a new\\nbootstrap path.\\n\\n### Supported Routes\\n\\n| Route | Meaning |\\n|-------|---------|\\n| `/projects` | Project index |\\n| `/projects/:projectId` | Project shell |\\n| `/projects/:projectId/processes/:processId` | Dedicated process work surface |\\n\\n### Router File Changes\\n\\n`apps/platform/client/app/router.ts` remains the router entry point, but it\\ngains a third route kind and stops using Epic 1's `?processId=` querystring as\\nthe active-work route.\\n\\n```ts\\nexport type ParsedRoute =\\n  | { kind: 'project-index'; projectId: null; selectedProcessId: null; processId: null }\\n  | { kind: 'project-shell'; projectId: string; selectedProcessId: string | null; processId: null }\\n  | { kind: 'process-work-surface'; projectId: string; selectedProcessId: null; processId: string };\\n```\\n\\nThe querystring-selected process remains a shell-only focus state for the\\nsummary list. Opening active process work always moves onto the dedicated process\\nroute.\\n\\n`parseRoute()` must check the dedicated process pattern before the broader\\n`/projects/:projectId` shell pattern. Otherwise a valid process route will be\\nmisclassified as a project-shell route.\\n\\n## Client Bootstrap\\n\\n`apps/platform/client/main.ts` and `apps/platform/client/app/bootstrap.ts` keep\\nthe same high-level sequence from Epic 1:\\n\\n1. load `/auth/me`\\n2. resolve current route\\n3. mount the correct page\\n\\nEpic 2 adds one more page target, not a new bootstrap model. The client still\\ndoes not negotiate auth on its own and still redirects immediately on\\n`UNAUTHENTICATED`.\\n\\n## Client State\\n\\nEpic 1's store was intentionally shell-shaped. Epic 2 needs one more dedicated\\nstate slice for the process work surface. The most important design rule is to\\nkeep durable bootstrap state and live transport state separate enough that\\nreload, reconnect, and in-session updates remain understandable.\\n\\n`currentRequest` is part of that live state model, not just part of bootstrap.\\nThe client should accept explicit live `current_request` messages rather than\\ntrying to re-derive the pinned request from chronological history on every\\nupdate.\\n\\n### AppState Extensions\\n\\n`apps/platform/client/app/store.ts` should extend `AppState` with:\\n\\n```ts\\nexport interface ProcessSurfaceState {\\n  project: {\\n    projectId: string;\\n    name: string;\\n    role: 'owner' | 'member';\\n  } | null;\\n  process: ProcessSurfaceSummary | null;\\n  history: ProcessHistorySectionEnvelope | null;\\n  materials: ProcessMaterialsSectionEnvelope | null;\\n  currentRequest: CurrentProcessRequest | null;\\n  sideWork: SideWorkSectionEnvelope | null;\\n  isLoading: boolean;\\n  error: RequestError | null;\\n  live: {\\n    connectionState: 'idle' | 'connecting' | 'connected' | 'reconnecting' | 'error';\\n    subscriptionId: string | null;\\n    lastSequenceNumber: number | null;\\n    error: RequestError | null;\\n  };\\n}\\n```\\n\\nAdd a top-level `processSurface` key to `AppState` rather than overloading the\\nexisting `shell` slice. The project shell and process work surface are adjacent\\nsurfaces with different state models. Keeping them separate avoids a creeping\\nunion type that makes both pages harder to reason about.\\n\\n### Store Responsibilities\\n\\n`createAppStore()` remains synchronous and framework-free. The store should not\\nbecome a generalized event bus. It still needs only:\\n\\n- `get()`\\n- `set()`\\n- `patch()`\\n- `subscribe()`\\n\\nThe new process-surface slice increases state volume, not the complexity of the\\nstore primitive itself.\\n\\n## Browser API Layer\\n\\nEpic 2 adds one HTTP API client and one live transport client.\\n\\n### `apps/platform/client/browser-api/process-work-surface-api.ts`\\n\\n```ts\\nexport async function getProcessWorkSurface(args: {\\n  projectId: string;\\n  processId: string;\\n}): Promise<ProcessWorkSurfaceResponse>;\\n\\nexport async function startProcess(args: {\\n  projectId: string;\\n  processId: string;\\n}): Promise<StartProcessResponse>;\\n\\nexport async function resumeProcess(args: {\\n  projectId: string;\\n  processId: string;\\n}): Promise<ResumeProcessResponse>;\\n\\nexport async function submitProcessResponse(args: {\\n  projectId: string;\\n  processId: string;\\n  clientRequestId: string;\\n  message: string;\\n}): Promise<SubmitProcessResponseResponse>;\\n```\\n\\nThese functions are the client-side mock boundary for process-surface HTTP\\nbehavior.\\n\\n### `apps/platform/client/browser-api/process-live-transport.ts`\\n\\n```ts\\nexport interface ProcessLiveTransport {\\n  connect(args: {\\n    projectId: string;\\n    processId: string;\\n    onMessage: (message: LiveProcessUpdateMessage) => void;\\n    onDisconnect: () => void;\\n    onError: (error: Error) => void;\\n  }): { close(): void };\\n}\\n```\\n\\nThis module wraps the browser `WebSocket` API. The page and store consume typed\\nmessages, not raw websocket event objects.\\n\\n## Feature File Layout\\n\\n```text\\napps/platform/client/features/processes/\\n├── process-work-surface-page.ts\\n├── process-history-section.ts\\n├── current-request-panel.ts\\n├── process-materials-section.ts\\n├── side-work-section.ts\\n├── process-response-composer.ts\\n└── process-live-status.ts\\n```\\n\\nThe new `processes/` feature directory keeps Epic 2 code out of the existing\\n`features/projects/` shell modules while still living under the same client app.\\n\\n### Module Responsibility Matrix\\n\\n| Module | Status | Responsibility | Dependencies | ACs Covered |\\n|--------|--------|----------------|--------------|-------------|\\n| `app/router.ts` | MODIFIED | Add process-work-surface route parsing and navigation helpers | shared contracts | AC-1.1, AC-6.1, AC-6.4 |\\n| `app/store.ts` | MODIFIED | Hold durable process-surface state and live transport metadata | shared contracts | AC-1.4, AC-2.2, AC-3.6, AC-6.x |\\n| `browser-api/process-work-surface-api.ts` | NEW | HTTP bootstrap and process action calls | fetch, shared contracts | AC-1.1 to AC-3.6 |\\n| `browser-api/process-live-transport.ts` | NEW | Typed browser WebSocket transport | WebSocket, shared contracts | AC-2.2, AC-2.3, AC-6.2, AC-6.3, AC-6.5 |\\n| `process-work-surface-page.ts` | NEW | Route-driven bootstrap, live subscription lifecycle, action orchestration, section rendering | store, HTTP API, live transport, process feature modules | AC-1.1 to AC-6.6 |\\n| `process-history-section.ts` | NEW | Render visible history section envelope and chronological items | shared contracts | AC-1.4, AC-2.3, AC-3.3, AC-6.6 |\\n| `current-request-panel.ts` | NEW | Render pinned unresolved request and attention-required state | shared contracts | AC-3.2, AC-5.1, AC-5.2 |\\n| `process-materials-section.ts` | NEW | Render artifacts, outputs, sources, and empty/error states | shared contracts | AC-4.1 to AC-4.4, AC-6.6 |\\n| `side-work-section.ts` | NEW | Render side-work summaries, statuses, and result summaries | shared contracts | AC-5.3, AC-5.4, AC-6.6 |\\n| `process-response-composer.ts` | NEW | Submit responses, block invalid submits, surface in-session validation state | process API, store | AC-3.1 to AC-3.6 |\\n| `process-live-status.ts` | NEW | Show connected/disconnected/reconnecting state and retry path | store | AC-6.2, AC-6.5 |\\n\\n## Flow 1: Route Entry and Durable Process Surface Bootstrap\\n\\n**Covers:** AC-1.1, AC-1.2, AC-1.3, AC-1.4, AC-6.1, AC-6.4\\n\\nThis flow is the first user-visible difference between Epic 1 and Epic 2. The\\nuser is no longer just focusing a process inside the shell; they are opening a\\ndedicated work surface. The page needs to resolve the route, fetch the durable\\nbootstrap, and render enough current state that the user can orient immediately.\\n\\n```mermaid\\nsequenceDiagram\\n    participant Router as router.ts\\n    participant Page as process-work-surface-page.ts\\n    participant Api as process-work-surface-api.ts\\n    participant Store as store.ts\\n\\n    Note over Router,Page: AC-1.1: open dedicated process work surface\\n    Router->>Page: mount /projects/:projectId/processes/:processId\\n    Page->>Store: set processSurface.isLoading = true\\n    Page->>Api: getProcessWorkSurface(projectId, processId)\\n    Api-->>Page: ProcessWorkSurfaceResponse\\n    Page->>Store: patch durable processSurface state\\n    Note over Page,Store: AC-1.2, AC-1.3, AC-1.4\\n    Page-->>Page: render identity, next action, history, materials, request, sideWork\\n```\\n\\n**Skeleton Requirements:**\\n\\n| What | Where | Stub Signature |\\n|------|-------|----------------|\\n| Route parsing support | `apps/platform/client/app/router.ts` | `export function parseRoute(url: URL): ParsedRoute { throw new NotImplementedError('parseRoute') }` |\\n| Process work-surface API client | `apps/platform/client/browser-api/process-work-surface-api.ts` | `export async function getProcessWorkSurface(): Promise<ProcessWorkSurfaceResponse> { throw new NotImplementedError('getProcessWorkSurface') }` |\\n| Process work-surface page | `apps/platform/client/features/processes/process-work-surface-page.ts` | `export function renderProcessWorkSurfacePage(deps: ProcessWorkSurfacePageDeps): HTMLElement { throw new NotImplementedError('renderProcessWorkSurfacePage') }` |\\n\\n**TC Mapping for this Flow:**\\n\\n| TC | Tests | Module | Setup | Assert |\\n|----|-------|--------|-------|--------|\\n| TC-1.1a | open process from project shell | `tests/service/client/process-router.test.ts` | Start on project shell, activate open-process action | Router navigates to dedicated process route |\\n| TC-1.1b | direct process URL opens surface | `tests/service/client/process-router.test.ts` | Initial route is process route | Process surface page mounts and fetches bootstrap |\\n| TC-1.2a | active process identity shown | `tests/service/client/process-work-surface-page.test.ts` | Mock bootstrap response | Project/process identity visible |\\n| TC-1.3a | next step shown on load | `tests/service/client/process-work-surface-page.test.ts` | Bootstrap with nextActionLabel | Next action visible |\\n| TC-1.3b | blocker shown on load | `tests/service/client/process-work-surface-page.test.ts` | Bootstrap with waiting/currentRequest | Blocker visible |\\n| TC-1.4a | bootstrap includes current work state | `tests/service/client/process-work-surface-page.test.ts` | Bootstrap with history/materials | Both sections render together |\\n| TC-1.4b | early process empty history state | `tests/service/client/process-history-section.test.ts` | Empty history envelope | Clear empty history state shown |\\n| TC-6.1a | browser reload restores process surface | `tests/service/client/process-router.test.ts` | Reload current process route | Same route and bootstrap fetch restored |\\n| TC-6.1b | return later restores visible state | `tests/integration/process-work-surface.test.ts` | Reopen process route in fresh session | Latest durable process surface visible |\\n| TC-6.4a | missing process shows unavailable state | `tests/service/client/process-router.test.ts` | Route loads with `PROCESS_NOT_FOUND` | Unavailable state rendered |\\n| TC-6.4b | revoked access blocks process surface | `tests/service/client/process-router.test.ts` | Route loads with forbidden response | Access-denied state rendered |\\n\\n## Flow 2: Start and Resume Actions With Same-Session Updates\\n\\n**Covers:** AC-2.1, AC-2.4, AC-2.5\\n\\nStart and resume are not just mutations; they are the first moment where the\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/02-start-and-resume/codex-review-stalled.jsonl:10:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,260p' docs/spec-build/v2/epics/02--process-work-surface/tech-design.md\\\"\",\"aggregated_output\":\"# Technical Design: Process Work Surface\\n\\n## Purpose\\n\\nThis document translates Epic 2 into implementable architecture for the Liminal\\nBuild process work surface. It is the index document for a four-file tech design\\nset:\\n\\n| Document | Role |\\n|----------|------|\\n| `tech-design.md` | Decision record, validation, system view, module architecture overview, work breakdown |\\n| `tech-design-client.md` | Route model, client state, process surface UI, live-update client, browser flow design |\\n| `tech-design-server.md` | Fastify routes, WebSocket integration, process-surface services, Convex state model, projection and action design |\\n| `test-plan.md` | TC-to-test mapping, mock strategy, fixtures, test counts, chunk verification plan |\\n\\nThe downstream consumers are:\\n\\n| Audience | What they need from this design |\\n|----------|---------------------------------|\\n| Reviewers | Clear design decisions, scope discipline, and visible trade-offs before implementation starts |\\n| Story authors | Chunk boundaries, relevant design sections, and stable technical targets for enrichment |\\n| Implementers | Exact file paths, interface targets, mock boundaries, and verification gates |\\n\\n## Spec Validation\\n\\nEpic 2 is designable after the latest clarification pass. The feature now makes\\nthe pinned-vs-chronological request distinction explicit, distinguishes side-work\\nsummary state from history state, defines same-session mutation update behavior,\\nand resolves process-surface degradation behavior at the spec level. The\\nremaining work is implementation design, not spec repair.\\n\\nThe design still needs to be explicit about one important line: Epic 2 delivers\\nthe process control surface and visible live state, not the full execution\\nsubstrate. Environment lifecycle, tool harness execution, canonical archive\\ntaxonomy, and rich artifact review remain separate concerns owned by later\\nepics.\\n\\n### Issues Found\\n\\n| Issue | Spec Location | Resolution | Status |\\n|-------|---------------|------------|--------|\\n| `currentRequest` and visible history were initially ambiguous | AC-3.2, Data Contracts | Epic now states that requests are issued into visible history and projected into a pinned unresolved request view while still active | Resolved |\\n| `sideWork` summary state and chronological history were initially ambiguous | AC-5.3, AC-5.4, Data Contracts | Epic now distinguishes current summary items from related history records | Resolved |\\n| Mutation success behavior did not define same-session surface update expectations | AC-2.x, AC-3.x, Data Contracts | Epic now states that successful actions update the visible surface immediately, then reconcile through live updates or fallback bootstrap | Resolved |\\n| Process-surface section failure policy was initially deferred to Tech Design | AC-6.x, Tech Design Questions | Epic now defines section-by-section degradation when core process identity and status are still available | Resolved |\\n| Epic 2 still defined `PROCESS_LIVE_UPDATES_UNAVAILABLE` as a `503` request error even though the surface must remain usable from durable bootstrap state | Data Contracts, Error Responses | This design treats live-unavailable as a post-bootstrap live transport state, not as an HTTP bootstrap failure. Durable bootstrap remains `200`; live failure is surfaced through the live client state and retry path | Resolved — deviated |\\n| The current Convex scaffold uses `queryGeneric`/`mutationGeneric`, `ctx: any`, and some broad `.collect()` reads that do not match the generated Convex AI guidelines | Existing codebase in `convex/*.ts` | This design standardizes new and modified Convex modules on guideline-compliant validators, typed contexts, bounded queries, and explicit indexes. Existing scaffold shortcuts are treated as implementation debt, not as design precedent | Resolved — deviated |\\n| The original Epic 1 design assumed a greenfield repo, but the current workspace already contains a working shell scaffold | Epic 1 tech design context | This design nests within the actual `apps/platform`, `convex`, and `tests` structure already in the repo | Resolved — clarified |\\n\\n## Context\\n\\nEpic 2 is the second half of Milestone 1. Epic 1 established the durable\\nproject shell: authenticated entry, project listing, project shell summaries,\\nprocess registration, and return-later shell visibility. Epic 2 is the first\\ntime the platform has to feel like a process product instead of a shell around\\nrecords. The user needs to open one process and stay oriented through active\\nprogress, conversation, current materials, unresolved requests, and return-later\\nstate without reconstructing what is happening from summaries alone.\\n\\nThe technical architecture already constrains the shape of this work. Fastify is\\nthe control plane. Convex is the durable state layer behind that control plane.\\nThe browser consumes typed upsert objects over WebSocket instead of raw provider\\ndeltas. The platform is process-first, not transcript-first, and process types\\nremain code-defined modules with process-owned semantics. The design therefore\\nneeds to add a dedicated process-surface route, a browser store that can hold\\ndurable and live state together, and a server-side projection/action layer that\\nkeeps the shared work surface generic without flattening process-specific\\nbehavior into one universal schema blob.\\n\\nThe current codebase is no longer just a Story 0 scaffold. It already contains\\nthe Epic 1 shell implementation shape: a Fastify app in `apps/platform/server`,\\na Vite-built vanilla TypeScript client in `apps/platform/client`, Zod-authored\\nshared contracts in `apps/platform/shared/contracts`, and a Convex-backed\\n`PlatformStore` abstraction that feeds the server services. That is a strength:\\nEpic 2 can extend those seams instead of inventing parallel ones. It is also a\\nconstraint: the design should preserve the existing shell route model where it\\nstill makes sense, keep the server as the composition root, and avoid\\nover-engineering a brand-new client architecture that fights the current code.\\n\\nThe highest-risk area in this design is state coherence across three different\\ntruth layers. The browser needs a durable bootstrap for reload and re-entry, a\\nlive current-object stream for in-session coherence, and a clear boundary\\nbetween visible user-facing process history and the fuller canonical archive\\nplanned for Epic 5. The design therefore needs to introduce a forward-compatible\\nvisible-history model for the process surface without pretending to solve the\\nentire archive problem early.\\n\\n## Tech Design Question Answers\\n\\n### Q1. What is the exact browser route model for entering a dedicated process work surface?\\n\\nUse a dedicated process route nested under the existing project route family:\\n\\n- `GET /projects`\\n- `GET /projects/:projectId`\\n- `GET /projects/:projectId/processes/:processId`\\n\\nFastify continues to serve the same authenticated shell HTML for all project and\\nprocess routes. The client router expands from two route kinds to three:\\n\\n- `project-index`\\n- `project-shell`\\n- `process-work-surface`\\n\\nEpic 1's `?processId=` query parameter remains a shell-level focus affordance for\\nthe project shell only. Opening active work moves the user onto the dedicated\\nprocess route. This keeps the process work surface bookmarkable, reloadable, and\\ndistinct from the project shell without creating a second HTML application.\\n\\n### Q2. What exact browser store shape should hold durable process history, current live objects, current materials, and side-work items?\\n\\nExtend the existing synchronous app store with a dedicated `processSurface`\\nslice. Keep durable bootstrap state and live transport state in the same slice,\\nbut do not collapse them into one undifferentiated object. The client needs to\\nremember what came from bootstrap, what is currently connected, and how to\\nreconcile finalized visible items after reconnect.\\n\\nThe client slice should hold:\\n\\n- route-resolved process identity (`projectId`, `processId`)\\n- durable bootstrap payload (`project`, `process`, `history`, `materials`,\\n  `currentRequest`, `sideWork`)\\n- request-level load state and error\\n- live connection state (`idle`, `connecting`, `connected`, `reconnecting`,\\n  `error`)\\n- active subscription metadata (`subscriptionId`, `lastSequenceNumber`)\\n- live transport error or disconnect banner state\\n\\nThe client applies typed `snapshot`, `upsert`, `complete`, and `error` messages\\ninto current-object state. Finalized history items are keyed by `historyItemId`\\nso reconnect/reload can merge state without duplicating items the user has\\nalready seen settle.\\n\\n### Q3. What exact WebSocket subscription/authentication model should the platform use for process live updates?\\n\\nUse `@fastify/websocket` inside the existing Fastify monolith. Register the\\nplugin before routes so Fastify can intercept WebSocket routes correctly. Expose\\none browser-facing route:\\n\\n- `GET /ws/projects/:projectId/processes/:processId`\\n\\nAuthentication and authorization follow the same server-owned session model as\\nthe HTTP shell routes:\\n\\n- session cookie is validated server-side\\n- project/process access is checked before the connection is accepted\\n- unauthorized connections are rejected before subscription starts\\n\\nThe server sends typed process-surface messages only after successful access\\nresolution. The client does not connect directly to Convex or any provider\\nruntime.\\n\\n### Q4. What exact reconciliation policy should the client use after reconnect?\\n\\nUse bootstrap-first, stream-second reconciliation.\\n\\n1. Process route opens.\\n2. Browser fetches the durable process-surface bootstrap over HTTP.\\n3. Browser opens the WebSocket subscription.\\n4. Server sends a `snapshot` message describing the current live objects for the\\n   surface.\\n5. Browser applies later `upsert` and `complete` messages in `sequenceNumber`\\n   order within the active `subscriptionId`.\\n\\nReconnect rules:\\n\\n- If the socket drops, keep the last visible durable/current state on screen.\\n- On reconnect, fetch a fresh durable bootstrap before resubscribing.\\n- Merge finalized history items by `historyItemId`.\\n- Treat `complete` as the settling edge for current live objects.\\n- Replace current-object state with newer `snapshot`/`upsert` payloads instead of\\n  replaying raw deltas.\\n\\nThis keeps the browser state legible even if the process progresses while the\\nuser is disconnected.\\n\\n### Q5. What exact process-surface projection contract should each process module implement?\\n\\nIntroduce a process module registry for the first time. Epic 1 could derive\\nshell summaries from the generic `processes` row and minimal type-state rows.\\nEpic 2 needs more than that: current materials, current request, current output\\nvisibility, action availability, and response semantics are process-owned.\\n\\nEach process module implements a shared interface:\\n\\n```ts\\nexport interface ProcessWorkSurfaceModule<TState> {\\n  processType: SupportedProcessType;\\n  getState(args: { processId: string }): Promise<TState | null>;\\n  buildShellSummary(args: { process: ProcessRecord; state: TState }): ProcessSummary;\\n  buildSurfaceProjection(args: {\\n    process: ProcessRecord;\\n    state: TState;\\n    visibleHistory: ProcessHistoryItem[];\\n    sideWork: SideWorkItem[];\\n    outputs: ProcessOutputRecord[];\\n    artifactLookup: Map<string, ArtifactSummary>;\\n    sourceLookup: Map<string, SourceAttachmentSummary>;\\n  }): ProcessSurfaceProjection;\\n  start(args: { process: ProcessRecord; state: TState; actorId: string }): Promise<ProcessActionResult>;\\n  resume(args: { process: ProcessRecord; state: TState; actorId: string }): Promise<ProcessActionResult>;\\n  respond(args: {\\n    process: ProcessRecord;\\n    state: TState;\\n    actorId: string;\\n    message: string;\\n    clientRequestId: string;\\n  }): Promise<ProcessActionResult>;\\n}\\n```\\n\\nThis keeps the shared process work surface generic while letting each process\\nmodule own its phase semantics, prompts, output shaping, and response behavior.\\n\\n### Q6. What exact data model should represent visible side work if full inspectable subthreads remain out of scope?\\n\\nUse a dedicated `processSideWorkItems` table for current summary state and a\\nrelated visible history trail in `processHistoryItems`.\\n\\nThe table stores bounded, user-facing summary state:\\n\\n- `processId`\\n- `displayLabel`\\n- `purposeSummary`\\n- `status`\\n- `resultSummary`\\n- `updatedAt`\\n\\nVisible history records the chronological moments:\\n\\n- side work started\\n- side work status changed\\n- side work completed or failed\\n- parent process changed because of that outcome\\n\\nThis matches the epic: users see current side-work status in a summary section\\nwithout requiring a full subordinate-thread viewer.\\n\\n### Q7. What exact persistence grain should Epic 2 use for visible process history before Epic 5 delivers the full canonical archive?\\n\\nAdd a durable `processHistoryItems` table now as the user-facing visible history\\nlayer for the process surface. Do not implement the full Feature 5 canonical\\narchive taxonomy in Epic 2.\\n\\nThis table stores user-facing visible items only:\\n\\n- user messages\\n- process messages\\n- progress updates\\n- attention requests\\n- side-work updates\\n- process events\\n\\nEach row is a stable visible item, not a raw streaming delta. Rows may move from\\n`current` to `finalized`, but they are never replayed as opaque low-level\\nprovider fragments in the browser.\\n\\nEpic 5 can later add the lower-level canonical archive and derive richer views\\nwithout invalidating the Epic 2 process surface.\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/02-start-and-resume/codex-review-stalled.jsonl:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,260p' docs/spec-build/v2/epics/02--process-work-surface/tech-design-server.md\\\"\",\"aggregated_output\":\"# Technical Design: Process Work Surface Server\\n\\nThis companion document covers the Fastify, WebSocket, service, and Convex\\ndesign for Epic 2. It expands the server-owned parts of the index document into\\nexact module boundaries, durable state decisions, flow design, and copy-paste\\nready interfaces.\\n\\n## Server Bootstrap\\n\\nThe server remains a single Fastify 5 application that owns shell delivery,\\nauth, project APIs, and process APIs. Epic 2 adds process-surface APIs and a\\nWebSocket live-update path inside the same Fastify monolith. It does not add a\\nsecond server or let the browser connect to Convex directly.\\n\\n### Entry Point: `apps/platform/server/index.ts`\\n\\nResponsibilities remain the same:\\n\\n- load environment configuration\\n- construct the Fastify app\\n- start the HTTP server\\n\\nEpic 2 adds one more responsibility inside app startup: ensure websocket support\\nis registered before process routes are mounted.\\n\\n### App Factory: `apps/platform/server/app.ts`\\n\\n`app.ts` remains the main assembly point. Epic 2 extends it to:\\n\\n- register the new websocket plugin\\n- register process routes after auth and websocket plugins are ready\\n- decorate the Fastify instance with the process live hub and new process\\n  services\\n\\nThe assembly order matters. `@fastify/websocket` must be registered before any\\nroute using websocket handlers, otherwise Fastify will not attach the websocket\\nroute behavior correctly.\\n\\n## Top-Tier Surface Nesting\\n\\n| Surface | Epic 2 Nesting |\\n|---------|----------------|\\n| Projects | Existing project shell remains the entry path into a process |\\n| Processes | `routes/processes.ts`, process action services, process module registry, process live hub |\\n| Artifacts | Materials reader resolves current artifact context for the process surface |\\n| Sources | Materials reader resolves current source context for the process surface |\\n| Archive | Epic 2 adds visible process history only; the full canonical archive remains a later concern |\\n\\nThe process surface is process-owned. Project services are still relevant for\\nentry and access, but the main server-side implementation should live under\\n`services/processes/` instead of extending the Epic 1 shell services beyond\\ntheir natural role.\\n\\n## Module Architecture\\n\\n```text\\napps/platform/server/\\n├── app.ts\\n├── plugins/\\n│   ├── cookies.plugin.ts\\n│   ├── csrf.plugin.ts\\n│   ├── vite.plugin.ts\\n│   ├── workos-auth.plugin.ts\\n│   └── websocket.plugin.ts                 # NEW\\n├── routes/\\n│   ├── auth.ts\\n│   ├── projects.ts\\n│   └── processes.ts                        # NEW\\n├── services/\\n│   ├── auth/\\n│   ├── projects/\\n│   └── processes/\\n│       ├── process-access.service.ts       # NEW\\n│       ├── process-work-surface.service.ts # NEW\\n│       ├── process-start.service.ts        # NEW\\n│       ├── process-resume.service.ts       # NEW\\n│       ├── process-response.service.ts     # NEW\\n│       ├── process-module-registry.ts      # NEW\\n│       ├── live/\\n│       │   ├── process-live-hub.ts         # NEW\\n│       │   └── process-live-normalizer.ts  # NEW\\n│       ├── readers/\\n│       │   ├── history-section.reader.ts   # NEW\\n│       │   ├── materials-section.reader.ts # NEW\\n│       │   └── side-work-section.reader.ts # NEW\\n│       └── summary/\\n│           ├── process-history.builder.ts   # NEW\\n│           ├── current-request.projector.ts # NEW\\n│           ├── process-materials.builder.ts # NEW\\n│           └── sid`TC-4.3a read-only source not recorded as write target` | Provenance service rejects/omits invalid write provenance |\\\\\\\\n| TC-4.4a | `tests/service/server/source-management-api.test.ts` | `TC-4.4a degraded provenance entry does not hide healthy entries` | Mixed ready/degraded response |\\\\\\\\n| TC-4.4b | `tests/service/client/source-provenance-section.test.ts` | `TC-4.4b degraded provenance falls back to durable identity` | UI shows copied identity and degraded reason |\\\\\\\\n| TC-5.1a | `tests/service/server/source-management-api.test.ts` | `TC-5.1a detaches project-scoped source` | DELETE returns detached response |\\\\\\\\n| TC-5.1b | `tests/service/server/source-management-api.test.ts` | `TC-5.1b detaches process-scoped source` | DELETE enforces process/project relationship |\\\\\\\\n| TC-5.1c | `tests/service/server/process-execution-orchestrator.test.ts` | `TC-5.1c detach during active process does not rewrite hydrated copy` | Existing environment copy remains; future current-source list updates |\\\\\\\\n| TC-5.2a | `convex/sourceProvenance.test.ts` | `TC-5.2a prior provenance remains after detach` | Provenance still readable after source detached |\\\\\\\\n| TC-5.3a | `tests/service/client/source-management-ui.test.ts` | `TC-5.3a unrelated attachments remain after detach` | UI removes only detached row |\\\\\\\\n| TC-6.1a | `tests/service/server/projects-api.test.ts` | `TC-6.1a reopens project source attachment state` | GET project shell returns source state after reload |\\\\\\\\n| TC-6.1b | `tests/service/server/process-work-surface-api.test.ts` | `TC-6.1b reopens process source attachment state` | GET process work surface returns current sources |\\\\\\\\n| TC-6.2a | `tests/service/client/source-management-ui.test.ts` | `TC-6.2a unavailable source shown safely` | Displays unavailable without unsafe action |\\\\\\\\n| TC-6.2b | `tests/service/server/source-management-api.test.ts` | `TC-6.2b revoked access blocks source management` | 403/503 depending revoked project vs repo access |\\\\\\\\n| TC-6.3a | `tests/service/server/projects-api.test.ts` | `TC-6.3a one failing source does not hide healthy sources` | Section returns healthy rows plus bounded error/degraded row |\\\\\\\\n\\\\\\\\n## Non-TC Decided Tests\\\\\\\\n\\\\\\\\n| Test File | Test Description | Reason |\\\\\\\\n|-----------|------------------|--------|\\\\\\\\n| `tests/service/client/process-live.test.ts` | source schemas accept Epic 6 fields and reject missing required identity/freshness fields | Protects shared contract expansion before route/client work |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | derives `repositoryFullName` from valid HTTPS GitHub URLs with and without `.git` | Protects identity normalization used by multiple ACs |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | rejects non-GitHub URLs in the first repository-focused slice | Prevents accidental external-source scope creep |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | rejects mismatched `repositoryUrl` and provided `repositoryFullName` | Prevents identity spoofing or accidental mismatch |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | rejects `read_write` sources that target tags or commits | Locks down writable-ref policy |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | resolves missing `targetRef` on `read_write` to the repository default branch before persistence | Clarifies writable-source default-branch behavior |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | process-scoped source shadows project-scoped source only for matching process | Critical resolver behavior not covered by one explicit TC |\\\\\\\\n| `convex/sourceAttachments.test.ts` | detached rows are excluded from active listings but still exist durably | Soft-detach invariant |\\\\\\\\n| `tests/service/server/source-management-service.test.ts` | branch-head movement marks a hydrated source stale using durable resolved-ref snapshot fields | Covers moving-branch freshness semantics |\\\\\\\\n| `tests/service/server/source-management-api.test.ts` | request-level refresh errors differ from `refreshStatus: failed` | Clarifies response contract |\\\\\\\\n| `tests/service/server/source-management-api.test.ts` | unavailable or revoked source reads redact current source details while preserving bounded state | Covers AC-6.2 redaction requirement |\\\\\\\\n| `tests/service/client/source-management-ui.test.ts` | pending refresh does not render as a fifth hydration state | Protects canonical four-state model |\\\\\\\\n\\\\\\\\n## Chunk Test Counts\\\\\\\\n\\\\\\\\n| Chunk | TC Tests | Non-TC Tests | Total | Primary Files |\\\\\\\\n|-------|----------|--------------|-------|---------------|\\\\\\\\n| 0 Foundation | 0 | 1 | 1 | contract/schema/fixture tests |\\\\\\\\n| 1 Attach repositories | 8 | 6 | 14 | source-management API/service, Convex |\\\\\\\\n| 2 Manage metadata | 5 | 0 | 5 | source-management API, client sections |\\\\\\\\n| 3 Hydration/freshness | 6 | 3 | 9 | source-management API/UI |\\\\\\\\n| 4 Provenance | 6 | 2 | 8 | source provenance API, Convex, client |\\\\\\\\n| 5 Detach | 5 | 1 | 6 | API, Convex, execution orchestrator, UI |\\\\\\\\n| 6 Reopen/degraded | 5 | 0 | 5 | projects/process work surface API, UI |\\\\\\\\n| **Total** | **35** | **12** | **47** |  |\\\\\\\\n\\\\\\\\nThe TC count is 35 because Epic 6 has 35 named TCs. Non-TC tests cover identity\\\\\\\\nnormalization, external-source scope exclusion, URL/full-name mismatch,\\\\\\\\nwritable-ref policy, scope-shadowing, branch-drift freshness, soft-detach\\\\\\\\ninvariants, refresh response semantics, unavailable-source redaction, and\\\\\\\\ncanonical hydration-state protection.\\\\\\\\n\\\\\\\\n## Verification Gates\\\\\\\\n\\\\\\\\n| Phase | Command | Expected Result |\\\\\\\\n|-------|---------|-----------------|\\\\\\\\n| Skeleton / Red exit | `pnpm run red-verify` | Format, lint, typecheck, and build pass while new behavior tests fail against stubs |\\\\\\\\n| Development | `pnpm run verify` | Standard project verification passes |\\\\\\\\n| Green exit | `pnpm run green-verify` | All tests pass and no-test-change guard runs |\\\\\\\\n| Story/Epic completion | `pnpm run verify-all` | Full verification, integration, and e2e scaffold pass |\\\\\\\\n\\\\\\\\n## Manual Verification Checklist\\\\\\\\n\\\\\\\\n1. Start Convex with `pnpm run convex:dev`.\\\\\\\\n2. Start app server with `pnpm dev`.\\\\\\\\n3. Open a project shell and attach a GitHub repository at project scope.\\\\\\\\n4. Open a process work surface and attach a process-scoped repository.\\\\\\\\n5. Verify duplicate exact attachments are blocked but project/process scope can coexist.\\\\\\\\n6. Change a target ref and confirm the source becomes stale.\\\\\\\\n7. Trigger refresh and verify settled or pending state is visible.\\\\\\\\n8. Detach one source and verify other sources remain visible.\\\\\\\\n9. Reopen the project and process pages and confirm source/provenance state persists.\\\\\\\\n\\\\\\\\n## Reconciliation\\\\\\\\n\\\\\\\\n- TC tests: 35\\\\\\\\n- Non-TC decided tests: 12\\\\\\\\n- Planned automated tests: 47\\\\\\\\n- Manual verification steps: 9\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/02-manage-purpose-access-mode-and-target-ref/streams/005-verify.stdout.log:13:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_5\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"sed -n '1,260p' docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/tech-design.md\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"# Technical Design: Epic 6 Source Attachments and Canonical Source Management\\\\\\\\n\\\\\\\\n## Purpose\\\\\\\\n\\\\\\\\nThis document translates Epic 6 into an implementable design for repository\\\\\\\\nsource-management. It is the implementation blueprint for source attachment\\\\\\\\nlifecycle, source identity, freshness, provenance, detach, and reopen behavior.\\\\\\\\n\\\\\\\\n| Audience | Value |\\\\\\\\n|----------|-------|\\\\\\\\n| Reviewers | Validate that Epic 6 fits the core platform architecture before code is written |\\\\\\\\n| Developers | Know which files, services, Convex functions, and contracts to change |\\\\\\\\n| Story Tech Sections | Reuse module responsibilities, interfaces, test mappings, and chunk boundaries |\\\\\\\\n\\\\\\\\nRelated documents:\\\\\\\\n\\\\\\\\n- Epic: `docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/epic.md`\\\\\\\\n- Test plan: `docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/test-plan.md`\\\\\\\\n- Architecture: `docs/spec-build/v2/core-platform-arch.md`\\\\\\\\n- PRD: `docs/spec-build/v2/core-platform-prd.md`\\\\\\\\n\\\\\\\\nOutput configuration: Config A. Epic 6 gets this `tech-design.md` and a separate\\\\\\\\n`test-plan.md`. The work crosses client, Fastify, Convex, environment, and\\\\\\\\nGitHub boundaries, but the source-management slice is still coherent enough to\\\\\\\\nkeep implementation depth in one index document.\\\\\\\\n\\\\\\\\n## Spec Validation\\\\\\\\n\\\\\\\\nEpic 6 is implementation-ready. The epic covers repository source lifecycle\\\\\\\\nonly, leaves archive and derived views to Epic 7, and defers MCP/external-source\\\\\\\\nattachment beyond the Epic 5-7 sequence.\\\\\\\\n\\\\\\\\n| Issue | Spec Location | Resolution | Status |\\\\\\\\n|-------|---------------|------------|--------|\\\\\\\\n| Source identity needs both operational URL and canonical GitHub identity | Data Contracts, AC-1.3, AC-4.x | Design stores `repositoryUrl` for clone/write operations and `repositoryFullName` for uniqueness/provenance. `repositoryFullName` is derived server-side when omitted. | Resolved - clarified |\\\\\\\\n| Refresh cannot always settle synchronously | AC-3.3, Refresh Response | Design returns `refreshStatus: settled | pending | failed`, with pending as operation metadata rather than a fifth hydration state. | Resolved - clarified |\\\\\\\\n| Process-scoped shadowing needs exact read rule | Tech Design Question 7 | Design defines an active-source resolver that combines project-scoped and process-scoped attachments, shadows by `repositoryFullName + targetRef`, and excludes detached rows. | Resolved |\\\\\\\\n| Detach representation needs exact storage shape | Tech Design Question 8 | Design adds soft-detach fields (`detachedAt`, `detachedByUserId`) and active-list filters. | Resolved |\\\\\\\\n| Source provenance storage is deferred by epic | AC-4.x | Design introduces durable `sourceProvenance` records with copied immutable source identity. | Resolved |\\\\\\\\n\\\\\\\\nNo design-time deviation from the PRD or architecture is required. Fastify\\\\\\\\ncontinues to own source-management policy and orchestration; Convex owns durable\\\\\\\\nrecords and atomic persistence invariants.\\\\\\\\n\\\\\\\\n## Tech Design Questions Answered\\\\\\\\n\\\\\\\\n| # | Epic Question | Design Answer |\\\\\\\\n|---|---------------|---------------|\\\\\\\\n| 1 | What exact browser interaction model should attach, update, refresh, and detach use without creating a separate source-management app? | Extend the existing project shell and process work surface. Project-scoped actions appear in the project source section; process-scoped actions appear in the process materials/source area. Client calls Fastify JSON APIs and renders settled/pending/degraded responses in-place. No standalone source app or live source subscription is added. |\\\\\\\\n| 2 | What exact durable schema should represent source attachments and provenance visibility? | Extend `sourceAttachments` with `repositoryFullName`, freshness fields, refresh progress fields, and soft-detach fields. Add `sourceProvenance` for process-specific provenance with copied immutable source identity. Artifact ownership remains untouched. |\\\\\\\\n| 3 | What exact conflict rule applies for same repository/target ref across related contexts? | Duplicate key is active `projectId + processId + repositoryFullName + targetRef`. Same identity/ref may exist once at project scope and once at process scope. Process-scoped rows shadow project-scoped rows only for that process's current-source read. |\\\\\\\\n| 4 | What exact refresh/freshness policy maps to the four source states? | The canonical states remain `not_hydrated`, `hydrated`, `stale`, and `unavailable`. Target-ref changes make hydrated rows stale. Refresh returns settled/pending/failed operation metadata; pending is not a fifth hydration state. Branch freshness is checked when the surface reads or refresh is requested, not by background polling. |\\\\\\\\n| 5 | What provenance surface shows informed-work and received-code-update relationships? | Add a process provenance endpoint and client section that reads durable `sourceProvenance` entries. Entries are `informed_work` or `received_code_update`, copy repository identity, and enrich current attachment context independently when available. |\\\\\\\\n| 6 | How should shell/process surfaces stay coherent across project and process scope? | Keep project shell source summaries for project-wide management. Process work surfaces show current sources after active-source resolution, including process-scoped shadowing and applicable project-scoped rows. |\\\\\\\\n| 7 | What exact current-source read algorithm combines scopes and degrades boundedly? | `resolveActiveProcessSources` excludes detached rows, starts from current material refs, pulls in process-scoped siblings when they shadow an active project-scoped source, partitions by scope, shadows by `repositoryFullName + targetRef`, sorts by `updatedAt`, and preserves per-row degraded metadata. |\\\\\\\\n| 8 | What soft-detach representation preserves identity and provenance? | Add `detachedAt` and `detachedByUserId` to source attachments. Active listings filter detached rows, but provenance entries remain durable because they copy identity and may retain nullable `sourceAttachmentId`. |\\\\\\\\n\\\\\\\\n## Context\\\\\\\\n\\\\\\\\nEpic 6 implements the repository-focused half of PRD Feature 5. Earlier epics\\\\\\\\nalready made source attachments visible enough for hydration and checkpointing,\\\\\\\\nbut that substrate is not yet a complete management surface. Today, Convex has a\\\\\\\\n`sourceAttachments` table, project shell summaries expose attached sources, and\\\\\\\\nprocess materials can show current source references. Environment hydration and\\\\\\\\ncode checkpointing already use `repositoryUrl` as the operational clone/write\\\\\\\\naddress.\\\\\\\\n\\\\\\\\nThe missing layer is user- and process-facing source management. A user needs to\\\\\\\\nattach a GitHub repository to a project or to one process, classify why it is\\\\\\\\nattached, understand whether it can receive writes, refresh stale or missing\\\\\\\\nworking copies, detach it from current use without erasing history, and later\\\\\\\\nunderstand which sources informed or received process work. Those behaviors\\\\\\\\ncannot be implicit side effects of environment hydration.\\\\\\\\n\\\\\\\\nThe core architecture shapes the design. GitHub remains code truth. The\\\\\\\\nsandboxed filesystem is only a disposable working copy. Fastify is the source\\\\\\\\nmanagement control plane: it validates repository identity, enforces project and\\\\\\\\nprocess access, resolves shadowing rules, coordinates refresh, and records\\\\\\\\nprovenance intent. Convex stores durable source attachment and provenance rows\\\\\\\\nbehind Fastify with validators and indexes that preserve integrity.\\\\\\\\n\\\\\\\\nEpic 6 also establishes contracts that Epic 7 will consume. Source provenance is\\\\\\\\ndurable and process-specific; it copies immutable repository identity at the\\\\\\\\ntime work is informed or code is updated. Archive entries in Epic 7 can link to\\\\\\\\nthose provenance records without asking source attachments to become archive\\\\\\\\ntruth.\\\\\\\\n\\\\\\\\n## System View\\\\\\\\n\\\\\\\\n### Top-Tier Surfaces\\\\\\\\n\\\\\\\\n| Surface | Source | This Epic's Role |\\\\\\\\n|---------|--------|------------------|\\\\\\\\n| Projects | Core architecture | Project-scoped source attachments appear in the project shell and can be managed there |\\\\\\\\n| Processes | Core architecture | Process-scoped attachments, current-source views, and source provenance appear in the process work surface |\\\\\\\\n| Sources | Core architecture | Primary Epic 6 domain; owns repository attachment lifecycle, freshness, detach, and provenance records |\\\\\\\\n| Environments | Core architecture | Hydrates active source attachments and reports freshness/checkpoint effects |\\\\\\\\n| Tool Runtime | Core architecture | Produces source-use and code-update signals through environment execution results |\\\\\\\\n| Archive | Core architecture | Downstream consumer only; Epic 6 provides source provenance that Epic 7 can reference |\\\\\\\\n\\\\\\\\n### Runtime Flow\\\\\\\\n\\\\\\\\n```mermaid\\\\\\\\nflowchart LR\\\\\\\\n    UI[Client project/process UI]\\\\\\\\n    API[Fastify source routes]\\\\\\\\n    SVC[SourceManagementService]\\\\\\\\n    STORE[PlatformStore]\\\\\\\\n    X[(Convex)]\\\\\\\\n    GH[GitHub]\\\\\\\\n    ENV[Environment services]\\\\\\\\n\\\\\\\\n    UI --> API\\\\\\\\n    API --> SVC\\\\\\\\n    SVC --> GH\\\\\\\\n    SVC --> STORE\\\\\\\\n    STORE --> X\\\\\\\\n    ENV --> SVC\\\\\\\\n    ENV --> STORE\\\\\\\\n```\\\\\\\\n\\\\\\\\nThe normal path starts in the existing project shell or process work surface.\\\\\\\\nThe client calls Fastify API routes. Fastify validates auth and project/process\\\\\\\\naccess, delegates source-specific decisions to `SourceManagementService`, then\\\\\\\\npersists through `PlatformStore` into Convex. GitHub is consulted for repository\\\\\\\\nidentity and accessibility; environment services consume active source summaries\\\\\\\\nfor hydration and checkpointing.\\\\\\\\n\\\\\\\\n### External Contracts\\\\\\\\n\\\\\\\\nEpic 6 introduces no new third-party package. It uses the existing GitHub\\\\\\\\nintegration surface already present for code checkpointing.\\\\\\\\n\\\\\\\\n| External Boundary | Used For | Mock Strategy |\\\\\\\\n|-------------------|----------|---------------|\\\\\\\\n| GitHub API / clone identity | Validate repository existence, access, canonical `owner/name`, and target ref resolution | Mock in server service tests through a `GitHubRepositoryResolver` interface |\\\\\\\\n| Environment provider | Refresh or rehydrate working copies when needed | Mock provider adapter/service in process-level tests; do not mock internal source services |\\\\\\\\n| Convex | Durable source attachment and provenance persistence | Use Convex function tests for durable invariants; in Fastify service tests use existing PlatformStore fakes or in-memory harnesses |\\\\\\\\n\\\\\\\\n### Runtime Prerequisites\\\\\\\\n\\\\\\\\n| Prerequisite | Where Needed | How to Verify |\\\\\\\\n|--------------|--------------|---------------|\\\\\\\\n| WorkOS-authenticated Fastify request | All source-management routes | Existing auth middleware populates `request.actor` |\\\\\\\\n| GitHub token/config | Repository validation and branch freshness checks | Epic 6 introduces a dedicated `GitHubRepositoryResolver` seam over the existing app GitHub configuration |\\\\\\\\n| Convex deployment/local backend | Durable source and provenance records | `pnpm run convex:dev` for runtime; tests use in-memory/mocked stores |\\\\\\\\n| Environment refresh seam | Refresh/recovery paths | Epic 6 introduces a dedicated source refresh seam over existing process/environment services rather than assuming a full source-management implementation already exists |\\\\\\\\n| Existing verification scripts | Story execution | `pnpm run red-verify`, `pnpm run verify`, `pnpm run green-verify`, `pnpm run verify-all` |\\\\\\\\n\\\\\\\\n## Decisions\\\\\\\\n\\\\\\\\n| Decision | Rationale | Consequence |\\\\\\\\n|----------|-----------|-------------|\\\\\\\\n| Keep `repositoryUrl` and add `repositoryFullName` | `repositoryUrl` is operational clone/write input; `owner/name` is stable GitHub identity for uniqueness and provenance | Create accepts URL-first requests and may derive full name; persisted summaries return both |\\\\\\\\n| Source-management routes live in Fastify | Architecture says Fastify owns orchestration, auth, integrations, and source policy | Convex functions remain trusted persistence operations, not public app API |\\\\\\\\n| Soft detach rather than hard delete | Prior provenance and historical source identity must remain visible after detach | Active source reads filter detached rows; provenance can still resolve copied identity |\\\\\\\\n| Refresh may be pending | Repo fetch/hydration work can exceed a short request | Pending state is operation metadata, not a fifth canonical hydration state |\\\\\\\\n| Process-scoped attach updates current process source refs immediately | The epic says a process-scoped attachment belongs to one process as current source state and becomes visible immediately | `attachProcessSource` persists the source row and adds its id to that process's current source refs in the same orchestration path |\\\\\\\\n| Process scope shadows project scope only in current-source reads | Same repo can be useful both project-wide and process-specific | Durable rows can coexist; resolver picks process-scoped row for that process when identity/ref collide |\\\\\\\\n| Read-write attachments require branch-like target refs | Durable code updates need a writable moving ref rather than an immutable commit/tag | `read_write` attachments reject tag/commit target refs; `read_only` attachments may use branch/tag/commit |\\\\\\\\n| Provenance records copy immutable identity | Detach or access loss must not erase process history | Provenance stores `repositoryFullName`, `repositoryUrl`, `targetRef`, relationship kind, and optional attachment id |\\\\\\\\n\\\\\\\\n## Module Boundaries\\\\\\\\n\\\\\\\\n### File Architecture\\\\\\\\n\\\\\\\\n```\\\\\\\\nconvex/\\\\\\\\n├── sourceAttachments.ts                         # MODIFIED: durable CRUD/query functions for source lifecycle\\\\\\\\n├── sourceProvenance.ts                          # NEW: durable source provenance records and process reads\\\\\\\\n└── schema.ts                                    # MODIFIED: source fields, provenance table, indexes\\\\\\\\n\\\\\\\\napps/platform/shared/contracts/\\\\\\\\n├── schemas.ts                                   # MODIFIED: source summary fields, source provenance schemas\\\\\\\\n├── source-management.ts                         # NEW: route request/response contracts and route constants\\\\\\\\n└── index.ts                                     # MODIFIED: exports\\\\\\\\n\\\\\\\\napps/platform/server/schemas/\\\\\\\\n└── source-management.ts                         # NEW: Zod route schemas for source-management APIs\\\\\\\\n\\\\\\\\napps/platform/server/routes/\\\\\\\\n└── source-management.ts                         # NEW: Fastify routes for attach/update/refresh/detach/provenance\\\\\\\\n\\\\\\\\napps/platform/server/services/sources/\\\\\\\\n├── source-management.service.ts                 # NEW: orchestration, validation, conflict/shadowing policy\\\\\\\\n├── source-identity.service.ts                   # NEW: URL parsing, canonical full-name derivation, target-ref normalization\\\\\\\\n├── github-repository-resolver.ts                # NEW: GitHub access/ref validation boundary\\\\\\\\n├── source-refresh.service.ts                    # NEW: refresh request handling and pending/settled result shaping\\\\\\\\n└── source-provenance.service.ts                 # NEW: provenance record creation/read enrichment\\\\\\\\n\\\\\\\\napps/platform/server/services/projects/\\\\\\\\n├── platform-store.ts                            # MODIFIED: source lifecycle/provenance methods\\\\\\\\n└── readers/source-section.reader.ts             # MODIFIED: active/non-detached project source summaries\\\\\\\\n\\\\\\\\napps/platform/server/services/processes/readers/\\\\\\\\n└── materials-section.reader.ts                  # MODIFIED: active-source resolver and process shadowing\\\\\\\\n\\\\\\\\napps/platform/client/features/projects/\\\\\\\\n└── source-attachment-section.ts                 # MODIFIED: management controls and pending/degraded state display\\\\\\\\n\\\\\\\\napps/platform/client/features/processes/\\\\\\\\n├── process-materials-section.ts                 # MODIFIED: current-source shadowing/freshness/provenance display\\\\\\\\n└── source-provenance-section.ts                 # NEW: process provenance section\\\\\\\\n\\\\\\\\ntests/\\\\\\\\n├── fixtures/sources.ts                          # MODIFIED: repositoryFullName, freshness, detach, provenance fixtures\\\\\\\\n├── service/server/source-management-api.test.ts # NEW: Fastify route/service tests\\\\\\\\n├── service/server/source-management-service.test.ts # NEW: pure policy/resolver tests\\\\\\\\n├── service/client/source-management-ui.test.ts  # NEW: client behavior tests\\\\\\\\n└── service/client/source-provenance-section.test.ts # NEW: provenance UI tests\\\\\\\\n```\\\\\\\\n\\\\\\\\n### Module Responsibility Matrix\\\\\\\\n\\\\\\\\n| Module | Status | Responsibility | Dependencies | ACs Covered |\\\\\\\\n|--------|--------|----------------|--------------|-------------|\\\\\\\\n| `convex/sourceAttachments.ts` | Modified | Persist source rows, active queries, duplicate indexes, soft detach fields, hydration/freshness updates | Convex validators/schema | AC-1.x, AC-2.x, AC-3.x, AC-5.x, AC-6.x |\\\\\\\\n| `convex/sourceProvenance.ts` | New | Persist and read process-scoped provenance entries with copied source identity | Convex validators/schema | AC-4.x, AC-5.2 |\\\\\\\\n| `source-management.ts` contracts | New | Shared request/response schemas, error codes, route constants | Zod shared schemas | All route-facing ACs |\\\\\\\\n| `registerSourceManagementRoutes` | New | Authenticated Fastify API entry points | SourceManagementService, access services | AC-1.x through AC-6.x |\\\\\\\\n| `SourceManagementService` | New | Attach/update/detach orchestration, conflict rules, scope enforcement | PlatformStore, SourceIdentityService, GitHubRepositoryResolver | AC-1.x, AC-2.x, AC-5.x, AC-6.2 |\\\\\\\\n| `SourceRefreshService` | New | Refresh request policy, settled/pending/failed response mapping | PlatformStore, environment/service hooks, GitHub resolver | AC-3.x |\\\\\\\\n| `SourceProvenanceService` | New | Record/read provenance, enrich degraded entries independently | PlatformStore | AC-4.x, AC-5.2 |\\\\\\\\n| `MaterialsSectionReader` | Modified | Resolve current process sources with process-scoped shadowing and detached filtering | PlatformStore | AC-2.1, AC-3.1, AC-6.1 |\\\\\\\\n| `SourceSectionReader` | Modified | Project shell source summaries, excluding inactive rows from active lists | PlatformStore | AC-1.2, AC-2.1, AC-3.1, AC-5.3, AC-6.1 |\\\\\\\\n| Client source sections | Modified/New | Render management controls, freshness, provenance, detach, degraded states | Shared contracts | AC-1.2, AC-2.x, AC-3.x, AC-4.x, AC-5.x, AC-6.x |\\\\\\\\n\\\\\\\\n## Data Model\\\\\\\\n\\\\\\\\n### Convex `sourceAttachments`\\\\\\\\n\\\\\\\\nThe existing table remains the durable source attachment table. Epic 6 extends\\\\\\\\nit rather than introducing a parallel source identity table.\\\\\\\\n\\\\\\\\n```typescript\\\\\\\\nexport const sourceAttachmentsTableFields = {\\\\\\\\n  projectId: v.string(),\\\\\\\\n  processId: v.union(v.string(), v.null()),\\\\\\\\n  provider: v.literal('github'),\\\\\\\\n  displayName: v.string(),\\\\\\\\n  purpose: v.union(v.literal('research'), v.literal('review'), v.literal('implementation'), v.literal('other')),\\\\\\\\n  accessMode: v.union(v.literal('read_only'), v.literal('read_write')),\\\\\\\\n  repositoryUrl: v.string(),\\\\\\\\n  repositoryFullName: v.string(),\\\\\\\\n  targetRef: v.union(v.string(), v.null()),\\\\\\\\n  hydrationState: v.union(v.literal('not_hydrated'), v.literal('hydrated'), v.literal('stale'), v.literal('unavailable')),\\\\\\\\n  lastHydratedAt: v.union(v.string(), v.null()),\\\\\\\\n  lastHydratedResolvedRef: v.union(v.string(), v.null()),\\\\\\\\n  lastObservedRemoteResolvedRef: v.union(v.string(), v.null()),\\\\\\\\n  freshnessReason: v.union(v.string(), v.null()),\\\\\\\\n  refreshStatus: v.union(v.literal('idle'), v.literal('pending'), v.literal('failed')),\\\\\\\\n  refreshRequestedAt: v.union(v.string(), v.null()),\\\\\\\\n  detachedAt: v.union(v.string(), v.null()),\\\\\\\\n  detachedByUserId: v.union(v.string(), v.null()),\\\\\\\\n  updatedAt: v.string(),\\\\\\\\n};\\\\\\\\n```\\\\\\\\n\\\\\\\\nIndexes:\\\\\\\\n\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/02-manage-purpose-access-mode-and-target-ref/streams/005-verify.stdout.log:17:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_7\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"rg --files docs/onboarding docs | rg 'current-state-(index|tech-design|code-map)|source|materials|project'\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"rg: docs/onboarding: No such file or directory (os error 2)\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/tech-design-client.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/test-plan.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/tech-design-server.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/epic.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/coherence-review.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/05-return-and-recovery-visibility.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/04-process-registration-in-a-project.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/coverage.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/03-project-shell-summaries.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/00-foundation.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/01-authenticated-project-entry.md\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/01-authenticated-project-entry.pdf\\\\\\\\ndocs/spec-build/v2/epics/01--project-and-process-shell/stories/02-project-creation-an