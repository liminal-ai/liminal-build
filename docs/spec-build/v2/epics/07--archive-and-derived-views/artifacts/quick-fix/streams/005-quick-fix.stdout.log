ror(response, 'package-review'));\\\\ntests/service/client/review-workspace-page.test.ts:6:import { renderReviewWorkspacePage } from '../../../apps/platform/client/features/review/review-workspace-page.js';\\\\ntests/service/client/review-workspace-page.test.ts:13:} from '../../fixtures/review-workspace.js';\\\\ntests/service/client/review-workspace-page.test.ts:27:      pathname: '/projects/project-review-001/processes/process-review-001/review',\\\\ntests/service/client/review-workspace-page.test.ts:31:    reviewWorkspace: {\\\\ntests/service/client/review-workspace-page.test.ts:85:describe('review workspace page', () => {\\\\ntests/service/client/review-workspace-page.test.ts:89:    expect(dom.window.document.querySelector('[data-review-workspace=\\\\\\\"true\\\\\\\"]')).not.toBeNull();\\\\ntests/service/client/review-workspace-page.test.ts:104:      reviewWorkspace: {\\\\ntests/service/client/review-workspace-page.test.ts:126:    expect(dom.window.document.body.textContent).toContain('Select a review target');\\\\ntests/service/client/review-workspace-page.test.ts:148:  it('TC-1.3b identifies package review targets on first render', () => {\\\\ntests/service/client/review-workspace-page.test.ts:150:      reviewWorkspace: {\\\\ntests/service/client/review-workspace-page.test.ts:171:    expect(dom.window.document.body.textContent).toContain('Package review');\\\\ntests/service/client/review-workspace-page.test.ts:185:      throw new Error('Expected the review workspace to render a back-to-process link.');\\\\ntests/service/client/review-workspace-page.test.ts:196:  it('TC-1.1e renders the empty target state when no reviewable targets exist', () => {\\\\ntests/service/client/review-workspace-page.test.ts:198:      reviewWorkspace: {\\\\ntests/service/client/review-workspace-page.test.ts:217:      'No review targets are available for this process yet.',\\\\ntests/service/client/review-workspace-page.test.ts:221:  it('TC-6.2a renders an unavailable review target with