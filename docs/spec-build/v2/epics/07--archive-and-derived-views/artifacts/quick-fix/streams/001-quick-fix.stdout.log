('processes'),\n  },\n  handler: async (ctx, args) => {\n    const createdAt = new Date().toISOString();\n    return await ctx.db.insert('artifactVersions', {\n      ...args,\n      createdAt,\n    });\n  },\n});\n```\n\n","exit_code":0,"status":"completed"}}
