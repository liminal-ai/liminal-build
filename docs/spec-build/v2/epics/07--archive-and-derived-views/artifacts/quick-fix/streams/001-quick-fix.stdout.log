s are never exposed in response bodies, logs, or error payloads.\n./apps/platform/server/services/review/artifact-review.service.ts:3:  ArtifactVersionDetail,\n./apps/platform/server/services/review/artifact-review.service.ts:10:import type { ArtifactVersionRecord, PlatformStore } from '../projects/platform-store.js';\n./apps/platform/server/services/review/artifact-review.service.ts:19:function buildArtifactVersionNotFoundError(args: {\n./apps/platform/server/services/review/artifact-review.service.ts:140:      this.platformStore.listArtifactVersions({\n./apps/platform/server/services/review/artifact-review.service.ts:175:      throw buildArtifactVersionNotFoundError({\n./apps/platform/server/services/review/artifact-review.service.ts:201:          : await this.buildArtifactVersionDetail(\n./apps/platform/server/services/review/artifact-review.service.ts:245:  private async buildArtifactVersionDetail(\n./apps/platform/server/services/review/artifact-review.service.ts:246:    version: ArtifactVersionRecord,\n./apps/platform/server/services/review/artifact-review.service.ts:248:  ): Promise<ArtifactVersionDetail> {\n./apps/platform/server/services/review/artifact-review.service.ts:260:    const contentUrl = await this.platformStore.getArtifactVersionContentUrl({\n./apps/platform/server/services/review/artifact-review.service.ts:265:      return this.buildArtifactVersionError(\n./apps/platform/server/services/review/artifact-review.service.ts:281:        return this.buildArtifactVersionError(\n./apps/platform/server/services/review/artifact-review.service.ts:295:        return this.buildArtifactVersionError(\n./apps/platform/server/services/review/artifact-review.service.ts:303:      return this.buildArtifactVersionError(\n./apps/platform/server/services/review/artifact-review.service.ts:337:  private buildArtifactVersionError(\n./apps/platform/server/services/review/artifact-review.service.ts:338:    version: ArtifactVersionRecord,\n./apps/platform/server/services/re