    83\\\\t  sourceAttachments: Awaited<ReturnType<PlatformStore['listProjectSourceAttachments']>>;\\\\n    84\\\\t  currentMaterialRefs: CurrentProcessMaterialRefs;\\\\n    85\\\\t  processId: string;\\\\n    86\\\\t}): ProcessSourceReference[] {\\\\n    87\\\\t  return resolveActiveProcessSourceAttachments({\\\\n    88\\\\t    sourceAttachments: args.sourceAttachments,\\\\n    89\\\\t    processId: args.processId,\\\\n    90\\\\t    currentSourceAttachmentIds: args.currentMaterialRefs.sourceAttachmentIds,\\\\n    91\\\\t  }).map((sourceAttachment) => ({\\\\n    92\\\\t    sourceAttachmentId: sourceAttachment.sourceAttachmentId,\\\\n    93\\\\t    displayName: sourceAttachment.displayName,\\\\n    94\\\\t    purpose: sourceAttachment.purpose,\\\\n    95\\\\t    accessMode: sourceAttachment.accessMode,\\\\n    96\\\\t    repositoryUrl: sourceAttachment.repositoryUrl,\\\\n    97\\\\t    repositoryFullName: sourceAttachment.repositoryFullName,\\\\n    98\\\\t    attachmentScope: sourceAttachment.attachmentScope,\\\\n    99\\\\t    targetRef: sourceAttachment.targetRef,\\\\n   100\\\\t    hydrationState: sourceAttachment.hydrationState,\\\\n   101\\\\t    ...(sourceAttachment.lastHydratedAt === null\\\\n   102\\\\t      ? {}\\\\n   103\\\\t      : { lastHydratedAt: sourceAttachment.lastHydratedAt }),\\\\n   104\\\\t    ...(sourceAttachment.freshnessReason === null\\\\n   105\\\\t      ? {}\\\\n   106\\\\t      : { freshnessReason: sourceAttachment.freshnessReason }),\\\\n   107\\\\t    ...(sourceAttachment.refreshStatus === undefined || sourceAttachment.refreshStatus === 'idle'\\\\n   108\\\\t      ? {}\\\\n   109\\\\t      : { refreshStatus: sourceAttachment.refreshStatus }),\\\\n   110\\\\t    ...(sourceAttachment.refreshRequestedAt === null ||\\\\n   111\\\\t    sourceAttachment.refreshRequestedAt === undefined\\\\n   112\\\\t      ? {}\\\\n   113\\\\t      : { refreshRequestedAt: sourceAttachment.refreshRequestedAt }),\\\\n   114\\\\t    updatedAt: sourceAttachment.updatedAt,\\\\n   115\\\\t  }));\\\\n   116\\\\t}\\\\n   117\\\\t\\\\n   118\\\\texport class MaterialsSectionReader {\\\\n   119\\\\t  constructor(\\\\n   120\\\\t    private readonly platformStore: PlatformStore,\\\\n    20\\\\t    void args.actor;\\\\n    21\\\\t    const [sourceAttachments, projectProcesses] = await Promise.all([\\\\n    22\\\\t      this.platformStore.listProjectSourceAttachments({\\\\n    23\\\\t        projectId: args.projectId,\\\\n    24\\\\t      }),\\\\n    25\\\\t      this.platformStore.listProjectProcesses({\\\\n    26\\\\t        projectId: args.projectId,\\\\n    27\\\\t      }),\\\\n    28\\\\t    ]);\\\\n    29\\\\t    const synchronizedSourceAttachments =\\\\n    30\\\\t      this.sourceRefreshService === undefined\\\\n    31\\\\t        ? sourceAttachments\\\\n    32\\\\t        : await this.sourceRefreshService.synchronizeProjectSourceAttachments({\\\\n    33\\\\t            projectId: args.projectId,\\\\n    34\\\\t            sourceAttachments,\\\\n    35\\\\t          });\\\\n    36\\\\t    const refreshTargetCountsBySourceAttachmentId = new Map<string, number>();\\\\n    37\\\\t\\\\n    38\\\\t    for (const process of projectProcesses) {\\\\n    39\\\\t      const materialRefs = await this.platformStore.getCurrentProcessMaterialRefs({\\\\n    40\\\\t        processId: process.processId,\\\\n    41\\\\t      });\\\\n    42\\\\t\\\\n    43\\\\t      for (const sourceAttachmentId of materialRefs.sourceAttachmentIds) {\\\\n    44\\\\t        refreshTargetCountsBySourceAttachmentId.set(\\\\n    45\\\\t          sourceAttachmentId,\\\\n    46\\\\t          (refreshTargetCountsBySourceAttachmentId.get(sourceAttachmentId) ?? 0) + 1,\\\\n    47\\\\t        );\\\\n    48\\\\t      }\\\\n    49\\\\t    }\\\\n    50\\\\t\\\\n    51\\\\t    const items = [...synchronizedSourceAttachments]\\\\n    52\\\\t      .filter((sourceAttachment) => sourceAttachment.detachedAt == null)\\\\n    53\\\\t      .sort((left, right) => right.updatedAt.localeCompare(left.updatedAt))\\\\n    54\\\\t      .map((sourceAttachment) =>\\\\n    55\\\\t        buildSourceAttachmentSummary({\\\\n    56\\\\t          ...sourceAttachment,\\\\n    57\\\\t          ...(sourceAttachment.attachmentScope === 'project'\\\\n    58\\\\t            ? {\\\\n    59\\\\t                projectRefreshTargetCount:\\\\n    60\\\\t                  refreshTargetCountsBySourceAttachmentId.get(\\\\n    61\\\\t                    sourceAttachment.sourceAttachmentId,\\\\n    62\\\\t                  ) ?? 0,\\\\n    63\\\\t              }\\\\n    64\\\\t            : {}),\\\\n    65\\\\t        }),\\\\n   180\\\\t  displayName: z.string().min(1),\\\\n   181\\\\t  currentVersionLabel: z.string().min(1).nullable(),\\\\n   182\\\\t  updatedAt: z.string().min(1),\\\\n   183\\\\t});\\\\n   184\\\\texport type ArtifactSummary = z.infer<typeof artifactSummarySchema>;\\\\n   185\\\\t\\\\n   186\\\\texport const sourceAttachmentSummarySchema = z.object({\\\\n   187\\\\t  sourceAttachmentId: z.string().min(1),\\\\n   188\\\\t  provider: sourceProviderSchema,\\\\n   189\\\\t  displayName: z.string().min(1),\\\\n   190\\\\t  purpose: sourcePurposeSchema,\\\\n   191\\\\t  accessMode: sourceAccessModeSchema,\\\\n   192\\\\t  // Canonical clone URL for the source. `LocalProviderAdapter` uses this for\\\\n   193\\\\t  // `git clone` at hydration, and `OctokitCodeCheckpointWriter` parses it to\\\\n   194\\\\t  // resolve the GitHub `owner/repo` coordinates for direct writes back to the\\\\n   195\\\\t  // attached writable target ref.\\\\n   196\\\\t  repositoryUrl: z.string().min(1),\\\\n   197\\\\t  repositoryFullName: z.string().min(1),\\\\n   198\\\\t  targetRef: z.string().min(1).nullable(),\\\\n   199\\\\t  hydrationState: hydrationStateSchema,\\\\n   200\\\\t  lastHydratedAt: z.string().min(1).nullable(),\\\\n   201\\\\t  lastHydratedResolvedRef: z.string().min(1).nullable(),\\\\n   202\\\\t  lastObservedRemoteResolvedRef: z.string().min(1).nullable(),\\\\n   203\\\\t  freshnessReason: z.string().min(1).nullable(),\\\\n   204\\\\t  refreshStatus: sourceAttachmentRefreshStateSchema.optional(),\\\\n   205\\\\t  refreshRequestedAt: z.string().min(1).nullable().optional(),\\\\n   206\\\\t  attachmentScope: attachmentScopeSchema,\\\\n   207\\\\t  processId: z.string().min(1).nullable(),\\\\n   208\\\\t  processDisplayLabel: z.string().min(1).nullable(),\\\\n   209\\\\t  projectRefreshTargetCount: z.number().int().nonnegative().optional(),\\\\n   210\\\\t  detachedAt: z.string().min(1).nullable().optional(),\\\\n   320\\\\texport const processSourceReferenceSchema = z.object({\\\\n   321\\\\t  sourceAttachmentId: z.string().min(1),\\\\n   322\\\\t  displayName: z.string().min(1),\\\\n   323\\\\t  purpose: sourcePurposeSchema,\\\\n   324\\\\t  accessMode: sourceAccessModeSchema,\\\\n   325\\\\t  // Canonical clone URL for the source. Mirrored from the durable\\\\n   326\\\\t  // `sourceAttachments` row so the process surface and the orchestrator's\\\\n   327\\\\t  // checkpoint stage both see the same address the writer will push to.\\\\n   328\\\\t  repositoryUrl: z.string().min(1),\\\\n   329\\\\t  repositoryFullName: z.string().min(1),\\\\n   330\\\\t  attachmentScope: attachmentScopeSchema,\\\\n   331\\\\t  targetRef: z.string().min(1).nullable(),\\\\n   332\\\\t  hydrationState: hydrationStateSchema,\\\\n   333\\\\t  lastHydratedAt: z.string().min(1).nullable().optional(),\\\\n   334\\\\t  freshnessReason: z.string().min(1).nullable().optional(),\\\\n   335\\\\t  refreshStatus: sourceAttachmentRefreshStateSchema.optional(),\\\\n   336\\\\t  refreshRequestedAt: z.string().min(1).nullable().optional(),\\\\n   337\\\\t  updatedAt: z.string().min(1),\\\\n   338\\\\t});\\\\n   339\\\\texport type ProcessSourceReference = z.infer<typeof processSourceReferenceSchema>;\\\\n   340\\\\t\\\\n   341\\\\texport const processMaterialsSectionEnvelopeSchema = z\\\\n   342\\\\t  .object({\\\\n   343\\\\t    status: sectionStatusSchema,\\\\n   344\\\\t    currentArtifacts: z.array(processArtifactReferenceSchema),\\\\n   345\\\\t    currentOutputs: z.array(processOutputReferenceSchema),\\\\n   143\\\\t  it('TC-6.2a unavailable source shown safely', () => {\\\\n   144\\\\t    const projectView = renderSourceAttachmentSection({\\\\n   145\\\\t      envelope: sourceAttachmentSectionEnvelopeSchema.parse({\\\\n   146\\\\t        status: 'ready',\\\\n   147\\\\t        items: [unavailableSourceFixture],\\\\n   148\\\\t      }),\\\\n   149\\\\t      targetDocument: document,\\\\n   150\\\\t      onRefreshSource: async () => undefined,\\\\n   151\\\\t    });\\\\n   152\\\\t    const processView = renderProcessMaterialsSection({\\\\n   153\\\\t      envelope: processMaterialsSectionEnvelopeSchema.parse({\\\\n   154\\\\t        status: 'ready',\\\\n   155\\\\t        currentArtifacts: [],\\\\n   156\\\\t        currentOutputs: [],\\\\n   157\\\\t        currentSources: [\\\\n   158\\\\t          buildProcessSourceReference(unavailableSourceFixture, { attachmentScope: 'process' }),\\\\n   159\\\\t        ],\\\\n   160\\\\t      }),\\\\n   161\\\\t      targetDocument: document,\\\\n   162\\\\t      onRefreshSource: async () => undefined,\\\\n   163\\\\t    });\\\\n   164\\\\t\\\\n   165\\\\t    expect(projectView.textContent).toContain('Hydration: unavailable');\\\\n   166\\\\t    expect(projectView.textContent).toContain(\\\\n   167\\\\t      'Source unavailable right now. Reload later or restore access to inspect current details.',\\\\n   168\\\\t    );\\\\n   169\\\\t    expect(projectView.textContent).not.toContain(\\\\n   170\\\\t      `Last hydrated: ${unavailableSourceFixture.lastHydratedAt}`,\\\\n   171\\\\t    );\\\\n   172\\\\t    expect(projectView.textContent).not.toContain('Freshness reason:');\\\\n   173\\\\t\\\\n   174\\\\t    expect(processView.textContent).toContain('Hydration: unavailable');\\\\n   175\\\\t    expect(processView.textContent).toContain(\\\\n   176\\\\t      'Availability: Source unavailable right now. Reload later or restore access to inspect current details.',\\\\n   177\\\\t    );\\\\n   178\\\\t    expect(processView.textContent).not.toContain(\\\\n   179\\\\t      `Last hydrated: ${unavailableSourceFixture.lastHydratedAt}`,\\\\n   180\\\\t    );\\\\n   181\\\\t    expect(processView.textContent).not.toContain('Freshness reason:');\\\\n   182\\\\t  });\\\\n   183\\\\t\\\\n   184\\\\t  it('TC-3.3b shows refresh progress while pending without introducing a fifth hydration state', () => {\\\\n   185\\\\t    const view = renderSourceAttachmentSection({\\\\n   334\\\\t  it('TC-6.3a one failing source does not hide healthy sources', async () => {\\\\n   335\\\\t    const healthySource = buildSourceAttachmentSummaryFixture({\\\\n   336\\\\t      sourceAttachmentId: 'source-project-healthy-001',\\\\n   337\\\\t      displayName: 'healthy source',\\\\n   338\\\\t      repositoryUrl: 'https://github.com/liminal-ai/healthy-source',\\\\n   339\\\\t      repositoryFullName: 'liminal-ai/healthy-source',\\\\n   340\\\\t      updatedAt: '2026-05-03T12:10:00.000Z',\\\\n   341\\\\t    });\\\\n   342\\\\t    const failingSource = buildSourceAttachmentSummaryFixture({\\\\n   343\\\\t      sourceAttachmentId: 'source-project-failing-001',\\\\n   344\\\\t      displayName: 'failing source',\\\\n   345\\\\t      repositoryUrl: 'https://github.com/liminal-ai/failing-source',\\\\n   346\\\\t      repositoryFullName: 'liminal-ai/failing-source',\\\\n   347\\\\t      updatedAt: '2026-05-03T12:05:00.000Z',\\\\n   348\\\\t    });\\\\n   349\\\\t    const platformStore = new InMemoryPlatformStore({\\\\n   350\\\\t      accessibleProjectsByUserId: {\\\\n   351\\\\t        'user:workos-user-1': [ownerProjectSummary],\\\\n   352\\\\t      },\\\\n   353\\\\t      projectAccessByProjectId: {\\\\n   354\\\\t        [ownerProjectSummary.projectId]: {\\\\n   355\\\\t          kind: 'accessible',\\\\n   356\\\\t          project: ownerProjectSummary,\\\\n   357\\\\t        },\\\\n   358\\\\t      },\\\\n   359\\\\t      sourceAttachmentsByProjectId: {\\\\n   360\\\\t        [ownerProjectSummary.projectId]: [healthySource, failingSource],\\\\n   361\\\\t      },\\\\n   362\\\\t    });\\\\n   363\\\\t    const sourceRefreshService = new DefaultSourceRefreshService(\\\\n   364\\\\t      platformStore,\\\\n   365\\\\t      new StubGitHubRepositoryResolver(({ repositoryUrl, targetRef }) => {\\\\n   366\\\\t        if (repositoryUrl === failingSource.repositoryUrl) {\\\\n   367\\\\t          throw new Error('GitHub source lookup failed for one attachment.');\\\\n   368\\\\t        }\\\\n   369\\\\t\\\\n   370\\\\t        return {\\\\n   371\\\\t          kind: 'resolved',\\\\n   372\\\\t          repositoryUrl,\\\\n   373\\\\t          repositoryFullName: healthySource.repositoryFullName,\\\\n   374\\\\t          targetRef,\\\\n   375\\\\t          targetRefKind: targetRef === null ? 'none' : 'branch',\\\\n   376\\\\t          defaultBranch: 'main',\\\\n   377\\\\t          resolvedRef: targetRef === null ? null : 'a'.repeat(40),\\\\n   378\\\\t        };\\\\n   379\\\\t      }),\\\\n   380\\\\t      noOpHydrationExecutor,\\\\n   381\\\\t    );\\\\n   382\\\\t    const app = await buildApp({\\\\n   383\\\\t      authSessionService: createTestAuthSessionService({\\\\n   384\\\\t        actor: {\\\\n   385\\\\t          userId: 'workos-user-1',\\\\n   386\\\\t          workosUserId: 'workos-user-1',\\\\n   387\\\\t          email: 'lee@example.com',\\\\n   388\\\\t          displayName: 'Lee Moore',\\\\n   389\\\\t        },\\\\n   390\\\\t        reason: null,\\\\n   391\\\\t      }),\\\\n   392\\\\t      authUserSyncService: new AuthUserSyncService(platformStore),\\\\n   393\\\\t      platformStore,\\\\n   394\\\\t      sourceRefreshService,\\\\n   395\\\\t    });\\\\n   396\\\\t\\\\n   397\\\\t    const response = await app.inject({\\\\n   398\\\\t      method: 'GET',\\\\n   399\\\\t      url: `/api/projects/${ownerProjectSummary.projectId}`,\\\\n   400\\\\t      cookies: {\\\\n   401\\\\t        [sessionCookieName]: 'valid-session-cookie',\\\\n   402\\\\t      },\\\\n   403\\\\t    });\\\\n   404\\\\t\\\\n   405\\\\t    expect(response.statusCode).toBe(200);\\\\n   406\\\\t    expect(response.json()).toMatchObject({\\\\n   407\\\\t      sourceAttachments: {\\\\n   408\\\\t        status: 'ready',\\\\n   409\\\\t        items: expect.arrayContaining([\\\\n   410\\\\t          expect.objectContaining({\\\\n   411\\\\t            sourceAttachmentId: healthySource.sourceAttachmentId,\\\\n   412\\\\t            hydrationState: 'hydrated',\\\\n   413\\\\t          }),\\\\n   414\\\\t          expect.objectContaining({\\\\n   415\\\\t            sourceAttachmentId: failingSource.sourceAttachmentId,\\\\n   416\\\\t            hydrationState: 'unavailable',\\\\n   417\\\\t            freshnessReason: 'target_ref_unavailable',\\\\n   418\\\\t          }),\\\\n   419\\\\t        ]),\\\\n   420\\\\t      },\\\\n   421\\\\t    });\\\\n   422\\\\t    expect(response.json().sourceAttachments.items).toHaveLength(2);\\\\n   423\\\\t\\\\n   424\\\\t    await app.close();\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/06-reopen-and-degraded-source-state/streams/004-verify.stdout.log:97:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_47\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"{\\\\\\\"artifactsRead\\\\\\\":[\\\\\\\"convex/_generated/ai/guidelines.md\\\\\\\",\\\\\\\"docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/stories/06-reopen-and-degraded-source-state.md\\\\\\\",\\\\\\\"docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/tech-design.md\\\\\\\",\\\\\\\"docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/test-plan.md\\\\\\\",\\\\\\\"apps/platform/server/services/sources/source-refresh.service.ts\\\\\\\",\\\\\\\"apps/platform/server/services/projects/readers/source-section.reader.ts\\\\\\\",\\\\\\\"apps/platform/server/services/processes/readers/materials-section.reader.ts\\\\\\\",\\\\\\\"apps/platform/server/services/processes/active-process-sources.ts\\\\\\\",\\\\\\\"apps/platform/shared/contracts/schemas.ts\\\\\\\",\\\\\\\"apps/platform/shared/contracts/process-work-surface.ts\\\\\\\",\\\\\\\"apps/platform/client/features/projects/source-attachment-section.ts\\\\\\\",\\\\\\\"apps/platform/client/features/processes/process-materials-section.ts\\\\\\\",\\\\\\\"apps/platform/server/routes/source-management.ts\\\\\\\",\\\\\\\"apps/platform/server/services/sources/source-management.service.ts\\\\\\\",\\\\\\\"tests/service/server/projects-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/process-work-surface-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/source-management-api.test.ts\\\\\\\",\\\\\\\"tests/service/client/source-management-ui.test.ts\\\\\\\"],\\\\\\\"reviewScopeSummary\\\\\\\":\\\\\\\"Reviewed Story 6 against the story, tech design, and test plan, then traced the real project-shell and process work-surface read paths, unavailable-source synchronization, and mapped story tests. Verified focused story tests plus both configured gates (`green-verify`, `verify-all`).\\\\\\\",\\\\\\\"priorFindingStatuses\\\\\\\":[],\\\\\\\"newFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"SV-06-01\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"major\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Unavailable source reads still serialize stale hydration metadata\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"`buildUnavailableSourceAttachment` only flips availability-related fields and leaves prior hydration metadata on the summary (`apps/platform/server/services/sources/source-refresh.service.ts`). The project-shell reader forwards that summary unchanged (`apps/platform/server/services/projects/readers/source-section.reader.ts`), and the process materials reader still emits `lastHydratedAt` / `freshnessReason` whenever present (`apps/platform/server/services/processes/readers/materials-section.reader.ts`). The shared project contract also requires `lastHydratedResolvedRef` and `lastObservedRemoteResolvedRef` on every source row (`apps/platform/shared/contracts/schemas.ts`), so unavailable rows returned from real GET surfaces can still expose prior hydration details. The only new TC-6.2a proof is a synthetic UI-envelope test (`tests/service/client/source-management-ui.test.ts`), which means the route/read path required by the story’s anti-shim rule is not actually proving redaction.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"apps/platform/server/services/sources/source-refresh.service.ts\\\\\\\",\\\\\\\"apps/platform/server/services/projects/readers/source-section.reader.ts\\\\\\\",\\\\\\\"apps/platform/server/services/processes/readers/materials-section.reader.ts\\\\\\\",\\\\\\\"apps/platform/shared/contracts/schemas.ts\\\\\\\",\\\\\\\"apps/platform/shared/contracts/process-work-surface.ts\\\\\\\",\\\\\\\"tests/service/client/source-management-ui.test.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-6.2\\\\\\\",\\\\\\\"TC-6.2a\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"same-session-implementor\\\\\\\",\\\\\\\"blocking\\\\\\\":true}],\\\\\\\"openFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"SV-06-01\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"major\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Unavailable source reads still serialize stale hydration metadata\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"`buildUnavailableSourceAttachment` only flips availability-related fields and leaves prior hydration metadata on the summary (`apps/platform/server/services/sources/source-refresh.service.ts`). The project-shell reader forwards that summary unchanged (`apps/platform/server/services/projects/readers/source-section.reader.ts`), and the process materials reader still emits `lastHydratedAt` / `freshnessReason` whenever present (`apps/platform/server/services/processes/readers/materials-section.reader.ts`). The shared project contract also requires `lastHydratedResolvedRef` and `lastObservedRemoteResolvedRef` on every source row (`apps/platform/shared/contracts/schemas.ts`), so unavailable rows returned from real GET surfaces can still expose prior hydration details. The only new TC-6.2a proof is a synthetic UI-envelope test (`tests/service/client/source-management-ui.test.ts`), which means the route/read path required by the story’s anti-shim rule is not actually proving redaction.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"apps/platform/server/services/sources/source-refresh.service.ts\\\\\\\",\\\\\\\"apps/platform/server/services/projects/readers/source-section.reader.ts\\\\\\\",\\\\\\\"apps/platform/server/services/processes/readers/materials-section.reader.ts\\\\\\\",\\\\\\\"apps/platform/shared/contracts/schemas.ts\\\\\\\",\\\\\\\"apps/platform/shared/contracts/process-work-surface.ts\\\\\\\",\\\\\\\"tests/service/client/source-management-ui.test.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-6.2\\\\\\\",\\\\\\\"TC-6.2a\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"same-session-implementor\\\\\\\",\\\\\\\"blocking\\\\\\\":true}],\\\\\\\"requirementCoverage\\\\\\\":{\\\\\\\"verified\\\\\\\":[\\\\\\\"AC-6.1\\\\\\\",\\\\\\\"TC-6.1a\\\\\\\",\\\\\\\"TC-6.1b\\\\\\\",\\\\\\\"TC-6.2b\\\\\\\",\\\\\\\"AC-6.3\\\\\\\",\\\\\\\"TC-6.3a\\\\\\\"],\\\\\\\"unverified\\\\\\\":[\\\\\\\"AC-6.2\\\\\\\",\\\\\\\"TC-6.2a\\\\\\\"]},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run green-verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run verify-all\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"}],\\\\\\\"productionPathFindings\\\\\\\":[\\\\\\\"Real project/process read APIs still rely on client-side hiding for unavailable-source redaction; the runtime payloads can carry prior hydration metadata for degraded rows.\\\\\\\"],\\\\\\\"recommendedNextStep\\\\\\\":\\\\\\\"revise\\\\\\\",\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"same-session-implementor\\\\\\\",\\\\\\\"openQuestions\\\\\\\":[],\\\\\\\"additionalObservations\\\\\\\":[\\\\\\\"Focused story tests also passed: `corepack pnpm vitest run tests/service/server/projects-api.test.ts tests/service/server/process-work-surface-api.test.ts tests/service/server/source-management-api.test.ts tests/service/client/source-management-ui.test.ts`.\\\\\\\",\\\\\\\"`docs/onboarding/current-state-index.md`, `current-state-tech-design.md`, and `current-state-code-map.md` referenced by `AGENTS.md` were not present in this checkout, so this review used the story/spec docs directly.\\\\\\\"]}\\\"}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
