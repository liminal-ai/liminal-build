ailability',\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          value:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+            'Source unavailable right now. Reload later or restore access to inspect current details.',\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          targetDocument: args.targetDocument,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+        });\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+      } else {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+        appendDetail({\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          item,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          label: 'Last hydrated',\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          value: source.lastHydratedAt ?? 'never',\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          targetDocument: args.targetDocument,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+        });\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+        appendDetail({\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          item,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          label: 'Freshness reason',\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          value: source.freshnessReason?.replaceAll('_', ' ') ?? 'none',\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+          targetDocument: args.targetDocument,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+        });\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+      }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n       appendDetail({\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n         item,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ndiff --git a/apps/platform/client/features/projects/source-attachment-section.ts b/apps/platform/client/features/projects/source-attachment-section.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nindex d91600c..8e37ca2 100644\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n--- a/apps/platform/client/features/projects/source-attachment-section.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+++ b/apps/platform/client/features/projects/source-attachment-section.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n@@ -63,6 +63,10 @@ function resolveRefreshLabel(sourceAttachment: SourceAttachmentSummary): string\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   return null;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+function isUnavailableSourceAttachment(sourceAttachment: SourceAttachmentSummary): boolean {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+  return sourceAttachment.hydrationState === 'unavailable';\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n export function renderSourceAttachmentSection(args: {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   envelope: SourceAttachmentSectionEnvelope | null;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   targetDocument: Document;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n@@ -135,6 +139,7 @@ export function renderSourceAttachmentSection(args: {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     const hydration = args.targetDocument.createElement('p');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     const lastHydratedAt = args.targetDocument.createElement('p');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     const freshnessReason = args.targetDocument.createElement('p');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+    const availability = args.targetDocument.createElement('p');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     const scope = args.targetDocument.createElement('p');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     const updatedAt = args.targetDocument.createElement('p');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     item.setAttribute('data-source-attachment-row', sourceAttachment.sourceAttachmentId);\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n@@ -147,6 +152,12 @@ export function renderSourceAttachmentSection(args: {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     hydration.textContent = `Hydration: ${formatHydrationStateLabel(sourceAttachment.hydrationState)}`;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     lastHydratedAt.textContent = `Last hydrated: ${sourceAttachment.lastHydratedAt ?? 'never'}`;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n     freshnessReason.textContent = `Freshness reason: ${formatFreshnessReason(sourceAttachment.freshnessReason) ?? 'none'}`;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+    availability.textContent =\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n+ 