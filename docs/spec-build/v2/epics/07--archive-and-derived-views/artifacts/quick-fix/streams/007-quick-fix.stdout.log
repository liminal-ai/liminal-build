iew access.\\\",\\\"changedFiles\\\":[{\\\"path\\\":\\\"apps/platform/server/services/processes/readers/materials-section.reader.ts\\\",\\\"reason\\\":\\\"Derive process artifact role labels from artifact version provenance instead of legacy artifact ownership fields.\\\"},{\\\"path\\\":\\\"apps/platform/server/services/projects/platform-store.ts\\\",\\\"reason\\\":\\\"Union current refs with produced artifacts when building review targets so cross-process references work without regressing existing review/package flows.\\\"},{\\\"path\\\":\\\"apps/platform/server/services/review/artifact-review.service.ts\\\",\\\"reason\\\":\\\"Allow artifact review when the process currently references the artifact, while preserving existing produced-artifact review access.\\\"},{\\\"path\\\":\\\"tests/service/server/project-shell-bootstrap-api.test.ts\\\",\\\"reason\\\":\\\"Added coverage that project-shell artifact summaries strip legacy process ownership fields from API output.\\\"},{\\\"path\\\":\\\"tests/service/server/process-work-surface-api.test.ts\\\",\\\"reason\\\":\\\"Added coverage for referenced-artifact materials labeling and review availability from current refs.\\\"},{\\\"path\\\":\\\"tests/service/server/artifact-review-api.test.ts\\\",\\\"reason\\\":\\\"Added coverage for reviewing an artifact referenced by a later process but produced by an earlier one.\\\"}],\\\"tests\\\":{\\\"added\\\":[],\\\"modified\\\":[\\\"tests/service/server/project-shell-bootstrap-api.test.ts\\\",\\\"tests/service/server/process-work-surface-api.test.ts\\\",\\\"tests/service/server/artifact-review-api.test.ts\\\"],\\\"removed\\\":[],\\\"totalAfterStory\\\":556,\\\"deltaFromPriorBaseline\\\":3},\\\"gatesRun\\\":[{\\\"command\\\":\\\"corepack pnpm exec vitest run tests/service/server/project-shell-bootstrap-api.test.ts tests/service/server/process-work-surface-api.test.ts tests/service/server/artifact-review-api.test.ts tests/service/client/artifact-section.test.ts --environment node\\\",