ync getArchive(args: {\n    44\t    actor: AuthenticatedActor;\n    45\t    projectId: string;\n    46\t    processId: string;\n    47\t    cursor?: string | null;\n    48\t    limit?: number;\n    49\t  }): Promise<ArchivePage> {\n    50\t    await this.processAccessService.assertProcessAccess({\n    51\t      actor: args.actor,\n    52\t      projectId: args.projectId,\n    53\t      processId: args.processId,\n    54\t    });\n    55\t\n    56\t    const cursor = normalizeArchiveCursor(args.cursor);\n    57\t    const limit = normalizeArchiveLimit(args.limit);\n    58\t    const page = await this.platformStore.listArchiveEntries({\n    59\t      processId: args.processId,\n    60\t      cursor,\n    61\t      limit,\n    62\t    });\n    63\t    const entries = await enrichArchiveEntries({\n    64\t      entries: page.entries,\n    65\t      platformStore: this.platformStore,\n    66\t      processId: args.processId,\n    67\t    });\n    68\t\n    69\t    return archivePageSchema.parse({\n    70\t      ...page,\n    71\t      entries,\n    72\t    });\n    73\t  }\n    74\t}\n    75\t\n    76\tasync function enrichArchiveEntries(args: {\n    77\t  entries: ArchiveEntry[];\n    78\t  platformStore: Pick<PlatformStore, 'getArtifactVersion'> & {\n    79\t    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n    80\t    listProcessSourceProvenance?: PlatformStore['listProcessSourceProvenance'];\n    81\t  };\n    82\t  processId: string;\n    83\t}): Promise<ArchiveEntry[]> {\n    84\t  const artifactVersionIds = Array.from(\n    85\t    new Set(\n    86\t      args.entries\n    87\t        .map((entry) => entry.relatedArtifactVersionId)\n    88\t        .filter((versionId): versionId is string => versionId !== null),\n    89\t    ),\n    90\t  );\n    91\t  const sourceProvenanceIds = new Set(\n    92\t    args.entries\n    93\t      .map((entry) => entry.relatedSourceProvenanceId)\n    94\t      .filter((provenanceId): provenanceId is string => provenanceId !== null),\n    95\t  );\n    96\t  const artifactVersions = await Promise.all(\n    97\t    artifactVersionIds.map(async (versionId) => {\n    98\t      try {\n    99\t        return [versionId, await args.platformStore.getArtifactVersion({ versionId })] as const;\n   100\t      } catch {\n   101\t        return [versionId, null] as const;\n   102\t      }\n   103\t    }),\n   104\t  );\n   105\t  const artifactVersionsById = new Map<string, ArtifactVersionRecord | null>(artifactVersions);\n   106\t  const producingProcessIds = Array.from(\n   107\t    new Set(\n   108\t      artifactVersions\n   109\t        .map(([, version]) => version?.createdByProcessId ?? null)\n   110\t        .filter((processId): processId is string => processId !== null),\n   111\t    ),\n   112\t  );\n   113\t  const processes =\n   114\t    args.platformStore.listProcessesByIds === undefined || producingProcessIds.length === 0\n   115\t      ? []\n   116\t      : await loadProcessesByIds(args.platformStore, producingProcessIds);\n   117\t  const processDisplayLabelsById = new Map(\n   118\t    processes.map((processRecord) => [processRecord.processId, processRecord.displayLabel]),\n   119\t  );\n   120\t  const sourceRecords =\n   121\t    args.platformStore.listProcessSourceProvenance === undefined || sourceProvenanceIds.size === 0\n   122\t      ? []\n   123\t      : await loadSourceProvenanceRecords(args.platformStore, args.processId);\n   124\t  const sourceRecordsById = new Map(\n   125\t    sourceRecords.map((record) => [record.provenanceId, record] as const),\n   126\t  );\n   127\t\n   128\t  return args.entries.map((entry) =>\n   129\t    buildEnrichedArchiveEntry(entry, {\n   130\t      artifactVersion: resolveArtifactVersion(entry, artifactVersionsById),\n   131\t      producingProcessDisplayLabelsById: processDisplayLabelsById,\n   132\t      sourceRecord: resolveSourceRecord(entry, sourceProvenanceIds, sourceRecordsById),\n   133\t    }),\n   134\t  );\n   135\t}\n   136\t\n   137\tfunction resolveArtifactVersion(\n   138\t  entry: ArchiveEntry,\n   139\t  artifactVersionsById: Map<string, ArtifactVersionRecord | null>,\n   140\t): ArtifactVersionRecord | null {\n   141\t  if (entry.relatedArtifactVersionId === null) {\n   142\t    return null;\n   143\t  }\n   144\t\n   145\t  return artifactVersionsById.get(entry.relatedArtifactVersionId) ?? null;\n   146\t}\n   147\t\n   148\tfunction resolveSourceRecord(\n   149\t  entry: ArchiveEntry,\n   150\t  sourceProvenanceIds: Set<string>,\n   151\t  sourceRecordsById: Map<string, StoredSourceProvenanceRecord>,\n   152\t): StoredSourceProvenanceRecord | null {\n   153\t  if (\n   154\t    entry.relatedSourceProvenanceId === null ||\n   155\t    !sourceProvenanceIds.has(entry.relatedSourceProvenanceId)\n   156\t  ) {\n   157\t    return null;\n   158\t  }\n   159\t\n   160\t  return sourceRecordsById.get(entry.relatedSourceProvenanceId) ?? null;\n   161\t}\n   162\t\n   163\tfunction buildEnrichedArchiveEntry(\n   164\t  entry: ArchiveEntry,\n   165\t  args: {\n   166\t    artifactVersion: ArtifactVersionRecord | null;\n   167\t    producingProcessDisplayLabelsById: Map<string, string>;\n   168\t    sourceRecord: StoredSourceProvenanceRecord | null;\n   169\t  },\n   170\t): ArchiveEntry {\n   171\t  const degradationReasons = entry.degradationReason === null ? [] : [entry.degradationReason];\n   172\t  let relatedArtifactProvenance: ArchiveEntryArtifactProvenance | undefined;\n   173\t  let relatedSourceProvenance: ArchiveEntrySourceProvenance | undefined;\n   174\t\n   175\t  if (entry.relatedArtifactVersionId !== null) {\n   176\t    if (args.artifactVersion === null) {\n   177\t      degradationReasons.push('Related artifact version is unavailable.');\n   178\t    } else {\n   179\t      const producedByProcessDisplayLabel =\n   180\t        args.producingProcessDisplayLabelsById.get(args.artifactVersion.createdByProcessId) ?? null;\n   181\t      relatedArtifactProvenance = {\n   182\t        versionId: args.artifactVersion.versionId,\n   183\t        artifactId: args.artifactVersion.artifactId,\n   184\t        versionLabel: args.artifactVersion.versionLabel,\n   185\t        createdAt: args.artifactVersion.createdAt,\n   186\t        producedByProcessId: args.artifactVersion.createdByProcessId,\n   187\t        producedByProcessDisplayLabel,\n   188\t      };\n   189\t\n   190\t      if (producedByProcessDisplayLabel === null) {\n   191\t        degradationReasons.push(\n   192\t          'Producing process provenance is unavailable for the related artifact version.',\n   193\t        );\n   194\t      }\n   195\t    }\n   196\t  }\n   197\t\n   198\t  if (entry.relatedSourceProvenanceId !== null) {\n   199\t    if (args.sourceRecord === null) {\n   200\t      degradationReasons.push('Related source provenance is unavailable.');\n   201\t    } else {\n   202\t      relatedSourceProvenance = {\n   203\t        provenanceId: args.sourceRecord.provenanceId,\n   204\t        sourceAttachmentId: args.sourceRecord.sourceAttachmentId,\n   205\t        relationshipKind: args.sourceRecord.relationshipKind,\n   206\t        repositoryFullName: args.sourceRecord.repositoryFullName,\n   207\t        repositoryUrl: args.sourceRecord.repositoryUrl,\n   208\t        targetRef: args.sourceRecord.targetRef,\n   209\t        entryStatus: args.sourceRecord.entryStatus,\n   210\t        degradationReason: args.sourceRecord.degradationReason,\n   211\t        recordedAt: args.sourceRecord.recordedAt,\n   212\t      };\n   213\t    }\n   214\t  }\n   215\t\n   216\t  const nextDegradationReason = dedupeStrings(degradationReasons).join(' ') || null;\n   217\t\n   218\t  return {\n   219\t    ...entry,\n   220\t    ...(relatedArtifactProvenance === undefined ? {} : { relatedArtifactProvenance }),\n   221\t    ...(relatedSourceProvenance === undefined ? {} : { relatedSourceProvenance }),\n   222\t    entryStatus: nextDegradationReason === null ? 'ready' : 'degraded',\n   223\t    degradationReason: nextDegradationReason,\n   224\t  };\n   225\t}\n   226\t\n   227\tfunction dedupeStrings(values: string[]): string[] {\n   228\t  return [...new Set(values)];\n   229\t}\n   230\t\n   231\tasync function loadProcessesByIds(\n   232\t  platformStore: {\n   233\t    listProcessesByIds?: PlatformStore['listProcessesByIds'];\n   234\t  },\n   235\t  processIds: string[],\n   236\t): Promise<Array<Awaited<ReturnType<NonNullable<PlatformStore['listProcessesByIds']>>>[number]>> {\n   237\t  if (platformStore.listProcessesByIds === undefined || processIds.length === 0) {\n   238\t    return [];\n   239\t  }\n   240\t\n   241\t  try {\n   242\t    return await platformStore.listProcessesByIds({\n   243\t      processIds,\n   244\t    });\n   245\t  } catch {\n   246\t    return [];\n   247\t  }\n   248\t}\n   249\t\n   250\tasync function loadSourceProvenanceRecords(\n   251\t  platformStore: {\n   252\t    listProcessSourceProvenance?: PlatformStore['listProcessSourceProvenance'];\n   253\t  },\n   254\t  processId: string,\n   255\t): Promise<StoredSourceProvenanceRecord[]> {\n   256\t  if (platformStore.listProcessSourceProvenance === undefined) {\n   257\t    return [];\n   258\t  }\n   259\t\n   260\t  try {\n   261\t    return await platformStore.listProcessSourceProvenance({\n   262\t      processId,\n   263\t    });\n   264\t  } catch {\n   265\t    return [];\n   266\t  }\n   267\t}\n   268\t\n   269\tfunction normalizeArchiveCursor(cursor: string | null | undefined): string | null {\n   270\t  if (cursor === undefined || cursor === null) {\n   271\t    return null;\n   272\t  }\n   273\t\n   274\t  if (!/^\\d+$/.test(cursor)) {\n   275\t    throw new AppError({\n   276\t      code: invalidArchiveRequestErrorCode,\n   277\t      message: 'Archive pagination parameters were invalid.',\n   278\t      statusCode: 422,\n   279\t    });\n   280\t  }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/service/server/archive-api.test.ts | sed -n '1,560p'\"","aggregated_output":"     1\timport { describe, expect, it } from 'vitest';\n     2\timport {\n     3\t  AuthSessionService,\n     4\t  type SessionResolution,\n     5\t  sessionCookieName,\n     6\t} from '../../../apps/platform/server/services/auth/auth-session.service.js';\n     7\timport { AuthUserSyncService } from '../../../apps/platform/server/services/auth/auth-user-sync.service.js';\n     8\timport {\n     9\t  InMemoryPlatformStore,\n    10\t  type ArtifactVersionRecord,\n    11\t  type StoredSourceProvenanceRecord,\n    12\t} from '../../../apps/platform/server/services/projects/platform-store.js';\n    13\timport {\n    14\t  buildProcessArchiveApiPath,\n    15\t  buildProcessDerivedArchiveViewsRefreshApiPath,\n    16\t  processSummarySchema,\n    17\t  projectSummarySchema,\n    18\t  type DerivedArchiveView,\n    19\t} from '../../../apps/platform/shared/contracts/index.js';\n    20\timport {\n    21\t  archiveEntryWithArtifactProvenanceFixture,\n    22\t  archiveEntryWithSourceProvenanceFixture,\n    23\t  degradedArchiveEntryFixture,\n    24\t  modelArchiveEntryFixture,\n    25\t  processEventArchiveEntryFixture,\n    26\t  readyArchivePageFixture,\n    27\t  userArchiveEntryFixture,\n    28\t} from '../../fixtures/archive.js';\n    29\timport { currentArtifactVersionFixture } from '../../fixtures/artifact-versions.js';\n    30\timport { lostEnvironmentFixture } from '../../fixtures/process-environment.js';\n    31\timport { completedProcessFixture } from '../../fixtures/processes.js';\n    32\timport { readySourceProvenanceFixture } from '../../fixtures/sources.js';\n    33\timport { buildApp } from '../../utils/build-app.js';\n    34\t\n    35\tfunction createTestAuthSessionService(resolution: SessionResolution) {\n    36\t  class TestAuthSessionService extends AuthSessionService {\n    37\t    constructor() {\n    38\t      super({\n    39\t        workosClient: {} as never,\n    40\t        clientId: 'client_test_archive_api',\n    41\t        cookiePassword: 'story3-archive-api-cookie-password-12345',\n    42\t        redirectUri: 'http://localhost:5001/auth/callback',\n    43\t        loginReturnUri: 'http://localhost:5001/projects',\n    44\t      });\n    45\t    }\n    46\t\n    47\t    override async resolveSession(): Promise<SessionResolution> {\n    48\t      return resolution;\n    49\t    }\n    50\t  }\n    51\t\n    52\t  return new TestAuthSessionService();\n    53\t}\n    54\t\n    55\tconst actor = {\n    56\t  userId: 'workos-user-archive-1',\n    57\t  workosUserId: 'workos-user-archive-1',\n    58\t  email: 'lee@example.com',\n    59\t  displayName: 'Lee Moore',\n    60\t};\n    61\t\n    62\tconst projectId = userArchiveEntryFixture.projectId;\n    63\tconst processId = userArchiveEntryFixture.processId;\n    64\t\n    65\tconst projectSummary = projectSummarySchema.parse({\n    66\t  projectId,\n    67\t  name: 'Archive Story Project',\n    68\t  ownerDisplayName: 'Lee Moore',\n    69\t  role: 'owner',\n    70\t  processCount: 1,\n    71\t  artifactCount: 0,\n    72\t  sourceAttachmentCount: 0,\n    73\t  lastUpdatedAt: '2026-05-05T09:00:00.000Z',\n    74\t});\n    75\t\n    76\tconst processSummary = processSummarySchema.parse({\n    77\t  ...completedProcessFixture,\n    78\t  processId,\n    79\t  displayLabel: 'Archive replay process',\n    80\t  updatedAt: '2026-05-05T09:05:00.000Z',\n    81\t});\n    82\t\n    83\tconst artifactProducingProcessSummary = processSummarySchema.parse({\n    84\t  ...completedProcessFixture,\n    85\t  processId: currentArtifactVersionFixture.producedByProcessId,\n    86\t  displayLabel:\n    87\t    currentArtifactVersionFixture.producedByProcessDisplayLabel ?? 'Feature Specification #1',\n    88\t  updatedAt: '2026-04-22T12:00:00.000Z',\n    89\t});\n    90\t\n    91\tconst resolvedArtifactVersionRecord: ArtifactVersionRecord = {\n    92\t  versionId: currentArtifactVersionFixture.versionId,\n    93\t  artifactId: 'artifact-001',\n    94\t  versionLabel: currentArtifactVersionFixture.versionLabel,\n    95\t  contentStorageId: 'storage-001',\n    96\t  contentKind: 'markdown',\n    97\t  bytes: 128,\n    98\t  createdAt: currentArtifactVersionFixture.createdAt,\n    99\t  createdByProcessId: currentArtifactVersionFixture.producedByProcessId,\n   100\t};\n   101\t\n   102\tconst storedResolvedSourceProvenance: StoredSourceProvenanceRecord = {\n   103\t  provenanceId: 'provenance-001',\n   104\t  projectId,\n   105\t  processId,\n   106\t  sourceAttachmentId: readySourceProvenanceFixture.sourceAttachmentId,\n   107\t  relationshipKind: readySourceProvenanceFixture.relationshipKind,\n   108\t  repositoryFullName: readySourceProvenanceFixture.repositoryFullName,\n   109\t  repositoryUrl: readySourceProvenanceFixture.repositoryUrl,\n   110\t  targetRef: readySourceProvenanceFixture.targetRef,\n   111\t  eventId: null,\n   112\t  entryStatus: 'ready',\n   113\t  degradationReason: null,\n   114\t  recordedAt: readySourceProvenanceFixture.recordedAt,\n   115\t};\n   116\t\n   117\tfunction buildStoreSeed(\n   118\t  args: {\n   119\t    access?: 'accessible' | 'forbidden' | 'project_not_found';\n   120\t    includeProcess?: boolean;\n   121\t    archiveEntries?: Array<(typeof readyArchivePageFixture.entries)[number]>;\n   122\t    extraProcesses?: Array<typeof processSummary>;\n   123\t    artifactVersionsByArtifactId?: Record<string, ArtifactVersionRecord[]>;\n   124\t    sourceProvenanceByProcessId?: Record<string, StoredSourceProvenanceRecord[]>;\n   125\t    environmentLost?: boolean;\n   126\t  } = {},\n   127\t) {\n   128\t  return {\n   129\t    accessibleProjectsByUserId: {\n   130\t      [`user:${actor.workosUserId}`]: args.access === 'accessible' ? [projectSummary] : [],\n   131\t    },\n   132\t    projectAccessByProjectId: {\n   133\t      [projectId]:\n   134\t        args.access === 'forbidden'\n   135\t          ? { kind: 'forbidden' as const }\n   136\t          : args.access === 'project_not_found'\n   137\t            ? { kind: 'not_found' as const }\n   138\t            : {\n   139\t                kind: 'accessible' as const,\n   140\t                project: projectSummary,\n   141\t              },\n   142\t    },\n   143\t    processesByProjectId: {\n   144\t      [projectId]:\n   145\t        args.includeProcess === false\n   146\t          ? []\n   147\t          : [processSummary, artifactProducingProcessSummary, ...(args.extraProcesses ?? [])],\n   148\t    },\n   149\t    archiveEntriesByProcessId: {\n   150\t      [processId]: args.archiveEntries ?? readyArchivePageFixture.entries,\n   151\t    },\n   152\t    artifactVersionsByArtifactId: args.artifactVersionsByArtifactId ?? {\n   153\t      [resolvedArtifactVersionRecord.artifactId]: [resolvedArtifactVersionRecord],\n   154\t    },\n   155\t    sourceProvenanceByProcessId: args.sourceProvenanceByProcessId ?? {\n   156\t      [processId]: [storedResolvedSourceProvenance],\n   157\t    },\n   158\t    processEnvironmentSummariesByProcessId: args.environmentLost\n   159\t      ? {\n   160\t          [processId]: lostEnvironmentFixture,\n   161\t        }\n   162\t      : undefined,\n   163\t  };\n   164\t}\n   165\t\n   166\tfunction buildStore(\n   167\t  args: {\n   168\t    access?: 'accessible' | 'forbidden' | 'project_not_found';\n   169\t    includeProcess?: boolean;\n   170\t    archiveEntries?: Array<(typeof readyArchivePageFixture.entries)[number]>;\n   171\t    extraProcesses?: Array<typeof processSummary>;\n   172\t    artifactVersionsByArtifactId?: Record<string, ArtifactVersionRecord[]>;\n   173\t    sourceProvenanceByProcessId?: Record<string, StoredSourceProvenanceRecord[]>;\n   174\t    environmentLost?: boolean;\n   175\t  } = {},\n   176\t) {\n   177\t  return new InMemoryPlatformStore(buildStoreSeed(args));\n   178\t}\n   179\t\n   180\tasync function buildArchiveApp(\n   181\t  store: InMemoryPlatformStore,\n   182\t  resolution: SessionResolution = {\n   183\t    actor,\n   184\t    reason: null,\n   185\t  },\n   186\t) {\n   187\t  return buildApp({\n   188\t    authSessionService: createTestAuthSessionService(resolution),\n   189\t    authUserSyncService: new AuthUserSyncService(store),\n   190\t    platformStore: store,\n   191\t  });\n   192\t}\n   193\t\n   194\tclass ConflictDuringDerivedViewRefreshStore extends InMemoryPlatformStore {\n   195\t  private mutated = false;\n   196\t\n   197\t  override async replaceDerivedArchiveViews(args: {\n   198\t    projectId: string;\n   199\t    processId: string;\n   200\t    views: DerivedArchiveView[];\n   201\t  }): Promise<void> {\n   202\t    if (!this.mutated) {\n   203\t      this.mutated = true;\n   204\t      await this.appendArchiveEntry({\n   205\t        projectId: args.projectId,\n   206\t        processId: args.processId,\n   207\t        entryKind: 'process_event',\n   208\t        finalizationKey: 'event:archive-api-derived-refresh-conflict',\n   209\t        sourceObjectId: 'event-archive-api-derived-refresh-conflict',\n   210\t        bodyFormat: 'none',\n   211\t        recordedAt: '2026-05-01T12:15:00.000Z',\n   212\t      });\n   213\t    }\n   214\t\n   215\t    await super.replaceDerivedArchiveViews(args);\n   216\t  }\n   217\t}\n   218\t\n   219\tclass ThrowingArtifactVersionLookupStore extends InMemoryPlatformStore {\n   220\t  override async getArtifactVersion(args: {\n   221\t    versionId: string;\n   222\t  }): Promise<ArtifactVersionRecord | null> {\n   223\t    if (args.versionId === currentArtifactVersionFixture.versionId) {\n   224\t      throw new Error('Artifact version lookup failed.');\n   225\t    }\n   226\t\n   227\t    return super.getArtifactVersion(args);\n   228\t  }\n   229\t}\n   230\t\n   231\tclass ThrowingSourceProvenanceLookupStore extends InMemoryPlatformStore {\n   232\t  override async listProcessSourceProvenance(args: {\n   233\t    processId: string;\n   234\t  }): Promise<StoredSourceProvenanceRecord[]> {\n   235\t    if (args.processId === processId) {\n   236\t      throw new Error('Source provenance lookup failed.');\n   237\t    }\n   238\t\n   239\t    return super.listProcessSourceProvenance(args);\n   240\t  }\n   241\t}\n   242\t\n   243\tdescribe('archive API', () => {\n   244\t  const storedReadySourceProvenance = {\n   245\t    provenanceId: readySourceProvenanceFixture.provenanceId,\n   246\t    projectId,\n   247\t    processId,\n   248\t    sourceAttachmentId: readySourceProvenanceFixture.sourceAttachmentId,\n   249\t    relationshipKind: readySourceProvenanceFixture.relationshipKind,\n   250\t    repositoryFullName: readySourceProvenanceFixture.repositoryFullName,\n   251\t    repositoryUrl: readySourceProvenanceFixture.repositoryUrl,\n   252\t    targetRef: readySourceProvenanceFixture.targetRef,\n   253\t    eventId: null,\n   254\t    entryStatus: readySourceProvenanceFixture.entryStatus,\n   255\t    degradationReason: readySourceProvenanceFixture.degradationReason,\n   256\t    recordedAt: readySourceProvenanceFixture.recordedAt,\n   257\t  } as const;\n   258\t\n   259\t  it('TC-3.2a archive survives reload', async () => {\n   260\t    const store = buildStore();\n   261\t    const app = await buildArchiveApp(store);\n   262\t    const url = buildProcessArchiveApiPath({ projectId, processId });\n   263\t\n   264\t    const first = await app.inject({\n   265\t      method: 'GET',\n   266\t      url,\n   267\t      cookies: {\n   268\t        [sessionCookieName]: 'valid-session-cookie',\n   269\t      },\n   270\t    });\n   271\t    const second = await app.inject({\n   272\t      method: 'GET',\n   273\t      url,\n   274\t      cookies: {\n   275\t        [sessionCookieName]: 'valid-session-cookie',\n   276\t      },\n   277\t    });\n   278\t\n   279\t    expect(first.statusCode).toBe(200);\n   280\t    expect(second.statusCode).toBe(200);\n   281\t    expect(first.json()).toEqual(second.json());\n   282\t    expect(first.json()).toMatchObject({\n   283\t      entries: readyArchivePageFixture.entries,\n   284\t      page: {\n   285\t        cursor: null,\n   286\t        nextCursor: null,\n   287\t        hasMore: false,\n   288\t      },\n   289\t    });\n   290\t\n   291\t    await app.close();\n   292\t  });\n   293\t\n   294\t  it('TC-3.2b archive survives environment loss', async () => {\n   295\t    const store = buildStore({\n   296\t      environmentLost: true,\n   297\t      archiveEntries: [userArchiveEntryFixture, modelArchiveEntryFixture],\n   298\t    });\n   299\t    const app = await buildArchiveApp(store);\n   300\t    const response = await app.inject({\n   301\t      method: 'GET',\n   302\t      url: buildProcessArchiveApiPath({ projectId, processId }),\n   303\t      cookies: {\n   304\t        [sessionCookieName]: 'valid-session-cookie',\n   305\t      },\n   306\t    });\n   307\t\n   308\t    expect(response.statusCode).toBe(200);\n   309\t    expect(response.json()).toMatchObject({\n   310\t      entries: [userArchiveEntryFixture, modelArchiveEntryFixture],\n   311\t      page: {\n   312\t        cursor: null,\n   313\t        nextCursor: null,\n   314\t        hasMore: false,\n   315\t      },\n   316\t    });\n   317\t\n   318\t    await app.close();\n   319\t  });\n   320\t\n   321\t  it('TC-3.3a unauthorized archive read blocked', async () => {\n   322\t    const store = buildStore({\n   323\t      access: 'forbidden',\n   324\t    });\n   325\t    const app = await buildArchiveApp(store);\n   326\t    const response = await app.inject({\n   327\t      method: 'GET',\n   328\t      url: buildProcessArchiveApiPath({ projectId, processId }),\n   329\t      cookies: {\n   330\t        [sessionCookieName]: 'valid-session-cookie',\n   331\t      },\n   332\t    });\n   333\t\n   334\t    expect(response.statusCode).toBe(403);\n   335\t    expect(response.json()).toEqual({\n   336\t      code: 'PROJECT_FORBIDDEN',\n   337\t      message: 'You do not have access to this process.',\n   338\t      status: 403,\n   339\t    });\n   340\t\n   341\t    await app.close();\n   342\t  });\n   343\t\n   344\t  it('TC-3.3b missing process archive read returns not found', async () => {\n   345\t    const store = buildStore({\n   346\t      includeProcess: false,\n   347\t    });\n   348\t    const app = await buildArchiveApp(store);\n   349\t    const response = await app.inject({\n   350\t      method: 'GET',\n   351\t      url: buildProcessArchiveApiPath({ projectId, processId }),\n   352\t      cookies: {\n   353\t        [sessionCookieName]: 'valid-session-cookie',\n   354\t      },\n   355\t    });\n   356\t\n   357\t    expect(response.statusCode).toBe(404);\n   358\t    expect(response.json()).toEqual({\n   359\t      code: 'PROCESS_NOT_FOUND',\n   360\t      message: 'The requested process could not be found.',\n   361\t      status: 404,\n   362\t    });\n   363\t\n   364\t    await app.close();\n   365\t  });\n   366\t\n   367\t  it('TC-3.4a degraded entry displayed with healthy entries', async () => {\n   368\t    const store = buildStore({\n   369\t      archiveEntries: [userArchiveEntryFixture, degradedArchiveEntryFixture],\n   370\t    });\n   371\t    const app = await buildArchiveApp(store);\n   372\t    const response = await app.inject({\n   373\t      method: 'GET',\n   374\t      url: buildProcessArchiveApiPath({ projectId, processId }),\n   375\t      cookies: {\n   376\t        [sessionCookieName]: 'valid-session-cookie',\n   377\t      },\n   378\t    });\n   379\t\n   380\t    expect(response.statusCode).toBe(200);\n   381\t    expect(response.json()).toMatchObject({\n   382\t      entries: [\n   383\t        expect.objectContaining({\n   384\t          archiveEntryId: userArchiveEntryFixture.archiveEntryId,\n   385\t          entryStatus: 'ready',\n   386\t        }),\n   387\t        expect.objectContaining({\n   388\t          archiveEntryId: degradedArchiveEntryFixture.archiveEntryId,\n   389\t          entryStatus: 'degraded',\n   390\t          degradationReason: degradedArchiveEntryFixture.degradationReason,\n   391\t        }),\n   392\t      ],\n   393\t    });\n   394\t\n   395\t    await app.close();\n   396\t  });\n   397\t\n   398\t  it('invalid archive query returns INVALID_ARCHIVE_REQUEST', async () => {\n   399\t    const store = buildStore();\n   400\t    const app = await buildArchiveApp(store);\n   401\t    const response = await app.inject({\n   402\t      method: 'GET',\n   403\t      url: `${buildProcessArchiveApiPath({ projectId, processId })}?cursor=banana`,\n   404\t      cookies: {\n   405\t        [sessionCookieName]: 'valid-session-cookie',\n   406\t      },\n   407\t    });\n   408\t\n   409\t    expect(response.statusCode).toBe(422);\n   410\t    expect(response.json()).toEqual({\n   411\t      code: 'INVALID_ARCHIVE_REQUEST',\n   412\t      message: 'Archive pagination parameters were invalid.',\n   413\t      status: 422,\n   414\t    });\n   415\t\n   416\t    await app.close();\n   417\t  });\n   418\t\n   419\t  it('TC-6.1a artifact provenance visible from archive entry', async () => {\n   420\t    const store = buildStore({\n   421\t      archiveEntries: [\n   422\t        {\n   423\t          ...processEventArchiveEntryFixture,\n   424\t          relatedSourceProvenanceId: null,\n   425\t        },\n   426\t      ],\n   427\t      artifactVersionsByArtifactId: {\n   428\t        'artifact-001': [\n   429\t          {\n   430\t            versionId: currentArtifactVersionFixture.versionId,\n   431\t            artifactId: 'artifact-001',\n   432\t            versionLabel: currentArtifactVersionFixture.versionLabel,\n   433\t            contentStorageId: 'storage-001',\n   434\t            contentKind: 'markdown',\n   435\t            bytes: 128,\n   436\t            createdAt: currentArtifactVersionFixture.createdAt,\n   437\