_call',\\n   470\\t        finalizationKey: 'tool:lint:call',\\n   471\\t        relatedToolCallId: 'tool-call-1',\\n   472\\t        recordedAt: '2026-05-01T10:07:00.000Z',\\n   473\\t      }),\\n   474\\t    );\\n   475\\t    await appendArchiveEntryHandler(\\n   476\\t      ctx,\\n   477\\t      buildAppendArgs({\\n   478\\t        entryKind: 'tool_result',\\n   479\\t        finalizationKey: 'tool:lint:result',\\n   480\\t        relatedToolCallId: 'tool-call-1',\\n   481\\t        recordedAt: '2026-05-01T10:07:00.000Z',\\n   482\\t      }),\\n   483\\t    );\\n   484\\t\\n   485\\t    const page = await listArchiveEntriesHandler(ctx, {\\n   486\\t      processId: 'process-archive-1',\\n   487\\t      limit: 20,\\n   488\\t    });\\n   489\\t\\n   490\\t    expect(page.entries.map((entry) => [entry.sequence, entry.finalizationKey])).toEqual([\\n   491\\t      [0, 'tool:lint:call'],\\n   492\\t      [1, 'tool:lint:result'],\\n   493\\t    ]);\\n   494\\t  });\\n   495\\t\\n   496\\t  it('TC-2.3b replayed completion does not duplicate entry', async () => {\\n   497\\t    const { ctx } = createFakeConvexContext({\\n   498\\t      ...buildArchiveSeed(),\\n   499\\t      archiveEntries: [],\\n   500\\t    });\\n   501\\t\\n   502\\t    const first = await appendArchiveEntryHandler(\\n   503\\t      ctx,\\n   504\\t      buildAppendArgs({\\n   505\\t        entryKind: 'model_message',\\n   506\\t        finalizationKey: 'model:completed-1',\\n   507\\t        bodyText: 'First finalized response.',\\n   508\\t      }),\\n   509\\t    );\\n   510\\t    const replay = await appendArchiveEntryHandler(\\n   511\\t      ctx,\\n   512\\t      buildAppendArgs({\\n   513\\t        entryKind: 'model_message',\\n   514\\t        finalizationKey: 'model:completed-1',\\n   515\\t        bodyText: 'Replayed finalized response.',\\n   516\\t      }),\\n   517\\t    );\\n   518\\t    const page = await listArchiveEntriesHandler(ctx, {\\n   519\\t      processId: 'process-archive-1',\\n   520\\t      limit: 20,\\n   521\\t    });\\n   522\\t\\n   523\\t    expect(replay).toEqual(first);\\n   524\\t    expect(page.entries).toHaveLength(1);\\n   525\\t    expect(page.entries[0]).toMatchObject({\\n   526\\t      archiveEntryId: first.archiveEntryId,\\n   527\\t      bodyText: 'First finalized response.',\\n   528\\t      sequence: 0,\\n   529\\t    });\\n   530\\t  });\\n   531\\t\\n   532\\t  it('TC-1.4a and TC-1.4b store related context ids and keep pages readable when related context is missing', async () => {\\n   533\\t    const { ctx } = createFakeConvexContext({\\n   534\\t      ...buildArchiveSeed(),\\n   535\\t      archiveEntries: [],\\n   536\\t    });\\n   537\\t\\n   538\\t    await appendArchiveEntryHandler(\\n   539\\t      ctx,\\n   540\\t      buildAppendArgs({\\n   541\\t        entryKind: 'user_message',\\n   542\\t        finalizationKey: 'user:1',\\n   543\\t        recordedAt: '2026-05-01T10:08:00.000Z',\\n   544\\t      }),\\n   545\\t    );\\n   546\\t    await appendArchiveEntryHandler(\\n   547\\t      ctx,\\n   548\\t      buildAppendArgs({\\n   549\\t        entryKind: 'process_event',\\n   550\\t        finalizationKey: 'event:with-related-context',\\n   551\\t        relatedArtifactVersionId: 'artifact-version-1',\\n   552\\t        relatedSourceProvenanceId: 'provenance-1',\\n   553\\t        relatedToolCallId: 'tool-call-7',\\n   554\\t        recordedAt: '2026-05-01T10:08:01.000Z',\\n   555\\t      }),\\n   556\\t    );\\n   557\\t    await appendArchiveEntryHandler(\\n   558\\t      ctx,\\n   559\\t      buildAppendArgs({\\n   560\\t        entryKind: 'process_event',\\n   561\\t        finalizationKey: 'event:missing-related-context',\\n   562\\t        relatedArtifactVersionId: 'artifact-version-missing',\\n   563\\t        relatedSourceProvenanceId: 'provenance-missing',\\n   564\\t        relatedToolCallId: 'tool-call-missing',\\n   565\\t        recordedAt: '2026-05-01T10:08:02.000Z',\\n   566\\t      }),\\n  