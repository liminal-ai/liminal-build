ry],\\\\\\\\n   352\\\\\\\\t      },\\\\\\\\n   353\\\\\\\\t      projectAccessByProjectId: {\\\\\\\\n   354\\\\\\\\t        [ownerProjectSummary.projectId]: {\\\\\\\\n   355\\\\\\\\t          kind: 'accessible',\\\\\\\\n   356\\\\\\\\t          project: ownerProjectSummary,\\\\\\\\n   357\\\\\\\\t        },\\\\\\\\n   358\\\\\\\\t      },\\\\\\\\n   359\\\\\\\\t      sourceAttachmentsByProjectId: {\\\\\\\\n   360\\\\\\\\t        [ownerProjectSummary.projectId]: [healthySource, failingSource],\\\\\\\\n   361\\\\\\\\t      },\\\\\\\\n   362\\\\\\\\t    });\\\\\\\\n   363\\\\\\\\t    const sourceRefreshService = new DefaultSourceRefreshService(\\\\\\\\n   364\\\\\\\\t      platformStore,\\\\\\\\n   365\\\\\\\\t      new StubGitHubRepositoryResolver(({ repositoryUrl, targetRef }) => {\\\\\\\\n   366\\\\\\\\t        if (repositoryUrl === failingSource.repositoryUrl) {\\\\\\\\n   367\\\\\\\\t          throw new Error('GitHub source lookup failed for one attachment.');\\\\\\\\n   368\\\\\\\\t        }\\\\\\\\n   369\\\\\\\\t\\\\\\\\n   370\\\\\\\\t        return {\\\\\\\\n   371\\\\\\\\t          kind: 'resolved',\\\\\\\\n   372\\\\\\\\t          repositoryUrl,\\\\\\\\n   373\\\\\\\\t          repositoryFullName: healthySource.repositoryFullName,\\\\\\\\n   374\\\\\\\\t          targetRef,\\\\\\\\n   375\\\\\\\\t          targetRefKind: targetRef === null ? 'none' : 'branch',\\\\\\\\n   376\\\\\\\\t          defaultBranch: 'main',\\\\\\\\n   377\\\\\\\\t          resolvedRef: targetRef === null ? null : 'a'.repeat(40),\\\\\\\\n   378\\\\\\\\t        };\\\\\\\\n   379\\\\\\\\t      }),\\\\\\\\n   380\\\\\\\\t      noOpHydrationExecutor,\\\\\\\\n   381\\\\\\\\t    );\\\\\\\\n   382\\\\\\\\t    const app = await buildApp({\\\\\\\\n   383\\\\\\\\t      authSessionService: createTestAuthSessionService({\\\\\\\\n   384\\\\\\\\t        actor: {\\\\\\\\n   385\\\\\\\\t          userId: 'workos-user-1',\\\\\\\\n   386\\\\\\\\t          workosUserId: 'workos-user-1',\\\\\\\\n   387