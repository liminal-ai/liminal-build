dateHistoryFixture,\\n      }),\\n    ).toBeNull();\\n  });\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/streams/007-verify.stdout.log:66:{\"type\":\"item.started\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/003-implementor.json\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n./docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/streams/007-verify.stdout.log:67:{\"type\":\"item.started\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/007-verify.json\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n./docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/streams/007-verify.stdout.log:68:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/007-verify.json\\\"\",\"aggregated_output\":\"\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/streams/007-verify.stdout.log:69:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' docs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/00-foundation/003-implementor.json\\\"\",\"aggregated_output\":\"{\\\"command\\\":\\\"story-implement\\\",\\\"version\\\":1,\\\"status\\\":\\\"ok\\\",\\\"outcome\\\":\\\"ready-for-verification\\\",\\\"result\\\":{\\\"resultId\\\":\\\"656965c0-5984-44fd-acd0-3a3dcd8b9203\\\",\\\"provider\\\":\