n        environmentId: ensured.environmentId,\n        plan: hydrationPlan,\n      });\n      hydratedEnvironment = await this.upsertEnvironmentState({\n        processId: args.processId,\n        providerKind,\n        state: 'ready',\n","exit_code":0,"status":"completed"}}
