rocess_message',\\ntests/fixtures/process-history.ts:29:  kind: 'progress_update',\\ntests/fixtures/process-history.ts:39:  kind: 'attention_request',\\ntests/fixtures/process-history.ts:49:  kind: 'side_work_update',\\ntests/fixtures/process-history.ts:59:  kind: 'process_event',\\ntests/fixtures/archive.ts:52:export const reasoningArchiveEntryFixture = archiveEntrySchema.parse({\\ntests/fixtures/archive.ts:53:  archiveEntryId: 'archive-entry-reasoning-001',\\ntests/fixtures/archive.ts:56:  entryKind: 'reasoning',\\ntests/fixtures/archive.ts:59:  finalizationKey: 'reasoning:001',\\ntests/fixtures/archive.ts:60:  sourceObjectId: 'reasoning-001',\\ntests/fixtures/archive.ts:76:  entryKind: 'script_emission',\\ntests/fixtures/archive.ts:96:  entryKind: 'tool_call',\\ntests/fixtures/archive.ts:118:  entryKind: 'tool_result',\\ntests/fixtures/archive.ts:140:  entryKind: 'process_event',\\ntests/fixtures/archive.ts:160:  entryKind: 'process_event',\\ntests/fixtures/archive.ts:179:  reasoningArchiveEntryFixture,\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/07--archive-and-derived-views/artifacts/02-finalization-boundary-between-live-state-and-archive/streams/005-verify.stdout.log:81:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_39\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'rg -n \\\"current-object|current object|WebSocket|upsert\\\" docs/spec-build/v2/epics/07--archive-and-derived-views/tech-design.md docs/spec-build/v2/epics/07--archive-and-derived-views/stories/02-finalization-boundary-between-live-state-and-archive.md apps/platform/server/services/processes/live/process-live-normalizer.ts apps/platform/client/app/process-live.ts'\",\"aggregated_output\":\"apps/platform/server/services/processes/live/process-live-normalizer.ts:13:  messageType: 'snapshot' | 'upsert' | 'complete' | 'error';\\napps/platform/server/services/processes/live/process-live-normalizer.ts:57:    args.publication.messageType === 'upsert' &&\\nd