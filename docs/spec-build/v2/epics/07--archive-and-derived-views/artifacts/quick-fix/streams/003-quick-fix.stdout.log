project', 'process']);\\\\napps/platform/shared/contracts/schemas.ts:35:export type AttachmentScope = z.infer<typeof attachmentScopeSchema>;\\\\napps/platform/shared/contracts/schemas.ts:155:export type ArtifactSummary = z.infer<typeof artifactSummarySchema> & {\\\\napps/platform/shared/contracts/schemas.ts:156:  attachmentScope?: AttachmentScope;\\\\napps/platform/shared/contracts/schemas.ts:158:  processDisplayLabel?: string | null;\\\\napps/platform/shared/contracts/schemas.ts:173:  attachmentScope: attachmentScopeSchema,\\\\napps/platform/shared/contracts/schemas.ts:175:  processDisplayLabel: z.string().min(1).nullable(),\\\\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/004-self-review-pass-3.json:1:{\\\\\\\"resultId\\\\\\\":\\\\\\\"dd90a8d2-6bab-472f-aaaf-9a44c9e87b49\\\\\\\",\\\\\\\"provider\\\\\\\":\\\\\\\"codex\\\\\\\",\\\\\\\"model\\\\\\\":\\\\\\\"gpt-5.4\\\\\\\",\\\\\\\"role\\\\\\\":\\\\\\\"story_self_review_pass\\\\\\\",\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\",\\\\\\\"sessionId\\\\\\\":\\\\\\\"019dcb8d-54d4-7882-8bd6-b820edf96e06\\\\\\\",\\\\\\\"continuation\\\\\\\":{\\\\\\\"provider\\\\\\\":\\\\\\\"codex\\\\\\\",\\\\\\\"sessionId\\\\\\\":\\\\\\\"019dcb8d-54d4-7882-8bd6-b820edf96e06\\\\\\\",\\\\\\\"storyId\\\\\\\":\\\\\\\"00-foundation\\\\\\\"},\\\\\\\"outcome\\\\\\\":\\\\\\\"ready-for-verification\\\\\\\",\\\\\\\"story\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"00-foundation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Story 0: Foundation\\\\\\\"},\\\\\\\"passNumber\\\\\\\":3,\\\\\\\"planSummary\\\\\\\":\\\\\\\"Aligned Story 0 foundations by slimming project artifact summaries, extending review provenance and error contracts, adding durable process package-context tables/store methods, and refreshing fixtures/tests so the new vocabulary verifies cleanly.\\\\\\\",\\\\\\\"changedFiles\\\\\\\":[{\\\\\\\"path\\\\\\\":\\\\\\\"apps/platform/shared/contracts/schemas.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"Remov