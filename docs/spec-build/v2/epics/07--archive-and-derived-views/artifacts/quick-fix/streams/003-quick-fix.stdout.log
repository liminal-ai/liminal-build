: {\\n   611\\t        [sessionCookieName]: 'valid-session-cookie',\\n   612\\t      },\\n   613\\t    });\\n   614\\t\\n   615\\t    expect(response.statusCode).toBe(404);\\n   616\\t    expect(response.json()).toMatchObject({\\n   617\\t      code: 'ARTIFACT_VERSION_NOT_FOUND',\\n   618\\t      status: 404,\\n   619\\t    });\\n   620\\t\\n   621\\t    await app.close();\\n   622\\t  });\\n   623\\t\\n   624\\t  it('TC-3.2b returns REVIEW_TARGET_NOT_FOUND when the process neither references nor pins the artifact', async () => {\\n   625\\t    const platformStore = new InMemoryPlatformStore({\\n   626\\t      accessibleProjectsByUserId: {\\n   627\\t        'user:workos-user-1': [projectSummary],\\n   628\\t      },\\n   629\\t      projectAccessByProjectId: {\\n   630\\t        [projectSummary.projectId]: {\\n   631\\t          kind: 'accessible',\\n   632\\t          project: projectSummary,\\n   633\\t        },\\n   634\\t      },\\n   635\\t      processesByProjectId: {\\n   636\\t        [projectSummary.projectId]: [processSummary],\\n   637\\t      },\\n   638\\t      artifactsByProjectId: {\\n   639\\t        [projectSummary.projectId]: [\\n   640\\t          {\\n   641\\t            artifactId: 'artifact-unrelated-001',\\n   642\\t            displayName: 'Unrelated Design Notes',\\n   643\\t            currentVersionLabel: 'notes-v1',\\n   644\\t            updatedAt: '2026-04-23T12:07:00.000Z',\\n   645\\t          },\\n   646\\t        ],\\n   647\\t      },\\n   648\\t      artifactVersionsByArtifactId: {\\n   649\\t        'artifact-unrelated-001': [\\n   650\\t          {\\n   651\\t            versionId: 'artifact-unrelated-v1',\\n   652\\t            artifactId: 'artifact-unrelated-001',\\n   653\\t            versionLabel: 'notes-v1',\\n   654\\t            contentStorageId: 'storage-unrelated-v1',\\n   655\\t            contentKind: 'markdown',\\n   656\\t            bytes: 18,\\n   657\\t            createdAt: '2026-04-23T12:07:00.000Z',\\n   65