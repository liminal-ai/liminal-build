ocessFeatureImplementationStates.js';\\\\nimport { processFeatureSpecificationStateTableFields } from './processFeatureSpecificationStates.js';\\\\nimport { processOutputsTableFields } from './processOutputs.js';\\\\nimport { processProductDefinitionStateTableFields } from './processProductDefinitionStates.js';\\\\nimport { processSideWorkItemsTableFields } from './processSideWorkItems.js';\\\\nimport { projectMembersTableFields } from './projectMembers.js';\\\\nimport { projectsTableFields } from './projects.js';\\\\nimport { sourceAttachmentsTableFields } from './sourceAttachments.js';\\\\nimport { usersTableFields } from './users.js';\\\\n\\\\nexport default defineSchema({\\\\n  users: defineTable(usersTableFields).index('by_workosUserId', ['workosUserId']),\\\\n  projects: defineTable(projectsTableFields)\\\\n    .index('by_ownerUserId', ['ownerUserId'])\\\\n    .index('by_lastUpdatedAt', ['lastUpdatedAt']),\\\\n  projectMembers: defineTable(projectMembersTableFields)\\\\n    .index('by_projectId', ['projectId'])\\\\n    .index('by_userId', ['userId']),\\\\n  processes: defineTable(processesTableFields)\\\\n    .index('by_projectId', ['projectId'])\\\\n    .index('by_projectId_and_updatedAt', ['projectId', 'updatedAt']),\\\\n  processHistoryItems: defineTable(processHistoryItemsTableFields)\\\\n    .index('by_processId_and_createdAt', ['processId', 'createdAt'])\\\\n    .index('by_processId_and_clientRequestId', ['processId', 'clientRequestId'])\\\\n    .index('by_processId_and_requestState_and_createdAt', [\\\\n      'processId',\\\\n      'requestState',\\\\n      'createdAt',\\\\n    ]),\\\\n  processSideWorkItems: defineTable(processSideWorkItemsTableFields).index(\\\\n    'by_processId_and_updatedAt',\\\\n    ['processId', 'updatedAt'],\\\\n  ),\\\\n  processOutputs: defineTable(processOutputsTableFields).index('by_processId_and_updatedAt', [\\\\n    'processId',\\\\n    'updatedAt',\\\\n  ]),\\\\n  processProductDefinitionStates: defineTable(processProductDefinitionStateTableFields).index(\\\\n    'by_processId',\\\\n    ['processId'],\\\\n  ),\\\\n  processFeatureSpecificationStates: defineTable(processFeatureSpecificationStateTableFields).index(\\\\n    'by_processId',\\\\n    ['processId'],\\\\n  ),\\\\n  processFeatureImplementationStates: defineTable(\\\\n    processFeatureImplementationStateTableFields,\\\\n  ).index('by_processId', ['processId']),\\\\n  artifacts: defineTable(artifactsTableFields)\\\\n    .index('by_projectId', ['projectId'])\\\\n    .index('by_projectId_updatedAt', ['projectId', 'updatedAt']),\\\\n  sourceAttachments: defineTable(sourceAttachmentsTableFields)\\\\n    .index('by_projectId', ['projectId'])\\\\n    .index('by_projectId_updatedAt', ['projectId', 'updatedAt']),\\\\n});\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n./docs/spec-build/v2/epics/02--process-work-surface/story-verification/04-materials-and-outputs/codex-impl-round-1-stalled.jsonl:146:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_74\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg -n \\\\\\\\\\\\\\\"processProductDefinitionStates|processFeatureSpecificationStates|processFeatureImplementationStates|by_processId\\\\\\\\\\\\\\\" apps convex tests -g '*.ts'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"convex/_generated/api.d.ts:12:import type * as processFeatureImplementationStates from \\\\\\\"../processFeatureImplementationStates.js\\\\\\\";\\\\nconvex/_generated/api.d.ts:13:import type * as processFeatureSpecificationStates from \\\\\\\"../processFeatureSpecificationStates.js\\\\\\\";\\\\nconvex/_generated/api.d.ts:14:import type * as processProductDefinitionStates from \\\\\\\"../processProductDefinitionStates.js\\\\\\\";\\\\nconvex/_generated/api.d.ts:29:  processFeatureImplementationStates: typeof processFeatureImplementationStates;\\\\nconvex/_generated/api.d.ts:30:  processFeatureSpecificationStates: typeof processFeatureSpecificationStates;\\\\nconvex/_generated/api.d.ts:31:  processProductDefinitionStates: typeof processProductDefinitionStates;\\\\nconvex/processHistoryItems.ts:48:      .withIndex('by_processId_and_createdAt', (query) => query.eq('processId', processId))\\\\nconvex/processOutputs.ts:23:      .withIndex('by_processId_and_updatedAt', (query) => query.eq('processId', processId))\\\\nconvex/processes.ts:152:      .withIndex('by_processId_and_clientRequestId', (indexQuery) =>\\\\nconvex/processes.ts:193:      await ctx.db.insert('processProductDefinitionStates', {\\\\nconvex/processes.ts:201:      await ctx.db.insert('processFeatureSpecificationStates', {\\\\nconvex/processes.ts:209:      await ctx.db.insert('processFeatureImplementationStates', {\\\\nconvex/processes.ts:295:      .withIndex('by_processId_and_clientRequestId', (indexQuery) =>\\\\nconvex/processSideWorkItems.ts:29:      .withIndex('by_processId_and_updatedAt', (query) => query.eq('processId', processId))\\\\nconvex/schema.ts:5:import { processFeatureImplementationStateTableFields } from './processFeatureImplementationStates.js';\\\\nconvex/schema.ts:6:import { processFeatureSpecificationStateTableFields } from './processFeatureSpecificationStates.js';\\\\nconvex/schema.ts:8:import { processProductDefinitionStateTableFields } from './processProductDefinitionStates.js';\\\\nconvex/schema.ts:27:    .index('by_processId_and_createdAt', ['processId', 'createdAt'])\\\\nconvex/schema.ts:28:    .index('by_processId_and_clientRequestId', ['processId', 'clientRequestId'])\\\\nconvex/schema.ts:29:    .index('by_processId_and_requestState_and_createdAt', [\\\\nconvex/schema.ts:35:    'by_processId_and_updatedAt',\\\\nconvex/schema.ts:38:  processOutputs: defineTable(processOutputsTableFields).index('by_processId_and_updatedAt', [\\\\nconvex/schema.ts:42:  processProductDefinitionStates: defineTable(processProductDefinitionStateTableFields).index(\\\\nconvex/schema.ts:43:    'by_processId',\\\\nconvex/schema.ts:46:  processFeatureSpecificationStates: defineTable(processFeatureSpecificationStateTableFields).index(\\\\nconvex/schema.ts:47:    'by_processId',\\\\nconvex/schema.ts:50:  processFeatureImplementationStates: defineTable(\\\\nconvex/schema.ts:52:  ).index('by_processId', ['processId']),\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n./docs/spec-build/v2/epics/02--process-work-surface/story-verification/04-materials-and-outputs/codex-review-round-1.jsonl:11:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '1,260p' /Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/02--process-work-surface/tech-design.md\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"# Technical Design: Process Work Surface\\\\n\\\\n## Purpose\\\\n\\\\nThis document translates Epic 2 into implementable architecture for the Liminal\\\\nBuild process work surface. It is the index document for a four-file tech design\\\\nset:\\\\n\\\\n| Document | Role |\\\\n|----------|------|\\\\n| `tech-design.md` | Decision record, validation, system view, module architecture overview, work breakdown |\\\\n| `tech-design-client.md` | Route model, client state, process surface UI, live-update client, browser flow design |\\\\n| `tech-design-server.md` | Fastify routes, WebSocket integration, process-surface services, Convex state model, projection and action design |\\\\n| `test-plan.md` | TC-to-test mapping, mock strategy, fixtures, test counts, chunk verification plan |\\\\n\\\\nThe downstream consumers are:\\\\n\\\\n| Audience | What they need from this design |\\\\n|----------|---------------------------------|\\\\n| Reviewers | Clear design decisions, scope discipline, and visible trade-offs before implementation starts |\\\\n| Story authors | Chunk boundaries, relevant design sections, and stable technical targets for enrichment |\\\\n| Implementers | Exact file paths, interface targets, mock boundaries, and verification gates |\\\\n\\\\n## Spec Validation\\\\n\\\\nEpic 2 is designable after the latest clarification pass. The feature now makes\\\\nthe pinned-vs-chronological request distinction explicit, distinguishes side-work\\\\nsummary state from history state, defines same-session mutation update behavior,\\\\nand resolves process-surface degradation behavior at the spec level. The\\\\nremaining work is implementation design, not spec repair.\\\\n\\\\nThe design still needs to be explicit about one important line: Epic 2 delivers\\\\nthe process control surface and visible live state, not the full execution\\\\nsubstrate. Environment lifecycle, tool harness execution, canonical archive\\\\ntaxonomy, and rich artifact review remain separate concerns owned by later\\\\nepics.\\\\n\\\\n### Issues Found\\\\n\\\\n| Issue | Spec Location | Resolution | Status |\\\\n|-------|---------------|------------|--------|\\\\n| `currentRequest` and visible history were initially ambiguous | AC-3.2, Data Contracts | Epic now states that requests are issued into visible history and projected into a pinned unresolved request view while still active | Resolved |\\\\n| `sideWork` summary state and chronological history were initially ambiguous | AC-5.3, AC-5.4, Data Contracts | Epic now distinguishes current summary items from related history records | Resolved |\\\\n| Mutation success behavior did not define same-session surface update expectations | AC-2.x, AC-3.x, Data Contracts | Epic now states that successful actions update the visible surface immediately, then reconcile through live updates or fallback bootstrap | Resolved |\\\\n| Process-surface section failure policy was initially deferred to Tech Design | AC-6.x, Tech Design Questions | Epic now defines section-by-section degradation when core process identity and status are still available | Resolved |\\\\n| Epic 2 still defined `PROCESS_LIVE_UPDATES_UNAVAILABLE` as a `503` request error even though the surface must remain usable from durable bootstrap state | Data Contracts, Error Responses | This design treats live-unavailable as a post-bootstrap live transport state, not as an HTTP bootstrap failure. Durable bootstrap remains `200`; live failure is surfaced through the live client state and retry path | Resolved — deviated |\\\\n| The current Convex scaffold uses `queryGeneric`/`mutationGeneric`, `ctx: any`, and some broad `.collect()` reads that do not match the generated Convex AI guidelines | Existing codebase in `convex/*.ts` | This design standardizes new and modified Convex modules on guideline-compliant validators, typed contexts, bounded queries, and explicit indexes. Existing scaffold shortcuts are treated as implementation debt, not as design precedent | Resolved — deviated |\\\\n| The original Epic 1 design assumed a greenfield repo, but the current workspace already contains a working shell scaffold | Epic 1 tech design context | This design nests within the actual `apps/platform`, `convex`, and `tests` structure already in the repo | Resolved — clarified |\\\\n\\\\n## Context\\\\n\\\\nEpic 2 is the second half of Milestone 1. Epic 1 established the durable\\\\nproject shell: authenticated entry, project listing, project shell summaries,\\\\nprocess registration, and return-later shell visibility. Epic 2 is the first\\\\ntime the platform has to feel like a process product instead of a shell around\\\\nrecords. The user needs to open one process and stay oriented through active\\\\nprogress, conversation, current materials, unresolved requests, and return-later\\\\nstate without reconstructing what is happening from summaries alone.\\\\n\\\\nThe technical architecture already constrains the shape of this work. Fastify is\\\\nthe control plane. Convex is the durable state layer behind that control plane.\\\\nThe browser consumes typed upsert objects over WebSocket instead of raw provider\\\\ndeltas. The platform is process-first, not transcript-first, and process types\\\\nremain code-defined modules with process-owned semantics. The design therefore\\\\nneeds to add a dedicated process-surface route, a browser store that can hold\\\\ndurable and live state together, and a server-side projection/action layer that\\\\nkeeps the shared work surface generic without flattening process-specific\\\\nbehavior into one universal schema blob.\\\\n\\\\nThe current codebase is no longer just a Story 0 scaffold. It already contains\\\\nthe Epic 1 shell implementation shape: a Fastify app in `apps/platform/server`,\\\\na Vite-built vanilla TypeScript client in `apps/platform/client`, Zod-authored\\\\nshared contracts in `apps/platform/shared/contracts`, and a Convex-backed\\\\n`PlatformStore` abstraction that feeds the server services. That is a strength:\\\\nEpic 2 can extend those seams instead of inventing parallel ones. It is also a\\\\nconstraint: the design should preserve the existing shell route model where it\\\\nstill makes sense, keep the server as the composition root, and avoid\\\\nover-engineering a brand-new client architecture that fights the current code.\\\\n\\\\nThe highest-risk area in this design is state coherence across three different\\\\ntruth layers. The browser needs a durable bootstrap for reload and re-entry, a\\\\nlive current-object stream for in-session coherence, and a clear boundary\\\\nbetween visible user-facing process history and the fuller canonical archive\\\\nplanned for Epic 5. The design therefore needs to introduce a forward-compatible\\\\nvisible-history model for the process surface without pretending to solve the\\\\nentire archive problem early.\\\\n\\\\n## Tech Design Question Answers\\\\n\\\\n### Q1. What is the exact browser route model for entering a dedicated process work surface?\\\\n\\\\nUse a dedicated process route nested under the existing project route family:\\\\n\\\\n- `GET /projects`\\\\n- `GET /projects/:projectId`\\\\n- `GET /projects/:projectId/processes/:processId`\\\\n\\\\nFastify continues to serve the same authenticated shell HTML for all project and\\\\nprocess routes. The client router expands from two route kinds to three:\\\\n\\\\n- `project-index`\\\\n- `project-shell`\\\\n- `process-work-surface`\\\\n\\\\nEpic 1's `?processId=` query parameter remains a shell-level focus affordance for\\\\nthe project shell only. Opening active work moves the user onto the dedicated\\\\nprocess route. This keeps the process work su------|--------------|---------------|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| WorkOS-authenticated Fastify request | All source-management routes | Existing auth middleware populates `request.actor` |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| GitHub token/config | Repository validation and branch freshness checks | Epic 6 introduces a dedicated `GitHubRepositoryResolver` seam over the existing app GitHub configuration |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Convex deployment/local backend | Durable source and provenance records | `pnpm run convex:dev` for runtime; tests use in-memory/mocked stores |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Environment refresh seam | Refresh/recovery paths | Epic 6 introduces a dedicated source refresh seam over existing process/environment services rather than assuming a full source-management implementation already exists |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Existing verification scripts | Story execution | `pnpm run red-verify`, `pnpm run verify`, `pnpm run green-verify`, `pnpm run verify-all` |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Decisions\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Decision | Rationale | Consequence |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n|----------|-----------|-------------|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Keep `repositoryUrl` and add `repositoryFullName` | `repositoryUrl` is operational clone/write input; `owner/name` is stable GitHub identity for uniqueness and provenance | Create accepts URL-first requests and may derive full name; persisted summaries return both |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Source-management routes live in Fastify | Architecture says Fastify owns orchestration, auth, integrations, and source policy | Convex functions remain trusted persistence operations, not public app API |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Soft detach rather than hard delete | Prior provenance and historical source identity must remain visible after detach | Active source reads filter detached rows; provenance can still resolve copied identity |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Refresh may be pending | Repo fetch/hydration work can exceed a short request | Pending state is operation metadata, not a fifth canonical hydration state |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Process-scoped attach updates current process source refs immediately | The epic says a process-scoped attachment belongs to one process as current source state and becomes visible immediately | `attachProcessSource` persists the source row and adds its id to that process's current source refs in the same orchestration path |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Process scope shadows project scope only in current-source reads | Same repo can be useful both project-wide and process-specific | Durable rows can coexist; resolver picks process-scoped row for that process when identity/ref collide |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Read-write attachments require branch-like target refs | Durable code updates need a writable moving ref rather than an immutable commit/tag | `read_write` attachments reject tag/commit target refs; `read_only` attachments may use branch/tag/commit |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Provenance records copy immutable identity | Detach or access loss must not erase process history | Provenance stores `repositoryFullName`, `repositoryUrl`, `targetRef`, relationship kind, and optional attachment id |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Module Boundaries\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### File Architecture\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nconvex/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── sourceAttachments.ts                         # MODIFIED: durable CRUD/query functions for source lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── sourceProvenance.ts                          # NEW: durable source provenance records and process reads\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── schema.ts                                    # MODIFIED: source fields, provenance table, indexes\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/shared/contracts/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── schemas.ts                                   # MODIFIED: source summary fields, source provenance schemas\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── source-management.ts                         # NEW: route request/response contracts and route constants\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── index.ts                                     # MODIFIED: exports\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/schemas/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── source-management.ts                         # NEW: Zod route schemas for source-management APIs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/routes/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── source-management.ts                         # NEW: Fastify routes for attach/update/refresh/detach/provenance\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/sources/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── source-management.service.ts                 # NEW: orchestration, validation, conflict/shadowing policy\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── source-identity.service.ts                   # NEW: URL parsing, canonical full-name derivation, target-ref normalization\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── github-repository-resolver.ts                # NEW: GitHub access/ref validation boundary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── source-refresh.service.ts                    # NEW: refresh request handling and pending/settled result shaping\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── source-provenance.service.ts                 # NEW: provenance record creation/read enrichment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/projects/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── platform-store.ts                            # MODIFIED: source lifecycle/provenance methods\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── readers/source-section.reader.ts             # MODIFIED: active/non-detached project source summaries\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/processes/readers/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── materials-section.reader.ts                  # MODIFIED: active-source resolver and process shadowing\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/client/features/projects/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── source-attachment-section.ts                 # MODIFIED: management controls and pending/degraded state display\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/client/features/processes/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── process-materials-section.ts                 # MODIFIED: current-source shadowing/freshness/provenance display\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── source-provenance-section.ts                 # NEW: process provenance section\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── fixtures/sources.ts                          # MODIFIED: repositoryFullName, freshness, detach, provenance fixtures\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── service/server/source-management-api.test.ts # NEW: Fastify route/service tests\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── service/server/source-management-service.test.ts # NEW: pure policy/resolver tests\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n├── service/client/source-management-ui.test.ts  # NEW: client behavior tests\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n└── service/client/source-provenance-section.test.ts # NEW: provenance UI tests\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Module Responsibility Matrix\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Module | Status | Responsibility | Dependencies | ACs Covered |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n|--------|--------|----------------|--------------|-------------|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `convex/sourceAttachments.ts` | Modified | Persist source rows, active queries, duplicate indexes, soft detach fields, hydration/freshness updates | Convex validators/schema | AC-1.x, AC-2.x, AC-3.x, AC-5.x, AC-6.x |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `convex/sourceProvenance.ts` | New | Persist and read process-scoped provenance entries with copied source identity | Convex validators/schema | AC-4.x, AC-5.2 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `source-management.ts` contracts | New | Shared request/response schemas, error codes, route constants | Zod shared schemas | All route-facing ACs |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `registerSourceManagementRoutes` | New | Authenticated Fastify API entry points | SourceManagementService, access services | AC-1.x through AC-6.x |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `SourceManagementService` | New | Attach/update/detach orchestration, conflict rules, scope enforcement | PlatformStore, SourceIdentityService, GitHubRepositoryResolver | AC-1.x, AC-2.x, AC-5.x, AC-6.2 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `SourceRefreshService` | New | Refresh request policy, settled/pending/failed response mapping | PlatformStore, environment/service hooks, GitHub resolver | AC-3.x |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `SourceProvenanceService` | New | Record/read provenance, enrich degraded entries independently | PlatformStore | AC-4.x, AC-5.2 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `MaterialsSectionReader` | Modified | Resolve current process sources with process-scoped shadowing and detached filtering | PlatformStore | AC-2.1, AC-3.1, AC-6.1 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `SourceSectionReader` | Modified | Project shell source summaries, excluding inactive rows from active lists | PlatformStore | AC-1.2, AC-2.1, AC-3.1, AC-5.3, AC-6.1 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Client source sections | Modified/New | Render management controls, freshness, provenance, detach, degraded states | Shared contracts | AC-1.2, AC-2.x, AC-3.x, AC-4.x, AC-5.x, AC-6.x |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Data Model\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Convex `sourceAttachments`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThe existing table remains the durable source attachment table. Epic 6 extends\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nit rather than introducing a parallel source identity table.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```typescript\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nexport const sourceAttachmentsTableFields = {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  projectId: v.string(),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  processId: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  provider: v.literal('github'),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  displayName: v.string(),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  purpose: v.union(v.literal('research'), v.literal('review'), v.literal('implementation'), v.literal('other')),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  accessMode: v.union(v.literal('read_only'), v.literal('read_write')),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  repositoryUrl: v.string(),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  repositoryFullName: v.string(),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  targetRef: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  hydrationState: v.union(v.literal('not_hydrated'), v.literal('hydrated'), v.literal('stale'), v.literal('unavailable')),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  lastHydratedAt: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  lastHydratedResolvedRef: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  lastObservedRemoteResolvedRef: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  freshnessReason: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  refreshStatus: v.union(v.literal('idle'), v.literal('pending'), v.literal('failed')),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  refreshRequestedAt: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  detachedAt: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  detachedByUserId: v.union(v.string(), v.null()),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  updatedAt: v.string(),\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n};\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nIndexes:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"}}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/03-hydration-and-freshness-management/streams/004-verify.stdout.log:27:{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item_11\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"sed -n '521,760p' docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/tech-design.md\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"sequenceDiagram\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant U as User\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant C as Client Source UI\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant R as Fastify Source Route\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant S as SourceManagementService\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant G as GitHubRepositoryResolver\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant P as PlatformStore\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant X as Convex\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    U->>C: Submit repository URL and metadata\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    C->>R: POST source-attachments\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    Note over R,S: AC-1.1: project or process scoped attach\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    R->>S: attachProjectSource or attachProcessSource\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    S->>G: resolveRepository(url, fullName?, targetRef)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    Note over S,G: AC-1.4: reject invalid/inaccessible repos\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    G-->>S: canonical repositoryFullName\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    S->>P: createSourceAttachment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    P->>X: sourceAttachments:createSourceAttachment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    Note over P,X: AC-1.3: duplicate active row rejected\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    alt Process-scoped attach\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        S->>P: add sourceAttachmentId to current process source refs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    end\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    X-->>P: persisted row\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    P-->>S: SourceAttachmentSummary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    S-->>R: summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    R-->>C: 201 summary\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nFor process-scoped attach, `SourceManagementService` must update the process's\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ncurrent source refs so the new source appears immediately in\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`materials.currentSources`. Project-scoped attach creates a durable shared\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsource row but does not automatically make that source current for every\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nprocess.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Flow 2: Manage Purpose, Access Mode, and Target Ref\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThis flow covers AC-2.1 through AC-2.4. Purpose and access mode are durable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nmetadata. Target ref is part of the source definition; changing it marks a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\npreviously hydrated attachment stale until refresh/rehydration catches up.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`SourceManagementService.updateSource` validates the actor, loads the active\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsource row, normalizes the target ref, and calls `PlatformStore.updateSource`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nConvex applies the update atomically. If the target ref changes while\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`hydrationState === 'hydrated'`, the Fastify-side service includes the requested\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nfreshness transition in the write plan and Convex persists it with the metadata\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nupdate. The resulting row uses `hydrationState: 'stale'` and a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`freshnessReason` such as `target_ref_changed`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nFor `read_write` sources, the service validates that `targetRef` is a writable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nbranch ref before persistence. If `targetRef` is omitted for `read_write`,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nEpic 6 resolves it to the repository default branch before the row is written.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`read_only` sources may use branch, tag, or commit refs.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Flow 3: Hydration and Freshness\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThis flow covers AC-3.1 through AC-3.3. The four canonical states remain\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`not_hydrated`, `hydrated`, `stale`, and `unavailable`. Pending refresh is not a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nstate in that enum; it is operation progress metadata returned by refresh and\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nvisible in the client.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nBranch freshness is evaluated from durable snapshot state plus live repository\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nresolution:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- if `targetRef` is a branch and the current remote resolution differs from\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  `lastHydratedResolvedRef`, return `stale`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- if the working copy is recoverably missing, return `stale` with\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  `freshnessReason: 'working_copy_missing'`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- if the branch/ref cannot be resolved safely, return `unavailable`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- if the source is `read_only` with a tag/commit ref, keep it `hydrated` unless\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  the ref becomes unavailable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```mermaid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsequenceDiagram\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant U as User\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant C as Client Source UI\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant R as Fastify Source Route\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant F as SourceRefreshService\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant P as PlatformStore\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant E as Environment Service\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    U->>C: Click refresh\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    C->>R: POST /refresh\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    R->>F: refreshSource\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    F->>P: get source attachment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    alt Cheap freshness check or rehydration completes\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        F->>E: refresh or validate working copy\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        F->>P: update hydration/freshness\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        F-->>R: refreshStatus settled + sourceAttachment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    else Longer work needed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        F->>P: mark refresh pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        F-->>R: refreshStatus pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    else Not recoverable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        F-->>R: request-level error or refreshStatus failed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    end\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    R-->>C: Visible settled/pending/failed state\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Flow 4: Source Provenance\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThis flow covers AC-4.1 through AC-4.4. Process execution records provenance at\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntwo moments: when an attached source informs process work and when a writable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsource receives a durable code update. Environment execution services already\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nknow the current source attachment ids and code checkpoint targets; Epic 6 adds\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nexplicit provenance recording through `SourceProvenanceService`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nRead-only attachments can record `informed_work` but must not be represented as\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`received_code_update`. Code checkpoint planning already blocks writes to\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nread-only sources; provenance records reinforce that boundary by deriving write\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nprovenance only from successful writable checkpoint results.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nRefresh does not create provenance. Provenance is reserved for execution-time\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsource influence and durable code updates so AC-4 remains about process work,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nnot source maintenance.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Flow 5: Detach Sources\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThis flow covers AC-5.1 through AC-5.3. Detach is a soft operation. It removes\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nthe source from future active source lists and current-source resolution, but it\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ndoes not delete provenance or mutate an already hydrated working copy mid-run.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```mermaid\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsequenceDiagram\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant U as User\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant C as Client Source UI\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant R as Fastify Source Route\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant S as SourceManagementService\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant P as PlatformStore\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    participant X as Convex\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    U->>C: Detach source\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    C->>R: DELETE source attachment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    R->>S: detachSource\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    S->>P: softDetachSourceAttachment\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    P->>X: set detachedAt, detachedByUserId, updatedAt\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    X-->>P: detached row\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    P-->>S: detached response\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    S-->>R: detached true\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    R-->>C: remove from active list\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n### Flow 6: Reopen and Degraded State\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThis flow covers AC-6.1 through AC-6.3. Project shell and process work surface\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nreads continue to return section envelopes. One failed source/provenance lookup\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nmust degrade locally rather than hiding healthy source rows.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`SourceSectionReader` and `MaterialsSectionReader` should preserve the existing\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsection envelope pattern. Active lists exclude detached rows; process materials\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nuse the active-source resolver to combine project and process scopes. If an\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nenrichment lookup fails, the reader returns durable source identity with\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`entryStatus: degraded` or a section-level source error only when the whole\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nsection cannot load.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Active Source Resolution\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThe active-source resolver is the central design answer for process-scoped\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nshadowing. It affects the process work surface and environment working-set\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nplanning; it does not make every project-scoped source automatically current\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nfor every process. A process sees only source attachments referenced by its\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ncurrent material refs, after active filtering and shadowing are applied.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```typescript\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nexport function resolveActiveProcessSources(args: {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  projectSources: SourceAttachmentSummary[];\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  processId: string;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  currentSourceAttachmentIds: string[];\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n}): ProcessSourceReference[] {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  throw new NotImplementedError('resolveActiveProcessSources');\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n```\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nResolution rules:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n1. Exclude rows with `detachedAt`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n2. Build the base active set from rows whose `sourceAttachmentId` is in\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   `currentSourceAttachmentIds`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n3. Partition active rows into project-scoped rows and rows where `processId`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   matches.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n4. Compute shadow key as `${repositoryFullName}:${targetRef ?? ''}`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n5. If an active project-scoped row has a process-scoped sibling with the same\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   shadow key, include the process-scoped sibling in the candidate set even when\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   its id is not yet in `currentSourceAttachmentIds`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n6. Prefer the matching process-scoped row over the project-scoped row for that\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n   process only.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n7. Sort visible rows by `updatedAt` descending.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n8. Preserve degraded metadata independently per row.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nThis resolver belongs in Fastify/shared server logic, not Convex. Convex stores\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nrows; Fastify decides how one process sees its current source material.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Implementation Chunks\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Chunk | Story | Scope | ACs | Primary Tests |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n|-------|-------|-------|-----|---------------|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 0 | Foundation | Shared contracts, Convex schema/indexes, fixtures, errors, resolver skeletons | All support | Relevant sections: API Contracts, Data Model. Non-TC: shared contract/schema expansion |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 1 | Attach repositories | Routes, service validation, GitHub resolver, duplicate checks, process current-source mutation | AC-1.x | Relevant sections: Flow 1, Service Interfaces, Error Codes. Non-TC: URL/full-name mismatch, writable-ref policy, non-GitHub rejection |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 2 | Manage metadata | Update route, target-ref stale logic, UI metadata display | AC-2.x | Relevant sections: Flow 2, API Contracts. Non-TC: none |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 3 | Hydration/freshness | Refresh route, pending/settled/failed responses, branch snapshot comparison, freshness UI | AC-3.x | Relevant sections: Flow 3, Data Model. Non-TC: branch-head drift, refresh contract semantics |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 4 | Provenance | Provenance records, process read endpoint, degraded enrichment, redaction behavior | AC-4.x | Relevant sections: Flow 4, Data Model, API Contracts. Non-TC: unavailable-source redaction |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 5 | Detach | Soft detach, active-list filtering, provenance retention | AC-5.x | Relevant sections: Flow 5, Active Source Resolution. Non-TC: detached-row durability |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| 6 | Reopen/degraded | Reopen surfaces, access loss, partial failure behavior | AC-6.x | Relevant sections: Flow 6, Error Codes. Non-TC: none |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nChunk 0 creates durable vocabulary and fixtures. Chunks 1-6 should follow the\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nTDD loop: skeleton stubs, Red tests, Green implementation, then `green-verify`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Verification\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Script | Command | Use |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n|--------|---------|-----|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `red-verify` | `pnpm run red-verify` | After skeleton and Red tests; tests may fail but format/lint/typecheck/build pass |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `verify` | `pnpm run verify` | Standard development gate |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `green-verify` | `pnpm run green-verify` | After implementation passes; includes current no-test-changes guard |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `verify-all` | `pnpm run verify-all` | Epic/story completion and integration confidence |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Deferred Items\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Item | Related AC | Reason Deferred | Future Work |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n|------|------------|-----------------|-------------|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| MCP-backed source attachment | Scope | Epic 6 is repository-focused | Later source-integration epic |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Archive/turn/chunk views | Scope | Owned by Epic 7 | Epic 7 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Full background freshness polling | AC-3.x | Epic 6 uses read/request freshness checks | Later operational monitoring work |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Complex branch protection/write policy UI | AC-2.x, AC-4.x | Epic 6 only distinguishes read-only vs writable and target ref | Later GitHub policy work |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Resolved Implementation Decisions\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Decision | Applied In |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n|----------|------------|\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Pending refresh is stored on the source row with `refreshStatus` and `refreshRequestedAt`; Epic 6 does not add a separate refresh-operations table. | Chunk 3 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| `read_write` attachments require branch-like target refs. `read_only` attachments may use branch, tag, or commit refs. | Chunk 1 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n| Provenance is recorded only for execution-time source influence and durable code updates, never for manual refresh. | Chunk 4 |\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n## Self-Review Checklist\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- [x] Every Epic 6 AC has a module owner.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- [x] Every Epic 6 TC is mapped in `test-plan.md`.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- [x] Fastify/Convex boundary is explicit.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- [x] Source identity and shadowing are explicit.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- [x] Refresh pending state is not a fifth hydration state.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n- [x] Verification commands use project scripts.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"exit_code\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"}}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/03-hydration-and-freshness-management/streams/004-verify.stdout.log:30:{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item.completed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item_13\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"command_execution\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"command\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"rg --files | rg 'source-management|source-attachment-section|process-materials-section|source-refresh|github-repository-resolver|platform-store|sourceAttachments\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.ts|schema\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\.ts|source-management-ui|process-work-surface-api|projects-api'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"apps/platform/client/browser-api/projects-api.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/client/browser-api/process-work-surface-api.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/client/features/projects/source-attachment-section.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/client/features/processes/process-materials-section.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/shared/contracts/source-management.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/sources/github-repository-resolver.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/sources/source-management.service.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/sources/source-refresh.service.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/routes/source-management.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/services/projects/platform-store.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\napps/platform/server/schemas/source-management.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nconvex/schema.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\nconvex/sourceAttachments.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/process-work-surface-api.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/platform-store-environment-summary.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/platform-store-recovery-materials.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/projects-api.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/source-management-contracts.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/source-management-service.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/client/process-materials-section.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/client/source-management-ui.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/client/source-attachment-section.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/convex-platform-store-api-key.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ntests/service/server/platform-store-checkpoint-artifacts.test.ts\\\\\\\\\\\\\\\\\\\\\\\\\