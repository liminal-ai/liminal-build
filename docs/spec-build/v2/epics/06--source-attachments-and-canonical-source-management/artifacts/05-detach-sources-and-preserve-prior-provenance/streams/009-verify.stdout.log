status !== 'interrupted') {\n    30\t      throw new AppError({\n    31\t        code: 'PROCESS_ACTION_NOT_AVAILABLE',\n    32\t        message: 'Resume is not available for this process right now.',\n    33\t        statusCode: 409,\n    34\t      });\n    35\t    }\n    36\t\n    37\t    const result = await this.platformStore.resumeProcess({\n    38\t      processId: access.process.processId,\n    39\t    });\n    40\t    const existingEnvironment = await this.platformStore.getProcessEnvironmentSummary({\n    41\t      processId: access.process.processId,\n    42\t    });\n    43\t    const persistedProviderKind = await this.platformStore.getProcessEnvironmentProviderKind({\n    44\t      processId: access.process.processId,\n    45\t    });\n    46\t    const providerKind = persistedProviderKind ?? this.defaultEnvironmentProviderKind;\n    47\t    const environment = requiresEnvironmentPreparation(result.process.status)\n    48\t      ? await this.platformStore.upsertProcessEnvironmentState({\n    49\t          processId: access.process.processId,\n    50\t          providerKind,\n    51\t          state: 'preparing',\n    52\t          environmentId: existingEnvironment.environmentId,\n    53\t          blockedReason: null,\n    54\t          lastHydratedAt: existingEnvironment.lastHydratedAt,\n    55\t        })\n    56\t      : existingEnvironment;\n    57\t\n    58\t    if (requiresEnvironmentPreparation(result.process.status)) {\n    59\t      const [materialRefs, currentOutputs, sourceAttachments] = await Promise.all([\n    60\t        this.platformStore.getCurrentProcessMaterialRefs({\n    61\t          processId: access.process.processId,\n    62\t        }),\n    63\t        this.platformStore.listProcessOutputs({\n    64\t          processId: access.process.processId,\n    65\t        }),\n    66\t        this.platformStore.listProjectSourceAttachments({\n    67\t          projectId: access.project.projectId,\n    68\t        }),\n    69\t      ]);\n  