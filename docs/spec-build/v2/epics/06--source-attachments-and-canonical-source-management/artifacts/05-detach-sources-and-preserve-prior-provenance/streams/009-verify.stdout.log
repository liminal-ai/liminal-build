uildShadowKey(sourceAttachment), sourceAttachment);\n    40\t  }\n    41\t\n    42\t  for (const sourceAttachment of activeAttachments) {\n    43\t    if (\n    44\t      sourceAttachment.attachmentScope !== 'project' ||\n    45\t      !currentSourceAttachmentIds.has(sourceAttachment.sourceAttachmentId)\n    46\t    ) {\n    47\t      continue;\n    48\t    }\n    49\t\n    50\t    const processScopedSibling = processScopedRows.find(\n    51\t      (candidate) =>\n    52\t        candidate.repositoryFullName === sourceAttachment.repositoryFullName &&\n    53\t        candidate.targetRef === sourceAttachment.targetRef,\n    54\t    );\n    55\t\n    56\t    visibleByShadowKey.set(\n    57\t      buildShadowKey(sourceAttachment),\n    58\t      processScopedSibling ?? sourceAttachment,\n    59\t    );\n    60\t  }\n    61\t\n    62\t  return sortByUpdatedAtDesc([...visibleByShadowKey.values()]);\n    63\t}\n","exit_code":0,"status":"completed"}}
