{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/services/processes/process-start.service.ts | sed -n '1,140p'\"","aggregated_output":"     1\timport type { StartProcessResponse } from '../../../shared/contracts/index.js';\n     2\timport { startProcessResponseSchema } from '../../../shared/contracts/index.js';\n     3\timport { AppError } from '../../errors/app-error.js';\n     4\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n     5\timport type { ProcessLiveHub } from './live/process-live-hub.js';\n     6\timport type { PlatformStore } from '../projects/platform-store.js';\n     7\timport { buildProcessSurfaceSummaryWithReviewability } from './process-work-surface.service.js';\n     8\timport type { ProcessAccessService } from './process-access.service.js';\n     9\timport { planHydrationWorkingSet } from './environment/hydration-planner.js';\n    10\timport type { ProcessEnvironmentService } from './environment/process-environment.service.js';\n    11\timport { resolveActiveProcessSourceAttachments } from './active-process-sources.js';\n    12\t\n    13\texport class ProcessStartService {\n    14\t  constructor(\n    15\t    private readonly platformStore: PlatformStore,\n    16\t    private readonly processAccessService: ProcessAccessService,\n    17\t    private readonly processLiveHub: ProcessLiveHub,\n    18\t    private readonly processEnvironmentService?: ProcessEnvironmentService,\n    19\t    private readonly defaultEnvironmentProviderKind: 'daytona' | 'local' = 'daytona',\n    20\t  ) {}\n    21\t\n    22\t  async start(args: {\n    23\t    actor: AuthenticatedActor;\n    24\t    projectId: string;\n    25\t    processId: string;\n    26\t  }): Promise<StartProcessResponse> {\n    27\t    const access = await this.processAccessService.assertProcessAccess(args);\n    28\t\n    29\t    if (access.process.status !== 'draft') {\n    30\t      throw new AppError({\n    31\t        code: 'PROCESS_ACTION_NOT_AVAILABLE',\n    32\t        message: 'Start is not available for this process right now.',\n    33\t        statusCode: 409,\n    34\t      });\n    35\t    }\n    36\t\n    37\t    const result = await this.platformStore.startProcess({\n    38\t      processId: access.process.processId,\n    39\t    });\n    40\t    const persistedProviderKind = await this.platformStore.getProcessEnvironmentProviderKind({\n    41\t      processId: access.process.processId,\n    42\t    });\n    43\t    const providerKind = persistedProviderKind ?? this.defaultEnvironmentProviderKind;\n    44\t    const environment = requiresEnvironmentPreparation(result.process.status)\n    45\t      ? await this.platformStore.upsertProcessEnvironmentState({\n    46\t          processId: access.process.processId,\n    47\t          providerKind,\n    48\t          state: 'preparing',\n    49\t          environmentId: null,\n    50\t          blockedReason: null,\n    51\t          lastHydratedAt: null,\n    52\t        })\n    53\t      : await this.platformStore.getProcessEnvironmentSummary({\n    54\t          processId: access.process.processId,\n    55\t        });\n    56\t\n    57\t    if (requiresEnvironmentPreparation(result.process.status)) {\n    58\t      const [materialRefs, currentOutputs, sourceAttachments] = await Promise.all([\n    59\t        this.platformStore.getCurrentProcessMaterialRefs({\n    60\t          processId: access.process.processId,\n    61\t        }),\n    62\t        this.platformStore.listProcessOutputs({\n    63\t          processId: access.process.processId,\n    64\t        }),\n    65\t        this.platformStore.listProjectSourceAttachments({\n    66\t          projectId: access.project.projectId,\n    67\t        }),\n    68\t      ]);\n    69\t      await this.platformStore.setProcessHydrationPlan({\n    70\t        processId: access.process.processId,\n    71\t        providerKind,\n    72\t        plan: planHydrationWorkingSet({\n    73\t          artifactIds: materialRefs.artifactIds,\n    74\t          sourceAttachmentIds: resolveActiveProcessSourceAttachments({\n    75\t            sourceAttachments,\n    76\t            processId: access.process.processId,\n    77\t            currentSourceAttachmentIds: materialRefs.sourceAttachmentIds,\n    78\t          }).map((sourceAttachment) => sourceAttachment.sourceAttachmentId),\n    79\t          outputIds: currentOutputs.map((o) => o.outputId),\n    80\t        }),\n    81\t      });\n    82\t      this.processEnvironmentService?.runHydrationAsync({\n    83\t        projectId: access.project.projectId,\n    84\t        processId: access.process.processId,\n    85\t      });\n    86\t    }\n    87\t\n    88\t    const process = await buildProcessSurfaceSummaryWithReviewability({\n    89\t      platformStore: this.platformStore,\n    90\t      projectId: access.project.projectId,\n    91\t      process: result.process,\n    92\t      environment,\n    93\t    });\n    94\t\n    95\t    this.processLiveHub.publish({\n    96\t      projectId: access.project.projectId,\n    97\t      processId: access.process.processId,\n    98\t      publication: {\n    99\t        messageType: isTerminalProcessStatus(process.status) ? 'complete' : 'upsert',\n   100\t        completedAt: isTerminalProcessStatus(process.status) ? process.updatedAt : null,\n   101\t        process,\n   102\t        currentRequest: result.currentRequest,\n   103\t        environment,\n   104\t      },\n   105\t    });\n   106\t\n   107\t    return startProcessResponseSchema.parse({\n   108\t      process,\n   109\t      currentRequest: result.currentRequest,\n   110\t      environment,\n   111\t    });\n   112\t  }\n   113\t}\n   114\t\n   115\tfunction isTerminalProcessStatus(status: StartProcessResponse['process']['status']): boolean {\n   116\t  return status === 'completed' || status === 'failed' || status === 'interrupted';\n   117\t}\n   118\t\