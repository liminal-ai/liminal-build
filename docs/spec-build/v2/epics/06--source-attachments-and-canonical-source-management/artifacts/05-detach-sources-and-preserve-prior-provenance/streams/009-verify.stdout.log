ngerprint` from the durable\n  1301\t   * env-state row. The adapter sees the same digest the stale-projection path\n  1302\t   * uses, rather than a placeholder or a recomputed server-local hash.\n  1303\t   */\n  1304\t  private async buildAdapterHydrationPlan(args: {\n  1305\t    projectId: string;\n  1306\t    processId: string;\n  1307\t    plan: WorkingSetPlan;\n  1308\t  }): Promise<HydrationPlan> {\n  1309\t    const [artifacts, sources, outputs, fingerprint] = await Promise.all([\n  1310\t      this.platformStore.listProjectArtifacts({ projectId: args.projectId }),\n  1311\t      this.platformStore.listProjectSourceAttachments({ projectId: args.projectId }),\n  1312\t      this.platformStore.listProcessOutputs({ processId: args.processId }),\n  1313\t      this.platformStore.getProcessWorkingSetFingerprint({ processId: args.processId }),\n  1314\t    ]);\n  1315\t\n  1316\t    const artifactById = new Map(artifacts.map((artifact) => [artifact.artifactId, artifact]));\n  1317\t    const sourceById = new Map(sources.map((source) => [source.sourceAttachmentId, source]));\n  1318\t    const outputById = new Map(outputs.map((output) => [output.outputId, output]));\n  1319\t\n  1320\t    if (fingerprint === null) {\n  1321\t      throw new Error(\n  1322\t        `HydrationPlan is missing a persisted workingSetFingerprint for process '${args.processId}'.`,\n  1323\t      );\n  1324\t    }\n  1325\t\n  1326\t    return {\n  1327\t      fingerprint,\n  1328\t      artifactInputs: args.plan.artifactIds.map((artifactId) => {\n  1329\t        const artifact = artifactById.get(artifactId);\n  1330\t        return {\n  1331\t          artifactId,\n  1332\t          displayName: artifact?.displayName ?? artifactId,\n  1333\t          versionLabel: artifact?.currentVersionLabel ?? null,\n  1334\t        };\n  1335\t      }),\n  1336\t      outputInputs: args.plan.outputIds.map((outputId) => {\n  1337\t        const output = outputById.get(outputId);\n  1338\t        return {\n  1339\t          outputId,\n  1340\t          displayName: output?.displayName ?? outputId,\n  1341\t          revisionLabel: output?.revisionLabel ?? null,\n  1342\t        };\n  1343\t      }),\n  1344\t      sourceInputs: args.plan.sourceAttachmentIds.map((sourceAttachmentId) => {\n  1345\t        const source = sourceById.get(sourceAttachmentId);\n  1346\t        if (source === undefined) {\n  1347\t          // A plan referencing a source we can't resolve against the current\n  1348\t          // project-scoped sources is a real breakage — fail loud rather than\n  1349\t          // fabricating a placeholder repositoryUrl that would silently bypass\n  1350\t          // hydration or checkpointing.\n  1351\t          throw new Error(\n  1352\t            `HydrationPlan references sourceAttachmentId '${sourceAttachmentId}' that is not in the project's source listing.`,\n  1353\t          );\n  1354\t        }\n  1355\t        return {\n  1356\t          sourceAttachmentId,\n  1357\t          displayName: source.displayName,\n  1358\t          repositoryUrl: source.repositoryUrl,\n  1359\t          targetRef: source.targetRef,\n  1360\t          accessMode: source.accessMode,\n  1361\t        };\n  1362\t      }),\n  1363\t    };\n  1364\t  }\n  1365\t\n","exit_code":0,"status":"completed"}}
