tifactCheckpointResult,\n   809\t        });\n   810\t        const materials = await this.readMaterials({\n   811\t          projectId: currentProcess.projectId,\n   812\t          processId: args.processId,\n   813\t        });\n   814\t        this.publishEnvironmentUpsert({\n   815\t          projectId: args.projectId,\n   816\t          processId: args.processId,\n   817\t          process: currentProcess,\n   818\t          environment: artifactEnvironment,\n   819\t          materials,\n   820\t        });\n   821\t      }\n   822\t\n   823\t      if (plan.codeTargets.length > 0) {\n   824\t        const codeOutcomes = await Promise.all(\n   825\t          plan.codeTargets.map(async (target) => ({\n   826\t            target,\n   827\t            writeResult: await args.codeCheckpointWriter.writeFor(target),\n   828\t          })),\n   829\t        );\n   830\t        const successfulCodeTargets = codeOutcomes\n   831\t          .filter((outcome) => outcome.writeResult.outcome === 'succeeded')\n   832\t          .map((outcome) => outcome.target);\n   833\t\n   834\t        if (successfulCodeTargets.length > 0) {\n   835\t          await this.sourceProvenanceService?.recordReceivedCodeUpdates({\n   836\t            projectId: currentProcess.projectId,\n   837\t            processId: args.processId,\n   838\t            codeTargets: successfulCodeTargets,\n   839\t          });\n   840\t        }\n   841\t\n   842\t        const firstFailure = codeOutcomes.find(\n   843\t          (outcome) => outcome.writeResult.outcome === 'failed',\n   844\t        );\n   845\t\n   846\t        if (firstFailure !== undefined) {\n   847\t          const failedCodeResult = buildCheckpointResult({\n   848\t            checkpointKind: 'code',\n   849\t            outcome: 'failed',\n   850\t            targetLabel: resolveCheckpointTargetLabel(firstFailure.target, sourceSummariesById),\n   851\t            targetRef: resolveCheckpointTargetRef(firstFailure.target, sourceSummarie