ourceAttachmentIds(\n   467\t  ctx: MutationCtx,\n   468\t  processRecord: Doc<'processes'>,\n   469\t): Promise<Id<'sourceAttachments'>[]> {\n   470\t  switch (processRecord.processType) {\n   471\t    case 'ProductDefinition': {\n   472\t      const state = await ctx.db\n   473\t        .query('processProductDefinitionStates')\n   474\t        .withIndex('by_processId', (query) => query.eq('processId', processRecord._id))\n   475\t        .unique();\n   476\t      return state?.currentSourceAttachmentIds ?? [];\n   477\t    }\n   478\t    case 'FeatureSpecification': {\n   479\t      const state = await ctx.db\n   480\t        .query('processFeatureSpecificationStates')\n   481\t        .withIndex('by_processId', (query) => query.eq('processId', processRecord._id))\n   482\t        .unique();\n   483\t      return state?.currentSourceAttachmentIds ?? [];\n   484\t    }\n   485\t    case 'FeatureImplementation': {\n   486\t      const state = await ctx.db\n   487\t        .query('processFeatureImplementationStates')\n   488\t        .withIndex('by_processId', (query) => query.eq('processId', processRecord._id))\n   489\t        .unique();\n   490\t      return state?.currentSourceAttachmentIds ?? [];\n   491\t    }\n   492\t    default:\n   493\t      return [];\n   494\t  }\n   495\t}\n   496\t\n   497\tasync function writeCurrentProcessSourceAttachmentIds(\n   498\t  ctx: MutationCtx,\n   499\t  processRecord: Doc<'processes'>,\n   500\t  args: {\n   501\t    sourceAttachmentIds: Id<'sourceAttachments'>[];\n   502\t    updatedAt: string;\n   503\t  },\n   504\t): Promise<void> {\n   505\t  switch (processRecord.processType) {\n   506\t    case 'ProductDefinition': {\n   507\t      const state = await ctx.db\n   508\t        .query('processProductDefinitionStates')\n   509\t        .withIndex('by_processId', (query) => query.eq('processId', processRecord._id))\n   510\t        .unique();\n   511\t\n   512\t      if (state === null) {\n   513\t        await ctx.db.