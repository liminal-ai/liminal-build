    };\n    41\t\n    42\texport interface SourceHydrationExecutor {\n    43\t  refreshRecoverableSource(args: {\n    44\t    actor: AuthenticatedActor;\n    45\t    projectId: string;\n    46\t    sourceAttachment: SourceAttachmentSummary;\n    47\t    repository: ResolvedRepository;\n    48\t  }): Promise<SourceHydrationExecutorResult>;\n    49\t}\n    50\t\n    51\texport interface SourceRefreshService {\n    52\t  synchronizeProjectSourceAttachments(args: {\n    53\t    projectId: string;\n    54\t    sourceAttachments: SourceAttachmentSummary[];\n    55\t  }): Promise<SourceAttachmentSummary[]>;\n    56\t  refreshSource(args: {\n    57\t    actor: AuthenticatedActor;\n    58\t    projectId: string;\n    59\t    sourceAttachmentId: string;\n    60\t  }): Promise<RefreshSourceAttachmentResponse>;\n    61\t}\n    62\t\n    63\ttype RuntimeSourceHydrationPlatformStore = Pick<\n    64\t  PlatformStore,\n    65\t  | 'getCurrentProcessMaterialRefs'\n    66\t  | 'getProcessEnvironmentProviderKind'\n    67\t  | 'getProcessEnvironmentSummary'\n    68\t  | 'getProcessWorkingSetFingerprint'\n    69\t  | 'listProcessOutputs'\n    70\t  | 'listProjectArtifacts'\n    71\t  | 'listProjectProcesses'\n    72\t  | 'listProjectSourceAttachments'\n    73\t  | 'setProcessHydrationPlan'\n    74\t  | 'upsertProcessEnvironmentState'\n    75\t>;\n    76\t\n    77\texport class RuntimeSourceHydrationExecutor implements SourceHydrationExecutor {\n    78\t  constructor(\n    79\t    private readonly platformStore: RuntimeSourceHydrationPlatformStore,\n    80\t    private readonly providerAdapterRegistry: ProviderAdapterRegistry,\n    81\t    private readonly defaultEnvironmentProviderKind: 'daytona' | 'local' = 'daytona',\n    82\t  ) {}\n    83\t\n    84\t  async refreshRecoverableSource(args: {\n    85\t    actor: AuthenticatedActor;\n    86\t    projectId: string;\n    87\t    sourceAttachment: SourceAttachmentSummary;\n    88\t    repository: ResolvedRepository;\n    89\t  }): Promise<