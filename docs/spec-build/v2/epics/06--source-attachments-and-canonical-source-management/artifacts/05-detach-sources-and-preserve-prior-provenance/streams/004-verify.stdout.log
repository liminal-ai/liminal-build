rceAttachmentId,\n   316\t      detachedAt,\n   317\t    };\n   318\t  },\n   319\t});\n   320\t\n   321\tasync function buildSourceAttachmentSummary(\n   322\t  ctx: QueryCtx | MutationCtx,\n   323\t  sourceAttachment: Doc<'sourceAttachments'>,\n   324\t) {\n   325\t  const attachedProcess =\n   326\t    sourceAttachment.processId === null\n   327\t      ? null\n   328\t      : await ctx.db.get(sourceAttachment.processId as Id<'processes'>);\n   329\t\n   330\t  return {\n   331\t    sourceAttachmentId: sourceAttachment._id,\n   332\t    provider: sourceAttachment.provider,\n   333\t    displayName: sourceAttachment.displayName,\n   334\t    purpose: sourceAttachment.purpose,\n   335\t    accessMode: sourceAttachment.accessMode,\n   336\t    repositoryUrl: sourceAttachment.repositoryUrl,\n   337\t    repositoryFullName: sourceAttachment.repositoryFullName,\n   338\t    targetRef: sourceAttachment.targetRef,\n   339\t    hydrationState: sourceAttachment.hydrationState,\n   340\t    lastHydratedAt: sourceAttachment.lastHydratedAt,\n   341\t    lastHydratedResolvedRef: sourceAttachment.lastHydratedResolvedRef,\n   342\t    lastObservedRemoteResolvedRef: sourceAttachment.lastObservedRemoteResolvedRef,\n   343\t    freshnessReason: sourceAttachment.freshnessReason,\n   344\t    refreshStatus: sourceAttachment.refreshStatus,\n   345\t    refreshRequestedAt: sourceAttachment.refreshRequestedAt,\n   346\t    attachmentScope: sourceAttachment.processId === null ? 'project' : 'process',\n   347\t    processId: sourceAttachment.processId,\n   348\t    processDisplayLabel: attachedProcess?.displayLabel ?? null,\n   349\t    detachedAt: sourceAttachment.detachedAt,\n   350\t    updatedAt: sourceAttachment.updatedAt,\n   351\t  };\n   352\t}\n   353\t\n   354\tasync function createSourceAttachmentRecord(\n   355\t  ctx: MutationCtx,\n   356\t  args: {\n   357\t    projectId: string;\n   358\t    processId: string | null;\n   359\t    provider: 'github';\n   360\t    displayName: string;\n   361\t    purpose: 'research' | 'review' | 'implementation' | 'other';\n   362\t    accessMode: 'read_only' | 'read_write';\n   363\t    repositoryUrl: string;\n   364\t    repositoryFullName: string;\n   365\t    targetRef: string | null;\n   366\t    now: string;\n   367\t  },\n   368\t): Promise<Id<'sourceAttachments'>> {\n   369\t  await assertNoActiveDuplicate(ctx, {\n   370\t    projectId: args.projectId,\n   371\t    processId: args.processId,\n   372\t    repositoryFullName: args.repositoryFullName,\n   373\t    targetRef: args.targetRef,\n   374\t  });\n   375\t\n   376\t  const sourceAttachmentId = await ctx.db.insert('sourceAttachments', {\n   377\t    projectId: args.projectId,\n   378\t    processId: args.processId,\n   379\t    provider: args.provider,\n   380\t    displayName: args.displayName,\n   381\t    purpose: args.purpose,\n   382\t    accessMode: args.accessMode,\n   383\t    repositoryUrl: args.repositoryUrl,\n   384\t    repositoryFullName: args.repositoryFullName,\n   385\t    targetRef: args.targetRef,\n   386\t    hydrationState: 'not_hydrated',\n   387\t    lastHydratedAt: null,\n   388\t    lastHydratedResolvedRef: null,\n   389\t    lastObservedRemoteResolvedRef: null,\n   390\t    freshnessReason: null,\n   391\t    refreshStatus: 'idle',\n   392\t    refreshRequestedAt: null,\n   393\t    detachedAt: null,\n   394\t    detachedByUserId: null,\n   395\t    updatedAt: args.now,\n   396\t  });\n   397\t\n   398\t  if (args.processId === null) {\n   399\t    await touchProject(ctx, args.projectId as Id<'projects'>, args.now);\n   400\t  } else {\n   401\t    const processRecord = await getProcessRecord(ctx, args.processId);\n   402\t\n   403\t    if (processRecord !== null) {\n   404\t      await touchProcessAndProject(ctx, processRecord, args.now);\n   405\t    }\n   406\t  }\n   407\t\n   408\t  return sourceAttachmentId;\n   409\t}\n   410\t\n   411\tasync function assertNoActiveDuplicate(\n   412\t  ctx: MutationCtx,\n   