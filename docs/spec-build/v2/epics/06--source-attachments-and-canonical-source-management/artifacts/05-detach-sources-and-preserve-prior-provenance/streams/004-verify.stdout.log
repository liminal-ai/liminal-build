n   164\t  }\n   165\t\n   166\t  async rebuild(args: {\n   167\t    actor: AuthenticatedActor;\n   168\t    projectId: string;\n   169\t    processId: string;\n   170\t  }): Promise<RebuildProcessResponse> {\n   171\t    const access = await this.processAccessService.assertProcessAccess(args);\n   172\t    const [existingEnvironment, providerKind] = await Promise.all([\n   173\t      this.platformStore.getProcessEnvironmentSummary({\n   174\t        processId: access.process.processId,\n   175\t      }),\n   176\t      this.getAuthoritativeProviderKind(access.process.processId),\n   177\t    ]);\n   178\t\n   179\t    this.assertRebuildAvailable(existingEnvironment);\n   180\t\n   181\t    const [plan, storeHasMaterials] = await Promise.all([\n   182\t      this.buildHydrationPlan(access.process.processId),\n   183\t      this.platformStore.hasCanonicalRecoveryMaterials({ processId: access.process.processId }),\n   184\t    ]);\n   185\t    if (!hasCanonicalRecoveryMaterials(plan) && !storeHasMaterials) {\n   186\t      throw new AppError({\n   187\t        code: processEnvironmentPrerequisiteMissingErrorCode,\n   188\t        message: 'Required canonical materials are missing for rebuild.',\n   189\t        statusCode: 422,\n   190\t      });\n   191\t    }\n   192\t\n   193\t    await this.platformStore.setProcessHydrationPlan({\n   194\t      processId: access.process.processId,\n   195\t      providerKind,\n   196\t      plan,\n   197\t    });\n   198\t\n   199\t    const rebuildingEnvironmentId = buildRebuildingEnvironmentId(access.process.processId);\n   200\t    const environment = await this.upsertEnvironmentState({\n   201\t      processId: access.process.processId,\n   202\t      providerKind,\n   203\t      state: 'rebuilding',\n   204\t      environmentId: rebuildingEnvironmentId,\n   205\t      blockedReason: 'Rebuild is in progress.',\n   206\t      lastHydratedAt: existingEnvironment.lastHydratedAt,\n   207\t    });\n   208\t    const rebuildHistoryI