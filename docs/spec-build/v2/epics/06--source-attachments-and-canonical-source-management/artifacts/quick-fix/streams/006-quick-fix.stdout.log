wait app.inject({\\\\n   271\\\\t      method: 'GET',\\\\n   272\\\\t      url: `/api/projects/${projectSummary.projectId}/processes/${waitingProcessSummary.processId}`,\\\\n   273\\\\t      cookies: {\\\\n   274\\\\t        [sessionCookieName]: 'valid-session-cookie',\\\\n   275\\\\t      },\\\\n   276\\\\t    });\\\\n   277\\\\t\\\\n   278\\\\t    expect(response.statusCode).toBe(403);\\\\n   279\\\\t    expect(response.json()).toEqual({\\\\n   280\\\\t      code: 'PROJECT_FORBIDDEN',\\\\n   281\\\\t      message: 'You do not have access to this process.',\\\\n   282\\\\t      status: 403,\\\\n   283\\\\t    });\\\\n   284\\\\t\\\\n   285\\\\t    await app.close();\\\\n   286\\\\t  });\\\\n   287\\\\t\\\\n   288\\\\t  it('returns stable section error envelopes without collapsing the whole surface', async () => {\\\\n   289\\\\t    const platformStore = buildPopulatedStore();\\\\n   290\\\\t    const processAccessService = new ProcessAccessService(\\\\n   291\\\\t      platformStore,\\\\n   292\\\\t      new ProjectAccessService(platformStore),\\\\n   293\\\\t    );\\\\n   294\\\\t    const processWorkSurfaceService = new DefaultProcessWorkSurfaceService(\\\\n   295\\\\t      platformStore,\\\\n   296\\\\t      processAccessService,\\\\n   297\\\\t      {\\\\n   298\\\\t        historySectionReader: new ThrowingHistorySectionReader(platformStore),\\\\n   299\\\\t        materialsSectionReader: new ThrowingMaterialsSectionReader(platformStore),\\\\n   300\\\\t        sideWorkSectionReader: new ThrowingSideWorkSectionReader(platformStore),\\\\n   301\\\\t      },\\\\n   302\\\\t    );\\\\n   303\\\\t    const app = await buildApp({\\\\n   304\\\\t      authSessionService: createTestAuthSessionService({\\\\n   305\\\\t        actor: {\\\\n   306\\\\t          userId: 'workos-user-1',\\\\n   307\\\\t          workosUserId: 'workos-user-1',\\\\n   308\\\\t          email: 'lee@example.com',\\\\n   309\\\\t          displayName: 'Lee Moore',\\\\n   310\\\\t        },\\\\