  sourceAttachmentsByProjectId: {\\n+        [ownerProjectSummary.projectId]: [healthySource, failingSource],\\n+      },\\n+    });\\n+    const sourceRefreshService = new DefaultSourceRefreshService(\\n+      platformStore,\\n+      new StubGitHubRepositoryResolver(({ repositoryUrl, targetRef }) => {\\n+        if (repositoryUrl === failingSource.repositoryUrl) {\\n+          throw new Error('GitHub source lookup failed for one attachment.');\\n+        }\\n+\\n+        return {\\n+          kind: 'resolved',\\n+          repositoryUrl,\\n+          repositoryFullName: healthySource.repositoryFullName,\\n+          targetRef,\\n+          targetRefKind: targetRef === null ? 'none' : 'branch',\\n+          defaultBranch: 'main',\\n+          resolvedRef: targetRef === null ? null : 'a'.repeat(40),\\n+        };\\n+      }),\\n+      noOpHydrationExecutor,\\n+    );\\n+    const app = await buildApp({\\n+      authSessionService: createTestAuthSessionService({\\n+        actor: {\\n+          userId: 'workos-user-1',\\n+          workosUserId: 'workos-user-1',\\n+          email: 'lee@example.com',\\n+          displayName: 'Lee Moore',\\n+        },\\n+        reason: null,\\n+      }),\\n+      authUserSyncService: new AuthUserSyncService(platformStore),\\n+      platformStore,\\n+      sourceRefreshService,\\n+    });\\n+\\n+    const response = await app.inject({\\n+      method: 'GET',\\n+      url: `/api/projects/${ownerProjectSummary.projectId}`,\\n+      cookies: {\\n+        [sessionCookieName]: 'valid-session-cookie',\\n+      },\\n+    });\\n+\\n+    expect(response.statusCode).toBe(200);\\n+    expect(response.json().sourceAttachments.status).toBe('ready');\\n+    expect(response.json().sourceAttachments.items).toHaveLength(2);\\n+\\n+    const healthyItem = response\\n+      .json()\\n+      .sourceAttachments.items.find(\\n+        (item: { sourceAttachmentId: string }) =>\\n+          item.sourceAttachmentId === healthySource.sourceAttachmentId,\\n+      );\\n+    const unavailableItem = response\\n+      .json()\\n+      .sourceAttachments.items.find(\\n+        (item: { sourceAttachmentId: string }) =>\\n+          item.sourceAttachmentId === failingSource.sourceAttachmentId,\\n+      );\\n+\\n+    expect(healthyItem).toMatchObject({\\n+      sourceAttachmentId: healthySource.sourceAttachmentId,\\n+      hydrationState: 'hydrated',\\n+      lastHydratedAt: healthySource.lastHydratedAt,\\n+      lastHydratedResolvedRef: healthySource.lastHydratedResolvedRef,\\n+      lastObservedRemoteResolvedRef: healthySource.lastObservedRemoteResolvedRef,\\n+      freshnessReason: healthySource.freshnessReason,\\n+    });\\n+    expect(unavailableItem).toMatchObject({\\n+      sourceAttachmentId: failingSource.sourceAttachmentId,\\n+      hydrationState: 'unavailable',\\n+      lastHydratedAt: null,\\n+      lastHydratedResolvedRef: null,\\n+      lastObservedRemoteResolvedRef: null,\\n+      freshnessReason: null,\\n+    });\\n+    expect(unavailableItem).not.toHaveProperty('refreshStatus');\\n+    expect(unavailableItem).not.toHaveProperty('refreshRequestedAt');\\n+\\n+    await app.close();\\n+  });\\n });\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/streams/006-quick-fix.stdout.log:139:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_75\",\"type\":\"agent_message\",\"text\":\"Unavailable-source redaction now happens at the server read-model seam, so real project-shell and process work-surface payloads keep safe identity/scope fields but stop serializing stale hydration metadata or resolved-ref snapshots for unavailable rows. I added the shared logic in [source-read-models.ts](/Users/leemoore/code/liminal-build/apps/platform/server/services/sources/source-read-models.ts), then wired it into [source-summary.builder.ts](/Users/leemoore/code/liminal-build/apps/platform/server/services/projects/summary/source-summary.builder.ts) and [materials-section.reader.ts](/Users/leemoore/code/liminal-build/apps/platform/server/services/processes/readers/materials-section.reader.ts). Healthy rows still preserve their existing metadata, and the outer section envelopes are unchanged.\\n\\nTC-6.2a is now proven through actual route/read behavior in [projects-api.test.ts](/Users/leemoore/code/liminal-build/tests/service/server/projects-api.test.ts) and [process-work-surface-api.test.ts](/Users/leemoore/code/liminal-build/tests/service/server/process-work-surface-api.test.ts). The mixed project-shell case also now asserts that healthy rows stay intact while the unavailable row is bounded/redacted.\\n\\nVerification passed:\\n- `corepack pnpm vitest run tests/service/server/projects-api.test.ts tests/service/server/process-work-surface-api.test.ts tests/service/server/source-management-api.test.ts tests/service/client/source-management-ui.test.ts`\\n- `corepack pnpm run green-verify`\\n\\nI left the unrelated existing worktree changes untouched.\"}}\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/progress/005-quick-fix.status.json:16:  \"artifactPath\": \"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/005-quick-fix.json\",\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/progress/005-quick-fix.status.json:18:    \"stdoutPath\": \"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/streams/005-quick-fix.stdout.log\",\ndocs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/progress/005-quick-fix.status.json:19:    \"stderrPath\": \"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/quick-fix/streams/005-quick-fi