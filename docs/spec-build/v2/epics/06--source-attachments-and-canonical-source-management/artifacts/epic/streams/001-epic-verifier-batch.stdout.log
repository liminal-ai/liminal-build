ds.\\\"},{\\\"path\\\":\\\"tests/service/server/package-review-api.test.ts\\\",\\\"reason\\\":\\\"Updated server package-review fixtures to include provenance-bearing version summaries.\\\"},{\\\"path\\\":\\\"tests/service/server/nfr.test.ts\\\",\\\"reason\\\":\\\"Updated package-review NFR fixtures to satisfy provenance-bearing artifact review contracts.\\\"},{\\\"path\\\":\\\"tests/service/server/observability.test.ts\\\",\\\"reason\\\":\\\"Updated observed package-review fixtures to satisfy provenance-bearing artifact review contracts.\\\"},{\\\"path\\\":\\\"tests/service/client/artifact-review-panel.test.ts\\\",\\\"reason\\\":\\\"Updated unsupported-version fixture data for required provenance fields.\\\"},{\\\"path\\\":\\\"tests/service/client/artifact-section.test.ts\\\",\\\"reason\\\":\\\"Updated UI assertions for ownership-free project artifact rendering.\\\"},{\\\"path\\\":\\\"tests/integration/platform-shell.test.ts\\\",\\\"reason\\\":\\\"Made the production-shell asset assertion use the active worktree build output path.\\\"}],\\\"tests\\\":{\\\"added\\\":[],\\\"modified\\\":[\\\"tests/service/server/review-foundation-contracts.test.ts\\\",\\\"tests/service/server/review-export-api.test.ts\\\",\\\"tests/service/server/package-review-api.test.ts\\\",\\\"tests/service/server/nfr.test.ts\\\",\\\"tests/service/server/observability.test.ts\\\",\\\"tests/service/client/artifact-review-panel.test.ts\\\",\\\"tests/service/client/artifact-section.test.ts\\\",\\\"tests/integration/platform-shell.test.ts\\\"],\\\"removed\\\":[],\\\"totalAfterStory\\\":552,\\\"deltaFromPriorBaseline\\\":1},\\\"gatesRun\\\":[{\\\"command\\\":\\\"corepack pnpm run green-verify\\\",\\\"result\\\":\\\"pass\\\"},{\\\"command\\\":\\\"corepack pnpm run verify-all\\\",\\\"result\\\":\\\"pass\\\"}],\\\"selfReview\\\":{\\\"passesRun\\\":3,\\\"findingsFixed\\\":[\\\"Removed artifact ownership fields from project-shell artifact summaries and rendering while preserving process-local artifact references.\\\",\\\"Added provenance ids and display labels to review version contracts and patched store/service/test scaffolding to emit them consistently.\\\",\\\"Added durable process package-context tables plus store methods with canonical upsert and idempotent semantics.\\\",\\\"Fixed the production-shell integration assertion to resolve the built asset from the active worktree instead of a hard-coded sibling checkout path.\\\"],\\\"findingsSurfaced\\\":[\\\"Browser-facing package member contracts still carry the legacy `versionId` name as a compatibility shim; later Epic 5 stories still need the full surface rename to `artifactVersionId`.\\\",\\\"Review target schemas still accept legacy `REVIEW_MEMBER_UNAVAILABLE` alongside `PACKAGE_MEMBER_UNAVAILABLE` as a compatibility bridge until downstream package-review callers are fully migrated.\\\"]},\\\"openQuestions\\\":[],\\\"specDeviations\\\":[\\\"Browser-facing package member contracts still expose legacy `versionId`; Story 0 added the durable/package-context `artifactVersionId` vocabulary and deferred the surface rename to avoid wider Story 3/4 regressions.\\\",\\\"Review target schemas still accept legacy `REVIEW_MEMBER_UNAVAILABLE` alongside `PACKAGE_MEMBER_UNAVAILABLE` as a compatibility bridge for existing package review flows.\\\"],\\\"recommendedNextStep\\\":\\\"Implement Story 1 against the new project-scoped artifact summary and package-context foundation.\\\"}\\ntests/service/server/projects-api.test.ts:41:  it('TC-1.2a returns only accessible projects sorted by lastUpdatedAt descending', async () => {\\ntests/service/server/projects-api.test.ts:84:  it('TC-1.2c omits inaccessible projects', async () => {\\ntests/service/server/projects-api.test.ts:149:  it('TC-1.3c blocks direct project access for unauthorized actor', async () => {\\napps/platform/server/app.ts:192:  const processDisplayLabelService = new ProcessDisplayLabelService(platformStore);\\napps/platform/server/app.ts:197:      processDisplayLabelService,\\ntests/service/server/project-shell-bootstrap-api.test.ts:218:  it('returns project artifact summaries without legacy process ownership fields', async () => {\\ntests/service/server/project-shell-bootstrap-api.test.ts:235:            attachmentScope: 'process',\\ntests/service/server/project-shell-bootstrap-api.test.ts:237:            processDisplayLabel: 'Legacy Process #1',\\ntests/service/server/artifact-review-api.test.ts:83:          attachmentScope: 'process',\\ntests/service/server/artifact-review-api.test.ts:85:          processDisplayLabel: processSummary.displayLabel,\\ntests/service/server/artifact-review-api.test.ts:92:          attachmentScope: 'process',\\ntests/service/server/artifact-review-api.test.ts:94:          processDisplayLabel: processSummary.displayLabel,\\ntests/service/server/artifact-review-api.test.ts:445:            attachmentScope: 'process',\\ntests/service/server/artifact-review-api.test.ts:447:            processDisplayLabel: processSummary.displayLabel,\\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/002-self-review-pass-1.json:1:{\\\"resultId\\\":\\\"b9238b32-2bf1-4b5d-8fac-0b2649e3a780\\\",\\\"provider\\\":\\\"codex\\\",\\\"model\\\":\\\"gpt-5.4\\\",\\\"role\\\":\\\"story_self_review_pass\\\",\\\"status\\\":\\\"completed\\\",\\\"sessionId\\\":\\\"019dcb8d-54d4-7882-8bd6-b820edf96e06\\\",\\\"continuation\\\":{\\\"provider\\\":\\\"codex\\\",\\\"sessionId\\\":\\\"019dcb8d-54d4-7882-8bd6-b820edf96e06\\\",\\\"storyId\\\":\\\"00-foundation\\\"},\\\"outcome\\\":\\\"ready-for-verification\\\",\\\"story\\\":{\\\"id\\\":\\\"00-foundation\\\",\\\"title\\\":\\\"Story 0: Foundation\\\"},\\\"passNumber\\\":1,\\\"planSummary\\\":\\\"Aligned Story 0 foundations by slimming project artifact summaries, extending review provenance and error contracts, adding durable process package-context tables/store methods, and refreshing fixtures/tests so the new vocabulary verifies cleanly.\\\