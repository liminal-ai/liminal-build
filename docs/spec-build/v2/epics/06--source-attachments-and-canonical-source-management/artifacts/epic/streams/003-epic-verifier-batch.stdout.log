resolveActiveProcessSourceAttachments({\napps/platform/server/services/processes/environment/process-environment.service.ts:1283:            currentSourceAttachmentIds: materialRefs.sourceAttachmentIds,\napps/platform/server/services/processes/environment/process-environment.service.ts:1525:  codeTargets: Array<{ sourceAttachmentId: string }>;\napps/platform/server/services/processes/environment/process-environment.service.ts:1532:  for (const codeTarget of args.codeTargets) {\n","exit_code":0,"status":"completed"}}
