sionLabel: output.revisionLabel,\n   279\t  }));\n   280\t\n   281\t  const sourceInputs: FingerprintSourceInput[] = [];\n   282\t  for (const sourceAttachmentId of materialRefs.sourceAttachmentIds) {\n   283\t    const source = await ctx.db.get(sourceAttachmentId as Id<'sourceAttachments'>);\n   284\t    if (source === null) {\n   285\t      continue;\n   286\t    }\n   287\t    sourceInputs.push({\n   288\t      sourceAttachmentId: source._id,\n   289\t      targetRef: source.targetRef,\n   290\t      hydrationState: source.hydrationState,\n","exit_code":0,"status":"completed"}}
