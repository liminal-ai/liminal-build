   if (plan.artifactTargets.length > 0) {\n        await this.artifactCheckpointPersistence.persistCheckpointArtifacts({\n          processId: args.processId,\n          artifacts: plan.artifactTargets,\n        });\n","exit_code":0,"status":"completed"}}
