ervice.test.ts:639:    const shadowedProjectSource = await store.createProjectSourceAttachment({\ntests/service/server/source-management-service.test.ts:653:      displayName: 'shared repo process shadow',\ntests/service/server/source-management-service.test.ts:656:      repositoryUrl: shadowedProjectSource.repositoryUrl,\ntests/service/server/source-management-service.test.ts:657:      repositoryFullName: shadowedProjectSource.repositoryFullName,\ntests/service/server/source-management-service.test.ts:658:      targetRef: shadowedProjectSource.targetRef,\ntests/service/server/source-management-service.test.ts:664:        shadowedProjectSource.sourceAttachmentId,\ntests/service/server/source-management-service.test.ts:665:        shadowedProjectSource.sourceAttachmentId,\n","exit_code":0,"status":"completed"}}
