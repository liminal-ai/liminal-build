d_write';\\n   212\\t    repositoryUrl: string;\\n   213\\t    repositoryFullName: string;\\n   214\\t    targetRef: string | null;\\n   215\\t    now: string;\\n   216\\t  },\\n   217\\t): Promise<Id<'sourceAttachments'>> {\\n   218\\t  await assertNoActiveDuplicate(ctx, {\\n   219\\t    projectId: args.projectId,\\n   220\\t    processId: args.processId,\\n   221\\t    repositoryFullName: args.repositoryFullName,\\n   222\\t    targetRef: args.targetRef,\\n   223\\t  });\\n   224\\t\\n   225\\t  const sourceAttachmentId = await ctx.db.insert('sourceAttachments', {\\n   226\\t    projectId: args.projectId,\\n   227\\t    processId: args.processId,\\n   228\\t    provider: args.provider,\\n   229\\t    displayName: args.displayName,\\n   230\\t    purpose: args.purpose,\\n   231\\t    accessMode: args.accessMode,\\n   232\\t    repositoryUrl: args.repositoryUrl,\\n   233\\t    repositoryFullName: args.repositoryFullName,\\n   234\\t    targetRef: args.targetRef,\\n   235\\t    hydrationState: 'not_hydrated',\\n   236\\t    lastHydratedAt: null,\\n   237\\t    lastHydratedResolvedRef: null,\\n   238\\t    lastObservedRemoteResolvedRef: null,\\n   239\\t    freshnessReason: null,\\n   240\\t    refreshStatus: 'idle',\\n   241\\t    refreshRequestedAt: null,\\n   242\\t    detachedAt: null,\\n   243\\t    detachedByUserId: null,\\n   244\\t    updatedAt: args.now,\\n   245\\t  });\\n   246\\t\\n   247\\t  if (args.processId === null) {\\n   248\\t    await touchProject(ctx, args.projectId as Id<'projects'>, args.now);\\n   249\\t  } else {\\n   250\\t    const processRecord = await getProcessRecord(ctx, args.processId);\\n   251\\t\\n   252\\t    if (processRecord !== null) {\\n   253\\t      await touchProcessAndProject(ctx, processRecord, args.now);\\n   254\\t    }\\n   255\\t  }\\n   256\\t\\n   257\\t  return sourceAttachmentId;\\n   258\\t}\\n   259\\t\\n   260\\tasync function assertNoActiveDuplicate(\\n   261\\t  ctx: MutationCtx,\\n   262\\t  args: {\\n   263\\t    projectId: string;\\n   264\\t    processId: string | null;\\n   265\\t    repositoryFullName: string;\\n   266\\t    targetRef: string | null;\\n   267\\t  },\\n   268\\t): Promise<void> {\\n   269\\t  const duplicates = await ctx.db\\n   270\\t    .query('sourceAttachments')\\n   271\\t    .withIndex('by_projectId_processId_repositoryFullName_targetRef', (indexQuery) =>\\n   272\\t      indexQuery\\n   273\\t        .eq('projectId', args.projectId)\\n   274\\t        .eq('processId', args.processId)\\n   275\\t        .eq('repositoryFullName', args.repositoryFullName)\\n   276\\t        .eq('targetRef', args.targetRef),\\n   277\\t    )\\n   278\\t    .take(10);\\n   279\\t\\n   280\\t  if (duplicates.some((attachment) => attachment.detachedAt === null)) {\\n   281\\t    throw new Error('SOURCE_ATTACHMENT_CONFLICT');\\n   282\\t  }\\n   283\\t}\\n   284\\t\\n   285\\tasync function appendCurrentProcessSourceRef(\\n   286\\t  ctx: MutationCtx,\\n   287\\t  args: {\\n   288\\t    processRecord: Doc<'processes'>;\\n   289\\t    sourceAttachmentId: Id<'sourceAttachments'>;\\n   290\\t    updatedAt: string;\\n   291\\t  },\\n   292\\t): Promise<void> {\\n   293\\t  const existingSourceAttachmentIds = await resolveCurrentProcessSourceAttachmentIds(\\n   294\\t    ctx,\\n   295\\t    args.processRecord,\\n   296\\t  );\\n   297\\t  const nextSourceAttachmentIds = dedupeIds([\\n   298\\t    ...existingSourceAttachmentIds,\\n   299\\t    args.sourceAttachmentId,\\n   300\\t  ]);\\n   301\\t\\n   302\\t  await writeCurrentProcessSourceAttachmentIds(ctx, args.processRecord, {\\n   303\\t    sourceAttachmentIds: nextSourceAttachmentIds,\\n   304\\t    updatedAt: args.updatedAt,\\n   305\\t  });\\n   306\\t  await touchProcessAndProject(ctx, args.processRecord, args.updatedAt);\\n   307\\t}\\n   308\\t\\n   309\\tasync function resolveCurrentProcessSourceAttachmentIds(\\n   310\\t  ctx: MutationCtx,\\n   311\\t  processRecord: Doc<'processes'>,\\n   312\\t): Promise<Id<'