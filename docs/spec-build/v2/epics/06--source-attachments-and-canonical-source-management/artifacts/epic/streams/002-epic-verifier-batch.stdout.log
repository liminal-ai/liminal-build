c (ctx: MutationCtx, args) => {\n   141\t    const now = new Date().toISOString();\n   142\t    const processRecord = await getProcessRecord(ctx, args.processId);\n   143\t\n   144\t    if (processRecord === null || processRecord.projectId !== args.projectId) {\n   145\t      throw new Error('Process not found.');\n   146\t    }\n   147\t\n   148\t    const sourceAttachmentId = await createSourceAttachmentRecord(ctx, {\n   149\t      ...args,\n   150\t      processId: args.processId,\n   151\t      now,\n   152\t    });\n   153\t\n   154\t    await appendCurrentProcessSourceRef(ctx, {\n   155\t      processRecord,\n   156\t      sourceAttachmentId: sourceAttachmentId as Id<'sourceAttachments'>,\n   157\t      updatedAt: now,\n   158\t    });\n   159\t\n   160\t    const sourceAttachment = await ctx.db.get(sourceAttachmentId);\n   161\t\n   162\t    if (sourceAttachment === null) {\n   163\t      throw new Error('Source attachment could not be loaded after creation.');\n   164\t    }\n   165\t\n   166\t    return buildSourceAttachmentSummary(ctx, sourceAttachment);\n   167\t  },\n   168\t});\n   169\t\n   170\texport const getProjectSourceAttachmentSummary = query({\n   171\t  args: {\n   172\t    projectId: v.string(),\n   173\t    sourceAttachmentId: v.string(),\n   174\t  },\n   175\t  handler: async (ctx: QueryCtx, args) => {\n   176\t    const sourceAttachment = await getSourceAttachmentRecord(ctx, args.sourceAttachmentId);\n   177\t\n   178\t    if (\n   179\t      sourceAttachment === null ||\n   180\t      sourceAttachment.projectId !== args.projectId ||\n   260\t      await touchProject(ctx, sourceAttachment.projectId as Id<'projects'>, now);\n   261\t    } else {\n   262\t      const processRecord = await getProcessRecord(ctx, sourceAttachment.processId);\n   263\t\n   264\t      if (processRecord !== null) {\n   265\t        await touchProcessAndProject(ctx, processRecord, now);\n   266\t      }\n   267\t    }\n   268\t\n   269\t    const updatedSourceAttachment = await ctx.db.get(sourceAttachment._id);\n   270\t\n   271\t    if (updatedSourceAttachment === null) {\n   272\t      throw new Error('Source attachment could not be loaded after update.');\n   273\t    }\n   274\t\n   275\t    return buildSourceAttachmentSummary(ctx, updatedSourceAttachment);\n   276\t  },\n   277\t});\n   278\t\n   279\texport const detachSourceAttachment = mutation({\n   280\t  args: {\n   281\t    projectId: v.string(),\n   282\t    sourceAttachmentId: v.string(),\n   283\t    detachedByUserId: v.string(),\n   284\t  },\n   285\t  handler: async (ctx: MutationCtx, args) => {\n   286\t    const sourceAttachment = await getSourceAttachmentRecord(ctx, args.sourceAttachmentId);\n   287\t\n   288\t    if (\n   289\t      sourceAttachment === null ||\n   290\t      sourceAttachment.projectId !== args.projectId ||\n   291\t      sourceAttachment.detachedAt !== null\n   292\t    ) {\n   293\t      throw new Error('SOURCE_ATTACHMENT_NOT_FOUND');\n   294\t    }\n   295\t\n   296\t    const detachedAt = new Date().toISOString();\n   297\t    await ctx.db.patch(sourceAttachment._id, {\n   298\t      detachedAt,\n   299\t      detachedByUserId: args.detachedByUserId,\n   300\t      updatedAt: detachedAt,\n   301\t    });\n   302\t\n   303\t    if (sourceAttachment.processId === null) {\n   304\t      await touchProject(ctx, sourceAttachment.projectId as Id<'projects'>, detachedAt);\n   305\t    } else {\n   306\t      const processRecord = await getProcessRecord(ctx, sourceAttachment.processId);\n   307\t\n   308\t      if (processRecord !== null) {\n   309\t        await touchProcessAndProject(ctx, processRecord, detachedAt);\n   310\t      }\n   311\t    }\n   312\t\n   313\t    return {\n   314\t      detached: true as const,\n   315\t      sourceAttachmentId: args.sourceAttachmentId,\n   316\t      detachedAt,\n   317\t    };\n   318\t  },\n   319\t});\n   320\t\n","exit_code":0,"status":"completed"}}
