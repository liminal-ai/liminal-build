{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/services/sources/source-provenance.service.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport {\n     2\t  type ListProcessSourceProvenanceResponse,\n     3\t  listProcessSourceProvenanceResponseSchema,\n     4\t  type SourceAttachmentSummary,\n     5\t  type SourceProvenanceEntry,\n     6\t} from '../../../shared/contracts/index.js';\n     7\timport type { CodeCheckpointTarget } from '../processes/environment/checkpoint-types.js';\n     8\timport type { PlatformStore, StoredSourceProvenanceRecord } from '../projects/platform-store.js';\n     9\t\n    10\ttype SourceProvenancePlatformStore = PlatformStore & {\n    11\t  createSourceProvenance: NonNullable<PlatformStore['createSourceProvenance']>;\n    12\t  listProcessSourceProvenance: NonNullable<PlatformStore['listProcessSourceProvenance']>;\n    13\t};\n    14\t\n    15\texport interface SourceProvenanceService {\n    16\t  recordInformedWorkForCurrentSources(args: {\n    17\t    projectId: string;\n    18\t    processId: string;\n    19\t    eventId?: string | null;\n    20\t  }): Promise<void>;\n    21\t  recordReceivedCodeUpdates(args: {\n    22\t    projectId: string;\n    23\t    processId: string;\n    24\t    codeTargets: CodeCheckpointTarget[];\n    25\t    eventId?: string | null;\n    26\t  }): Promise<void>;\n    27\t  listProcessSourceProvenance(args: {\n    28\t    projectId: string;\n    29\t    processId: string;\n    30\t  }): Promise<ListProcessSourceProvenanceResponse>;\n    31\t}\n    32\t\n    33\texport class DefaultSourceProvenanceService implements SourceProvenanceService {\n    34\t  constructor(private readonly platformStore: SourceProvenancePlatformStore) {}\n    35\t\n    36\t  async recordInformedWorkForCurrentSources(args: {\n    37\t    projectId: string;\n    38\t    processId: string;\n    39\t    eventId?: string | null;\n    40\t  }): Promise<void> {\n    41\t    const [currentMaterialRefs, projectSourceAttachments] = await Promise.all([\n    42\t      this.platformStore.getCurrentProcessMaterialRefs({\n    43\t        processId: args.processId,\n    44\t      }),\n    45\t      this.platformStore.listProjectSourceAttachments({\n    46\t        projectId: args.projectId,\n    47\t      }),\n    48\t    ]);\n    49\t    const sourceAttachmentsById = new Map(\n    50\t      projectSourceAttachments.map((sourceAttachment) => [\n    51\t        sourceAttachment.sourceAttachmentId,\n    52\t        sourceAttachment,\n    53\t      ]),\n    54\t    );\n    55\t\n    56\t    await Promise.all(\n    57\t      Array.from(new Set(currentMaterialRefs.sourceAttachmentIds)).map(\n    58\t        async (sourceAttachmentId) => {\n    59\t          const sourceAttachment = sourceAttachmentsById.get(sourceAttachmentId);\n    60\t\n    61\t          if (sourceAttachment === undefined || sourceAttachment.detachedAt != null) {\n    62\t            return;\n    63\t          }\n    64\t\n    65\t          await this.createProvenanceRecord({\n    66\t            projectId: args.projectId,\n    67\t            processId: args.processId,\n    68\t            sourceAttachment,\n    69\t            relationshipKind: 'informed_work',\n    70\t            eventId: args.eventId ?? null,\n    71\t          });\n    72\t        },\n    73\t      ),\n    74\t    );\n    75\t  }\n    76\t\n    77\t  async recordReceivedCodeUpdates(args: {\n    78\t    projectId: string;\n    79\t    processId: string;\n    80\t    codeTargets: CodeCheckpointTarget[];\n    81\t    eventId?: string | null;\n    82\t  }): Promise<void> {\n    83\t    if (args.codeTargets.length === 0) {\n    84\t      return;\n    85\t    }\n    86\t\n    87\t    const projectSourceAttachments = await this.platformStore.listProjectSourceAttachments({\n    88\t      projectId: args.projectId,\n    89\t    });\n    90\t    const sourceAttachmentsById = new Map(\n    91\t      projectSourceAttachments.map((sourceAttachment) => [\n    92\t        sourceAttachment.sourceAttachmentId,\n    93\t        sourceAttachment,\n    94\t      ]),\n    95\t    );\n    96\t\n    97\t    await Promise.all(\n    98\t      Array.from(new Set(args.codeTargets.map((target) => target.sourceAttachmentId))).map(\n    99\t        async (sourceAttachmentId) => {\n   100\t          const sourceAttachment = sourceAttachmentsById.get(sourceAttachmentId);\n   101\t\n   102\t          if (\n   103\t            sourceAttachment === undefined ||\n   104\t            sourceAttachment.detachedAt != null ||\n   105\t            sourceAttachment.accessMode !== 'read_write'\n   106\t          ) {\n   107\t            return;\n   108\t          }\n   109\t\n   110\t          await this.createProvenanceRecord({\n   111\t            projectId: args.projectId,\n   112\t            processId: args.processId,\n   113\t            sourceAttachment,\n   114\t            relationshipKind: 'received_code_update',\n   115\t            eventId: args.eventId ?? null,\n   116\t          });\n   117\t        },\n   118\t      ),\n   119\t    );\n   120\t  }\n   121\t\n   122\t  async listProcessSourceProvenance(args: {\n   123\t    projectId: string;\n   124\t    processId: string;\n   125\t  }): Promise<ListProcessSourceProvenanceResponse> {\n   126\t    const [records, projectSourceAttachments] = await Promise.all([\n   127\t      this.platformStore.listProcessSourceProvenance({\n   128\t        processId: args.processId,\n   129\t      }),\n   130\t      this.platformStore.listProjectSourceAttachments({\n   131\t        projectId: args.projectId,\n   132\t      }),\n   133\t    ]);\n   134\t    const sourceAttachmentsById = new Map(\n   135\t      projectSourceAttachments.map((sourceAttachment) => [\n   136\t        sourceAttachment.sourceAttachmentId,\n   137\t        sourceAttachment,\n   138\t      ]),\n   139\t    );\n   140\t\n   141\t    return listProcessSourceProvenanceResponseSchema.parse({\n   142\t      entries: records.map((record) =>\n   143\t        this.buildSourceProvenanceEntry(\n   144\t          record,\n   145\t          record.sourceAttachmentId === null\n   146\t            ? null\n   147\t            : (sourceAttachmentsById.get(record.sourceAttachmentId) ?? null),\n   148\t        ),\n   149\t      ),\n   150\t    });\n   151\t  }\n   152\t\n   153\t  private async createProvenanceRecord(args: {\n   154\t    projectId: string;\n   155\t    processId: string;\n   156\t    sourceAttachment: SourceAttachmentSummary;\n   157\t    relationshipKind: SourceProvenanceEntry['relationshipKind'];\n   158\t    eventId: string | null;\n   159\t  }): Promise<void> {\n   160\t    await this.platformStore.createSourceProvenance({\n   161\t      projectId: args.projectId,\n   162\t      processId: args.processId,\n   163\t      sourceAttachmentId: args.sourceAttachment.sourceAttachmentId,\n   164\t      relationshipKind: args.relationshipKind,\n   165\t      repositoryFullName: args.sourceAttachment.repositoryFullName,\n   166\t      repositoryUrl: args.sourceAttachment.repositoryUrl,\n   167\t      targetRef: args.sourceAttachment.targetRef,\n   168\t      eventId: args.eventId,\n   169\t      entryStatus: 'ready',\n   170\t      degradationReason: null,\n   171\t    });\n   172\t  }\n   173\t\n   174\t  private buildSourceProvenanceEntry(\n   175\t    record: StoredSourceProvenanceRecord,\n   176\t    sourceAttachment: SourceAttachmentSummary | null,\n   177\t  ): SourceProvenanceEntry {\n   178\t    if (\n   179\t      record.entryStatus === 'ready' &&\n   180\t      record.degradationReason === null &&\n   181\t      sourceAttachment !== null &&\n   182\t      sourceAttachment.detachedAt == null\n   183\t    ) {\n   184\t      return {\n   185\t        provenanceId: record.provenanceId,\n   186\t        sourceAttachmentId: record.sourceAttachmentId,\n   187\t        relationshipKind: record.relationshipKind,\n   188\t        repositoryFullName: record.repositoryFullName,\n   189\t        repositoryUrl: record.repositoryUrl,\n   190\t        targetRef: record.targetRef,\n   191\t        currentAttachmentDisplayName: sourceAttachment.displayName,\n   192\t        currentAttachmentScope: sourceAttachment.attachmentScope,\n   193\t        currentAttachmentAccessMode: sourceAttachment.accessMode,\n   194\t        currentAttachmentHydrationState: sourceAttachment.hydrationState,\n   195\t        currentAttachmentVisibility: 'available',\n   196\t        entryStatus: record.entryStatus,\n   197\t        degradationReason: record.degradationReason,\n   198\t        recordedAt: record.recordedAt,\n   199\t      };\n   200\t    }\n   201\t\n   202\t    const currentAttachmentVisibility =\n   203\t      record.degradationReason === 'access_revoked'\n   204\t        ? 'redacted'\n   205\t        : sourceAttachment?.detachedAt != null || record.degradationReason === 'source_detached'\n   206\t          ? 'detached'\n   207\t          : 'unavailable';\n   208\t\n   209\t    return {\n   210\t      provenanceId: record.provenanceId,\n   211\t      sourceAttachmentId: record.sourceAttachmentId,\n   212\t      relationshipKind: record.relationshipKind,\n   213\t      repositoryFullName: record.repositoryFullName,\n   214\t      repositoryUrl: record.repositoryUrl,\n   215\t      targetRef: record.targetRef,\n   216\t      currentAttachmentDisplayName: null,\n   217\t      currentAttachmentScope: null,\n   218\t      currentAttachmentAccessMode: null,\n   219\t      currentAttachmentHydrationState: null,\n   220\t      currentAttachmentVisibility,\n   221\t      entryStatus: 'degraded',\n   222\t      degradationReason:\n   223\t        record.degradationReason ??\n   224\t        (currentAttachmentVisibility === 'detached'\n   225\t          ? 'source_detached'\n   226\t          : currentAttachmentVisibility === 'redacted'\n   227\t            ? 'access_revoked'\n   228\t            : 'current_attachment_unavailable'),\n   229\t      recordedAt: record.recordedAt,\n   230\t    };\n   231\t  }\n   232\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/tech-design.md | sed -n '30,120p'\nnl -ba docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/test-plan.md | sed -n '1,200p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/tech-design.md | sed -n '30,120p'\nnl -ba docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/test-plan.md | sed -n '1,200p'\"","aggregated_output":"    30\tonly, leaves archive and derived views to Epic 7, and defers MCP/external-source\n    31\tattachment beyond the Epic 5-7 sequence.\n    32\t\n    33\t| Issue | Spec Location | Resolution | Status |\n    34\t|-------|---------------|------------|--------|\n    35\t| Source identity needs both operational URL and canonical GitHub identity | Data Contracts, AC-1.3, AC-4.x | Design stores `repositoryUrl` for clone/write operations and `repositoryFullName` for uniqueness/provenance. `repositoryFullName` is derived server-side when omitted. | Resolved - clarified |\n    36\t| Refresh cannot always settle synchronously | AC-3.3, Refresh Response | Design returns `refreshStatus: settled | pending | failed`, with pending as operation metadata rather than a fifth hydration state. | Resolved - clarified |\n    37\t| Process-scoped shadowing needs exact read rule | Tech Design Question 7 | Design defines an active-source resolver that combines project-scoped and process-scoped attachments, shadows by `repositoryFullName + targetRef`, and excludes detached rows. | Resolved |\n    38\t| Detach representation needs exact storage shape | Tech Design Question 8 | Design adds soft-detach fields (`detachedAt`, `detachedByUserId`) and active-list filters. | Resolved |\n    39\t| Source provenance storage is deferred by epic | AC-4.x | Design introduces durable `sourceProvenance` records with copied immutable source identity. | Resolved |\n    40\t\n    41\tNo design-time deviation from the PRD or architecture is required. Fastify\n    42\tcontinues to own source-management policy and orchestration; Convex owns durable\n    43\trecords and atomic persistence invariants.\n    44\t\n    45\t## Tech Design Questions Answered\n    46\t\n    47\t| # | Epic Question | Design Answer |\n    48\t|---|---------------|---------------|\n    49\t| 1 | What exact browser interaction model should attach, update, refresh, and detach use without creating a separate source-management app? | Extend the existing project shell and process work surface. Project-scoped actions appear in the project source section; process-scoped actions appear in the process materials/source area. Client calls Fastify JSON APIs and renders settled/pending/degraded responses in-place. No standalone source app or live source subscription is added. |\n    50\t| 2 | What exact durable schema should represent source attachments and provenance visibility? | Extend `sourceAttachments` with `repositoryFullName`, freshness fields, refresh progress fields, and soft-detach fields. Add `sourceProvenance` for process-specific provenance with copied immutable source identity. Artifact ownership remains untouched. |\n    51\t| 3 | What exact conflict rule applies for same repository/target ref across related contexts? | Duplicate key is active `projectId + processId + repositoryFullName + targetRef`. Same identity/ref may exist once at project scope and once at process scope. Process-scoped rows shadow project-scoped rows only for that process's current-source read. |\n    52\t| 4 | What exact refresh/freshness policy maps to the four source states? | The canonical states remain `not_hydrated`, `hydrated`, `stale`, and `unavailable`. Target-ref changes make hydrated rows stale. Refresh returns settled/pending/failed operation metadata; pending is not a fifth hydration state. Branch freshness is checked when the surface reads or refresh is requested, not by background polling. |\n    53\t| 5 | What provenance surface shows informed-work and received-code-update relationships? | Add a process provenance endpoint and client section that reads durable `sourceProvenance` entries. Entries are `informed_work` or `received_code_update`, copy repository identity, and enrich current attachment context independently when available. |\n    54\t| 6 | How should shell/process surfaces stay coherent across project and process scope? | Keep project shell source summaries for project-wide management. Process work surfaces show current sources after active-source resolution, including process-scoped shadowing and applicable project-scoped rows. |\n    55\t| 7 | What exact current-source read algorithm combines scopes and degrades boundedly? | `resolveActiveProcessSources` excludes detached rows, starts from current material refs, pulls in process-scoped siblings when they shadow an active project-scoped source, partitions by scope, shadows by `repositoryFullName + targetRef`, sorts by `updatedAt`, and preserves per-row degraded metadata. |\n    56\t| 8 | What soft-detach representation preserves identity and provenance? | Add `detachedAt` and `detachedByUserId` to source attachments. Active listings filter detached rows, but provenance entries remain durable because they copy identity and may retain nullable `sourceAttachmentId`. |\n    57\t\n    58\t## Context\n    59\t\n    60\tEpic 6 implements the repository-focused half of PRD Feature 5. Earlier epics\n    61\talready made source attachments visible enough for hydration and checkpointing,\n    62\tbut that substrate is not yet a complete management surface. Today, Convex has a\n    63\t`sourceAttachments` table, project shell summaries expose attached sources, and\n    64\tprocess materials can show current source references. Environment hydration and\n    65\tcode checkpointing already use `repositoryUrl` as the operational clone/write\n    66\taddress.\n    67\t\n    68\tThe missing layer is user- and process-facing source management. A user needs to\n    69\tattach a GitHub repository to a project or to one process, classify why it is\n    70\tattached, understand whether it can receive writes, refresh stale or missing\n    71\tworking copies, detach it from current use without erasing history, and later\n    72\tunderstand which sources informed or received process work. Those behaviors\n    73\tcannot be implicit side effects of environment hydration.\n    74\t\n    75\tThe core architecture shapes the design. GitHub remains code truth. The\n    76\tsandboxed filesystem is only a disposable working copy. Fastify is the source\n    77\tmanagement control plane: it validates repository identity, enforces project and\n    78\tprocess access, resolves shadowing rules, coordinates refresh, and records\n    79\tprovenance intent. Convex stores durable source attachment and provenance rows\n    80\tbehind Fastify with validators and indexes that preserve integrity.\n    81\t\n    82\tEpic 6 also establishes contracts that Epic 7 will consume. Source provenance is\n    83\tdurable and process-specific; it copies immutable repository identity at the\n    84\ttime work is informed or code is updated. Archive entries in Epic 7 can link to\n    85\tthose provenance records without asking source attachments to become archive\n    86\ttruth.\n    87\t\n    88\t## System View\n    89\t\n    90\t### Top-Tier Surfaces\n    91\t\n    92\t| Surface | Source | This Epic's Role |\n    93\t|---------|--------|------------------|\n    94\t| Projects | Core architecture | Project-scoped source attachments appear in the project shell and can be managed there |\n    95\t| Processes | Core architecture | Process-scoped attachments, current-source views, and source provenance appear in the process work surface |\n    96\t| Sources | Core architecture | Primary Epic 6 domain; owns repository attachment lifecycle, freshness, detach, and provenance records |\n    97\t| Environments | Core architecture | Hydrates active source attachments and reports freshness/checkpoint effects |\n    98\t| Tool Runtime | Core architecture | Produces source-use and code-update signals through environment execution results |\n    99\t| Archive | Core architecture | Downstream consumer only; Epic 6 provides source provenance that Epic 7 can reference |\n   100\t\n   101\t### Runtime Flow\n   102\t\n   103\t```mermaid\n   104\tflowchart LR\n   105\t    UI[Client project/process UI]\n   106\t    API[Fastify source routes]\n   107\t    SVC[SourceManagementService]\n   108\t    STORE[PlatformStore]\n   109\t    X[(Convex)]\n   110\t    GH[GitHub]\n   111\t    ENV[Environment services]\n   112\t\n   113\t    UI --> API\n   114\t    API --> SVC\n   115\t    SVC --> GH\n   116\t    SVC --> STORE\n   117\t    STORE --> X\n   118\t    ENV --> SVC\n   119\t    ENV --> STORE\n   120\t```\n     1\t# Test Plan: Epic 6 Source Attachments and Canonical Source Management\n     2\t\n     3\t## Purpose\n     4\t\n     5\tThis test plan maps every Epic 6 test condition to planned tests. It follows\n     6\tthe service-mock strategy: test at Fastify route/service, Convex function, and\n     7\tclient rendering boundaries while mocking only external systems such as GitHub,\n     8\tenvironment providers, and configuration.\n     9\t\n    10\tRelated design: `docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/tech-design.md`\n    11\t\n    12\t## Test Strategy\n    13\t\n    14\t### Test Layers\n    15\t\n    16\t| Layer | Files | Purpose |\n    17\t|-------|-------|---------|\n    18\t| Convex service tests | `convex/sourceAttachments.test.ts`, `convex/sourceProvenance.test.ts` | Durable schema/function invariants, duplicate checks, soft detach, provenance persistence |\n    19\t| Fastify service/API tests | `tests/service/server/source-management-api.test.ts`, `tests/service/server/source-management-service.test.ts`, `tests/service/server/process-work-surface-api.test.ts` | Auth/access, routes, request/response contracts, source policy, refresh, degraded states |\n    20\t| Client service tests | `tests/service/client/source-management-ui.test.ts`, `tests/service/client/source-attachment-section.test.ts`, `tests/service/client/process-materials-section.test.ts`, `tests/service/client/source-provenance-section.test.ts` | User-visible source state, controls, provenance, detach, and degraded states |\n    21\t| Existing environment tests | `tests/service/server/process-execution-orchestrator.test.ts`, provider adapter tests | Ensure source hydration/checkpoint consumers still work with expanded source contracts |\n    22\t\n    23\t### Mock Boundaries\n    24\t\n    25\t| Boundary | Mock? | Notes |\n    26\t|----------|-------|-------|\n    27\t| GitHub repository/ref lookup | Yes | Mock `GitHubRepositoryResolver`; no live GitHub calls in service tests |\n    28\t| Environment provider refresh/hydration | Yes | Mock provider/service outcomes for pending, settled, failed |\n    29\t| Convex in Fastify route tests | Existing fake/in-memory PlatformStore pattern | Route tests should exercise Fastify services without live Convex |\n    30\t| Fastify source services in client tests | Mock API layer/fetch only | Do not mock UI components under test |\n    31\t| Internal source policy helpers | No | Exercise through service or route tests |\n    32\t\n    33\t## TC to Test Mapping\n    34\t\n    35\t| TC | Test File | Test Description | Coverage Notes |\n    36\t|----|-----------|------------------|----------------|\n    37\t| TC-1.1a | `tests/service/server/source-management-api.test.ts` | `TC-1.1a creates a project-scoped source attachment` | POST project route returns 201 summary |\n    38\t| TC-1.1b | `tests/service/server/source-management-api.test.ts` | `TC-1.1b creates a process-scoped source attachment and makes it current for that process` | POST process route enforces process access, scope, and current-source mutation |\n    39\t| TC-1.2a | `tests/service/client/source-attachment-section.test.ts` | `TC-1.2a renders new source identity and scope` | Verifies repository identity, target ref, purpose, access mode |\n    40\t| TC-1.3a | `tests/service/server/source-management-api.test.ts` | `TC-1.3a blocks duplicate exact attachment` | Expects `SOURCE_ATTACHMENT_CONFLICT` |\n    41\t| TC-1.3b | `convex/sourceAttachments.test.ts` | `TC-1.3b treats missing target ref as duplicate missing target ref` | Durable duplicate invariant |\n    42\t| TC-1.3c | `tests/service/server/source-management-service.test.ts` | `TC-1.3c allows same repository at project and process scope` | Confirms independent scopes |\n    43\t| TC-1.4a | `tests/service/server/source-management-api.test.ts` | `TC-1.4a rejects invalid repository identity without partial row` | Mock resolver returns invalid; store unchanged |\n    44\t| TC-1.4b | `tests/service/server/source-management-api.test.ts` | `TC-1.4b rejects inaccessible repository without partial row` | Mock resolver returns inaccessible; 503 |\n    45\t| TC-2.1a | `tests/service/client/source-attachment-section.test.ts` | `TC-2.1a displays purpose access mode and target ref` | Project shell and process summary contract |\n    46\t| TC-2.2a | `tests/service/server/source-management-api.test.ts` | `TC-2.2a updates source metadata` | PATCH route returns updated summary |\n    47\t| TC-2.3a | `tests/service/client/process-materials-section.test.ts` | `TC-2.3a identifies read-only source` | Uses visible text and data attribute |\n    48\t| TC-2.3b | `tests/service/client/process-materials-section.test.ts` | `TC-2.3b identifies writable source` | Uses visible text and data attribute |\n    49\t| TC-2.4a | `convex/sourceAttachments.test.ts` | `TC-2.4a target-ref change marks hydrated source stale` | Checks `hydrationState` and `freshnessReason` |\n    50\t| TC-3.1a | `tests/service/client/source-management-ui.test.ts` | `TC-3.1a renders all hydration and freshness states` | Covers four canonical states |\n    51\t| TC-3.2a | `tests/service/client/source-management-ui.test.ts` | `TC-3.2a shows refresh action for stale source` | UI action visible |\n    52\t| TC-3.2b | `tests/service/client/source-management-ui.test.ts` | `TC-3.2b does not offer recovery for unavailable source` | UI action absent |\n    53\t| TC-3.2c | `tests/service/client/source-management-ui.test.ts` | `TC-3.2c shows hydration action for not hydrated source` | UI action visible |\n    54\t| TC-3.3a | `tests/service/server/source-management-api.test.ts` | `TC-3.3a refresh updates one source in place` | Response returns settled source summary |\n    55\t| TC-3.3b | `tests/service/client/source-management-ui.test.ts` | `TC-3.3b shows refresh progress while pending` | Pending state visible without fifth hydration state |\n    56\t| TC-4.1a | `tests/service/server/source-management-api.test.ts` | `TC-4.1a returns informing source provenance` | GET process provenance includes `informed_work` |\n    57\t| TC-4.1b | `tests/service/client/source-provenance-section.test.ts` | `TC-4.1b renders empty provenance state` | Empty state visible |\n    58\t| TC-4.2a | `tests/service/server/source-management-api.test.ts` | `TC-4.2a returns receiving source provenance` | GET process provenance includes `received_code_update` |\n    59\t| TC-4.3a | `tests/service/server/source-management-service.test.ts` | `TC-4.3a read-only source not recorded as write target` | Provenance service rejects/omits invalid write provenance |\n    60\t| TC-4.4a | `tests/service/server/source-management-api.test.ts` | `TC-4.4a degraded provenance entry does not hide healthy entries` | Mixed ready/degraded response |\n    61\t| TC-4.4b | `tests/service/client/source-provenance-section.test.ts` | `TC-4.4b degraded provenance falls back to durable identity` | UI shows copied identity and degraded reason |\n    62\t| TC-5.1a | `tests/service/server/source-management-api.test.ts` | `TC-5.1a detaches project-scoped source` | DELETE returns detached response |\n    63\t| TC-5.1b | `tests/service/server/source-management-api.test.ts` | `TC-5.1b detaches process-scoped source` | DELETE enforces process/project relationship |\n    64\t| TC-5.1c | `tests/service/server/process-execution-orchestrator.test.ts` | `TC-5.1c detach during active process does not rewrite hydrated copy` | Existing environment copy remains; future current-source list updates |\n    65\t| TC-5.2a | `convex/sourceProvenance.test.ts` | `TC-5.2a prior provenance remains after detach` | Provenance still readable after source detached |\n    66\t| TC-5.3a | `tests/service/client/source-management-ui.test.ts` | `TC-5.3a unrelated attachments remain after detach` | UI removes only detached row |\n    67\t| TC-6.1a | `tests/service/server/projects-api.test.ts` | `TC-6.1a reopens project source attachment state` | GET project shell returns source state after reload |\n    68\t| TC-6.1b | `tests/service/server/process-work-surface-api.test.ts` | `TC-6.1b reopens process source attachment state` | GET process work surface returns current sources |\n    69\t| TC-6.2a | `tests/service/client/source-management-ui.test.ts` | `TC-6.2a unavailable source shown safely` | Displays unavailable without unsafe action |\n    70\t| TC-6.2b | `tests/service/server/source-management-api.test.ts` | `TC-6.2b revoked access blocks source management` | 403/503 depending revoked project vs repo access |\n    71\t| TC-6.3a | `tests/service/server/projects-api.test.ts` | `TC-6.3a one failing source does not hide healthy sources` | Section returns healthy rows plus bounded error/degraded row |\n    72\t\n    73\t## Non-TC Decided Tests\n    74\t\n    75\t| Test File | Test Description | Reason |\n    76\t|-----------|------------------|--------|\n    77\t| `tests/service/client/process-live.test.ts` | source schemas accept Epic 6 fields and reject missing required identity/freshness fields | Protects shared contract expansion before route/client work |\n    78\t| `tests/service/server/source-management-service.test.ts` | derives `repositoryFullName` from valid HTTPS GitHub URLs with and without `.git` | Protects identity normalization used by multiple ACs |\n    79\t| `tests/service/server/source-management-service.test.ts` | rejects non-GitHub URLs in the first repository-focused slice | Prevents accidental external-source scope creep |\n    80\t| `tests/service/server/source-management-service.test.ts` | rejects mismatched `repositoryUrl` and provided `repositoryFullName` | Prevents identity spoofing or accidental mismatch |\n    81\t| `tests/service/server/source-management-service.test.ts` | rejects `read_write` sources that target tags or commits | Locks down writable-ref policy |\n    82\t| `tests/service/server/source-management-service.test.ts` | resolves missing `targetRef` on `read_write` to the repository default branch before persistence | Clarifies writable-source default-branch behavior |\n    83\t| `tests/service/server/source-management-service.test.ts` | process-scoped source shadows project-scoped source only for matching process | Critical resolver behavior not covered by one explicit TC |\n    84\t| `convex/sourceAttachments.test.ts` | detached rows are excluded from active listings but still exist durably | Soft-detach invariant |\n    85\t| `tests/service/server/source-management-service.test.ts` | branch-head movement marks a hydrated source stale using durable resolved-ref snapshot fields | Covers moving-branch freshness semantics |\n    86\t| `tests/service/server/source-management-api.test.ts` | request-level refresh errors differ from `refreshStatus: failed` | Clarifies response contract |\n    87\t| `tests/service/server/source-management-api.test.ts` | unavailable or revoked source reads redact current source details while preserving bounded state | Covers AC-6.2 redaction requirement |\n    88\t| `tests/service/client/source-management-ui.test.ts` | pending refresh does not render as a fifth hydration state | Protects canonical four-state model |\n    89\t\n    90\t## Chunk Test Counts\n    91\t\n    92\t| Chunk | TC Tests | Non-TC Tests | Total | Primary Files |\n    93\t|-------|----------|--------------|-------|---------------|\n    94\t| 0 Foundation | 0 | 1 | 1 | contract/schema/fixture tests |\n    95\t| 1 Attach repositories | 8 | 6 | 14 | source-management API/service, Convex |\n    96\t| 2 Manage metadata | 5 | 0 | 5 | source-management API, client sections |\n    97\t| 3 Hydration/freshness | 6 | 3 | 9 | source-management API/UI |\n    98\t| 4 Provenance | 6 | 2 | 8 | source provenance API, Convex, client |\n    99\t| 5 Detach | 5 | 1 | 6 | API, Convex, execution orchestrator, UI |\n   100\t| 6 Reopen/degraded | 5 | 0 | 5 | projects/process work surface API, UI |\n   101\t| **Total** | **35** | **12** | **47** |  |\n   102\t\n   103\tThe TC count is 35 because Epic 6 has 35 named TCs. Non-TC tests cover identity\n   104\tnormalization, external-source scope exclusion, URL/full-name mismatch,\n   105\twritable-ref policy, scope-shadowing, branch-drift freshness, soft-detach\n   106\tinvariants, refresh response semantics, unavailable-source redaction, and\n   107\tcanonical hydration-state protection.\n   108\t\n   109\t## Verification Gates\n   110\t\n   111\t| Phase | Command | Expected Result |\n   112\t|-------|---------|-----------------|\n   113\t| Skeleton / Red exit | `pnpm run red-verify` | Format, lint, typecheck, and build pass while new behavior tests fail against stubs |\n   114\t| Development | `pnpm run verify` | Standard project verification passes |\n   115\t| Green exit | `pnpm run green-verify` | All tests pass and no-test-change guard runs |\n   116\t| Story/Epic completion | `pnpm run verify-all` | Full verification, integration, and e2e scaffold pass |\n   117\t\n   118\t## Manual Verification Checklist\n   119\t\n   120\t1. Start Convex with `pnpm run convex:dev`.\n   121\t2. Start app server with `pnpm dev`.\n   122\t3. Open a project shell and attach a GitHub repository at project scope.\n   123\t4. Open a process work surface and attach a process-scoped repository.\n   124\t5. Verify duplicate exact attachments are blocked but project/process scope can coexist.\n   125\t6. Change a target ref and confirm the source becomes stale.\n   126\t7. Trigger refresh and verify settled or pending state is visible.\n   127\t8. Detach one source and verify other sources remain visible.\n   128\t9. Reopen the project and process pages and confirm source/provenance state persists.\n   129\t\n   130\t## Reconciliation\n   131\t\n   132\t- TC tests: 35\n   133\t- Non-TC decided tests: 12\n   134\t- Planned automated tests: 47\n   135\t- Manual verification steps: 9\n","exit_code":0,"status":"completed"}}
