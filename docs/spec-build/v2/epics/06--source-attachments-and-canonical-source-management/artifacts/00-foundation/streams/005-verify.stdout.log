oes not begin after failed preparation', () => {\n   278\t    const baseState = {\n   279\t      ...connectedProcessSurfaceStateFixture,\n   280\t      live: {\n   281\t        connectionState: 'connected' as const,\n   282\t        subscriptionId: 'subscription-001',\n   283\t        lastSequenceNumber: environmentPreparingUpsertLiveFixture.sequenceNumber - 1,\n   284\t        error: null,\n   285\t      },\n   286\t    };\n   287\t\n   288\t    const preparingState = applyLiveProcessMessage({\n   289\t      state: baseState,\n   290\t      message: environmentPreparingUpsertLiveFixture,\n   291\t    });\n   292\t    expect(preparingState.environment?.state).toBe('preparing');\n   293\t\n   294\t    const failedState = applyLiveProcessMessage({\n   295\t      state: preparingState,\n   296\t      message: environmentFailedUpsertLiveFixture,\n   297\t    });\n   298\t    expect(failedState.environment?.state).toBe('failed');\n   299\t    expect(failedState.environment?.state).not.toBe('running');\n   300\t    expect(failedState.environment?.blockedReason).not.toBeNull();\n   301\t  });\n   302\t\n   303\t  it('TC-3.1a / TC-3.3a reducer leaves the environment unchanged until the server pairs it', () => {\n   304\t    const nextState = applyLiveProcessMessage({\n   305\t      state: buildConnectedExecutionState(1),\n   306\t      message: buildLiveProcessMessageFixture({\n   307\t        messageType: 'upsert',\n   308\t        entityType: 'process',\n   309\t        sequenceNumber: 2,\n   310\t        payload: processSurfaceSummarySchema.parse({\n   311\t          ...waitingProcessSurfaceFixture,\n   312\t          processId: runningProcessSurfaceFixture.processId,\n   313\t        }),\n   314\t      }),\n   315\t    });\n   316\t\n   317\t    expect(nextState.process?.status).toBe('waiting');\n   318\t    expect(nextState.environment?.state).toBe('running');\n   319\t  });\n   320\t\n","exit_code":0,"status":"completed"}}
