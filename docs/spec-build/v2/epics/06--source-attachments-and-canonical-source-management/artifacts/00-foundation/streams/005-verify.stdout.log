 146\tfunction applyExecutionFailurePublication(state: ReturnType<typeof buildConnectedExecutionState>) {\n   147\t  const failedEnvironment = buildExecutionFailureEnvironment();\n   148\t  const currentProcess = processSummarySchema.parse({\n   149\t    processId: state.process?.processId ?? runningProcessSurfaceFixture.processId,\n   150\t    displayLabel: state.process?.displayLabel ?? runningProcessSurfaceFixture.displayLabel,\n   151\t    processType: state.process?.processType ?? runningProcessSurfaceFixture.processType,\n   152\t    status: state.process?.status ?? runningProcessSurfaceFixture.status,\n   153\t    phaseLabel: state.process?.phaseLabel ?? runningProcessSurfaceFixture.phaseLabel,\n   154\t    nextActionLabel: state.process?.nextActionLabel ?? runningProcessSurfaceFixture.nextActionLabel,\n   155\t    availableActions: ['review'],\n   156\t    hasEnvironment: state.process?.hasEnvironment ?? runningProcessSurfaceFixture.hasEnvironment,\n   157\t    updatedAt: state.process?.updatedAt ?? runningProcessSurfaceFixture.updatedAt,\n   158\t  });\n   159\t  const processMessage = buildLiveProcessMessageFixture({\n   160\t    messageType: 'upsert',\n   161\t    entityType: 'process',\n   162\t    processId: state.processId ?? runningProcessSurfaceFixture.processId,\n   163\t    sequenceNumber: (state.live.lastSequenceNumber ?? 0) + 1,\n   164\t    payload: buildProcessSurfaceSummary(currentProcess, failedEnvironment),\n   165\t  });\n   166\t  const stateWithProcess = applyLiveProcessMessage({\n   167\t    state,\n   168\t    message: processMessage,\n   169\t  });\n   170\t  const environmentMessage = buildLiveProcessMessageFixture({\n   171\t    messageType: 'upsert',\n   172\t    entityType: 'environment',\n   173\t    processId: stateWithProcess.processId ?? runningProcessSurfaceFixture.processId,\n   174\t    sequenceNumber: (state.live.lastSequenceNumber ?? 0) + 2,\n   175\t    payload: failedEnvironment,\n   176\t  });\n   177\t\n   178\t  retur