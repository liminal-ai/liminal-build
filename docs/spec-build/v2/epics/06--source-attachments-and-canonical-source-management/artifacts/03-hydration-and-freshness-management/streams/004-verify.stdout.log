nst processSectionEnvelopeSchema = makeShellSectionEnvelopeSchema(\n  processSummarySchema,\n).superRefine((value, context) => {\n  if (value.status === 'error' && value.error !== undefined) {\n","exit_code":0,"status":"completed"}}
