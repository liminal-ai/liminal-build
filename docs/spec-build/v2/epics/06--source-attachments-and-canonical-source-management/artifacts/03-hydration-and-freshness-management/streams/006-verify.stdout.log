fresh source';\n    49\t  }\n    50\t\n    51\t  if (sourceAttachment.hydrationState === 'not_hydrated') {\n    52\t    return 'Hydrate source';\n    53\t  }\n    54\t\n    55\t  return null;\n    56\t}\n    57\t\n    58\texport function renderSourceAttachmentSection(args: {\n    59\t  envelope: SourceAttachmentSectionEnvelope | null;\n    60\t  targetDocument: Document;\n    61\t  onAttachSource?: (input: CreateSourceAttachmentRequest) => Promise<void>;\n    62\t  onUpdateSource?: (\n    63\t    sourceAttachmentId: string,\n    64\t    input: UpdateSourceAttachmentRequest,\n    65\t  ) => Promise<void>;\n    66\t  onRefreshSource?: (sourceAttachmentId: string) => Promise<void>;\n    67\t}): HTMLElement {\n    68\t  if (args.envelope === null || args.envelope.status !== 'ready') {\n    69\t    const section = renderSectionEnvelopeState({\n    70\t      title: 'Source attachments',\n    71\t      envelope: args.envelope,\n    72\t      targetDocument: args.targetDocument,\n    73\t    });\n    74\t\n    75\t    if (args.onAttachSource !== undefined) {\n    76\t      section.append(\n    77\t        renderSourceAttachmentComposer({\n    78\t          title: 'Attach repository',\n    79\t          description: 'Attach a GitHub repository to this project.',\n    80\t          scope: 'project',\n    81\t          submitLabel: 'Attach to project',\n    82\t          targetDocument: args.targetDocument,\n    83\t          onAttachSource: args.onAttachSource,\n    84\t        }),\n    85\t      );\n    86\t    }\n    87\t\n    88\t    return section;\n    89\t  }\n    90\t\n    91\t  const section = createSectionElement({\n    92\t    title: 'Source attachments',\n    93\t    targetDocument: args.targetDocument,\n    94\t  });\n    95\t\n    96\t  if (args.onAttachSource !== undefined) {\n    97\t    section.append(\n    98\t      renderSourceAttachmentComposer({\n    99\t        title: 'Attach repository',\n   100\t        description: 'Attach a GitHub repository to this p