    };\n    41\t\n    42\texport interface SourceHydrationExecutor {\n    43\t  refreshRecoverableSource(args: {\n    44\t    actor: AuthenticatedActor;\n    45\t    projectId: string;\n    46\t    sourceAttachment: SourceAttachmentSummary;\n    47\t    repository: ResolvedRepository;\n    48\t  }): Promise<SourceHydrationExecutorResult>;\n    49\t}\n    50\t\n    51\texport interface SourceRefreshService {\n    52\t  synchronizeProjectSourceAttachments(args: {\n    53\t    projectId: string;\n    54\t    sourceAttachments: SourceAttachmentSummary[];\n    55\t  }): Promise<SourceAttachmentSummary[]>;\n    56\t  refreshSource(args: {\n    57\t    actor: AuthenticatedActor;\n    58\t    projectId: string;\n    59\t    sourceAttachmentId: string;\n    60\t  }): Promise<RefreshSourceAttachmentResponse>;\n    61\t}\n    62\t\n    63\ttype RuntimeSourceHydrationPlatformStore = Pick<\n    64\t  PlatformStore,\n    65\t  | 'getCurrentProcessMaterialRefs'\n    66\t  | 'getProcessEnvironmentProviderKind'\n    67\t  | 'getProcessEnvironmentSummary'\n    68\t  | 'getProcessWorkingSetFingerprint'\n    69\t  | 'listProcessOutputs'\n    70\t  | 'listProjectArtifacts'\n    71\t  | 'listProjectProcesses'\n    72\t  | 'listProjectSourceAttachments'\n    73\t  | 'setProcessHydrationPlan'\n    74\t  | 'upsertProcessEnvironmentState'\n    75\t>;\n    76\t\n    77\texport class RuntimeSourceHydrationExecutor implements SourceHydrationExecutor {\n    78\t  constructor(\n    79\t    private readonly platformStore: RuntimeSourceHydrationPlatformStore,\n    80\t    private readonly providerAdapterRegistry: ProviderAdapterRegistry,\n    81\t    private readonly defaultEnvironmentProviderKind: 'daytona' | 'local' = 'daytona',\n    82\t  ) {}\n    83\t\n    84\t  async refreshRecoverableSource(args: {\n    85\t    actor: AuthenticatedActor;\n    86\t    projectId: string;\n    87\t    sourceAttachment: SourceAttachmentSummary;\n    88\t    repository: ResolvedRepository;\n    89\t  }): Promise<SourceHydrationExecutorResult> {\n    90\t    void args.actor;\n    91\t\n    92\t    const targetProcessId = await this.resolveTargetProcessId(args);\n    93\t\n    94\t    if (targetProcessId === null) {\n    95\t      return {\n    96\t        kind: 'not_available',\n    97\t        message:\n    98\t          'Refresh is not available because no single current process working copy owns this source attachment.',\n    99\t      };\n   100\t    }\n   101\t\n   102\t    const [currentMaterialRefs, currentOutputs, providerKind, existingEnvironment] =\n   103\t      await Promise.all([\n   104\t        this.platformStore.getCurrentProcessMaterialRefs({\n   105\t          processId: targetProcessId,\n   106\t        }),\n   107\t        this.platformStore.listProcessOutputs({\n   108\t          processId: targetProcessId,\n   109\t        }),\n   110\t        this.getProviderKind(targetProcessId),\n   111\t        this.platformStore.getProcessEnvironmentSummary({\n   112\t          processId: targetProcessId,\n   113\t        }),\n   114\t      ]);\n   115\t\n   116\t    if (\n   117\t      !currentMaterialRefs.sourceAttachmentIds.includes(args.sourceAttachment.sourceAttachmentId)\n   118\t    ) {\n   119\t      return {\n   120\t        kind: 'not_available',\n   121\t        message:\n   122\t          'Refresh is not available because the source attachment is not in the target process working set.',\n   123\t      };\n   124\t    }\n   125\t\n   126\t    if (existingEnvironment.state === 'running') {\n   127\t      return {\n   128\t        kind: 'not_available',\n   129\t        message: 'Refresh is unavailable while the environment is actively running.',\n   130\t      };\n   131\t    }\n   132\t\n   133\t    if (\n   134\t      existingEnvironment.state === 'preparing' ||\n   135\t      existingEnvironment.state === 'rehydrating' ||\n   136\t      existingEnvironment.state === 'rebuilding' ||\n   137\t      existingEnvironment.state === 'checkpointing'\n   138\t    ) {\n   139\t      return {\n   140\t        kind: 'pending',\n   141\t        refreshRequestedAt: new Date().toISOString(),\n   142\t      };\n   143\t    }\n   144\t\n   145\t    const plan = planHydrationWorkingSet({\n   146\t      ...currentMaterialRefs,\n   147\t      outputIds: currentOutputs.map((output) => output.outputId),\n   148\t    });\n   149\t    await this.platformStore.setProcessHydrationPlan({\n   150\t      processId: targetProcessId,\n   151\t      providerKind,\n   152\t      plan,\n   153\t    });\n   154\t\n   155\t    const hydrationPlan = await this.buildAdapterHydrationPlan({\n   156\t      projectId: args.projectId,\n   157\t      processId: targetProcessId,\n   158\t      plan,\n   159\t    });\n   160\t    const adapter = this.providerAdapterRegistry.resolve(providerKind);\n   161\t\n   162\t    try {\n   163\t      const hydrationResult =\n   164\t        existingEnvironment.environmentId === null ||\n   165\t        existingEnvironment.state === 'absent' ||\n   166\t        existingEnvironment.state === 'lost' ||\n   167\t        existingEnvironment.state === 'failed' ||\n   168\t        existingEnvironment.state === 'unavailable'\n   169\t          ? await this.runHydrate(adapter, {\n   170\t              processId: targetProcessId,\n   171\t              providerKind,\n   172\t              plan: hydrationPlan,\n   173\t            })\n   174\t          : await this.runRehydrate(adapter, {\n   175\t              environmentId: existingEnvironment.environmentId,\n   176\t              processId: targetProcessId,\n   177\t              providerKind,\n   178\t              plan: hydrationPlan,\n   179\t            });\n   180\t\n   181\t      await this.platformStore.upsertProcessEnvironmentState({\n   182\t        processId: targetProcessId,\n   183\t        providerKind,\n   184\t        state: 'ready',\n   185\t        environmentId: hydrationResult.environmentId,\n   186\t        blockedReason: null,\n   187\t        lastHydratedAt: hydrationResult.hydratedAt,\n   188\t      });\n   189\t\n   190\t      return {\n   191\t        kind: 'settled',\n   192\t        hydratedAt: hydrationResult.hydratedAt,\n   193\t      };\n   194\t    } catch (error) {\n   195\t      const failureState =\n   196\t        error instanceof ProviderLifecycleError ? error.environmentState : 'failed';\n   197\t      const failureReason = error instanceof Error ? error.message : 'Unknown refresh error.';\n   198\t\n   199\t      await this.platformStore.upsertProcessEnvironmentState({\n   200\t        processId: targetProcessId,\n   201\t        providerKind,\n   202\t        state: failureState,\n   203\t        environmentId: existingEnvironment.environmentId,\n   204\t        blockedReason: failureReason,\n   205\t        lastHydratedAt: existingEnvironment.lastHydratedAt,\n   206\t      });\n   207\t\n   208\t      return {\n   209\t        kind: 'failed',\n   210\t        failedAt: new Date().toISOString(),\n   211\t      };\n   212\t    }\n   213\t  }\n   214\t\n   215\t  private async resolveTargetProcessId(args: {\n   216\t    projectId: string;\n   217\t    sourceAttachment: SourceAttachmentSummary;\n   218\t  }): Promise<string | null> {\n   219\t    if (args.sourceAttachment.processId !== null) {\n   220\t      return args.sourceAttachment.processId;\n","exit_code":0,"status":"completed"}}
