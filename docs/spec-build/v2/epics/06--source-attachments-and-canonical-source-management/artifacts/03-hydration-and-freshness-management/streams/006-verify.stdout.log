ttachmentRefreshControl({\n   185\t          sourceAttachment,\n   186\t          targetDocument: args.targetDocument,\n   187\t          onRefreshSource: args.onRefreshSource,\n   188\t        }),\n   189\t      );\n   190\t    }\n   191\t\n   192\t    list.append(item);\n   193\t  }\n   194\t\n   195\t  section.append(list);\n   196\t  return section;\n   197\t}\n   198\t\n   199\tfunction renderSourceAttachmentRefreshControl(args: {\n   200\t  sourceAttachment: SourceAttachmentSummary;\n   201\t  targetDocument: Document;\n   202\t  onRefreshSource: (sourceAttachmentId: string) => Promise<void>;\n   203\t}): HTMLElement {\n   204\t  const container = args.targetDocument.createElement('div');\n   205\t  const refreshLabel = resolveRefreshLabel(args.sourceAttachment);\n   206\t  const status = args.targetDocument.createElement('p');\n   207\t\n   208\t  status.setAttribute(\n   209\t    'data-source-attachment-refresh-status',\n   210\t    args.sourceAttachment.sourceAttachmentId,\n   211\t  );\n   212\t\n   213\t  if (args.sourceAttachment.refreshStatus === 'pending') {\n   214\t    status.textContent = `Refresh in progress since ${args.sourceAttachment.refreshRequestedAt ?? 'just now'}.`;\n   215\t  } else if (args.sourceAttachment.refreshStatus === 'failed') {\n   216\t    status.textContent = 'The last refresh attempt failed.';\n   217\t  }\n   218\t\n   219\t  container.append(status);\n   220\t\n   221\t  if (refreshLabel === null) {\n   222\t    return container;\n   223\t  }\n   224\t\n   225\t  const button = args.targetDocument.createElement('button');\n   226\t  button.type = 'button';\n   227\t  button.textContent = refreshLabel;\n   228\t  button.disabled = args.sourceAttachment.refreshStatus === 'pending';\n   229\t  button.setAttribute(\n   230\t    'data-source-attachment-refresh-submit',\n   231\t    args.sourceAttachment.sourceAttachmentId,\n   232\t  );\n   233\t\n   234\t  button.addEventListener('click', () => {\n   235\t    button.disabled = t