iew = renderSourceAttachmentSection({\n    35\t      envelope: sourceAttachmentSectionEnvelopeSchema.parse({\n    36\t        status: 'ready',\n    37\t        items: [processScopedSourceFixture],\n    38\t      }),\n    39\t      targetDocument: document,\n    40\t    });\n    41\t\n    42\t    expect(view.querySelectorAll('li')).toHaveLength(1);\n    43\t    expect(view.textContent).toContain(\n    44\t      `Attached to ${processScopedSourceFixture.processDisplayLabel}.`,\n    45\t    );\n    46\t  });\n    47\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/client/features/projects/source-attachment-section.ts | sed -n '1,240p'\"","aggregated_output":"     1\timport type { SourceAttachmentSectionEnvelope } from '../../../shared/contracts/index.js';\n     2\timport {\n     3\t  appendSectionMessage,\n     4\t  createSectionElement,\n     5\t  renderSectionEnvelopeState,\n     6\t} from './section-envelope.js';\n     7\t\n     8\tfunction formatHydrationStateLabel(hydrationState: string): string {\n     9\t  return hydrationState.replaceAll('_', ' ');\n    10\t}\n    11\t\n    12\texport function renderSourceAttachmentSection(args: {\n    13\t  envelope: SourceAttachmentSectionEnvelope | null;\n    14\t  targetDocument: Document;\n    15\t}): HTMLElement {\n    16\t  if (args.envelope === null || args.envelope.status !== 'ready') {\n    17\t    return renderSectionEnvelopeState({\n    18\t      title: 'Source attachments',\n    19\t      envelope: args.envelope,\n    20\t      targetDocument: args.targetDocument,\n    21\t    });\n    22\t  }\n    23\t\n    24\t  const section = createSectionElement({\n    25\t    title: 'Source attachments',\n    26\t    targetDocument: args.targetDocument,\n    27\t  });\n    28\t  const list = args.targetDocument.createElement('ul');\n    29\t\n    30\t  if (args.envelope.items.length === 0) {\n    31\t    return appendSectionMessage({\n    32\t      section,\n    33\t      message: 'No source attachments yet.',\n    34\t      targetDocument: args.targetDocument,\n    35\t    });\n    36\t  }\n    37\t\n    38\t  for (const sourceAttachment of args.envelope.items) {\n    39\t    const item = args.targetDocument.createElement('li');\n    40\t    const heading = args.targetDocument.createElement('strong');\n    41\t    const repositoryIdentity = args.targetDocument.createElement('p');\n    42\t    const purpose = args.targetDocument.createElement('p');\n    43\t    const hydration = args.targetDocument.createElement('p');\n    44\t    const scope = args.targetDocument.createElement('p');\n    45\t    const updatedAt = args.targetDocument.createElement('p');\n    46\t\n    47\t    heading.textContent = sourceAttachment.displayName;\n    48\t    repositoryIdentity.textContent = `Repository: ${sourceAttachment.repositoryFullName}`;\n    49\t    purpose.textContent = `Purpose: ${sourceAttachment.purpose}`;\n    50\t    hydration.textContent = `Hydration: ${formatHydrationStateLabel(sourceAttachment.hydrationState)}`;\n    51\t    scope.textContent =\n    52\t      sourceAttachment.attachmentScope === 'project'\n    53\t        ? 'Project-scoped source attachment.'\n    54\t        : `Attached to ${sourceAttachment.processDisplayLabel ?? sourceAttachment.processId ?? 'a process'}.`;\n    55\t    updatedAt.textContent = `Updated: ${sourceAttachment.updatedAt}`;\n    56\t\n    57\t    item.append(heading, repositoryIdentity, purpose, hydration, scope, updatedAt);\n    58\t\n    59\t    if (sourceAttachment.targetRef !== null) {\n    60\t      const targetRef = args.targetDocument.createElement('p');\n    61\t      targetRef.textContent = `Target ref: ${sourceAttachment.targetRef}`;\n    62\t      item.append(targetRef);\n    63\t    }\n    64\t\n    65\t    list.append(item);\n    66\t  }\n    67\t\n    68\t  section.append(list);\n    69\t  return section;\n    70\t}\n","exit_code":0,"status":"completed"}}
