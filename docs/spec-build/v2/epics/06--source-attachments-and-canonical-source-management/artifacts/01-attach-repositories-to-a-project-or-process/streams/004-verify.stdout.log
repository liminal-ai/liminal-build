st title = args.targetDocument.createElement('h2');\n    80\t    const body = args.targetDocument.createElement('p');\n    81\t    title.textContent = 'Process work surface failed to load';\n    82\t    body.textContent = processSurface.error?.message ?? 'The process work surface is unavailable.';\n    83\t    error.append(title, body);\n    84\t    container.append(error);\n    85\t    return container;\n    86\t  }\n    87\t\n    88\t  const activeProject = processSurface.project;\n    89\t  const activeProcess = processSurface.process;\n    90\t\n    91\t  const backButton = args.targetDocument.createElement('button');\n    92\t  backButton.type = 'button';\n    93\t  backButton.textContent = 'Back to project';\n    94\t  backButton.addEventListener('click', () => {\n    95\t    args.onOpenProject(activeProject.projectId);\n    96\t  });\n    97\t\n    98\t  const projectHeading = args.targetDocument.createElement('h2');\n    99\t  const projectRole = args.targetDocument.createElement('p');\n   100\t  const processHeading = args.targetDocument.createElement('h3');\n   101\t  const processMeta = args.targetDocument.createElement('p');\n   102\t  const processPhase = args.targetDocument.createElement('p');\n   103\t\n   104\t  projectHeading.textContent = activeProject.name;\n   105\t  projectRole.textContent = `Role: ${activeProject.role}`;\n   106\t  processHeading.textContent = activeProcess.displayLabel;\n   107\t  processMeta.textContent = `${formatProcessTypeLabel(activeProcess.processType)} • ${formatProcessStatusLabel(activeProcess.status)}`;\n   108\t  processPhase.textContent = `Phase: ${activeProcess.phaseLabel}`;\n   109\t  container.append(\n   110\t    backButton,\n   111\t    projectHeading,\n   112\t    projectRole,\n   113\t    processHeading,\n   114\t    processMeta,\n   115\t    processPhase,\n   116\t  );\n   117\t\n   118\t  if (processSurface.actionError !== null) {\n   119\t    const actionError = args.targetDocument.createElement('p');\n   120\t    actionError.setAttribute('data-process-action-error', 'true');\n   121\t    actionError.setAttribute('role', 'alert');\n   122\t    actionError.textContent = processSurface.actionError.message;\n   123\t    container.append(actionError);\n   124\t  }\n   125\t\n   126\t  if (activeProcess.nextActionLabel !== null) {\n   127\t    const nextAction = args.targetDocument.createElement('p');\n   128\t    nextAction.textContent = `Next action: ${activeProcess.nextActionLabel}`;\n   129\t    container.append(nextAction);\n   130\t  }\n   131\t\n   132\t  container.append(\n   133\t    renderProcessControls({\n   134\t      controls: activeProcess.controls,\n   135\t      targetDocument: args.targetDocument,\n   136\t      onAction: (actionId) => {\n   137\t        switch (actionId) {\n   138\t          case 'start':\n   139\t            args.onStartProcess?.(activeProject.projectId, activeProcess.processId);\n   140\t            return;\n   141\t          case 'resume':\n   142\t            args.onResumeProcess?.(activeProject.projectId, activeProcess.processId);\n   143\t            return;\n   144\t          case 'review':\n   145\t            args.onOpenReview?.(activeProject.projectId, activeProcess.processId);\n   146\t            return;\n   147\t          case 'rehydrate':\n   148\t            args.onRehydrateEnvironment?.(activeProject.projectId, activeProcess.processId);\n   149\t            return;\n   150\t          case 'rebuild':\n   151\t            args.onRebuildEnvironment?.(activeProject.projectId, activeProcess.processId);\n   152\t            return;\n   153\t          case 'respond': {\n   154\t            const responseInput = container.querySelector('[data-process-response-input=\"true\"]');\n   155\t\n   156\t            if (responseInput instanceof args.targetWindow.HTMLTextAreaElement) {\n   157\t              responseInput.focus();\n   158\t            }\n   159\t            return;\n   160\t          }\n   161\t          default:\n   162\t            return;\n   163\t        }\n   164\t      },\n   165\t    }),\n   166\t  );\n   167\t\n   168\t  const liveStatus = renderProcessLiveStatus({\n   169\t    liveState: processSurface.live,\n   170\t    targetDocument: args.targetDocument,\n   171\t    onRetry:\n   172\t      args.onRetryLiveSubscription === undefined\n   173\t        ? undefined\n   174\t        : () => {\n   175\t            args.onRetryLiveSubscription?.(activeProject.projectId, activeProcess.processId);\n   176\t          },\n   177\t  });\n   178\t\n   179\t  if (liveStatus !== null) {\n   180\t    container.append(liveStatus);\n   181\t  }\n   182\t\n   183\t  container.append(\n   184\t    renderProcessEnvironmentPanel({\n   185\t      environment: processSurface.environment,\n   186\t      targetDocument: args.targetDocument,\n   187\t    }),\n   188\t    renderCurrentRequestPanel({\n   189\t      currentRequest: processSurface.currentRequest,\n   190\t      targetDocument: args.targetDocument,\n   191\t    }),\n   192\t  );\n   193\t\n   194\t  if (\n   195\t    activeProcess.availableActions.includes('respond') &&\n   196\t    args.onSubmitProcessResponse !== undefined\n   197\t  ) {\n   198\t    container.append(\n   199\t      renderProcessResponseComposer({\n   200\t        targetDocument: args.targetDocument,\n   201\t        onSubmitResponse: async (message: string) => {\n   202\t          args.onSubmitProcessResponse?.(activeProject.projectId, activeProcess.processId, message);\n   203\t        },\n   204\t      }),\n   205\t    );\n   206\t  }\n   207\t\n   208\t  container.append(\n   209\t    renderProcessHistorySection({\n   210\t      envelope: processSurface.history,\n   211\t      targetDocument: args.targetDocument,\n   212\t    }),\n   213\t    renderProcessMaterialsSection({\n   214\t      envelope: processSurface.materials,\n   215\t      targetDocument: args.targetDocument,\n   216\t    }),\n   217\t    renderSideWorkSection({\n   218\t      envelope: processSurface.sideWork,\n   219\t      targetDocument: args.targetDocument,\n   220\t    }),\n   221\t  );\n   222\t\n   223\t  return container;\n   224\t}\n","exit_code":0,"status":"completed"}}
