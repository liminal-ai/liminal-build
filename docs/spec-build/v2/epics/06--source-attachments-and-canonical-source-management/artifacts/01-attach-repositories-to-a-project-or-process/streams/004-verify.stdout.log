{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/routes/source-management.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport type { FastifyInstance } from 'fastify';\n     2\timport type { ZodTypeProvider } from 'fastify-type-provider-zod';\n     3\timport type { RequestError } from '../../shared/contracts/index.js';\n     4\timport {\n     5\t  createProcessSourceAttachmentRouteSchema,\n     6\t  createProjectSourceAttachmentRouteSchema,\n     7\t} from '../schemas/source-management.js';\n     8\timport { sessionCookieName } from '../services/auth/auth-session.service.js';\n     9\timport { AppError } from '../errors/app-error.js';\n    10\t\n    11\tfunction buildUnauthenticatedResponse() {\n    12\t  return {\n    13\t    code: 'UNAUTHENTICATED' as const,\n    14\t    message: 'Authenticated access is required.',\n    15\t    status: 401 as const,\n    16\t  };\n    17\t}\n    18\t\n    19\tfunction buildRequestError(error: AppError, statusCode: 403 | 404 | 409 | 422 | 503): RequestError {\n    20\t  return {\n    21\t    code: error.code as RequestError['code'],\n    22\t    message: error.message,\n    23\t    status: statusCode,\n    24\t  };\n    25\t}\n    26\t\n    27\texport async function registerSourceManagementRoutes(app: FastifyInstance): Promise<void> {\n    28\t  const typedApp = app.withTypeProvider<ZodTypeProvider>();\n    29\t\n    30\t  typedApp.post(\n    31\t    '/api/projects/:projectId/source-attachments',\n    32\t    { schema: createProjectSourceAttachmentRouteSchema },\n    33\t    async (request, reply) => {\n    34\t      if (request.actor === null) {\n    35\t        if (request.authFailureReason === 'invalid_session') {\n    36\t          reply.clearCookie(sessionCookieName, { path: '/' });\n    37\t        }\n    38\t\n    39\t        return reply.code(401).send(buildUnauthenticatedResponse());\n    40\t      }\n    41\t\n    42\t      const access = await app.projectAccessService.getProjectAccess({\n    43\t        actor: request.actor,\n    44\t        projectId: request.params.projectId,\n    45\t      });\n    46\t\n    47\t      if (access.kind === 'forbidden') {\n    48\t        return reply.code(403).send({\n    49\t          code: 'PROJECT_FORBIDDEN',\n    50\t          message: 'The current actor cannot access this project.',\n    51\t          status: 403,\n    52\t        });\n    53\t      }\n    54\t\n    55\t      if (access.kind === 'not_found') {\n    56\t        return reply.code(404).send({\n    57\t          code: 'PROJECT_NOT_FOUND',\n    58\t          message: 'The requested project was not found.',\n    59\t          status: 404,\n    60\t        });\n    61\t      }\n    62\t\n    63\t      try {\n    64\t        const attachment = await app.sourceManagementService.attachProjectSource({\n    65\t          actor: request.actor,\n    66\t          projectId: request.params.projectId,\n    67\t          input: request.body,\n    68\t        });\n    69\t\n    70\t        return reply.code(201).send(attachment);\n    71\t      } catch (error) {\n    72\t        if (error instanceof AppError) {\n    73\t          const statusCode = error.statusCode as 403 | 404 | 409 | 422 | 503;\n    74\t          return reply.code(statusCode).send(buildRequestError(error, statusCode));\n    75\t        }\n    76\t\n    77\t        throw error;\n    78\t      }\n    79\t    },\n    80\t  );\n    81\t\n    82\t  typedApp.post(\n    83\t    '/api/projects/:projectId/processes/:processId/source-attachments',\n    84\t    { schema: createProcessSourceAttachmentRouteSchema },\n    85\t    async (request, reply) => {\n    86\t      if (request.actor === null) {\n    87\t        if (request.authFailureReason === 'invalid_session') {\n    88\t          reply.clearCookie(sessionCookieName, { path: '/' });\n    89\t        }\n    90\t\n    91\t        return reply.code(401).send(buildUnauthenticatedResponse());\n    92\t      }\n    93\t\n    94\t      const access = await app.processAccessService.getProcessAccess({\n    95\t        actor: request.actor,\n    96\t        projectId: request.params.projectId,\n    97\t        processId: request.params.processId,\n    98\t      });\n    99\t\n   100\t      if (access.kind === 'forbidden') {\n   101\t        return reply.code(403).send({\n   102\t          code: 'PROCESS_FORBIDDEN',\n   103\t          message: 'The current actor cannot access this process.',\n   104\t          status: 403,\n   105\t        });\n   106\t      }\n   107\t\n   108\t      if (access.kind === 'project_not_found') {\n   109\t        return reply.code(404).send({\n   110\t          code: 'PROJECT_NOT_FOUND',\n   111\t          message: 'The requested project was not found.',\n   112\t          status: 404,\n   113\t        });\n   114\t      }\n   115\t\n   116\t      if (access.kind === 'process_not_found') {\n   117\t        return reply.code(404).send({\n   118\t          code: 'PROCESS_NOT_FOUND',\n   119\t          message: 'The requested process could not be found.',\n   120\t          status: 404,\n   121\t        });\n   122\t      }\n   123\t\n   124\t      try {\n   125\t        const attachment = await app.sourceManagementService.attachProcessSource({\n   126\t          actor: request.actor,\n   127\t          projectId: request.params.projectId,\n   128\t          processId: request.params.processId,\n   129\t          input: request.body,\n   130\t        });\n   131\t\n   132\t        return reply.code(201).send(attachment);\n   133\t      } catch (error) {\n   134\t        if (error instanceof AppError) {\n   135\t          const statusCode = error.statusCode as 403 | 404 | 409 | 422 | 503;\n   136\t          return reply.code(statusCode).send(buildRequestError(error, statusCode));\n   137\t        }\n   138\t\n   139\t        throw error;\n   140\t      }\n   141\t    },\n   142\t  );\n   143\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/services/sources/source-identity.service.ts | sed -n '1,220p'\"","aggregated_output":"     1\texport interface ParsedGitHubRepositoryIdentity {\n     2\t  repositoryUrl: string;\n     3\t  repositoryFullName: string;\n     4\t}\n     5\t\n     6\tfunction trimTrailingSlash(value: string): string {\n     7\t  return value.endsWith('/') ? value.slice(0, -1) : value;\n     8\t}\n     9\t\n    10\tfunction stripDotGitSegment(value: string): string {\n    11\t  return value.endsWith('.git') ? value.slice(0, -'.git'.length) : value;\n    12\t}\n    13\t\n    14\texport class SourceIdentityService {\n    15\t  normalizeRepositoryFullName(repositoryFullName: string): string {\n    16\t    return repositoryFullName.trim().toLowerCase();\n    17\t  }\n    18\t\n    19\t  normalizeTargetRef(targetRef: string | null | undefined): string | null {\n    20\t    if (targetRef === null || targetRef === undefined) {\n    21\t      return null;\n    22\t    }\n    23\t\n    24\t    const normalized = targetRef.trim();\n    25\t    return normalized.length > 0 ? normalized : null;\n    26\t  }\n    27\t\n    28\t  parseGitHubRepositoryUrl(repositoryUrl: string): ParsedGitHubRepositoryIdentity | null {\n    29\t    const trimmedUrl = repositoryUrl.trim();\n    30\t\n    31\t    let parsedUrl: URL;\n    32\t    try {\n    33\t      parsedUrl = new URL(trimmedUrl);\n    34\t    } catch {\n    35\t      return null;\n    36\t    }\n    37\t\n    38\t    if (parsedUrl.protocol !== 'https:' || parsedUrl.hostname !== 'github.com') {\n    39\t      return null;\n    40\t    }\n    41\t\n    42\t    const pathSegments = parsedUrl.pathname\n    43\t      .split('/')\n    44\t      .map((segment) => segment.trim())\n    45\t      .filter((segment) => segment.length > 0);\n    46\t\n    47\t    if (pathSegments.length !== 2) {\n    48\t      return null;\n    49\t    }\n    50\t\n    51\t    const owner = pathSegments[0];\n    52\t    const repo = stripDotGitSegment(pathSegments[1] ?? '');\n    53\t\n    54\t    if (owner === undefined || owner.length === 0 || repo.length === 0) {\n    55\t      return null;\n    56\t    }\n    57\t\n    58\t    const canonicalUrl = trimTrailingSlash(`${parsedUrl.protocol}//github.com/${owner}/${repo}`);\n    59\t\n    60\t    return {\n    61\t      repositoryUrl: canonicalUrl,\n    62\t      repositoryFullName: this.normalizeRepositoryFullName(`${owner}/${repo}`),\n    63\t    };\n    64\t  }\n    65\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/services/sources/source-management.service.ts | sed -n '1,320p'\"","aggregated_output":"     1\timport type {\n     2\t  CreateSourceAttachmentRequest,\n     3\t  SourceAttachmentSummary,\n     4\t} from '../../../shared/contracts/index.js';\n     5\timport { AppError } from '../../errors/app-error.js';\n     6\timport type { AuthenticatedActor } from '../auth/auth-session.service.js';\n     7\timport type { CreateSourceAttachmentRecord, PlatformStore } from '../projects/platform-store.js';\n     8\timport type { GitHubRepositoryResolver } from './github-repository-resolver.js';\n     9\timport { SourceIdentityService } from './source-identity.service.js';\n    10\t\n    11\ttype SourceManagementPlatformStore = PlatformStore & {\n    12\t  createProjectSourceAttachment: NonNullable<PlatformStore['createProjectSourceAttachment']>;\n    13\t  createProcessSourceAttachment: NonNullable<PlatformStore['createProcessSourceAttachment']>;\n    14\t};\n    15\t\n    16\texport interface SourceManagementService {\n    17\t  attachProjectSource(args: {\n    18\t    actor: AuthenticatedActor;\n    19\t    projectId: string;\n    20\t    input: CreateSourceAttachmentRequest;\n    21\t  }): Promise<SourceAttachmentSummary>;\n    22\t  attachProcessSource(args: {\n    23\t    actor: AuthenticatedActor;\n    24\t    projectId: string;\n    25\t    processId: string;\n    26\t    input: CreateSourceAttachmentRequest;\n    27\t  }): Promise<SourceAttachmentSummary>;\n    28\t}\n    29\t\n    30\texport class DefaultSourceManagementService implements SourceManagementService {\n    31\t  constructor(\n    32\t    private readonly platformStore: SourceManagementPlatformStore,\n    33\t    private readonly gitHubRepositoryResolver: GitHubRepositoryResolver,\n    34\t    private readonly sourceIdentityService: SourceIdentityService = new SourceIdentityService(),\n    35\t  ) {}\n    36\t\n    37\t  async attachProjectSource(args: {\n    38\t    actor: AuthenticatedActor;\n    39\t    projectId: string;\n    40\t    input: CreateSourceAttachmentRequest;\n    41\t  }): Promise<SourceAttachmentSummary> {\n    42\t    void args.actor;\n    43\t    const sourceRecord = await this.prepareSourceAttachment({\n    44\t      projectId: args.projectId,\n    45\t      processId: null,\n    46\t      input: args.input,\n    47\t    });\n    48\t    return this.persistSourceAttachment(() =>\n    49\t      this.platformStore.createProjectSourceAttachment(sourceRecord),\n    50\t    );\n    51\t  }\n    52\t\n    53\t  async attachProcessSource(args: {\n    54\t    actor: AuthenticatedActor;\n    55\t    projectId: string;\n    56\t    processId: string;\n    57\t    input: CreateSourceAttachmentRequest;\n    58\t  }): Promise<SourceAttachmentSummary> {\n    59\t    void args.actor;\n    60\t    const sourceRecord = await this.prepareSourceAttachment({\n    61\t      projectId: args.projectId,\n    62\t      processId: args.processId,\n    63\t      input: args.input,\n    64\t    });\n    65\t    return this.persistSourceAttachment(() =>\n    66\t      this.platformStore.createProcessSourceAttachment({\n    67\t        ...sourceRecord,\n    68\t        processId: args.processId,\n    69\t      }),\n    70\t    );\n    71\t  }\n    72\t\n    73\t  private async persistSourceAttachment(\n    74\t    operation: () => Promise<SourceAttachmentSummary>,\n    75\t  ): Promise<SourceAttachmentSummary> {\n    76\t    try {\n    77\t      return await operation();\n    78\t    } catch (error) {\n    79\t      if (error instanceof Error && error.message === 'SOURCE_ATTACHMENT_CONFLICT') {\n    80\t        throw new AppError({\n    81\t          code: 'SOURCE_ATTACHMENT_CONFLICT',\n    82\t          message:\n    83\t            'An active source attachment already exists for this repository, scope, and target ref.',\n    84\t          statusCode: 409,\n    85\t        });\n    86\t      }\n    87\t\n    88\t      throw error;\n    89\t    }\n    90\t  }\n    91\t\n    92\t  private async prepareSourceAttachment(args: {\n    93\t    projectId: string;\n    94\t    processId: string | null;\n    95\t    input: CreateSourceAttachmentRequest;\n    96\t  }): Promise<CreateSourceAttachmentRecord> {\n    97\t    if (args.input.provider !== 'github') {\n    98\t      throw new AppError({\n    99\t        code: 'INVALID_SOURCE_ATTACHMENT',\n   100\t        message: 'Only GitHub-backed source attachments are supported in this flow.',\n   101\t        statusCode: 422,\n   102\t      });\n   103\t    }\n   104\t\n   105\t    const parsedIdentity = this.sourceIdentityService.parseGitHubRepositoryUrl(\n   106\t      args.input.repositoryUrl,\n   107\t    );\n   108\t\n   109\t    if (parsedIdentity === null) {\n   110\t      throw new AppError({\n   111\t        code: 'INVALID_SOURCE_ATTACHMENT',\n   112\t        message: 'Repository URL must be an https://github.com/<owner>/<repo> repository URL.',\n   113\t        statusCode: 422,\n   114\t      });\n   115\t    }\n   116\t\n   117\t    const providedRepositoryFullName =\n   118\t      args.input.repositoryFullName === undefined\n   119\t        ? undefined\n   120\t        : this.sourceIdentityService.normalizeRepositoryFullName(args.input.repositoryFullName);\n   121\t\n   122\t    if (\n   123\t      providedRepositoryFullName !== undefined &&\n   124\t      providedRepositoryFullName !== parsedIdentity.repositoryFullName\n   125\t    ) {\n   126\t      throw new AppError({\n   127\t        code: 'INVALID_SOURCE_ATTACHMENT',\n   128\t        message: 'Provided repositoryFullName must match the repositoryUrl identity.',\n   129\t        statusCode: 422,\n   130\t      });\n   131\t    }\n   132\t\n   133\t    const normalizedTargetRef = this.sourceIdentityService.normalizeTargetRef(args.input.targetRef);\n   134\t    const repositoryResolution = await this.gitHubRepositoryResolver.resolveRepository({\n   135\t      repositoryUrl: parsedIdentity.repositoryUrl,\n   136\t      targetRef: normalizedTargetRef,\n   137\t    });\n   138\t\n   139\t    if (repositoryResolution.kind === 'invalid') {\n   140\t      throw new AppError({\n   141\t        code: 'INVALID_SOURCE_ATTACHMENT',\n   142\t        message: repositoryResolution.message,\n   143\t        statusCode: 422,\n   144\t      });\n   145\t    }\n   146\t\n   147\t    if (repositoryResolution.kind === 'inaccessible') {\n   148\t      throw new AppError({\n   149\t        code: 'SOURCE_ATTACHMENT_UNAVAILABLE',\n   150\t        message: repositoryResolution.message,\n   151\t        statusCode: 503,\n   152\t      });\n   153\t    }\n   154\t\n   155\t    const resolvedTargetRef =\n   156\t      args.input.accessMode === 'read_write'\n   157\t        ? (repositoryResolution.targetRef ?? repositoryResolution.defaultBranch)\n   158\t        : repositoryResolution.targetRef;\n   159\t\n   160\t    const resolvedTargetRefKind =\n   161\t      repositoryResolution.targetRef === null && args.input.accessMode === 'read_write'\n   162\t        ? 'branch'\n   163\t        : repositoryResolution.targetRefKind;\n   164\t\n   165\t    if (args.input.accessMode === 'read_write' && resolvedTargetRefKind !== 'branch') {\n   166\t      throw new AppError({\n   167\t        code: 'SOURCE_ATTACHMENT_CONFLICT',\n   168\t        message: 'Writable source attachments must target a branch ref.',\n   169\t        statusCode: 409,\n   170\t      });\n   171\t    }\n   172\t\n   173\t    const existingAttachments = await this.platformStore.listProjectSourceAttachments({\n   174\t      projectId: args.projectId,\n   175\t    });\n   176\t    const isDuplicate = existingAttachments.some(\n   177\t      (attachment) =>\n   178\t        attachment.detachedAt === null &&\n   179\t        attachment.processId === args.processId &&\n   180\t        this.sourceIdentityService.normalizeRepositoryFullName(attachment.repositoryFullName) ===\n   181\t          repositoryResolution.repositoryFullName &&\n   182\t        attachment.targetRef === resolvedTargetRef,\n   183\t    );\n   184\t\n   185\t    if (isDuplicate) {\n   186\t      throw new AppError({\n   187\t        code: 'SOURCE_ATTACHMENT_CONFLICT',\n   188\t        message:\n   189\t          'An active source attachment already exists for this repository, scope, and target ref.',\n   190\t        statusCode: 409,\n   191\t      });\n   192\t    }\n   193\t\n   194\t    return {\n   195\t      projectId: args.projectId,\n   196\t      provider: 'github',\n   197\t      displayName: args.input.displayName.trim(),\n   198\t      purpose: args.input.purpose,\n   199\t      accessMode: args.input.accessMode,\n   200\t      repositoryUrl: repositoryResolution.repositoryUrl,\n   201\t      repositoryFullName: repositoryResolution.repositoryFullName,\n   202\t      targetRef: resolvedTargetRef,\n   203\t    };\n   204\t  }\n   205\t}\n","exit_code":0,"status":"completed"}}
