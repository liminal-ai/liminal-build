atus: 503,\n   350\t    });\n   351\t\n   352\t    expect(\n   353\t      await platformStore.listProjectSourceAttachments({\n   354\t        projectId: projectSummary.projectId,\n   355\t      }),\n   356\t    ).toHaveLength(0);\n   357\t\n   358\t    await app.close();\n   359\t  });\n   360\t});\n","exit_code":0,"status":"completed"}}
