branch-repo',\n   267\t      freshnessReason: 'target_ref_changed',\n   268\t      refreshStatus: 'pending',\n   269\t      refreshRequestedAt: '2026-04-15T12:04:00.000Z',\n   270\t    });\n   271\t  });\n   272\t\n   273\t  it('projects mixed read_only and read_write attachments distinctly', async () => {\n   274\t    const { ctx } = createFakeConvexContext(buildSourceAttachmentsSeed());\n   275\t\n   276\t    const summaries = await listProjectSourceAttachmentSummariesHandler(ctx, {\n   277\t      projectId: 'project-sources-1',\n   278\t    });\n   279\t\n   280\t    const readOnly = summaries.filter((summary) => summary.accessMode === 'read_only');\n   281\t    const readWrite = summaries.filter((summary) => summary.accessMode === 'read_write');\n   282\t\n   283\t    expect(readOnly).toHaveLength(2);\n   284\t    expect(readWrite).toHaveLength(1);\n   285\t    expect(readWrite[0]?.sourceAttachmentId).toBe('source-writable-process-1');\n   286\t  });\n   287\t\n   288\t  it('TC-1.3b treats missing target ref as a duplicate missing target ref', async () => {\n   289\t    const { ctx, db } = createFakeConvexContext(buildSourceAttachmentsSeed());\n   290\t\n   291\t    await createProjectSourceAttachmentHandler(ctx, {\n   292\t      projectId: 'project-sources-1',\n   293\t      provider: 'github',\n   294\t      displayName: 'missing-target-ref',\n   295\t      purpose: 'research',\n   296\t      accessMode: 'read_only',\n   297\t      repositoryUrl: 'https://github.com/liminal-ai/missing-target-ref',\n   298\t      repositoryFullName: 'liminal-ai/missing-target-ref',\n   299\t      targetRef: null,\n   300\t    });\n   301\t\n   302\t    await expect(\n   303\t      createProjectSourceAttachmentHandler(ctx, {\n   304\t        projectId: 'project-sources-1',\n   305\t        provider: 'github',\n   306\t        displayName: 'missing-target-ref duplicate',\n   307\t        purpose: 'research',\n   308\t        accessMode: 'read_only',\n   309\t        repositoryUrl