sitoryResolver {\n    50\t  private readonly client: OctokitRepositoryClient;\n    51\t  private readonly sourceIdentityService: SourceIdentityService;\n    52\t\n    53\t  constructor(options: {\n    54\t    token: string;\n    55\t    client?: OctokitRepositoryClient;\n    56\t    sourceIdentityService?: SourceIdentityService;\n    57\t  }) {\n    58\t    this.sourceIdentityService = options.sourceIdentityService ?? new SourceIdentityService();\n    59\t    this.client =\n    60\t      options.client ??\n    61\t      (new Octokit({ auth: options.token }) as unknown as OctokitRepositoryClient);\n    62\t  }\n    63\t\n    64\t  async resolveRepository(args: {\n    65\t    repositoryUrl: string;\n    66\t    targetRef: string | null;\n    67\t  }): Promise<GitHubRepositoryResolution> {\n    68\t    const parsedIdentity = this.sourceIdentityService.parseGitHubRepositoryUrl(args.repositoryUrl);\n    69\t\n    70\t    if (parsedIdentity === null) {\n    71\t      return {\n    72\t        kind: 'invalid',\n    73\t        message: 'Expected an https://github.com/<owner>/<repo> repository URL.',\n    74\t      };\n    75\t    }\n    76\t\n    77\t    const [owner, repo] = parsedIdentity.repositoryFullName.split('/');\n    78\t\n    79\t    if (owner === undefined || repo === undefined) {\n    80\t      return {\n    81\t        kind: 'invalid',\n    82\t        message: 'Repository URL could not be resolved to a canonical owner/name.',\n    83\t      };\n    84\t    }\n    85\t\n    86\t    let repository: { full_name: string; default_branch: string };\n    87\t    try {\n    88\t      const response = await this.client.repos.get({\n    89\t        owner,\n    90\t        repo,\n    91\t      });\n    92\t      repository = response.data;\n    93\t    } catch (error) {\n    94\t      return {\n    95\t        kind: 'inaccessible',\n    96\t        message: describeRepositoryLookupFailure(error),\n    97\t      };\n    98\t    }\n    99\t\n   100\t    const canonicalFullName = this.sourceIdentityService.normalizeRepositoryFullName(\n   101\t      repository.full_name,\n   102\t    );\n   103\t    const normalizedTargetRef = this.sourceIdentityService.normalizeTargetRef(args.targetRef);\n   104\t\n   105\t    if (normalizedTargetRef === null) {\n   106\t      return {\n   107\t        kind: 'resolved',\n   108\t        repositoryUrl: parsedIdentity.repositoryUrl,\n   109\t        repositoryFullName: canonicalFullName,\n   110\t        targetRef: null,\n   111\t        targetRefKind: 'none',\n   112\t        defaultBranch: repository.default_branch,\n   113\t      };\n   114\t    }\n   115\t\n   116\t    const explicitBranchName = stripPrefix(normalizedTargetRef, 'refs/heads/');\n   117\t    if (explicitBranchName !== null) {\n   118\t      return this.resolveBranchRef({\n   119\t        owner,\n   120\t        repo,\n   121\t        repositoryUrl: parsedIdentity.repositoryUrl,\n   122\t        repositoryFullName: canonicalFullName,\n   123\t        defaultBranch: repository.default_branch,\n   124\t        branchName: explicitBranchName,\n   125\t      });\n   126\t    }\n   127\t\n   128\t    const explicitTagName =\n   129\t      stripPrefix(normalizedTargetRef, 'refs/tags/') ?? stripPrefix(normalizedTargetRef, 'tags/');\n   130\t    if (explicitTagName !== null) {\n   131\t      return this.resolveTagRef({\n   132\t        owner,\n   133\t        repo,\n   134\t        repositoryUrl: parsedIdentity.repositoryUrl,\n   135\t        repositoryFullName: canonicalFullName,\n   136\t        defaultBranch: repository.default_branch,\n   137\t        tagName: explicitTagName,\n   138\t      });\n   139\t    }\n   140\t\n   141\t    const branchResolution = await this.resolveBranchRef({\n   142\t      owner,\n   143\t      repo,\n   144\t      repositoryUrl: parsedIdentity.repositoryUrl,\n   145\t      repositoryFullName: canonicalFullName,\n   146\t      defaultBranch: repository.default_branch,\n   147\t      branchName: normalizedTargetRef,\n   148\t    });\n   149\t    if (branchResolution.kind === 'resolved') {\n   150\t      return branchResolution;\n   151\t    }\n   152\t\n   153\t    const tagResolution = await this.resolveTagRef({\n   154\t      owner,\n   155\t      repo,\n   156\t      repositoryUrl: parsedIdentity.repositoryUrl,\n   157\t      repositoryFullName: canonicalFullName,\n   158\t      defaultBranch: repository.default_branch,\n   159\t      tagName: normalizedTargetRef,\n   160\t    });\n   161\t    if (tagResolution.kind === 'resolved') {\n   162\t      return tagResolution;\n   163\t    }\n   164\t\n   165\t    if (/^[0-9a-f]{7,40}$/i.test(normalizedTargetRef)) {\n   166\t      return this.resolveCommitRef({\n   167\t        owner,\n   168\t        repo,\n   169\t        repositoryUrl: parsedIdentity.repositoryUrl,\n   170\t        repositoryFullName: canonicalFullName,\n   171\t        defaultBranch: repository.default_branch,\n   172\t        commitish: normalizedTargetRef,\n   173\t      });\n   174\t    }\n   175\t\n   176\t    return {\n   177\t      kind: 'inaccessible',\n   178\t      message: `GitHub could not resolve the requested target ref '${normalizedTargetRef}'.`,\n   179\t    };\n   180\t  }\n   181\t\n   182\t  private async resolveBranchRef(args: {\n   183\t    owner: string;\n   184\t    repo: string;\n   185\t    repositoryUrl: string;\n   186\t    repositoryFullName: string;\n   187\t    defaultBranch: string;\n   188\t    branchName: string;\n   189\t  }): Promise<GitHubRepositoryResolution> {\n   190\t    try {\n   191\t      await this.client.repos.getBranch({\n   192\t        owner: args.owner,\n   193\t        repo: args.repo,\n   194\t        branch: args.branchName,\n   195\t      });\n   196\t      return {\n   197\t        kind: 'resolved',\n   198\t        repositoryUrl: args.repositoryUrl,\n   199\t        repositoryFullName: args.repositoryFullName,\n   200\t        targetRef: args.branchName,\n   201\t        targetRefKind: 'branch',\n   202\t        defaultBranch: args.defaultBranch,\n   203\t      };\n   204\t    } catch (error) {\n   205\t      if (readErrorStatus(error) === 404) {\n   206\t        return {\n   207\t          kind: 'inaccessible',\n   208\t          message: `GitHub branch '${args.branchName}' could not be accessed.`,\n   209\t        };\n   210\t      }\n   211\t\n   212\t      return {\n   213\t        kind: 'inaccessible',\n   214\t        message: describeRepositoryLookupFailure(error),\n   215\t      };\n   216\t    }\n   217\t  }\n   218\t\n   219\t  private async resolveTagRef(args: {\n   220\t    owner: string;\n   221\t    repo: string;\n   222\t    repositoryUrl: string;\n   223\t    repositoryFullName: string;\n   224\t    defaultBranch: string;\n   225\t    tagName: string;\n   226\t  }): Promise<GitHubRepositoryResolution> {\n   227\t    try {\n   228\t      await this.client.git.getRef({\n   229\t        owner: args.owner,\n   230\t        repo: args.repo,\n   231\t        ref: `tags/${args.tagName}`,\n   232\t      });\n   233\t      return {\n   234\t        kind: 'resolved',\n   235\t        repositoryUrl: args.repositoryUrl,\n   236\t        repositoryFullName: args.repositoryFullName,\n   237\t        targetRef: args.tagName,\n   238\t        targetRefKind: 'tag',\n   239\t        defaultBranch: args.defaultBranch,\n   240\t      };\n   241\t    } catch (error) {\n   242\t      if (readErrorStatus(error) === 404) {\n   243\t        return {\n   244\t          kind: 'inaccessible',\n   245\t          message: `GitHub tag '${args.tagName}' could not be accessed.`,\n   246\t        };\n   247\t      }\n   248\t\n   249\t      return {\n   250\t        kind: 'inaccessible',\n   251\t        message: describeRepositoryLookupFailure(error),\n   252\t      };\n   253\t    }\n   254\t  }\n   255\t\n   256\t  private async resolveCommitRef(args: {\n   257\t    owner: string;\n   258\t    repo: string;\n   259\t    repositoryUrl: string;\n   260\t    repositoryFullName: string;\n   261\t    defaultBranch: string;\n   262\t    commitish: string;\n   263\t  }): Promise<GitHubRepositoryResolution> {\n   264\t    try {\n   265\t      await this.client.repos.getCommit({\n   266\t        owner: args.owner,\n   267\t        repo: args.repo,\n   268\t        ref: args.commitish,\n   269\t      });\n   270\t      return {\n   271\t        kind: 'resolved',\n   272\t        repositoryUrl: args.repositoryUrl,\n   273\t        repositoryFullName: args.repositoryFullName,\n   274\t        targetRef: args.commitish,\n   275\t        targetRefKind: 'commit',\n   276\t        defaultBranch: args.defaultBranch,\n   277\t      };\n   278\t    } catch (error) {\n   279\t      if (readErrorStatus(error) === 404) {\n   280\t        return {\n   281\t          kind: 'inaccessible',\n   282\t          message: `GitHub commit '${args.commitish}' could not be accessed.`,\n   283\t        };\n   284\t      }\n   285\t\n   286\t      return {\n   287\t        kind: 'inaccessible',\n   288\t        message: describeRepositoryLookupFailure(error),\n   289\t      };\n   290\t    }\n   291\t  }\n   292\t}\n   293\t\n   294\tfunction stripPrefix(value: string, prefix: string): string | null {\n   295\t  if (!value.startsWith(prefix)) {\n   296\t    return null;\n   297\t  }\n   298\t\n   299\t  const stripped = value.slice(prefix.length).trim();\n   300\t  return stripped.length > 0 ? stripped : null;\n   301\t}\n   302\t\n   303\tfunction readErrorStatus(error: unknown): number | null {\n   304\t  if (error !== null && typeof error === 'object' && 'status' in error) {\n   305\t    const status = (error as { status?: unknown }).status;\n   306\t    return typeof status === 'number' ? status : null;\n   307\t  }\n   308\t\n   309\t  return null;\n   310\t}\n   311\t\n   312\tfunction describeRepositoryLookupFailure(error: unknown): string {\n   313\t  const status = readErrorStatus(error);\n   314\t\n   315\t  if (status === 401 || status === 403) {\n   316\t    return 'GitHub rejected repository access with the current credentials.';\n   317\t  }\n   318\t\n   319\t  if (status === 404) {\n   320\t    return 'GitHub could not find the requested repository or ref.';\n   321\t  }\n   322\t\n   323\t  if (error instanceof Error && error.message.length > 0) {\n   324\t    return `GitHub repository validation failed: ${error.message}`;\n   325\t  }\n   326\t\n   327\t  return 'GitHub repository validation failed.';\n   328\t}\n","exit_code":0,"status":"completed"}}
