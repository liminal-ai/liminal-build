       defaultBranch: 'develop',\n   299\t      })),\n   300\t    });\n   301\t\n   302\t    const attachment = await service.attachProjectSource({\n   303\t      actor: {\n   304\t        userId: 'workos-user-1',\n   305\t        workosUserId: 'workos-user-1',\n   306\t        email: 'lee@example.com',\n   307\t        displayName: 'Lee Moore',\n   308\t      },\n   309\t      projectId: projectSummary.projectId,\n   310\t      input: {\n   311\t        provider: 'github',\n   312\t        repositoryUrl: 'https://github.com/liminal-ai/liminal-build',\n   313\t        displayName: 'liminal-build',\n   314\t        purpose: 'implementation',\n   315\t        accessMode: 'read_write',\n   316\t        targetRef: null,\n   317\t      },\n   318\t    });\n   319\t\n   320\t    expect(attachment.targetRef).toBe('develop');\n   321\t  });\n   322\t\n   323\t  it('TC-1.3c allows the same repository at project and process scope', async () => {\n   324\t    const store = buildStore();\n   325\t    const service = buildService({\n   326\t      store,\n   327\t    });\n   328\t\n   329\t    const baseInput: Omit<CreateSourceAttachmentRecord, 'projectId'> & { displayName: string } = {\n   330\t      provider: 'github',\n   331\t      displayName: 'liminal-build',\n   332\t      purpose: 'implementation',\n   333\t      accessMode: 'read_only',\n   334\t      repositoryUrl: 'https://github.com/liminal-ai/liminal-build',\n   335\t      repositoryFullName: 'liminal-ai/liminal-build',\n   336\t      targetRef: 'main',\n   337\t    };\n   338\t\n   339\t    const projectAttachment = await service.attachProjectSource({\n   340\t      actor: {\n   341\t        userId: 'workos-user-1',\n   342\t        workosUserId: 'workos-user-1',\n   343\t        email: 'lee@example.com',\n   344\t        displayName: 'Lee Moore',\n   345\t      },\n   346\t      projectId: projectSummary.projectId,\n   347\t      input: baseInput,\n   348\t    });\n   349\t    const processAttachment = await servic