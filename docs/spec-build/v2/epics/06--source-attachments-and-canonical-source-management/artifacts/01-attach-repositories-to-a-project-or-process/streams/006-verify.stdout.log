id;\n    33\t  onResumeProcess?: (projectId: string, processId: string) => void;\n    34\t  onRehydrateEnvironment?: (projectId: string, processId: string) => void;\n    35\t  onRebuildEnvironment?: (projectId: string, processId: string) => void;\n    36\t  onSubmitProcessResponse?: (projectId: string, processId: string, message: string) => void;\n    37\t  onRetryLiveSubscription?: (projectId: string, processId: string) => void;\n    38\t  onAttachSource?: (\n    39\t    projectId: string,\n    40\t    processId: string,\n    41\t    input: CreateSourceAttachmentRequest,\n    42\t  ) => Promise<void>;\n    43\t}): HTMLElement {\n    44\t  const container = args.targetDocument.createElement('section');\n    45\t  const state = args.store.get();\n    46\t  const processSurface = state.processSurface;\n    47\t\n    48\t  container.setAttribute('data-process-work-surface', 'true');\n    49\t  container.append(\n    50\t    renderShellHeader({\n    51\t      store: args.store,\n    52\t      targetDocument: args.targetDocument,\n    53\t      targetWindow: args.targetWindow,\n    54\t    }),\n    55\t  );\n    56\t\n    57\t  if (processSurface.isLoading) {\n    58\t    const loading = args.targetDocument.createElement('p');\n    59\t    loading.textContent = 'Loading process work surface...';\n    60\t    container.append(loading);\n    61\t    return container;\n    62\t  }\n    63\t\n    64\t  if (processSurface.error?.code === 'PROJECT_FORBIDDEN') {\n    65\t    container.append(renderForbiddenProcessState(args.targetDocument));\n    66\t    return container;\n    67\t  }\n    68\t\n    69\t  if (processSurface.error?.code === 'PROJECT_NOT_FOUND') {\n    70\t    container.append(renderMissingProjectState(args.targetDocument));\n    71\t    return container;\n    72\t  }\n    73\t\n    74\t  if (processSurface.error?.code === 'PROCESS_NOT_FOUND') {\n    75\t    container.append(renderMissingProcessState(args.targetDocument));\n    76\t    return container;\n    77\t  }\n    78\t\n    79\t  if (\n    80\t    processSurface.error !== null ||\n    81\t    processSurface.project === null ||\n    82\t    processSurface.process === null\n    83\t  ) {\n    84\t    const error = args.targetDocument.createElement('section');\n    85\t    const title = args.targetDocument.createElement('h2');\n    86\t    const body = args.targetDocument.createElement('p');\n    87\t    title.textContent = 'Process work surface failed to load';\n    88\t    body.textContent = processSurface.error?.message ?? 'The process work surface is unavailable.';\n    89\t    error.append(title, body);\n    90\t    container.append(error);\n    91\t    return container;\n    92\t  }\n    93\t\n    94\t  const activeProject = processSurface.project;\n    95\t  const activeProcess = processSurface.process;\n    96\t\n    97\t  const backButton = args.targetDocument.createElement('button');\n    98\t  backButton.type = 'button';\n    99\t  backButton.textContent = 'Back to project';\n   100\t  backButton.addEventListener('click', () => {\n   101\t    args.onOpenProject(activeProject.projectId);\n   102\t  });\n   103\t\n   104\t  const projectHeading = args.targetDocument.createElement('h2');\n   105\t  const projectRole = args.targetDocument.createElement('p');\n   106\t  const processHeading = args.targetDocument.createElement('h3');\n   107\t  const processMeta = args.targetDocument.createElement('p');\n   108\t  const processPhase = args.targetDocument.createElement('p');\n   109\t\n   110\t  projectHeading.textContent = activeProject.name;\n   111\t  projectRole.textContent = `Role: ${activeProject.role}`;\n   112\t  processHeading.textContent = activeProcess.displayLabel;\n   113\t  processMeta.textContent = `${formatProcessTypeLabel(activeProcess.processType)} • ${formatProcessStatusLabel(activeProcess.status)}`;\n   114\t  processPhase.textContent = `Phase: ${activeProcess.phaseLabel}`;\n   115\t  container.append(\n   116\t    backButton,\n   117\t    projectHeading,\n   118\t    projectRole,\n   119\t    processHeading,\n   120\t    processMeta,\n   121\t    processPhase,\n   122\t  );\n   123\t\n   124\t  if (processSurface.actionError !== null) {\n   125\t    const actionError = args.targetDocument.createElement('p');\n   126\t    actionError.setAttribute('data-process-action-error', 'true');\n   127\t    actionError.setAttribute('role', 'alert');\n   128\t    actionError.textContent = processSurface.actionError.message;\n   129\t    container.append(actionError);\n   130\t  }\n   131\t\n   132\t  if (activeProcess.nextActionLabel !== null) {\n   133\t    const nextAction = args.targetDocument.createElement('p');\n   134\t    nextAction.textContent = `Next action: ${activeProcess.nextActionLabel}`;\n   135\t    container.append(nextAction);\n   136\t  }\n   137\t\n   138\t  container.append(\n   139\t    renderProcessControls({\n   140\t      controls: activeProcess.controls,\n   141\t      targetDocument: args.targetDocument,\n   142\t      onAction: (actionId) => {\n   143\t        switch (actionId) {\n   144\t          case 'start':\n   145\t            args.onStartProcess?.(activeProject.projectId, activeProcess.processId);\n   146\t            return;\n   147\t          case 'resume':\n   148\t            args.onResumeProcess?.(activeProject.projectId, activeProcess.processId);\n   149\t            return;\n   150\t          case 'review':\n   151\t            args.onOpenReview?.(activeProject.projectId, activeProcess.processId);\n   152\t            return;\n   153\t          case 'rehydrate':\n   154\t            args.onRehydrateEnvironment?.(activeProject.projectId, activeProcess.processId);\n   155\t            return;\n   156\t          case 'rebuild':\n   157\t            args.onRebuildEnvironment?.(activeProject.projectId, activeProcess.processId);\n   158\t            return;\n   159\t          case 'respond': {\n   160\t            const responseInput = container.querySelector('[data-process-response-input=\"true\"]');\n   161\t\n   162\t            if (responseInput instanceof args.targetWindow.HTMLTextAreaElement) {\n   163\t              responseInput.focus();\n   164\t            }\n   165\t            return;\n   166\t          }\n   167\t          default:\n   168\t            return;\n   169\t        }\n   170\t      },\n   171\t    }),\n   172\t  );\n   173\t\n   174\t  const liveStatus = renderProcessLiveStatus({\n   175\t    liveState: processSurface.live,\n   176\t    targetDocument: args.targetDocument,\n   177\t    onRetry:\n   178\t      args.onRetryLiveSubscription === undefined\n   179\t        ? undefined\n   180\t        : () => {\n   181\t            args.onRetryLiveSubscription?.(activeProject.projectId, activeProcess.processId);\n   182\t          },\n   183\t  });\n   184\t\n   185\t  if (liveStatus !== null) {\n   186\t    container.append(liveStatus);\n   187\t  }\n   188\t\n   189\t  container.append(\n   190\t    renderProcessEnvironmentPanel({\n   191\t      environment: processSurface.environment,\n   192\t      targetDocument: args.targetDocument,\n   193\t    }),\n   194\t    renderCurrentRequestPanel({\n   195\t      currentRequest: processSurface.currentRequest,\n   196\t      targetDocument: args.targetDocument,\n   197\t    }),\n   198\t  );\n   199\t\n   200\t  if (\n   201\t    activeProcess.availableActions.includes('respond') &&\n   202\t    args.onSubmitProcessResponse !== undefined\n   203\t  ) {\n   204\t    container.append(\n   205\t      renderProcessResponseComposer({\n   206\t        targetDocument: args.targetDocument,\n   207\t        onSubmitResponse: async (message: string) => {\n   208\t          args.onSubmitProcessResponse?.(activeProject.projectId, activeProcess.processId, message);\n   209\t        },\n   210\t      }),\n   211\t    );\n   212\t  }\n   213\t\n   214\t  container.append(\n   215\t    renderProcessHistorySection({\n   216\t      envelope: processSurface.history,\n   217\t      targetDocument: args.targetDocument,\n   218\t    }),\n   219\t    renderProcessMaterialsSection({\n   220\t      envelope: processSurface.materials,\n   221\t      targetDocument: args.targetDocument,\n   222\t      onAttachSource:\n   223\t        args.onAttachSource === undefined\n   224\t          ? undefined\n   225\t          : async (input) => {\n   226\t              await args.onAttachSource?.(activeProject.projectId, activeProcess.processId, input);\n   227\t            },\n   228\t    }),\n   229\t    renderSideWorkSection({\n   230\t      envelope: processSurface.sideWork,\n   231\t      targetDocument: args.targetDocument,\n   232\t    }),\n   233\t  );\n   234\t\n   235\t  return container;\n   236\t}\n","exit_code":0,"status":"completed"}}
