ttachment-scope', args.scope);\n    37\t  heading.textContent = args.title;\n    38\t  description.textContent = args.description;\n    39\t\n    40\t  form.setAttribute('data-source-attachment-form', 'true');\n    41\t\n    42\t  repositoryUrlInput.name = 'repositoryUrl';\n    43\t  repositoryUrlInput.placeholder = 'Repository URL';\n    44\t  repositoryUrlInput.required = true;\n    45\t  repositoryUrlInput.setAttribute('data-source-attachment-repository-url', 'true');\n    46\t\n    47\t  displayNameInput.name = 'displayName';\n    48\t  displayNameInput.placeholder = 'Display name';\n    49\t  displayNameInput.required = true;\n    50\t  displayNameInput.setAttribute('data-source-attachment-display-name', 'true');\n    51\t\n    52\t  purposeSelect.name = 'purpose';\n    53\t  purposeSelect.setAttribute('data-source-attachment-purpose', 'true');\n    54\t  for (const [value, label] of sourcePurposeOptions) {\n    55\t    const option = args.targetDocument.createElement('option');\n    56\t    option.value = value;\n    57\t    option.textContent = label;\n    58\t    if (value === 'implementation') {\n    59\t      option.selected = true;\n    60\t    }\n    61\t    purposeSelect.append(option);\n    62\t  }\n    63\t\n    64\t  accessModeSelect.name = 'accessMode';\n    65\t  accessModeSelect.setAttribute('data-source-attachment-access-mode', 'true');\n    66\t  for (const [value, label] of sourceAccessModeOptions) {\n    67\t    const option = args.targetDocument.createElement('option');\n    68\t    option.value = value;\n    69\t    option.textContent = label;\n    70\t    if (value === 'read_only') {\n    71\t      option.selected = true;\n    72\t    }\n    73\t    accessModeSelect.append(option);\n    74\t  }\n    75\t\n    76\t  targetRefInput.name = 'targetRef';\n    77\t  targetRefInput.placeholder = 'Target ref (optional)';\n    78\t  targetRefInput.setAttribute('data-source-attachment-target-ref', 'true');\n    79\t\n    80\t  submitButton.type = 'submit';\n    81\t  submitButton.textContent = args.submitLabel;\n    82\t  submitButton.setAttribute('data-source-attachment-submit', 'true');\n    83\t\n    84\t  validation.setAttribute('data-source-attachment-validation', 'true');\n    85\t  validation.setAttribute('role', 'alert');\n    86\t\n    87\t  form.addEventListener('submit', (event) => {\n    88\t    event.preventDefault();\n    89\t\n    90\t    const repositoryUrl = repositoryUrlInput.value.trim();\n    91\t    const displayName = displayNameInput.value.trim();\n    92\t    const targetRef = targetRefInput.value.trim();\n    93\t\n    94\t    if (repositoryUrl.length === 0 || displayName.length === 0) {\n    95\t      validation.textContent = 'Enter a repository URL and display name before attaching.';\n    96\t      return;\n    97\t    }\n    98\t\n    99\t    validation.textContent = '';\n   100\t    submitButton.disabled = true;\n   101\t\n   102\t    void Promise.resolve(\n   103\t      args.onAttachSource({\n   104\t        provider: 'github',\n   105\t        repositoryUrl,\n   106\t        displayName,\n   107\t        purpose: purposeSelect.value as CreateSourceAttachmentRequest['purpose'],\n   108\t        accessMode: accessModeSelect.value as CreateSourceAttachmentRequest['accessMode'],\n   109\t        targetRef: targetRef.length > 0 ? targetRef : null,\n   110\t      }),\n   111\t    ).finally(() => {\n   112\t      submitButton.disabled = false;\n   113\t    });\n   114\t  });\n   115\t\n   116\t  form.append(\n   117\t    repositoryUrlInput,\n   118\t    displayNameInput,\n   119\t    purposeSelect,\n   120\t    accessModeSelect,\n   121\t    targetRefInput,\n   122\t    submitButton,\n   123\t    validation,\n   124\t  );\n   125\t  section.append(heading, description, form);\n   126\t\n   127\t  return section;\n   128\t}\n","exit_code":0,"status":"completed"}}
