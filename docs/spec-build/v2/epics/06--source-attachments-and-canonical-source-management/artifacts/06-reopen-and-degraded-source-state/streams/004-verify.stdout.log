\",\"result\":\"not-run\"}]},\"verification\":{\"finalVerifierOutcome\":\"pass\",\"findings\":[{\"id\":\"SV-05-01\",\"status\":\"fixed\",\"evidence\":[\"Verifier 009 marks SV-05-01 resolved.\",\"Verifier 009 states the shared active-source resolver now excludes detached rows and is applied to materials reads, start/resume hydration planning, rehydrate/rebuild planning, and checkpoint source selection.\",\"Verifier 009 reports no new findings and no open findings.\"]}]},\"riskAndDeviationReview\":{\"specDeviations\":[],\"assumedRisks\":[],\"scopeChanges\":[],\"productionPathDecisionItems\":[]},\"diffReview\":{\"changedFiles\":[{\"path\":\"apps/platform/server/services/processes/active-process-sources.ts\",\"reason\":\"Added a shared resolver for active process sources that excludes detached rows and preserves process-scope shadowing.\"},{\"path\":\"apps/platform/server/services/processes/readers/materials-section.reader.ts\",\"reason\":\"Switched process current-source rendering to the shared active-source resolver.\"},{\"path\":\"apps/platform/server/services/processes/environment/process-environment.service.ts\",\"reason\":\"Filtered detached source IDs out of future hydration and checkpoint planning paths.\"},{\"path\":\"apps/platform/server/services/processes/process-start.service.ts\",\"reason\":\"Updated start-time hydration planning to exclude detached sources from new working-set plans.\"},{\"path\":\"apps/platform/server/services/processes/process-resume.service.ts\",\"reason\":\"Updated resume-time hydration planning to exclude detached sources from new working-set plans.\"},{\"path\":\"tests/service/server/process-execution-orchestrator.test.ts\",\"reason\":\"Expanded Story 5 runtime coverage for no mid-run rewrite, detached-source-free rehydrate/rebuild plans, and detached-source checkpoint blocking.\"},{\"path\":\"tests/service/server/process-live-updates.test.ts\",\"reason\":\"Seeded current source refs explicitly so live checkpoint/provenance tests continue to match active-source resolver semantics.\"},{\"path\":\"tests/service/server/process-actions-api.test.ts\",\"reason\":\"Seeded source attachments/current refs explicitly for hydration-plan assertions under the active-source resolver rules.\"}],\"storyScopedAssessment\":\"Latest bounded child-operation changes remain scoped to the active story.\"},\"acceptanceChecks\":[{\"name\":\"story-gate-result\",\"status\":\"unknown\",\"evidence\":[\"corepack pnpm run verify-all\"],\"reasoning\":\"Story gate corepack pnpm run verify-all reported not-run.\"},{\"name\":\"final-verifier-result\",\"status\":\"pass\",\"evidence\":[\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/05-detach-sources-and-preserve-prior-provenance/004-verify.json\",\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/05-detach-sources-and-preserve-prior-provenance/009-verify.json\"],\"reasoning\":\"Final verifier outcome is pass.\"},{\"name\":\"unresolved-findings-status\",\"status\":\"pass\",\"evidence\":[],\"reasoning\":\"No unresolved verifier findings remain.\"},{\"name\":\"scope-change-status\",\"status\":\"pass\",\"evidence\":[],\"reasoning\":\"No scope changes require further ruling.\"},{\"name\":\"production-path-status\",\"status\":\"pass\",\"evidence\":[],\"reasoning\":\"No production-path decisions require further approval.\"},{\"name\":\"baseline-status\",\"status\":\"pass\",\"evidence\":[\"baselineBefore=41\",\"baselineAfter=48\"],\"reasoning\":\"The current baseline did not drop below the prior accepted baseline.\"},{\"name\":\"receipt-readiness\",\"status\":\"fail\",\"evidence\":[\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epics/06--source-attachments-and-canonical-source-management/artifacts/05-detach-sources-and-preserve-prior-provenance/003-implementor.json\",\"/Users/leemoore/code/liminal-build/docs/spec-build/v2/epic