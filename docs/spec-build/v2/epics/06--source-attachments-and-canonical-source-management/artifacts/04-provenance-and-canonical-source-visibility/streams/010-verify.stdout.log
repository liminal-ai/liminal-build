{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba apps/platform/server/services/sources/source-provenance.service.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport {\n     2\t  type ListProcessSourceProvenanceResponse,\n     3\t  listProcessSourceProvenanceResponseSchema,\n     4\t  type SourceAttachmentSummary,\n     5\t  type SourceProvenanceEntry,\n     6\t} from '../../../shared/contracts/index.js';\n     7\timport type { CodeCheckpointTarget } from '../processes/environment/checkpoint-types.js';\n     8\timport type { PlatformStore, StoredSourceProvenanceRecord } from '../projects/platform-store.js';\n     9\t\n    10\ttype SourceProvenancePlatformStore = PlatformStore & {\n    11\t  createSourceProvenance: NonNullable<PlatformStore['createSourceProvenance']>;\n    12\t  listProcessSourceProvenance: NonNullable<PlatformStore['listProcessSourceProvenance']>;\n    13\t};\n    14\t\n    15\texport interface SourceProvenanceService {\n    16\t  recordInformedWorkForCurrentSources(args: {\n    17\t    projectId: string;\n    18\t    processId: string;\n    19\t    eventId?: string | null;\n    20\t  }): Promise<void>;\n    21\t  recordReceivedCodeUpdates(args: {\n    22\t    projectId: string;\n    23\t    processId: string;\n    24\t    codeTargets: CodeCheckpointTarget[];\n    25\t    eventId?: string | null;\n    26\t  }): Promise<void>;\n    27\t  listProcessSourceProvenance(args: {\n    28\t    projectId: string;\n    29\t    processId: string;\n    30\t  }): Promise<ListProcessSourceProvenanceResponse>;\n    31\t}\n    32\t\n    33\texport class DefaultSourceProvenanceService implements SourceProvenanceService {\n    34\t  constructor(private readonly platformStore: SourceProvenancePlatformStore) {}\n    35\t\n    36\t  async recordInformedWorkForCurrentSources(args: {\n    37\t    projectId: string;\n    38\t    processId: string;\n    39\t    eventId?: string | null;\n    40\t  }): Promise<void> {\n    41\t    const [currentMaterialRefs, projectSourceAttachments] = await Promise.all([\n    42\t      this.platformStore.getCurrentProcessMaterialRefs({\n    43\t        processId: args.processId,\n    44\t      }),\n    45\t      this.platformStore.listProjectSourceAttachments({\n    46\t        projectId: args.projectId,\n    47\t      }),\n    48\t    ]);\n    49\t    const sourceAttachmentsById = new Map(\n    50\t      projectSourceAttachments.map((sourceAttachment) => [\n    51\t        sourceAttachment.sourceAttachmentId,\n    52\t        sourceAttachment,\n    53\t      ]),\n    54\t    );\n    55\t\n    56\t    await Promise.all(\n    57\t      Array.from(new Set(currentMaterialRefs.sourceAttachmentIds)).map(\n    58\t        async (sourceAttachmentId) => {\n    59\t          const sourceAttachment = sourceAttachmentsById.get(sourceAttachmentId);\n    60\t\n    61\t          if (sourceAttachment === undefined || sourceAttachment.detachedAt != null) {\n    62\t            return;\n    63\t          }\n    64\t\n    65\t          await this.createProvenanceRecord({\n    66\t            projectId: args.projectId,\n    67\t            processId: args.processId,\n    68\t            sourceAttachment,\n    69\t            relationshipKind: 'informed_work',\n    70\t            eventId: args.eventId ?? null,\n    71\t          });\n    72\t        },\n    73\t      ),\n    74\t    );\n    75\t  }\n    76\t\n    77\t  async recordReceivedCodeUpdates(args: {\n    78\t    projectId: string;\n    79\t    processId: string;\n    80\t    codeTargets: CodeCheckpointTarget[];\n    81\t    eventId?: string | null;\n    82\t  }): Promise<void> {\n    83\t    if (args.codeTargets.length === 0) {\n    84\t      return;\n    85\t    }\n    86\t\n    87\t    const projectSourceAttachments = await this.platformStore.listProjectSourceAttachments({\n    88\t      projectId: args.projectId,\n    89\t    });\n    90\t    const sourceAttachmentsById = new Map(\n    91\t      projectSourceAttachments.map((sourceAttachment) => [\n    92\t        sourceAttachment.sourceAttachmentId,\n    93\t        sourceAttachment,\n    94\t      ]),\n    95\t    );\n    96\t\n    97\t    await Promise.all(\n    98\t      Array.from(new Set(args.codeTargets.map((target) => target.sourceAttachmentId))).map(\n    99\t        async (sourceAttachmentId) => {\n   100\t          const sourceAttachment = sourceAttachmentsById.get(sourceAttachmentId);\n   101\t\n   102\t          if (\n   103\t            sourceAttachment === undefined ||\n   104\t            sourceAttachment.detachedAt != null ||\n   105\t            sourceAttachment.accessMode !== 'read_write'\n   106\t          ) {\n   107\t            return;\n   108\t          }\n   109\t\n   110\t          await this.createProvenanceRecord({\n   111\t            projectId: args.projectId,\n   112\t            processId: args.processId,\n   113\t            sourceAttachment,\n   114\t            relationshipKind: 'received_code_update',\n   115\t            eventId: args.eventId ?? null,\n   116\t          });\n   117\t        },\n   118\t      ),\n   119\t    );\n   120\t  }\n   121\t\n   122\t  async listProcessSourceProvenance(args: {\n   123\t    projectId: string;\n   124\t    processId: string;\n   125\t  }): Promise<ListProcessSourceProvenanceResponse> {\n   126\t    const [records, projectSourceAttachments] = await Promise.all([\n   127\t      this.platformStore.listProcessSourceProvenance({\n   128\t        processId: args.processId,\n   129\t      }),\n   130\t      this.platformStore.listProjectSourceAttachments({\n   131\t        projectId: args.projectId,\n   132\t      }),\n   133\t    ]);\n   134\t    const sourceAttachmentsById = new Map(\n   135\t      projectSourceAttachments.map((sourceAttachment) => [\n   136\t        sourceAttachment.sourceAttachmentId,\n   137\t        sourceAttachment,\n   138\t      ]),\n   139\t    );\n   140\t\n   141\t    return listProcessSourceProvenanceResponseSchema.parse({\n   142\t      entries: records.map((record) =>\n   143\t        this.buildSourceProvenanceEntry(\n   144\t          record,\n   145\t          record.sourceAttachmentId === null\n   146\t            ? null\n   147\t            : (sourceAttachmentsById.get(record.sourceAttachmentId) ?? null),\n   148\t        ),\n   149\t      ),\n   150\t    });\n   151\t  }\n   152\t\n   153\t  private async createProvenanceRecord(args: {\n   154\t    projectId: string;\n   155\t    processId: string;\n   156\t    sourceAttachment: SourceAttachmentSummary;\n   157\t    relationshipKind: SourceProvenanceEntry['relationshipKind'];\n   158\t    eventId: string | null;\n   159\t  }): Promise<void> {\n   160\t    await this.platformStore.createSourceProvenance({\n   161\t      projectId: args.projectId,\n   162\t      processId: args.processId,\n   163\t      sourceAttachmentId: args.sourceAttachment.sourceAttachmentId,\n   164\t      relationshipKind: args.relationshipKind,\n   165\t      repositoryFullName: args.sourceAttachment.repositoryFullName,\n   166\t      repositoryUrl: args.sourceAttachment.repositoryUrl,\n   167\t      targetRef: args.sourceAttachment.targetRef,\n   168\t      eventId: args.eventId,\n   169\t      entryStatus: 'ready',\n   170\t      degradationReason: null,\n   171\t    });\n   172\t  }\n   173\t\n   174\t  private buildSourceProvenanceEntry(\n   175\t    record: StoredSourceProvenanceRecord,\n   176\t    sourceAttachment: SourceAttachmentSummary | null,\n   177\t  ): SourceProvenanceEntry {\n   178\t    if (\n   179\t      record.entryStatus === 'ready' &&\n   180\t      record.degradationReason === null &&\n   181\t      sourceAttachment !== null &&\n   182\t      sourceAttachment.detachedAt == null\n   183\t    ) {\n   184\t      return {\n   185\t        provenanceId: record.provenanceId,\n   186\t        sourceAttachmentId: record.sourceAttachmentId,\n   187\t        relationshipKind: record.relationshipKind,\n   188\t        repositoryFullName: record.repositoryFullName,\n   189\t        repositoryUrl: record.repositoryUrl,\n   190\t        targetRef: record.targetRef,\n   191\t        currentAttachmentDisplayName: sourceAttachment.displayName,\n   192\t        currentAttachmentScope: sourceAttachment.attachmentScope,\n   193\t        currentAttachmentAccessMode: sourceAttachment.accessMode,\n   194\t        currentAttachmentHydrationState: sourceAttachment.hydrationState,\n   195\t        currentAttachmentVisibility: 'available',\n   196\t        entryStatus: record.entryStatus,\n   197\t        degradationReason: record.degradationReason,\n   198\t        recordedAt: record.recordedAt,\n   199\t      };\n   200\t    }\n   201\t\n   202\t    const currentAttachmentVisibility =\n   203\t      record.degradationReason === 'access_revoked'\n   204\t        ? 'redacted'\n   205\t        : sourceAttachment?.detachedAt != null || record.degradationReason === 'source_detached'\n   206\t          ? 'detached'\n   207\t          : 'unavailable';\n   208\t\n   209\t    return {\n   210\t      provenanceId: record.provenanceId,\n   211\t      sourceAttachmentId: record.sourceAttachmentId,\n   212\t      relationshipKind: record.relationshipKind,\n   213\t      repositoryFullName: record.repositoryFullName,\n   214\t      repositoryUrl: record.repositoryUrl,\n   215\t      targetRef: record.targetRef,\n   216\t      currentAttachmentDisplayName: null,\n   217\t      currentAttachmentScope: null,\n   218\t      currentAttachmentAccessMode: null,\n   219\t      currentAttachmentHydrationState: null,\n   220\t      currentAttachmentVisibility,\n   221\t      entryStatus: 'degraded',\n   222\t      degradationReason:\n   223\t        record.degradationReason ??\n   224\t        (currentAttachmentVisibility === 'detached'\n   225\t          ? 'source_detached'\n   226\t          : currentAttachmentVisibility === 'redacted'\n   227\t            ? 'access_revoked'\n   228\t            : 'current_attachment_unavailable'),\n   229\t      recordedAt: record.recordedAt,\n   230\t    };\n   231\t  }\n   232\t}\n","exit_code":0,"status":"completed"}}
