ing(args.targetDocument, args.artifact.displayName),\n    40\t    createParagraph(args.targetDocument, `Artifact ID: ${args.artifact.artifactId}`),\n    41\t    createParagraph(\n    42\t      args.targetDocument,\n    43\t      `Current version: ${args.artifact.currentVersionLabel ?? 'No durable version yet'}`,\n    44\t    ),\n    45\t    createParagraph(\n    46\t      args.targetDocument,\n    47\t      `Selected version: ${selectedVersion?.versionLabel ?? 'No durable version selected'}`,\n    48\t    ),\n    49\t  );\n    50\t\n    51\t  if (args.artifact.versions.length === 0) {\n    52\t    container.append(\n    53\t      createParagraph(\n    54\t        args.targetDocument,\n    55\t        'No reviewable version is currently available for this artifact.',\n    56\t      ),\n    57\t    );\n    58\t    return container;\n    59\t  }\n    60\t\n    61\t  if (showVersionSwitcher) {\n    62\t    container.append(\n    63\t      renderVersionSwitcher({\n    64\t        versions: args.artifact.versions,\n    65\t        selectedVersionId: args.artifact.selectedVersionId,\n    66\t        targetDocument: args.targetDocument,\n    67\t        onSelect: args.onSelectVersion,\n    68\t      }),\n    69\t    );\n    70\t  }\n    71\t\n    72\t  if (selectedVersion === undefined) {\n    73\t    return container;\n    74\t  }\n    75\t\n    76\t  container.append(\n    77\t    createHeading(args.targetDocument, selectedVersion.versionLabel, 'h4'),\n    78\t    createParagraph(args.targetDocument, `Created: ${selectedVersion.createdAt}`),\n    79\t    createParagraph(\n    80\t      args.targetDocument,\n    81\t      `Produced by: ${formatProducedByLabel({\n    82\t        producedByProcessId: selectedVersion.producedByProcessId,\n    83\t        producedByProcessDisplayLabel: selectedVersion.producedByProcessDisplayLabel,\n    84\t      })}`,\n    85\t    ),\n    86\t  );\n    87\t\n    88\t  if (selectedVersion.contentKind === 'unsupported') {\n    89\t    container