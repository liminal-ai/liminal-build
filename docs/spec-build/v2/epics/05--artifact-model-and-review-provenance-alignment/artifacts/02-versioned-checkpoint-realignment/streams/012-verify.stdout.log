? 0 : -1;\n    48\t  option.setAttribute('data-artifact-version-id', args.version.versionId);\n    49\t  option.setAttribute('aria-selected', args.isSelected ? 'true' : 'false');\n    50\t  option.addEventListener('click', () => {\n    51\t    args.onSelect(args.version.versionId);\n    52\t  });\n    53\t  option.addEventListener('keydown', (event) => {\n    54\t    const options = [\n    55\t      ...(option.parentElement?.querySelectorAll<HTMLElement>('[role=\"option\"]') ?? []),\n    56\t    ];\n    57\t    const currentIndex = options.indexOf(option);\n    58\t\n    59\t    switch (event.key) {\n    60\t      case 'ArrowDown':\n    61\t        event.preventDefault();\n    62\t        moveListboxSelection({ options, currentIndex, nextIndex: currentIndex + 1 });\n    63\t        return;\n    64\t      case 'ArrowUp':\n    65\t        event.preventDefault();\n    66\t        moveListboxSelection({ options, currentIndex, nextIndex: currentIndex - 1 });\n    67\t        return;\n    68\t      case 'Home':\n    69\t        event.preventDefault();\n    70\t        moveListboxSelection({ options, currentIndex, nextIndex: 0 });\n    71\t        return;\n    72\t      case 'End':\n    73\t        event.preventDefault();\n    74\t        moveListboxSelection({\n    75\t          options,\n    76\t          currentIndex,\n    77\t          nextIndex: options.length - 1,\n    78\t        });\n    79\t        return;\n    80\t      case 'Enter':\n    81\t      case ' ':\n    82\t        event.preventDefault();\n    83\t        args.onSelect(args.version.versionId);\n    84\t        return;\n    85\t    }\n    86\t  });\n    87\t\n    88\t  return option;\n    89\t}\n    90\t\n    91\texport function renderVersionSwitcher(args: {\n    92\t  versions: ArtifactVersionSummary[];\n    93\t  selectedVersionId?: string;\n    94\t  targetDocument: Document;\n    95\t  onSelect: (versionId: string) => void;\n    96\t}): HTMLElement {\n    97\t  const container = args.targetDocument.createElement('section');\n    98\t  const heading = args.targetDocument.createElement('h4');\n    99\t  const list = args.targetDocument.createElement('ul');\n   100\t\n   101\t  container.setAttribute('data-artifact-version-switcher', 'true');\n   102\t  heading.textContent = 'Versions';\n   103\t  list.role = 'listbox';\n   104\t  list.setAttribute('aria-label', 'Artifact versions');\n   105\t  list.setAttribute('data-artifact-version-list', 'true');\n   106\t\n   107\t  for (const version of args.versions) {\n   108\t    const item = createVersionOption({\n   109\t      targetDocument: args.targetDocument,\n   110\t      version,\n   111\t      isSelected: version.versionId === args.selectedVersionId,\n   112\t      onSelect: args.onSelect,\n   113\t    });\n   114\t    const meta = args.targetDocument.createElement('p');\n   115\t\n   116\t    meta.textContent = `Created: ${version.createdAt} | Produced by: ${formatProducedByLabel({\n   117\t      producedByProcessId: version.producedByProcessId,\n   118\t      producedByProcessDisplayLabel: version.producedByProcessDisplayLabel,\n   119\t    })}`;\n   120\t    item.append(meta);\n   121\t    list.append(item);\n   122\t  }\n   123\t\n   124\t  container.append(heading, list);\n   125\t  return container;\n   126\t}\n","exit_code":0,"status":"completed"}}
