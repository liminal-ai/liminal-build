t versions');\n    96\t  list.setAttribute('data-artifact-version-list', 'true');\n    97\t\n    98\t  for (const version of args.versions) {\n    99\t    const item = createVersionOption({\n   100\t      targetDocument: args.targetDocument,\n   101\t      version,\n   102\t      isSelected: version.versionId === args.selectedVersionId,\n   103\t      onSelect: args.onSelect,\n   104\t    });\n   105\t    const meta = args.targetDocument.createElement('p');\n   106\t\n   107\t    meta.textContent = `Created: ${version.createdAt}`;\n   108\t    item.append(meta);\n   109\t    list.append(item);\n   110\t  }\n   111\t\n   112\t  container.append(heading, list);\n   113\t  return container;\n   114\t}\n","exit_code":0,"status":"completed"}}
