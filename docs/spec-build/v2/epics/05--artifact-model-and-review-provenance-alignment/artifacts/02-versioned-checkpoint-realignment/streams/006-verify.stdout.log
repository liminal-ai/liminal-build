st platformStore = buildStore();\n   360\t    const app = await buildApp({\n   361\t      authSessionService: createTestAuthSessionService({\n   362\t        actor: {\n   363\t          userId: 'workos-user-1',\n   364\t          workosUserId: 'workos-user-1',\n   365\t          email: 'lee@example.com',\n   366\t          displayName: 'Lee Moore',\n   367\t        },\n   368\t        reason: null,\n   369\t      }),\n   370\t      authUserSyncService: new AuthUserSyncService(platformStore),\n   371\t      platformStore,\n   372\t    });\n   373\t    const response = await app.inject({\n   374\t      method: 'GET',\n   375\t      url: `/api/projects/${projectSummary.projectId}/processes/${processSummary.processId}/review/artifacts/artifact-001`,\n   376\t      cookies: {\n   377\t        [sessionCookieName]: 'valid-session-cookie',\n   378\t      },\n   379\t    });\n   380\t\n   381\t    expect(response.statusCode).toBe(200);\n   382\t    expect(\n   383\t      response.json().versions.map((version: { versionId: string }) => version.versionId),\n   384\t    ).toEqual([currentArtifactVersionFixture.versionId, priorArtifactVersionFixture.versionId]);\n   385\t\n   386\t    await app.close();\n   387\t  });\n   388\t\n   389\t  it('TC-2.4a returns the no-version empty state for an owned artifact with no durable revisions', async () => {\n   390\t    const platformStore = buildStore();\n   391\t    const app = await buildApp({\n   392\t      authSessionService: createTestAuthSessionService({\n   393\t        actor: {\n   394\t          userId: 'workos-user-1',\n   395\t          workosUserId: 'workos-user-1',\n   396\t          email: 'lee@example.com',\n   397\t          displayName: 'Lee Moore',\n   398\t        },\n   399\t        reason: null,\n   400\t      }),\n   401\t      authUserSyncService: new AuthUserSyncService(platformStore),\n   402\t      platformStore,\n   403\t    });\n   404\t    const response = await app.inject({\n   405\t      method: 'GET',\n   