esponse.json()).toMatchObject({\n   500\t      artifactId: 'artifact-zero-byte-001',\n   501\t      currentVersionId: 'artifact-version-zero-byte-001',\n   502\t      selectedVersionId: 'artifact-version-zero-byte-001',\n   503\t      selectedVersion: {\n   504\t        versionId: 'artifact-version-zero-byte-001',\n   505\t        versionLabel: 'checkpoint-empty',\n   506\t        bodyStatus: 'ready',\n   507\t        body: '',\n   508\t        mermaidBlocks: [],\n   509\t      },\n   510\t    });\n   511\t\n   512\t    await app.close();\n   513\t  });\n   514\t\n   515\t  it('keeps version context visible when artifact body loading times out', async () => {\n   516\t    const platformStore = buildStore();\n   517\t    const fetchSpy = vi.spyOn(globalThis, 'fetch').mockRejectedValue(\n   518\t      Object.assign(new Error('timed out'), {\n   519\t        name: 'TimeoutError',\n   520\t      }),\n   521\t    );\n   522\t    const app = await buildApp({\n   523\t      authSessionService: createTestAuthSessionService({\n   524\t        actor: {\n   525\t          userId: 'workos-user-1',\n   526\t          workosUserId: 'workos-user-1',\n   527\t          email: 'lee@example.com',\n   528\t          displayName: 'Lee Moore',\n   529\t        },\n   530\t        reason: null,\n   531\t      }),\n   532\t      authUserSyncService: new AuthUserSyncService(platformStore),\n   533\t      platformStore,\n   534\t    });\n   535\t    const response = await app.inject({\n   536\t      method: 'GET',\n   537\t      url: `/api/projects/${projectSummary.projectId}/processes/${processSummary.processId}/review/artifacts/artifact-001`,\n   538\t      cookies: {\n   539\t        [sessionCookieName]: 'valid-session-cookie',\n   540\t      },\n   541\t    });\n   542\t\n   543\t    expect(ARTIFACT_CONTENT_FETCH_TIMEOUT_MS).toBe(10_000);\n   544\t    expect(fetchSpy).toHaveBeenCalled();\n   545\t    expect(response.statusCode).toBe(200);\n   546\t    expect(response.json()).toMatchObject({\n   547\t      currentVersionId: currentArtifactVersionFixture.versionId,\n   548\t      selectedVersionId: currentArtifactVersionFixture.versionId,\n   549\t      selectedVersion: {\n   550\t        versionId: currentArtifactVersionFixture.versionId,\n   551\t        producedByProcessId: processSummary.processId,\n   552\t        producedByProcessDisplayLabel: processSummary.displayLabel,\n   553\t        bodyStatus: 'error',\n   554\t        bodyError: {\n   555\t          code: 'REVIEW_RENDER_FAILED',\n   556\t        },\n   557\t      },\n   558\t    });\n   559\t\n   560\t    await app.close();\n   561\t  });\n   562\t});\n","exit_code":0,"status":"completed"}}
