ctedVersion:\n   159\t        selectedVersionRecord === undefined\n   160\t          ? undefined\n   161\t          : await this.buildArtifactVersionDetail(\n   162\t              selectedVersionRecord,\n   163\t              processDisplayLabelsById.get(selectedVersionRecord.createdByProcessId) ?? null,\n   164\t            ),\n   165\t    });\n   166\t\n   167\t    if (selectedVersionRecord !== undefined) {\n   168\t      this.logger?.info(\n   169\t        {\n   170\t          event: 'review.artifact.resolved',\n   171\t          artifactId: artifactReview.artifactId,\n   172\t          selectedVersionId: selectedVersionRecord.versionId,\n   173\t          contentKind:\n   174\t            artifactReview.selectedVersion?.contentKind ?? selectedVersionRecord.contentKind,\n   175\t          bodyStatus: artifactReview.selectedVersion?.bodyStatus ?? null,\n   176\t        },\n   177\t        'Artifact review resolved.',\n   178\t      );\n   179\t    }\n   180\t\n   181\t    if (currentVersion === undefined) {\n   182\t      return {\n   183\t        artifact: artifactReview,\n   184\t        status: 'empty',\n   185\t      };\n   186\t    }\n   187\t\n   188\t    if (selectedVersionRecord?.contentKind === 'unsupported') {\n   189\t      return {\n   190\t        artifact: artifactReview,\n   191\t        status: 'unsupported',\n   192\t        error: {\n   193\t          code: 'REVIEW_TARGET_UNSUPPORTED',\n   194\t          message: 'This artifact format is not reviewable in the current release.',\n   195\t        },\n   196\t      };\n   197\t    }\n   198\t\n   199\t    return {\n   200\t      artifact: artifactReview,\n   201\t      status: 'ready',\n   202\t    };\n   203\t  }\n   204\t\n   205\t  private async buildArtifactVersionDetail(\n   206\t    version: ArtifactVersionRecord,\n   207\t    producedByProcessDisplayLabel: string | null,\n   208\t  ): Promise<ArtifactVersionDetail> {\n   209\t    if (version.contentKind === 'unsupported') {\n   210\t      return {\n   211\t        versionId: version.versionId,\n   212\t        versionLabel: version.versionLabel,\n   213\t        contentKind: 'unsupported',\n   214\t        createdAt: version.createdAt,\n   215\t        producedByProcessId: version.createdByProcessId,\n   216\t        producedByProcessDisplayLabel,\n   217\t      };\n   218\t    }\n   219\t\n   220\t    const contentUrl = await this.platformStore.getArtifactVersionContentUrl({\n   221\t      versionId: version.versionId,\n   222\t    });\n   223\t\n   224\t    if (contentUrl === null) {\n   225\t      return this.buildArtifactVersionError(\n   226\t        version,\n   227\t        producedByProcessDisplayLabel,\n   228\t        'This artifact version could not be loaded for review.',\n   229\t        'missing_content_url',\n   230\t      );\n   231\t    }\n   232\t\n   233\t    let markdown: string;\n   234\t\n   235\t    try {\n   236\t      const response = await fetch(contentUrl, {\n   237\t        signal: AbortSignal.timeout(ARTIFACT_CONTENT_FETCH_TIMEOUT_MS),\n   238\t      });\n   239\t\n   240\t      if (!response.ok) {\n   241\t        return this.buildArtifactVersionError(\n   242\t          version,\n   243\t          producedByProcessDisplayLabel,\n   244\t          'This artifact version could not be loaded for review.',\n   245\t          `http_${response.status}`,\n   246\t        );\n   247\t      }\n   248\t\n   249\t      markdown = await response.text();\n   250\t    } catch (error) {\n   251\t      if (\n   252\t        error instanceof Error &&\n   253\t        (error.name === 'AbortError' || error.name === 'TimeoutError')\n   254\t      ) {\n   255\t        return this.buildArtifactVersionError(\n   256\t          version,\n   257\t          producedByProcessDisplayLabel,\n   258\t          'Artifact version loading timed out before review content became available.',\n   259\t          'timeout',\n   260\t        );\n   261\t      }\n   262\t\n   263\t      return this.buildArtifact