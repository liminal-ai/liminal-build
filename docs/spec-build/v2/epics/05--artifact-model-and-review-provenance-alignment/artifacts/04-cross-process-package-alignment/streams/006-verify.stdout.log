ound.',\\\\napps/platform/client/browser-api/review-workspace-api.ts:75:        message: 'The review target is unavailable right now. Try again or reload the page.',\\\\napps/platform/client/browser-api/review-workspace-api.ts:82:          message: 'The requested review target could not be found.',\\\\napps/platform/client/browser-api/review-workspace-api.ts:148:    throw new ApiRequestError(await parseRequestError(response, 'review-workspace'));\\\\napps/platform/client/browser-api/review-workspace-api.ts:151:  return reviewWorkspaceResponseSchema.parse(await response.json());\\\\napps/platform/client/browser-api/review-workspace-api.ts:178:    throw new ApiRequestError(await parseRequestError(response, 'artifact-review'));\\\\napps/platform/client/browser-api/review-workspace-api.ts:208:    throw new ApiRequestError(await parseRequestError(response, 'package-review'));\\\\ntests/service/client/review-workspace-page.test.ts:6:import { renderReviewWorkspacePage } from '../../../apps/platform/client/features/review/review-workspace-page.js';\\\\ntests/service/client/review-workspace-page.test.ts:13:} from '../../fixtures/review-workspace.js';\\\\ntests/service/client/review-workspace-page.test.ts:27:      pathname: '/projects/project-review-001/processes/process-review-001/review',\\\\ntests/service/client/review-workspace-page.test.ts:31:    reviewWorkspace: {\\\\ntests/service/client/review-workspace-page.test.ts:85:describe('review workspace page', () => {\\\\ntests/service/client/review-workspace-page.test.ts:89:    expect(dom.window.document.querySelector('[data-review-workspace=\\\\\\\"true\\\\\\\"]')).not.toBeNull();\\\\ntests/service/client/review-workspace-page.test.ts:104:      reviewWorkspace: {\\\\ntests/service/client/review-workspace-page.test.ts:126:    expect(dom.window.document.body.textContent).toContain('Select a review target');\\\\ntests/service/client/review-workspace-page.test.ts:148:  it('TC-1.3b identifies package review targets on first render', () => {\\\\ntests/service/client/revhema,\\\\n   152\\\\t  promptText: z.string().min(1),\\\\n   153\\\\t  requiredActionLabel: z.string().min(1).nullable(),\\\\n   154\\\\t  createdAt: z.string().min(1),\\\\n   155\\\\t});\\\\n   156\\\\texport type CurrentProcessRequest = z.infer<typeof currentProcessRequestSchema>;\\\\n   157\\\\t\\\\n   158\\\\texport const processArtifactReferenceSchema = z.object({\\\\n   159\\\\t  artifactId: z.string().min(1),\\\\n   160\\\\t  displayName: z.string().min(1),\\\\n   161\\\\t  currentVersionLabel: z.string().min(1).nullable(),\\\\n   162\\\\t  roleLabel: z.string().min(1).nullable(),\\\\n   163\\\\t  updatedAt: z.string().min(1),\\\\n   164\\\\t});\\\\n   165\\\\texport type ProcessArtifactReference = z.infer<typeof processArtifactReferenceSchema>;\\\\n   166\\\\t\\\\n   167\\\\texport const processOutputReferenceSchema = z.object({\\\\n   168\\\\t  outputId: z.string().min(1),\\\\n   169\\\\t  displayName: z.string().min(1),\\\\n   170\\\\t  revisionLabel: z.string().min(1).nullable(),\\\\n   171\\\\t  state: z.string().min(1),\\\\n   172\\\\t  updatedAt: z.string().min(1),\\\\n   173\\\\t});\\\\n   174\\\\texport type ProcessOutputReference = z.infer<typeof processOutputReferenceSchema>;\\\\n   175\\\\t\\\\n   176\\\\texport const processSourceReferenceSchema = z.object({\\\\n   177\\\\t  sourceAttachmentId: z.string().min(1),\\\\n   178\\\\t  displayName: z.string().min(1),\\\\n   179\\\\t  purpose: sourcePurposeSchema,\\\\n   180\\\\t  targetRef: z.string().min(1).nullable(),\\\\n   181\\\\t  hydrationState: hydrationStateSchema,\\\\n   182\\\\t  updatedAt: z.string().min(1),\\\\n   183\\\\t});\\\\n   184\\\\texport type ProcessSourceReference = z.infer<typeof processSourceReferenceSchema>;\\\\n   185\\\\t\\\\n   186\\\\texport const processMaterialsSectionEnvelopeSchema = z\\\\n   187\\\\t  .object({\\\\n   188\\\\t    status: sectionStatusSchema,\\\\n   189\\\\t    currentArtifacts: z.array(processArtifactReferenceSchema),\\\\n   190\\\\t    currentOutputs: z.array(processOutputReferenceSchema),\\\\n   191\\\\t    currentSources: z.array(processSourceReferenceSchema),\\\\n   192\\\\t    error: processSurfaceSectionErrorSchema.optional(),\\\\n   193\\\\t  })\\\\n   194\\\\t  .superRefine((value, context) => {\\\\n   195\\\\t    if (value.status === 'error' && value.error === undefined) {\\\\n   196\\\\t      context.addIssue({\\\\n   197\\\\t        code: z.ZodIssueCode.custom,\\\\n   198\\\\t        message: 'Process materials error state requires an error payload.',\\\\n   199\\\\t      });\\\\n   200\\\\t    }\\\\n   201\\\\t  });\\\\n   202\\\\texport type ProcessMaterialsSectionEnvelope = z.infer<typeof processMaterialsSectionEnvelopeSchema>;\\\\n   203\\\\t\\\\n   204\\\\texport const sideWorkStatusSchema = z.enum(['running', 'completed', 'failed']);\\\\n   205\\\\texport type SideWorkStatus = z.infer<typeof sideWorkStatusSchema>;\\\\n   206\\\\t\\\\n   207\\\\texport const sideWorkItemSchema = z.object({\\\\n   208\\\\t  sideWorkId: z.string().min(1),\\\\n   209\\\\t  displayLabel: z.string().min(1),\\\\n   210\\\\t  purposeSummary: z.string().min(1),\\\\n   211\\\\t  status: sideWorkStatusSchema,\\\\n   212\\\\t  resultSummary: z.string().min(1).nullable(),\\\\n   213\\\\t  updatedAt: z.string().min(1),\\\\n   214\\\\t});\\\\n   215\\\\texport type SideWorkItem = z.infer<typeof sideWorkItemSchema>;\\\\n   216\\\\t\\\\n   217\\\\texport const sideWorkSectionEnvelopeSchema = z\\\\n   218\\\\t  .object({\\\\n   219\\\\t    status: sectionStatusSchema,\\\\n   220\\\\t    items: z.array(sideWorkItemSchema),\\\\n   221\\\\t    error: processSurfaceSectionErrorSchema.optional(),\\\\n   222\\\\t  })\\\\n   223\\\\t  .superRefine((value, context) => {\\\\n   224\\\\t    if (value.status === 'error' && value.error === undefined) {\\\\n   225\\\\t      context.addIssue({\\\\n   226\\\\t        code: z.ZodIssueCode.custom,\\\\n   227\\\\t        message: 'Side-work error state requ