chema,\\\\n   265\\\\t  currentRequest: currentProcessRequestSchema.nullable(),\\\\n   266\\\\t});\\\\n   267\\\\texport type SubmitProcessResponseResponse = z.infer<typeof submitProcessResponseResponseSchema>;\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/spec-build/v2/epics/02--process-work-surface/story-verification/03-conversation-and-current-request/codex-review.jsonl:123:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_62\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba apps/platform/shared/contracts/schemas.ts | sed -n '1,260p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\timport { z } from 'zod/v4';\\\\n     2\\\\t\\\\n     3\\\\texport const supportedProcessTypeSchema = z.enum([\\\\n     4\\\\t  'ProductDefinition',\\\\n     5\\\\t  'FeatureSpecification',\\\\n     6\\\\t  'FeatureImplementation',\\\\n     7\\\\t]);\\\\n     8\\\\texport type SupportedProcessType = z.infer<typeof supportedProcessTypeSchema>;\\\\n     9\\\\t\\\\n    10\\\\texport const projectRoleSchema = z.enum(['owner', 'member']);\\\\n    11\\\\texport type ProjectRole = z.infer<typeof projectRoleSchema>;\\\\n    12\\\\t\\\\n    13\\\\texport const processStatusSchema = z.enum([\\\\n    14\\\\t  'draft',\\\\n    15\\\\t  'running',\\\\n    16\\\\t  'waiting',\\\\n    17\\\\t  'paused',\\\\n    18\\\\t  'completed',\\\\n    19\\\\t  'failed',\\\\n    20\\\\t  'interrupted',\\\\n    21\\\\t]);\\\\n    22\\\\texport type ProcessStatus = z.infer<typeof processStatusSchema>;\\\\n    23\\\\t\\\\n    24\\\\texport const processAvailableActionSchema = z.enum([\\\\n    25\\\\t  'open',\\\\n    26\\\\t  'respond',\\\\n    27\\\\t  'resume',\\\\n    28\\\\t  'review',\\\\n    29\\\\t  'rehydrate',\\\\n    30\\\\t  'restart',\\\\n    31\\\\t]);\\\\n    32\\\\texport type ProcessAvailableAction = z.infer<typeof processAvailableActionSchema>;\\\\n    33\\\\t\\\\n    34\\\\texport const attachmentScopeSchema = z.enum(['project', 'process']);\\\\n    35\\\\texport type AttachmentScope = z.infer<typeof attachmentScopeSchema>;\\\\n    36\\\\t\\\\n    37\\\\texport const sourcePurposeSchema = z.enum(['research', 'review', 'implementation', 'other']);\\\\n    38\\\\texport type SourcePurpose = z.infer<typeof sourcePurposeSchema>;\\\\n    39\\\\t\\\\n    40\\\\texport const hydrationStateSchema = z.enum(['not_hydrated', 'hydrated', 'stale', 'unavailable']);\\\\n    41\\\\texport type HydrationState = z.infer<typeof hydrationStateSchema>;\\\\n    42\\\\t\\\\n    43\\\\texport const requestErrorCodeSchema = z.enum([\\\\n    44\\\\t  'UNAUTHENTICATED',\\\\n    45\\\\t  'PROJECT_FORBIDDEN',\\\\n    46\\\\t  'PROJECT_NOT_FOUND',\\\\n    47\\\\t  'PROCESS_NOT_FOUND',\\\\n    48\\\\t  'PROJECT_NAME_CONFLICT',\\\\n    49\\\\t  'INVALID_PROJECT_NAME',\\\\n    50\\\\t  'INVALID_PROCESS_TYPE',\\\\n    51\\\\t  'PROCESS_ACTION_NOT_AVAILABLE',\\\\n    52\\\\t  'PROCESS_ACTION_FAILED',\\\\n    53\\\\t  'INVALID_PROCESS_RESPONSE',\\\\n    54\\\\t  'PROCESS_LIVE_UPDATES_UNAVAILABLE',\\\\n    55\\\\t]);\\\\n    56\\\\texport type RequestErrorCode = z.infer<typeof requestErrorCodeSchema>;\\\\n    57\\\\t\\\\n    58\\\\texport const sectionStatusSchema = z.enum(['ready', 'empty', 'error']);\\\\n    59\\\\texport type SectionStatus = z.infer<typeof sectionStatusSchema>;\\\\n    60\\\\t\\\\n    61\\\\texport const authenticatedUserSchema = z.object({\\\\n    62\\\\t  id: z.string().min(1),\\\\n    63\\\\t  email: z.string().email().nullable(),\\\\n    64\\\\t  displayName: z.string().min(1).nullable(),\\\\n    65\\\\t});\\\\n    66\\\\texport type AuthenticatedUser = z.infer<typeof authenticatedUserSchema>;\\\\n    67\\\\t\\\\n    68\\\\texport const authenticatedUserResponseSchema = z.object({\\\\n    69\\\\t  user: authenticatedUserSchema,\\\\n    70\\\\t});\\\\n    71\\\\texport type AuthenticatedUserResponse = z.infer<typeof authenticatedUserResponseSchema>;\\\\n    72\\\\t\\\\n    73\\\\texp