ts/service/server/nfr.test.ts\\\",\\\"tests/service/server/observability.test.ts\\\",\\\"tests/service/client/artifact-review-panel.test.ts\\\",\\\"tests/service/client/artifact-section.test.ts\\\",\\\"tests/integration/platform-shell.test.ts\\\"],\\\"removed\\\":[],\\\"totalAfterStory\\\":552,\\\"deltaFromPriorBaseline\\\":1},\\\"gatesRun\\\":[{\\\"command\\\":\\\"corepack pnpm run green-verify\\\",\\\"result\\\":\\\"pass\\\"},{\\\"command\\\":\\\"corepack pnpm run verify-all\\\",\\\"result\\\":\\\"pass\\\"}],\\\"selfReview\\\":{\\\"passesRun\\\":3,\\\"findingsFixed\\\":[\\\"Removed artifact ownership fields from project-shell artifact summaries and rendering while preserving process-local artifact references.\\\",\\\"Added provenance ids and display labels to review version contracts and patched store/service/test scaffolding to emit them consistently.\\\",\\\"Added durable process package-context tables plus store methods with canonical upsert and idempotent semantics.\\\",\\\"Fixed the production-shell integration assertion to resolve the built asset from the active worktree instead of a hard-coded sibling checkout path.\\\"],\\\"findingsSurfaced\\\":[\\\"Browser-facing package member contracts still carry the legacy `versionId` name as a compatibility shim; later Epic 5 stories still need the full surface rename to `artifactVersionId`.\\\",\\\"Review target schemas still accept legacy `REVIEW_MEMBER_UNAVAILABLE` alongside `PACKAGE_MEMBER_UNAVAILABLE` as a compatibility bridge until downstream package-review callers are fully migrated.\\\"]},\\\"openQuestions\\\":[],\\\"specDeviations\\\":[\\\"Browser-facing package member contracts still expose legacy `versionId`; Story 0 added the durable/package-context `artifactVersionId` vocabulary and deferred the surface rename to avoid wider Story 3/4 regressions.\\\",\\\"Review target schemas still accept legacy `REVIEW_MEMBER_UNAVAILABLE` alongside `PACKAGE_MEMBER_UNAVAILABLE` as a compatibility bridge for existing package review flows.\\\"],\\\"recommendedNextStep\\\":\\\"Implement Story 1 against the new project-scoped artifact summary and package-context foundation.\\\"}\\ntests/service/server/projects-api.test.ts:41:  it('TC-1.2a returns only accessible projects sorted by lastUpdatedAt descending', async () => {\\ntests/service/server/projects-api.test.ts:84:  it('TC-1.2c omits inaccessible projects', async () => {\\ntests/service/server/projects-api.test.ts:149:  it('TC-1.3c blocks direct project access for unauthorized actor', async () => {\\napps/platform/server/app.ts:192:  const processDisplayLabelService = new ProcessDisplayLabelService(platformStore);\\napps/platform/server/app.ts:197:      processDisplayLabelService,\\ntests/service/server/project-shell-bootstrap-api.test.ts:218:  it('returns project artifact summaries without legacy process ownership fields', async () => {\\ntests/service/server/project-shell-bootstrap-api.test.ts:235:            attachmentScope: 'process',\\ntests/service/server/project-shell-bootstrap-api.test.ts:237:            processDisplayLabel: 'Legacy Process #1',\\ntests/service/server/artifact-review-api.test.ts:83:          attachmentScope: 'process',\\ntests/service/server/artifact-review-api.test.ts:85:          processDisplayLabel: processSummary.displayLabel,\\ntests/service/server/artifact-review-api.test.ts:92:          attachmentScope: 'process',\\ntests/service/server/artifact-review-api.test.ts:94:          processDisplayLabel: processSummary.displayLabel,\\ntests/service/server/artifact-review-api.test.ts:445:            attachmentScope: 'process',\\ntests/service/server/artifact-review-api.test.ts:447:            processDisplayLabel: processSummary.displayLabel,\\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/002-self-review-pass-1.json:1:{\\\"resultId\\\":\\\"b9238b32-2bf1-4b5d-8fac-0b2649e3a780\\\",\\\"provider\\\":\\\"codex\\\",\\\"model\\\":\\\"gpt-5.4\\\",\\\"role\\\":\\