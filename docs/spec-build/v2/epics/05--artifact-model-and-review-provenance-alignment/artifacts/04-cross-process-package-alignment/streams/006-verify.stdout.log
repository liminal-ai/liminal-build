8\\\\t  sourceAttachmentCount: z.number().int().nonnegative(),\\\\n   119\\\\t  lastUpdatedAt: z.string().min(1),\\\\n   120\\\\t});\\\\n   121\\\\texport type ProjectSummary = z.infer<typeof projectSummarySchema>;\\\\n   122\\\\t\\\\n   123\\\\texport const processSummarySchema = z.object({\\\\n   124\\\\t  processId: z.string().min(1),\\\\n   125\\\\t  displayLabel: z.string().min(1),\\\\n   126\\\\t  processType: supportedProcessTypeSchema,\\\\n   127\\\\t  status: processStatusSchema,\\\\n   128\\\\t  phaseLabel: z.string().min(1),\\\\n   129\\\\t  nextActionLabel: z.string().min(1).nullable(),\\\\n   130\\\\t  availableActions: z.array(processAvailableActionSchema),\\\\n   131\\\\t  hasEnvironment: z.boolean(),\\\\n   132\\\\t  updatedAt: z.string().min(1),\\\\n   133\\\\t});\\\\n   134\\\\texport type ProcessSummary = z.infer<typeof processSummarySchema>;\\\\n   135\\\\t\\\\n   136\\\\texport const artifactSummarySchema = z.object({\\\\n   137\\\\t  artifactId: z.string().min(1),\\\\n   138\\\\t  displayName: z.string().min(1),\\\\n   139\\\\t  currentVersionLabel: z.string().min(1).nullable(),\\\\n   140\\\\t  attachmentScope: attachmentScopeSchema,\\\\n   141\\\\t  processId: z.string().min(1).nullable(),\\\\n   142\\\\t  processDisplayLabel: z.string().min(1).nullable(),\\\\n   143\\\\t  updatedAt: z.string().min(1),\\\\n   144\\\\t});\\\\n   145\\\\texport type ArtifactSummary = z.infer<typeof artifactSummarySchema>;\\\\n   146\\\\t\\\\n   147\\\\texport const sourceAttachmentSummarySchema = z.object({\\\\n   148\\\\t  sourceAttachmentId: z.string().min(1),\\\\n   149\\\\t  displayName: z.string().min(1),\\\\n   150\\\\t  purpose: sourcePurposeSchema,\\\\n   151\\\\t  targetRef: z.string().min(1).nullable(),\\\\n   152\\\\t  hydrationState: hydrationStateSchema,\\\\n   153\\\\t  attachmentScope: attachmentScopeSchema,\\\\n   154\\\\t  processId: z.string().min(1).nullable(),\\\\n   155\\\\t  processDisplayLabel: z.string().min(1).nullable(),\\\\n   156\\\\t  updatedAt: z.string().min(1),\\\\n   157\\\\t});\\\\n   158\\\\texport type SourceAttachmentSummary = z.infer<typeof sourceAttachmentSummarySchema>;\\\\n   159\\\\t\\\\n   160\\\\texport const processSectionErrorSchema = z.object({\\\\n   161\\\\t  code: z.literal('PROJECT_SHELL_PROCESSES_LOAD_FAILED'),\\\\n   162\\\\t  message: z.string().min(1),\\\\n   163\\\\t});\\\\n   164\\\\texport const artifactSectionErrorSchema = z.object({\\\\n   165\\\\t  code: z.literal('PROJECT_SHELL_ARTIFACTS_LOAD_FAILED'),\\\\n   166\\\\t  message: z.string().min(1),\\\\n   167\\\\t});\\\\n   168\\\\texport const sourceAttachmentSectionErrorSchema = z.object({\\\\n   169\\\\t  code: z.literal('PROJECT_SHELL_SOURCES_LOAD_FAILED'),\\\\n   170\\\\t  message: z.string().min(1),\\\\n   171\\\\t});\\\\n   172\\\\t\\\\n   173\\\\texport const processSectionEnvelopeSchema = makeShellSectionEnvelopeSchema(\\\\n   174\\\\t  processSummarySchema,\\\\n   175\\\\t).superRefine((value, context) => {\\\\n   176\\\\t  if (value.status === 'error' && value.error !== undefined) {\\\\n   177\\\\t    const result = processSectionErrorSchema.safeParse(value.error);\\\\n   178\\\\t    if (!result.success) {\\\\n   179\\\\t      context.addIssue({\\\\n   180\\\\t        code: z.ZodIssueCode.custom,\\\\n   181\\\\t        message: 'Process section errors must use the process section error code.',\\\\n   182\\\\t      });\\\\n   183\\\\t    }\\\\n   184\\\\t  }\\\\n   185\\\\t});\\\\n   186\\\\texport type ProcessSectionEnvelope = z.infer<typeof processSectionEnvelopeSchema>;\\\\n   187\\\\t\\\\n   188\\\\texport const artifactSectionEnvelopeSchema = makeShellSectionEnvelopeSchema(\\\\n   189\\\\t  artifactSummarySchema,\\\\n   190\\\\t).superRefine((value, context) => {\\\\n   191\\\\t  if (value.status === 'error' && value.error !== undefined) {\\\\n   192\\\\t    const result = artifactSectionErrorSchema.safeParse(value.error);\\\\n   193\\\\t    if (!result.success) {\\\\n   194\\\\t      context.addIs