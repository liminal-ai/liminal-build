s: [...args.plan.artifactIds],\n      sourceAttachmentIds: [...args.plan.sourceAttachmentIds],\n      outputIds: [...args.plan.outputIds],\n    };\n  }\n\n  async listProcessOutputs(): Promise<PlatformProcessOutputSummary[]> {\n","exit_code":0,"status":"completed"}}
