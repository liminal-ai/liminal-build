layName: target.displayName,\n        })),\n    ].sort((left, right) => {\n      const publishedAtComparison = right.publishedAt.localeCompare(left.publishedAt);\n\n      if (publishedAtComparison !== 0) {\n        return publishedAtComparison;\n","exit_code":0,"status":"completed"}}
