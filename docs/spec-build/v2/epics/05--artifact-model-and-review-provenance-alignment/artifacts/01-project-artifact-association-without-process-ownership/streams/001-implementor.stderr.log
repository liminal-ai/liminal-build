  async getProcessReviewPackage(args: {
    processId: string;
    packageId: string;
    memberId?: string;
  }): Promise<PackageReviewTarget | null> {
    const snapshot = await this.client.query(getPackageSnapshotQuery, {
      packageSnapshotId: args.packageId,
    });

    if (snapshot === null || snapshot.processId !== args.processId) {
      return null;
    }

    const members = await this.client.query(listPackageSnapshotMembersQuery, {
      packageSnapshotId: snapshot.packageSnapshotId,
    });

    if (members.length === 0) {
      return null;
    }

    const memberStates = await Promise.all(
      members.map(async (member) => {
        const pinnedVersion = await this.client.query(getArtifactVersionQuery, {
          versionId: member.artifactVersionId,
        });
        const displayName = member.displayName;
        const versionLabel = member.versionLabel;
        const producingProcess =
          pinnedVersion === null
            ? null
            : await this.client.query(getProcessRecordQuery, {
                processId: pinnedVersion.createdByProcessId,
              });

        if (pinnedVersion === null) {
          return {
            member: {
              memberId: member.memberId,
              position: member.position,
              artifactId: member.artifactId,
              displayName,
              artifactVersionId: member.artifactVersionId,
              versionLabel,
              status: 'unavailable' as const,
            },
            review: null,
          };
        }

        const currentVersion = await this.client.query(getLatestArtifactVersionQuery, {
          artifactId: member.artifactId,
        });
        const currentVersionId = currentVersion?.versionId ?? null;
        const currentVersionLabel = currentVersion?.versionLabel ?? null;
        const contentUrl = await this.client.query(getArtifactVersionContentUrlQuery, {
          versionId: pinnedVersion.versionId,
        });
        const selectedVersion = await this.buildArtifactVersionDetail({
          version: pinnedVersion,
          contentUrl,
          producedByProcessDisplayLabel: producingProcess?.displayLabel ?? null,
        });

        return {
          member: {
            memberId: member.memberId,
            position: member.position,
            artifactId: member.artifactId,
            displayName,
            artifactVersionId: member.artifactVersionId,
            versionLabel,
            status: 'ready' as const,
          },
          review: artifactReviewTargetSchema.parse({
            artifactId: member.artifactId,
            displayName,
            currentVersionId,
            currentVersionLabel,
            selectedVersionId: pinnedVersion.versionId,
            versions: [
              {
                versionId: pinnedVersion.versionId,
                versionLabel,
                isCurrent: currentVersionId === pinnedVersion.versionId,
                createdAt: pinnedVersion.createdAt,
                producedByProcessId: pinnedVersion.createdByProcessId,
                producedByProcessDisplayLabel: producingProcess?.displayLabel ?? null,
              },
            ],
            selectedVersion,
          }),
        };
      }),
    );

    const selectedReadyMember =
      (args.memberId === undefined
        ? memberStates.find((entry) => entry.member.status === 'ready')
        : memberStates.find(
            (entry) => entry.member.memberId === args.memberId && entry.member.status === 'ready',
          )) ?? null;
    const selectedUnavailableMember =
      args.memberId === undefined
        ? null
        : memberStates.find(
            (entry) =>
              entry.member.memberId === args.memberId && entry.member.status === 'unavailable',
          ) ?? null;

    if (selectedReadyMember === null && selectedUnavailableMember === null) {
      return null;
    }

    const selectedMemberId =
      selectedReadyMember?.member.memberId ?? selectedUnavailableMember?.member.memberId ?? null;

    return packageReviewTargetSchema.parse({
      packageId: snapshot.packageSnapshotId,
      displayName: snapshot.displayName,
      packageType: snapshot.packageType,
      members: memberStates
        .map((entry) => entry.member)
        .sort((left, right) => left.position - right.position),
      selectedMemberId,
      selectedMember:
        selectedReadyMember === null
          ? null
          : {
              memberId: selectedReadyMember.member.memberId,
              artifactId: selectedReadyMember.member.artifactId,
              displayName: selectedReadyMember.member.displayName,
              artifactVersionId: selectedReadyMember.member.artifactVersionId,
              versionLabel: selectedReadyMember.member.versionLabel,
              status: 'ready',
              artifact: selectedReadyMember.review,
            },
      exportability: {
        isExportable: selectedUnavailableMember === null,
        disabledReason:
          selectedUnavailableMember === null
            ? null
            : 'One or more pinned artifact versions are unavailable for export.',
      },
    });
  }
