tring;\\n    81\\t    versionId?: string;\\n    82\\t  }): Promise<ArtifactReviewState | null> {\\n    83\\t    const [artifacts, versionRecords] = await Promise.all([\\n    84\\t      this.platformStore.listProjectArtifacts({\\n    85\\t        projectId: args.projectId,\\n    86\\t      }),\\n    87\\t      this.platformStore.listArtifactVersions({\\n    88\\t        artifactId: args.artifactId,\\n    89\\t      }),\\n    90\\t    ]);\\n    91\\t\\n    92\\t    const artifact = artifacts.find((candidate) => candidate.artifactId === args.artifactId);\\n    93\\t    const processCanReviewArtifact =\\n    94\\t      artifact?.processId === undefined\\n    95\\t        ? versionRecords.some((candidate) => candidate.createdByProcessId === args.processId)\\n    96\\t        : artifact.processId === args.processId;\\n    97\\t\\n    98\\t    if (artifact === undefined || !processCanReviewArtifact) {\\n    99\\t      return null;\\n   100\\t    }\\n   101\\t\\n   102\\t    const processIds = Array.from(\\n   103\\t      new Set(versionRecords.map((version) => version.createdByProcessId)),\\n   104\\t    );\\n   105\\t    const processRecords =\\n   106\\t      (await this.platformStore.listProcessesByIds?.({\\n   107\\t        processIds,\\n   108\\t      })) ?? [];\\n   109\\t    const processDisplayLabelsById = new Map(\\n   110\\t      processRecords.map((processRecord) => [processRecord.processId, processRecord.displayLabel]),\\n   111\\t    );\\n   112\\t\\n   113\\t    const currentVersion = versionRecords[0];\\n   114\\t    const selectedVersionRecord =\\n   115\\t      args.versionId === undefined\\n   116\\t        ? currentVersion\\n   117\\t        : versionRecords.find((candidate) => candidate.versionId === args.versionId);\\n   118\\t\\n   119\\t    if (args.versionId !== undefined && selectedVersionRecord === undefined) {\\n   120\\t      return null;\\n   121\\t    }\\n   122\\t\\n   123\\t    const versions = versionRecords.map((version, index) => ({\\n   