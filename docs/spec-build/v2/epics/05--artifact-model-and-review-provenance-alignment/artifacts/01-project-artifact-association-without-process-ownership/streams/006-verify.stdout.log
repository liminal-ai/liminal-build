ared current/reopened package-context fixtures for later Epic 5 stories.\\\"},{\\\"path\\\":\\\"tests/service/server/review-foundation-contracts.test.ts\\\",\\\"reason\\\":\\\"Expanded Story 0 contract coverage for slim artifact summaries, provenance, and new error codes.\\\"},{\\\"path\\\":\\\"tests/service/server/review-export-api.test.ts\\\",\\\"reason\\\":\\\"Updated package-review fixture expectations for required provenance fields.\\\"},{\\\"path\\\":\\\"tests/service/server/package-review-api.test.ts\\\",\\\"reason\\\":\\\"Updated server package-review fixtures to include provenance-bearing version summaries.\\\"},{\\\"path\\\":\\\"tests/service/server/nfr.test.ts\\\",\\\"reason\\\":\\\"Updated package review NFR fixtures to satisfy provenance-bearing artifact review contracts.\\\"},{\\\"path\\\":\\\"tests/service/server/observability.test.ts\\\",\\\"reason\\\":\\\"Updated observed package review fixtures to satisfy provenance-bearing artifact review contracts.\\\"},{\\\"path\\\":\\\"tests/service/client/artifact-review-panel.test.ts\\\",\\\"reason\\\":\\\"Updated unsupported-version fixture data for required provenance fields.\\\"},{\\\"path\\\":\\\"tests/service/client/artifact-section.test.ts\\\",\\\"reason\\\":\\\"Updated UI assertions for ownership-free project artifact rendering.\\\"},{\\\"path\\\":\\\"tests/integration/platform-shell.test.ts\\\",\\\"reason\\\":\\\"Made the production-shell asset assertion use the active worktree build output path.\\\"}],\\\"tests\\\":{\\\"added\\\":[],\\\"modified\\\":[\\\"tests/service/server/review-foundation-contracts.test.ts\\\",\\\"tests/service/server/review-export-api.test.ts\\\",\\\"tests/service/server/package-review-api.test.ts\\\",\\\"tests/service/server/nfr.test.ts\\\",\\\"tests/service/server/observability.test.ts\\\",\\\"tests/service/client/artifact-review-panel.test.ts\\\",\\\"tests/service/client/artifact-section.test.ts\\\",\\\"tests/integration/platform-shell.test.ts\\\"],\\\"removed\\\":[],\\\"tota