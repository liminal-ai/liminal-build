rsion).toBeUndefined();\\n   766\\t\\n   767\\t    await app.close();\\n   768\\t  });\\n   769\\t\\n   770\\t  it('TC-3.4c returns ARTIFACT_VERSION_NOT_FOUND when an explicit version is requested for a zero-version artifact', async () => {\\n   771\\t    const platformStore = buildStore();\\n   772\\t    const app = await buildApp({\\n   773\\t      authSessionService: createTestAuthSessionService({\\n   774\\t        actor: {\\n   775\\t          userId: 'workos-user-1',\\n   776\\t          workosUserId: 'workos-user-1',\\n   777\\t          email: 'lee@example.com',\\n   778\\t          displayName: 'Lee Moore',\\n   779\\t        },\\n   780\\t        reason: null,\\n   781\\t      }),\\n   782\\t      authUserSyncService: new AuthUserSyncService(platformStore),\\n   783\\t      platformStore,\\n   784\\t    });\\n   785\\t    const response = await app.inject({\\n   786\\t      method: 'GET',\\n   787\\t      url: `/api/projects/${projectSummary.projectId}/processes/${processSummary.processId}/review/artifacts/artifact-empty-001?versionId=artifact-version-empty-missing`,\\n   788\\t      cookies: {\\n   789\\t        [sessionCookieName]: 'valid-session-cookie',\\n   790\\t      },\\n   791\\t    });\\n   792\\t\\n   793\\t    expect(response.statusCode).toBe(404);\\n   794\\t    expect(response.json()).toMatchObject({\\n   795\\t      code: 'ARTIFACT_VERSION_NOT_FOUND',\\n   796\\t      status: 404,\\n   797\\t    });\\n   798\\t\\n   799\\t    await app.close();\\n   800\\t  });\\n   801\\t\\n   802\\t  it('returns a ready empty markdown review when a durable version body is zero-byte', async () => {\\n   803\\t    const platformStore = new InMemoryPlatformStore({\\n   804\\t      accessibleProjectsByUserId: {\\n   805\\t        'user:workos-user-1': [projectSummary],\\n   806\\t      },\\n   807\\t      projectAccessByProjectId: {\\n   808\\t        [projectSummary.projectId]: {\\n   809\\t          kind: 'accessible',\\n   810\\t          project: projectSummary,\\n   811\\t        },\\n   812\\t      },\\n   813\\t      processesByProjectId: {\\n   814\\t        [projectSummary.projectId]: [processSummary],\\n   815\\t      },\\n   816\\t      artifactsByProjectId: {\\n   817\\t        [projectSummary.projectId]: [\\n   818\\t          {\\n   819\\t            artifactId: 'artifact-zero-byte-001',\\n   820\\t            displayName: 'Zero Byte Spec',\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/03-process-scoped-artifact-review-realignment/streams/006-verify.stdout.log:150:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_73\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba tests/service/server/review-workspace-api.test.ts | sed -n '260,460p'\\\"\",\"aggregated_output\":\"   260\\t      process: {\\n   261\\t        processId: processSummary.processId,\\n   262\\t      },\\n   263\\t    });\\n   264\\t    expect(response.json().target).toBeUndefined();\\n   265\\t\\n   266\\t    await app.close();\\n   267\\t  });\\n   268\\t\\n   269\\t  it('TC-1.3b explicit package selection keeps the target kind visible as package', async () => {\\n   270\\t    const platformStore = buildStore({\\n   271\\t      includePackage: true,\\n   272\\t    });\\n   273\\t    const app = await buildApp({\\n   274\\t      authSessionService: createTestAuthSessionService({\\n   275\\t        actor: {\\n   276\\t          userId: 'workos-user-1',\\n   277\\t          workosUserId: 'workos-user-1',\\n   278\\t          email: 'lee@example.com',\\n   279\\t          displayName: 'Lee Moore',\\n   280\\t        },\\n   281\\t        reason: null,\\n   282\\t      }),\\n   283\\t      authUserSyncService: new AuthUserSyncService(platformStore),\\n   284\\t      platformStore,\\n   285\\t    });\\n   286\\t    const response = await app.inject({\\n   287\\t      method: 'GET',\\n   288\\t      url: `/api/projects/${projectSummary.pro