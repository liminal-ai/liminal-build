.\\\\\\\"}],\\\\\\\"tests\\\\\\\":{\\\\\\\"added\\\\\\\":[],\\\\\\\"modified\\\\\\\":[\\\\\\\"tests/service/server/project-shell-bootstrap-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/process-work-surface-api.test.ts\\\\\\\",\\\\\\\"tests/service/server/artifact-review-api.test.ts\\\\\\\"],\\\\\\\"removed\\\\\\\":[],\\\\\\\"totalAfterStory\\\\\\\":556,\\\\\\\"deltaFromPriorBaseline\\\\\\\":3},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run green-verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"corepack pnpm run verify-all\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"}],\\\\\\\"selfReview\\\\\\\":{\\\\\\\"findingsFixed\\\\\\\":[\\\\\\\"Confirmed AC-1.1 through AC-1.3 are covered in behavior by stripping shell ownership fields, preserving process-local current-material projection, and enabling referenced-artifact review entry without ownership transfer.\\\\\\\",\\\\\\\"Validated the in-scope test-plan obligations with added server coverage for shell summary shape, current-material reference behavior, and cross-process referenced review access.\\\\\\\",\\\\\\\"Caught and fixed the temporary integration regression from a too-narrow current-ref-only reviewability rule, then re-ran both story and epic gates successfully.\\\\\\\"],\\\\\\\"findingsSurfaced\\\\\\\":[\\\\\\\"Legacy artifact-row ownership hints still exist in some internal durable/test seams as compatibility residue; this story stops relying on them in the affected read paths, but Story 2 remains the write-path cleanup point.\\\\\\\",\\\\\\\"Review eligibility now intentionally unions current refs with produced-artifact visibility to preserve existing shipped behavior during this chunk; a later epic/story can narrow or replace that compatibility path once package-context and full review-context alignment land.\\\\\\\"]},\\\\\\\"openQuestions\\\\\\\":[],\\\\\\\"specDeviations\\\\\\\":[],\\\\\\\"recommendedNextStep\\\\\\\":\\\\\\\"Proceed to verification with focused checks on cross-process artifact reference behavior in the project shell, process materials, and review entry paths, then carry the deferred write-path and compatibility cleanup into Story 2 and later review-context alignment work.\\\\\\\"}\\\"}}\\napps/platform/shared/contracts/schemas.ts:34:export const attachmentScopeSchema = z.enum(['project', 'process']);\\napps/platform/shared/contracts/schemas.ts:35:export type AttachmentScope = z.infer<typeof attachmentScopeSchema>;\\napps/platform/shared/contracts/schemas.ts:155:export type ArtifactSummary = z.infer<typeof artifactSummarySchema> & {\\napps/platform/shared/contracts/schemas.ts:156:  attachmentScope?: AttachmentScope;\\napps/platform/shared/contracts/schemas.ts:158:  processDisplayLabel?: string | null;\\napps/platform/shared/contracts/schemas.ts:173:  attachmentScope: attachmentScopeSchema,\\napps/platform/shared/contracts/schemas.ts:175:  processDisplayLabel: z.string().min(1).nullable(),\\ndocs/spec-build/v2/epics/05--artifact-model-and-review-provenance-alignment/artifacts/00-foundation/004-self-review-pass-3.json:1:{\\\"resultId\\\":\\\"dd90a8d2-6bab-472f-aaaf-9a44c9e87b49\\\",\\\"provider\\\":\\\"codex\\\",\\\"model\\\":\\\"gpt-5.4\\\",\\\"role\\\":\\\"story_self_review_pass\\\",\\\"status\\\":\\\"completed\\\",\\\"sessionId\\\":\\\"019dcb8d-54d4-7882-8bd6-b820edf96e06\\\",\\\"continuation\\\":{\\\"provider\\\":\\\"codex\\\",\\\"sessionId\\\":\\\"019dcb8d-54d4-7882-8bd6-b820edf96e06\\\",\\\"storyId\\\":\\\"00-foundation\\\"},\\\"outcome\\\":\\\"ready-for-verification\\\",\\\"story\\\":{\\\"id\\\":\\\"00-foundation\\\",\\\"title\\\":\\\"Story 0: Foundation\\\"},\\\"passNumber\\\":3,\\\"planSummary\\\":\\\"Aligned Story 0 foundations by slimming project artifact summaries, extending review provenance and error contracts, adding durable process package-context tables/store methods, and refreshing fixtures/tests so the new vocabulary verifies cleanly.\\\",\\\"changedFiles\\\":[{\\\"path\\\":\\\"apps/platform/shared/contracts/schemas.ts\\\",\\\"reason\\\":\\\"Removed artifact-summary ownership fields from the browser contract and added Story 0 request error codes.\\\"},{\\\"path\\\":\\\"apps/platform/shared/contracts/review-workspace.ts\\\",\\\"reason\\\":\\\"Added version provenance fields and expanded review-target error vocabulary.\\\"},{\\\"path\\\":\\\"apps/platform/server/errors/codes.ts\\\",\\\"reason\\\":\\\"Added server-side constants for the new review and package error codes.\\\"},{\\\"path\\\":\\\"apps/platform/server/services/review/artifact-review.service.ts\\\",\\\"reason\\\":\\\"Populated review version provenance ids and display labels from store data.\\\"},{\\\"path\\\":\\\"apps/platform/server/services/projects/platform-store.ts\\\",\\\"reason\\\":\\\"Added package-context record types/methods and made package review scaffolding provenance-aware.\\\"},{\\\"path\\\":\\\"convex/processPackageContexts.ts\\\",\\\"reason\\\":\\\"Added durable current package-context query and mutation support with canonical upsert and duplicate cleanup semantics.\\\"},{\\\"path\\\":\\\"convex/processPackageContextMembers.ts\\\",\\\"reason\\\":\\\"Added durable ordered package-context member query support.\\\"},{\\\"path\\\":\\\"convex/schema.ts\\\",\\\"reason\\\":\\\"Registered the new process package-context tables and indexes.\\\"},{\\\"path\\\":\\\"convex/artifacts.ts\\\",\\\"reason\\\":\\\"Slimmed project artifact summary reads to the Story 0 project-scoped vocabulary.\\\"},{\\\"path\\\":\\\"convex/_generated/api.d.ts\\\",\\\"reason\\\":\\\"Regenerated Convex bindings after adding package-context functions and tables.\\\"},{\\\"path\\\":\\\"convex/_generated/ai/ai-files.state.json\\\",\\\"reason\\\":\\\"Refreshed generated Convex AI metadata during codegen/dev.\\\"},{\\\"path\\\":\\\"apps/platform/client/features/projects/artifact-section.ts\\\",\\\"reason\\\":\\\"Removed project-shell ownership copy so artifact rows render as project assets only.\\\"},{\\\"path\\\":\\\"tests/fixtures/artifact-versions.ts\\\",\\\"reason\\\":\\\"Added provenance metadata to shared artifact-version fixtures.\\\"},{\\\"path\\\":\\\"tests/fixtures/package-snapshots.ts\\\",\\\"reason\\\":\\\"Updated package-member degradation fixtures to the new error vocabulary.\\\"},{\\\"path\\\":\\\"tests/fixtures/review-workspace.ts\\\",\\\"reason\\\":\\\"Updated bounded review-workspace fixtures for the new package-member error code.\\\"},{\\\"path\\\":\\\"tests/fixtures/review-errors.ts\\\",\\\"reason\\\":\\\"Added shared request and target error fixtures for Story 0 review/package classifications.\\\"},{\\\"path\\\":\\\"tests/fixtures/package-contexts.ts\\\",\\\"reason\\\":\\\"Added shared current and reopened package-context fixtures for later Epic 5 stories.\\\"},{\\\"path\\\":\\\"tests/service/server/review-foundation-contracts.test.ts\\\",\\\"reason\\\":\\\"Expanded Story 0 contract coverage for slim artifact summaries, provenance, and new error codes.\\\"},{\\\"path\\\":\\\"tests/service/server/review-export-api.test.ts\\\",\\\"reason\\\":\\\"Updated package-review fixture expectations for required provenance fields.\\\"},{\\\"path\\\":\\\"tests/service/server/package-review-api.test.ts\\\",\\\"reason\\\":\\\"Updated server package-review fixtures to include provenance-bearing version summaries.\\\"},{\\\"path\\\":\\\"tests/service/server/nfr.test.ts\\\",\\\"reason\\\":\\\"Updated package-review NFR fixtures to satisfy provenance-bearing artifact review contracts.\\\"},{\\\"path\\\":\\\"tests/service/server/observability.test.ts\\\",\\\"reason\\\":\\\"Updated observed package-review fixtures to satisfy provenance-bearing artifact review contracts.\\\"},{\\\"path\\\":\\\"tests/service/client/artifact-review-panel.test.ts\\\",\\\"reason\\\":\\\"Updated unsupported-version fixture data for required provenance fields.\\\"},{\\\"path\\\":\\\"tests/service/client/artifact-section.test.ts\\\",\\\"reason\\\":\\\"Updated UI as